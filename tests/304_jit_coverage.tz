// Покрытие JIT (хвост шага 10). Строки — байты (§4.0): s.size и s[k] в машинном коде —
// длина и байты по смещениям VM, s[k] — с проверкой границ (out_of_bounds, как у
// интерпретатора); parse_int прелюдии — тоже. Анонимный литерал {…} на месте результата
// или T x = {…} — тип места struct (§4.3): литерал вычисляет VM и приводит к нему.
// Оператор, объявленный в блоке, — локальная функция: встраивается в свои операции.
// Где этого нет 
//  — интерпретатор с причиной.
// args: 12a3
// jit-compiled: digits
// jit-compiled: at
// jit-compiled: origin
// jit-compiled: moved
// jit-compiled: minus3
// machine
// out: 3 12 -1
// out: 49 -2
// out: 51
// out: point{x: 0, y: 0} point{x: 5, y: 1}
// out: 5
struct point { i64 x; i64 y; }
digits(str s) {
  n = 0;
  for(k : range(s.size)) if((s[k] >= '0') && (s[k] <= '9')) n += 1;
  n
}
at(str s, i64 k) => try { s[k] } catch(out_of_bounds e) { -2 };
point origin() => {x: 0, y: 0};
moved(i64 d) {
  point p = {y: 1, x: d}; // поля — по именам: порядок литерала не порядок struct
  print((p.x * 10) + p.y);
  p
}
minus3(i64 a, i64 b, i64 c) {
  [[associative]] operator (i64 x) - (i64 y) => sub(x, y);
  a - b - c
}

main() {
  s = args[1];
  print(digits(s), parse_int("12").value, if(parse_int(s).ok) 1 else -1);
  print(at(s, 0), at(s, 9));
  print(origin(), moved(5));
  print(minus3(10, 3, 2));
}
