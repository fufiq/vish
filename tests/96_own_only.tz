// error: area: расширять сущности модуля geo.own можно только в нём (own_only)
// [[extension(own_only)]] module k; — проверка прелюдии own_only запрещает чужие
// расширения сущностей модуля (§9.1): перегрузка area вне geo.own — ошибка разбора
// на её объявлении. 
// own_only — самый строгий вариант такой проверки.
use geo.own;

area(i64 w, i64 h) => w * h;

main() {
  print(area(2.0, 3.0));
}
