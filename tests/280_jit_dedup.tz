// out: 27
// jit-stats: jit  scale(кт, i64) → код scale(кт, i64) (та же рантайм-часть)
// jit-stats: jit  twice_of(кт, i64) → код twice_of(кт, i64) (та же рантайм-часть)
// machine
// Дедупликация экземпляров (R2, §10.3): 
// 
//  
// сравнение — «выше ир»: тот же вход компилятора и те же ответы разбора на его
// вопросы (jit_type, jit_const…) — код уже есть, второй компиляции нет. scale(i64…) и
// scale(f64…) — одна рантайм-часть, scale(str…) — другая ветка.
scale(type t, i64 n) => if((t == i64) || (t == f64)) n * 2 else n;
twice_of(type t, i64 n) => n + n;
main() {
  s = 0;
  for(i : range(3)) s += scale(i64, i) + scale(f64, i) + scale(str, i) + twice_of(bool, i) + twice_of(i64, i);
  print(s);
}
