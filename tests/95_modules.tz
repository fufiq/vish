// out: 25.0 100.0
// out: 3.0
// machine
// fmt-stable
// store-roundtrip
// Модули (§9.1) — семантический инклюд по ключу: 
//;
//.
// use geo.vec; — все объявления модуля видны, перегрузки сливаются; расширять
// можно (модуль не sealed): своя перегрузка norm2 для i64.
use geo.vec;

norm2(i64 n) => f64(n * n) / 3.0;

main() {
  a = v2{3.0, 4.0};
  print(norm2(a), norm2(scale(a, 2.0)));
  print(norm2(3));
}
