// out: [role{level: 2}, async]
// out: [1, packed]
// out: x i64 3
// out: point{x: 1, y: 2, z: 0} 3
// out: true
// fmt-stable
// store-roundtrip
// Сущности компилятора как значения (шаг 1 расширений): атрибуты [[…]] —
// значения языка, вычисляемые при компиляции (как [[internal("govno")]] у
// Автора, но не текст); расширение сущности формой Имя { … } — 
// 
// поля, атрибуты, функции.
struct role { i64 level; }

[[role{2}, "async"]] api_call() => 0;

[[1]] struct point { i64 x; i64 y; }

point {
  i64 z = 0;
  [["packed"]];
  sum(point p) => p.x + p.y + p.z;
}

main() {
  print(attrs(api_call));
  print(attrs(point));
  fs = fields(point);
  print(fs[0].name, fs[0].type, fs.size);
  p = point{1, 2};
  print(p, p.sum());
  print(typeof(p) == point);
}
