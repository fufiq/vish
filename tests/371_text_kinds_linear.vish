// args: 30000
// out: 120000 d 120000
// out: 900000 97
// machine
// Виды строк растут линейно (Ш2а): 
// параметры — алиасы, поэтому
// большая строка и вид строки, переданные в функцию, не копируются на каждый вызов. Было: копия
// строки на каждый вызов (проверка типа отвергнутых перегрузок печатала её целиком) — квадрат,
// 30000 дописываний — минуты. Машина процессов: проверка типа параметра не копирует агрегат ради отказа.
fill(i64 n) {
  g = grown_text();
  for(i : range(n)) g.put("abcd");
  g
}
// Size and s[k] read the location of the caller.
probe(str s) => s.size;
last(grown_text g) => byte_at(g, size(g) - 1);
main() {
  n = parse_int(args[1]).value;
  g = fill(n);
  b = text_buffer();
  for(i : range(n)) b.put("abcd");
  print(size(g), text_byte(last(g)), size(b));
  total = 0;
  s = text(g);
  for(i : range(n)) total += (probe(s) / 4000) + (if(last(g) == 100) 0 else 1);
  print(total, s[0]);
}
