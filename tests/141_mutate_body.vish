// out: вход в greet
// out: тело
// out: вход в sum
// out: 7
// fmt-stable
// store-roundtrip
// fmt-ct-has: print("вход в greet");
// fmt-ct-has: sum(a, b) {
// machine
// Правка тел функций при компиляции (§7.4): ct-код вставляет инструкцию в начало каждой
// функции списка — «поведение» как результат программы, а не текст: «Порождение это не
// то, что ты описал явно - порождение это результат работы описанной тобою программы…
// раздельное создание в какой-то степени это мутации». Мутация — в
// журнал базы с источником (этот ct { }); vish fmt — написанное, vish fmt --ct — после
// элаборации.
greet() {
  print("тело");
}

sum(a, b) {
  a + b
}

// A function called from a ct module is also a ct code.
trace_entry(f) {
  b = f.body;
  b.items = array{ast.call{ast.name{"print"}, array{ast.string{"вход в " + code_name(f)}}}, ...b.items};
}

ct {
  for(name : array{"greet", "sum"}) trace_entry(functions_named(name)[0]);
}

main() {
  greet();
  print(sum(3, 4));
}
