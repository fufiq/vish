// out: 120
// out: 55
// out: 3628800
// out: [2.0, 4.5, 7.0]
// out: 7
// out: true
// out: false
// out: -3
// out: 3
// out: 9223372036854775807
// jit-compiled: fact
// jit-compiled: sum_to
// jit-compiled: scale_add
// jit-compiled: collatz
// jit-compiled: logic
// jit-compiled: nan_eq
// jit-compiled: divmod
// Кодогенераторы операций (M1a): рекурсия, счётные циклы, while, запись в
// элементы массива, деление/остаток, логика, сравнения f64 по IEEE, модульная
// арифметика. Результаты сверяются с интерпретатором (дифференциально).
fact(n) {
  if(n <= 1) return 1;
  n * fact(n - 1)
}

sum_to(n) {
  auto s = 0;
  for(auto i : range(n + 1)) s += i;
  s
}

scale_add(mut auto xs, f64 k) {
  for(auto i : range(xs.size)) xs[i] = (xs[i] * k) + 0.5;
  xs.size
}

collatz(n) {
  auto steps = 0;
  auto x = n;
  while(x != 1) {
    if(x % 2 == 0) x = x / 2; else x = (3 * x) + 1;
    steps += 1;
  }
  steps
}

logic(a, b) => (a > 0 && b > 0) || a == b;

nan_eq(x) => x == x;

divmod(a, b) => (a / b) + (a % b);

main() {
  print(fact(5));
  print(sum_to(10));
  print(fact(10));
  auto xs = array{1.5, 4.0, 6.5};
  auto k = scale_add(xs, 1.0);
  print(xs);
  print(collatz(3));
  print(logic(1, 2));
  print(nan_eq(0.0 / 0.0));
  print(divmod(-7, 3));
  print(divmod(7, 3));
  print(9223372036854775806 + 1);
}
