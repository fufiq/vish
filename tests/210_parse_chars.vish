// out: rgb{r: 255, g: 0, b: 170}
// out: rgb{r: 0, g: 255, b: 0}
// out: rgb{r: 15, g: 0, b: 10}
// out: rgb{r: 18, g: 52, b: 86}
// out: rgb{r: 1, g: 2, b: 3}
// machine
// fmt-stable
// store-roundtrip
// Разбор символов внутри атома (§4.4) — пример автора о mecha: 
// 
// 
// 
// The atom ff00aa is one name, 00ff00 is the atoms 00 and ff00 close: the symbolic parser
// reads the text of the word as written. '#' is a byte, symbolic literal; rgb(1) | rgb(2) -
// luck at the boundary of the atom takes over (*mine*).
struct rgb { i64 r; i64 g; i64 b; }

hex_digits(i64 digits) => int({sign: false, base: 16, digits: digits});
rgb_p(i64 digits) => map(rgb, {r: hex_digits(digits), g: hex_digits(digits), b: hex_digits(digits)});

color(expr body) {
  syntax {r} => parse(r, combine('#', rgb_p(1) | rgb_p(2)));
  body
}

// without '#': formatter hex(2) - and parsing setting (same as fmt"{hex(2)}{x}")
plain(expr body) {
  syntax {r} => parse(r, map(rgb, {r: hex(2), g: hex(2), b: hex(2)}));
  body
}

// in the middle of the atom - literal by symbols, the whole - by decimal numbers
dotted(expr body) {
  syntax {r} => parse(r, map(rgb, {r: int(false), g: combine("x", int(false)), b: combine("x", int(false))}));
  body
}

main() {
  print(color { #ff00aa });
  print(color { #00ff00 });
  print(color { #f0a });
  print(plain { 123456 });
  print(dotted { 1x2x3 });
}
