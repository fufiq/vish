// Проекция — группа записей syntax (§4.5, вариант C — решение автора
// 2026-10-05): модуль geo.words печатает те же узлы (n_loop, n_if) словами и
// ставит скобки своей функцией operand_parens. tz fmt --projection geo.words —
// то же, что представление редактора с этой проекцией (225_editor_projection).
// Программа модуль проекции не использует: без проекции — C-подобная (D3).
// fmt-projection: geo.words
// fmt-projection-has:   forever {
// fmt-projection-has:     when(n > 2) break;
// fmt-projection-has:     when(n == 1) print(n) otherwise print(0);
// fmt-projection-has:   print(n, ((n + n) + n) - 3);
// fmt-has:   loop {
// fmt-has:     if(n == 1) print(n) else print(0);
// fmt-has:   print(n, (n + n + n) - 3);
// fmt-stable
// out: 1
// out: 0
// out: 0
// out: 3 6
main() {
  n = 0;
  loop {
    n += 1;
    if(n > 2) break;
    if(n == 1) print(n) else print(0);
  }
  print(0);
  print(n, ((n + n) + n) - 3);
}
