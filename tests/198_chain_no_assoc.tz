// check-error: цепочка операторов неоднозначна
// out: 1 7 24
// error: цепочка операторов неоднозначна
// Без ассоциативности — по-прежнему перебор по типам: единственный разбор
// берётся (i % 2 == 0), одинаковый ассоциативный — одно дерево, а `a - b - c`
// без [[associative]] в контексте — ошибка «расставьте скобки».
pick(i) => if(i % 2 == 0) 1 else 2;

main() {
  print(pick(4), (10 - 2) - 1, 2 * 3 * 4);
  a = 10;
  print(a - 3 - 2);
}
