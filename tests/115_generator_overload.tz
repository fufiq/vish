// out: 90
// jit-compiled: main
// Генератор → цикл в компиляторе на языке, когда имя функции генератора совпадает с
// функцией прелюдии (fill(n, x) — заполнение массива): перегрузка в теле W
// выбирается по типам разбора в контексте встраивания, а не по арности. main
// с print компилируется целиком: produce встроен, генератор свёрнут.
fill(s, n) {
  for(i : range(n)) write(s, i * 2);
  close(s);
}

total(s) {
  t = 0;
  for(x : s) t += x;
  t
}

produce(n) {
  s = stream(16);
  spawn { fill(s, n); }
  total(s)
}

main() {
  print(produce(10));
}
