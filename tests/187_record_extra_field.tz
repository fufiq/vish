// Лишнее поле — ошибка в месте литерала: struct из места не принимает того, чего в нём нет
// (§4.3); причина — в кандидате перегрузки. Недостающее без значения по умолчанию и
// неподходящий тип поля — тоже; explicit point p литерал не берёт: литерал — уровень
// «представимо» (
//).
struct point { f64 x; f64 y; }

len2(point p) => (p.x * p.x) + (p.y * p.y);

main() {
  print(len2({x: 3, y: 4}));
  print(len2({x: 3, y: 4, z: 5}));
}
