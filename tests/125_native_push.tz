// out: 4998 [1, 2, 3, 7, 8] 5
// jit-compiled: fill
// jit-compiled: add2
// machine
// push машинным кодом: место в словах есть — запись и n + 1 без VM («бесконечный
// вектор» не переезжает, §12.2); нет — VM через службу (рост, раскладка по первому
// элементу). push инвалидирует опору всегда — новое поколение буфера и в машинном коде.
fill(i64 n) {
  a = array{};
  for(i : range(n)) a.push(i);
  fs = array{};
  for(i : range(n)) fs.push(f64(i) * 0.5);
  a.size + (i64(fs[n - 1]) + a[n - 1])
}
add2(mut xs, i64 v) {
  xs.push(v);
  xs.push(v + 1);
  xs.size
}
main() {
  ys = array{1, 2, 3};
  k = add2(ys, 7);
  print(fill(2000), ys, k);
}
