// The edit in the subblock of the raw block is a unit of the same call block (*my:* text of the
// subblock is part of the text of the block, the atoms are in it); the result (code_parse of the
// subblock by the standard parsing) is recalculated at the next analysis. Broken brackets of the
// subblock - a mark in place inside the block; fixed - again the block.
// program: 173_raw_sub_blocks.tz
open_view module
run
// expect: output text="first\n12\nsecond\n5\n7\n" ok=true
// let: blk @print(1
pointer 1 @print(1 0 21
key 1 3
// expect: node=$blk nodes=⏎  id=$blk kind="n_raw" pieces=["{\n    first { print(13 ~ 2); }\n
// expect: курсор:     first { print(13‸ ~ 2); }
run
// expect: output text="first\n132\nsecond\n5\n7\n" ok=true
key 1 Backspace
key 1 Backspace
key 1 Backspace
// `)` without a pair - the draft of the element is disassembled whole, the block is the same
// node, the error is in place inside the block
// expect: kind="n_raw" pieces=["{\n    first { print ~ 2); }\n
idle
// expect: kind="error" text="исполнение неразобранного фрагмента: непарная скобка
// expect: from=14 to=25
// let: blk2 @first
key 1 (
// expect: node=$blk2 nodes=⏎  id=$blk2 kind="n_raw" pieces=["{\n    first { print( ~ 2); }\n
// expect-not: kind="n_block"
key 1 4
run
// expect: output text="first\n42\nsecond\n5\n7\n" ok=true
