// args: abc
// out: before
// out: load failed
// Семантический инлайн: return(caller) в теле try выходит из load, а не из try.
try(expr e) {
  r = e;
  if(r.is_err()) return(caller) r;
  r.value
}

load(s) {
  v = try(parse_int(s));
  print("after");
  v
}

main() {
  print("before");
  r = load(args[1]);
  if(r.is_err()) print("load failed");
}
