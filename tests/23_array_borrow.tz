// jit-compiled: sum
// jit-compiled: first_to
// out: [1, 2, 3] [9, 2, 3]
// out: [1, 2, 3]
// out: [[1, 2, 3], [1, 2, 3]] [7, 2, 3]
// out: 6
// out: [5, 2, 3]
// machine
// Массив-место передаётся заёмным видом ячейки вызывающего, без копии и без
// счётчиков ссылок 
// Копия внутри функции, возврат
// параметра и сохранение его в другом массиве — самостоятельные значения.
local_copy(a) {
  b = a;
  b[0] = 9;
  print(a, b);
}

same(a) => a

keep(a) {
  box = array{a, a};
  box
}

sum(a) {
  s = 0;
  for(i : range(a.size)) s += a[i];
  s
}

first_to(mut a, v) { a[0] = v; }

main() {
  xs = array{1, 2, 3};
  local_copy(xs);
  ys = same(xs);
  print(ys);
  box = keep(xs);
  xs[0] = 7;
  print(box, xs);
  xs[0] = 1;
  print(sum(xs));
  first_to(xs, 5);
  print(xs);
}
