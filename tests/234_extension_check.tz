// out: 3 3 6
// machine
// fmt-stable
// Своя проверка расширений (§9.1): [[extension(has_x)]] у объявления оператора —
// has_x исполняется при разборе на каждую его перегрузку (и на свои: решает сама
// проверка). Условный тест: перегрузка <+> — только для типов с полем x. 
// 
//. Ошибочная перегрузка — тест 235.
[[extension(has_x)]] operator (a) <+> (b) => a + b;

struct pt {
  i64 x;
}
struct pt3 {
  i64 x;
  i64 y;
}
operator (pt a) <+> (pt b) => pt{a.x + b.x};
operator (pt3 a) <+> (pt3 b) => pt3{a.x + b.x, a.y + b.y};

// у каждого типизированного параметра перегрузки — поле x
has_x(ext, entity) {
  ok = true;
  if(code_kind(ext) == ast.function) {
    ast.function{_, params, _, _, _, _, _, _, _} = ext;
    for(p : params) {
      ast.parameter{_, t, _, _, _, _, _} = p;
      if(given(t)) {
        if(!has_field(type_of_code(t), "x")) ok = false;
      }
    }
  }
  require(ok, code_name(entity) + ": перегрузка только для типов с полем x", "оператор объявлен здесь", entity);
}
has_field(T, str name) {
  found = false;
  for(f : fields(T)) if(f.name == name) found = true;
  found
}

main() {
  print(1 <+> 2, (pt{1} <+> pt{2}).x, (pt3{1, 2} <+> pt3{3, 4}).y);
}
