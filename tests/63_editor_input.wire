// Ввод в редакторе (M5, §13.1): клавиша — управляющий сигнал VM. Текст элемента
// модуля, который правят, — черновик: ровно как набран, каждая клавиша его
// разбирает (решение автора 2026-10-12); недописанное — дыры своих строк:
//  
// Канон — при уходе из элемента. Изменение получают все клиенты —
// состояние одно; элемент в чужом черновике не правится.
// program: editor_text.vish
open_view module
[2] open_view module
[2] pointer 1 @print 0 2
// expect: курсор:   pr‸int(s);
// набор внутри строки: черновик элемента разобран целиком, id узлов — те же;
// обновление — самое узкое (только строка)
pointer 1 @привет 0 7
key 1 !
// expect: update view=1
// expect: kind="n_str" pieces=["\"привет!, мир\""]
// expect: курсор:   s = "привет!‸, мир";
// второй клиент получил правку, его курсор остался на своём месте
// expect: другому клиенту:
// expect: курсор:   pr‸int(s);
// черновик — текст как набран: пробелы и `;` ставит человек; второму — канон
key 1 End
key 1 y
key 1 =
key 1 2
key 1 ;
// expect-not: kind="n_hole"
// expect: другому клиенту:
// expect:   y = 2;
key 1 \s
// expect: курсор:   s = "привет!, мир";y=2; ‸
// уход из элемента (Escape) — канон: пробелы ставит проекция
key 1 Escape
// expect: курсор:   y = 2;‸
// недописанное — дыра только в своей инструкции: незакрытая скобка закрывается
// по отступу (§4.1) — следующая строка разобрана; причина — примечание узла;
// Enter — с отступом строки
key 1 Enter
key 1 (
// expect: kind="n_hole" pieces=["("] note="незакрытая скобка"
// expect: kind="n_call" pieces=[#
// expect: курсор:   (‸
key 1 Backspace
// expect-not: n_hole
// expect: курсор:   ‸
// скобку существующей функции отдельно не стереть — только функцию целиком (O16): 
//  
// 
pointer 1 @main 0 7
key 1 Delete
// expect: error text="скобку существующего узла не стереть отдельно
// expect-not: n_hole
// элемент в черновике первого клиента: второму — отказ
[2] key 1 x
// expect: элемент правит другой клиент
// чёлка (кадр «Два клиента»): чей черновик и когда элемент откроется
// expect: status kind="locked" text="элемент правит другой клиент" hint="ваша клавиша не применена — main откроется, когда клиент 1 закончит"
// первый ушёл из элемента — второй правит, первому приходит изменение
key 1 Escape
[2] pointer 1 @print 0 2
[2] key 1 x
// expect: курсор:   prx‸int(s);
// expect: другому клиенту:
// expect: prxint(s);
// края: Backspace в начале — ничего; Ctrl+буква — не ввод
pointer 1 @Программа 0 0
key 1 Backspace
// expect: курсор: ‸// Программа для сценария 62
key 1 q 2
// expect: клавиша не обработана: q
