// Объявления записями (§4.5, шаг 11.3): второй язык объявляет те же функции и struct.
// 
//  и 
// 
// Записи — в geo/words.tz: define #name (params, ...) {body},
// define #name (params, ...) means {e};, record #name {fields}; #name — голое имя,
// #params — параметры, {fields} — поля, как у struct. Чего второй язык не умеет
// (оператор, клаузы, тип результата), печатается базовым языком — тот же узел.
// fmt-stable
// fmt-has: define sq(x) means x * x;
// fmt-has: define total(xs) {
// fmt-has: record point { f64 x; f64 y = 2.0; }
// fmt-has: record size { i64 w; i64 h; }
// fmt-has: define each(n) means n + 1;
// fmt-has: operator (point a) + (point b) => point{a.x + b.x, a.y + b.y};
// fmt-has: i64 half(i64 v) => v / 2;
// fmt-has:   define twice(i64 v) means v + v;
// jit-compiled: total
// machine
// out: 9 6 8 3.0 12
// out: 4.0 3 2
use geo.words;

define sq(x) means x * x;
define total(xs) {
  s = 0;
  each (x) in (xs) s += x;
  s
}
record point { f64 x; f64 y = 2.0; }
struct size { i64 w; i64 h; } // базовая запись — печать словами
operator (point a) + (point b) => point{a.x + b.x, a.y + b.y};
i64 half(i64 v) => v / 2; // тип результата — второму языку не по силам
define each(n) means n + 1; // имя — слово проекции: дальше each — эта функция

main() {
  define twice(i64 v) means v + v;
  p = point{1.0};
  s = size{3, 4};
  print(sq(3), total(array{1, 2, 3}), twice(4), p.x + p.y, s.w * s.h);
  q = p + p;
  print(q.y, each(2), half(4));
}
