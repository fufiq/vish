// out: 1 102 30
// out: 4
// machine
// fmt-stable
// Свои и чужие расширения (§9.1): у geo.typed — [[extension(same_module_types)]].
// Своё (show(i64) в самом модуле) проходит проверку как своё; чужое — перегрузка
// show(box) программы — разрешено, потому что использует тип своего модуля (box).
// 
// Alien for alien types - test 237.
//
use geo.typed;

struct box {
  i64 v;
}

show(box b) => b.v * 10;

// Expansion field of its type is also not entity geo.typed extension: no check
box {
  i64 w;
}

main() {
  print(show(cell{1}), show(2), show(box{3, 4}));
  print(box{3, 4}.w);
}
