// out: [1, 2] 6 [1, 2] 6
// machine
// fmt-stable
// Поле в изменяемый параметр — как переменная: «параметр — алиас», изменение
// выводится.
// Было: b.xs и b.n передавались копией. Изменение через вызов a.f(b) ≡ f(a, b) тоже
// выводится (ys.push(y)). *Моё:* интерпретатор — копия на входе и запись в поле на
// выходе (без ссылки внутрь агрегата), машина — алиас по номеру поля.
struct box { array xs; i64 n; }
add(ys, y) { ys.push(y); }
bump(k) { k = k + 1; }

main() {
  b = box{array{1}, 5};
  add(b.xs, 2);
  bump(b.n);
  v = array{1};
  add(v, 2);
  m = 5;
  bump(m);
  print(b.xs, b.n, v, m);
}
