// error: все файберы ждут друг друга (взаимная блокировка)
// error: неизвестная функция range(str)
// error: в gen
// error: непойманное исключение i64: 5
// machine
// Файбер упал, поток не закрыт — main встаёт во взаимной блокировке. Ошибка
// программы — обе: блокировка на месте ожидания и ошибки файберов со своими трейсами
// (решение автора 2026-10-25):
// 
//.
gen(s, n) {
  for(i : range(n)) write(s, i);
  close(s);
}

main() {
  s = stream(4);
  spawn { gen(s, "10"); }
  spawn { throw 5; }
  t = 0;
  for(x : s) t += x;
  print(t);
}
