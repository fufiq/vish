// out: читаю a
// out: в блоке
// out: закрыт b
// out: c = a
// out: закрыт врем
// out: d d'
// out: закрыт a
// out: конец
// out: закрыт p2
// out: закрыт p1
// out: закрыт d'
// out: закрыт d
// out: закрыт c2
// fmt-stable
// Деструктор — часть «статического гц» 
// destroy(T x) у ресурса T вызывается в конце области (обратный
// порядок, поля — после хозяина), у перезаписанного и у отброшенного временного. Перенос —
// по использованию, без пометок: 
// c = a (a дальше не читается) —
// перенос; e = d (d читается) — copy(T), объявленный программой: глубокое копирование — 
// сам язык поля не обходит.
struct file { str name; }
destroy(file f) { print("закрыт", f.name); }
copy(file f) => file{f.name + "'"};
struct pair { file a; file b; }
mk(str n) => file{n};
use(file f) => print("читаю", f.name);
main() {
  a = mk("a");
  use(a);
  {
    b = mk("b");
    print("в блоке");
  }
  c = a;
  print("c =", c.name);
  mk("врем");
  d = mk("d");
  e = d;
  print(d.name, e.name);
  p = pair{mk("p1"), mk("p2")};
  c = mk("c2");
  print("конец");
}
