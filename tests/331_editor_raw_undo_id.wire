key 1 z 2
// expect: node=$blk nodes=⏎  id=$blk kind="n_raw" pieces=["{\n    first { print(1 ~ 2); }\n    second {\n      x += 4;
// repeat
key 1 y 2
// expect: node=$blk nodes=⏎  id=$blk kind="n_raw" pieces=["{\n    first { print(1 ~ 2); }\n    second {\n      x += 41;
run
