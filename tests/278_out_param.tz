// out: 3 4
// out: [0, 1, 4, 9]
// out: [0, 1]
// machine
// fmt-stable
// out-параметр — место результата у вызывающего (§6.2, R13): 
// 
// 
// Имя аргумента — место: нет у вызывающего — объявляется,
// прежнее значение уходит; функция строит значение на месте; читать до записи нельзя, к
// выходу записано на всех путях (тест 279).
struct point { i64 x; i64 y; }
make(i64 k, out p) { p = point{k, k + 1}; }
fill_sq(i64 n, out xs) {
  xs = array{};
  for(i : range(n)) xs.push(i * i);
}
main() {
  make(3, q);
  print(q.x, q.y);
  fill_sq(4, ys);
  print(ys);
  ys.push(100);
  fill_sq(2, ys);
  print(ys);
}
