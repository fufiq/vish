// error: 238_extension_field_error.tz:10:1: ошибка: pt: расширять сущности модуля geo.shapes можно только в нём (own_only)
// Контроль у отдельной сущности (§9.1): [[extension(own_only)]] у struct pt модуля
// geo.shapes — поле, добавленное расширением pt { … } вне модуля, отвергается на
// объявлении расширения. area того же модуля без контроля — её перегрузка своим
// типом проходит (ошибка — только у pt).
use geo.shapes;

area(i64 n) => n;

pt {
  i64 z;
}

main() {
  print(area(pt{2, 3}), area(4));
}
