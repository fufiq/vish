// программы (было:).
ct k = 3;
ct i = 7;

total(n) {
  s = 0;
  for(x : range(n)) s = s + x;
  s
}

main() {
  s = 0;
  for(x : array{1, 2, 3}) s = s + x;
  print(s, k, total(5));
