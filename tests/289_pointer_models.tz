// out: 1 2 30 4
// out: 3 20 10
// out: 7 8
// machine
// fmt-stable
// Модели указателей: 
// 
// push — эффект группы «relocate»; ломает ли он ссылку — решает модель
// опоры. pin(xs) — бесконечный вектор (свой диапазон адресов): рост не переезд, ссылка жива.
// Своя модель «я-я» (ничего не ломает:) —
// программа берёт ответственность явно; при исполнении остаётся проверка поколения реализации.
pinned_ref() {
  xs = array{1, 2, 3};
  pin(xs);
  &e = xs[2];
  xs.push(4);
  e = 30;
  print(xs[0], xs[1], xs[2], xs[3]);
}
// своя операция объявляет эффект relocate (как push), но данных не двигает: в модели по
// умолчанию — ошибка разбора, в модели «я-я» — можно
[[relocates(xs)]] swap_ends(mut xs) {
  t = xs[0];
  xs[0] = xs[xs.size - 1];
  xs[xs.size - 1] = t;
}
ya_ya() => pointer_model{"я-я", array{}};
own_model() {
  ys = array{10, 20, 3};
  with_model(ys, ya_ya());
  &f = ys[1];
  swap_ends(ys);
  print(ys[0], f, ys[2]);
}
// своя группа эффекта: «compact» ломает ссылки только в модели, которая его называет (тест 290);
// модель по умолчанию его не знает
[[effect(xs, "compact")]] squeeze(mut xs) {}
own_effect() {
  zs = array{7, 8};
  &g = zs[1];
  squeeze(zs);
  print(zs[0], g);
}
main() {
  pinned_ref();
  own_model();
  own_effect();
}
