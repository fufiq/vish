// Вытеснение (шаг 12.2): 
// 
//  — поэтому не сигнал, а
// кооперативный уход в безопасной точке (обратное ребро цикла, вызов), когда квант кончился,
// а другие готовы. Вытесняются только фоновые процессы (process(f, …)), без JIT: 
// Монопольный — сама программа и её
// файберы — не вытесняется никогда (решение автора 2026-10-19): A и B — файберы фонового
// процесса (его полоса — свой поток хоста, шаг 12.3b), их циклы чередуются; C и D — файберы
// программы, идут по очереди целиком. Квант здесь — 150 итераций (quantum:, детерминированно),
// по умолчанию — 10 мс.
// quantum: 150
// machine
// out: A 0
// out: A 100
// out: B 0
// out: B 100
// out: A 200
// out: B 200
// out: C 0
// out: C 100
// out: C 200
// out: D 0
// out: D 100
// out: D 200
// out: конец
busy(str name, i64 n) {
  s = 0;
  for(i : range(n)) {
    s += i;
    if((i % 100) == 0) print(name, i);
  }
}
// фоновый процесс: A и B — его файберы, в очереди его полосы по порядку; квант их чередует
two(done) {
  spawn { busy("A", 300); write(done, 1); }
  spawn { busy("B", 300); write(done, 1); }
  read(done);
  read(done);
}
main() {
  p = process(two, stream());
  wait(p);
  spawn { busy("C", 300); }
  spawn { busy("D", 300); }
  yield(); // C и D — целиком, по очереди: монопольного не вытесняют
  print("конец");
}
