// Process from the background process (step 12 debt): The process takes the elaboration of the VM root -
// the same code, the same results (ct-values, ct instance), the base does not change, so it starts and
// the background band; it goes in it. Error attachment - its outcome, as in any process.
//
// machine
// out: внутренний: фоновый 7
// out: внутренний упал: индекс 3 вне границ массива размера 1
// out: внешний готов
// out: конец
ct limit = 7;
inner(to) => write(to, "внутренний: " + process_class() + " " + text(limit));
broken(i64 k) {
  xs = array{};
  for(i : range(k)) xs.push(i);
  print(xs[3]);
}
outer(to) {
  p = process(inner, to);
  wait(p);
  q = process(broken, args.size);
  if(!wait(q)) write(to, "внутренний упал: " + error(q));
  write(to, "внешний готов");
}
main() {
  s = stream();
  p = process(outer, s);
  print(read(s));
  print(read(s));
  print(read(s));
  wait(p);
  print("конец");
}
