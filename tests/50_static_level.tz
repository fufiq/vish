// args: 3
// out: 6 4 0
// check: статичность экземпляров:
// check: sum(рт array<i64>): всё доказано статически
// check: pick(кт, рт i64): рт-проверок 1, исключений 1
// check: out_of_bounds
// Уровень статичности выводится (§12.3, M2e): 
//,
//  
// Требование — обычный require над значением static_level(f).
sum(auto xs) {
  auto s = 0;
  for(auto i : range(xs.size)) s += xs[i];
  s
}

pick(auto xs, auto i) => xs[i];

ct {
  auto l = static_level(sum);
  require(l.checks == 0);
  require(l.throws == 0);
}

main() {
  auto n = parse_int(args[1]).value;
  auto xs = fill(n, 2);
  print(sum(xs), pick(array{1, 4}, n - 2), static_level(pick).checks - 1);
}
