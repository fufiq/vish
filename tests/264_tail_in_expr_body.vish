// out: 1
// out: 2
// out: 4 0 7
// machine
// fmt-stable
// store-roundtrip
// Хвост-инструкция конструкции в конце тела `=> e` (g() => if(c) for(x : xs) s;) съедает
// `;` — она же конец объявления. Было: флаг «хвост закончил инструкцию» доживал до
// следующей, и `h(i64 x) => k(…)` разбиралось как `h => k;` плюс отдельная инструкция
// (в компиляторе на языке — «неизвестное имя» в теле so/sb, 2026-10-17). Печать — без `;;`.
f() {
  show(xs) => if(xs.size > 0) for(x : xs) print(x);
  dec(i64 x) => keep(if(x >= 1) x - 1 else x);
  keep(i64 y) => y;
  show(array{1, 2});
  array{dec(5), dec(0), keep(7)}
}

main() {
  array{a, b, c} = f();
  print(a, b, c);
}
