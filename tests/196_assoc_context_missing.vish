// check-error: цепочка операторов неоднозначна
// out: 5
// error: цепочка операторов неоднозначна
// The same `a - b - c`, but [[associative]] is declared in a different context: here it
// is not visible - brutes find two trees, you need brackets.
minus3(i64 a, i64 b, i64 c) {
  [[associative]] operator (i64 x) - (i64 y) => sub(x, y);
  a - b - c
}

plain3(i64 a, i64 b, i64 c) => a - b - c;

main() {
  print(minus3(10, 3, 2));
  print(plain3(10, 3, 2));
}
