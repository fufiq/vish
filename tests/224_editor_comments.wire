// Комментарии в редакторе (§4.0, решение автора 2026-10-05 — в языке): они —
// часть проекции (текст контекста между элементами), в базе — при элементе.
// Правка строки кода оставляет её комментарии; правка внутри комментария
// переразбирает блок — комментарий меняется, код цел; строка, ставшая
// комментарием, — комментарий перед следующей. Текст клиента сверяется с проекцией.
// program: editor_comments.tz
open_view module
// expect:   // перед строкой⏎  x = 1; // хвост⏎  y = 2;
// expect:   // в конце⏎}
// правка кода строки — хвост остаётся
pointer 1 @1 0 1
key 1 2
// expect:   // перед строкой⏎  x = 12; // хвост⏎  y = 2;
// правка внутри комментария — блок переразбирается, код тот же
pointer 1 @перед 0 20
key 1 !
// expect:   // перед строкой!⏎  x = 12; // хвост⏎  y = 2;
// expect:   // в конце⏎}
// строка, ставшая комментарием, — комментарий перед следующим элементом
pointer 1 @y 0 0
key 1 End
key 1 Enter
key 1 /
key 1 /
key 1 \s
key 1 б
// (`;` недописанной строки `/` остаётся в тексте комментария — долг)
// expect:   y = 2;⏎  // б;⏎  print(x + y);
// expect: курсор:   // б‸;
