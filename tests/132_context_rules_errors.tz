// error: 132_context_rules_errors.tz:15:9: ошибка: ожидалось ';'
// error: 132_context_rules_errors.tz:35:9: ошибка: ожидалось ';'
// error: 132_context_rules_errors.tz:37:11: ошибка: ожидалось ';'
// fmt-has: /* дыра: ожидалось ';' */ twice { n += 1; }
// fmt-has: /* дыра: ожидалось ';' */ again { k += 100; }
// fmt-has: /* дыра: ожидалось ';' */ again { k += 10; }
// Контексты разбора (§4.4): правило действует от объявления до конца своего
// контекста — не выше по тексту и не снаружи. 
// 
// Не по правилам места — дыра.

// syntax twice объявлен ниже — здесь записи нет
early() {
  n = 0;
  twice { n += 1; }
  n
}

syntax twice {body} => {
  body;
  body;
};

// конструкция блока не видна снаружи блока
local() {
  k = 0;
  {
    i64 again(expr body) {
      body;
      body;
      0
    }
    again { k += 1; }
  }
  again { k += 10; }
  {
    again { k += 100; }
  }
  k
}

main() {
  n = 0;
  twice { n += 1; }
  print(early(), local(), n);
}
