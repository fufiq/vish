// out: 1
// out: -1 -1 3
// out: 0
// out: 1
// machine
// fmt-stable
// store-roundtrip
// Инструкция, кончающаяся блоком, кончается на `}`: следующая строка `-1` — новая
// инструкция, а не минус к циклу. 
// Тело `=> e` — инструкция: хвост конструкции в его начале
// (g => for(x: xs) s;), как у ветки if без скобок (решение автора 2026-10-11).
f(xs) {
  for(x : xs) {
    print(x);
  }
  -1
}

g() {
  loop {
    break;
  }
  -1
}

show(xs) => for(x : xs) print(x);
count(xs) => xs.size;

main() {
  print(f(array{1}), g(), count(array{1, 2, 3}));
  show(array{0, 1});
}
