// out: 0
// error: 194_empty_literal_errors.tz:17:9: ошибка: нет перегрузки len2 для этих значений
// error: кандидат len2({x: a, y: b}): аргумент 1 не распаковывается в {x: a, y: b}
// check-error: не распаковывается в {x: a, y: b}
// {} становится только тем, у чего есть значение по умолчанию (struct с полями по
// умолчанию, i64, f64 — как zero(T)); образец-параметр {x: a, y: b} не подходит
// агрегату без поля y — нет перегрузки (а не ошибка обращения).
struct strict { i64 a; }
struct opt { i64 a = 0; }

len2({x: a, y: b}) => (a * a) + (b * b);
use_opt(opt o) => o.a;

main() {
  print(use_opt({}));
  // strict s = {}; — ошибка: не задано поле a
  print(len2({x: 1}));
}
