// error: уровень памяти освобождается, а в нём живут значения (1)
// Значение из региона пережило бы его (результат тела with_alloc уходит наружу) — ошибка с
// трейсом, не висячая память. Присваивание внешнему имени в теле — копия в его память, не
// утечка. Входы — из args: иначе вызов свёрнут при разборе и региона при исполнении нет.
leak(i64 n) {
  r = region();
  with_alloc(r) { array{n, 2, 3} }
}
main() { print(leak(args.size)); }
