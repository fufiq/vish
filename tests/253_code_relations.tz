// machine
// Связи кода в языке (§7.4, решение автора 2026-10-17): кто вызывает функцию, что
// она вызывает, от чего зависит, кто использует имя. 
//.
// out: вызывают sq: 2
// out: - sq(3)
// out: - sq(a)
// out: main вызывает: 12
// out: - зависит от ast.function sq
// out: - зависит от ast.function seen
// out: - зависит от ast.function vals
// out: - зависит от ast.function inst
// out: a объявлена: a
// out: - a используется: sq(a)
// out: - a используется: print(a, b)
// out: перегрузки sq(3): 1
// out: 9 82
// out: 1 [6.25] [sq(кт)]
// out: [i64]
sq(x) => x * x;

// факты разбора: типы, значения и экземпляры — у разобранного до места (в каноническом
// порядке инстанцирования); при исполнении вне ct — свой разбор программы
seen() => ct { code_types(code_callers(code(sq))[0]).size };
vals() => ct { code_values(code_callers(code(sq))[2]) };
inst() => ct { code_instances(code(sq)) };

main() {
  a = sq(3);
  b = sq(a) + 1;
  print(a, b);
  c = sq(2.5);
  print(seen(), vals(), inst());
  print(code_types(code_callers(code(sq))[0]));
}

ct {
  f = code(sq);
  print("вызывают sq:", code_callers(f).size - 1);
  for(c : code_callers(f))
    if(code_text(c) != "sq(2.5)") print("-", code_text(c));
  m = code(main);
  print("main вызывает:", code_calls(m).size);
  for(d : code_deps(m)) print("- зависит от", code_kind(d), code_name(d));
  body = code_items(m)[0];
  decl = code_items(code_items(body)[0])[0]; // a = sq(3): имя a — объявление
  print("a объявлена:", code_text(code_declaration(decl)));
  for(u : code_users(decl)) print("- a используется:", code_text(code_parent(u)));
  print("перегрузки sq(3):", code_targets(code_callers(f)[0]).size);
}
