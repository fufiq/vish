// out: 25 25 2
// out: 9
// machine
// fmt-stable
// Квалифицированное имя — функция модуля по ключу: geo.inner.sq(…) без use (модуль берётся
// по имени, названному целиком: файл geo/inner.tz). Изоляция подмодулей не прячет то, что
// названо полностью; неквалифицированно sq здесь не видна (тест 293).
use geo.outer;
main() {
  print(norm(3, 4), geo.inner.sq(5), geo.outer.norm(1, 1));
  print(geo.inner.sq(3));
}
