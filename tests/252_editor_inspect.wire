// AST Inspector (§13.1): what is and who is disassembled. The tree of the module element: the
// place in the parent is the node field and the syntax recording parameter, or the structure
// that it became; who disassembled the node; instance types. node disclosure at the cursor:
// the record is which piece became what it turned into and what it turned into; the design is
// its body with the arguments set up.
// 
//.
// program: editor_inspect.tz
open_view module
// the ad is the type and value at this moment, not future: k = 0, later k + = 1
// expect: kind="type" text="i64 = 0"
// expect-not: text="i64 = 0 | 2"
// design challenge: arguments - its parameters, disclosure - body with substitution
inspect 1 @when:2
// expect: kind="ast.call" text="" rule="конструкция when(c, expr yes) otherwise(expr no)" rule_at=#
// expect: role="args[0] → c" kind="ast.operation" text=">"
// expect: role="args[2] → otherwise: no" kind="ast.block"
// expect: kind="параметр" text="c = n > 2"
// expect: kind="раскрытие" text="if(n > 2) {\n  10\n} else {\n  20\n}"
// function call - selected overload
// expect: rule="вызов pair(a, b)"
// Syntax recording of the program: block - its parameter
// expect: kind="ast.int" text="2" rule="" rule_at=· types="i64 = 2"
inspect 1 @twice:2
// expect: kind="ast.call" text="" rule="запись syntax twice {body}" rule_at=#
// expect: role="args[0] → body" kind="ast.block"
// expect: kind="итог" text="ast.call{callee: twice, args[0]: {\n  k += 1;\n}}"
// prelude: if is an ast.if node, its fields are write parameters
inspect 1 @if:2
// expect: kind="ast.if" text="" rule="запись syntax if (c) {then_}" rule_at=#
// expect: role="cond → c" kind="ast.operation" text=">"
// expect: role="then → then_" kind="ast.call"
// expect: kind="итог" text="ast.if{cond: k > 1, then: print(k)}"
// Types - with values known in compilation (compile-time): pair(1, 2) folded into 3
// expect: role="args[1]" kind="ast.call" text="" rule="вызов pair(a, b)"
// expect: types="i64 = 3"
