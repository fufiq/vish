// out: {x: 1.0, y: 2.0} 1.0 {x: f64, y: f64}
// out: true false
// out: x f64
// out: y f64
// out: {name: box, size: {w: 2, h: 3}} 3 {name: str, size: {w: i64, h: i64}}
// out: 1.0 box 3
// out: да 2.0
// out: нет
// machine
// fmt-stable
// store-roundtrip
// Анонимный структурный литерал {имя: выражение, …} (§4.3): тип — по структуре (имена и
// типы полей по порядку), где тип не ожидается — остаётся анонимным. 
// 
// 
// 
//.
main() {
  p = {x: 1.0, y: 2.0};
  print(p, p.x, typeof(p));
  // one structure, one type
  print(typeof(p) == typeof({x: 3.0, y: 4.0}), typeof(p) == typeof({y: 4.0, x: 3.0}));
  for(f : fields(typeof(p))) print(f.name, f.type);
  b = {name: "box", size: {w: 2, h: 3}};
  print(b, b.size.h, typeof(b));
  // field sample by name: {x: a, y: b} = v (for any aggregate)
  {x: a} = p;
  {name: n, size: {h: h}} = b;
  print(a, n, h);
  if({x: (1.0), y: c} = p) print("да", c);
  else print("нет");
  if({x: (5.0)} = p) print("да");
  else print("нет");
}
