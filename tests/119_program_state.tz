// out: 1 [10] note{n: 1, text: запуск 1}
// out2: 2 [10, 20] note{n: 2, text: запуск 2}
// Состояние программы (§12.2): [[state]] x = e — корень в энергонезависимом уровне,
// файл держит VM (у программы путей нет), страницы — на тех же адресах; второй запуск
// видит значения первого. 
//.
struct note { i64 n; str text; }
[[state]] runs = 0;
[[state]] log = array{};
[[state]] last = note{0, "нет"};
main() {
  runs = runs + 1;
  log.push(runs * 10);
  last = note{runs, "запуск " + text(runs)};
  print(runs, log, last);
}
