// VM services:
// 
// [[service]] module
// svc.keys — сервис: его переменные — одно состояние на VM; программа и её фоновые процессы
// (другая полоса) зовут его обычным вызовом и держат дескрипторы key (данные: передаются между
// процессами), а не байты. Процесс, перенесённый в другую VM, приносит дескрипторы, но не
// состояние сервиса: 
// — там ключ неизвестен.
// machine
// machine-dump: 120
// out: программа/10
// out: фон/10
// out: фон2/17
// out: ключей 2
// dump-out: программа/10
// dump-out: фон/неизвестный ключ
// dump-out: фон2/17
// dump-out: ключей 1
use svc.keys;
worker(key k, to) {
  write(to, seal(k, "фон"));
  m = make_key("ещё тайна");
  write(to, seal(m, "фон2"));
}
main() {
  k = make_key("тайна");
  print(seal(k, "программа"));
  s = stream();
  p = process(worker, k, s);
  print(read(s));
  print(read(s));
  wait(p);
  print("ключей", keys_count());
}
