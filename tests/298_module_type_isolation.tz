// Изоляция подмодулей — и для имён типов и переменных модулей (хвост шага 10): 
// 
// Имя struct
// (тип параметра и переменной, Имя{…}, образец, значение-тип) и переменная модуля видны,
// если объявлены в своём модуле, в прелюдии или в модуле, который берут use напрямую.
// Значение типа идёт через функции и без имени: x.v, печать.
// machine
// out: 15 7 cell{v: 15}
// out: 3 true 7
use geo.wrap;

through() {
  x = wrapped(8); // значение типа cell — имя не нужно
  print(x.v, depth_of(), x);
}

main() {
  through();
  seen();
}

use geo.deep; // свой use: имена geo.deep видны модулю программы (не по месту — правила разбора по месту)
seen() {
  c = cell{3};
  cell{v} = c;
  print(v, typeof(c) == cell, depth);
}
