// String parameters of machine code (§10.3, 2026-10-31): a string is its type instance `str` (the address
// of the VM cell; length and bytes are by displacements of the VM, as in the variable string), rather than
// a sample of the VM value; checking AArch64 (--a64) transfers its bytes to guest memory. Substring search,
// subsequence, byte cycles, binary search - machine code (copies of tools and editor functions). Native
// (text) is a VM node within the function code. A node whose type parsing does not know ("?: an empty array
// {} element of a variable service) is a failure, a function is a function to the interpreter: the cell
// address as bool is always true.
//.
// jit-compiled: find_from
// jit-compiled: subsequence
// jit-compiled: escape_from
// jit-compiled: lower_bound
// jit-compiled: digit_count
// jit-stats: jit  find_from(str, str, i64)
// jit-stats: jit  subsequence(str, str)
// jit-stats: jit  lower_bound(array<i64>, i64)
// jit-stats: completing(i64): компилятор языка: нет кодогенератора .on над ?: тип узла неизвестен разбору
// out: 6 -1 0 3
// out: true false true
// out: 1 -1 2
// out: 2 4
// out: 3 4
// out: false true
use svc.views;
find_from(str s, str part, i64 from) {
  m = part.size;
  if(m == 0) return from;
  c = part[0];
  end = s.size - m;
  k = from;
  while(k <= end) {
    if(s[k] == c) {
      j = 1;
      while((j < m) && (s[k + j] == part[j])) j += 1;
      if(j == m) return k;
    }
    k += 1;
  }
  -1
}
subsequence(str s, str w) {
  k = 0;
  for(i : range(s.size)) if((k < w.size) && (s[i] == w[k])) k += 1;
  k == w.size
}
escape_from(str s, i64 from) {
  k = from;
  while(k < s.size) {
    c = s[k];
    if((c == 34) || ((c == 92) || ((c == 10) || (c == 9)))) return k;
    k += 1;
  }
  -1
}
lower_bound(xs, i64 x) {
  lo = 0;
  hi = xs.size;
  while(lo < hi) {
    mid = (lo + hi) / 2;
    if(xs[mid] < x) lo = mid + 1 else hi = mid;
  }
  lo
}
// Native prelude: the string counts VM, its bytes are machine code
digit_count(i64 k) {
  s = text(k);
  n = 0;
  for(i : range(s.size)) if((s[i] >= '0') && (s[i] <= '9')) n += 1;
  n
}
main() {
  s = "hello, vish world";
  print(find_from(s, "ish", 0) - 2, find_from(s, "zz", 0), find_from(s, "", 0), find_from("aaab", "ab", 1) + 1);
  print(subsequence(s, "hvw"), subsequence(s, "wvh"), subsequence("", ""));
  print(escape_from("ab\"", 0) - 1, escape_from("plain", 0), escape_from("x\ny\tz", 2) - 1);
  print(lower_bound(array{1, 3, 5, 7}, 4), lower_bound(array{1, 3, 5, 7}, 9));
  print(digit_count(-123), digit_count(1000));
  add_view();
  print(completing(0), {
    turn_on(0);
    completing(0)
  });
}
