// Слишком глубокая рекурсия (не в хвосте) — исключение stack_overflow, а не падение VM: «нет UB»
// (R20). VM смотрит, сколько осталось стека исполнения (у потока и у файбера своего), и на
// последних мегабайтах даёт ошибку языка — её ловят, как любую ошибку VM. Глубина — свойство
// движка (машинный код тратит стек иначе, машине процессов стек хоста не нужен), поэтому
// сверки с ними нет. Трасса одинаковых кадров — одной строкой (×N).
// no-jit
// out: поймал: stack_overflow
// out: в файбере: stack_overflow
// out: живы
sum(i64 n) => if(n == 0) 0 else n + sum(n - 1);
main() {
  try { print(sum(args.size * 1000000)); } catch(stack_overflow e) { print("поймал: stack_overflow"); }
  s = stream();
  spawn {
    try { write(s, sum(args.size * 1000000)); } catch(vm_error e) { write(s, -1); }
  }
  if(read(s) < 0) print("в файбере: stack_overflow");
  print("живы");
}
