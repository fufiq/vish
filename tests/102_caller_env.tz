// out: 3 7 8 8
// out: 12.0
// stdin: 1 2 3
// machine
// fmt-stable
// store-roundtrip
// Окружение вызова (O4): 
// 
//  (Ярик) — 
// 
// Решение автора — неявно: свободное имя тела
// ищется лексически, затем среди функций и типов модуля, затем у вызывающего и
// дальше по цепочке вызовов. *Моё:* x = e объявляет своё имя (не затирает имя
// вызывающего); экземпляр — на место вызова.
bump() {
  a += 1;
  tmp = a * 10;
}

total() => a + b;

deeper() => total();

scale(x) => x * k;

acc(xs) {
  for(i : range(xs.size)) s += scale(xs[i]);
}

main() {
  a = 1;
  tmp = 7;
  bump();
  bump();
  b = 5;
  print(a, tmp, total(), deeper());
  xs = read_floats(stdin);
  k = 2.0;
  s = 0.0;
  acc(xs);
  print(s);
}
