// out: ast.operation x += 2
// out: ast.call print(x)
// out: 3
// out: ast.name x
// machine
// fmt-stable
// store-roundtrip
// Код как значение — обход (§7.4): 
//  
// логика — на самом языке, не у хоста: 
// code(x) — узел
// выражения (у expr-параметра — код вызывающего), code_kind (тег вида узла: ast.operation, ast.if…)/items/name/text —
// операции базового языка над ним. Не токены и не строка: 
//.
syntax traced {body} => {
  for(s : code_items(code(body))) print(code_kind(s), code_text(s));
  body;
};

main() {
  x = 1;
  traced {
    x += 2;
    print(x);
  }
  print(code_kind(code(x)), code_name(code(x)));
}
