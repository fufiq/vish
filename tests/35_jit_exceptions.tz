// args: 7
// out: 21 -2 14
// out: -2 -3
// out: 99
// jit-compiled: outer
// jit-compiled: guard
// jit-stats: outer(i64) → 
// jit-stats: исключений переходом: 1
// Статические исключения в машинном коде (M2a, критерий M2): throw через
// три уровня встраивания — переход (jmp) в catch внешней функции, без таблиц
// раскрутки 
// Ошибка VM внутри try — тоже переход в catch.
// Не пойманное в машинном коде выходит «вторым путём» (как errno), дальше
// ловит интерпретатор.
level3(x) {
  if(x < 0) throw x * 2;
  x * 3
}
level2(x) => level3(x - 1) + 0
level1(x) => level2(x + 1) * 1

outer(x) {
  try { level1(x) } catch(i64 e) { e }
}

guard(d, n) {
  try { n / d } catch(div_by_zero _) { -3 }
}

escape(x) {
  if(x > 5) throw 99;
  x
}

main() {
  n = parse_int(args[1]).value;
  print(outer(n), outer((0 - n) + 6), outer(n - 0) - n);
  print(outer(0 - 1), guard(0, n));
  print(try { escape(n) } catch(i64 e) { e });
}
