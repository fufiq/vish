// args: 7
// out: {"id":7,"name":"box","size":{"w":2,"h":3}}
// fmt-stable
// store-roundtrip
// Рефлексия агрегатов вместо derive (§7.4, критерий M4): одна to_json для всех
// агрегатов — цикл по fields(T) при компиляции, поле по дескриптору v.[f].
struct size { i64 w; i64 h; }
struct item { i64 id; str name; size size; }

to_json(i64 v) => text(v);
to_json(str v) => "\"" + v + "\"";
to_json(v) {
  s = "{";
  first = true;
  for(f : fields(typeof(v))) {
    if(!first) s = s + ",";
    s = s + "\"" + f.name + "\":" + to_json(v.[f]);
    first = false;
  }
  s + "}"
}

main() {
  n = parse_int(args[1]).value;
  print(to_json(item{n, "box", size{2, 3}}));
}
