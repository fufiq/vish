// Feature layers - overload (user solutions 2026-10-26 and 2026-10-27, Layer frame): "We write a function for
// static context first, then we add dynamic layers to it ... these functions should glean general logic."
//
// The module shows one overload group and
// replaces it in place.
// program: editor_overload_layers.vish
open_view module
// first common; ‹ i/n › with neighbors and signature; other overload in the module text is not visible
// expect: kind="overloads" text="1/2|
// expect: |общая логика"
// expect-not: norm(f64 x) {
// for calls - the chip of the selected overload (number - color, signature), the call not shown - other
// expect: kind="chosen" text="1|общая логика"
// expect: kind="chosen" text="2|norm(f64 x)"
// expect: kind="other"
// Replace on the spot: f64 instead of general, "common / own" and different parts
layer 1 next:@norm
// expect: norm(f64 x) {
// expect: kind="overloads" text="2/2|
// expect: kind="common"
// expect: kind="own"
// expect: kind="own-part"
// Transition palette (frame "Transition", author's decision 2026-10-27): reasons from VM, "add" -
// explanation to "will be created" (where the name of the parameter, what is internal)
goto 1 norm(str)
// expect: name="добавить norm(str)" kind="добавить"
// expect: name="norm(x)" kind="перегрузка" detail="подходит: без типа"
// expect: context="Имя параметра — как у norm(x). Внутренняя: в базе и в исполнении, в модуле не видна. Откроется во второй панели."
key 1 Escape
// second panel still: overload f64 - switch and "shared / own" against the most common
goto 1 norm(f64)
key 1 Enter
// expect: overloads=
// expect: head="norm(x)"
// expect: head="norm(f64 x)"
// expect: overload=1
