// fmt-has: // в конце модуля
// Комментарии и пустые строки — в языке (решение автора 2026-10-05): комментарий
// — текст человека при элементе контекста (строки перед ним, хвост его строки,
// строки перед концом блока или модуля), в базе (журнал, .tzdb), а не теряется
// проекцией; исполнение его не видит. Строки комментариев — не пустые строки.
// code_comment(c) — комментарии элемента для кода на языке. Логики в комментариях
// нет:  
// *Моё:* привязка к элементу; комментарий внутри
// выражения — строкой перед элементом; срез и остаточная программа их не печатают.

struct pair { i64 a; i64 b; }

// сумма до n
sum(n) {
  s = 0; // накопитель
  // цикл

  // после пустой строки
  for(i : range(n + 1)) s += i;
  t = s + /* внутри выражения */ 0;
  t
  // в конце блока
} // после функции

/* блочный */ first() => code_comment(code(sum));

main() {
  print(sum(3));
  print(first());
}

// в конце модуля
