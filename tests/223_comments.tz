// fmt-stable
// store-roundtrip
// fmt-has: // сумма до n
// fmt-has: sum(n) {
// fmt-has:   s = 0; // накопитель
// fmt-has:   // цикл
// fmt-has:   // после пустой строки
// fmt-has:   for(i : range(n + 1)) s += i;
