// error: значение sock — ресурс: a читается дальше, а копировать его нечем
// machine
// Ресурс без copy(T) и читается после передачи — ошибка с подсказкой: перенос — только когда имя
// дальше не нужно, а копию язык сам не выдумывает 
//.
struct sock { i64 fd; }
destroy(sock s) { print("close", s.fd); }
main() {
  a = sock{1};
  b = a;
  print(a.fd, b.fd);
}
