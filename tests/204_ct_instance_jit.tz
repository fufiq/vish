// out: 300 15
// jit-compiled: scale
// jit-compiled: shift
// machine
// Код, изменённый ct-кодом экземпляра, — обычный код программы: JIT компилирует итог
// элаборации, машина процессов исполняет его. Тело scale задаёт экземпляр tune по месту
// вызова (множитель — его аргумент), тело shift — экземпляр с другим аргументом. Разбор
// элаборации — один раз: разбор экземпляров для JIT берёт её итог (ревизии те же —
// перекомпиляции нет). 
//.
scale(i64 x) => x;
shift(i64 x) => x;

tune(f, op, k) => ct {
  f.body = n_op{op, array{n_ident{"x"}, n_int{k}}};
};

main() {
  tune(code(scale), "*", 3);
  tune(code(shift), "+", 5);
  s = 0;
  for(i : range(100)) s += scale(1);
  print(s, shift(10));
}
