// out: 3 11
// out: 5 3
// machine
// fmt-stable
// «Новый вид функций»: пак аргументов и кортеж взаимозаменяемы — «foo(tuple{int x,
// ... xs}); foo(tuple{1, 2}); - ты хочешь просто преобразовать в foo(int x, ...xs);
// foo(1, 2)… Даже если запакованный тапл ты хочешь его распаковать» 
// foo(array{…}) зовётся и списком аргументов, dist(a, b) — кортежем.
// Уровень ниже прямого совпадения (моё): только если прямо не подошёл никто.
foo(array{i64 x, ...xs}) => x + xs.size;

dist(a, b) => b - a;

main() {
  print(foo(1, 2, 3), foo(array{10, 20}));
  t = array{3, 8};
  print(dist(t), dist(1, 4));
}
