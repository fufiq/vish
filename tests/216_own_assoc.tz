// out: 5
// error: geo.rules:19:31: ошибка: цепочка операторов неоднозначна
// [[associative]] у объявления «-» вне модуля с [[extension(…)]] не меняет разбор цепочек
// в его коде: ассоциативность кода модуля — из его контекста определения (он сам,
// прелюдия, его use). Своя цепочка снаружи — по своему объявлению (это работает), а
// diff3 модуля (a - b - c) остаётся неоднозначной, как без этой программы. 
// 
//. Контекст исполнения — тест 214. «-» — сущность прелюдии, не модуля:
// проверка own_only его не видит, а разбор кода модуля защищён всё равно (*моё*).
use geo.rules;

struct my {
  i64 v;
}
[[associative]] operator (my a) - (my b) => my{a.v - b.v};

main() {
  print((my{10} - my{3} - my{2}).v);
  print(diff3(10, 3, 2));
}
