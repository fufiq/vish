// Счёт ссылок shared — статический там, где он известен (хвост шага 10): 
// 
// Счёт — ячейка разбора, как
// любая другая: после блока он известен (n2 = кт 1 — shared_count свёрнут в константу
// экземпляра), после копии под рт-условием — нет (n3 = рт i64, считает исполнение).
// Перенос из параметра-алиаса решает и вызывающий: 
// — keep(a) копирует, если a читается дальше, иначе переносит. push и
// array{…} кладут ресурс в массив переносом или копией, как присваивание.
// args: 1 2 3 4 5 6 7
// machine
// jit-compiled: cnt
// jit-compiled: keep
// jit-compiled: push
// check: n2 = кт 1
// check: n3 = рт i64
// out: закрыт общий 8
// out: 213
// out: закрыт общий 2
// out: 212
// out: закрыт с 8
// out: 28
// out: в keep a'
// out: закрыт a' 0
// out: после a
// out: в keep b
// out: закрыт b 0
// out: конец
// out: закрыт a 0
struct file { str name; i64 n; }
destroy(file f) { print("закрыт", f.name, f.n); }
copy(file f) => file{f.name + "'", f.n};
work(i64 k) {
  a = shared(file{"общий", k});
  n1 = 0;
  {
    b = a;
    n1 = shared_count(a);
  }
  n2 = shared_count(a);
  xs = array{a};
  if(k > 5) xs.push(a);
  n3 = shared_count(a);
  ((n1 * 100) + (n2 * 10)) + n3
}
cnt(i64 k) { // счёт известен: b = a — копия (a читается дальше), в машинном коде — константа 2
  a = shared(file{"с", k});
  b = a;
  (shared_count(a) * 10) + b.n
}
keep(file f) {
  g = f;
  print("в keep", g.name);
}
main() {
  n = args.size;
  print(work(n));
  print(work(n - 6));
  print(cnt(n));
  a = file{"a", 0};
  keep(a); // a читается дальше — копия
  print("после", a.name);
  b = file{"b", 0};
  keep(b); // b дальше не читается — перенос: освобождает keep
  print("конец");
}
