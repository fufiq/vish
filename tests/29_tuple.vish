// args: 1
// out: tuple array i64 f64
// out: f64 2.0
// out: i64 3 f64 4.5
// out: 2
// machine
// check: t2 = рт tuple<i64, f64>
// check: u = кт [3, 4]
// check: show(рт i64)  ×
// check: show(рт f64)  ×
// check: first(рт tuple<i64, f64>)  ×1
// Array with elements of different types - tuple tuple with one type - array.
// compile-time gives the exact type of element, the run-time index splits the
// continuation by element types: foo => [T0 => bar, T1 => bar].
//
show(x) { print(typeof(x), x); }

first(p) => p[0]

main() {
  t = array{1, 2.0};
  u = array{3, 4};
  print(typeof(t), typeof(u), typeof(t[0]), typeof(t[1]));
  i = parse_int(args[1]).value;
  show(t[i]);
  t2 = if(i > 5) array{1, 2.5} else array{3, 4.5};
  a = first(t2);
  print(typeof(a), a, typeof(t2[1]), t2[1]);
  print(t2.size);
}
