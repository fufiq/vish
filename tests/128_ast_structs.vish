// out: [field{name: cond, type: code}, field{name: then, type: code}, field{name: else, type: code}]
// out: + 2 false
// out: a
// out: 12
// out: 2 100 0
// machine
// jit-compiled: show
// jit-compiled: pairsum
// jit-compiled: kind_of
// node AST - struct programs:
// 
// Advertisements are generated from structures node VM; sample ast.operation {op, xs, post} = c - checking
// the type node and its field (empty node - code without node, given - lie); predicate if(образец = v) - and
// in machine code; the size of the array of values VM (code, lines) machine code reads from the list of
// values.
show(c) {
  ast.operation{op, xs, post} = c;
  print(op, xs.size, post);
  ast.name{nm} = xs[0];
  print(nm);
}
pairsum(i64 k) {
  s = 0;
  if(array{a, b} = array{k, k * 2}) s = a + b;
  if(array{c} = array{k, 1}) s += 1000;
  s
}
kind_of(c) {
  r = 0;
  if(ast.operation{op, xs, _} = c) r = xs.size;
  if(ast.if{_, _, el} = c) r = if(given(el)) 100 else 50;
  r
}
main() {
  print(fields(ast.if));
  ast.quote{items} = quote { a + 2 };
  show(items[0]);
  print(pairsum(4));
  ast.quote{ifs} = quote { if(a) 1 else 2 };
  ast.quote{lits} = quote { 7 };
  print(kind_of(items[0]), kind_of(ifs[0]), kind_of(lits[0]));
}
