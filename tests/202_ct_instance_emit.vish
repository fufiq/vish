// out: i64: 42
// out: f64: 0.5
// out: i64: 7
// check: изменения кода ct-кодом экземпляров (элаборация):
// check: emit: 1 объявл.
// fmt-stable
// store-roundtrip
// machine
// machine-dump: 40
// fmt-ct-has: describe(i64 v) => "i64: " + text(v);
// fmt-ct-has: describe(f64 v) => "f64: " + text(v);
// Ct code generation instance (§7.4): A instance function for an argument type generates overload
// under this type - like a instantiation template.
//  
// 
// Generated instance - elements of the module after elaboration (visible to everyone: launch,
// parsing, JIT), the source is its ct-node. ct-variable: A type for which overload is already present
// is not generated a second time.
ct seen = array{"-"};

note(x) {
  ct {
    t = text(typeof(x));
    fresh = true;
    for(s : seen) if(s == t) fresh = false;
    if(fresh) {
      seen = array{...seen, t};
      f = ast.function{"describe", array{ast.parameter{"v", ast.name{t}}}};
      f.body = ast.operation{"+", array{ast.string{t + ": "}, ast.call{ast.name{"text"}, array{ast.name{"v"}}}}};
      f.expr_body = true;
      emit(f);
    }
  }
}

main() {
  note(1);
  note(2.5);
  note(3);
  print(describe(42));
  print(describe(0.5));
  print(describe(7));
}
