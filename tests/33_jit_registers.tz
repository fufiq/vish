// args: 6
// out: 10403375
// out: 720 21.0
// out: 12
// out: 2.5
// jit-compiled: many
// jit-compiled: rec
// jit-compiled: via_alias
// jit-compiled: fsum
// Регистры переменных (M1): переменных больше, чем регистров в пуле
// (5 целых, 8 f64) — лишние остаются в кадре; f64 в регистре переживает
// настоящий (рекурсивный) вызов — на время вызова уходит в слот; регистры
// вызывающего сохраняются рекурсией; переменная-регистр меняется через
// встроенную функцию (алиас)..
many(auto n) {
  auto a = 1; auto b = 2; auto c = 3; auto d = 4; auto e = 5; auto g = 6; auto h = 7;
  auto x = 0.5; auto y = 1.0; auto z = 1.5; auto u = 0.0; auto v = 0.0; auto w = 0.0;
  auto p = 0.0; auto q = 0.0; auto r = 0.0; auto t = 0.0;
  for(auto i : range(n)) {
    a += i; b += a; c += 1; d += c; e += d % 3; g += 1; h += g % 2;
    u += x; v += y; w += z; p += 0.25; q += 0.5; r += 0.125; t += 0.0625;
  }
  ((a + (b % 7) + c + d + e + g + h) * 100000) + i64(((((((u + v) - w) + p + q) - r) - t)) * 1000.0)
}

// f64 в регистре живёт через рекурсивный вызов
rec(auto n, auto acc) {
  auto k = f64(n) * 0.5;
  if(n <= 1) return acc;
  auto sub = rec(n - 1, acc * n);
  auto back = k + 0.0;
  if(back != f64(n) * 0.5) return -1;
  sub
}

bump(mut auto c, auto by) { c += by; }

via_alias(auto n) {
  auto s = 0;
  for(auto i : range(n)) bump(s, 2);
  s
}

fsum(auto xs) {
  auto s = 0.0;
  for(auto x : xs) s += x;
  s
}

main() {
  auto n = parse_int(args[1]).value;
  print(many(n));
  print(rec(n, 1), f64(rec(n, 1)) / 34.285714285714285714);
  print(via_alias(n));
  print(fsum(fill(n - 1, 0.5)));
}
