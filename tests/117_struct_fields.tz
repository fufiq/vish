// out: point{x: 7, y: 40.0, on: true}
// out: 7
// machine
// jit-compiled: move
// struct — раскладка в памяти (§12.2): поля агрегата — в страницах VM, номер поля
// статичен (порядок полей типа); машинный код читает и пишет поле i64/f64 по смещению,
// которое сообщает VM. bool и нескалярное поле — пока у VM.
struct point { i64 x; f64 y; bool on; }
move(i64 n) {
  p = point{1, 2.5, true};
  for(i : range(n)) {
    p.x = p.x + i;
    p.y = p.y * 2.0;
  }
  print(p);
  p.x
}
main() {
  print(move(4));
}
