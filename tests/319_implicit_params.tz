// Неявные параметры: 
// 
// 
//  
// implicit x — последние параметры: в вызове их не пишут, аргумент — имя x у места
// вызова (лексически, затем у вызывающих — окружение вызова); написанный явно — обычный. База —
// массив пользователей, «указатель» — узкий индекс u16.
// fmt-stable
// fmt-has: name(u16 id, implicit users) => users[i64(id)].name;
// jit-compiled: total_age
// machine
// out: Аня 31
// out: Боря
// out: 2 Вера
// out: 58
// out: Гоша
struct user { str name; i64 age; }
name(u16 id, implicit users) => users[i64(id)].name;
age(u16 id, implicit users) => users[i64(id)].age;
older(u16 a, u16 b, implicit users) => if(age(a) > age(b)) a else b; // неявный — и дальше, у вызывающего
total_age(i64 n, implicit array users) {
  s = 0;
  for(i : range(n)) s += users[i].age;
  s
}
main() {
  users = array{user{"Аня", 31}, user{"Боря", 27}};
  id = u16(0);
  print(name(id), age(id));
  print(name(older(u16(1), u16(0)) + u16(1)));
  more = array{user{"Вера", 40}, user{"Гоша", 12}};
  print(more.size, name(u16(0), more)); // явно — другая база
  print(total_age(2));
  users = more; // база — имя users у места вызова, каким оно стало
  print(name(u16(1)));
}
