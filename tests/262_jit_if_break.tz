// args: 10
// out: 45 25 17 3
// jit-compiled: sums
// if(c) break; / if(c) continue; — ветка из одного перехода: условие в контексте when с целью
// цикла, один условный переход.
sums(i64 n) {
  a = 0;
  i = 0;
  loop {
    if(i >= n) break;
    a += i;
    i += 1;
  }
  b = 0;
  j = 0;
  loop {
    j += 1;
    if(j > n) {
      break;
    }
    if((j % 2) == 0) continue;
    b += j;
  }
  c = 0;
  for(x : range(n)) {
    for(y : range(n)) {
      if(!(y < x)) break;
      if(y > 1) continue;
      c += 1;
    }
  }
  d = 0;
  k = 0;
  loop {
    k += 1;
    if(k == 4) break;
    d += 1;
  }
  print(a, b, c, d);
  a
}

main() {
  sums(parse_int(args[1]).value);
}
