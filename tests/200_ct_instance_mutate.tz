// out: вход в greet
// out: тело
// out: вход в sum
// out: 7
// out: point{x: 1, y: 2, tag: 0}
// check: изменения кода ct-кодом экземпляров (элаборация):
// fmt-stable
// store-roundtrip
// machine
// machine-dump: 40
// fmt-ct-has: print("вход в greet");
// fmt-ct-has: struct point { i64 x; i64 y; i64 tag = 0; }
// Изменение кода ct-кодом экземпляра (§7.4): ct { } в теле функции исполняется при
// инстанцировании — один раз на экземпляр (место вызова) в каноническом порядке (§7.3) —
// и может менять узлы, как ct модуля. 
// 
// 
// 
// Изменения делает элаборация (разбор программы от main);
// исполнение — итог.
greet() {
  print("тело");
}

sum(a, b) {
  a + b
}

struct point { i64 x; i64 y; }

// каждый вызов — свой экземпляр, свой ct
instrument(f) {
  ct {
    b = f.body;
    b.items = array{ast.call{ast.name{"print"}, array{ast.string{"вход в " + code_name(f)}}}, ...b.items};
  }
}

// ct-функция: тело — ct-код
add_field(s, name) => ct {
  s.items = array{...s.items, ast.variable{name, ast.name{"i64"}, ast.int{0}}};
};

main() {
  instrument(code(greet));
  instrument(code(sum));
  add_field(code(point), "tag");
  greet();
  print(sum(3, 4));
  print(point{1, 2});
}
