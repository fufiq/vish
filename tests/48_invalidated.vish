// check-error: ссылка на элемент использована после инвалидации опоры (опасное-опасное)
// check-error: ссылка взята здесь
// check-error: опора инвалидирована здесь
// out: 10
// machine
// Пример §12.1: push инвалидирует опору (буфер v), пока жива ссылка e, которая после этого
// используется, — «опасное-опасное» в модели, которая это запрещает: программа выбрала её сама
// (with_model) —  
// Разбор даёт ошибку с трейсом. Исполнение
// — по реализации: ссылка — место (база и индекс), переезд памяти VM ей не виден. По умолчанию
// (тест 334) push ссылку не ломает.
main() {
  v = array{1, 2, 3};
  with_model(v, model_moving());
  &e = v[0];
  v[1] = 5;
  e = 10;
  for(i : range(100)) push(v, i);
  print(e);
}
