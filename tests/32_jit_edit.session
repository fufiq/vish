// §14.4 with JIT (M1): edit dot in a running VM - the next run executes new machine
// code. instance checks the revisions of the functions included in it and is
// recompiled; no de-optimizations.
// program: dot_edit.vish
stdin 1 2 3
stdin 4 5 6
run
// expect: 32.0
jit
// expect: jit  dot(array<f64>, array<f64>)
edit dot
dot(a, b) {
  require(a.size == b.size);
  s = zero(typeof(a[0]));
  for(i : range(a.size)) s = s + (a[i] * b[i] * 2.0);
  s
}
.
// expect: функция dot заменена
run
// expect: 64.0
// expect-not: 32.0
jit
// expect: jit  dot(array<f64>, array<f64>)
check
// expect: пересчитано
