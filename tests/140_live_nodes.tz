// out: 42
// out: abab
// out: point{x: 1, y: 2, z: 7}
// out: point{x: 1, y: 2, z: 3}
// out: [field{name: x, type: i64}, field{name: y, type: i64}, field{name: z, type: i64}]
// out: twice(x) => x * 2;
// out: if(a) 1 else 2 a n_int
// out: да
// fmt-stable
// store-roundtrip
// fmt-ct-has: struct point { i64 x; i64 y; i64 z = 7; }
// fmt-ct-has: twice(x) => x * 2;
// Узлы — живые значения-код: n_X{…}
// создаёт настоящий узел базы, e.поле читает его поле, e.поле = v при компиляции меняет
// узел (мутация — в журнал базы с источником). 
// 
// 
//.
struct point { i64 x; i64 y; }

ct {
  // новая функция: узел создаётся, достраивается и порождается emit
  f = n_fn{"twice", array{n_param{"x"}}};
  f.body = n_op{"*", array{n_ident{"x"}, n_int{2}}};
  f.expr_body = true;
  emit(f);
  // перегрузка той же функции: twice(str s)
  g = n_fn{"twice", array{n_param{"s", n_ident{"str"}}}};
  g.body = n_op{"+", array{n_ident{"s"}, n_ident{"s"}}};
  g.expr_body = true;
  emit(g);
  // поле в struct: struct point — инстанс struct, его узел — код
  p = code(point);
  p.items = array{...p.items, n_var{"z", n_ident{"i64"}, n_int{7}}};
}

is_if(n_if c) => "да";
is_if(c) => "нет";

main() {
  print(twice(21));
  print(twice("ab"));
  print(point{1, 2});
  print(point{1, 2, 3});
  print(fields(point));
  print(code_text(code(twice))); // печать созданного — по записям syntax
  c = n_if{n_ident{"a"}, n_int{1}, n_int{2}};
  print(code_text(c), code_text(c.cond), code_kind(c.then_));
  print(is_if(c)); // код узла n_if — инстанс struct n_if
}
