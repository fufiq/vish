// out: 42
// out: abab
// out: point{x: 1, y: 2, z: 7}
// out: point{x: 1, y: 2, z: 3}
// out: [field{name: x, type: i64}, field{name: y, type: i64}, field{name: z, type: i64}]
// out: twice(x) => x * 2;
// out: if(a) 1 else 2 a ast.int
// out: да
// fmt-stable
// store-roundtrip
// fmt-ct-has: struct point { i64 x; i64 y; i64 z = 7; }
// fmt-ct-has: twice(x) => x * 2;
// machine
// Узлы — живые значения-код: n_X{…}
// создаёт настоящий узел базы, e.поле читает его поле, e.поле = v при компиляции меняет
// узел (мутация — в журнал базы с источником). 
// 
// 
//.
struct point { i64 x; i64 y; }

ct {
  // новая функция: узел создаётся, достраивается и порождается emit
  f = ast.function{"twice", array{ast.parameter{"x"}}};
  f.body = ast.operation{"*", array{ast.name{"x"}, ast.int{2}}};
  f.expr_body = true;
  emit(f);
  // перегрузка той же функции: twice(str s)
  g = ast.function{"twice", array{ast.parameter{"s", ast.name{"str"}}}};
  g.body = ast.operation{"+", array{ast.name{"s"}, ast.name{"s"}}};
  g.expr_body = true;
  emit(g);
  // поле в struct: struct point — инстанс struct, его узел — код
  p = code(point);
  p.items = array{...p.items, ast.variable{"z", ast.name{"i64"}, ast.int{7}}};
}

is_if(ast.if c) => "да";
is_if(c) => "нет";

main() {
  print(twice(21));
  print(twice("ab"));
  print(point{1, 2});
  print(point{1, 2, 3});
  print(fields(point));
  print(code_text(code(twice))); // печать созданного — по записям syntax
  c = ast.if{ast.name{"a"}, ast.int{1}, ast.int{2}};
  print(code_text(c), code_text(c.cond), code_kind(c.then));
  print(is_if(c)); // код узла ast.if — инстанс struct ast.if
}
