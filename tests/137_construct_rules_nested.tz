// out: 7 21 9 1 2.5 12
// machine
// fmt-stable
// store-roundtrip
// Вложенные вставки получают правила обеих: 
// 
// python, объявленная в теле cpp, — конструкция только
// блоков cpp; правило блока python поверх правил блока cpp — переопределение
// (, там же).
sqlish(expr body) {
  operator (a) ~ (b) => (a * 10) + b;
  body
}

cpp(expr body) {
  operator (a) @ (b) => (a * 2) + b;
  python(expr b) => {
    operator (a) $ (b) => a * b;
    b
  };
  body
}

// перегрузки конструкции: правила блоков — объединение их тел (какая выбрана —
// решают типы при инстанцировании)
gen(i64 x, expr body) {
  operator (a) |> (b) => a - b;
  body
}
gen(f64 x, expr body) {
  syntax half (v) => v / 2.0;
  body
}

main() {
  a = cpp { 2 @ 3 };
  b = cpp { python { (2 @ 3) $ 3 } };
  c = cpp {
    operator (a) @ (b) => a + b; // своё правило блока поверх правила cpp
    python { (2 @ 1) $ 3 }
  };
  d = gen(1) { 4 |> 3 };
  e = gen(2.0) { half (5.0) };
  f = sqlish { cpp { 1 ~ 2 } }; // блок cpp внутри блока sqlish — правила обеих
  print(a, b, c, d, e, f);
}
