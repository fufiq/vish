// Программе ресурсы даёт автор (долг шага 12): 
// 
// не дали — не отвал, а.
// Без tz run --grant fs,net (здесь — без grant:) у программы нет файлов и сети: файла нет,
// подключение сразу закрыто; granted(вид) — дано ли сейчас.
// machine
// out: fs дана: false
// out: нет файла
// out: сеть: close сеть программе не дана
main() {
  print("fs дана:", granted("fs"));
  try {
    open("tests/317_not_granted.tz");
    print("открыл");
  } catch(io_error e) {
    print("нет файла");
  }
  c = connect("127.0.0.1", 9);
  e = read(c);
  print("сеть:", e.kind, e.data);
}
