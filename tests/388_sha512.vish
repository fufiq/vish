// out: 64 true
main() {
  print(sha512_hex(""));
  print(sha512_hex("abc"));
  print(sha512_hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"));
  print(sha512("abc").size, sha512("abc") == sha512("abc"));
}
