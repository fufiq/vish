// Links to and from links (§12.1, tail of step 10):
//  (§12.1, D13). &e = p.x,
// &f = ps[i].y, &e = b.xs[k], &e = r[k] от ссылки r — ссылка-путь: корень — переменная,
// шаги — поле и элемент; место ищется заново при каждом обращении — поле заменённого
// агрегата — поле нового. q.y = v через &q = ps[i] — запись по пути. В изменяемый параметр
// — алиас ссылки. JIT путь честно отдаёт интерпретатору (компилирует &e = xs[k]).
// machine
// machine-dump: 60
// machine-dump: 150
// jit-compiled: first
// out: 10 7 9
// out: 40 41 60
// out: 20 6
// out: 11 10 11 10
struct point { i64 x; i64 y; }
struct bag { array xs; }
inc(mut v) { v += 1; }
bump(ps, i64 k) {
  &f = ps[k].y;
  f += 5;
  f
}
first(xs) {
  &e = xs[0];
  e = e * 2;
  e
}

main() {
  p = point{1, 2};
  &e = p.x; // variable-field
  e = 10;
  a = p.x;
  p = point{7, 8}; // The unit is replaced - the link sees a new field
  b = e;
  e = 9;
  print(a, b, p.x);

  ps = array{point{1, 2}, point{3, 4}};
  &q = ps[1];
  q.y = 40; // record
  &f = q.y; // reference-field
  y = ps[1].y;
  inc(f); // reference to the variable parameter
  g = array{array{1, 2, 3}, array{4, 5, 6}};
  &r = g[1];
  &z = r[2]; // element
  z = 60;
  print(y, ps[1].y, g[1][2]);

  bg = bag{array{1, 2, 3}};
  &x = bg.xs[1]; // massif
  x = 20;
  &w = ps[0].y;
  w += 4;
  print(bg.xs[1], ps[0].y);

  zs = array{5, 6};
  print(bump(ps, 0), first(zs), ps[0].y, zs[0]);
}
