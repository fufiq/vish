// out: 46 -38 255 4 1 12 -2
// jit-compiled: sum
// jit-compiled: diff
// jit-compiled: bits
// jit-compiled: count
// jit-compiled: dot
// out: 2 true false 4.5
// out: 3 -3 1 -1 -9223372036854775808 0 -1
// jit-compiled: q
// jit-compiled: flt
// jit-compiled: conv
// out: false true true true false false 10 -3
// jit-compiled: r
// machine
// jit-stats: sum(array<i64>) → 
// jit-stats: bits(i64) → 
// jit-stats: bits(i64) → 
// fmt-stable
// store-roundtrip
// Кодогенераторы на языке (§10.4): цель — контекст, в нём операция — её
// машинный код: 
// 
// 
//.
// + - * & | ^ << >>, сравнения для i64 и + - * / для f64 — в прелюдии, кодирование — функции на языке над
// номерами регистров. Программа переопределяет - (другое кодирование того же
// sub): последнее объявление — первым, без сборки VM. / и % — с переходом в
// ловушку: её адрес — смещение `fault` (метка значением), кодирование перехода —
// тоже на языке (, автор,
//). INT_MIN / -1 — модульно (интерпретатор раньше падал SIGFPE).
amd64(expr body) {
  using operator (i64 a) - (i64 b) => array{0x48 | ((a >> 3) << 2) | (b >> 3), 0x2B, 0xC0 | ((a & 7) << 3) | (b & 7)}; // sub a, b (form 2B)
  body
}

arm64(expr body) {
  using operator (i64 a) - (i64 b) => a64_rrr(0xEB000000, a, a, b); // subs
  body
}

sum(xs) {
  s = 0;
  for(i : range(xs.size)) s = s + xs[i];
  s
}

diff(i64 a, i64 b) => a - b;

bits(i64 x) => ((x & 12) | 2) ^ ((x << 2) >> 3);

count(xs, i64 lim) {
  n = 0;
  for(i : range(xs.size)) if(xs[i] < lim) n += 1;
  n
}

same(i64 a, i64 b) => (a == b) && (a >= 0);

dot(xs, ys) {
  s = 0.0;
  for(i : range(xs.size)) s = s + (xs[i] * ys[i]);
  (s / 2.0) - 1.0
}

q(i64 a, i64 b) => a / b;

r(i64 a, i64 b) => a % b;

safe(i64 a, i64 b) => try { a / b } catch(div_by_zero e) { -1 };

// f64 compared to NaN: everything except != is false
flt(f64 a, f64 b) => (a == b) || ((a < b) && ((a <= b) && ((b > a) && (b >= a))));

conv(i64 k, f64 x) => i64(f64(k) * x) - k;

main() {
  print(sum(array{1, 2, 3, 40}), diff(2, 40), 0xFF, (bits(5) - bits(0)) + 2, 3 & 5, 3 * 4, -8 >> 2);
  print(count(array{5, 1, 7, 2}, 5), same(3, 3), same(1, 2), dot(array{1.0, 2.0}, array{3.0, 4.0}));
  m = -9223372036854775807 - 1;
  print(q(7, 2), q(-7, 2), r(7, 3), r(-7, 3), q(m, -1), r(m, -1), safe(5, 0));
  n = 0.0 / 0.0;
  print(flt(n, 1.0), n != n, flt(1.0, 2.0), flt(2.0, 2.0), flt(2.0, 1.0), flt(n, n), conv(7, 2.5), -(3));
}
