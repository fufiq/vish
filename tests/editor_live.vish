// Program for 323_editor_live_run.wire: launch takes a long time, output - in progress, step rule on the move.
// out: 0 8994
// out: 8 8994
// out: 16 8994
// out: 24 8994
// out: 32 8994
// out: 40 8994
// out: 48 8994
// out: 56 8994
// out: 64 8994
// out: 72 8994
step(i64 k) => k * 2;

main() {
  for(i : range(40)) {
    s = 0;
    for(j : range(3000)) s += j % 7;
    if(i % 4 == 0) print(step(i), s);
  }
}
