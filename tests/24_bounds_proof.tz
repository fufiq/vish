// args: 3
// out: 6 6 3 3
// out: 9
// machine
// check: xs[i]
// check: ys[k] (запись)
// check-lacks: ws[i]
// check-lacks: zs[j]
// check-lacks: vs[i]
// jit-compiled: sum
// jit-compiled: second
// Безопасный индекс 
// переменная цикла for(i: range(a.size)) — индекс a, проверка границ
// снимается разбором и видна в отчёте check. Не снимается, если тело меняет
// индекс, заменяет массив целиком или индексирует другой массив.
sum(xs) {
  s = 0;
  for(i : range(xs.size)) s += xs[i];
  s
}

// запись в элемент тоже доказана
twice(mut ys) {
  for(k : range(ys.size)) ys[k] = ys[k] * 2;
}

// другой массив той же длины не доказан
cross(xs, ws) {
  s = 0;
  for(i : range(xs.size)) s += ws[i];
  s
}

// индекс меняется в теле
second(zs) {
  s = 0;
  for(j : range(zs.size)) { j = j + 0; s += zs[j]; }
  s
}

// массив заменяется целиком
shrink(xs) {
  vs = xs;
  s = 0;
  for(i : range(vs.size)) { s += vs[i]; vs = fill(9, 1); }
  s
}

main() {
  n = parse_int(args[1]).value;
  xs = fill(n, 2);
  ys = fill(n, 1);
  twice(ys);
  print(sum(xs), cross(xs, xs), second(ys) / 2, shrink(xs) - 1);
  print(sum(ys) + n);
}
