// Программа для сценария 66_editor_members.wire (сама по себе — обычный тест).
// stdin: 1 2 3
// out: 3
// out: 3.0
struct point { f64 x; f64 y; }

point {
  sum(point p) => p.x + p.y;
}

total(xs) {
  s = 0.0;
  for(x : xs) s = s + x;
  s
}

main() {
  xs = read_floats(stdin);
  print(xs.size);
  p = point{1.0, 2.0};
  print(p.sum());
}
