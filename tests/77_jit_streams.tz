// out: потоки
// out: 10
// out: 2.0
// error: запись в закрытый поток
// jit-compiled: sum
// jit-compiled: push_all
// jit-compiled: avg
// Операции потоков в машинном коде (шаг 1 плана):
// write/read — вызов VM, файбер паркуется прямо на своём стеке, код вокруг
// остаётся машинным: 
// Тип
// элементов потока — из разбора всей программы по месту создания. Ошибка VM
// внутри операции выходит из машинного кода меткой, как у интерпретатора.
sum(s) {
  t = 0;
  for(x : s) t += x;
  t
}

push_all(s, n) {
  for(i : range(n)) write(s, i);
  close(s);
}

avg(s) {
  t = 0.0;
  k = 0;
  for(x : s) {
    t += x;
    k += 1;
  }
  t / f64(k)
}

// main — интерпретатору (строка в переменной): файберы обмениваются по-настоящему,
// а не свёртываются в цикл в скомпилированном main
main() {
  title = "потоки";
  print(title);
  s = stream(2);
  spawn { push_all(s, 5); }
  print(sum(s));
  f = stream();
  spawn { write(f, 1.5); write(f, 2.5); close(f); }
  print(avg(f));
  yield();
  push_all(s, 1);
}
