// Программа для сценария 217_db_growth.session (сама по себе — обычный тест): в ней все
// источники производных узлов — ct модуля с n_X{} и emit, ct-код экземпляров, разбор
// сырого блока кодом, цепочки (ассоциативная и с перебором по типам).
// out: 300 15 7
// out: 16
// out: 42 abab
// out: true 6
// store-roundtrip
// fmt-stable
scale(i64 x) => x;
shift(i64 x) => x;
other() => 7;

tune(f, op, k) => ct {
  f.body = ast.operation{op, array{ast.name{"x"}, ast.int{k}}};
};

ct {
  f = ast.function{"twice", array{ast.parameter{"x"}}};
  f.body = ast.operation{"*", array{ast.name{"x"}, ast.int{2}}};
  f.expr_body = true;
  emit(f);
  g = ast.function{"twice", array{ast.parameter{"s", ast.name{"str"}}}};
  g.body = ast.operation{"+", array{ast.name{"s"}, ast.name{"s"}}};
  g.expr_body = true;
  emit(g);
}

sum_parse(r) {
  ast.raw{_, items, _, _, _} = r;
  e = ast.int{0};
  for(a : items) e = ast.operation{"+", array{e, a}};
  e
}

sum_of(expr body) {
  syntax {r} => sum_parse(r);
  body
}

main() {
  tune(code(scale), "*", 3);
  tune(code(shift), "+", 5);
  s = 0;
  for(i : range(100)) s += scale(1);
  print(s, shift(10), other());
  x = 10;
  print(sum_of { 1 2 3 x });
  print(twice(21), twice("ab"));
  a = 1;
  print(a + 2 == 3, a + 2 + 3);
}
