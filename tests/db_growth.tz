// Программа для сценария 217_db_growth.session (сама по себе — обычный тест): в ней все
// источники производных узлов — ct модуля с n_X{} и emit, ct-код экземпляров, разбор
// сырого блока кодом, цепочки (ассоциативная и с перебором по типам).
// out: 300 15 7
// out: 16
// out: 42 abab
// out: true 6
// store-roundtrip
// fmt-stable
scale(i64 x) => x;
shift(i64 x) => x;
other() => 7;

tune(f, op, k) => ct {
  f.body = n_op{op, array{n_ident{"x"}, n_int{k}}};
};

ct {
  f = n_fn{"twice", array{n_param{"x"}}};
  f.body = n_op{"*", array{n_ident{"x"}, n_int{2}}};
  f.expr_body = true;
  emit(f);
  g = n_fn{"twice", array{n_param{"s", n_ident{"str"}}}};
  g.body = n_op{"+", array{n_ident{"s"}, n_ident{"s"}}};
  g.expr_body = true;
  emit(g);
}

sum_parse(r) {
  n_raw{_, items, _, _, _} = r;
  e = n_int{0};
  for(a : items) e = n_op{"+", array{e, a}};
  e
}

sum_of(expr body) {
  syntax {r} => sum_parse(r);
  body
}

main() {
  tune(code(scale), "*", 3);
  tune(code(shift), "+", 5);
  s = 0;
  for(i : range(100)) s += scale(1);
  print(s, shift(10), other());
  x = 10;
  print(sum_of { 1 2 3 x });
  print(twice(21), twice("ab"));
  a = 1;
  print(a + 2 == 3, a + 2 + 3);
}
