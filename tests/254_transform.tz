// Трансформатор (§7.4, решение автора 2026-10-17): функция [[transform]] с
// параметром вида узла вызывается при элаборации для каждого такого узла программы;
// вернула код — узел становится им (изменение с источником — откат при правке
// трансформатора), иное — узел как был. 
// 
//.
// out: 42 10
// out: 7
// fmt-ct-has:   a = 21 * 2;
// fmt-ct-has:   b = 5 * 2;
twice2(x) => x + x;

// вызов twice2(x) — умножение x * 2
[[transform]] double_call(ast.call c) {
  if(code_name(c) != "twice2") return;
  x = code_items(c)[1];
  ast.operation{"*", array{x, ast.int{2}}}
}

// любой узел: литерал 7000 — 7 (переписанное снова смотрят все трансформаторы)
[[transform]] shrink(c) {
  if((code_kind(c) != ast.int) || (code_text(c) != "7000")) return;
  ast.int{7}
}

main() {
  a = twice2(21);
  b = twice2(5);
  print(a, b);
  print(7000);
}
