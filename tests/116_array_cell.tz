// out: 200 9000100
// jit-compiled: grow
// Массив в машинном коде — адрес ячейки значения VM: данные и размер код читает из
// неё в момент обращения (§12.2, без копий в кадре). push делает VM (узел VM), массив
// растёт через границу мелкий → растущий («бесконечный вектор»); a.f(b) ≡ f(a, b).
grow(i64 n) {
  xs = array{};
  for(i : range(n)) xs.push(i * 2);
  s = 0;
  for(i : range(xs.size)) s += xs[i];
  xs[0] = 100;
  s + xs[0] + xs.size
}
main() {
  print(grow(10), grow(3000));
}
