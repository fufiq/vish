// out: 10 3
// out: 10 3
// out: 10 3
// Программа сессии 302 (живой процесс: ct по месту после правки, раскладка — и типы полей).
struct cell { i64 v; }
ct k = 1;
f() => k * 10; // ct-переменная по месту: в каноническом порядке раньше later — 1
later() => ct { k = 5; };
main() {
  c = cell{3};
  for(i : range(3)) {
    print(f(), c.v);
    later();
  }
}
