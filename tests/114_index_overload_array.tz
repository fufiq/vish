// out: 20 97 6
// machine
// jit-compiled: get
// Перегрузка [] над массивом своим кодом: компилятор на языке выбирает её, как
// перегрузку вызова, и встраивает; index(a, i) — примитив ядра. Модули — инклюды
// прелюдия модуль
// программы не включает — её for индексирует ядром.
operator (array xs)[i64 k] => index(xs, k) * 10;
get(array xs, i64 k) => xs[k];

main() {
  s = 0;
  for(x : array{1, 2, 3}) s = s + x;
  print(get(array{1, 2, 3}, 1), "ab"[0], s);
}
