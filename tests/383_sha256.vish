// Cryptography in language. SHA-256 (FIPS 180-4) are NIST reference vectors; HMAC-SHA-256 is RFC 4231 (cases 1, 2 and long
// key, case 6).
// machine
// out: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
// out: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// out: 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
// out: 32 true
// out: b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
// out: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// out: 60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54
main() {
  print(sha256_hex(""));
  print(sha256_hex("abc"));
  print(sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"));
  print(sha256("abc").size, sha256("abc") == sha256("abc"));
  k1 = "";
  for(j : range(20)) k1 = k1 + text_byte(11);
  print(hmac_sha256_hex(k1, "Hi There"));
  print(hmac_sha256_hex("Jefe", "what do ya want for nothing?"));
  k2 = "";
  for(j : range(131)) k2 = k2 + text_byte(170);
  print(hmac_sha256_hex(k2, "Test Using Larger Than Block-Size Key - Hash Key First"));
}
