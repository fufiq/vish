// error: begin нельзя внутри блоков transaction
// check-error: begin нельзя внутри блоков transaction
// check-error: вызов здесь
// machine
// Хук разбора [[g(…)]] пишет программа: свой «запрет вложенности» на примитивах
// места — call_site() и code_parent(c) (объемлющий узел), как inside прелюдии.
// Ошибка разбора — с пометкой у места (require(c, сообщение, пометка, место)) и до
// исполнения: begin(n) вне блока не успевает напечатать.
transaction(expr body) {
  body;
}

// место c — где-то внутри вызова g (до объявления функции)
under(c, str g) {
  up = code_parent(c);
  found = false;
  while(!found && given(up)) {
    if(code_kind(up) == ast.function) up = code();
    else {
      if(code_kind(up) == ast.call) found = code_name(up) == g;
      up = code_parent(up);
    }
  }
  found
}
outside(expr g) => require(!under(call_site(), code_name(code(g))),
  code_name(call_site()) + " нельзя внутри блоков " + code_name(code(g)), "вызов здесь", call_site());

[[outside(transaction)]] begin(mut n) { n += 1; }

main() {
  n = 0;
  begin(n);
  print(n);
  transaction { begin(n); }
}
