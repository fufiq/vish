// out: 3.0 2 2.75 3 1.5
// out: 7.0
// jit-compiled: avg
// machine
// Преобразования чисел — объявления прелюдии (f64(i64 x) => int_to_float(x), M6:
// решение автора 2026-10-10); программа
// добавляет свои перегрузки так же, как операторы.
struct meters { __int64 value; }
f64(meters m) => f64(m.value);

avg(i64 a, i64 b) => f64(a + b) / 2.0;

main() {
  x = 3;
  y = 2.75;
  print(f64(x), i64(y), f64(y), i64(x), avg(1, 2));
  print(f64(meters{7}));
}
