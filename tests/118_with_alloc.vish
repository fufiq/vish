// out: 602 597 [7]
// machine
// with_alloc(r) { … } — уровень памяти выбирает программа (§12.2): массив, созданный и
// выросший в теле (через границу мелкий → растущий), — в страницах уровня r; без
// контекста — уровень вызывающего. 
//.
fill_to(mut xs, i64 n) {
  for(i : range(n)) xs.push(i);
}
main() {
  r = region();
  xs = with_alloc(r) {
    a = array{1, 2};
    fill_to(a, 600);
    a
  };
  ys = array{7};
  print(xs.size, xs[599], ys);
}
