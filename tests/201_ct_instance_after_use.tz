// error: изменение кода после его использования: n_block уже разобран в каноническом порядке инстанцирования
// error: использован здесь
// check-error: изменение кода после его использования
// Менять ct-кодом экземпляра можно только код, ещё не разобранный в каноническом
// порядке (§7.3): иначе вызов до места изменения разбирался бы старым кодом, а исполнялся
// новым. 
// *Моё:* ошибка, а не две
// версии кода (как «специализация после инстанцирования» в C++); ослабить можно потом.
greet() {
  print("тело");
}

instrument(f) {
  ct {
    b = f.body;
    b.items = array{n_call{n_ident{"print"}, array{n_str{"вход"}}}, ...b.items};
  }
}

main() {
  greet();
  instrument(code(greet));
  greet();
}
