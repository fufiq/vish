// out: да да нет
// out: 3
// fmt-stable
// machine
// quote { … } — контекст: объявленное в заготовке (syntax, operator) видно только в ней
// и не меняет разбор окружающего текста; образец базы ast.context{} = код — истина для
// любого узла-наследника (блок, quote), как у struct с базой (решения пользователя 2026-10-02).
is_ctx(c) => if(ast.context{} = c) "да" else "нет";

main() {
  q = quote {
    syntax twice {b} => {
      b;
      b;
    };
  };
  ast.quote{items} = quote { { 1; } };
  ast.quote{ops} = quote { 1 + 2; };
  print(is_ctx(q), is_ctx(items[0]), is_ctx(ops[0]));
  twice = 3; // twice снаружи — просто имя: форма из заготовки не видна
  print(twice);
}
