// Tail calling is a transition, not a call/ret
// 
// 
// Smart implementation Calling yourself in the tail (block value, if branch, return) - a working call
// of the same function takes new values of parameters and repeats the body: the stack does not grow
// either in the interpreter, or in the machine (frame instead of frame), or in machine code (transition
// to the beginning of the body). Not in the tail (n + f(…), inside the try or loop) is a regular call.
//
//
// jit-compiled: count
// jit-compiled: gcd
// machine
// out: 100000
// out: 6
// out: 5 111
// out: 4950
count(i64 n, i64 acc) => if(n == 0) acc else count(n - 1, acc + 1);
gcd(i64 a, i64 b) {
  if(b == 0) return a;
  gcd(b, a % b)
}
collatz(i64 n, i64 steps) {
  if(n == 1) return steps;
  if((n % 2) == 0) return collatz(n / 2, steps + 1);
  collatz((3 * n) + 1, steps + 1)
}
sum(i64 n) => if(n == 0) 0 else n + sum(n - 1); // Not a tail: a common challenge
main() {
  print(count(args.size * 100000, 0));
  print(gcd(48, 18));
  print(collatz(args.size + 4, 0), collatz(args.size + 26, 0));
  print(sum(args.size * 99));
}
