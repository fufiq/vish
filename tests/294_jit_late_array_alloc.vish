// out: 499500 45
// out: 12
// jit-compiled: work
// jit-compiled: two
// machine
// Машинный код: массив, объявленный пустым литералом (array{}: тип элементов узнаётся ростом),
// и with_alloc(r) { … } в теле. Было: «поздний» массив не опознавался (typeof(array{}) — это
// array, а разбор называет его array<?>), размер читался из общего списка — цикл по массиву
// без итераций, итог 0 молча; with_alloc — отказ. Теперь
// уровень памяти — службы VM 13/14 вокруг тела, тело — на месте. Регион создаёт вызывающий:
// экземпляр, который сам создаёт region(), остаётся интерпретатору (освобождение уровня с
// проверкой «ничего не живёт» — у него, тест 287).
work(region r, i64 n) {
  s = 0;
  with_alloc(r) {
    xs = array{};
    for(i : range(n)) xs.push(i);
    for(x : xs) s += x;
  }
  s
}
two(i64 n) {
  s = 0;
  xs = array{};
  xs.push(n);
  xs.push(2);
  for(x : xs) s += x;
  s
}
main() {
  r = region();
  print(work(r, args.size * 1000), work(r, args.size * 10));
  print(two(args.size * 10));
}
