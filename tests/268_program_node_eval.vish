// out: 42 5.0
// out: 20 -1
// out: 3
// check:   eval(expr, expr)  ×1
// jit-compiled: first_big
// machine
// fmt-stable
// store-roundtrip
// Свой eval у вида узла программы (решение автора 2026-10-17: 
// форма — член вида).. Поля узла —
// аргументы eval по порядку: expr-поле вычисляется по месту узла (семантический инлайн —
// return из тела until выходит из first_big). Разбор — то же исполнение (value-подход).
struct ast.twice { code x; }
syntax twice (x) => ast.twice{x};
ast.twice { eval(expr x) => x + x; }

// your cycle: to the condition; break and return from the body out
struct ast.until { code cond; code body; }
syntax until (c) {body} => ast.until{c, body};
ast.until { eval(expr c, expr body) => loop { if(c) break; body; }; }

first_big(xs) {
  i = 0;
  until (i >= xs.size) {
    if(xs[i] > 10) return xs[i];
    i += 1;
  }
  return -1;
}

main() {
  a = 21;
  print(twice (a), twice (2.5));
  print(first_big(array{1, 20, 30}), first_big(array{1}));
  n = 0;
  until (n == 3) n += 1;
  print(n);
}
