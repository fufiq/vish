// out: 4950
// check-error: цикл не сошёлся при статическом разборе
// Пороги статического разбора — функция на языке (analysis_limit, M6 шаг 7):
// программа объявляет свою — VM берёт последнюю объявленную. Цикл со
// 100 известными итерациями при пороге 50 — ошибка разбора; исполнение — как было.
// 
//;
//.
analysis_limit(what) => if(what == "loop_known") 50 else if(what == "loop_types") 8 else if(what == "recursion_widen") 16 else 2000;

main() {
  s = 0;
  i = 0;
  while(i < 100) {
    s = s + i;
    i = i + 1;
  }
  print(s);
}
