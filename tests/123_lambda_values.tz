// out: 39
// machine
// jit-compiled: work
// Лямбды-значения в машинном коде — семантический инлайн: аргумент-лямбда связывается
// с параметром как код определения, лямбда в переменной — как локальная функция;
// захват — места определения (acc меняется по ссылке), контекст разбора — места вызова.
apply2(g, i64 x) => g(g(x));
each(i64 n, body) {
  for(i : range(n)) body(i);
}
work(i64 n) {
  acc = 0;
  scale = (i64 v) => v * 3;
  each(n, (i64 i) => {
    acc = acc + scale(i);
  });
  acc + apply2((i64 z) => z + 10, 1)
}
main() { print(work(4)); }
