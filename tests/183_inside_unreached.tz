// args: 2
// error: 183_inside_unreached.tz:16:15: ошибка: commit существует только внутри блоков transaction
// machine
// Ветка, в которую исполнение не зайдёт (n > 100 при n = 2), всё равно разобрана:
// хук проверяет каждый вызов в тексте, запуск останавливается до исполнения.
[[inside(transaction)]] commit(mut log) { log += 1; }

transaction(expr body) {
  body;
}

main() {
  n = parse_int(args[1]).value;
  log = 0;
  print(n);
  if(n > 100) commit(log);
  transaction { commit(log); }
  print(log);
}
