// no-jit
// out: CONSUME true
// out: EAT_LEAF true
// out: UNRELATED true
// out: RESULT 2
// out: ORACLE true
// RA-1 B6: a conservative closure through a common main/tooling includes unrelated too.
// The absence of an unrelated function in an isolated graph is checked by tests/rdeps_index.cpp.
// B4 (the RA-1 review): a change to Base affects the consumers of Derived and the descendants of the descendant (transitively through n_extend.base).
use rdeps;
struct Base { i64 x; }
struct Derived : Base { i64 y; }
struct Leaf : Derived { i64 z; }
consume(Derived d) => d.y;
eat_leaf(Leaf l) => l.z;
unrelated(i64 v) => v;
main() {
  impacted = impact_of(array{code(Base)});
  consume_in = false;
  eat_in = false;
  other_in = false;
  for(x : impacted) {
    if(code_name(x) == "consume") consume_in = true;
    if(code_name(x) == "eat_leaf") eat_in = true;
    if(code_name(x) == "unrelated") other_in = true;
  }
  print("CONSUME", consume_in);
  print("EAT_LEAF", eat_in);
  print("UNRELATED", other_in);
  print("RESULT", consume(Derived{1, 2}));
  print("ORACLE", rdeps_oracle_report() == "");
}
