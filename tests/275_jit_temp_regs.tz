// out: 10 -5 6.5 9.0
// jit-compiled: ints
// jit-compiled: floats
// machine
// Временные выражений без вызовов — в регистрах своего класса по глубине (temp_regs цели),
// не на стеке через целый регистр:  
// без распределителя (,
//). Глубже, чем регистров, — стек, как раньше; f64 между регистрами — movapd.
ints(xs, i64 k) => (xs[0] * (xs[1] + (xs[2] * (k - xs[3])))) - (xs[1] * (k + 1));
floats(a, b) {
  s = 0.0;
  for(i : range(a.size)) s += (a[i] * b[i]) + ((a[i] - b[i]) * (b[i] + (a[i] * 0.5)));
  s
}
main() {
  xs = array{2, 3, 4, 1};
  print(ints(xs, 3), ints(xs, 0), floats(array{1.0, 2.0, 3.0}, array{2.0, 4.0, 3.0}), floats(array{3.0}, array{1.5}));
}
