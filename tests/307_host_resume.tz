// Ресурсы хоста в машине процессов и перенос процесса (шаг 12.1): файлы, сеть и процессы VM
// машина исполняет, как интерпретатор (тесты 55, 56, 58 — и машиной). Дескрипторы хоста — не
// часть процесса: 
//   — в дамп не
// входят. Восстановленный в другой VM процесс видит их закрытыми внешней стороной (решение
// пользователя 2026-10-19): чтение — конец потока, запись — исключение closed_stream, send —
// false. Открытое после переноса — снова ресурс хоста.
// machine
// machine-dump: 300
// out: записано 40
// out: прочитано: да
// out: заново открыт
// dump-out: файл закрыт внешней стороной: запись в закрытый поток
// dump-out: прочитано: нет
// dump-out: заново открыт
main() {
  src = open("tests/307_host_resume.tz");
  f = create("out/host_resume.txt");
  n = 0;
  try {
    for(i : range(40)) {
      write(f, "x");
      n += 1;
    }
    close(f);
    print("записано", n);
  } catch(closed_stream e) {
    print("файл закрыт внешней стороной:", e.message);
  }
  k = 0;
  for(chunk : src) k += chunk.size;
  print("прочитано:", if(k > 0) "да" else "нет");
  g = open("out/host_resume.txt"); // сколько успело записаться до переноса — дело внешней стороны
  for(chunk : g) {}
  print("заново открыт");
}
