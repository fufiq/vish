// out: сеть: close сеть программе не дана
main() {
  print("fs дана:", granted("fs"));
  try {
    open("tests/317_not_granted.vish");
    print("открыл");
  } catch(io_error e) {
    print("нет файла");
  }
  c = connect("127.0.0.1", 9);
  e = read(c);
  print("сеть:", e.kind, e.data);
}
