// out: i64 int 5
// Числа и строки — теги прелюдии над машинными представлениями (§5.8, O15, M6 шаг 9):
// 
// Имя i64
// даёт прелюдия (struct i64 { __int64 value; }); второй тип над тем же представлением —
// свой тип (2026-10-17, тест 269): литерал 1 — по-прежнему i64.
struct int { __int64 value; }

main() {
  print(typeof(1), typeof(int{5}), int{5}.value);
}
