// error: тег int: у представления __int64 уже есть тег i64
// Числа и строки — теги прелюдии над машинными представлениями (§5.8, O15, M6 шаг 9):
// 
// Имя i64
// даёт прелюдия (struct i64 { __int64 value; }); второй тег над тем же представлением —
// пока ошибка (отдельного типа над ним нет).
struct int { __int64 value; }

main() {
  print(typeof(1));
}
