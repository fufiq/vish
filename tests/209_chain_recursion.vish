// out: true
// out: false
// out: true
// machine
// Цепочка операторов с рекурсивным вызовом внутри `&&`/`||`: выбор дерева пробует
// разборы, а проба исполняет рекурсивный вызов, в теле которого та же цепочка. Тип
// такого атома ещё выводится (⊥, как у рекурсии разбора): берётся единственное
// согласованное дерево — `(k == part.size) || (…)`: `bool || ⊥` подходит (правый —
// expr), `i64 || ⊥` нет. Повторный выбор той же цепочки с теми же типами внутри пробы —
// «тип ещё выводится»; рекурсия пробы — по типам (значения в пробе стёрты). Раньше —
// переполнение стека.
same_at(s, part, i, k) => k == part.size || (s[i + k] == part[k] && same_at(s, part, i, k + 1));
has_at(s, part, i) => i + part.size <= s.size && (same_at(s, part, i, 0) || has_at(s, part, i + 1));
contains(s, part) => s.size >= part.size && has_at(s, part, 0);
main() {
  print(contains("ab;cd", "cd"));
  print(contains("ab;cd", "dc"));
  print(same_at("ab;cd", "cd", 3, 0));
}
