// out: 2 15 3
// out: 7 1
// out: 4
// out: контекст контекст нет да
// out: []
// machine
// fmt-stable
// store-roundtrip
// Контексты разбора (§4.4): правила разбора — syntax, operator, конструкции — из
// объявлений в контексте; действуют от объявления до конца своего контекста (модуль,
// блок) и во вложенных; прелюдия — внешний контекст всех модулей; use приносит формы
// модуля в точке use. 
// 
// 
//.
use geo.forms; // twice { … }, a +* b, thrice { … } — из модуля

// блок и модуль — наследники контекста (struct n_block : n_context)
kind(n_context c) => "контекст";
kind(c) => "нет";

forms() {
  n = 0;
  twice { n += 1; }
  m = 0;
  thrice { m += 1; }
  print(n, 3 +* 4, m);
}

// объявление действует со следующей строки и до конца модуля
syntax swap_add (expr a) <-> (expr b) => {
  t = a;
  a = b + 1;
  b = t;
};

local() {
  x = 1;
  y = 6;
  swap_add (x) <-> (y);
  // конструкция блока — в блоке и во вложенных, не снаружи (132)
  i64 again(expr body) {
    body;
    body;
    0
  }
  k = 0;
  again { k += 1; }
  {
    again { k += 1; }
  }
  print(x, y);
  print(k);
}

main() {
  forms();
  local();
  b = n_block{array{}, false, array{}};
  m = n_module{"m", array{}, array{}, array{}, false};
  print(kind(b), kind(m), kind(n_hole{"x", "y"}), if(n_context{} = m) "да" else "нет");
  print(fields(n_context));
}
