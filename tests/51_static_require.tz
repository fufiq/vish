// error: нарушено требование require; pick: out_of_bounds в строке
// Требование статичности не выполнено — ошибка с перечнем недоказанного.
pick(auto xs, auto i) => xs[i];

ct {
  require(static_level(pick).checks == 0);
}

main() {
  auto n = parse_int(args[1]).value;
  print(pick(array{1, 4}, n));
}
