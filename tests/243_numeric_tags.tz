// out: 3.5 3.5 2.25
// machine
// fmt-stable
// jit-compiled: infix+
// Числа — теги, операции — объявления по типам (O15, M6 шаг 8): 
// 
// В прелюдии i64 + f64 не объявлен — программа объявляет
// своё и получает смешанную арифметику (без него —, тест 07).
operator (i64 a) + (f64 b) => f64(a) + b;
operator (f64 a) + (i64 b) => a + f64(b);
mix(i64 n, f64 x) => n + x;

main() {
  print(1 + 2.5, 2.5 + 1, mix(2, 0.25));
}
