// out: 1
// error: индекс 5 вне границ массива размера 1
// Непойманное исключение завершает свой файбер (§8.3); остальные работают,
// программа завершается с его трейсом.
main() {
  auto s = stream();
  spawn {
    auto a = array{1};
    print(a[5]);
  }
  spawn { write(s, 1); }
  print(read(s));
}
