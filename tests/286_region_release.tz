// out: 499500 45
// Уровень памяти освобождается с последним держателем, если в нём ничего не живёт:
//.
// Значения в регионе умирают раньше него (объявлены позже) — регион пуст, страницы и адреса —
// системе.
work(i64 n) {
  r = region();
  s = 0;
  with_alloc(r) {
    xs = array{};
    for(i : range(n)) xs.push(i);
    for(x : xs) s += x;
  }
  s
}
main() { print(work(args.size * 1000), work(args.size * 10)); }
