// check-error: параметр a — алиас только для чтения; чтобы менять, объявите его mut
// error: параметр a — алиас только для чтения; чтобы менять, объявите его mut
// out: 2
// Параметр без mut — алиас только для чтения этой функцией (§6.2): запись и в
// переменную, и в элемент — ошибка. Локальная переменная с тем же именем
// (тень) и mut-параметр — можно.
shadow(auto a) {
  auto a = 1;
  a = 2;
  a
}

fine(mut auto a) { a[0] = 1; }

bad(auto a) { a[0] = 1; }

main() {
  auto xs = array{0, 0};
  print(shadow(5));
  fine(xs);
  bad(xs);
}
