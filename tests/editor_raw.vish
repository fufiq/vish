// out: 16
// Program for 175_editor_raw.wire script: A block disassembled by code (§4.4).
sum_parse(r) {
  ast.raw{_, items, _, _, _} = r;
  e = ast.int{0};
  for(a : items) e = ast.operation{"+", array{e, a}};
  e
}

negsum_parse(r) => ast.int{7};

sum_of(expr body) {
  syntax {r} => sum_parse(r);
  body
}

main() {
  x = 10;
  print(sum_of {1 2 3 x});
}
