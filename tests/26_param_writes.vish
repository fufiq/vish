// out: 5 [1, 0] 2
// out: 2 7
// machine
// check: setp(c): меняет c
// check: fill0(a): меняет a
// check: via(x): меняет x
// check: ping(p, n): меняет p
// check: pong(q, n): меняет q
// check-lacks: shadow(a): меняет
// check-lacks: reads(r): меняет
// The parameter is alias of the caller’s location; the function can change it without being marked.
// 
// parsing outputs which parameters the function changes - directly, through
// call and through recursion - and shows this in the check report.
setp(c) { c = 5; }
fill0(a) { a[0] = 1; }
via(x) { setp(x); }

ping(p, n) { if(n > 0) pong(p, n - 1); }
pong(q, n) { if(n > 0) ping(q, n - 1) else q += 1; }

shadow(a) {
  i64 a = 1;  // type - announcement: shadow parameter
  a = 2;
  a
}
reads(r) => r + 1

main() {
  v = 1;
  xs = array{0, 0};
  k = 1;
  setp(v);
  fill0(xs);
  ping(k, 3);
  print(v, xs, k);
  w = 0;
  via(w);
  print(shadow(9), reads(w) + 1);
}
