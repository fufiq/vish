// Ссылка-путь опирается на буфер массива первого шага (§12.1): push его инвалидирует —
// использование после — «опасное-опасное», ошибка разбора в пути (хуки опоры, как у
// &e = v[i]). При исполнении — только если данные правда переехали (поколение).
// check-error: ссылка на элемент использована после инвалидации опоры
// check-error: опора инвалидирована здесь
// out: 4
struct point { i64 x; i64 y; }
main() {
  ps = array{point{1, 2}, point{3, 4}};
  &f = ps[1].y;
  ps.push(point{5, 6});
  print(f);
}
