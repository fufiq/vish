// out: {} {}
// out: {} true
// out: ()
// machine
// fmt-stable
// {} без типа места — литерал без полей, анонимный агрегат {} (как {x: …}, где тип не
// ожидается, §4.3): 
//  
// Instruction {} and body {} - block, as before.
g(p) => p;
nothing() => {};

main() {
  x = {};
  print(x, typeof(x));
  print(g({}), typeof(g({})) == typeof(x));
  print(nothing());
}
