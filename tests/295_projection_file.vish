// Second language file (§4.5, step 11): The first line tells you how to parse the rest
// —  
// use geo.words приносит записи проекции (forever, when … otherwise).
// Своё объявление when ниже закрывает запись с этой головой: дальше when — вызов
// конструкции программы, печать там пишет узел if записью прелюдии — текст
// разбирается в то же дерево (vish test --projection — то же для всех тестов).
// fmt-stable
// fmt-has: define pick(n) means when(n > 1) 10 otherwise 20;
// fmt-has: when(c, expr yes) otherwise(expr no) => when(c) no otherwise yes;
// fmt-has: } otherwise {
// fmt-has:     if(n > 3) break;
// fmt-has:   forever {
// machine
// out: 10 20
// out: 4
use geo.words;

pick(n) => when(n > 1) 10 otherwise 20; // entry projection: ast.if
when(c, expr yes) otherwise(expr no) => when(c) no otherwise yes; // its design, on the contrary
flip(n) => when(n > 1) { 10 } otherwise { 20 }; // design
count() {
  n = 0;
  loop {
    n += 1;
    if(n > 3) break;
  }
  n
}

main() {
  print(pick(5), flip(5));
  k = 0;
  forever {
    k = count();
    break;
  }
  print(k);
}
