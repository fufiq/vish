// out: 97 48 16 -1
// machine
// fmt-stable
// store-roundtrip
// Строка — байты: «строки — байты», кодировка исходника «никакого отношения к
// внутренней кодировки не имеет». s[k] — байт (i64),
// за границей — out_of_bounds (раньше индексация строки роняла VM).
main() {
  s = "0123456789abcdef";
  r = try {
    s[16]
  } catch(out_of_bounds e) {
    -1
  };
  print(s[10], s[0], s.size, r);
}
