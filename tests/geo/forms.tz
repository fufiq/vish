// Модуль для теста 131_context_rules (ключ geo.forms): формы записи — объявления
// модуля; use geo.forms; приносит их в контекст в точке use (модуль — инклюд, §9.1).
module geo.forms;

syntax twice {body} => {
  body;
  body;
};

operator (a) +* (b) => (a * b) + a;

thrice(expr body) {
  body;
  body;
  body;
}
