// Модуль с контролем расширений (own_only) и правилами разбора — для тестов 214–216:
// запись syntax, свой оператор, конструкция с правилом тела, цепочка без [[associative]].
[[extension(own_only)]] module geo.rules;

syntax twice {body} => {
  body;
  body;
};

operator (a) <+> (b) => (a * 10) + b;

// оператор тела действует в блоках frame { … } места вызова (§4.4)
frame(expr body) {
  operator (a) <~> (b) => a - b;
  body
}

// a - b - c: у «-» нет [[associative]] в контексте определения модуля
diff3(i64 a, i64 b, i64 c) => a - b - c;
