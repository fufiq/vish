// Проекция «словами» для сценария 225_editor_projection.wire (ключ geo.words):
// группа записей syntax — модуль (§4.4, вариант C); представление редактора печатает
// по ним и разбирает правки по ним же. Узлы те же (ast.loop, ast.if), меняется только
// текст. Своя функция скобок — скобки у любого вложенного инфикса.
module geo.words;

syntax forever {body} => ast.loop{body};
syntax when (c) {yes} => ast.if{c, yes};
syntax when (c) {yes} otherwise {no} => ast.if{c, yes, no};
operand_parens(str kind, str op, bool left, str parent_op, bool assoc) => kind != "";
// Запись-заготовка (§4.5, шаг 11.2): тот же узел for, блок вводит имя — #x.
syntax each (x) in (xs) {body} => quote { for(#x : #xs) #body };
// Клауза с именем и места-блоки: try { … } catch(e) { … } словами.
syntax attempt {body} rescue (e) {handler} => quote { try { #body } catch(#e) { #handler } };
// Объявление записью (§4.5, шаг 11.3): та же функция; #name — голое имя, #params — параметры.
syntax define #name (params, ...) {body} => quote { #name(#params) { #body } };
syntax define #name (params, ...) means {e}; => quote { #name(#params) => #e; };
syntax record #name {fields} => quote { struct #name { #fields } };
