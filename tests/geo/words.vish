// projection "words" for the 225_editor_projection.wire script (key geo.words): a group of
// syntax records is a module (§4.4, variant C); the editor's presentation prints on them and
// analyzes edits on them. node is the same (ast.loop, ast.if), only the text changes. Its
// function is brackets for any nested infix.
module geo.words;

syntax forever {body} => ast.loop{body};
syntax when (c) {yes} => ast.if{c, yes};
syntax when (c) {yes} otherwise {no} => ast.if{c, yes, no};
operand_parens(str kind, str op, bool left, str parent_op, bool assoc) => kind != "";
// Write-workpiece (§4.5, step 11.2): the same node for, the block enters the name #x.
syntax each (x) in (xs) {body} => quote { for(#x : #xs) #body };
// Name and place-block: try { … } catch(e) { … } words.
syntax attempt {body} rescue (e) {handler} => quote { try { #body } catch(#e) { #handler } };
// Announcement by record (§4.5, step 11.3): same function; #name is the bare name; #params is the parameters.
syntax define #name (params, ...) {body} => quote { #name(#params) { #body } };
syntax define #name (params, ...) means {e}; => quote { #name(#params) => #e; };
syntax record #name {fields} => quote { struct #name { #fields } };
