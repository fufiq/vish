// Модуль для теста 238 и сценария 239: контроль расширений у отдельных сущностей
// (§9.1) — [[extension(own_only)]] у struct pt и у записи syntax twice; прочие
// сущности модуля (area) расширять можно.
module geo.shapes;

[[extension(own_only)]] struct pt {
  i64 x;
  i64 y;
}

[[extension(own_only)]] syntax twice {body} => {
  body;
  body;
};

area(pt p) => p.x * p.y;
