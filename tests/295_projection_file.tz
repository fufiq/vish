// Файл во втором языке (§4.5, шаг 11): первая строка говорит, как разбирать остальное
// —  
// use geo.words приносит записи проекции (forever, when … otherwise).
// Своё объявление when ниже закрывает запись с этой головой: дальше when — вызов
// конструкции программы, печать там пишет узел if записью прелюдии — текст
// разбирается в то же дерево (tz test --projection — то же для всех тестов).
// fmt-stable
// fmt-has: pick(n) => when(n > 1) 10 otherwise 20;
// fmt-has: when(c, expr yes) otherwise(expr no) => when(c) no otherwise yes;
// fmt-has: } otherwise {
// fmt-has:     if(n > 3) break;
// fmt-has:   forever {
// machine
// out: 10 20
// out: 4
use geo.words;

pick(n) => when(n > 1) 10 otherwise 20; // запись проекции: ast.if
when(c, expr yes) otherwise(expr no) => when(c) no otherwise yes; // своя конструкция — наоборот
flip(n) => when(n > 1) { 10 } otherwise { 20 }; // вызов своей конструкции
count() {
  n = 0;
  loop {
    n += 1;
    if(n > 3) break;
  }
  n
}

main() {
  print(pick(5), flip(5));
  k = 0;
  forever {
    k = count();
    break;
  }
  print(k);
}
