// args: 3
// out: 4 6 12 true 7 2
// out: 3 4 1
// jit-compiled: pick
// jit-compiled: sum3
// fmt-stable
// store-roundtrip
// Операторы кодом (расширения, шаг 3): 
// 
// Приоритетов
// нет: дерево цепочки выбирают типы, [[associative]] — инвариант из логики.
struct vec { i64 x; i64 y; }

// свой оператор над своим типом — перегрузка рядом со встроенным
operator (vec a) + (vec b) => vec{a.x + b.x, a.y + b.y};
operator (vec a) * (i64 k) => vec{a.x * k, a.y * k};

// постфикс с изменяемым параметром: a++ меняет место
operator (mut i64 a)++ { a += 1; }

// типы решают: (i % 2) == 0 — единственный разбор (i % (2 == 0) не инстанцируется)
pick(i) => if(i % 2 == 0) 1 else 2;

// одинаковый ассоциативный оператор подряд — одно дерево
sum3(a, b, c) => a + b + c;

// своя конструкция и сущность, живущая только в её блоке
[[inside(transaction)]] commit(mut log) { log += 1; }

transaction(expr body) {
  body;
  0
}

main() {
  n = parse_int(args[1]).value;
  v = vec{1, 2} + vec{n, 4};
  w = vec{1, 2} * (n + 3);
  print(v.x, v.y, w.y, n > 1 && pick(n) == 2, sum3(1, 2, n + 1), pick(n));
  c = n;
  c++;
  log = 0;
  transaction { commit(log); }
  print(n, c, log);
}
