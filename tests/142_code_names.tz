// out: 15
// out: 1000
// out: both(helper) => helper(1) + helper;
// fmt-stable
// store-roundtrip
// machine
// Имена в созданном коде (решение автора 2026-10-02): ast.name{"x"} — имя, его
// связывает анализ в месте, куда узел попал: 
//;
// конкретная сущность — ссылка на объявление ref(f), не ловится именем места вставки:
// 
// Печать ссылки — текущее имя цели.
helper(x) => x * 10;
ct base = 1000;

ct {
  // параметр helper заслоняет функцию: имя связывается с параметром, ссылка — с функцией
  f = ast.function{"both", array{ast.parameter{"helper"}}};
  f.body = ast.operation{"+", array{ast.call{ref(helper), array{ast.int{1}}}, ast.name{"helper"}}};
  f.expr_body = true;
  emit(f);
  // ссылка на ct-переменную модуля — её значение, хотя в месте вставки есть свой base
  g = ast.function{"get_base", array{ast.parameter{"base"}}};
  g.body = ast.reference{ref(base).target}; // ast.reference{номер узла объявления} — то же, что ref(base)
  g.expr_body = true;
  emit(g);
}

main() {
  print(both(5));
  print(get_base(7));
  print(code_text(code(both)));
}
