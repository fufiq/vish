// out: 15
// out: 1000
// out: both(helper) => helper(1) + helper;
// fmt-stable
// store-roundtrip
// Имена в созданном коде (решение автора 2026-10-02): n_ident{"x"} — имя, его
// связывает анализ в месте, куда узел попал: 
//;
// конкретная сущность — ссылка на объявление ref(f), не ловится именем места вставки:
// 
// Печать ссылки — текущее имя цели.
helper(x) => x * 10;
ct base = 1000;

ct {
  // параметр helper заслоняет функцию: имя связывается с параметром, ссылка — с функцией
  f = n_fn{"both", array{n_param{"helper"}}};
  f.body = n_op{"+", array{n_call{ref(helper), array{n_int{1}}}, n_ident{"helper"}}};
  f.expr_body = true;
  emit(f);
  // ссылка на ct-переменную модуля — её значение, хотя в месте вставки есть свой base
  g = n_fn{"get_base", array{n_param{"base"}}};
  g.body = n_ref{ref(base).target}; // n_ref{номер узла объявления} — то же, что ref(base)
  g.expr_body = true;
  emit(g);
}

main() {
  print(both(5));
  print(get_base(7));
  print(code_text(code(both)));
}
