// out: 12 10 42 7
// out: 2 6 16
// out: 2 4 3
// machine
// machine-dump: 40
// fmt-stable
// store-roundtrip
// jit-stats: вызов sqlish: правила тела для блоков конструкции — интерпретатор
// Конструкция задаёт правила разбора своего блока — из своего тела (решение
// пользователя 2026-10-02): syntax, operator и конструкции, объявленные в теле,
// действуют в блоке, переданном ей в месте вызова; внешние правила места
// наследуются, могут быть дополнены и переопределены. 
// 
// 
// 
// Исполнение блока видит правила тела, объявленные к его
// вычислению (слой над областью вызывающего); прочее тело блоку не видно.
operator (a) <+> (b) => a + b; // правило места — наследуется блоками

sqlish(expr body) {
  syntax pick (x) => x * 2;
  operator (a) ~ (b) => (a * 10) + b;
  body
}

// машинный код блока с правилами тела — интерпретатор (честный отказ компилятора)
calc(i64 n) => sqlish { n ~ 2 };

// конструкция, объявленная в теле, — конструкция блока: twice { … } внутри loop2 { … }
loop2(expr body) {
  twice(expr b) => {
    b;
    b;
  };
  body
}

// переопределение: + в блоке — свой (лексически, только текст блока)
upside(expr body) {
  operator (a) + (b) => sub(a, b);
  body
}

// хвост-инструкция и блок с параметром — тоже блоки конструкции
each(xs, expr body) {
  operator (a) ** (b) => a * (b * b);
  for(k : range(xs.size)) body(xs[k]);
}

main() {
  r = sqlish { 1 ~ 2 };
  q = sqlish { pick (5) };
  w = sqlish { (3 <+> 4) ~ 2 };
  print(r, q, calc(4), 3 <+> 4);
  n = 0;
  loop2 { twice { n += 1; } }
  m = 0;
  loop2 {
    twice() m += 1;
    twice { m += 1; }
  }
  print(w - 70, upside { 7 + 1 }, upside { 7 } + 1 + 8);
  s = 0;
  each(x : array{1, 2}) s += x ** 1;
  print(n, m, s);
}
