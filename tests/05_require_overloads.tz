// store-roundtrip
// out: small
// out: big
// out: odd
// require в начале тела — ограничение кандидата; побеждает самый специфичный.
kind(x) { require(x < 10); "small" }
kind(x) { require(x >= 10); "big" }
kind(x) { require(x >= 10); require(x % 2 == 1); "odd" }

main() {
  print(kind(3));
  print(kind(40));
  print(kind(41));
}
