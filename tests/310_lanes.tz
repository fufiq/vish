// Полосы на ядрах (шаг 12.3b, решение автора «в интерпретаторе сейчас»): «производительность
// — она нужна 1-2 активному приложению… то как там работает остальной мусор — нам максимально
// похрен»;
//
//;.
// Программа — монопольный процесс: основной поток хоста на производительных ядрах, без
// планировщика VM. process(f, …) — фоновый: своя полоса (поток хоста на энергоэффективных
// ядрах, свой планировщик и кольцо), процесс в ней с запуска до конца. Полосы считают
// одновременно; между ними — только потоки (данные) и исход процесса. Машина процессов —
// одна полоса, тот же итог.
// machine
// out: программа: монопольный
// out: фон: фоновый
// out: фон посчитал 4950
// out: программа посчитала 4950
// out: процесс упал: индекс 3 вне границ массива размера 1
// out: конец
work(i64 n) {
  s = 0;
  for(i : range(n)) s += i;
  s
}
side(to) {
  write(to, process_class());
  write(to, work(100));
}
bad(i64 k) => print(array{k}[3]);
main() {
  print("программа:", process_class());
  s = stream();
  p = process(side, s);
  print("фон:", read(s));
  print("фон посчитал", read(s));
  print("программа посчитала", work(100));
  wait(p);
  q = process(bad, 1);
  if(!wait(q)) print("процесс упал: " + error(q));
  print("конец");
}
