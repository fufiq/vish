// out: 97 10 true
// out: 00ff 3.14 42
// machine
// fmt-stable
// store-roundtrip
// native "cpp" { … } (§3.3): 
// 
// text_fixed — тело на C++ в прелюдии, собранное в VM
// (tz native, build.sh); text_hex и parse_int — уже на языке поверх примитива
// text_byte (M6). Символ 'c' — байт (i64), как s[k].
main() {
  s = "a";
  print('a', '\n', s[0] == 'a');
  print(text_hex(255, 4), text_fixed(3.14159, 2), parse_int("42").value);
}
