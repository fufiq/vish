// out: 8080
// out: живо
// error: 172_parse_error_hole.tz:24:25: ошибка: исполнение неразобранного фрагмента: разбор блока: ожидалось целое
// fmt-stable
// fmt-has:   bad = config() { port = "восемь" };
// Ошибка разбора кодом — дыра с причиной на месте атома, остальной текст цел: 
// 
// Разбор —
// лениво, при анализе: блок, до которого исполнение не дошло, ошибкой не мешает;
// дошло — ошибка в месте атома. Альтернатива отдаёт неудачу, ушедшую дальше всех.
struct server { i64 port; }

config(expr body) {
  syntax {r} => parse(r, map(server, {port: combine("port", "=", int() | as(0, word("auto")))}));
  body
}

never() => config { port = };

main() {
  good = config { port = 8080 };
  print(good.port);
  print("живо");
  bad = config { port = "восемь" };
  print(bad.port);
}
