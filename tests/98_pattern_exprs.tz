// out: k первый 7
// out: не k+1
// out: мало много
// machine
// fmt-stable
// Вычисляемые части образца и окружение локальной функции: значение-элемент
// (k), (k + 1) — выражение над областью распаковки; ведущий require локальной
// функции видит захваченные имена (lim), и у тела f(n) => { require(…); … }.
// Машина процессов считает их у помощника над перенесёнными значениями.
main() {
  k = 3;
  lim = 10;
  if(array{(k), x} = array{3, 7}) print("k первый", x);
  if(array{(k + 1), x} = array{3, 7}) print("нет") else print("не k+1");
  small(n) => {
    require(n < lim);
    "мало"
  };
  small(n) => "много";
  print(small(5), small(50));
}
