// out: 7 5 101 9
// out: 3 1 30
// machine
// jit-compiled: sum
// a[i] — парный оператор [] 
// перегрузка своим типам — 
// Массивы и строки — ядро.
struct grid { i64 w; array cells; }
operator (grid g)[i64 k] => g.cells[k] + g.w;

sum(array xs) {
  s = 0;
  for(i : range(xs.size)) s = s + xs[i];
  s
}

main() {
  g = grid{2, array{5, 3}};
  xs = array{1, 4, 9};
  print(g[0], g[1], "hello"[1], xs[2]);
  xs[0] = 3;
  print(xs[0], g.cells[1] - 2, sum(array{10, 20}));
}
