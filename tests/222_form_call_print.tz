// out: 1
// out: 2
// out: 3
// out: 4
// out: 5
// out: 6
// out: 7
// out: 8
// fmt-stable
// store-roundtrip
// fmt-has:   say(1);
// fmt-has:   say(2);
// fmt-has:   step(3) {
// fmt-has: syntax step(x) {b} [[line]] then {c} => {
// fmt-has:   then {
// fmt-has:   all(5, 6, 7);
// fmt-has:   unless (false)
// fmt-has:     say(8);
// Вызов формы syntax печатается той же записью, что и узел ядра (§4.4, вариант C):
// объявление формы — запись, места — аргументы по порядку частей; `;` в записи
// кончает инструкцию — второй не ставится (раньше: `say(1);;`), пометки раскладки
// и части-списки — как у записей узлов; `say (2)` — та же запись, что `say(2)`.
// 
// *Моё:* вызов формы — запись «по связи» (форму выбрал
// разбор, печать её не перевыбирает).
syntax say (x); => print(x);
syntax step(x) {b} [[line]] then {c} => {
  print(x);
  b;
  c;
};
syntax all(xs, ...) => {
  for(x : xs) print(x);
};
syntax unless [[space]] (bool c) [[indent]] {b} => if(!c) b;

main() {
  say(1);
  say (2);
  step(3) {
    say(4);
  } then {
    all(5, 6, 7);
  }
  unless(false) say(8);
}
