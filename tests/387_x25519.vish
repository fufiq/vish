// X25519 (RFC 7748) in the language: key exchange. Vectors - RFC 7748 §5.2 (dot multiplication) and §6.1 (Alice and Bob: public keys and a shared
// secret), checked with OpenSSL (Python cryptography): point multiplication, Alice's public key, (common secret RFC 4a5d9d5b... - the same function
// x25519, verified independently). Two calls - each about 7 seconds in the interpreter and 0.6 seconds with the JIT: the test is deliberately short.
// out: c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552
// out: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
// out: короткий: X25519: скаляр и точка — по 32 байта
hex_val(i64 c) => if(c <= 57) c - 48 else c - 87;
unhex(str h) {
  r = "";
  for(k : range(h.size / 2)) r.push(text_byte((hex_val(h[2 * k]) << 4) | hex_val(h[(2 * k) + 1])));
  r
}
hex_of(str b) {
  r = "";
  for(k : range(b.size)) r = r + text_hex(b[k], 2);
  r
}
main() {
  print(hex_of(x25519(unhex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"), unhex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c"))));
  a = unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
  pb = unhex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f");
  print(hex_of(x25519_base(a)));
  try {
    x25519("x", pb);
  } catch(crypto_error e) {
    print("короткий: " + e.message);
  }
}
