// push(xs, x) when executed is the same append(xs, x) without a wrap frame prelude: the
// array parameter grows in the caller, the field and element go the usual way, the user
// overload push is not replaced.
// out: 3 [1, 2, 3]
// out: 2 [5, 6]
// out: 1 [7]
// out: s1
grow(mut xs, x) { xs.push(x); }
struct box { array items; }
main() {
  xs = array{1};
  xs.push(2);
  push(xs, 3);
  print(xs.size, xs);
  ys = array{5};
  grow(ys, 6);
  print(ys.size, ys);
  b = box{array{}};
  b.items.push(7);
  print(b.items.size, b.items);
  print("s1");
}
