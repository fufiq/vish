// Running (F5) is the process of the machine in the same VM: the server executes it with quanta and does not stand up.
// 
// 
//.
// run: live
// quantum: 5000
// program: editor_live.vish
open_view module
run
wait 3
// conclusion
// expect: output text="0 8994\n" ok=true more=false state="running"
// It starts with what is executed (node), the string has its print.
// expect: label="main:18" now=#
// brows - by changing the state: "performed" with the first piece
// expect: status kind="run" text="исполняется" hint="⇧F5 остановить"
// editing during launch: the process executes the received code - a draft with editing is not visible to him
pointer 1 @2:1 0 1
key 1 Backspace
key 1 3
key 1 Escape
// expect: output text="16 8994\n" ok=true more=true state="running"
// Draft closed: editing is in the live process (hot replacement, §9.3) - step(i) is already 3·i
wait
// expect: output text="36 8994\n" ok=true more=true state="running"
// expect: output text="108 8994\n" ok=true more=true state="running"
// expect: output text="" ok=true more=true state=""
// expect-not: output text="24 8994\n"
// Shift+F5 - Stop, no program - tell
run
wait 2
stop
// expect: output text="" ok=true more=true state="stopped"
// expect: status kind="done" text="остановлено"
stop
// expect: error text="запуск: программа не исполняется"
