// out: 34 -7 0
// jit-compiled: digits
// Служба VM внутри цикла машинного кода: узел вычисляет VM (text_byte — примитив),
// вычисление запускает компиляцию, компилятор на языке исполняет свой машинный код
// (TZ_JIT_SELF) — интерпретатор службы после этого — снова внешний (было: висячий
// указатель, сигнал 11 на второй итерации). text(i64) — на языке (M6, шаг 1).
digits(i64 n) {
  s = "";
  k = n;
  loop {
    s = text_byte('0' + (k % 10)) + s;
    k = k / 10;
    if(k == 0) break;
  }
  s
}

main() {
  print(digits(34), text(-7), text(0));
}
