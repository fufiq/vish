// stdin: 1 2 3
// stdin: 4 5 6
// out: 32.0
// jit-compiled: dot
// Программа для сценария 32_jit_edit.session.
dot(a, b) {
  require(a.size == b.size);
  s = zero(typeof(a[0]));
  for(i : range(a.size)) s = s + (a[i] * b[i]);
  s
}

main() {
  xs = read_floats(stdin);
  ys = read_floats(stdin);
  print(dot(xs, ys));
}
