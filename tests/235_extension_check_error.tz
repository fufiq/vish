// error: 235_extension_check_error.tz:16:1: ошибка: infix<+>: перегрузка только для типов с полем x
// error: оператор объявлен здесь
// Своя проверка расширений (§9.1) отвергает перегрузку: у w нет поля x — ошибка
// разбора на объявлении расширения (не на вызове и не в проверке), пометка — у
// объявления сущности. Проверка — та же, что в тесте 234.
[[extension(has_x)]] operator (a) <+> (b) => a + b;

struct pt {
  i64 x;
}
struct w {
  i64 v;
}
operator (pt a) <+> (pt b) => pt{a.x + b.x};

operator (w a) <+> (w b) => w{a.v + b.v};

has_x(ext, entity) {
  ok = true;
  if(code_kind(ext) == n_fn) {
    n_fn{_, params, _, _, _, _, _, _, _} = ext;
    for(p : params) {
      n_param{_, t, _, _, _, _, _} = p;
      if(given(t)) {
        if(!has_field(type_of_code(t), "x")) ok = false;
      }
    }
  }
  require(ok, code_name(entity) + ": перегрузка только для типов с полем x", "оператор объявлен здесь", entity);
}
has_field(T, str name) {
  found = false;
  for(f : fields(T)) if(f.name == name) found = true;
  found
}

main() {
  print((pt{1} <+> pt{2}).x);
}
