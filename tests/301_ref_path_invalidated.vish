// The link-path is based on the buffer of the array of the first step (§12.1): push it disables
// - use after - "dangerous-dangerous", error parsing in the way (hooks support, like y &e =
// v[i]). In the performance - only if the data has moved (generation).
// check-error: ссылка на элемент использована после инвалидации опоры
// check-error: опора инвалидирована здесь
// out: 4
struct point { i64 x; i64 y; }
main() {
  ps = array{point{1, 2}, point{3, 4}};
  &f = ps[1].y;
  ps.push(point{5, 6});
  print(f);
}
