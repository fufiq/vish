// Программа для сценария 133_editor_context.wire (сама по себе — тест: форма выше
// своего объявления — дыра, §4.4).
// error: editor_context.tz:7:9: ошибка: ожидалось ';'
// fmt-has: /* дыра: ожидалось ';' */ twice { n += 1; }
early() {
  n = 0;
  twice { n += 1; }
  n
}

syntax twice {body} => {
  body;
  body;
};

when(c, expr body) {
  if(c) body;
}

count() {
  n = 0;
  twice { n += 2; }
  when(n > 1) n += 10;
  n
}

main() {
  print(early(), count());
}
