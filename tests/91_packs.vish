// out: 6 0 7
// out: 15 4 26
// out: 3
// machine
// fmt-stable
// store-roundtrip
// Паки: 
// 
// The tail of the parameters ...xs is the remnant of the arguments with the tuple (T...xs -
// each is represented in T); ...t, when called, opens the array / tuple into arguments. The
// exact number of arguments is more specific than the tail.
sum(...xs) => total(xs);

total(array{}) => 0;

total(array{x, ...xs}) => x + total(xs);

first(x, ...rest) => x;

ints(i64... xs) => xs.size;

main() {
  print(sum(1, 2, 3), sum(), first(7, 8, 9));
  t = array{4, 5, 6};
  print(sum(...t), first(...t), sum(1, ...t, 10));
  print(ints(1, 2.0, 3));
}
