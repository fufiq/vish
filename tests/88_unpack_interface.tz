// out: 3 7 2 2 4 1
// out: пусто с нуля прочее
// machine
// fmt-stable
// store-roundtrip
// Распаковка через интерфейс: 
//  
// Элемент .обращение: подобразец.поле, .size, [k], цепочки;
// позиционные элементы и обращения вместе. Обращение не удалось (нет элемента,
// граница) — не распаковалось: 
//  — kind(array{}) не падает на [0].x.
struct point { i64 x; i64 y; }

struct line { point a; point b; }

norm(p) => p.x + p.y;

main() {
  array{.size: n} = array{4, 5, 6};
  array{x, ...xs, .size: (3)} = array{7, 8, 9};
  point{.y: b} = point{1, 2};
  line{.b.y: by, .a: point{ax, _}} = line{point{1, 2}, point{3, 4}};
  kind(array{.size: (0)}) => "пусто";
  kind(array{[0].x: (0)}) => "с нуля";
  kind(array{...xs}) => "прочее";
  print(n, x, xs.size, b, by, ax);
  print(kind(array{}), kind(array{point{0, 5}}), kind(array{point{1, 5}}));
}
