// out: норма 3
// out: не 4
// fmt-stable
// machine
// Обращение к интерфейсу — и функция значения: .norm() ≡ norm(значение) (§4.5);
// так распаковываются и не-агрегаты — по  
// Машина процессов вычисляет вызов у помощника над значением.
struct point { i64 x; i64 y; }

norm(p) => p.x + p.y;

main() {
  if(point{.norm(): (3)} = point{1, 2}) print("норма 3");
  if(point{.norm(): (4)} = point{1, 2}) print("норма 4") else print("не 4");
}
