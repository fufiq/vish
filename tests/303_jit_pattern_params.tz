// Параметры-образцы в машинном коде (хвост шага 10): кандидата по значению выбирает VM
// 
// имена экземпляр получает распаковкой значения параметра на входе — той же
// службой VM, что инструкция образец = значение (её семантика целиком). Рекурсия по
// образцу — каждый вызов снова выбирает кандидата (array{} — конец).
// jit-compiled: sum
// jit-compiled: head
// jit-compiled: len2
// jit-compiled: swap_sum
// machine
// out: 15 9 0
// out: 25.0 7
struct point { f64 x; f64 y; }

sum(array{}) => 0;
sum(array{x, ...xs}) => x + sum(xs);
head(array{x, ...xs}) => x;
head(array{}) => 0;
len2({x: a, y: b}) => (a * a) + (b * b);
swap_sum(array{a, array{b, c}}) => a + b + c; // вложенный образец

main() {
  xs = array{1, 2, 3, 4, 5};
  print(sum(xs), head(array{9, 8}), head(array{}));
  print(len2(point{3.0, 4.0}), swap_sum(array{1, array{2, 4}}));
}
