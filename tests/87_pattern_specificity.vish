// out: пара с нулём много пара
// machine
// fmt-stable
// Специфичность образцов: 
// Точная длина конкретнее остатка, проверка типа или
// значения конкретнее имени: array{1, 2} — «пара», а не «много»; array{1.5, 0} —
// «пара»: i64 a не подходит к 1.5.
main() {
  f(array{x, ...xs}) => "много";
  f(array{a, b}) => "пара";
  f(array{i64 a, (0)}) => "с нулём";
  print(f(array{1, 2}), f(array{1, 0}), f(array{1, 2, 3}), f(array{1.5, 0}));
}
