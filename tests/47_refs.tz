// args: 4
// out: 10 5 4 10
// out: 4 4 2
// out: 20 1
// fmt-stable
// store-roundtrip
// Ссылки и опоры (§12.1, M2c): «опасное-безопасное» разрешено — несколько
// изменяемых алиасов, запись в другие элементы, изменение значения элемента
// 
//.
inc(auto x) { x += 1; }

// два изменяемых алиаса на один массив — ok
swap_ends(mut auto a, mut auto b) {
  auto t = a[0];
  a[0] = b[b.size - 1];
  b[b.size - 1] = t;
}

main() {
  auto n = parse_int(args[1]).value;
  auto v = array{1, 2, 3};
  auto& e = v[0];     // ссылка, опора — буфер v
  v[1] = 5;           // другой элемент — буфер тот же
  e = 10;             // запись через ссылку
  inc(v[2]);          // элемент в изменяемый параметр — ссылка, не копия
  print(v[0], v[1], v[2], e);
  push(v, n);         // рост: буфер может переехать
  auto& f = v[3];     // новая ссылка — после push
  auto w = array{1, 2};
  swap_ends(w, w);
  print(v.size, f, w[0]);
  f = 20;             // f взята после push — действительна
  print(v[3], w[1]);
}
