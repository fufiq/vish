// machine
// slice: main total
// slice-has: xs = read_floats(stdin);
// slice-has: for(x : xs) total = total + (x * x);
// slice-has: print(total);
// slice-lacks: count
// slice-lacks: xs) ;
// 
//.
main() {
  xs = read_floats(stdin);
  total = 0.0;
  count = 0;
  for(x : xs) total = total + (x * x);
  for(x : xs) count = count + 1;
  print(total);
  print(count);
}
