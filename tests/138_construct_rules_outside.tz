// error: 138_construct_rules_outside.tz:23:9: ошибка: нет оператора «~»
// error: 138_construct_rules_outside.tz:24:10: ошибка: ожидалось ';'
// fmt-has: /* дыра: нет оператора «~» */ x = 1 ~ 2;
// fmt-has: /* дыра: ожидалось ';' */ python { 1 }
// Правила тела конструкции — только в её блоках (§4.4): снаружи блока `~` не
// объявлен, python (конструкция тела cpp) вне блоков cpp — не конструкция; внутри
// тела самой конструкции её правила — от объявления до конца тела.
//.
sqlish(expr body) {
  operator (a) ~ (b) => (a * 10) + b;
  body
}

cpp(expr body) {
  python(expr b) => {
    b
  };
  body
}

main() {
  r = sqlish { 1 ~ 2 };
  x = 1 ~ 2;
  python { 1 }
  cpp {
    python { 2 }
  };
  print(r);
}
