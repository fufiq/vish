// store-roundtrip
// args: 5
// out: 120
// out: 120
// machine
// check: fact  ×5
// check: fact(рт i64)  ×1
// check: r = рт i64
// Recursion on compile-time is executed; on run-time - fixed point:
// instances are reduced to a general type.
fact(n) {
  if(n <= 1) return 1;
  n * fact(n - 1)
}

main() {
  print(fact(5));
  r = fact(parse_int(args[1]).value);
  print(r);
}
