// out: 42 7
// out: true false
// Цепочка без скобок с атомами над кодом: 
//  
// Перебор берёт типы атомов в пробнике, где значения окружения стёрты до
// типа; код — ссылка на узел, рт-части у него нет, стёртый он не узел. Было:
// `code_kind(c) != ast.int || code_text(c) != "7000"` — «ожидался код (quote)».
[[transform]] shrink(c) {
  if(code_kind(c) != ast.int || code_text(c) != "7000") return;
  ast.int{7}
}

is_call_of(c, str name) => code_kind(c) == ast.call && code_name(c) == name;

main() {
  print(42, 7000);
  print(ct { is_call_of(code(print(1)), "print") }, ct { is_call_of(code(1), "print") });
}
