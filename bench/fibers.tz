// Замер переключений файберов (2026-09-29): 
// args[1]: 1 — пинг-понг через два потока
// ёмкости 1 (каждый обмен — два переключения), 2 — производитель → потребитель
// через поток ёмкости 16 (генератор: VM может свернуть в цикл, O11),
// 3 — то же без файберов (эталон для свёртки), 4 — пинг-понг в n/200 парах
// файберов (n обменов всего): переключения по кругу через все стеки. Циклы — в своих функциях:
// их берёт JIT, spawn с замыканием остаётся интерпретатору.
echo(a, b) {
  for(x : a) write(b, x + 1);
  close(b);
}

drive(a, b, n) {
  s = 0;
  for(i : range(n)) {
    write(a, i);
    s += read(b);
  }
  close(a);
  s
}

ping(n) {
  a = stream(1);
  b = stream(1);
  spawn { echo(a, b); }
  drive(a, b, n)
}

fill(s, n) {
  for(i : range(n)) write(s, i * 2);
  close(s);
}

total(s) {
  t = 0;
  for(x : s) t += x;
  t
}

produce(n) {
  s = stream(16);
  spawn { fill(s, n); }
  total(s)
}

direct(n) {
  t = 0;
  for(i : range(n)) t += i * 2;
  t
}

pairs(n) {
  k = n / 200; // рантайм: разбор не прокручивает цикл по-настоящему
  done = stream(k);
  for(p : range(k)) {
    a = stream(1);
    b = stream(1);
    spawn { echo(a, b); }
    spawn { write(done, drive(a, b, n / k)); }
  }
  t = 0;
  for(p : range(k)) t += read(done);
  t
}

main() {
  mode = parse_int(args[1]).value;
  n = parse_int(args[2]).value;
  if(mode == 1) print(ping(n));
  if(mode == 2) print(produce(n));
  if(mode == 3) print(direct(n));
  if(mode == 4) print(pairs(n));
}
