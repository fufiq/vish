module versions;
// The base versions are diff and fusion in the language (§9.4; step 2 transfer tuling). The module is
// built into the build; it is seen by the editor (use versions) and commands vish diff, vish merge.

use tools;
// Primitives: version of the database (VM) ------------------------------------------------------- version -
// a copy of the database on the magazine .vishdb; number 0 - the base from which they work (editor's session
// program), the vish team - empty. The common beginning of the two versions is their common base.

// -1 - not opened (version_error - why)
version_open(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->open(std::string((a[0]).as<str_v>().view())));
};
// version from the program text (main.vish, modules nearby); -1 - not understood (version_error - why)
version_from_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->parse_text(std::string((a[0]).as<str_v>().view())));
};
version_error() => native "cpp" { return value(tools_host->error); };
// Common base of versions a and b (root - root a)
version_base(i64 a, i64 b) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->base((a[0]).as<int64_t>(), (a[1]).as<int64_t>()));
};
// copy no longer needed
version_close(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  tools_host->close((a[0]).as<int64_t>());
  return value(int64_t(0));
};
// Elements of the version module and what element (version_items, version_signature) is in the tool module:
// they are needed and sessions (edited). Element of the module root version v - text, parsing according to
// the rules of its place (§4.4): mine - replace it (node saves id), -1 - new after (-1 - at the end); layout
// - empty lines, internal, comments. The result is the element number; I did not understand -1.
//
version_put(i64 v, i64 root, i64 mine, str text, str name, i64 after, i64 blank, bool inner, lead, str tail) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(-1)));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(int64_t(-1));
  node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>());
  if(!m) return value(int64_t(-1));
  auto num = [](value const & v) { return v.as<int64_t>() < 0 ? node_id{} : node_id(uint32_t(v.as<int64_t>())); };
  node_note note;
  for(uint32_t k = 0; k < (a[8]).as<array_v>().size(); ++k) note.lead.emplace_back((a[8]).as<array_v>().get(k).as<str_v>().view());
  note.tail = std::string((a[9]).as<str_v>().view());
  node_id got = put_item(*x->db, m, num(a[2]), std::string((a[3]).as<str_v>().view()), std::string((a[4]).as<str_v>().view()), num(a[5]), uint32_t((a[6]).as<int64_t>()), (a[7]).as<bool>(), std::move(note));
  return value(got ? int64_t(got.value) : int64_t(-1));
};
// Remove element n of the root v module
version_remove(i64 v, i64 root, i64 n) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(int64_t(0));
  if(node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>()); m && (a[2]).as<int64_t>() >= 0) remove_item(*x->db, m, node_id(uint32_t((a[2]).as<int64_t>())));
  return value(int64_t(0));
};
// journal version v - in the file .vishdb; "" - written, otherwise error
version_save(i64 v, str path) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(std::string("нет версии"));
  try {
    save_area(*x->db, x->root, std::string((a[1]).as<str_v>().view()));
  } catch(std::exception const & e) {
    return value(std::string(e.what()));
  }
  return value(std::string());
};
// --- Base versions: Semantic Diff and Tripartite Merger (§9.4) ---
//  
// Live editing through VM does not give conflicts. Copies of the base
// only diverge when the work was in two places.
// 
// 
// The base is the versions and their elements; the decision (whose, what's taken, where's the conflict) is
// here. Diff and fusion - by module elements: the function is recognized by name and signature, not by lines.

// The module element in the version: who is it (id - node number, if the element was in the common database:
// change of signature - editing the same element; otherwise - the key), as it is called (key), what it is
// (text projection) and its layout: internal (§13.3), empty lines in front of it, comments, the neighbor in
// front of it (after - its id): - the element is transferred with everything that it has.
struct item { bool present; i64 node; str id; str key; str text; bool inner; i64 blank; array lead; str tail; str after; }
no_item() => item{false, -1, "", "", "", false, 0, array{}, "", ""};
// Key element: function - name and types of parameters, syntax - words of form recording, struct,
// extensions, variable - name; other - the text itself.
item_key(i64 v, i64 n, str shown) {
  array{kind, name, parts, target} = version_signature(v, n);
  if(kind == "syntax") {
    k = "syntax";
    for(p : parts) k = k + " " + p;
    return k;
  }
  if(kind == "fn") {
    k = name + "(";
    for(j : range(parts.size)) k = k + (if(j > 0) ", " else "") + parts[j];
    return k + ")";
  }
  if(kind == "struct") return "struct " + name;
  if(kind == "extend_ref") return "&" + item_key(v, target, "") + " { … }";
  if(kind == "extend") return name + " { … }";
  if(kind == "var") return name;
  shown
}
// Elements of the root module v (-1 is the program module); base_items is the number of the common base elements.
module_items(i64 v, i64 root, base_items) {
  found = array{};
  prev = "";
  for(x : version_items(v, root)) {
    array{n, shown, inner, blank, lead, tail} = x;
    kind = version_signature(v, n)[0];
    if(((kind == "var") || ((kind == "other") || starts_with(shown, "use "))) && !ends_with(shown, ";")) shown = shown + ";"; // variable, service assignment and use are printed without ;: in the text of the module it is needed
    first = item_key(v, n, shown);
    key = first;
    j = 2;
    while(find_item(found, key).present) {
      key = first + " #" + text(j);
      j += 1;
    }
    id = if(has_number(base_items, n)) "#" + text(n) else key;
    found.push(item{true, n, id, key, shown, inner, blank, lead, tail, prev});
    prev = id;
  }
  found
}
find_item(xs, str id) {
  r = no_item();
  for(x : xs) if(!r.present && (x.id == id)) r = x;
  r
}
find_key(xs, str key) {
  r = no_item();
  for(x : xs) if(!r.present && (x.key == key)) r = x;
  r
}
// What compares the merger: text and layout (there is no element - also state)
same_state(item x, item y) {
  if(x.present != y.present) return false;
  if(!x.present) return true;
  (x.text == y.text) && ((x.inner == y.inner) && ((x.blank == y.blank) && ((x.tail == y.tail) && same_lines(x.lead, y.lead))))
}
// Replace (or add or remove) the element id of the root module v with their element: text - parsing in place
// of the element (§4.4), layout - as they have; new - after the same neighbor as them (no one - at the end).
// The result is the element number (-1 - removed or not understood).
take_theirs(i64 v, i64 root, base_items, str id, item theirs) {
  items = module_items(v, root, base_items);
  mine = find_item(items, id);
  if(!theirs.present) {
    if(mine.present) version_remove(v, root, mine.node);
    return -1;
  }
  prev = find_item(items, theirs.after);
  body = if(starts_with(theirs.text, "use ") && !ends_with(theirs.text, ";")) theirs.text + ";" else theirs.text; // use is printed without ";"
  version_put(v, root, if(mine.present) mine.node else -1, body, id, if(prev.present) prev.node else -1, theirs.blank, theirs.inner, theirs.lead, theirs.tail)
}
// Conflict is both options for a person: the text of the common base, mine, them (there is no element in the
// version) and their element with a layout - for "take them."
struct conflict { str id; str key; str base; str mine; str theirs; item their; }
// taken_why - to the self-taken: from where and whether it is visible in the module (frame "Merge")
struct merge_result { array taken; array taken_why; array conflicts; array base_items; }
no_merge() => merge_result{array{}, array{}, array{}, array{}};
// The three-way merging of their version into mine (mine changes on the spot): what is changed is taken by
// themselves, and conflict is different in both.
merge_versions(i64 mine, i64 theirs) {
  bv = version_base(mine, theirs);
  base_items = array{};
  for(x : version_items(bv, -1)) base_items.push(x[0]);
  b = module_items(bv, -1, base_items);
  m = module_items(mine, -1, base_items);
  t = module_items(theirs, -1, base_items);
  version_close(bv);
  ids = array{};
  for(x : b) if(!has_text(ids, x.id)) ids.push(x.id);
  for(x : m) if(!has_text(ids, x.id)) ids.push(x.id);
  for(x : t) if(!has_text(ids, x.id)) ids.push(x.id);
  r = no_merge();
  r.base_items = base_items;
  for(id : ids) {
    bi = find_item(b, id);
    mi = find_item(m, id);
    ti = find_item(t, id);
    name = if(mi.present) mi.key else if(ti.present) ti.key else bi.key;
    if(!same_state(mi, ti) && !same_state(ti, bi)) {
      // They have changed or they have not changed.
      if(same_state(mi, bi)) {
        // They are only changed by themselves.
        take_theirs(mine, -1, base_items, id, ti);
        r.taken.push(name);
        r.taken_why.push(if(ti.inner) "взята из их копии — внутренняя, в модуле не видна" else "взята из их копии");
      } else r.conflicts.push(conflict{id, name, bi.text, mi.text, ti.text, ti});
    }
  }
  r
}
// Bilateral diff: What is B different than A (by module elements).
diff_versions(i64 a, i64 b) {
  xa = module_items(a, -1, array{});
  xb = module_items(b, -1, array{});
  r = "";
  for(x : xa) {
    y = find_key(xb, x.key);
    if(!y.present) r = r + ("- " + x.key + "\n") else if(y.text != x.text) r = r + ("~ " + x.key + "\n  было:  " + x.text + "\n  стало: " + y.text + "\n") else if(!same_state(x, y)) r = r + ("~ " + x.key + " — раскладка (внутренний, пустые строки, комментарий)\n");
  }
  for(y : xb) if(!find_key(xa, y.key).present) r = r + ("+ " + y.key + "\n  " + y.text + "\n");
  if(r == "") "без различий\n" else r
}
// --- commands vish: diff, merge (cli loads the module by key) ------------------------------------------------------- vish diff a.vishdb
// b.vishdb - semantic diff of bases
diff_files(str a, str b) {
  va = version_open(a);
  if(va < 0) return fail(version_error());
  vb = version_open(b);
  if(vb < 0) return fail(version_error());
  write_out(diff_versions(va, vb));
  0
}
// vish merge my.vishdb their.vishdb [total.vishdb] - tripartite merger; conflicts are my variant, code 1
merge_files(str mine, str theirs, str result) {
  mv = version_open(mine);
  if(mv < 0) return fail(version_error());
  tv = version_open(theirs);
  if(tv < 0) return fail(version_error());
  r = merge_versions(mv, tv);
  for(k : r.taken) write_out("взято у них: " + k + "\n");
  for(c : r.conflicts) write_out("конфликт: " + c.key + "\n  база: " + dash(c.base) + "\n  мой:  " + dash(c.mine) + "\n  их:   " + dash(c.theirs) + "\n");
  why = version_save(mv, result);
  if(why != "") return fail(why);
  write_out("записано: " + result + (if(r.conflicts.size == 0) "" else " (конфликты — мой вариант; слить руками)") + "\n");
  if(r.conflicts.size == 0) 0 else 1
}
dash(str s) => if(s == "") "—" else s;
// entry points for cli: words after command
diff_command(args) => if(args.size == 2) diff_files(args[0], args[1]) else 2;
merge_command(args) => if(args.size >= 2) merge_files(args[0], args[1], if(args.size >= 3) args[2] else args[0]) else 2;
// Local repository (§9.4). The container mechanics belong to the host; the history,
// the choice of the common base and the merge decisions are here. This is our development of the author's ideas of
// key=>ast (2022-11-04) and stable semantic references (2023-05-29).
// Names, the directory, snapshot numbers/parents and applying a state are in Vish.
repo_builtin(str name) => has_text(array{"prelude", "tools", "versions", "tests", "cli", "editor", "lexer", "parser", "printer", "runlog", "modules", "views", "complete", "session", "proto", "server"}, name);
repo_ident_start(i64 c) => ((c >= 'a') && (c <= 'z')) || (((c >= 'A') && (c <= 'Z')) || ((c == '_') || (c >= 128)));
repo_name_ok(str name) {
  if((name.size == 0) || ((name.size > 256) || repo_builtin(name))) return false;
  first = true;
  for(k : range(name.size)) {
    c = name[k];
    if(c == '.') {
      if(first) return false;
      first = true;
    } else {
      if(!repo_ident_start(c) && (first || !((c >= '0') && (c <= '9')))) return false;
      first = false;
    }
  }
  !first
}
repo_direct(i64 s, str op, str key, str body, i64 n, i64 other) {
  r = repository_storage(s, op, key, body, n, other);
  if(!r[0]) throw r[1];
  r
}
repo_catalog_data(mods) {
  rows = array{};
  for(m : mods) rows.push(array{m.node, m.name});
  rows
}
repo_native_modules(i64 s, i64 snapshot) {
  r = array{};
  for(x : repo_direct(s, "modules", "", "", snapshot, 0)[3]) r.push(repo_mod{x[3], x[4]});
  r
}
repo_check_catalog(mods, i64 root) {
  ids = array{};
  names = array{};
  for(m : mods) {
    if(!repo_name_ok(m.name) || (has_number(ids, m.node) || has_text(names, m.name))) throw "повреждён каталог модулей";
    ids.push(m.node);
    names.push(m.name);
  }
  if(!has_number(ids, root)) throw "в каталоге нет корневого модуля";
  true
}
repo_normalize(i64 s) {
  info = repo_direct(s, "state", "", "", 0, 0);
  if(info[1] == "") return 0;
  repo_direct(s, "live", "", "", 0, 0);
  root = version_root(0);
  mods = repo_native_modules(s, 0);
  changed = false;
  for(k : range(mods.size)) {
    name = version_module_name(0, mods[k].node);
    if((name == "") && (mods[k].node == root)) name = "main";
    if(mods[k].name != name) {
      mods[k].name = name;
      changed = true;
    }
  }
  repo_check_catalog(mods, root);
  if(changed) repository_catalog(s, repo_catalog_data(mods));
  0
}
repo_restore_state(i64 s, i64 snapshot) {
  old = repo_native_modules(s, 0);
  target = repo_native_modules(s, snapshot);
  v = repo_direct(s, "version", "", "", snapshot, 0)[2];
  roots = array{};
  for(m : target) roots.push(m.node);
  repository_tree(s, v, roots, array{});
  version_close(v);
  for(m : old) if(repo_mod_of(target, m.node).node < 0) repository_clear(s, m.node);
  repository_catalog(s, repo_catalog_data(target));
  0
}
repo_take_module(i64 s, i64 snapshot, i64 node, str choice) {
  live = repo_native_modules(s, 0);
  target = repo_mod_of(repo_native_modules(s, snapshot), node);
  next = array{};
  removed = array{};
  for(m : live) if(m.node != node) {
    if((target.node >= 0) && (m.name == target.name)) {
      if((choice != "theirs") || (m.node == version_root(0))) throw "конфликт имён модулей";
      removed.push(m.node);
    } else next.push(m);
  }
  if(target.node < 0) {
    if(node == version_root(0)) throw "нельзя удалить корневой модуль";
    repository_clear(s, node);
  } else {
    v = repo_direct(s, "version", "", "", snapshot, 0)[2];
    repository_tree(s, v, array{node}, array{});
    version_close(v);
    next.push(target);
  }
  for(id : removed) repository_clear(s, id);
  repository_catalog(s, repo_catalog_data(next));
  0
}
repo_take_item(i64 s, i64 snapshot, i64 module, i64 node) {
  if(repo_mod_of(repo_native_modules(s, 0), module).node < 0) throw "нет модуля слияния";
  v = repo_direct(s, "version", "", "", snapshot, 0)[2];
  target = repo_items(v, module);
  chosen = find_item(target, text(node));
  if(!chosen.present) version_remove(0, module, node) else {
    live = repo_items(0, module);
    at = 0;
    before = true;
    for(m : target) {
      if(m.node == node) before = false;
      if(before) {
        index = 0;
        for(x : live) if(x.node != node) {
          if(x.node == m.node) at = index + 1;
          index += 1;
        }
      }
    }
    repository_tree(s, v, array{module}, array{node});
    repository_attach(s, module, node, at, chosen.blank, chosen.inner);
  }
  version_close(v);
  0
}
repository_raw(i64 s, str op, str key, str body, i64 n, i64 other) {
  try {
    if(op == "init") {
      if(!ends_with(key, ".vishrepo")) throw "путь должен оканчиваться на .vishrepo";
      if(repo_direct(s, "state", "", "", 0, 0)[1] != "") throw "репозиторий уже открыт";
      repo_direct(s, "live", "", "", 0, 0);
      root = version_root(0);
      mods = array{};
      for(x : version_modules(0)) if((x[1] != "") || (x[0] == root)) {
        name = if(x[1] == "") "main" else x[1];
        if(!repo_builtin(name)) mods.push(repo_mod{x[0], name});
      }
      repo_check_catalog(mods, root);
      repo_direct(s, "init", key, "", 0, 0);
      repository_catalog(s, repo_catalog_data(mods));
      repo_direct(s, "branch", "main", "", 0, 1);
    } else if(op == "capture") {
      if((key.size == 0) || (key.size > 512)) throw "нужно имя снимка до 512 байт";
      info = repo_direct(s, "state", "", "", 0, 0);
      next = 0;
      ids = array{0};
      for(x : info[3]) {
        if(x[0] == "current") next = x[1];
        if(x[0] == "snapshot") ids.push(x[1]);
      }
      if((next <= 0) || (next > 4096)) throw "не больше 4096 снимков";
      if(!has_number(ids, n) || !has_number(ids, other)) throw "нет родителя снимка";
      repo_normalize(s);
      id = repository_checkpoint(s, next, key, n, other);
      return array{true, info[1], id, array{}};
    } else if(op == "branch") {
      if((key.size == 0) || (key.size > 128)) throw "нужно имя ветки до 128 байт";
      found = n == 0;
      for(x : repo_direct(s, "state", "", "", 0, 0)[3]) if((x[0] == "snapshot") && (x[1] == n)) found = true;
      if(!found) throw "нет снимка ветки";
    } else if(op == "module") {
      if(!repo_name_ok(key)) throw "недопустимое имя модуля";
      mods = repo_native_modules(s, 0);
      for(m : mods) if(m.name == key) throw "модуль уже есть";
      result = repo_direct(s, "module", key, "module " + key + (";\n" + body), 0, 0);
      mods.push(repo_mod{result[2], key});
      repository_catalog(s, repo_catalog_data(mods));
      return result;
    } else if(op == "restore") repo_restore_state(s, n) else if(op == "take-module") repo_take_module(s, n, other, body) else if(op == "take-item") repo_take_item(s, n, number_of(key), other);
    if((op == "init") || ((op == "restore") || ((op == "take-module") || (op == "take-item")))) return array{true, "", 0, array{}};
    if((op == "state") || (op == "save")) repo_normalize(s);
    repo_direct(s, op, key, body, n, other)
  } catch(e) {
    array{false, text(e), 0, array{}}
  }
}
repo_op(i64 s, str op, str key, str body, i64 n, i64 other) {
  r = repository_raw(s, op, key, body, n, other);
  if(!r[0]) throw r[1];
  r
}
repo_rows(i64 s) => repo_op(s, "state", "", "", 0, 0)[3];
repo_head(i64 s) => repo_op(s, "state", "", "", 0, 0)[2];
repo_branch(i64 s) {
  r = "";
  for(x : repo_rows(s)) if(x[0] == "current") r = x[4];
  r
}
struct repo_mod { i64 node; str name; }
repo_modules(i64 s, i64 snapshot) {
  found = array{};
  for(x : repo_op(s, "modules", "", "", snapshot, 0)[3]) found.push(repo_mod{x[3], x[4]});
  found
}
repo_mod_of(xs, i64 node) {
  r = repo_mod{-1, ""};
  for(x : xs) if(x.node == node) r = x;
  r
}
repo_union(xs, ys) {
  r = xs;
  for(y : ys) if(repo_mod_of(r, y.node).node < 0) r.push(y);
  r
}
repo_version(i64 s, i64 snapshot) => if(snapshot > 0) repo_op(s, "version", "", "", snapshot, 0)[2] else repo_op(s, "live", "", "", 0, 0)[2];
repo_items(i64 v, i64 m) {
  r = module_items(v, m, array{});
  for(k : range(r.size)) {
    r[k].id = text(r[k].node);
    r[k].after = if(k > 0) text(r[k - 1].node) else "";
  }
  r
}
repo_same(i64 av, item a, i64 bv, item b) {
  if(a.present != b.present) return false;
  if(!a.present) return true;
  same_state(a, b) && ((a.after == b.after) && ((a.key == b.key) && (version_structure(av, a.node) == version_structure(bv, b.node))))
}
repo_mod_same(i64 av, repo_mod a, i64 bv, repo_mod b) {
  if((a.node < 0) != (b.node < 0)) return false;
  if(a.node < 0) return true;
  (a.name == b.name) && (version_structure(av, a.node) == version_structure(bv, b.node))
}
repo_diff(i64 s, i64 from, i64 to) {
  av = repo_version(s, from);
  bv = repo_version(s, to);
  am = repo_modules(s, from);
  bm = repo_modules(s, to);
  shown = "";
  for(m : repo_union(am, bm)) {
    a = repo_mod_of(am, m.node);
    b = repo_mod_of(bm, m.node);
    if(a.node < 0) shown = shown + ("+ модуль " + b.name + "\n") else if(b.node < 0) shown = shown + ("- модуль " + a.name + "\n") else if(!repo_mod_same(av, a, bv, b)) {
      if(a.name != b.name) shown = shown + ("~ модуль " + a.name + " → " + b.name + "\n");
      ai = repo_items(av, a.node);
      bi = repo_items(bv, b.node);
      changes = "";
      for(x : ai) {
        y = find_item(bi, x.id);
        place = a.name + "::" + x.key + " #" + x.id;
        if(!y.present) changes = changes + ("- " + place + "\n") else if(!repo_same(av, x, bv, y)) {
          if(x.key != y.key) changes = changes + ("~ переименование " + place + " → " + y.key + "\n") else changes = changes + ("~ " + place + "\n");
          changes = changes + ("  было:  " + x.text + "\n  стало: " + y.text + "\n" + (if(x.after != y.after) "  изменён порядок\n" else ""));
        }
      }
      for(y : bi) if(!find_item(ai, y.id).present) changes = changes + ("+ " + b.name + "::" + y.key + "\n  " + (y.text + "\n"));
      shown = shown + (if(changes != "") changes else "~ метаданные модуля " + b.name + "\n");
    }
  }
  if(from > 0) version_close(av);
  if(to > 0) version_close(bv);
  if(shown == "") "без различий\n" else shown
}
repo_dirty(i64 s) {
  if(repo_branch(s) == "") return false;
  h = repo_head(s);
  (h == 0) || (repo_diff(s, h, 0) != "без различий\n")
}
repo_resolve(i64 s, str key) {
  if((key == "") || (key == "HEAD")) return repo_head(s);
  found = 0;
  for(x : repo_rows(s)) {
    if((x[0] == "branch") && (x[4] == key)) return x[6];
    if((x[0] == "snapshot") && ((text(x[1]) == key) || (x[4] == key))) {
      if(found > 0) throw "неоднозначное имя снимка — используйте номер";
      found = x[1];
    }
  }
  if(found == 0) throw "нет снимка или ветки";
  found
}
repo_capture(i64 s, str name, i64 second) {
  id = repo_op(s, "capture", name, "", repo_head(s), second)[2];
  repo_op(s, "branch", repo_branch(s), "", id, 1);
  repo_op(s, "save", "", "", 0, 0);
  id
}
repo_ancestors(i64 s, i64 id) {
  found = array{id};
  k = 0;
  rows = repo_rows(s);
  while(k < found.size) {
    for(x : rows) if((x[0] == "snapshot") && (x[1] == found[k])) {
      for(p : array{x[2], x[6]}) if((p > 0) && !has_number(found, p)) found.push(p);
    }
    k += 1;
  }
  found
}
repo_base(i64 s, i64 a, i64 b) {
  aa = repo_ancestors(s, a);
  bb = repo_ancestors(s, b);
  best = array{};
  for(x : aa) if(has_number(bb, x)) {
    older = false;
    for(y : aa) if((x != y) && has_number(bb, y)) if(has_number(repo_ancestors(s, y), x)) older = true;
    if(!older) best.push(x);
  }
  if(best.size != 1) throw "слияние требует единственной общей базы";
  best[0]
}
struct repo_pick { str kind; i64 mod; i64 node; bool conflict; str name; }
repo_merge(i64 s, i64 theirs, str choice) {
  if(repo_dirty(s)) throw "сначала создайте снимок своих изменений";
  mine = repo_head(s);
  base = repo_base(s, mine, theirs);
  bv = repo_version(s, base);
  av = repo_version(s, mine);
  tv = repo_version(s, theirs);
  bm = repo_modules(s, base);
  am = repo_modules(s, mine);
  tm = repo_modules(s, theirs);
  picks = array{};
  conflicts = "";
  for(m : repo_union(repo_union(bm, am), tm)) {
    b = repo_mod_of(bm, m.node);
    a = repo_mod_of(am, m.node);
    t = repo_mod_of(tm, m.node);
    if(!repo_mod_same(av, a, tv, t) && !repo_mod_same(tv, t, bv, b)) {
      if(repo_mod_same(av, a, bv, b)) {
        clash = false;
        if(t.node >= 0) for(q : am) if((q.node != t.node) && (q.name == t.name)) clash = true;
        picks.push(repo_pick{"take-module", m.node, m.node, clash, m.name + (if(clash) " (имя модуля)" else "")});
      } else if((a.node < 0) || ((t.node < 0) || ((b.node < 0) || ((a.name != b.name) || (t.name != b.name))))) picks.push(repo_pick{"take-module", m.node, m.node, true, m.name}) else if(version_module_meta(av, a.node) != version_module_meta(tv, t.node)) picks.push(repo_pick{"take-module", m.node, m.node, true, m.name + " (выбор целого модуля)"}) else {
        ai = repo_items(av, a.node);
        bi = repo_items(bv, b.node);
        ti = repo_items(tv, t.node);
        ids = array{};
        for(xs : array{ai, bi, ti}) for(x : xs) if(!has_text(ids, x.id)) ids.push(x.id);
        for(id : ids) {
          x = find_item(ai, id);
          y = find_item(bi, id);
          z = find_item(ti, id);
          if(!repo_same(av, x, tv, z) && !repo_same(tv, z, bv, y)) picks.push(repo_pick{"take-item", m.node, number_of(id), !repo_same(av, x, bv, y), m.name + "::" + (if(x.present) x.key else z.key)});
        }
      }
    }
  }
  for(p : picks) if(p.conflict) conflicts = conflicts + ("конфликт: " + p.name + "\n");
  version_close(av);
  version_close(bv);
  version_close(tv);
  if((conflicts != "") && ((choice != "ours") && (choice != "theirs"))) return array{false, "нужен выбор конфликтов: ours / theirs", conflicts};
  try {
    for(p : picks) if(!p.conflict || (choice == "theirs")) repo_op(s, p.kind, text(p.mod), choice, theirs, p.node);
  } catch(e) {
    repo_op(s, "restore", "", "", mine, 0);
    throw e;
  }
  repo_capture(s, "Слияние " + text(theirs) + " → " + repo_branch(s), theirs);
  array{true, "слияние сохранено", conflicts}
}
repository_command(i64 s, str action, str key, str body) {
  try {
    repo_verify(s);
    if(action == "info") return array{true, "", ""};
    if(action == "init") {
      repo_op(s, "init", key, "", 0, 0);
      repo_capture(s, "Начало", 0);
    } else if(action == "module") repo_op(s, "module", key, body, 0, 0) else if(action == "snapshot") repo_capture(s, key, 0) else if(action == "diff") return array{true, "сравнение со снимком", repo_diff(s, repo_resolve(s, key), 0)}; else if(action == "restore") {
      id = repo_resolve(s, key);
      repo_op(s, "restore", "", "", id, 0);
      repo_capture(s, "Восстановление " + text(id), 0);
    } else if(action == "fork") {
      if(repo_dirty(s)) throw "сначала создайте снимок своих изменений";
      for(x : repo_rows(s)) if((x[0] == "branch") && (x[4] == key)) throw "ветка уже есть";
      repo_op(s, "branch", key, "", repo_head(s), 1);
    } else if(action == "checkout") {
      if(repo_dirty(s)) throw "есть несохранённые в снимке изменения";
      head = 0;
      for(x : repo_rows(s)) if((x[0] == "branch") && (x[4] == key)) head = x[6];
      if(head == 0) throw "нет ветки";
      repo_op(s, "restore", "", "", head, 0);
      repo_op(s, "branch", key, "", head, 1);
    } else if(action == "merge") return repo_merge(s, repo_resolve(s, key), body); else if(action == "pull") {
      // key - other .vishrepo, body - source name (empty - by file name)
      if(!ends_with(key, ".vishrepo")) throw "путь должен оканчиваться на .vishrepo";
      try {
        r = repo_pull_session(s, key, if(body != "") body else repo_source_name(key));
        return array{true, r, ""};
      } catch(e) {
        if(!starts_with(text(e), "журналы разошлись")) throw e;
      }
      o = repo_side_open(key); // Split - merge into modules (merge_foreign)
      if(o < 0) throw version_error();
      try {
        m = merge_foreign(s, o);
        repo_side_close(o);
        return array{true, m[1], m[2]};
      } catch(e) {
        repo_side_close(o);
        throw e;
      }
    } else if(action == "push") {
      // give another repository: pull in his session from my (saved) file
      if(!ends_with(key, ".vishrepo")) throw "путь должен оканчиваться на .vishrepo";
      repo_op(s, "save", "", "", 0, 0);
      mine = repo_direct(s, "state", "", "", 0, 0)[1];
      o = repo_side_open(key);
      if(o < 0) throw version_error();
      try {
        r = repo_pull_session(o, mine, if(body != "") body else repo_source_name(mine));
        repo_side_close(o);
        return array{true, r, ""};
      } catch(e) {
        if(!starts_with(text(e), "журналы разошлись")) {
          repo_side_close(o);
          throw e;
        }
        try {
          // Merge into modules in another repository (its live program is the receiver, my head is the source)
          m = merge_foreign(o, s);
          repo_side_close(o);
          return array{true, "в другом репозитории: " + m[1], m[2]};
        } catch(e2) {
          repo_side_close(o);
          throw e2;
        }
      }
    } else if(action != "save") throw "неизвестная команда репозитория";
    repo_op(s, "save", "", "", 0, 0);
    array{true, "сохранено", ""}
  } catch(e) {
    array{false, text(e), ""}
  }
}
// Verification of the repository model is written in the language; the binary downloader
// only checks the suitability of journal for safe playback and the node boundary.
repo_verify(i64 s) {
  info = repo_direct(s, "state", "", "", 0, 0);
  if(info[1] == "") return true;
  repo_direct(s, "live", "", "", 0, 0);
  root = version_root(0);
  repo_check_catalog(repo_native_modules(s, 0), root);
  ids = array{0};
  names = array{};
  ends = array{0};
  last = 0;
  next = 0;
  active = "";
  for(x : info[3]) {
    if(x[0] == "current") {
      next = x[1];
      active = x[4];
    }
    if(x[0] == "snapshot") {
      if((x[1] != (last + 1)) || ((x[1] > 4096) || ((x[4].size == 0) || (x[4].size > 512)))) throw "повреждена история снимков";
      if(!has_number(ids, x[2]) || !has_number(ids, x[6])) throw "повреждены родители снимка";
      pos = parse_int(x[5]);
      // the border is not less than the boundaries of the parents (the pictures received from another copy are not in the order of the boundaries);
      if(!pos.ok || ((pos.value == 0) || ((pos.value < ends[x[2]]) || (pos.value < ends[x[6]])))) throw "повреждена граница снимка";
      ends.push(pos.value);
      last = x[1];
      ids.push(last);
      repo_check_catalog(repo_native_modules(s, last), root);
    }
  }
  if(next != (last + 1)) throw "повреждён счётчик снимков";
  for(x : info[3]) if(x[0] == "branch") {
    if((x[4].size == 0) || ((x[4].size > 128) || (has_text(names, x[4]) || !has_number(ids, x[6])))) throw "повреждён список веток";
    names.push(x[4]);
  }
  if(!has_text(names, active)) throw "повреждена текущая ветка";
  true
}
repository_verify_cli(args) {
  try {
    repo_verify(number_of(args[0]));
    0
  } catch(e) {
    fail(text(e))
  }
}
// Merging someone else's repository, journal of which diverged (vish repo pull, 2026-11-10; *my*): their head is version o, my live
// program is version 0, the common base is the common prefix journal (version_base). Module with the same node and name in both
// copies merges into elements like merge_versions (changed only from them is taken by itself, both have different conflict, my
// variant remains); the module only for them is created from the texts of their elements; the same name, created independently in
// both, is a conflict. Removal of the module is not carried over (no database directory). The result is a picture of "Merge..."
repo_module_text(items) {
  r = "";
  for(x : items) {
    for(k : range(x.blank)) r = r + "\n";
    for(l : x.lead) r = r + l + "\n";
    r = r + x.text + (if(starts_with(x.text, "use ") && !ends_with(x.text, ";")) ";\n" else "\n");
    if(x.tail != "") r = r + x.tail + "\n";
  }
  r
}
merge_foreign(i64 s, i64 o) {
  // host version 0 has one for all sessions (repo_op of any session switches it): everything about their repository - up to the live mine
  repo_verify(o);
  head = repo_head(o);
  tv = repo_version(o, head);
  tm = repo_native_modules(o, head);
  their_branch = repo_branch(o);
  repo_verify(s);
  if(repo_dirty(s)) throw "сначала создайте снимок своих изменений";
  repo_direct(s, "live", "", "", 0, 0);
  bv = version_base(0, tv);
  am = repo_native_modules(s, 0);
  taken = array{};
  added = array{};
  conflicts = "";
  for(t : tm) {
    same = repo_mod_of(am, t.node);
    clash = false; // the same name, but the modules are different (created independently: the node number may coincide - journal diverged)
    for(q : am) if((q.name == t.name) && (q.node != t.node)) clash = true;
    if(clash) conflicts = conflicts + ("конфликт: модуль " + t.name + " создан в обеих копиях\n") else if((same.node >= 0) && (same.name == t.name)) {
      base_items = array{};
      for(x : version_items(bv, t.node)) base_items.push(x[0]);
      b = module_items(bv, t.node, base_items);
      m = module_items(0, t.node, base_items);
      th = module_items(tv, t.node, base_items);
      ids = array{};
      for(xs : array{b, m, th}) for(x : xs) if(!has_text(ids, x.id)) ids.push(x.id);
      for(id : ids) {
        bi = find_item(b, id);
        mi = find_item(m, id);
        ti = find_item(th, id);
        if(!same_state(mi, ti) && !same_state(ti, bi)) {
          label = t.name + "::" + (if(mi.present) mi.key else if(ti.present) ti.key else bi.key);
          if(same_state(mi, bi)) {
            take_theirs(0, t.node, base_items, id, ti);
            taken.push(label);
          } else conflicts = conflicts + ("конфликт: " + label + " — оставлен мой вариант\n");
        }
      }
    } else {
      repo_op(s, "module", t.name, repo_module_text(module_items(tv, t.node, array{})), 0, 0);
      added.push(t.name);
    }
  }
  // The module that the common ancestor knew, and they don't have it, is removed from them: it's removed if I haven't changed, otherwise the conflict
  removed = array{};
  base_mods = version_modules(bv);
  for(m : am) if((repo_mod_of(tm, m.node).node < 0) && (m.node != version_root(0))) {
    known = false;
    for(x : base_mods) if(x[0] == m.node) known = true;
    if(known) {
      base_items = array{};
      for(x : version_items(bv, m.node)) base_items.push(x[0]);
      b = module_items(bv, m.node, base_items);
      mine_items = module_items(0, m.node, base_items);
      changed = b.size != mine_items.size;
      for(x : mine_items) if(!same_state(x, find_item(b, x.id))) changed = true;
      if(changed) conflicts = conflicts + ("конфликт: модуль " + m.name + " удалён у них, но изменён у вас — оставлен мой вариант\n") else {
        next = array{};
        for(q : repo_native_modules(s, 0)) if(q.node != m.node) next.push(q);
        repository_clear(s, m.node);
        repository_catalog(s, repo_catalog_data(next));
        removed.push(m.name);
      }
    }
  }
  version_close(tv);
  version_close(bv);
  if((taken.size == 0) && ((added.size == 0) && (removed.size == 0))) return array{true, "у них нечего взять", conflicts};
  repo_capture(s, "Слияние: " + their_branch + " → " + repo_branch(s), 0);
  said = "слияние сохранено: взято элементов " + text(taken.size);
  for(k : taken) said = said + "\n  " + k;
  for(k : added) said = said + "\n  новый модуль " + k;
  for(k : removed) said = said + "\n  модуль удалён у них: " + k;
  array{true, said, conflicts}
}
repository_merge_cli(args) {
  try {
    r = merge_foreign(number_of(args[0]), number_of(args[1]));
    write_out(r[1] + "\n");
    write_out(r[2]);
    if(r[2] == "") 0 else 1
  } catch(e) {
    fail(text(e))
  }
}
// Exchange between independent repositories (2026-11-10, author's decision: import with renaming, fast-forward only;
// transferred from C++ to 2026-11-10 -). journal is a single growing, operations are recorded sequentially from copies that
// have diverged from a common ancestor, the common prefix journal . pull in s takes y o (alien session, repo_side_open ): the
// tail of journal (if journal s is the prefix journal o; compares and adds host , repository_graft ) and pictures - with new
// local numbers (the same content - border, name, parents, modules - the same), branches o - as a name / branch, move only
// forward. journal diverged - rejection with numbers. The live program s is then the end of someone else's journal: it is
// returned by repo_settle.
//
repo_snapshot_modules(i64 s, i64 id) => repo_catalog_data(repo_native_modules(s, id));
repo_same_modules(xs, ys) {
  if(xs.size != ys.size) return false;
  for(k : range(xs.size)) if((xs[k][0] != ys[k][0]) || (xs[k][1] != ys[k][1])) return false;
  true
}
repo_import_state(i64 s, i64 o, str name) {
  if((name.size == 0) || ((name.size > 100) || (find_text(name, "/") >= 0))) throw "имя источника: непусто, без «/», до 100 байт";
  g = repository_graft(s, o);
  if(!g[0]) throw "журналы разошлись: общее начало " + text(g[1]) + " операций (у вас " + text(g[2]) + ", у них " + text(g[3]) + ") — слейте копии через vish merge";
  renamed_from = array{0};
  renamed_to = array{0};
  added = 0;
  theirs = repo_direct(o, "state", "", "", 0, 0)[3];
  for(x : theirs) if(x[0] == "snapshot") {
    p = 0;
    q = 0;
    for(k : range(renamed_from.size)) {
      if(renamed_from[k] == x[2]) p = renamed_to[k];
      if(renamed_from[k] == x[6]) q = renamed_to[k];
    }
    end = parse_int(x[5]).value;
    mods = repo_snapshot_modules(o, x[1]);
    found = 0;
    mine = repo_direct(s, "state", "", "", 0, 0)[3];
    for(y : mine) if((found == 0) && (y[0] == "snapshot")) {
      if((parse_int(y[5]).value == end) && ((y[4] == x[4]) && ((y[2] == p) && ((y[6] == q) && repo_same_modules(repo_snapshot_modules(s, y[1]), mods))))) found = y[1];
    }
    if(found != 0) {
      renamed_from.push(x[1]);
      renamed_to.push(found);
    } else {
      next = 0;
      for(y : mine) if(y[0] == "current") next = y[1];
      repository_snapshot_add(s, next, x[4], p, q, end, mods);
      renamed_from.push(x[1]);
      renamed_to.push(next);
      added += 1;
    }
  }
  kept = "";
  nbranches = 0;
  for(x : theirs) if(x[0] == "branch") {
    nbranches += 1;
    tracked = name + "/" + x[4];
    head = 0;
    for(k : range(renamed_from.size)) if(renamed_from[k] == x[6]) head = renamed_to[k];
    mine = repo_direct(s, "state", "", "", 0, 0)[3];
    has = false;
    old = 0;
    for(y : mine) if((y[0] == "branch") && (y[4] == tracked)) {
      has = true;
      old = y[6];
    }
    // forward
    if(!has) repo_direct(s, "branch", tracked, "", head, 0) else if(repo_reaches(mine, head, old)) repo_direct(s, "branch", tracked, "", head, 0) else if(!repo_reaches(mine, old, head)) kept = kept + " " + tracked; // On the branch of our pictures - do not move
  }
  said = "получено: операций журнала " + text(g[4]) + ", снимков " + text(added) + ", веток " + text(nbranches) + " (имена " + name + "/…)";
  if(kept != "") said = said + "; не сдвинуты (на них свои снимки):" + kept;
  said
}
// ancestor of the old head picture (by parents, including the picture itself)
repo_reaches(rows, i64 old, i64 head) {
  found = array{head};
  k = 0;
  while(k < found.size) {
    if(found[k] == old) return true;
    for(x : rows) if((x[0] == "snapshot") && (x[1] == found[k])) for(p : array{x[2], x[6]}) if((p > 0) && !has_number(found, p)) found.push(p);
    k += 1;
  }
  false
}
// pull to the open repository of the session s: the file is a living base (save), the tail of journal and the source pictures
// are in the living base and state (without saving: the live program became the end of someone else's journal - it is first
// returned by repo_settle); journal diverged - "error: journal diverged..." (hereinafter merge_foreign ). journal live session
// also carries built-in modules (editor, tools), so with someone else's copy it often "parted".
repo_import_live(i64 s, str from, str name) {
  try {
    repo_op(s, "save", "", "", 0, 0);
    o = repo_side_open(from);
    if(o < 0) return "ошибка: " + version_error();
    try {
      r = repo_import_state(s, o, name);
      repo_side_close(o);
      r
    } catch(e) {
      repo_side_close(o);
      throw e;
    }
  } catch(e) {
    "ошибка: " + text(e)
  }
}
// Compare journal sessions s and o: the common prefix is to add tail o to s (playback); array {ок, общее начало, длина s,
// длина o, дописано}. The only thing host does for pull is byte recording comparison and replay.
repository_graft(i64 s, i64 o) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(array_v::of({})));
  auto & mine = repository_session(vm, a[0].as<int64_t>());
  auto & theirs = repository_session(vm, a[1].as<int64_t>());
  auto local = mine.db.journal(), other = theirs.db.journal();
  auto bytes = [](journal_entry const & e) { writer w; w.put(e); return w.bytes; };
  std::size_t shared = 0;
  while(shared < local.size() && shared < other.size() && bytes(local[shared]) == bytes(other[shared])) ++shared;
  auto ints = [&](bool ok, std::size_t tail) { return value(array_v::of({value(ok), value(int64_t(shared)), value(int64_t(local.size())), value(int64_t(other.size())), value(int64_t(tail))})); };
  if(shared < local.size() && shared < other.size()) return ints(false, 0);
  std::vector<journal_entry> tail(other.begin() + std::ptrdiff_t(shared), other.end());
  mine.db.replay(tail);
  return ints(true, tail.size());
};
// a snapshot of the repository with a given boundary journal and a catalog of modules (an alien snapshot when pull); modules - [node, name]
repository_snapshot_add(i64 s, i64 id, str name, i64 parent, i64 second, i64 end, modules) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  std::vector<uint32_t> parents;
  for(auto k: {3, 4}) if(a[k].as<int64_t>()) parents.push_back(uint32_t(a[k].as<int64_t>()));
  std::vector<repository_module> mods;
  auto const & xs = a[6].as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    auto item = xs.get(k); auto const & row = item.as<array_v>();
    mods.push_back({node_id(uint32_t(row.get(0).as<int64_t>())), std::string(row.get(1).as<str_v>().view())});
  }
  auto & r = *host.repository;
  r.snapshots.push_back({uint32_t(a[1].as<int64_t>()), std::move(parents), std::string(a[2].as<str_v>().view()), std::move(mods), uint64_t(a[5].as<int64_t>())});
  r.next_id = uint32_t(a[1].as<int64_t>()) + 1;
  ++r.generation;
  return value(int64_t(0));
};
// • someone else's repository - session at the time of the merger; -1 - not opened (version_error - why)
repo_side_open(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  try {
    return value(tools_host->open_side(std::string((a[0]).as<str_v>().view())));
  } catch(diagnostic const & d) {
    tools_host->error = d.what();
    return value(int64_t(-1));
  }
};
repo_side_close(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  tools_host->close_side((a[0]).as<int64_t>());
  return value(int64_t(0));
};
// After pull/push journal receiver is longer than someone else's tail, and the live program is the end of journal: return it
// to your head (branch shot), other people's pictures remain available (branch name / ...). The receiver has to be without
// unsaved changes - this operation would lose them. Mine. *
repo_settle(i64 s) {
  head = repo_direct(s, "state", "", "", 0, 0)[2]; // without repo_normalize: the live program is not currently aligned with the directory
  repo_op(s, "restore", "", "", head, 0);
  repo_op(s, "save", "", "", 0, 0);
  0
}
repo_journal_changed(str message) => find_text(message, "операций журнала 0,") < 0;
// pull to session s (receiver) from file from under name: message; journal split or other error - exception
repo_pull_session(i64 s, str from, str name) {
  repo_verify(s);
  if(repo_dirty(s)) throw "в приёмнике есть изменения вне снимка — сначала создайте снимок";
  r = repo_import_live(s, from, name);
  if(starts_with(r, "ошибка: ")) throw text_from(r, "ошибка: ".size);
  if(repo_journal_changed(r)) repo_settle(s) else repo_op(s, "save", "", "", 0, 0);
  r
}
// Source name along the way: file without directory and ".vishrepo"
repo_source_name(str path) {
  k = path.size;
  while((k > 0) && (path[k - 1] != '/')) k -= 1;
  n = text_from(path, k);
  if(ends_with(n, ".vishrepo")) text_range(n, 0, n.size - ".vishrepo".size) else n
}
// vish repo pull|push <my.vishrepo> <other.vishrepo> [name]: pull - take from another, push - give to another. The receiver
// opens with a session (cli.vish), args: action, receiver session number, source path, name ("" - by file name"). Code 3 -
// journal diverged (pull: cli.vish merges into modules).
repository_exchange_cli(args) {
  try {
    r = repo_pull_session(number_of(args[1]), args[2], if(args[3] != "") args[3] else repo_source_name(args[2]));
    write_out(r + "\n");
    0
  } catch(e) {
    said = text(e);
    if(starts_with(said, "журналы разошлись")) {
      write_out(said + "\nслияние по модулям…\n");
      return 3;
    }
    fail(said)
  }
}
// Text export (vish repo export, 2026-11-10): the live program and each snapshot are the usual .vish files read by any build
// <catalog> /main.vish - live program (+ use for modules that are not in it), geo.vec → geo/vec.vish; snapshots / <number>/ - the
// same for each shot; history.txt - pictures (snapshot number parent second-parent name), branches (branch name picture) and
// current (current name). Determined. Reverse: vish repo import <catalogue> <new. vishrepo> (images, parents, branches, live
// program) or vish repo init <catalogue> /main.vish (live program only).
//
//
repo_dump(i64 v, mods, i64 root, str dir) {
  main = repo_module_text(module_items(v, root, array{}));
  uses = "";
  for(m : mods) if(m.node != root) if(find_text(main, "use " + m.name) < 0) uses = uses + "use " + m.name + ";\n";
  why = write_text(dir + "/main.vish", uses + main);
  if(why != "") throw why;
  count = 1;
  for(m : mods) if(m.node != root) {
    path = dir + "/";
    for(k : range(m.name.size)) path = path + (if(m.name[k] == '.') "/" else slice_text(m.name, k, k + 1));
    why = write_text(path + ".vish", version_module_attrs(v, m.node) + "module " + m.name + ";\n" + repo_module_text(module_items(v, m.node, array{})));
    if(why != "") throw why;
    count = count + 1;
  }
  count
}
repo_export(i64 s, str dir) {
  repo_verify(s);
  hist = "";
  count = 0;
  for(x : repo_rows(s)) if(x[0] == "snapshot") {
    v = repo_version(s, x[1]);
    count = count + repo_dump(v, repo_native_modules(s, x[1]), version_root(v), dir + "/snapshots/" + text(x[1]));
    version_close(v);
    hist = hist + "snapshot " + text(x[1]) + " " + text(x[2]) + " " + text(x[6]) + (" " + x[4] + "\n");
  }
  for(x : repo_rows(s)) if(x[0] == "branch") hist = hist + "branch " + x[4] + " " + text(x[6]) + "\n";
  hist = hist + "current " + repo_branch(s) + "\n";
  repo_direct(s, "live", "", "", 0, 0); // Live - last: version 0 one for all
  count = count + repo_dump(0, repo_native_modules(s, 0), version_root(0), dir);
  why = write_text(dir + "/history.txt", hist);
  if(why != "") throw why;
  count
}
repository_export_cli(args) {
  try {
    n = repo_export(number_of(args[0]), args[1]);
    write_out("экспорт: файлов .vish " + text(n) + " в " + args[1] + "\n");
    0
  } catch(e) {
    fail(text(e))
  }
}
// Bring a live program to the text of the tv version (disassembled from the catalog): missing modules are created, module
// elements and programs are replaced / added / removed by keys, unnecessary modules are left. *Mine* is the merge mechanics.
repo_sync_items(i64 lnode, i64 tv, i64 tnode) {
  li = module_items(0, lnode, array{});
  ti = module_items(tv, tnode, array{});
  ids = array{};
  for(xs : array{li, ti}) for(x : xs) if(!has_text(ids, x.id)) ids.push(x.id);
  for(id : ids) {
    a = find_item(li, id);
    b = find_item(ti, id);
    if(!same_state(a, b)) take_theirs(0, lnode, array{}, id, b);
  }
  0
}
repo_sync_text(i64 s, i64 tv) {
  troot = version_root(tv);
  tmods = array{};
  for(x : version_modules(tv)) if((x[1] != "") && !repo_builtin(x[1])) tmods.push(repo_mod{x[0], x[1]});
  repo_direct(s, "live", "", "", 0, 0);
  for(t : tmods) {
    have = false;
    for(m : repo_native_modules(s, 0)) if(m.name == t.name) have = true;
    if(!have) repo_op(s, "module", t.name, repo_module_text(module_items(tv, t.node, array{})), 0, 0);
  }
  repo_direct(s, "live", "", "", 0, 0);
  live = repo_native_modules(s, 0);
  repo_sync_items(version_root(0), tv, troot);
  for(t : tmods) for(m : live) if(m.name == t.name) repo_sync_items(m.node, tv, t.node);
  keep = array{};
  gone = false;
  for(m : live) {
    wanted = m.node == version_root(0);
    for(t : tmods) if(t.name == m.name) wanted = true;
    if(wanted) keep.push(m) else {
      repository_clear(s, m.node);
      gone = true;
    }
  }
  if(gone) repository_catalog(s, repo_catalog_data(keep));
  0
}
// Import the export catalog to the newly created repository s (session program - the first picture, path - the repository file).
repo_import_text(i64 s, str path, str dir) {
  lines = lines_of(read_text(dir + "/history.txt"));
  olds = array{};
  news = array{};
  names = array{};
  parents = array{};
  seconds = array{};
  for(l : lines) if(starts_with(l, "snapshot ")) {
    w = words_of(l);
    olds.push(number_of(w[1]));
    parents.push(number_of(w[2]));
    seconds.push(number_of(w[3]));
    name = "";
    for(k : range(w.size)) if(k >= 4) name = if(k == 4) w[k] else name + " " + w[k];
    names.push(name);
  }
  if(olds.size == 0) throw "в каталоге нет снимков (history.txt)";
  repo_op(s, "init", path, "", 0, 0);
  news.push(repo_capture(s, names[0], 0));
  for(k : range(olds.size)) if(k > 0) {
    tv = version_from_text(dir + "/snapshots/" + text(olds[k]) + "/main.vish");
    if(tv < 0) throw version_error();
    repo_sync_text(s, tv);
    version_close(tv);
    p = 0;
    q = 0;
    for(j : range(olds.size)) if(j < news.size) {
      if(olds[j] == parents[k]) p = news[j];
      if(olds[j] == seconds[k]) q = news[j];
    }
    id = repo_op(s, "capture", names[k], "", p, q)[2];
    news.push(id);
    repo_op(s, "branch", "main", "", id, 1);
  }
  current = "main";
  for(l : lines) {
    w = words_of(l);
    if((w.size >= 3) && (w[0] == "branch")) {
      head = 0;
      for(j : range(olds.size)) if(olds[j] == number_of(w[2])) head = news[j];
      repo_op(s, "branch", w[1], "", head, 1);
    }
    if((w.size >= 2) && (w[0] == "current")) current = w[1];
  }
  for(x : repo_rows(s)) if((x[0] == "branch") && (x[4] == current)) repo_op(s, "branch", current, "", x[6], 1);
  tv = version_from_text(dir + "/main.vish"); // live program - as it was during export (including unsaved edits)
  if(tv < 0) throw version_error();
  repo_sync_text(s, tv);
  version_close(tv);
  repo_op(s, "save", "", "", 0, 0);
  olds.size
}
repository_import_cli(args) {
  try {
    n = repo_import_text(number_of(args[0]), args[1], args[2]);
    write_out("импорт: снимков " + text(n) + " в " + args[1] + "\n");
    0
  } catch(e) {
    fail(text(e))
  }
}
// Self-hosting (vish lib import|export, 2026-11-10, *mine* by user decision "the sources of vish itself in the repository
// and in the editor"): lib/*.vish are vish modules that are also built into the build (the names tools, versions, ... are taken
// by the built-in copies), so in the repository they live under the keys src.<name>: on import "module X;" -> "module src.X;",
// "use X" -> "use src.X", on export the reverse. The text of lib/ after export is the canonical projection of the database (the source
// of truth is the AST, the text is a projection; the author, 2022-09-21: "a normal editor should edit the AST, not the text").
lib_names() => array{"prelude", "tools", "versions", "tests", "cli", "editor", "lexer", "parser", "printer", "runlog", "modules", "views", "complete", "session", "proto", "server"};
lib_rename(str line, bool into) {
  from = if(into) "" else "src.";
  to = if(into) "src." else "";
  for(n : lib_names()) {
    mod = "module " + from + n + ";";
    at = find_text(line, mod);
    if((at >= 0) && (starts_with(line, "module ") || starts_with(line, "[["))) return slice_text(line, 0, at) + "module " + to + n + ";" + text_from(line, at + mod.size);
    use = "use " + from + n;
    if(starts_with(line, use) && ((line.size == use.size) || has_text(array{";", ".", " "}, slice_text(line, use.size, use.size + 1)))) return "use " + to + n + text_from(line, use.size);
  }
  line
}
lib_text(str source, bool into) {
  r = "";
  for(l : lines_of(source)) r = r + lib_rename(l, into) + "\n";
  r
}
lib_prepare(str libdir, str work) {
  why = remove_path(work);
  if(why != "") throw why;
  main = "";
  for(n : lib_names()) if(n != "prelude") {
    // prelude is the basis of the language: as a module it is not checked (its names are in the prelude base), it is added after
    why = write_text(work + "/src/" + n + ".vish", lib_text(read_text(libdir + "/" + n + ".vish"), true));
    if(why != "") throw why;
    main = main + "use src." + n + ";\n";
  }
  tasks = "// Задачи проекта (Ctrl+Shift+B — check; c_task): lib/ и сборка — из этого репозитория (tools/selfhost.sh).\n";
  tasks = tasks + "[[editor]] task_check(code root) => array{\"tools/selfhost.sh\", \"build\"};\n";
  tasks = tasks + "[[editor]] task_test(code root) => array{\"out/vish\", \"test\", \"tests\"};\n";
  why = write_text(work + "/main.vish", main + tasks + "main() {}\n");
  if(why != "") throw why;
  work + "/main.vish"
}
// prelude lib/ - Module src.prelude in the ready repository (no use: not elaborated), then save
lib_add_prelude_cli(args) {
  try {
    s = number_of(args[0]);
    body = lib_text(read_text(args[1] + "/prelude.vish"), true);
    head = "module src.prelude;\n";
    if(!starts_with(body, head)) throw "в prelude.vish нет «module prelude;» первой строкой";
    repo_op(s, "module", "src.prelude", text_from(body, head.size), 0, 0);
    repo_op(s, "save", "", "", 0, 0);
    0
  } catch(e) {
    fail(text(e))
  }
}
lib_prepare_cli(args) {
  if(args.size > 2) {
    remove_path(args[1]);
    return 0;
  } // Third word: Remove the working directory
  try {
    write_out(lib_prepare(args[0], args[1]) + "\n");
    0
  } catch(e) {
    fail(text(e))
  }
}
lib_export_cli(args) {
  try {
    work = args[1] + ".work";
    repo_export(number_of(args[0]), work);
    for(n : lib_names()) {
      why = write_text(args[1] + "/" + n + ".vish", lib_text(read_text(work + "/src/" + n + ".vish"), false));
      if(why != "") throw why;
    }
    why = remove_path(work);
    if(why != "") throw why;
    write_out("экспорт lib: " + args[1] + "\n");
    0
  } catch(e) {
    fail(text(e))
  }
}
repository_cli(args) {
  s = number_of(args[0]);
  r = repository_command(s, args[1], args[2], args[3]);
  if(!r[0]) {
    write_err(r[1] + "\n" + r[2]);
    return 1;
  }
  if(r[2] != "") write_out(r[2]);
  if(args[1] == "info") {
    write_out("ветка: " + repo_branch(s) + " · снимок " + text(repo_head(s)) + (if(repo_dirty(s)) " · есть изменения\n" else " · без изменений\n"));
    for(x : repo_rows(s)) if(x[0] != "current") write_out(x[0] + " " + text(x[1]) + " " + x[4] + " #" + text(if(x[0] == "module") x[3] else x[6]) + "\n");
  } else if(r[1] != "") write_out(r[1] + "\n");
  0
}
