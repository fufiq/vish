rx_f() => 1;
rx_g() => 2;
rx_payload(pv_k, pv_n) {
  if(pv_k == 0) return pv_n;
  if(pv_k == 1) return text(pv_n);
  if(pv_k == 2) return array{pv_n};
  if(pv_k == 3) return array{text(pv_n)};
  if(pv_k == 4) return array{array{pv_n}};
  if(pv_k == 5) return array{array{text(pv_n)}};
  if(pv_k == 6) return rx_box{array{pv_n}};
  if(pv_k == 7) return rx_box{array{text(pv_n)}};
  if(pv_k == 8) return f64(pv_n);
  if(pv_k == 9) return pv_n == 1;
  if(pv_k == 10) return text(pv_n == 1);
  if(pv_k == 11) return array{};
  if(pv_k == 12) return "";
  if(pv_k == 13) return array{"a, b"};
  if(pv_k == 14) return array{"a","b"};
  if(pv_k == 15) return array{pv_n,"a"};
  if(pv_k == 16) return array{text(pv_n),"a"};
  if(pv_k == 17) return array{pv_n,text(pv_n)};
  if(pv_k == 18) return array{text(pv_n),pv_n};
  if(pv_k == 19) return array{f64(pv_n)};
  if(pv_k == 20) return array{pv_n == 1};
  if(pv_k == 21) return array{text(pv_n == 1)};
  if(pv_k == 22) return if(pv_n == 0) 0.0 else -0.0;
  if(pv_k == 23) return array{array{if(pv_n == 0) 0.0 else -0.0}};
  if(pv_k == 24) return rx_box{array{if(pv_n == 0) 0.0 else -0.0}};
  if(pv_k == 25) return if(pv_n == 0) code(rx_f) else code(rx_g);
  if(pv_k == 26) return if(pv_n == 0) ref(rx_f) else ref(rx_g);
  if(pv_k == 27) return if(pv_n == 0) (x) => x else (x) => x + 1;
  if(pv_k == 28) return if(pv_n == 0) i64 else str;
  return 0.0 / 0.0;
}
rx_spec(mut sp_seed, sp_n, sp_specs) {
  sp_k = rx_rand(sp_seed) % 11; sp_a = rx_rand(sp_seed) % sp_n; sp_b = rx_rand(sp_seed) % sp_n;
  // a "catch with a report" (kind 9) reads the "thrower" query (kind 7) where possible: so a change of the exception structure is visible to the consumer
  if(sp_k == 9) {
    sp_c = array{}; for(sp_i : range(sp_specs.size)) if((sp_i + 5) < sp_n) if(sp_specs[sp_i][0] == 7) sp_c.push(sp_i + 5);
    if(sp_c.size > 0) sp_a = sp_c[sp_b % sp_c.size];
  }
  return array{sp_k,sp_a,sp_b,sp_n};
}
rx_naive(rn_specs, rn_inputs, rn_opts, rn_i, mut rn_count) {
  if(rn_i < rn_inputs.size) return rn_inputs[rn_i];
  rn_count = rn_count + 1; rn_s = rn_specs[rn_i - rn_inputs.size];
  if(rn_s[0] == 5) {
    try { return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count); } catch(rn_e) { return "0"; }
  }
  if(rn_s[0] == 8) {
    try { return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count); } catch(str rn_e) { return "2"; } catch(rn_e) { return "3"; }
  }
  if(rn_s[0] == 9) {
    try { return rx_norm(rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count)); } catch(rn_e) { return text(rx_hash(rx_ser(rn_e)) % 1000); }
  }
  rn_a = rx_norm(rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count));
  if(rn_s[0] == 10) return array{text(parse_int(rn_a).value % 3),text(parse_int(rn_a).value % 2)};
  if(rn_s[0] == 7) {
    rn_x = parse_int(rn_a).value;
    if((rn_x % 4) == 1) return rn_a;
    throw rx_payload((rn_x / 2) % 30,rn_x % 2);
  }
  if(rn_s[0] == 6) {
    rn_j = parse_int(rn_a).value % 3;
    if((rn_j >= 0) && (rn_j < 3)) if(rn_opts[rn_j] != "") return rn_opts[rn_j];
    return "0";
  }
  if(rn_s[0] == 3) {
    if((parse_int(rn_a).value % 2) == 0) return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[2],rn_count);
    return rn_a;
  }
  if(rn_s[0] == 4) {
    rn_x = parse_int(rn_a).value;
    if((rn_x % 5) == 0) throw "boom" + text(rn_s[3]);
    return text((rn_x + 1) % 1000);
  }
  rn_b = rx_norm(rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[2],rn_count));
  if(rn_s[0] == 2) return rn_a + rn_b;
  rn_x = parse_int(rn_a).value; rn_y = parse_int(rn_b).value;
  if(rn_s[0] == 1) return text(if(rn_x < rn_y) rn_x else rn_y);
  return text((rn_x + rn_y) % 1000);
}
rx_formula(mut fm_db, fm_s) {
  if(fm_s[0] == 5) {
    try { return get(fm_db,text(fm_s[1])); } catch(fm_e) { return "0"; }
  }
  if(fm_s[0] == 8) {
    try { return get(fm_db,text(fm_s[1])); } catch(str fm_e) { return "2"; } catch(fm_e) { return "3"; }
  }
  if(fm_s[0] == 9) {
    try { return rx_norm(get(fm_db,text(fm_s[1]))); } catch(fm_e) { return text(rx_hash(rx_ser(fm_e)) % 1000); }
  }
  fm_a = rx_norm(get(fm_db,text(fm_s[1])));
  if(fm_s[0] == 10) return array{text(parse_int(fm_a).value % 3),text(parse_int(fm_a).value % 2)};
  if(fm_s[0] == 7) {
    fm_x = parse_int(fm_a).value;
    if((fm_x % 4) == 1) return fm_a;
    throw rx_payload((fm_x / 2) % 30,fm_x % 2);
  }
  if(fm_s[0] == 6) {
    fm_j = parse_int(fm_a).value % 3;
    try { return get(fm_db,"opt" + text(fm_j)); } catch(fm_e) { return "0"; }
  }
  if(fm_s[0] == 3) {
    if((parse_int(fm_a).value % 2) == 0) return get(fm_db,text(fm_s[2]));
    return fm_a;
  }
  if(fm_s[0] == 4) {
    fm_x = parse_int(fm_a).value;
    if((fm_x % 5) == 0) throw "boom" + text(fm_s[3]);
    return text((fm_x + 1) % 1000);
  }
  fm_b = rx_norm(get(fm_db,text(fm_s[2])));
  if(fm_s[0] == 2) return fm_a + fm_b;
  fm_x = parse_int(fm_a).value; fm_y = parse_int(fm_b).value;
  if(fm_s[0] == 1) return text(if(fm_x < fm_y) fm_x else fm_y);
  return text((fm_x + fm_y) % 1000);
}
// df_ex are INDEPENDENT counters (the oracle compares them with stats()): df_ex[0] - query function executions (== stats[0]),
// df_ex[1] - the expected cutoffs: the execution result (a value or an exception, the structural record rx_ser) matched
// the previous result of the same key (== stats[2]; the previous result survives a redefinition). df_last[key-5] is the previous result.
rx_define(mut df_db, df_key, df_spec, df_ex, df_last) {
  df_copy = array{df_spec[0],df_spec[1],df_spec[2],df_spec[3]}; df_slot = parse_int(df_key).value - 5;
  query_define(df_db,df_key,(mut df_inner) => {
    df_ex[0] = df_ex[0] + 1; df_fail = false; df_exc = 0; df_val = 0; df_res = "";
    try { df_val = rx_formula(df_inner,df_copy); df_res = "V" + rx_ser(df_val); } catch(df_e) { df_fail = true; df_exc = df_e; df_res = "E" + rx_ser(df_e); }
    if((df_last[df_slot] == df_res) && rx_cuttable(if(df_fail) df_exc else df_val)) df_ex[1] = df_ex[1] + 1;
    df_last[df_slot] = df_res;
    if(df_fail) throw df_exc;
    return df_val;
  });
}
// An exception in the oracle's output - structurally: the type and the content at each level.
rx_exc_text(xt_e) => rx_ser(xt_e);
rx_out_naive(rn_specs, rn_inputs, rn_opts, rn_i, mut rn_count) {
  try { return "V" + rx_vtext(rx_naive(rn_specs,rn_inputs,rn_opts,rn_i,rn_count)); } catch(rn_e) { return "E" + rx_exc_text(rn_e); }
}
rx_out_get(mut og_db, og_key) {
  try { return "V" + rx_vtext(get(og_db,og_key)); } catch(og_e) { return "E" + rx_exc_text(og_e); }
}
// The structural invariant: users[d] contains i <=> d in deps[i]; the computation stacks are empty.
rx_audit(au_db) {
  au_bad = 0;
  if(au_db.top != 0) au_bad = au_bad + 1;
  for(au_i : range(au_db.keys.size)) {
    if(au_db.onstack[au_i]) au_bad = au_bad + 1;
    for(au_d : au_db.deps[au_i]) if(!rx_has(au_db.users[au_d[0]],au_i)) au_bad = au_bad + 1;
    for(au_u : au_db.users[au_i]) if(!rx_reads(au_db.deps[au_u],au_i)) au_bad = au_bad + 1;
  }
  return au_bad;
}
// Counter consistency: accesses == computations + hits + refusals; computations == the independent count of executions
// of query functions; cutoffs == independently counted ones (the result matched the previous one by rx_ser). Returns the number of violations.
rx_audit_stats(as_db, as_ex) {
  as_c = stats_all(as_db); as_bad = 0;
  if(as_c[3] != (as_c[0] + as_c[1] + as_c[4])) as_bad = as_bad + 1;
  if(as_c[0] != as_ex[0]) as_bad = as_bad + 1;
  if(as_c[2] > as_c[0]) as_bad = as_bad + 1;
  if(as_c[2] != as_ex[1]) as_bad = as_bad + 1;
  return as_bad;
}
rx_apply(mut ap_db, ap_ops, ap_ex, ap_last) {
  for(ap_o : ap_ops) {
    if(ap_o[0] == 0) set_input(ap_db,text(ap_o[1]),ap_o[2]);
    else if(ap_o[0] == 1) rx_define(ap_db,text(ap_o[1]),ap_o[3],ap_ex,ap_last);
    else set_input(ap_db,"opt" + text(ap_o[1]),ap_o[2]);
  }
}
rx_watch(mut rw_db, rw_key, rw_handler) { rw_v = get(rw_db,rw_key); watch(rw_db,rw_key,rw_handler); return rw_v; }
rx_sub(sb_ops, sb_from, sb_to) { sb_r = array{}; for(sb_i : range(sb_to - sb_from)) sb_r.push(sb_ops[sb_from + sb_i]); return sb_r; }
// A batch of three operations: tb_mode 0 - flat, 1 - batch{ batch{o0}; o1; o2 }, 2 - batch{ batch{ o0; batch{o1} }; o2 } (nested: operations AFTER
// the inner batch, delivery ONCE on leaving the outer one: the intermediate state is not delivered).
rx_try_batch(mut tb_db, tb_ops, tb_ex, tb_last, tb_mode) {
  try {
    if(tb_mode == 0) { batch(tb_db) { rx_apply(tb_db,tb_ops,tb_ex,tb_last); } return 0; }
    if(tb_mode == 1) { batch(tb_db) { batch(tb_db) { rx_apply(tb_db,rx_sub(tb_ops,0,1),tb_ex,tb_last); } rx_apply(tb_db,rx_sub(tb_ops,1,3),tb_ex,tb_last); } return 0; }
    batch(tb_db) { batch(tb_db) { rx_apply(tb_db,rx_sub(tb_ops,0,1),tb_ex,tb_last); batch(tb_db) { rx_apply(tb_db,rx_sub(tb_ops,1,2),tb_ex,tb_last); } } rx_apply(tb_db,rx_sub(tb_ops,2,3),tb_ex,tb_last); }
  } catch(tb_e) { return 1; }
  return 0;
}
react_check_cli(rc_av) {
  rc_seed = 1; rc_steps = 300;
  if(rc_av.size > 0) rc_seed = parse_int(rc_av[0]).value;
  if(rc_av.size > 1) rc_steps = parse_int(rc_av[1]).value;
  rc_push = new_db(true,(a,b) => deep_equal(a,b)); rc_pull = new_db(false,(a,b) => deep_equal(a,b));
  rc_inputs = array{}; rc_opts = array{"","",""}; rc_specs = array{}; rc_bad = 0; rc_naive = 0;
  rc_redef = 0; rc_errs = 0; rc_events = array{0}; rc_flusherr = 0;
  rc_last = array{array{"","",""},array{"","",""}}; rc_reg = array{array{false,false,false},array{false,false,false}};
  rc_dups = array{0}; rc_wkeys = array{"9","12","16"}; rc_expush = array{0,0}; rc_expull = array{0,0}; rc_statbad = 0;
  rc_lpush = array{}; rc_lpull = array{}; for(rc_i : range(12)) { rc_lpush.push(""); rc_lpull.push(""); }
  rc_evd = array{0,0}; rc_evbad = 0; rc_nested = 0;
  for(rc_i : range(5)) {
    rc_v = text(rx_rand(rc_seed) % 20); rc_inputs.push(rc_v);
    set_input(rc_push,text(rc_i),rc_v); set_input(rc_pull,text(rc_i),rc_v);
  }
  for(rc_i : range(12)) {
    rc_s = rx_spec(rc_seed,rc_i + 5,rc_specs); rc_specs.push(rc_s);
    rx_define(rc_push,text(rc_i + 5),rc_s,rc_expush,rc_lpush); rx_define(rc_pull,text(rc_i + 5),rc_s,rc_expull,rc_lpull);
  }
  for(rc_step : range(rc_steps)) {
    rc_ops = array{};
    for(rc_j : range(3)) {
      rc_r = rx_rand(rc_seed) % 10;
      if(rc_r < 6) {
        rc_at = rx_rand(rc_seed) % 5; rc_v = text(rx_rand(rc_seed) % 20); rc_inputs[rc_at] = rc_v;
        rc_ops.push(array{0,rc_at,rc_v,array{}});
      } else if(rc_r < 8) {
        rc_q = rx_rand(rc_seed) % 12; rc_s = rx_spec(rc_seed,rc_q + 5,rc_specs); rc_specs[rc_q] = rc_s;
        rc_ops.push(array{1,rc_q + 5,"",rc_s}); rc_redef = rc_redef + 1;
      } else {
        rc_at = rx_rand(rc_seed) % 3; rc_v = text(rx_rand(rc_seed) % 20); rc_opts[rc_at] = rc_v;
        rc_ops.push(array{2,rc_at,rc_v,array{}});
      }
    }
    // A snapshot before the batch: who is subscribed, the last value, the number of notifications (the exact notification count is checked afterwards).
    rc_regb = array{array{false,false,false},array{false,false,false}}; rc_lastb = array{array{"","",""},array{"","",""}}; rc_evb = array{rc_evd[0],rc_evd[1]};
    for(rc_d : range(2)) for(rc_w : range(3)) { rc_regb[rc_d][rc_w] = rc_reg[rc_d][rc_w]; rc_lastb[rc_d][rc_w] = rc_last[rc_d][rc_w]; }
    rc_mode = rc_step % 3; if(rc_mode > 0) rc_nested = rc_nested + 1;
    rc_flusherr = rc_flusherr + rx_try_batch(rc_push,rc_ops,rc_expush,rc_lpush,rc_mode) + rx_try_batch(rc_pull,rc_ops,rc_expull,rc_lpull,rc_mode);
    // The exact count: per batch (including a nested one) a subscriber gets no more than one notification: exactly when its query now does not fail
    // and its value differs from the last delivered one. The intermediate states of nested batches are not delivered.
    for(rc_d : range(2)) {
      rc_want = 0;
      for(rc_w : range(3)) if(rc_regb[rc_d][rc_w]) {
        rc_expected = rx_out_naive(rc_specs,rc_inputs,rc_opts,parse_int(rc_wkeys[rc_w]).value,rc_naive);
        if(rc_expected[0] == 86) if("V" + rc_lastb[rc_d][rc_w] != rc_expected) rc_want = rc_want + 1;
      }
      if((rc_evd[rc_d] - rc_evb[rc_d]) != rc_want) rc_evbad = rc_evbad + 1;
    }
    // Subscriptions on keys 9/12/16: registered when the query does not fail (watch throws on a query error).
    for(rc_w : range(3)) for(rc_d : range(2)) if(!rc_reg[rc_d][rc_w]) {
      rc_wi = rc_w; rc_di = rc_d;
      try {
        if(rc_d == 0) rc_init = rx_watch(rc_push,rc_wkeys[rc_w],(k,v) => { rc_sv = rx_vtext(v); if(rc_last[rc_di][rc_wi] == rc_sv) rc_dups[0] = rc_dups[0] + 1; rc_last[rc_di][rc_wi] = rc_sv; rc_events[0] = rc_events[0] + 1; rc_evd[rc_di] = rc_evd[rc_di] + 1; });
        else rc_init = rx_watch(rc_pull,rc_wkeys[rc_w],(k,v) => { rc_sv = rx_vtext(v); if(rc_last[rc_di][rc_wi] == rc_sv) rc_dups[0] = rc_dups[0] + 1; rc_last[rc_di][rc_wi] = rc_sv; rc_events[0] = rc_events[0] + 1; rc_evd[rc_di] = rc_evd[rc_di] + 1; });
        rc_last[rc_d][rc_w] = rx_vtext(rc_init); rc_reg[rc_d][rc_w] = true;
      } catch(rc_e) { }
    }
    rc_all = rx_rand(rc_seed) % 2;
    for(rc_i : range(12)) {
      rc_n = if((rc_step % 2) == 0) (rc_i + 5) else (16 - rc_i);
      if((rc_all == 1) || ((rx_rand(rc_seed) % 2) == 0)) {
        rc_expected = rx_out_naive(rc_specs,rc_inputs,rc_opts,rc_n,rc_naive);
        if(rc_expected[0] == 69) rc_errs = rc_errs + 1;
        if(rx_out_get(rc_push,text(rc_n)) != rc_expected) rc_bad = rc_bad + 1;
        if(rx_out_get(rc_pull,text(rc_n)) != rc_expected) rc_bad = rc_bad + 1;
      }
    }
    // Delivery: for a registered subscription the last value is current if the query does not fail.
    for(rc_w : range(3)) {
      rc_expected = rx_out_naive(rc_specs,rc_inputs,rc_opts,parse_int(rc_wkeys[rc_w]).value,rc_naive);
      if(rc_expected[0] == 86) for(rc_d : range(2)) if(rc_reg[rc_d][rc_w]) if("V" + rc_last[rc_d][rc_w] != rc_expected) rc_bad = rc_bad + 1;
    }
    rc_bad = rc_bad + rx_audit(rc_push) + rx_audit(rc_pull);
    rc_statbad = rc_statbad + rx_audit_stats(rc_push,rc_expush) + rx_audit_stats(rc_pull,rc_expull);
  }
  rc_bad = rc_bad + rc_dups[0] + rc_statbad + rc_evbad; rc_rand = rc_bad; rc_fixed = rx_cases(); rc_bad = rc_bad + rc_fixed;
  print("reactcheck: шагов=" + text(rc_steps) + " запросов=12 push=" + text(stats(rc_push)[0]) + " pull=" + text(stats(rc_pull)[0]) + " наивно=" + text(rc_naive) + " доля%=" + text((stats(rc_push)[0] * 100) / rc_naive) + " переопределений=" + text(rc_redef) + " ошибок=" + text(rc_errs) + " уведомлений=" + text(rc_events[0]) + " повторных=" + text(rc_dups[0]) + " вложенных_пакетов=" + text(rc_nested) + " уведомлений_нарушений=" + text(rc_evbad) + " статистика_нарушений=" + text(rc_statbad) + " попаданий=" + text(stats(rc_push)[1]) + "/" + text(stats(rc_pull)[1]) + " отсечений=" + text(stats(rc_push)[2]) + "/" + text(stats(rc_pull)[2]) + " ожидаемых_отсечений=" + text(rc_expush[1]) + "/" + text(rc_expull[1]) + " случайных_нарушений=" + text(rc_rand) + " фиксированных_нарушений=" + text(rc_fixed) + " нарушений=" + text(rc_bad));
  return if(rc_bad == 0) 0 else 1;
}

// ---- Fixed cases (regressions of the RA-2 review and API contracts) ----
rx_expect(mut ex_bad, ex_name, ex_got, ex_want) {
  if(text(ex_got) != text(ex_want)) { ex_bad = ex_bad + 1; print("reactcheck: случай " + ex_name + ": получено " + text(ex_got) + ", ожидалось " + text(ex_want)); }
}
rx_read_opt(mut ro_db, ro_key) { try { return get(ro_db,ro_key); } catch(ro_e) { return 0; } }
rx_chain(mut ch_db, ch_n) {
  set_input(ch_db,"c0",0);
  for(ch_i : range(ch_n)) { ch_k = "c" + text(ch_i); query_define(ch_db,"c" + text(ch_i + 1),(mut d) => get(d,ch_k) + 1); }
}
rx_cases() {
  cs_bad = 0;
  for(cs_push : array{false,true}) {
    cs_m = if(cs_push) "push " else "pull ";
    // B1: the old read-set is not computed after the controlling key changes; redefinition resets the read-set
    cs_db = new_db(cs_push,(a,b) => a == b);
    set_input(cs_db,"switch",0); query_define(cs_db,"bad",(mut d) => 1);
    query_define(cs_db,"q",(mut d) => if(get(d,"switch") == 0) get(d,"bad") else 42);
    rx_expect(cs_bad,cs_m + "dynamic before",get(cs_db,"q"),1);
    query_define(cs_db,"bad",(mut d) => get(d,"bad")); set_input(cs_db,"switch",1);
    rx_expect(cs_bad,cs_m + "dynamic after",rx_out_get(cs_db,"q"),"V42");
    query_define(cs_db,"q",(mut d) => 99);
    rx_expect(cs_bad,cs_m + "redefine const",rx_out_get(cs_db,"q"),"V99");
    // B1: an old branch with a broken query does not throw when the branch is no longer read
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"m",0); set_input(cs_db,"x",1);
    query_define(cs_db,"w",(mut d) => if(get(d,"m") == 0) 100 / get(d,"x") else -1);
    rx_expect(cs_bad,cs_m + "guarded before",rx_out_get(cs_db,"w"),"V100");
    set_input(cs_db,"x",0); set_input(cs_db,"m",1);
    rx_expect(cs_bad,cs_m + "guarded after",rx_out_get(cs_db,"w"),"V-1");
    // B2: a caught failure of a child is a dependency; an undefined key appeared
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"fail",1);
    query_define(cs_db,"child",(mut d) => if(get(d,"fail") == 1) throw "failed" else 7);
    query_define(cs_db,"parent",(mut d) => rx_read_opt(d,"child") - 1);
    rx_expect(cs_bad,cs_m + "caught child before",get(cs_db,"parent"),-1);
    set_input(cs_db,"fail",0); rx_expect(cs_bad,cs_m + "caught child after",get(cs_db,"parent"),6);
    set_input(cs_db,"fail",1); rx_expect(cs_bad,cs_m + "caught child again",get(cs_db,"parent"),-1);
    cs_db = new_db(cs_push,(a,b) => a == b); query_define(cs_db,"o",(mut d) => rx_read_opt(d,"missing"));
    rx_expect(cs_bad,cs_m + "missing before",get(cs_db,"o"),0);
    set_input(cs_db,"missing",7); rx_expect(cs_bad,cs_m + "missing after",get(cs_db,"o"),7);
    query_define(cs_db,"missing2",(mut d) => 5); query_define(cs_db,"o2",(mut d) => rx_read_opt(d,"missing2"));
    rx_expect(cs_bad,cs_m + "query defines missing",get(cs_db,"o2"),5);
    // M1: redefinition 1 -> 2, the dependents see it
    cs_db = new_db(cs_push,(a,b) => a == b); query_define(cs_db,"f",(mut d) => 1); query_define(cs_db,"g",(mut d) => get(d,"f") * 10);
    rx_expect(cs_bad,cs_m + "redef before",get(cs_db,"g"),10);
    query_define(cs_db,"f",(mut d) => 2); rx_expect(cs_bad,cs_m + "redef after",get(cs_db,"g"),20);
    query_define(cs_db,"f",(mut d) => 2); cs_ev = stats(cs_db)[0]; rx_expect(cs_bad,cs_m + "redef same",get(cs_db,"g"),20);
    rx_expect(cs_bad,cs_m + "redef same cutoff",stats(cs_db)[0] - cs_ev,1);
    // cycles: direct, indirect, one that arose after a redefinition; recovery
    cs_db = new_db(cs_push,(a,b) => a == b);
    query_define(cs_db,"a",(mut d) => get(d,"b")); query_define(cs_db,"b",(mut d) => get(d,"a"));
    rx_expect(cs_bad,cs_m + "cycle",rx_out_get(cs_db,"a"),"Estr:reactive cycle: a -> b -> a");
    query_define(cs_db,"b",(mut d) => 3); rx_expect(cs_bad,cs_m + "cycle fixed",rx_out_get(cs_db,"a"),"V3");
    rx_expect(cs_bad,cs_m + "audit cycle",rx_audit(cs_db),0);
    // batch: a body exception keeps the changes without notifications; delivery at the next flush
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => cs_ev.push(text(v)));
    try { batch(cs_db) { set_input(cs_db,"x",1); throw "body"; } } catch(cs_e) { }
    rx_expect(cs_bad,cs_m + "batch exc no notify",text(cs_ev),"[]"); rx_expect(cs_bad,cs_m + "batch exc kept",get(cs_db,"x"),1);
    set_input(cs_db,"x",2); rx_expect(cs_bad,cs_m + "batch exc delivered",text(cs_ev),"[2]");
    // M2: a handler exception does not interrupt delivery; the first is after delivery; it is not delivered again
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); set_input(cs_db,"y",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => { cs_ev.push("h1=" + text(v)); throw "handler1"; });
    watch(cs_db,"x",(k,v) => cs_ev.push("h2=" + text(v)));
    watch(cs_db,"y",(k,v) => { cs_ev.push("h3=" + text(v)); throw "handler3"; });
    cs_got = "";
    try { batch(cs_db) { set_input(cs_db,"x",1); set_input(cs_db,"y",1); } } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc first",cs_got,"handler1");
    rx_expect(cs_bad,cs_m + "handler exc all delivered",text(cs_ev),"[h1=1, h2=1, h3=1]");
    cs_got = ""; try { set_input(cs_db,"x",1); } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc no redelivery",text(cs_ev) + cs_got,"[h1=1, h2=1, h3=1]");
    batch(cs_db) { } rx_expect(cs_bad,cs_m + "handler exc empty batch",text(cs_ev),"[h1=1, h2=1, h3=1]");
    try { set_input(cs_db,"x",2); } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc next",text(cs_ev),"[h1=1, h2=1, h3=1, h1=2, h2=2]");
    rx_expect(cs_bad,cs_m + "handler exc state",rx_audit(cs_db) + cs_db.busy + cs_db.depth,0);
    // a database change from a handler and from a query is an explicit refusal
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); set_input(cs_db,"y",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => set_input(cs_db,"y",5));
    try { set_input(cs_db,"x",1); } catch(cs_e) { cs_ev.push(text(cs_e)); }
    rx_expect(cs_bad,cs_m + "mutation in handler",text(cs_ev),"[reactive: change during notification: set_input y]");
    rx_expect(cs_bad,cs_m + "mutation in handler kept",get(cs_db,"y"),0);
    query_define(cs_db,"mutq",(mut d) => { set_input(d,"y",9); return 1; });
    rx_expect(cs_bad,cs_m + "mutation in query",rx_out_get(cs_db,"mutq"),"Estr:reactive: change during evaluation: set_input y");
    rx_expect(cs_bad,cs_m + "mutation in query state",rx_audit(cs_db),0);
    // depth: a chain of 120 at a limit of 50 - an explicit error, the database is intact; 40 - works; the limit raised - works
    cs_db = new_db(cs_push,(a,b) => a == b); set_max_depth(cs_db,50); rx_chain(cs_db,120);
    rx_expect(cs_bad,cs_m + "depth limit",rx_out_get(cs_db,"c120"),"Estr:reactive: глубина вычислений > 50");
    rx_expect(cs_bad,cs_m + "depth state",rx_audit(cs_db),0);
    rx_expect(cs_bad,cs_m + "depth below limit",rx_out_get(cs_db,"c40"),"V40");
    set_max_depth(cs_db,500); rx_expect(cs_bad,cs_m + "depth raised",rx_out_get(cs_db,"c120"),"V120");
    set_input(cs_db,"c0",5); rx_expect(cs_bad,cs_m + "depth update",rx_out_get(cs_db,"c120"),"V125");
    // keys with common prefixes and the growth of the hash table
    cs_db = new_db(cs_push,(a,b) => a == b);
    for(cs_i : range(200)) set_input(cs_db,"k" + text(cs_i),cs_i);
    cs_sum = 0; for(cs_i : range(200)) cs_sum = cs_sum + get(cs_db,"k" + text(cs_i));
    rx_expect(cs_bad,cs_m + "many keys",cs_sum,19900);
    rx_expect(cs_bad,cs_m + "absent key",rx_out_get(cs_db,"k200"),"Estr:reactive: undefined k200");
  }
  // push counters: early cutoff and dynamic dependencies (push only, exact numbers)
  cs_db = new_db(true,(a,b) => a == b);
  set_input(cs_db,"x",2); set_input(cs_db,"y",9);
  query_define(cs_db,"q",(mut d) => get(d,"x") % 2);
  query_define(cs_db,"r",(mut d) => get(d,"q") + 10);
  get(cs_db,"r"); cs_before = stats(cs_db)[0]; set_input(cs_db,"x",4); get(cs_db,"r");
  rx_expect(cs_bad,"cutoff evals",stats(cs_db)[0] - cs_before,1);
  rx_expect(cs_bad,"cutoff count",stats(cs_db)[2],1);
  query_define(cs_db,"dyn",(mut d) => if(get(d,"q") == 0) get(d,"y") else get(d,"x"));
  get(cs_db,"dyn"); set_input(cs_db,"x",3); get(cs_db,"dyn");
  rx_expect(cs_bad,"dyn detached",rx_has(cs_db.users[rx_find(cs_db,"y")],rx_find(cs_db,"dyn")),false);
  cs_before = stats(cs_db)[0]; set_input(cs_db,"y",8); get(cs_db,"dyn");
  rx_expect(cs_bad,"dyn no recompute",stats(cs_db)[0] - cs_before,0);
  cs_events = array{};
  watch(cs_db,"r",(k,v) => cs_events.push(k)); watch(cs_db,"q",(k,v) => cs_events.push(k));
  batch(cs_db) { set_input(cs_db,"x",6); set_input(cs_db,"x",8); }
  rx_expect(cs_bad,"watch order",text(cs_events),"[q, r]");
  batch(cs_db) { set_input(cs_db,"y",1); set_input(cs_db,"x",10); }
  rx_expect(cs_bad,"watch once",cs_events.size,2);
  return cs_bad + rx_cases_err() + rx_cases_val() + rx_cases_cycle4();
}

// ---- Fixed cases of the second review cycle: the exception type, a cycle and delivery, the error cache, depth ----
rx_cases_err() {
  ce_bad = 0;
  for(ce_push : array{false,true}) {
    ce_m = if(ce_push) "push " else "pull ";
    // B1: a change of the exception type with the same text (`throw 1` -> `throw "1"`) recomputes the typed catch and its consumer
    ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",0);
    query_define(ce_db,"child",(mut d) => { if(get(d,"x") == 0) throw 1; throw "1"; });
    query_define(ce_db,"parent",(mut d) => { try { return get(d,"child"); } catch(str e) { return 20; } catch(e) { return 10; } });
    query_define(ce_db,"grand",(mut d) => get(d,"parent") + 100);
    rx_expect(ce_bad,ce_m + "typed catch before",get(ce_db,"grand"),110);
    rx_expect(ce_bad,ce_m + "typed uncaught before",rx_out_get(ce_db,"child"),"Ei64:1");
    set_input(ce_db,"x",1);
    rx_expect(ce_bad,ce_m + "typed catch after",get(ce_db,"grand"),120);
    rx_expect(ce_bad,ce_m + "typed uncaught after",rx_out_get(ce_db,"child"),"Estr:1");
    set_input(ce_db,"x",0); rx_expect(ce_bad,ce_m + "typed catch back",get(ce_db,"grand"),110);
    rx_expect(ce_bad,ce_m + "typed audit",rx_audit(ce_db),0);
    // B2: a caught cycle does not block delivery (including to an independent subscriber) and does not break the state
    ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",1); set_input(ce_db,"y",0); ce_ev = array{};
    query_define(ce_db,"a",(mut d) => { ce_x = get(d,"x"); try { return get(d,"b"); } catch(e) { return ce_x; } });
    query_define(ce_db,"b",(mut d) => get(d,"a"));
    watch(ce_db,"y",(k,v) => ce_ev.push("y=" + text(v))); watch(ce_db,"a",(k,v) => ce_ev.push("a=" + text(v)));
    rx_expect(ce_bad,ce_m + "caught cycle a",get(ce_db,"a"),1); rx_expect(ce_bad,ce_m + "caught cycle b",get(ce_db,"b"),1);
    ce_got = "";
    try { batch(ce_db) { set_input(ce_db,"x",2); set_input(ce_db,"y",2); } } catch(ce_e) { ce_got = text(ce_e); }
    rx_expect(ce_bad,ce_m + "caught cycle no error",ce_got,"");
    rx_expect(ce_bad,ce_m + "caught cycle both delivered",rx_has(ce_ev,"y=2") && rx_has(ce_ev,"a=2") && (ce_ev.size == 2),true);
    rx_expect(ce_bad,ce_m + "caught cycle value",get(ce_db,"a"),2);
    set_input(ce_db,"y",3); rx_expect(ce_bad,ce_m + "caught cycle independent",rx_has(ce_ev,"y=3"),true);
    set_input(ce_db,"x",5); rx_expect(ce_bad,ce_m + "caught cycle again",rx_has(ce_ev,"a=5"),true);
    rx_expect(ce_bad,ce_m + "caught cycle state",rx_audit(ce_db) + ce_db.busy + ce_db.depth + ce_db.top,0);
    // V1: a failed diamond of depth 20 is counted linearly: 1 + 3*20 executions, a repeated read comes from the cache
    ce_ex = array{0}; ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"s",0);
    query_define(ce_db,"r0",(mut d) => { ce_ex[0] = ce_ex[0] + 1; throw "boom" + text(get(d,"s") % 2); });
    for(ce_i : range(20)) {
      ce_p = "r" + text(ce_i); ce_l = "l" + text(ce_i + 1); ce_r = "m" + text(ce_i + 1);
      query_define(ce_db,ce_l,(mut d) => { ce_ex[0] = ce_ex[0] + 1; return get(d,ce_p); });
      query_define(ce_db,ce_r,(mut d) => { ce_ex[0] = ce_ex[0] + 1; return get(d,ce_p); });
      query_define(ce_db,"r" + text(ce_i + 1),(mut d) => { ce_ex[0] = ce_ex[0] + 1; try { get(d,ce_l); } catch(e) { } return get(d,ce_r); });
    }
    rx_expect(ce_bad,ce_m + "error diamond",rx_out_get(ce_db,"r20"),"Estr:boom0");
    rx_expect(ce_bad,ce_m + "error diamond execs",ce_ex[0],61);
    rx_expect(ce_bad,ce_m + "error diamond stats",stats(ce_db)[0],61);
    rx_out_get(ce_db,"r20"); rx_expect(ce_bad,ce_m + "error cached",ce_ex[0],61);
    set_input(ce_db,"s",2); rx_out_get(ce_db,"r20");
    rx_expect(ce_bad,ce_m + "error early cutoff",ce_ex[0],62);
    set_input(ce_db,"s",1);
    rx_expect(ce_bad,ce_m + "error changed",rx_out_get(ce_db,"r20"),"Estr:boom1");
    rx_expect(ce_bad,ce_m + "error changed execs",ce_ex[0],62 + 61);
    rx_expect(ce_bad,ce_m + "error diamond audit",rx_audit(ce_db),0);
    // an error is cached: the consumer is not recomputed while the child's exception is the same
    ce_ex = array{0,0}; ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",0);
    query_define(ce_db,"child",(mut d) => { ce_ex[0] = ce_ex[0] + 1; get(d,"x"); throw "same"; });
    query_define(ce_db,"parent",(mut d) => { ce_ex[1] = ce_ex[1] + 1; try { get(d,"child"); } catch(e) { return text(e); } return ""; });
    rx_expect(ce_bad,ce_m + "error consumer",get(ce_db,"parent"),"same"); get(ce_db,"parent");
    rx_expect(ce_bad,ce_m + "error consumer cached",text(ce_ex),"[1, 1]");
    set_input(ce_db,"x",1); rx_expect(ce_bad,ce_m + "error consumer cutoff",get(ce_db,"parent"),"same");
    rx_expect(ce_bad,ce_m + "error consumer cutoff execs",text(ce_ex),"[2, 1]");
    // V2: a caught depth error depends on the limit: raising the limit is visible at once, without bypassing the cache
    ce_db = new_db(ce_push,(a,b) => a == b); rx_chain(ce_db,10);
    query_define(ce_db,"p",(mut d) => { try { return get(d,"c10"); } catch(e) { return -1; } });
    set_max_depth(ce_db,5); rx_expect(ce_bad,ce_m + "depth caught low",get(ce_db,"p"),-1);
    set_max_depth(ce_db,20); rx_expect(ce_bad,ce_m + "depth caught raised",get(ce_db,"p"),10);
    set_input(ce_db,"c0",5); rx_expect(ce_bad,ce_m + "depth caught update",get(ce_db,"p"),15);
    rx_expect(ce_bad,ce_m + "depth caught audit",rx_audit(ce_db),0);
  }
  return ce_bad;
}

// ---- Fixed cases of the third review cycle: STRUCTURAL equality of values and exceptions, array cutoff, nested batches ----
rx_pair_case(cv_push, cv_i, cv_j, mut cv_bad) {
  cv_m = if(cv_push) "push " else "pull "; cv_name = cv_m + "payload " + text(cv_i) + "->" + text(cv_j) + ": ";
  cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"v",0);
  query_define(cv_db,"child",(mut d) => { if(get(d,"v") == 0) throw rx_payload(cv_i,1); throw rx_payload(cv_j,1); });
  query_define(cv_db,"parent",(mut d) => { try { get(d,"child"); } catch(e) { return rx_ser(e); } return "none"; });
  query_define(cv_db,"grand",(mut d) => get(d,"parent") + "!");
  rx_expect(cv_bad,cv_name + "before",get(cv_db,"grand"),rx_ser(rx_payload(cv_i,1)) + "!");
  set_input(cv_db,"v",1);
  rx_expect(cv_bad,cv_name + "after",get(cv_db,"grand"),rx_ser(rx_payload(cv_j,1)) + "!");
  rx_expect(cv_bad,cv_name + "uncaught",rx_out_get(cv_db,"child"),"E" + rx_ser(rx_payload(cv_j,1)));
  set_input(cv_db,"v",0);
  rx_expect(cv_bad,cv_name + "back",get(cv_db,"grand"),rx_ser(rx_payload(cv_i,1)) + "!");
  rx_expect(cv_bad,cv_name + "audit",rx_audit(cv_db),0);
}
rx_cases_val() {
  cv_bad = 0;
  // the truth table of deep_equal against an independent structural record: 22 kinds x parameter 0/1, all pairs
  cv_eq = 0; cv_ne = 0;
  for(cv_i : range(22)) for(cv_n : range(2)) for(cv_j : range(22)) for(cv_m : range(2)) {
    cv_a = rx_payload(cv_i,cv_n); cv_b = rx_payload(cv_j,cv_m);
    cv_want = rx_ser(cv_a) == rx_ser(cv_b);
    if(cv_want) cv_eq = cv_eq + 1 else cv_ne = cv_ne + 1;
    if(deep_equal(cv_a,cv_b) != cv_want) { cv_bad = cv_bad + 1; print("reactcheck: случай deep_equal " + text(cv_i) + "/" + text(cv_n) + " vs " + text(cv_j) + "/" + text(cv_m) + ": получено " + text(!cv_want)); }
  }
  rx_expect(cv_bad,"deep_equal truth table sizes",text(cv_eq) + "/" + text(cv_ne),"52/1884");
  rx_expect(cv_bad,"1 vs 1.0",deep_equal(1,1.0),false); rx_expect(cv_bad,"1 vs \"1\"",deep_equal(1,"1"),false);
  rx_expect(cv_bad,"true vs \"true\"",deep_equal(true,"true"),false); rx_expect(cv_bad,"empty array vs empty str",deep_equal(array{},""),false);
  rx_expect(cv_bad,"empty arrays",deep_equal(array{},array{}),true); rx_expect(cv_bad,"empty strs",deep_equal("",""),true);
  rx_expect(cv_bad,"array 1 vs \"1\"",deep_equal(array{1},array{"1"}),false); rx_expect(cv_bad,"nested",deep_equal(array{array{1}},array{array{"1"}}),false);
  rx_expect(cv_bad,"nested same",deep_equal(array{array{1,2},array{}},array{array{1,2},array{}}),true);
  rx_expect(cv_bad,"cardinality",deep_equal(array{"a, b"},array{"a","b"}),false);
  rx_expect(cv_bad,"struct field types",deep_equal(rx_box{array{1}},rx_box{array{"1"}}),false); rx_expect(cv_bad,"struct same",deep_equal(rx_box{array{1}},rx_box{array{1}}),true);
  rx_expect(cv_bad,"tuple order",deep_equal(array{1,"1"},array{"1",1}),false);
  // exceptions of a DIFFERENT type/structure with one text: the consumer catches and reports the full structure
  for(cv_push : array{false,true}) {
    for(cv_i : range(22)) for(cv_j : range(22)) if(cv_i != cv_j) {
      if((text(rx_payload(cv_i,1)) == text(rx_payload(cv_j,1))) || (cv_j == cv_i + 1) || (text(rx_payload(cv_i,0)) == text(rx_payload(cv_j,0)))) rx_pair_case(cv_push,cv_i,cv_j,cv_bad);
    }
  }
  for(cv_push : array{false,true}) {
    cv_m = if(cv_push) "push " else "pull ";
    // the regression of the H1 review: array{1} -> array{"1"} (the element type is observed inside the catch) and array{"a, b"} -> array{"a","b"} (the number of elements)
    cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"x",0);
    query_define(cv_db,"child",(mut d) => { if(get(d,"x") == 0) throw array{1}; throw array{"1"}; });
    query_define(cv_db,"parent",(mut d) => { try { get(d,"child"); return 0; } catch(e) { return if(typeof(e[0]) == typeof(1)) 110 else 120; } });
    rx_expect(cv_bad,cv_m + "H1 array types before",get(cv_db,"parent"),110); set_input(cv_db,"x",1);
    rx_expect(cv_bad,cv_m + "H1 array types after",get(cv_db,"parent"),120);
    cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"x",0);
    query_define(cv_db,"child",(mut d) => { if(get(d,"x") == 0) throw array{"a, b"}; throw array{"a","b"}; });
    query_define(cv_db,"parent",(mut d) => { try { get(d,"child"); return 0; } catch(e) { return e.size; } });
    rx_expect(cv_bad,cv_m + "H1 array length before",get(cv_db,"parent"),1); set_input(cv_db,"x",1);
    rx_expect(cv_bad,cv_m + "H1 array length after",get(cv_db,"parent"),2);
    // early cutoff by arrays: the result array{x%2} is structurally the same - the consumer is not recomputed, the cutoff is counted
    cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"x",0);
    query_define(cv_db,"q",(mut d) => array{get(d,"x") % 2}); query_define(cv_db,"p",(mut d) => get(d,"q")[0] + 100);
    rx_expect(cv_bad,cv_m + "array cutoff before",get(cv_db,"p"),100);
    cv_e0 = stats(cv_db)[0]; cv_c0 = stats(cv_db)[2]; set_input(cv_db,"x",2);
    rx_expect(cv_bad,cv_m + "array cutoff value",get(cv_db,"p"),100);
    rx_expect(cv_bad,cv_m + "array cutoff evals",stats(cv_db)[0] - cv_e0,1);
    rx_expect(cv_bad,cv_m + "array cutoff count",stats(cv_db)[2] - cv_c0,1);
    set_input(cv_db,"x",3); rx_expect(cv_bad,cv_m + "array changed",get(cv_db,"p"),101);
    rx_expect(cv_bad,cv_m + "array changed count",stats(cv_db)[2] - cv_c0,1);
    // the value changes the element type with the same text: array{1} -> array{"1"} - the consumer is recomputed
    cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"x",0);
    query_define(cv_db,"q",(mut d) => if(get(d,"x") == 0) array{1} else array{"1"});
    query_define(cv_db,"p",(mut d) => if(typeof(get(d,"q")[0]) == typeof(1)) 10 else 20);
    rx_expect(cv_bad,cv_m + "array value types before",get(cv_db,"p"),10); set_input(cv_db,"x",1);
    rx_expect(cv_bad,cv_m + "array value types after",get(cv_db,"p"),20);
    // nested batches: a subscriber gets one notification with the final value, the intermediate state is not delivered
    cv_db = new_db(cv_push,(a,b) => deep_equal(a,b)); set_input(cv_db,"x",0); cv_ev = array{};
    watch(cv_db,"x",(k,v) => cv_ev.push(v));
    batch(cv_db) { batch(cv_db) { set_input(cv_db,"x",1); set_input(cv_db,"x",2); } set_input(cv_db,"x",3); }
    rx_expect(cv_bad,cv_m + "nested batch once",text(cv_ev),"[3]");
    batch(cv_db) { batch(cv_db) { set_input(cv_db,"x",7); } set_input(cv_db,"x",3); }
    rx_expect(cv_bad,cv_m + "nested batch back to start",text(cv_ev),"[3]");
    batch(cv_db) { batch(cv_db) { batch(cv_db) { set_input(cv_db,"x",4); } set_input(cv_db,"x",5); } set_input(cv_db,"x",6); }
    rx_expect(cv_bad,cv_m + "nested batch three levels",text(cv_ev),"[3, 6]");
    rx_expect(cv_bad,cv_m + "nested batch state",cv_db.depth + cv_db.busy,0);
  }
  return cv_bad;
}

// Cycle 4: the consumer's result, including observing the sign by division; opaque values are not cut off even against themselves.
rx_observe(o_k, o_v) {
  if(o_k == 22) return text(1.0 / o_v);
  if(o_k == 23) return text(1.0 / o_v[0][0]);
  if(o_k == 24) return text(1.0 / o_v.v[0]);
  if((o_k == 25) || (o_k == 26)) return code_text(o_v);
  if(o_k == 27) return text(o_v(3));
  if(o_k == 28) return text(o_v);
  return text(o_v != o_v);
}
rx_cases_cycle4() {
  c4_bad = 0;
  for(c4_offset : range(8)) {
    c4_k = c4_offset + 22;
    c4_a = rx_payload(c4_k,0); c4_b = rx_payload(c4_k,1);
    rx_expect(c4_bad,"cycle4 direct different " + text(c4_k),deep_equal(c4_a,c4_b),false);
    rx_expect(c4_bad,"cycle4 direct same " + text(c4_k),deep_equal(c4_a,c4_a),c4_k < 25);
    for(c4_push : array{false,true}) for(c4_err : array{false,true}) {
      c4_name = "cycle4 " + text(c4_k) + "/" + text(c4_push) + "/" + text(c4_err);
      c4_db = new_db(c4_push,(a,b) => deep_equal(a,b)); set_input(c4_db,"x",0); c4_calls = array{0};
      query_define(c4_db,"child",(mut d) => { c4_v = rx_payload(c4_k,get(d,"x")); if(c4_err) throw c4_v; return c4_v; });
      query_define(c4_db,"parent",(mut d) => {
        c4_calls[0] = c4_calls[0] + 1;
        try { return rx_observe(c4_k,get(d,"child")); } catch(e) { return rx_observe(c4_k,e); }
      });
      rx_expect(c4_bad,c4_name + " before",get(c4_db,"parent"),rx_observe(c4_k,c4_a));
      set_input(c4_db,"x",1);
      rx_expect(c4_bad,c4_name + " after",get(c4_db,"parent"),rx_observe(c4_k,c4_b));
      rx_expect(c4_bad,c4_name + " consumer recomputed",c4_calls[0],2);
      set_input(c4_db,"x",0);
      rx_expect(c4_bad,c4_name + " back",get(c4_db,"parent"),rx_observe(c4_k,c4_a));
      rx_expect(c4_bad,c4_name + " alive",rx_audit(c4_db),0);
    }
  }
  return c4_bad;
}

// RA-4a - mine. A separate state of derived values; the original reactive_db is not changed.
struct derived_revision { str source; i64 revision; str generator; str version; str input_hash; array parameters; array dependencies; array checks; array cost; str status; str reason; array result; }
struct derived_store { array records; array journal; i64 active; i64 working; i64 stale; array generators; }
derived_new() => derived_store{array{},array{},-1,-1,0,array{}};
// A query snapshot includes its own revision and the RA-2 dynamic read-set.
derived_reads(mut dr_db, str dr_key) {
  get(dr_db,dr_key); dr_i = rx_find(dr_db,dr_key);
  dr_out = array{array{dr_i,dr_db.revs[dr_i]}};
  for(dr_d : dr_db.deps[dr_i]) dr_out.push(dr_d);
  return dr_out;
}
derived_current(mut dc_db, dc_reads) {
  // Two passes: first we bring ALL the queries up to date, then we compare the snapshot.
  for(dc_d : dc_reads) { try { rx_eval(dc_db,dc_d[0]); } catch(dc_e) { } }
  for(dc_d : dc_reads) if(dc_db.revs[dc_d[0]] != dc_d[1]) return false;
  return true;
}
derived_event(mut de_s, de_i, str de_status, str de_reason) {
  de_old = de_s.records[de_i].status;
  de_s.records[de_i].status = de_status; de_s.records[de_i].reason = de_reason;
  de_s.journal.push(array{"status",de_i,de_old,de_status,de_reason});
}
derived_candidate(mut dn_s, dn_record) {
  if(dn_record.status != "кандидат") throw "derived: expected candidate";
  dn_i = dn_s.records.size; dn_s.records.push(dn_record);
  dn_s.journal.push(array{"create",dn_i,dn_record}); return dn_i;
}
derived_version(mut dv_s, str dv_name, str dv_version) {
  dv_s.journal.push(array{"generator",dv_name,dv_version});
  dv_found = false;
  for(dv_j : range(dv_s.generators.size)) if(dv_s.generators[dv_j][0] == dv_name) { dv_s.generators[dv_j][1] = dv_version; dv_found = true; }
  if(!dv_found) dv_s.generators.push(array{dv_name,dv_version});
  for(dv_i : range(dv_s.records.size)) {
    dv_r = dv_s.records[dv_i];
    if((dv_r.generator == dv_name) && (dv_r.version != dv_version) && (dv_r.status != "отвергнут")) {
      derived_event(dv_s,dv_i,"устарел","generator version");
      if(dv_s.active == dv_i) dv_s.active = -1;
    }
  }
}
derived_publish(mut dp_s, mut dp_db, dp_i) {
  dp_r = dp_s.records[dp_i];
  if(dp_r.status != "кандидат") throw "derived: not candidate";
  if((rx_find(dp_db,dp_r.source) < 0) || (dp_r.revision < 0) || (dp_r.revision > dp_db.revision) || (dp_r.dependencies.size == 0)) {
    derived_event(dp_s,dp_i,"отвергнут","invalid source snapshot"); return false;
  }
  dp_valid = derived_current(dp_db,dp_r.dependencies);
  for(dp_g : dp_s.generators) if(dp_g[0] == dp_r.generator) if(dp_g[1] != dp_r.version) dp_valid = false;
  dp_now = array{}; for(dp_d : dp_r.dependencies) dp_now.push(dp_db.revs[dp_d[0]]);
  dp_gvalid = true;
  for(dp_g : dp_s.generators) if(dp_g[0] == dp_r.generator) if(dp_g[1] != dp_r.version) dp_gvalid = false;
  dp_s.journal.push(array{"publish",dp_i,dp_now,dp_gvalid});
  if(!dp_valid) {
    dp_s.stale = dp_s.stale + 1;
    derived_event(dp_s,dp_i,"устарел","read-set or generator changed"); return false;
  }
  if(dp_r.checks.size == 0) { derived_event(dp_s,dp_i,"отвергнут","no checks"); return false; }
  // checks: [oracle, corpus, comparisons, mismatches].
  for(dp_c : dp_r.checks) if((dp_c[2] <= 0) || (dp_c[3] != 0)) {
    derived_event(dp_s,dp_i,"отвергнут","counterexample"); return false;
  }
  derived_event(dp_s,dp_i,"принят","");
  dp_s.active = dp_i; dp_s.working = dp_i;
  return true;
}
// A rollback to an accepted journal record: the read-set is checked anew, the history is not truncated.
derived_rollback(mut db_s, mut db_db, db_event) {
  db_e = db_s.journal[db_event];
  if(db_e[0] != "status") throw "derived: not status event";
  if(db_e[3] != "принят") throw "derived: not acceptance";
  db_i = db_e[1]; db_r = db_s.records[db_i];
  if(db_r.status != "принят") return false;
  if(!derived_current(db_db,db_r.dependencies)) return false;
  for(db_g : db_s.generators) if(db_g[0] == db_r.generator) if(db_g[1] != db_r.version) return false;
  db_s.journal.push(array{"rollback",db_i});
  db_s.active = db_i;
  return true;
}
// An independent fold of the journal from scratch (it does not call the production model's transitions).
derived_audit(da_s) {
  da_states = array{}; da_reasons = array{}; da_active = -1; da_work = -1; da_stale = 0;
  da_pending = -1; da_expect = ""; da_created = array{};
  for(da_e : da_s.journal) {
    if(da_e[0] == "create") { da_states.push("кандидат"); da_reasons.push(da_e[2].reason); da_created.push(da_e[2]); }
    if(da_e[0] == "publish") {
      da_pending = da_e[1]; da_r = da_created[da_pending]; da_valid = da_e[3];
      for(da_j : range(da_r.dependencies.size)) if(da_r.dependencies[da_j][1] != da_e[2][da_j]) da_valid = false;
      da_expect = "принят";
      if(da_r.checks.size == 0) da_expect = "отвергнут";
      for(da_c : da_r.checks) if((da_c[2] <= 0) || (da_c[3] != 0)) da_expect = "отвергнут";
      if(!da_valid) { da_expect = "устарел"; da_stale = da_stale + 1; }
    }
    if(da_e[0] == "status") {
      if(da_pending >= 0) {
        if((da_pending != da_e[1]) || (da_expect != da_e[3])) return false;
        da_pending = -1;
      }
      if(da_states[da_e[1]] != da_e[2]) return false;
      da_states[da_e[1]] = da_e[3]; da_reasons[da_e[1]] = da_e[4];
      if(da_e[3] == "принят") { da_active = da_e[1]; da_work = da_e[1]; }
      if(da_e[3] == "устарел") if(da_active == da_e[1]) da_active = -1;
    }
    if(da_e[0] == "rollback") { if(da_states[da_e[1]] != "принят") return false; da_active = da_e[1]; }
  }
  if(da_active >= 0) if(da_states[da_active] != "принят") return false;
  if(da_pending >= 0) return false;
  if((da_active != da_s.active) || (da_work != da_s.working) || (da_stale != da_s.stale)) return false;
  if(da_states.size != da_s.records.size) return false;
  for(da_i : range(da_states.size)) if((da_states[da_i] != da_s.records[da_i].status) || (da_reasons[da_i] != da_s.records[da_i].reason)) return false;
  return true;
}
derived_check_cli(dd_args) {
  dd_db = new_db(true,(a,b) => deep_equal(a,b)); set_input(dd_db,"source",1);
  query_define(dd_db,"q",(mut d) => get(d,"source") + 1);
  dd_s = derived_new(); derived_version(dd_s,"gen","1"); dd_bad = 0; dd_steps = 0;
  for(dd_n : range(20)) {
    dd_r = derived_revision{"source",dd_db.revision,"gen","1","hash",array{dd_n},derived_reads(dd_db,"q"),array{array{"oracle","corpus",10,0}},array{1,2,3},"кандидат","",array{dd_n}};
    dd_i = derived_candidate(dd_s,dd_r);
    if(!derived_audit(dd_s)) dd_bad = dd_bad + 1;
    if(!derived_publish(dd_s,dd_db,dd_i)) dd_bad = dd_bad + 1;
    if(!derived_audit(dd_s)) dd_bad = dd_bad + 1;
    dd_accept = dd_s.journal.size - 1;
    dd_j = derived_candidate(dd_s,dd_r); derived_publish(dd_s,dd_db,dd_j);
    if(!derived_rollback(dd_s,dd_db,dd_accept)) dd_bad = dd_bad + 1;
    if(dd_s.active != dd_i) dd_bad = dd_bad + 1;
    dd_k = derived_candidate(dd_s,dd_r); set_input(dd_db,"source",dd_n + 2);
    if(derived_publish(dd_s,dd_db,dd_k)) dd_bad = dd_bad + 1;
    if(dd_s.working != dd_j) dd_bad = dd_bad + 1;
    if(derived_rollback(dd_s,dd_db,dd_accept)) dd_bad = dd_bad + 1;
    if(!derived_audit(dd_s)) dd_bad = dd_bad + 1;
    // Two generators, version changes in the middle, a return of the version does not revive a record.
    dd_t = derived_new(); derived_version(dd_t,"A","1"); derived_version(dd_t,"B","1");
    dd_r.dependencies = derived_reads(dd_db,"q"); dd_r.revision = dd_db.revision; dd_r.generator = "A";
    dd_a = derived_candidate(dd_t,dd_r); derived_publish(dd_t,dd_db,dd_a); dd_acc = dd_t.journal.size - 1;
    dd_r.generator = "B"; dd_b = derived_candidate(dd_t,dd_r); derived_publish(dd_t,dd_db,dd_b);
    derived_version(dd_t,"A","2");
    if(dd_t.records[dd_b].status != "принят") dd_bad = dd_bad + 1;
    if(derived_rollback(dd_t,dd_db,dd_acc)) dd_bad = dd_bad + 1;
    dd_r.generator = "A"; dd_old = derived_candidate(dd_t,dd_r);
    if(derived_publish(dd_t,dd_db,dd_old)) dd_bad = dd_bad + 1;
    derived_version(dd_t,"A","1");
    if(derived_rollback(dd_t,dd_db,dd_acc)) dd_bad = dd_bad + 1;
    if(dd_t.active != dd_b) dd_bad = dd_bad + 1;
    if(!derived_audit(dd_t)) dd_bad = dd_bad + 1;
    // An isolated check of the rollback version protection: fault injection of the version table.
    dd_guard = derived_new(); dd_r.generator = "A";
    dd_gi = derived_candidate(dd_guard,dd_r); derived_publish(dd_guard,dd_db,dd_gi); dd_ge = dd_guard.journal.size - 1;
    dd_guard.generators.push(array{"A","2"});
    if(derived_rollback(dd_guard,dd_db,dd_ge)) dd_bad = dd_bad + 1;
    dd_r.generator = "B"; dd_r.checks = array{array{"oracle","zero",0,0}};
    dd_zero = derived_candidate(dd_t,dd_r);
    if(derived_publish(dd_t,dd_db,dd_zero)) dd_bad = dd_bad + 1;
    derived_version(dd_t,"B","2");
    if(dd_t.records[dd_zero].status != "отвергнут") dd_bad = dd_bad + 1;
    if(!derived_audit(dd_t)) dd_bad = dd_bad + 1;
    dd_r.generator = "B"; dd_r.version = "2"; dd_r.checks = array{array{"oracle","valid",1,0}};
    dd_r.source = "missing"; dd_invalid = derived_candidate(dd_t,dd_r);
    if(derived_publish(dd_t,dd_db,dd_invalid)) dd_bad = dd_bad + 1;
    dd_r.source = "source"; dd_r.revision = dd_db.revision + 1;
    dd_invalid = derived_candidate(dd_t,dd_r);
    if(derived_publish(dd_t,dd_db,dd_invalid)) dd_bad = dd_bad + 1;
    dd_r.revision = dd_db.revision; dd_r.dependencies = array{};
    dd_invalid = derived_candidate(dd_t,dd_r);
    if(derived_publish(dd_t,dd_db,dd_invalid)) dd_bad = dd_bad + 1;
    if(!derived_audit(dd_t)) dd_bad = dd_bad + 1;
    // Lazy query only: its revision changes only after evaluation.
    dd_lazy = new_db(false,(a,b) => deep_equal(a,b)); set_input(dd_lazy,"x",dd_n); set_input(dd_lazy,"y",dd_n);
    query_define(dd_lazy,"qx",(mut d) => get(d,"x")); query_define(dd_lazy,"qy",(mut d) => get(d,"y"));
    get(dd_lazy,"qx"); get(dd_lazy,"qy");
    dd_x = rx_find(dd_lazy,"qx"); dd_y = rx_find(dd_lazy,"qy");
    dd_reads = array{array{dd_x,dd_lazy.revs[dd_x]},array{dd_y,dd_lazy.revs[dd_y]}};
    set_input(dd_lazy,"y",dd_n + 1);
    if(derived_current(dd_lazy,dd_reads)) dd_bad = dd_bad + 1;
    if(derived_current(dd_lazy,dd_reads)) dd_bad = dd_bad + 1;
    dd_steps = dd_steps + 1;
  }
  dd_r = derived_revision{"source",dd_db.revision,"gen","1","hash",array{},derived_reads(dd_db,"q"),array{},array{0,0,0},"кандидат","",array{0}};
  dd_no = derived_candidate(dd_s,dd_r);
  if(derived_publish(dd_s,dd_db,dd_no)) dd_bad = dd_bad + 1;
  if(dd_s.records[dd_no].status != "отвергнут") dd_bad = dd_bad + 1;
  dd_r.checks = array{array{"oracle","counterexample",10,1}};
  dd_fail = derived_candidate(dd_s,dd_r);
  if(derived_publish(dd_s,dd_db,dd_fail)) dd_bad = dd_bad + 1;
  if(dd_s.records[dd_fail].status != "отвергнут") dd_bad = dd_bad + 1;
  if(!derived_audit(dd_s)) dd_bad = dd_bad + 1;
  if(get(dd_db,"source") != 21) dd_bad = dd_bad + 1;
  derived_version(dd_s,"gen","2");
  for(dd_r : dd_s.records) if((dd_r.status != "устарел") && (dd_r.status != "отвергнут")) dd_bad = dd_bad + 1;
  if(dd_s.working < 0) dd_bad = dd_bad + 1;
  if(!derived_audit(dd_s)) dd_bad = dd_bad + 1;
  print("derivedcheck: циклов=" + text(dd_steps) + " записей=" + text(dd_s.records.size) + " устаревших=" + text(dd_s.stale) + " нарушений=" + text(dd_bad));
  return if(dd_bad == 0) 0 else 1;
}
