module reactive;
// RA-2, mine: incremental queries without native. Keys are strings.
// new_db(push, equal) takes a value comparison; the recommended comparator is deep_equal.
// set_input(db,key,value); query_define(db,key,fn): fn(mut db) reads get(db,key).
// get records the dynamic read-set; stats returns [computations, hits, cutoffs].
// watch(db,key,handler): handler(key,value). batch(db){...} merges changes;
// handlers are called when a value changes, once, dependencies before users,
// equal keys lexicographically. Nested batches are supported.
//
// The model (red-green, as in Salsa - a reference, UNVERIFIED): a query stores a read-set [key, revision] in order of
// first read. The freshness of an old query is checked by the REVISIONS of its dependencies in order and
// stops at the first one that changed: later dependencies were read only under the earlier values
// early ones, so they are not computed (otherwise an unneeded branch could throw an exception or give a cycle). A dependency
// which is now defined differently counts as changed: the query is recomputed with a NEW read-set.
// The check does not throw: a cycle over old edges simply means "changed".
// Redefining a query resets its read-set; the value stays for early cutoff.
// A query's RESULT is a value OR an exception (RA-2, the second review cycle): an error is cached the same way as a value,
// with its own read-set and revision, and takes part in early cutoff: the revision does not change if the new exception
// structurally equal to the previous one (deep_equal: the type and the content at each level). A reader of a failed query depends on its revision as on a value:
// a change of the exception (including the type with the same text - `throw 1` -> `throw "1"`) recomputes the catcher;
// a diamond with an error is counted linearly, not 2^n. A later definition/fix of a key (including an undefined one;
// a stub key is created on a read from a query) recomputes the parent.
// CONTEXT-DEPENDENT results are not cached ("volatile"): a computation that went through a caught
// CYCLE or a stack depth refusal (the answer depends on who called and on set_max_depth) marks the query
// and all its readers volatile: the value/exception is kept for the revision and early cutoff, but every access
// recomputes the query, so a change of the depth limit is visible at once. A cached pure result is not checked against the depth
// limit (a cold computation deeper than the limit is a refusal; a cache hit is not).
//
// Exceptions: a query clears the stack and is passed to the caller; a batch keeps the changes, the body's exception
// is passed without notifications (delivery is at the next flush). A handler: an exception does not interrupt
// delivery - ALL handlers of the affected keys are called (a key whose query failed is skipped), the subscriber's value
// is updated before the call, the first exception is rethrown from set_input/query_define/batch
// AFTER the others are delivered (the rest are dropped); the database state is consistent, no redelivery is needed.
// The delivery order is topological by read-set; the edges of a caught computation cycle form a cycle
// and do not block delivery: the remaining (unorderable) keys are delivered in ascending key order.
// set_input/query_define/watch/batch changes during the computation of a query or a notification are a refusal
// "reactive: change during ...". Queries are pure functions.
// The computation depth is limited (set_max_depth, 2000 by default; recursion is quadratic because of VM name lookup): otherwise the error
// "reactive: computation depth > N", not a hang. Key lookup is an open-addressing hash table.
// stats(db) = [computations (calls of the query function, including failed ones), hits (including those confirmed by checking the
// read-set), cutoffs (a recomputation gave the same result)]; stats_all(db) adds [accesses to queries, refusals
// by cycle/depth]: the oracle checks the invariant accesses == computations + hits + refusals.
struct reactive_db { array keys; array vals; array funcs; array deps; array revs; array checked; array dirty; array users; array stack; array reads; array watchers; i64 revision; i64 depth; bool push; array equal; array counts; array hashes; array table; array marks; array onstack; array aux; i64 epoch; i64 top; i64 maxdepth; i64 busy; array errs; array vols; i64 taint; }
rx_default_depth() => 2000;
new_db(bool nd_push, nd_equal) => reactive_db{array{},array{},array{},array{},array{},array{},array{},array{},array{},array{},array{},0,0,nd_push,array{nd_equal},array{0,0,0,0,0},array{},rx_table(16),array{},array{},array{},0,0,rx_default_depth(),0,array{},array{},0};
set_max_depth(mut sd_db, i64 sd_n) { sd_db.maxdepth = sd_n; }
rx_table(rt_n) { rt_t = array{}; for(rt_i : range(rt_n)) rt_t.push(-1); return rt_t; }
rx_hash(str rh_key) {
  rh_h = 5381;
  for(rh_c : range(rh_key.size)) rh_h = ((rh_h * 33) + rh_key[rh_c]) % 1000000007;
  return rh_h;
}
rx_lookup(rx_db, str rx_key, rx_h) {
  rx_cap = rx_db.table.size; rx_j = rx_h % rx_cap;
  while(true) {
    rx_s = rx_db.table[rx_j];
    if(rx_s < 0) return -1;
    if(rx_db.hashes[rx_s] == rx_h) if(rx_db.keys[rx_s] == rx_key) return rx_s;
    rx_j = (rx_j + 1) % rx_cap;
  }
  return -1;
}
rx_find(rx_db, str rx_key) => rx_lookup(rx_db, rx_key, rx_hash(rx_key));
rx_place(mut rp_db, rp_i) {
  rp_cap = rp_db.table.size; rp_j = rp_db.hashes[rp_i] % rp_cap;
  while(rp_db.table[rp_j] >= 0) rp_j = (rp_j + 1) % rp_cap;
  rp_db.table[rp_j] = rp_i;
}
rx_slot(mut rx_db, str rx_key) {
  rx_hh = rx_hash(rx_key); rx_i = rx_lookup(rx_db, rx_key, rx_hh);
  if(rx_i >= 0) return rx_i;
  rx_db.keys.push(rx_key); rx_db.hashes.push(rx_hh); rx_db.vals.push(array{}); rx_db.funcs.push(array{});
  rx_db.deps.push(array{}); rx_db.revs.push(0); rx_db.checked.push(-1);
  rx_db.dirty.push(true); rx_db.users.push(array{}); rx_db.marks.push(0); rx_db.onstack.push(false); rx_db.aux.push(0); rx_db.errs.push(array{}); rx_db.vols.push(false);
  rx_n = rx_db.keys.size - 1;
  if((rx_db.keys.size * 2) > rx_db.table.size) {
    rx_db.table = rx_table(rx_db.table.size * 2);
    for(rx_k : range(rx_db.keys.size)) rx_place(rx_db, rx_k);
  } else rx_place(rx_db, rx_n);
  return rx_n;
}
rx_has(rx_xs, rx_x) { for(rx_y : rx_xs) if(rx_y == rx_x) return true; return false; }
rx_reads(rr_deps, rr_i) { for(rr_d : rr_deps) if(rr_d[0] == rr_i) return true; return false; }
rx_guard(mut rg_db, str rg_what) {
  if(rg_db.top > 0) throw "reactive: change during evaluation: " + rg_what;
  if(rg_db.busy > 0) throw "reactive: change during notification: " + rg_what;
}
rx_unuse(mut un_db, un_d, un_i) {
  un_out = array{}; for(un_u : un_db.users[un_d]) if(un_u != un_i) un_out.push(un_u);
  un_db.users[un_d] = un_out;
}
// Back edges users[d] contains i <=> d in deps[i]: they change only by the difference of the old and the new read-set.
rx_relink(mut rl_db, rl_i, rl_old, rl_new) {
  for(rl_d : rl_old) if(!rx_reads(rl_new, rl_d[0])) rx_unuse(rl_db, rl_d[0], rl_i);
  for(rl_d : rl_new) if(!rx_reads(rl_old, rl_d[0])) rl_db.users[rl_d[0]].push(rl_i);
}
// All transitive users are marked dirty (a breadth-first walk, marks by epochs: O(edges)).
rx_dirty(mut rx_db, rx_i) {
  if(rx_db.users[rx_i].size == 0) { rx_db.dirty[rx_i] = true; return; }
  rx_db.epoch = rx_db.epoch + 1; rx_ep = rx_db.epoch;
  rx_db.dirty[rx_i] = true; rx_db.marks[rx_i] = rx_ep;
  rx_todo = array{rx_i}; rx_pos = 0;
  while(rx_pos < rx_todo.size) {
    rx_at = rx_todo[rx_pos]; rx_pos = rx_pos + 1;
    for(rx_u : rx_db.users[rx_at]) if(rx_db.marks[rx_u] != rx_ep) {
      rx_db.marks[rx_u] = rx_ep; rx_todo.push(rx_u); rx_db.dirty[rx_u] = true;
    }
  }
}
query_define(mut qd_db, str qd_key, qd_fn) {
  rx_guard(qd_db, "query_define " + qd_key);
  qd_i = rx_slot(qd_db,qd_key); qd_db.revision = qd_db.revision + 1;
  qd_old = qd_db.deps[qd_i]; rx_relink(qd_db,qd_i,qd_old,array{}); qd_db.deps[qd_i] = array{};
  qd_db.funcs[qd_i] = array{qd_fn}; qd_db.checked[qd_i] = -1; rx_dirty(qd_db,qd_i);
  if(qd_db.depth == 0) rx_flush(qd_db);
}
rx_enter(mut en_db, en_i) {
  if(en_db.top < en_db.stack.size) { en_db.stack[en_db.top] = en_i; en_db.reads[en_db.top] = array{}; }
  else { en_db.stack.push(en_i); en_db.reads.push(array{}); }
  en_db.top = en_db.top + 1; en_db.onstack[en_i] = true;
}
rx_leave(mut lv_db) { lv_db.top = lv_db.top - 1; lv_db.onstack[lv_db.stack[lv_db.top]] = false; }
// Whether a dependency changed since it was read (without an exception outside): the dependency is computed for the revision,
// an error is the same kind of result as a value (with its own revision; an identical exception is not a change).
// A dependency on the stack (a cycle over old edges) - "changed": a recomputation with a new read-set.
rx_changed(mut ch_db, ch_d) {
  if(ch_db.onstack[ch_d[0]]) return true;
  try { rx_eval(ch_db, ch_d[0]); } catch(ch_e) { }
  return ch_db.revs[ch_d[0]] != ch_d[1];
}
// STRUCTURAL equality of values (RA-2, the third review cycle, B1): the type at each level and recursively the content -
// the elements of arrays/tuples (the number and the order), the fields of a struct. It does not rely on text(): `array{1}` and `array{"1"}`,
// `array{"a, b"}` and `array{"a","b"}`, `1` and `"1"`, `1` and `1.0`, `true` and `"true"` are DIFFERENT values. The Vish `==` for values
// of different types is not a result but a program error, so the types are compared before the values. Conservatively "not equal"
// (the cutoff does not fire - safe): functions, type values, code/ref/expr and f64 NaN. The signs of +-0.0 differ.
// Values are trees, there are no cycles.
// The recommended comparator for new_db: (a,b) => deep_equal(a,b).
deep_equal(de_a, de_b) {
  de_t = typeof(de_a);
  if(de_t != typeof(de_b)) return false;
  if((de_t == array) || (de_t == tuple)) {
    if(de_a.size != de_b.size) return false;
    for(de_i : range(de_a.size)) if(!deep_equal(de_a[de_i],de_b[de_i])) return false;
    return true;
  }
  if(de_t == f64) {
    if((de_a != de_a) || (de_b != de_b)) return false;
    return f64_bits(de_a) == f64_bits(de_b);
  }
  if((de_t == i64) || (de_t == str) || (de_t == bool)) return de_a == de_b;
  de_n = text(de_t);
  if(de_n == "unit") return true;
  if((de_n == "fn") || (de_n == "type") || (de_n == "code") || (de_n == "expr") || (text(type_family(de_t)) != de_n)) return false;
  for(de_f : ct fields(de_t)) if(!deep_equal(de_a.[de_f],de_b.[de_f])) return false;
  return true;
}
// An exception is the same if structurally equal (the type and the content at each level).
rx_same_exc(se_a, se_b) => deep_equal(se_a,se_b);
// A stored query result: a value or an exception.
rx_result(mut rs_db, rs_i) {
  if(rs_db.errs[rs_i].size > 0) throw rs_db.errs[rs_i][0];
  return rs_db.vals[rs_i][0];
}
// A new revision of a slot's result: strictly greater than the old one (a volatile result may change within the same database revision).
rx_bump(mut bp_db, bp_i) { bp_db.revs[bp_i] = if(bp_db.revision > bp_db.revs[bp_i]) bp_db.revision else (bp_db.revs[bp_i] + 1); }
rx_eval(mut re_db, re_i) {
  if(re_db.funcs[re_i].size == 0) {
    if(re_db.vals[re_i].size == 0) throw "reactive: undefined " + re_db.keys[re_i];
    return re_db.vals[re_i][0];
  }
  re_db.counts[3] = re_db.counts[3] + 1;
  if(re_db.onstack[re_i]) {
    re_db.counts[4] = re_db.counts[4] + 1; re_db.taint = re_db.taint + 1;
    re_path = "reactive cycle: ";
    for(re_s : range(re_db.top)) re_path = re_path + re_db.keys[re_db.stack[re_s]] + " -> ";
    throw re_path + re_db.keys[re_i];
  }
  re_valid = re_db.checked[re_i] >= 0;
  if(re_valid && ((re_db.checked[re_i] == re_db.revision) || (re_db.push && !re_db.dirty[re_i]))) {
    re_db.counts[1] = re_db.counts[1] + 1; return rx_result(re_db,re_i);
  }
  if(re_db.top >= re_db.maxdepth) {
    re_db.counts[4] = re_db.counts[4] + 1; re_db.taint = re_db.taint + 1;
    throw "reactive: глубина вычислений > " + text(re_db.maxdepth);
  }
  re_olddeps = re_db.deps[re_i]; re_t0 = re_db.taint;
  rx_enter(re_db,re_i);
  if(re_valid) for(re_d : re_olddeps) if(rx_changed(re_db,re_d)) { re_valid = false; break; }
  if(!re_valid) {
    re_db.counts[0] = re_db.counts[0] + 1;
    re_fail = false; re_exc = 0; re_value = 0;
    try { re_fn = re_db.funcs[re_i][0]; re_value = re_fn(re_db); } catch(re_error) { re_fail = true; re_exc = re_error; }
    // The read-set (full or partial on an error) is kept: push invalidation will reach a failed query too.
    re_newdeps = re_db.reads[re_db.top - 1];
    rx_relink(re_db,re_i,re_olddeps,re_newdeps);
    re_db.deps[re_i] = re_newdeps;
    re_eq = re_db.equal[0]; re_same = false;
    if(re_fail) {
      if(re_db.errs[re_i].size > 0) re_same = rx_same_exc(re_db.errs[re_i][0],re_exc);
      if(!re_same) { re_db.errs[re_i] = array{re_exc}; re_db.vals[re_i] = array{}; rx_bump(re_db,re_i); }
    } else {
      if(re_db.vals[re_i].size > 0) re_same = re_eq(re_db.vals[re_i][0],re_value);
      if(!re_same) { re_db.vals[re_i] = array{re_value}; re_db.errs[re_i] = array{}; rx_bump(re_db,re_i); }
    }
    if(re_same) re_db.counts[2] = re_db.counts[2] + 1;
  } else re_db.counts[1] = re_db.counts[1] + 1;
  // A volatile result (the computation went through a cycle or a depth refusal) is not cached, but is stored.
  re_db.vols[re_i] = re_db.taint != re_t0;
  if(re_db.vols[re_i]) { re_db.checked[re_i] = -1; re_db.dirty[re_i] = true; }
  else { re_db.checked[re_i] = re_db.revision; re_db.dirty[re_i] = false; }
  rx_leave(re_db);
  return rx_result(re_db,re_i);
}
rx_note(mut nt_db, nt_i, nt_rev) {
  if(nt_db.top == 0) return;
  nt_at = nt_db.top - 1;
  for(nt_d : nt_db.reads[nt_at]) if(nt_d[0] == nt_i) return;
  nt_db.reads[nt_at].push(array{nt_i,nt_rev});
}
get(mut gt_db, str gt_key) {
  // Inside a query a missing key gets a stub: a failed read is also a dependency (on the error's revision).
  gt_i = rx_find(gt_db,gt_key);
  if(gt_i < 0) {
    if(gt_db.top == 0) throw "reactive: undefined " + gt_key;
    gt_i = rx_slot(gt_db,gt_key);
  }
  gt_value = 0;
  try { gt_value = rx_eval(gt_db,gt_i); }
  catch(gt_error) { rx_note(gt_db,gt_i,gt_db.revs[gt_i]); throw gt_error; }
  rx_note(gt_db,gt_i,gt_db.revs[gt_i]);
  return gt_value;
}
set_input(mut si_db, str si_key, si_value) {
  if((si_db.top > 0) || (si_db.busy > 0)) rx_guard(si_db, "set_input " + si_key);
  si_i = rx_slot(si_db,si_key); si_eq = si_db.equal[0];
  if(si_db.funcs[si_i].size > 0) throw "reactive: query is not input";
  if(si_db.vals[si_i].size > 0) if(si_eq(si_db.vals[si_i][0],si_value)) return;
  si_db.revision = si_db.revision + 1; si_db.vals[si_i] = array{si_value};
  si_db.revs[si_i] = si_db.revision; if(si_db.push) rx_dirty(si_db,si_i);
  if((si_db.depth == 0) && (si_db.watchers.size > 0)) rx_flush(si_db);
}
watch(mut wt_db, str wt_key, wt_handler) {
  rx_guard(wt_db, "watch " + wt_key);
  wt_value = get(wt_db,wt_key); wt_db.watchers.push(array{wt_key,wt_handler,wt_value});
}
// Subscription delivery. Order: dependencies before users (topologically over the whole read-set closure),
// among the ready ones - the smaller key. Every handler is called, exceptions are collected (the first after delivery).
rx_flush(mut fl_db) {
  if(fl_db.watchers.size == 0) return;
  fl_res = array{false,""}; fl_db.busy = fl_db.busy + 1;
  try { rx_deliver(fl_db,fl_res); } catch(fl_e) { fl_db.busy = fl_db.busy - 1; throw fl_e; }
  fl_db.busy = fl_db.busy - 1;
  if(fl_res[0]) throw fl_res[1];
}
rx_deliver(mut rf_db, mut rf_res) {
  rf_failed = false; rf_error = "";
  rf_eq = rf_db.equal[0]; rf_roots = array{};
  rf_db.epoch = rf_db.epoch + 1; rf_ep = rf_db.epoch;
  for(rf_w : rf_db.watchers) {
    rf_i = rx_find(rf_db,rf_w[0]);
    try {
      rx_eval(rf_db,rf_i);
      if(!rf_eq(rf_w[2],rf_db.vals[rf_i][0])) if(rf_db.marks[rf_i] != rf_ep) { rf_db.marks[rf_i] = rf_ep; rf_roots.push(rf_i); }
    } catch(rf_e) { if(!rf_failed) { rf_failed = true; rf_error = rf_e; } }
  }
  if(rf_roots.size > 0) {
    // the closure over dependencies (a breadth-first walk); the rf_ep mark means "in the closure"
    rf_cl = array{}; for(rf_r : rf_roots) rf_cl.push(rf_r);
    rf_pos = 0;
    while(rf_pos < rf_cl.size) {
      rf_at = rf_cl[rf_pos]; rf_pos = rf_pos + 1;
      for(rf_d : rf_db.deps[rf_at]) if(rf_db.marks[rf_d[0]] != rf_ep) { rf_db.marks[rf_d[0]] = rf_ep; rf_cl.push(rf_d[0]); }
    }
    for(rf_c : rf_cl) rf_db.aux[rf_c] = rf_db.deps[rf_c].size;
    rf_ready = array{}; rf_sorted = array{};
    for(rf_c : rf_cl) if(rf_db.aux[rf_c] == 0) rf_ready.push(rf_c);
    while(rf_sorted.size < rf_cl.size) {
      if(rf_ready.size == 0) {
        // A cycle of edges (a caught computation cycle gives edges both ways): there is no order, we do not abort delivery -
        // we release the smallest of the remaining keys (deterministically) and continue.
        rf_best = -1;
        for(rf_c : rf_cl) if(rf_db.aux[rf_c] > 0) if((rf_best < 0) || rx_less(rf_db.keys[rf_c],rf_db.keys[rf_best])) rf_best = rf_c;
        rf_db.aux[rf_best] = 0; rf_ready.push(rf_best);
      }
      rf_best = 0;
      for(rf_k : range(rf_ready.size)) if(rx_less(rf_db.keys[rf_ready[rf_k]],rf_db.keys[rf_ready[rf_best]])) rf_best = rf_k;
      rf_p = rf_ready[rf_best];
      rf_rest = array{}; for(rf_k : range(rf_ready.size)) if(rf_k != rf_best) rf_rest.push(rf_ready[rf_k]);
      rf_ready = rf_rest; rf_sorted.push(rf_p); rf_db.aux[rf_p] = -1;
      for(rf_u : rf_db.users[rf_p]) if(rf_db.marks[rf_u] == rf_ep) if(rf_db.aux[rf_u] > 0) {
        rf_db.aux[rf_u] = rf_db.aux[rf_u] - 1;
        if(rf_db.aux[rf_u] == 0) rf_ready.push(rf_u);
      }
    }
    rf_db.epoch = rf_db.epoch + 1; rf_ep2 = rf_db.epoch;
    for(rf_r : rf_roots) rf_db.marks[rf_r] = rf_ep2;
    for(rf_i : rf_sorted) if(rf_db.marks[rf_i] == rf_ep2) for(rf_j : range(rf_db.watchers.size)) if(rf_db.watchers[rf_j][0] == rf_db.keys[rf_i]) {
      rf_w = rf_db.watchers[rf_j]; rf_v = rf_db.vals[rf_i][0];
      if(!rf_eq(rf_w[2],rf_v)) {
        rf_db.watchers[rf_j][2] = rf_v; rf_fn = rf_w[1];
        try { rf_fn(rf_w[0],rf_v); } catch(rf_e) { if(!rf_failed) { rf_failed = true; rf_error = rf_e; } }
      }
    }
  }
  rf_res[0] = rf_failed; rf_res[1] = rf_error;
}
batch(mut bt_db, expr bt_body) {
  rx_guard(bt_db, "batch");
  bt_db.depth = bt_db.depth + 1;
  try { bt_body; } catch(bt_error) { bt_db.depth = bt_db.depth - 1; throw bt_error; }
  bt_db.depth = bt_db.depth - 1; if(bt_db.depth == 0) rx_flush(bt_db);
}
stats(st_db) => array{st_db.counts[0],st_db.counts[1],st_db.counts[2]};
stats_all(st_db) => st_db.counts;
rx_less(rl_a,rl_b) { for(rl_i : range(if(rl_a.size < rl_b.size) rl_a.size else rl_b.size)) { if(rl_a[rl_i] < rl_b[rl_i]) return true; if(rl_a[rl_i] > rl_b[rl_i]) return false; } return rl_a.size < rl_b.size; }

// ---- The reactcheck oracle: random graphs with errors and dynamic dependencies against a naive recomputation ----
// The specification of query n: [kind, a, b, n], references a,b < n (the graph is acyclic). Kinds: 0 sum%1000, 1 minimum, 2 concatenation,
// 3 conditional read (a even -> b, otherwise a), 4 "guard" (throws at a%5==0), 5 catching a read error of a (-> "0"),
// 6 an optional key "opt"+(a%3) (absent -> "0"; catching an undefined key),
// 7 a "mixed-type throw" (at a%4==1 it returns a; otherwise it throws a value of one of 22 rx_payload kinds - numbers,
// strings, arrays, nested arrays, a struct, tuples, bool, f64 - with the same text for different types/structure;
// the kind is chosen by (a/2)%22, the parameter a%2), 8 a typed catch of a read of a (a string -> "2", another exception -> "3"),
// 9 a catch with a report (a read exception of a -> the hash of the exception's full structural record %1000, otherwise the value of a),
// 10 an ARRAY result array{text(a%3), text(a%2)} (early cutoff by arrays). An array value is read as its element 0 (rx_norm).
rx_rand(mut rr_state) { rr_state = ((rr_state * 1664525) + 1013904223) % 2147483647; return rr_state; }
struct rx_box { array v; }
// A structural record of a value (the ORACLE, independent of deep_equal): the type, the content; nested parts with a length - without ambiguity.
rx_ser(sr_v) {
  sr_t = typeof(sr_v);
  if((sr_t == array) || (sr_t == tuple)) {
    sr_s = text(sr_t) + "[";
    for(sr_i : range(sr_v.size)) { sr_e = rx_ser(sr_v[sr_i]); sr_s = sr_s + text(sr_e.size) + "~" + sr_e; }
    return sr_s + "]";
  }
  if((sr_t == i64) || (sr_t == str) || (sr_t == f64) || (sr_t == bool)) return text(sr_t) + ":" + text(sr_v);
  sr_n = text(sr_t);
  if(sr_n == "code") return "code:" + code_text(sr_v);
  if(sr_n == "fn") return "fn:" + text(sr_v(3));
  if(sr_n == "type") return "type:" + text(sr_v);
  if(sr_n == "unit") return "unit:";
  if((sr_n == "fn") || (sr_n == "type") || (sr_n == "code") || (sr_n == "expr") || (text(type_family(sr_t)) != sr_n)) return "?" + sr_n;
  sr_s = sr_n + "{";
  for(sr_f : ct fields(sr_t)) { sr_e = rx_ser(sr_v.[sr_f]); sr_s = sr_s + sr_f.name + "=" + text(sr_e.size) + "~" + sr_e + ";"; }
  return sr_s + "}";
}
// An independent cutoff policy: an observation may match, but opaque/NaN do not promise equality.
rx_cuttable(cc_v) {
  cc_t = typeof(cc_v); cc_n = text(cc_t);
  if((cc_n == "fn") || (cc_n == "type") || (cc_n == "code") || (cc_n == "expr")) return false;
  if(cc_t == f64) return cc_v == cc_v;
  if((cc_t == array) || (cc_t == tuple)) { for(cc_x : cc_v) if(!rx_cuttable(cc_x)) return false; }
  if(cc_t == rx_box) return rx_cuttable(cc_v.v);
  return true;
}
// A value in the oracle's output: a scalar - text (as before), a compound - a structural record.
rx_vtext(vt_v) => if((typeof(vt_v) == array) || (typeof(vt_v) == tuple)) rx_ser(vt_v) else text(vt_v);
// An array value is read as a string, its element 0.
rx_norm(nm_v) => if(typeof(nm_v) == array) nm_v[0] else nm_v;
