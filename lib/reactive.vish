module reactive;
// RA-2, mine: incremental queries without native. Keys are strings.
// new_db(push, equal) takes a value comparison (for code - a dump comparison).
// set_input(db,key,value); query_define(db,key,fn): fn(mut db) reads get(db,key).
// get records the dynamic read-set; stats returns [computations, hits, cutoffs].
// watch(db,key,handler): handler(key,value). batch(db){...} merges changes;
// handlers are called when a value changes, once, dependencies before users,
// equal keys lexicographically. Nested batches are supported.
//
// The model (red-green, as in Salsa - a reference, UNVERIFIED): a query stores a read-set [key, revision] in order of
// first read. The freshness of an old query is checked by the REVISIONS of its dependencies in order and
// stops at the first one that changed: later dependencies were read only under the earlier values
// early ones, so they are not computed (otherwise an unneeded branch could throw an exception or give a cycle). A dependency
// which is now defined differently counts as changed: the query is recomputed with a NEW read-set.
// The check does not throw: a cycle over old edges simply means "changed".
// Redefining a query resets its read-set; the value stays for early cutoff.
// A query's RESULT is a value OR an exception (RA-2, the second review cycle): an error is cached the same way as a value,
// with its own read-set and revision, and takes part in early cutoff: the revision does not change if the new exception
// has the same type (typeof) and the same value. A reader of a failed query depends on its revision as on a value:
// a change of the exception (including the type with the same text - `throw 1` -> `throw "1"`) recomputes the catcher;
// a diamond with an error is counted linearly, not 2^n. A later definition/fix of a key (including an undefined one;
// a stub key is created on a read from a query) recomputes the parent.
// CONTEXT-DEPENDENT results are not cached ("volatile"): a computation that went through a caught
// CYCLE or a stack depth refusal (the answer depends on who called and on set_max_depth) marks the query
// and all its readers volatile: the value/exception is kept for the revision and early cutoff, but every access
// recomputes the query, so a change of the depth limit is visible at once. A cached pure result is not checked against the depth
// limit (a cold computation deeper than the limit is a refusal; a cache hit is not).
//
// Exceptions: a query clears the stack and is passed to the caller; a batch keeps the changes, the body's exception
// is passed without notifications (delivery is at the next flush). A handler: an exception does not interrupt
// delivery - ALL handlers of the affected keys are called (a key whose query failed is skipped), the subscriber's value
// is updated before the call, the first exception is rethrown from set_input/query_define/batch
// AFTER the others are delivered (the rest are dropped); the database state is consistent, no redelivery is needed.
// The delivery order is topological by read-set; the edges of a caught computation cycle form a cycle
// and do not block delivery: the remaining (unorderable) keys are delivered in ascending key order.
// set_input/query_define/watch/batch changes during the computation of a query or a notification are a refusal
// "reactive: change during ...". Queries are pure functions.
// The computation depth is limited (set_max_depth, 2000 by default; recursion is quadratic because of VM name lookup): otherwise the error
// "reactive: computation depth > N", not a hang. Key lookup is an open-addressing hash table.
// stats(db) = [computations (calls of the query function, including failed ones), hits (including those confirmed by checking the
// read-set), cutoffs (a recomputation gave the same result)]; stats_all(db) adds [accesses to queries, refusals
// by cycle/depth]: the oracle checks the invariant accesses == computations + hits + refusals.
struct reactive_db { array keys; array vals; array funcs; array deps; array revs; array checked; array dirty; array users; array stack; array reads; array watchers; i64 revision; i64 depth; bool push; array equal; array counts; array hashes; array table; array marks; array onstack; array aux; i64 epoch; i64 top; i64 maxdepth; i64 busy; array errs; array vols; i64 taint; }
rx_default_depth() => 2000;
new_db(bool nd_push, nd_equal) => reactive_db{array{},array{},array{},array{},array{},array{},array{},array{},array{},array{},array{},0,0,nd_push,array{nd_equal},array{0,0,0,0,0},array{},rx_table(16),array{},array{},array{},0,0,rx_default_depth(),0,array{},array{},0};
set_max_depth(mut sd_db, i64 sd_n) { sd_db.maxdepth = sd_n; }
rx_table(rt_n) { rt_t = array{}; for(rt_i : range(rt_n)) rt_t.push(-1); return rt_t; }
rx_hash(str rh_key) {
  rh_h = 5381;
  for(rh_c : range(rh_key.size)) rh_h = ((rh_h * 33) + rh_key[rh_c]) % 1000000007;
  return rh_h;
}
rx_lookup(rx_db, str rx_key, rx_h) {
  rx_cap = rx_db.table.size; rx_j = rx_h % rx_cap;
  while(true) {
    rx_s = rx_db.table[rx_j];
    if(rx_s < 0) return -1;
    if(rx_db.hashes[rx_s] == rx_h) if(rx_db.keys[rx_s] == rx_key) return rx_s;
    rx_j = (rx_j + 1) % rx_cap;
  }
  return -1;
}
rx_find(rx_db, str rx_key) => rx_lookup(rx_db, rx_key, rx_hash(rx_key));
rx_place(mut rp_db, rp_i) {
  rp_cap = rp_db.table.size; rp_j = rp_db.hashes[rp_i] % rp_cap;
  while(rp_db.table[rp_j] >= 0) rp_j = (rp_j + 1) % rp_cap;
  rp_db.table[rp_j] = rp_i;
}
rx_slot(mut rx_db, str rx_key) {
  rx_hh = rx_hash(rx_key); rx_i = rx_lookup(rx_db, rx_key, rx_hh);
  if(rx_i >= 0) return rx_i;
  rx_db.keys.push(rx_key); rx_db.hashes.push(rx_hh); rx_db.vals.push(array{}); rx_db.funcs.push(array{});
  rx_db.deps.push(array{}); rx_db.revs.push(0); rx_db.checked.push(-1);
  rx_db.dirty.push(true); rx_db.users.push(array{}); rx_db.marks.push(0); rx_db.onstack.push(false); rx_db.aux.push(0); rx_db.errs.push(array{}); rx_db.vols.push(false);
  rx_n = rx_db.keys.size - 1;
  if((rx_db.keys.size * 2) > rx_db.table.size) {
    rx_db.table = rx_table(rx_db.table.size * 2);
    for(rx_k : range(rx_db.keys.size)) rx_place(rx_db, rx_k);
  } else rx_place(rx_db, rx_n);
  return rx_n;
}
rx_has(rx_xs, rx_x) { for(rx_y : rx_xs) if(rx_y == rx_x) return true; return false; }
rx_reads(rr_deps, rr_i) { for(rr_d : rr_deps) if(rr_d[0] == rr_i) return true; return false; }
rx_guard(mut rg_db, str rg_what) {
  if(rg_db.top > 0) throw "reactive: change during evaluation: " + rg_what;
  if(rg_db.busy > 0) throw "reactive: change during notification: " + rg_what;
}
rx_unuse(mut un_db, un_d, un_i) {
  un_out = array{}; for(un_u : un_db.users[un_d]) if(un_u != un_i) un_out.push(un_u);
  un_db.users[un_d] = un_out;
}
// Back edges users[d] contains i <=> d in deps[i]: they change only by the difference of the old and the new read-set.
rx_relink(mut rl_db, rl_i, rl_old, rl_new) {
  for(rl_d : rl_old) if(!rx_reads(rl_new, rl_d[0])) rx_unuse(rl_db, rl_d[0], rl_i);
  for(rl_d : rl_new) if(!rx_reads(rl_old, rl_d[0])) rl_db.users[rl_d[0]].push(rl_i);
}
// All transitive users are marked dirty (a breadth-first walk, marks by epochs: O(edges)).
rx_dirty(mut rx_db, rx_i) {
  if(rx_db.users[rx_i].size == 0) { rx_db.dirty[rx_i] = true; return; }
  rx_db.epoch = rx_db.epoch + 1; rx_ep = rx_db.epoch;
  rx_db.dirty[rx_i] = true; rx_db.marks[rx_i] = rx_ep;
  rx_todo = array{rx_i}; rx_pos = 0;
  while(rx_pos < rx_todo.size) {
    rx_at = rx_todo[rx_pos]; rx_pos = rx_pos + 1;
    for(rx_u : rx_db.users[rx_at]) if(rx_db.marks[rx_u] != rx_ep) {
      rx_db.marks[rx_u] = rx_ep; rx_todo.push(rx_u); rx_db.dirty[rx_u] = true;
    }
  }
}
query_define(mut qd_db, str qd_key, qd_fn) {
  rx_guard(qd_db, "query_define " + qd_key);
  qd_i = rx_slot(qd_db,qd_key); qd_db.revision = qd_db.revision + 1;
  qd_old = qd_db.deps[qd_i]; rx_relink(qd_db,qd_i,qd_old,array{}); qd_db.deps[qd_i] = array{};
  qd_db.funcs[qd_i] = array{qd_fn}; qd_db.checked[qd_i] = -1; rx_dirty(qd_db,qd_i);
  if(qd_db.depth == 0) rx_flush(qd_db);
}
rx_enter(mut en_db, en_i) {
  if(en_db.top < en_db.stack.size) { en_db.stack[en_db.top] = en_i; en_db.reads[en_db.top] = array{}; }
  else { en_db.stack.push(en_i); en_db.reads.push(array{}); }
  en_db.top = en_db.top + 1; en_db.onstack[en_i] = true;
}
rx_leave(mut lv_db) { lv_db.top = lv_db.top - 1; lv_db.onstack[lv_db.stack[lv_db.top]] = false; }
// Whether a dependency changed since it was read (without an exception outside): the dependency is computed for the revision,
// an error is the same kind of result as a value (with its own revision; an identical exception is not a change).
// A dependency on the stack (a cycle over old edges) - "changed": a recomputation with a new read-set.
rx_changed(mut ch_db, ch_d) {
  if(ch_db.onstack[ch_d[0]]) return true;
  try { rx_eval(ch_db, ch_d[0]); } catch(ch_e) { }
  return ch_db.revs[ch_d[0]] != ch_d[1];
}
// An exception is the same if the type and the value (text) match: `throw 1` and `throw "1"` are different exceptions.
rx_same_exc(se_a, se_b) { return (typeof(se_a) == typeof(se_b)) && (text(se_a) == text(se_b)); }
// A stored query result: a value or an exception.
rx_result(mut rs_db, rs_i) {
  if(rs_db.errs[rs_i].size > 0) throw rs_db.errs[rs_i][0];
  return rs_db.vals[rs_i][0];
}
// A new revision of a slot's result: strictly greater than the old one (a volatile result may change within the same database revision).
rx_bump(mut bp_db, bp_i) { bp_db.revs[bp_i] = if(bp_db.revision > bp_db.revs[bp_i]) bp_db.revision else (bp_db.revs[bp_i] + 1); }
rx_eval(mut re_db, re_i) {
  if(re_db.funcs[re_i].size == 0) {
    if(re_db.vals[re_i].size == 0) throw "reactive: undefined " + re_db.keys[re_i];
    return re_db.vals[re_i][0];
  }
  re_db.counts[3] = re_db.counts[3] + 1;
  if(re_db.onstack[re_i]) {
    re_db.counts[4] = re_db.counts[4] + 1; re_db.taint = re_db.taint + 1;
    re_path = "reactive cycle: ";
    for(re_s : range(re_db.top)) re_path = re_path + re_db.keys[re_db.stack[re_s]] + " -> ";
    throw re_path + re_db.keys[re_i];
  }
  re_valid = re_db.checked[re_i] >= 0;
  if(re_valid && ((re_db.checked[re_i] == re_db.revision) || (re_db.push && !re_db.dirty[re_i]))) {
    re_db.counts[1] = re_db.counts[1] + 1; return rx_result(re_db,re_i);
  }
  if(re_db.top >= re_db.maxdepth) {
    re_db.counts[4] = re_db.counts[4] + 1; re_db.taint = re_db.taint + 1;
    throw "reactive: глубина вычислений > " + text(re_db.maxdepth);
  }
  re_olddeps = re_db.deps[re_i]; re_t0 = re_db.taint;
  rx_enter(re_db,re_i);
  if(re_valid) for(re_d : re_olddeps) if(rx_changed(re_db,re_d)) { re_valid = false; break; }
  if(!re_valid) {
    re_db.counts[0] = re_db.counts[0] + 1;
    re_fail = false; re_exc = 0; re_value = 0;
    try { re_fn = re_db.funcs[re_i][0]; re_value = re_fn(re_db); } catch(re_error) { re_fail = true; re_exc = re_error; }
    // The read-set (full or partial on an error) is kept: push invalidation will reach a failed query too.
    re_newdeps = re_db.reads[re_db.top - 1];
    rx_relink(re_db,re_i,re_olddeps,re_newdeps);
    re_db.deps[re_i] = re_newdeps;
    re_eq = re_db.equal[0]; re_same = false;
    if(re_fail) {
      if(re_db.errs[re_i].size > 0) re_same = rx_same_exc(re_db.errs[re_i][0],re_exc);
      if(!re_same) { re_db.errs[re_i] = array{re_exc}; re_db.vals[re_i] = array{}; rx_bump(re_db,re_i); }
    } else {
      if(re_db.vals[re_i].size > 0) re_same = re_eq(re_db.vals[re_i][0],re_value);
      if(!re_same) { re_db.vals[re_i] = array{re_value}; re_db.errs[re_i] = array{}; rx_bump(re_db,re_i); }
    }
    if(re_same) re_db.counts[2] = re_db.counts[2] + 1;
  } else re_db.counts[1] = re_db.counts[1] + 1;
  // A volatile result (the computation went through a cycle or a depth refusal) is not cached, but is stored.
  re_db.vols[re_i] = re_db.taint != re_t0;
  if(re_db.vols[re_i]) { re_db.checked[re_i] = -1; re_db.dirty[re_i] = true; }
  else { re_db.checked[re_i] = re_db.revision; re_db.dirty[re_i] = false; }
  rx_leave(re_db);
  return rx_result(re_db,re_i);
}
rx_note(mut nt_db, nt_i, nt_rev) {
  if(nt_db.top == 0) return;
  nt_at = nt_db.top - 1;
  for(nt_d : nt_db.reads[nt_at]) if(nt_d[0] == nt_i) return;
  nt_db.reads[nt_at].push(array{nt_i,nt_rev});
}
get(mut gt_db, str gt_key) {
  // Inside a query a missing key gets a stub: a failed read is also a dependency (on the error's revision).
  gt_i = rx_find(gt_db,gt_key);
  if(gt_i < 0) {
    if(gt_db.top == 0) throw "reactive: undefined " + gt_key;
    gt_i = rx_slot(gt_db,gt_key);
  }
  gt_value = 0;
  try { gt_value = rx_eval(gt_db,gt_i); }
  catch(gt_error) { rx_note(gt_db,gt_i,gt_db.revs[gt_i]); throw gt_error; }
  rx_note(gt_db,gt_i,gt_db.revs[gt_i]);
  return gt_value;
}
set_input(mut si_db, str si_key, si_value) {
  if((si_db.top > 0) || (si_db.busy > 0)) rx_guard(si_db, "set_input " + si_key);
  si_i = rx_slot(si_db,si_key); si_eq = si_db.equal[0];
  if(si_db.funcs[si_i].size > 0) throw "reactive: query is not input";
  if(si_db.vals[si_i].size > 0) if(si_eq(si_db.vals[si_i][0],si_value)) return;
  si_db.revision = si_db.revision + 1; si_db.vals[si_i] = array{si_value};
  si_db.revs[si_i] = si_db.revision; if(si_db.push) rx_dirty(si_db,si_i);
  if((si_db.depth == 0) && (si_db.watchers.size > 0)) rx_flush(si_db);
}
watch(mut wt_db, str wt_key, wt_handler) {
  rx_guard(wt_db, "watch " + wt_key);
  wt_value = get(wt_db,wt_key); wt_db.watchers.push(array{wt_key,wt_handler,wt_value});
}
// Subscription delivery. Order: dependencies before users (topologically over the whole read-set closure),
// among the ready ones - the smaller key. Every handler is called, exceptions are collected (the first after delivery).
rx_flush(mut fl_db) {
  if(fl_db.watchers.size == 0) return;
  fl_res = array{false,""}; fl_db.busy = fl_db.busy + 1;
  try { rx_deliver(fl_db,fl_res); } catch(fl_e) { fl_db.busy = fl_db.busy - 1; throw fl_e; }
  fl_db.busy = fl_db.busy - 1;
  if(fl_res[0]) throw fl_res[1];
}
rx_deliver(mut rf_db, mut rf_res) {
  rf_failed = false; rf_error = "";
  rf_eq = rf_db.equal[0]; rf_roots = array{};
  rf_db.epoch = rf_db.epoch + 1; rf_ep = rf_db.epoch;
  for(rf_w : rf_db.watchers) {
    rf_i = rx_find(rf_db,rf_w[0]);
    try {
      rx_eval(rf_db,rf_i);
      if(!rf_eq(rf_w[2],rf_db.vals[rf_i][0])) if(rf_db.marks[rf_i] != rf_ep) { rf_db.marks[rf_i] = rf_ep; rf_roots.push(rf_i); }
    } catch(rf_e) { if(!rf_failed) { rf_failed = true; rf_error = rf_e; } }
  }
  if(rf_roots.size > 0) {
    // the closure over dependencies (a breadth-first walk); the rf_ep mark means "in the closure"
    rf_cl = array{}; for(rf_r : rf_roots) rf_cl.push(rf_r);
    rf_pos = 0;
    while(rf_pos < rf_cl.size) {
      rf_at = rf_cl[rf_pos]; rf_pos = rf_pos + 1;
      for(rf_d : rf_db.deps[rf_at]) if(rf_db.marks[rf_d[0]] != rf_ep) { rf_db.marks[rf_d[0]] = rf_ep; rf_cl.push(rf_d[0]); }
    }
    for(rf_c : rf_cl) rf_db.aux[rf_c] = rf_db.deps[rf_c].size;
    rf_ready = array{}; rf_sorted = array{};
    for(rf_c : rf_cl) if(rf_db.aux[rf_c] == 0) rf_ready.push(rf_c);
    while(rf_sorted.size < rf_cl.size) {
      if(rf_ready.size == 0) {
        // A cycle of edges (a caught computation cycle gives edges both ways): there is no order, we do not abort delivery -
        // we release the smallest of the remaining keys (deterministically) and continue.
        rf_best = -1;
        for(rf_c : rf_cl) if(rf_db.aux[rf_c] > 0) if((rf_best < 0) || rx_less(rf_db.keys[rf_c],rf_db.keys[rf_best])) rf_best = rf_c;
        rf_db.aux[rf_best] = 0; rf_ready.push(rf_best);
      }
      rf_best = 0;
      for(rf_k : range(rf_ready.size)) if(rx_less(rf_db.keys[rf_ready[rf_k]],rf_db.keys[rf_ready[rf_best]])) rf_best = rf_k;
      rf_p = rf_ready[rf_best];
      rf_rest = array{}; for(rf_k : range(rf_ready.size)) if(rf_k != rf_best) rf_rest.push(rf_ready[rf_k]);
      rf_ready = rf_rest; rf_sorted.push(rf_p); rf_db.aux[rf_p] = -1;
      for(rf_u : rf_db.users[rf_p]) if(rf_db.marks[rf_u] == rf_ep) if(rf_db.aux[rf_u] > 0) {
        rf_db.aux[rf_u] = rf_db.aux[rf_u] - 1;
        if(rf_db.aux[rf_u] == 0) rf_ready.push(rf_u);
      }
    }
    rf_db.epoch = rf_db.epoch + 1; rf_ep2 = rf_db.epoch;
    for(rf_r : rf_roots) rf_db.marks[rf_r] = rf_ep2;
    for(rf_i : rf_sorted) if(rf_db.marks[rf_i] == rf_ep2) for(rf_j : range(rf_db.watchers.size)) if(rf_db.watchers[rf_j][0] == rf_db.keys[rf_i]) {
      rf_w = rf_db.watchers[rf_j]; rf_v = rf_db.vals[rf_i][0];
      if(!rf_eq(rf_w[2],rf_v)) {
        rf_db.watchers[rf_j][2] = rf_v; rf_fn = rf_w[1];
        try { rf_fn(rf_w[0],rf_v); } catch(rf_e) { if(!rf_failed) { rf_failed = true; rf_error = rf_e; } }
      }
    }
  }
  rf_res[0] = rf_failed; rf_res[1] = rf_error;
}
batch(mut bt_db, expr bt_body) {
  rx_guard(bt_db, "batch");
  bt_db.depth = bt_db.depth + 1;
  try { bt_body; } catch(bt_error) { bt_db.depth = bt_db.depth - 1; throw bt_error; }
  bt_db.depth = bt_db.depth - 1; if(bt_db.depth == 0) rx_flush(bt_db);
}
stats(st_db) => array{st_db.counts[0],st_db.counts[1],st_db.counts[2]};
stats_all(st_db) => st_db.counts;
rx_less(rl_a,rl_b) { for(rl_i : range(if(rl_a.size < rl_b.size) rl_a.size else rl_b.size)) { if(rl_a[rl_i] < rl_b[rl_i]) return true; if(rl_a[rl_i] > rl_b[rl_i]) return false; } return rl_a.size < rl_b.size; }

// ---- The reactcheck oracle: random graphs with errors and dynamic dependencies against a naive recomputation ----
// The specification of query n: [kind, a, b, n], references a,b < n (the graph is acyclic). Kinds: 0 sum%1000, 1 minimum, 2 concatenation,
// 3 conditional read (a even -> b, otherwise a), 4 "guard" (throws at a%5==0), 5 catching a read error of a (-> "0"),
// 6 an optional key "opt"+(a%3) (absent -> "0"; catching an undefined key),
// 7 a "mixed-type throw" (at a%4==1 it returns a; otherwise it throws a number or a string with the same text a%2 - the type
// is chosen by (a/4)%2), 8 a typed catch of a read of a (a string -> "2", another exception -> "3").
rx_rand(mut rr_state) { rr_state = ((rr_state * 1664525) + 1013904223) % 2147483647; return rr_state; }
rx_spec(mut sp_seed, sp_n) {
  sp_k = rx_rand(sp_seed) % 9; sp_a = rx_rand(sp_seed) % sp_n; sp_b = rx_rand(sp_seed) % sp_n;
  return array{sp_k,sp_a,sp_b,sp_n};
}
rx_naive(rn_specs, rn_inputs, rn_opts, rn_i, mut rn_count) {
  if(rn_i < rn_inputs.size) return rn_inputs[rn_i];
  rn_count = rn_count + 1; rn_s = rn_specs[rn_i - rn_inputs.size];
  if(rn_s[0] == 5) {
    try { return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count); } catch(rn_e) { return "0"; }
  }
  if(rn_s[0] == 8) {
    try { return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count); } catch(str rn_e) { return "2"; } catch(rn_e) { return "3"; }
  }
  rn_a = rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[1],rn_count);
  if(rn_s[0] == 7) {
    rn_x = parse_int(rn_a).value;
    if((rn_x % 4) == 1) return rn_a;
    if(((rn_x / 4) % 2) == 0) throw rn_x % 2;
    throw text(rn_x % 2);
  }
  if(rn_s[0] == 6) {
    rn_j = parse_int(rn_a).value % 3;
    if((rn_j >= 0) && (rn_j < 3)) if(rn_opts[rn_j] != "") return rn_opts[rn_j];
    return "0";
  }
  if(rn_s[0] == 3) {
    if((parse_int(rn_a).value % 2) == 0) return rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[2],rn_count);
    return rn_a;
  }
  if(rn_s[0] == 4) {
    rn_x = parse_int(rn_a).value;
    if((rn_x % 5) == 0) throw "boom" + text(rn_s[3]);
    return text((rn_x + 1) % 1000);
  }
  rn_b = rx_naive(rn_specs,rn_inputs,rn_opts,rn_s[2],rn_count);
  if(rn_s[0] == 2) return rn_a + rn_b;
  rn_x = parse_int(rn_a).value; rn_y = parse_int(rn_b).value;
  if(rn_s[0] == 1) return text(if(rn_x < rn_y) rn_x else rn_y);
  return text((rn_x + rn_y) % 1000);
}
rx_formula(mut fm_db, fm_s) {
  if(fm_s[0] == 5) {
    try { return get(fm_db,text(fm_s[1])); } catch(fm_e) { return "0"; }
  }
  if(fm_s[0] == 8) {
    try { return get(fm_db,text(fm_s[1])); } catch(str fm_e) { return "2"; } catch(fm_e) { return "3"; }
  }
  fm_a = get(fm_db,text(fm_s[1]));
  if(fm_s[0] == 7) {
    fm_x = parse_int(fm_a).value;
    if((fm_x % 4) == 1) return fm_a;
    if(((fm_x / 4) % 2) == 0) throw fm_x % 2;
    throw text(fm_x % 2);
  }
  if(fm_s[0] == 6) {
    fm_j = parse_int(fm_a).value % 3;
    try { return get(fm_db,"opt" + text(fm_j)); } catch(fm_e) { return "0"; }
  }
  if(fm_s[0] == 3) {
    if((parse_int(fm_a).value % 2) == 0) return get(fm_db,text(fm_s[2]));
    return fm_a;
  }
  if(fm_s[0] == 4) {
    fm_x = parse_int(fm_a).value;
    if((fm_x % 5) == 0) throw "boom" + text(fm_s[3]);
    return text((fm_x + 1) % 1000);
  }
  fm_b = get(fm_db,text(fm_s[2]));
  if(fm_s[0] == 2) return fm_a + fm_b;
  fm_x = parse_int(fm_a).value; fm_y = parse_int(fm_b).value;
  if(fm_s[0] == 1) return text(if(fm_x < fm_y) fm_x else fm_y);
  return text((fm_x + fm_y) % 1000);
}
// df_ex is an independent counter of query function executions (the oracle compares it with stats()[0]).
rx_define(mut df_db, df_key, df_spec, df_ex) {
  df_copy = array{df_spec[0],df_spec[1],df_spec[2],df_spec[3]};
  query_define(df_db,df_key,(mut df_inner) => { df_ex[0] = df_ex[0] + 1; return rx_formula(df_inner,df_copy); });
}
// An exception in the oracle's output has a type: `throw 1` and `throw "1"` are distinguished.
rx_exc_text(xt_e) => text(typeof(xt_e)) + ":" + text(xt_e);
rx_out_naive(rn_specs, rn_inputs, rn_opts, rn_i, mut rn_count) {
  try { return "V" + rx_naive(rn_specs,rn_inputs,rn_opts,rn_i,rn_count); } catch(rn_e) { return "E" + rx_exc_text(rn_e); }
}
rx_out_get(mut og_db, og_key) {
  try { return "V" + text(get(og_db,og_key)); } catch(og_e) { return "E" + rx_exc_text(og_e); }
}
// The structural invariant: users[d] contains i <=> d in deps[i]; the computation stacks are empty.
rx_audit(au_db) {
  au_bad = 0;
  if(au_db.top != 0) au_bad = au_bad + 1;
  for(au_i : range(au_db.keys.size)) {
    if(au_db.onstack[au_i]) au_bad = au_bad + 1;
    for(au_d : au_db.deps[au_i]) if(!rx_has(au_db.users[au_d[0]],au_i)) au_bad = au_bad + 1;
    for(au_u : au_db.users[au_i]) if(!rx_reads(au_db.deps[au_u],au_i)) au_bad = au_bad + 1;
  }
  return au_bad;
}
// Counter consistency: accesses == computations + hits + refusals; computations == the independent count of executions
// of query functions; cutoffs are no more than computations. Returns the number of violations.
rx_audit_stats(as_db, as_ex) {
  as_c = stats_all(as_db); as_bad = 0;
  if(as_c[3] != (as_c[0] + as_c[1] + as_c[4])) as_bad = as_bad + 1;
  if(as_c[0] != as_ex[0]) as_bad = as_bad + 1;
  if(as_c[2] > as_c[0]) as_bad = as_bad + 1;
  return as_bad;
}
rx_apply(mut ap_db, ap_ops, ap_ex) {
  for(ap_o : ap_ops) {
    if(ap_o[0] == 0) set_input(ap_db,text(ap_o[1]),ap_o[2]);
    else if(ap_o[0] == 1) rx_define(ap_db,text(ap_o[1]),ap_o[3],ap_ex);
    else set_input(ap_db,"opt" + text(ap_o[1]),ap_o[2]);
  }
}
rx_watch(mut rw_db, rw_key, rw_handler) { rw_v = get(rw_db,rw_key); watch(rw_db,rw_key,rw_handler); return rw_v; }
rx_try_batch(mut tb_db, tb_ops, tb_ex) { try { batch(tb_db) { rx_apply(tb_db,tb_ops,tb_ex); } } catch(tb_e) { return 1; } return 0; }
react_check_cli(rc_av) {
  rc_seed = 1; rc_steps = 300;
  if(rc_av.size > 0) rc_seed = parse_int(rc_av[0]).value;
  if(rc_av.size > 1) rc_steps = parse_int(rc_av[1]).value;
  rc_push = new_db(true,(a,b) => a == b); rc_pull = new_db(false,(a,b) => a == b);
  rc_inputs = array{}; rc_opts = array{"","",""}; rc_specs = array{}; rc_bad = 0; rc_naive = 0;
  rc_redef = 0; rc_errs = 0; rc_events = array{0}; rc_flusherr = 0;
  rc_last = array{array{"","",""},array{"","",""}}; rc_reg = array{array{false,false,false},array{false,false,false}};
  rc_dups = array{0}; rc_wkeys = array{"9","12","16"}; rc_expush = array{0}; rc_expull = array{0}; rc_statbad = 0;
  for(rc_i : range(5)) {
    rc_v = text(rx_rand(rc_seed) % 20); rc_inputs.push(rc_v);
    set_input(rc_push,text(rc_i),rc_v); set_input(rc_pull,text(rc_i),rc_v);
  }
  for(rc_i : range(12)) {
    rc_s = rx_spec(rc_seed,rc_i + 5); rc_specs.push(rc_s);
    rx_define(rc_push,text(rc_i + 5),rc_s,rc_expush); rx_define(rc_pull,text(rc_i + 5),rc_s,rc_expull);
  }
  for(rc_step : range(rc_steps)) {
    rc_ops = array{};
    for(rc_j : range(3)) {
      rc_r = rx_rand(rc_seed) % 10;
      if(rc_r < 6) {
        rc_at = rx_rand(rc_seed) % 5; rc_v = text(rx_rand(rc_seed) % 20); rc_inputs[rc_at] = rc_v;
        rc_ops.push(array{0,rc_at,rc_v,array{}});
      } else if(rc_r < 8) {
        rc_q = rx_rand(rc_seed) % 12; rc_s = rx_spec(rc_seed,rc_q + 5); rc_specs[rc_q] = rc_s;
        rc_ops.push(array{1,rc_q + 5,"",rc_s}); rc_redef = rc_redef + 1;
      } else {
        rc_at = rx_rand(rc_seed) % 3; rc_v = text(rx_rand(rc_seed) % 20); rc_opts[rc_at] = rc_v;
        rc_ops.push(array{2,rc_at,rc_v,array{}});
      }
    }
    rc_flusherr = rc_flusherr + rx_try_batch(rc_push,rc_ops,rc_expush) + rx_try_batch(rc_pull,rc_ops,rc_expull);
    // Subscriptions on keys 9/12/16: registered when the query does not fail (watch throws on a query error).
    for(rc_w : range(3)) for(rc_d : range(2)) if(!rc_reg[rc_d][rc_w]) {
      rc_wi = rc_w; rc_di = rc_d;
      try {
        if(rc_d == 0) rc_init = rx_watch(rc_push,rc_wkeys[rc_w],(k,v) => { if(rc_last[rc_di][rc_wi] == v) rc_dups[0] = rc_dups[0] + 1; rc_last[rc_di][rc_wi] = v; rc_events[0] = rc_events[0] + 1; });
        else rc_init = rx_watch(rc_pull,rc_wkeys[rc_w],(k,v) => { if(rc_last[rc_di][rc_wi] == v) rc_dups[0] = rc_dups[0] + 1; rc_last[rc_di][rc_wi] = v; rc_events[0] = rc_events[0] + 1; });
        rc_last[rc_d][rc_w] = rc_init; rc_reg[rc_d][rc_w] = true;
      } catch(rc_e) { }
    }
    rc_all = rx_rand(rc_seed) % 2;
    for(rc_i : range(12)) {
      rc_n = if((rc_step % 2) == 0) (rc_i + 5) else (16 - rc_i);
      if((rc_all == 1) || ((rx_rand(rc_seed) % 2) == 0)) {
        rc_expected = rx_out_naive(rc_specs,rc_inputs,rc_opts,rc_n,rc_naive);
        if(rc_expected[0] == 69) rc_errs = rc_errs + 1;
        if(rx_out_get(rc_push,text(rc_n)) != rc_expected) rc_bad = rc_bad + 1;
        if(rx_out_get(rc_pull,text(rc_n)) != rc_expected) rc_bad = rc_bad + 1;
      }
    }
    // Delivery: for a registered subscription the last value is current if the query does not fail.
    for(rc_w : range(3)) {
      rc_expected = rx_out_naive(rc_specs,rc_inputs,rc_opts,parse_int(rc_wkeys[rc_w]).value,rc_naive);
      if(rc_expected[0] == 86) for(rc_d : range(2)) if(rc_reg[rc_d][rc_w]) if("V" + rc_last[rc_d][rc_w] != rc_expected) rc_bad = rc_bad + 1;
    }
    rc_bad = rc_bad + rx_audit(rc_push) + rx_audit(rc_pull);
    rc_statbad = rc_statbad + rx_audit_stats(rc_push,rc_expush) + rx_audit_stats(rc_pull,rc_expull);
  }
  rc_bad = rc_bad + rc_dups[0] + rc_statbad; rc_rand = rc_bad; rc_fixed = rx_cases(); rc_bad = rc_bad + rc_fixed;
  print("reactcheck: шагов=" + text(rc_steps) + " запросов=12 push=" + text(stats(rc_push)[0]) + " pull=" + text(stats(rc_pull)[0]) + " наивно=" + text(rc_naive) + " доля%=" + text((stats(rc_push)[0] * 100) / rc_naive) + " переопределений=" + text(rc_redef) + " ошибок=" + text(rc_errs) + " уведомлений=" + text(rc_events[0]) + " повторных=" + text(rc_dups[0]) + " статистика_нарушений=" + text(rc_statbad) + " попаданий=" + text(stats(rc_push)[1]) + "/" + text(stats(rc_pull)[1]) + " отсечений=" + text(stats(rc_push)[2]) + "/" + text(stats(rc_pull)[2]) + " случайных_нарушений=" + text(rc_rand) + " фиксированных_нарушений=" + text(rc_fixed) + " нарушений=" + text(rc_bad));
  return if(rc_bad == 0) 0 else 1;
}

// ---- Fixed cases (regressions of the RA-2 review and API contracts) ----
rx_expect(mut ex_bad, ex_name, ex_got, ex_want) {
  if(text(ex_got) != text(ex_want)) { ex_bad = ex_bad + 1; print("reactcheck: случай " + ex_name + ": получено " + text(ex_got) + ", ожидалось " + text(ex_want)); }
}
rx_read_opt(mut ro_db, ro_key) { try { return get(ro_db,ro_key); } catch(ro_e) { return 0; } }
rx_chain(mut ch_db, ch_n) {
  set_input(ch_db,"c0",0);
  for(ch_i : range(ch_n)) { ch_k = "c" + text(ch_i); query_define(ch_db,"c" + text(ch_i + 1),(mut d) => get(d,ch_k) + 1); }
}
rx_cases() {
  cs_bad = 0;
  for(cs_push : array{false,true}) {
    cs_m = if(cs_push) "push " else "pull ";
    // B1: the old read-set is not computed after the controlling key changes; redefinition resets the read-set
    cs_db = new_db(cs_push,(a,b) => a == b);
    set_input(cs_db,"switch",0); query_define(cs_db,"bad",(mut d) => 1);
    query_define(cs_db,"q",(mut d) => if(get(d,"switch") == 0) get(d,"bad") else 42);
    rx_expect(cs_bad,cs_m + "dynamic before",get(cs_db,"q"),1);
    query_define(cs_db,"bad",(mut d) => get(d,"bad")); set_input(cs_db,"switch",1);
    rx_expect(cs_bad,cs_m + "dynamic after",rx_out_get(cs_db,"q"),"V42");
    query_define(cs_db,"q",(mut d) => 99);
    rx_expect(cs_bad,cs_m + "redefine const",rx_out_get(cs_db,"q"),"V99");
    // B1: an old branch with a broken query does not throw when the branch is no longer read
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"m",0); set_input(cs_db,"x",1);
    query_define(cs_db,"w",(mut d) => if(get(d,"m") == 0) 100 / get(d,"x") else -1);
    rx_expect(cs_bad,cs_m + "guarded before",rx_out_get(cs_db,"w"),"V100");
    set_input(cs_db,"x",0); set_input(cs_db,"m",1);
    rx_expect(cs_bad,cs_m + "guarded after",rx_out_get(cs_db,"w"),"V-1");
    // B2: a caught failure of a child is a dependency; an undefined key appeared
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"fail",1);
    query_define(cs_db,"child",(mut d) => if(get(d,"fail") == 1) throw "failed" else 7);
    query_define(cs_db,"parent",(mut d) => rx_read_opt(d,"child") - 1);
    rx_expect(cs_bad,cs_m + "caught child before",get(cs_db,"parent"),-1);
    set_input(cs_db,"fail",0); rx_expect(cs_bad,cs_m + "caught child after",get(cs_db,"parent"),6);
    set_input(cs_db,"fail",1); rx_expect(cs_bad,cs_m + "caught child again",get(cs_db,"parent"),-1);
    cs_db = new_db(cs_push,(a,b) => a == b); query_define(cs_db,"o",(mut d) => rx_read_opt(d,"missing"));
    rx_expect(cs_bad,cs_m + "missing before",get(cs_db,"o"),0);
    set_input(cs_db,"missing",7); rx_expect(cs_bad,cs_m + "missing after",get(cs_db,"o"),7);
    query_define(cs_db,"missing2",(mut d) => 5); query_define(cs_db,"o2",(mut d) => rx_read_opt(d,"missing2"));
    rx_expect(cs_bad,cs_m + "query defines missing",get(cs_db,"o2"),5);
    // M1: redefinition 1 -> 2, the dependents see it
    cs_db = new_db(cs_push,(a,b) => a == b); query_define(cs_db,"f",(mut d) => 1); query_define(cs_db,"g",(mut d) => get(d,"f") * 10);
    rx_expect(cs_bad,cs_m + "redef before",get(cs_db,"g"),10);
    query_define(cs_db,"f",(mut d) => 2); rx_expect(cs_bad,cs_m + "redef after",get(cs_db,"g"),20);
    query_define(cs_db,"f",(mut d) => 2); cs_ev = stats(cs_db)[0]; rx_expect(cs_bad,cs_m + "redef same",get(cs_db,"g"),20);
    rx_expect(cs_bad,cs_m + "redef same cutoff",stats(cs_db)[0] - cs_ev,1);
    // cycles: direct, indirect, one that arose after a redefinition; recovery
    cs_db = new_db(cs_push,(a,b) => a == b);
    query_define(cs_db,"a",(mut d) => get(d,"b")); query_define(cs_db,"b",(mut d) => get(d,"a"));
    rx_expect(cs_bad,cs_m + "cycle",rx_out_get(cs_db,"a"),"Estr:reactive cycle: a -> b -> a");
    query_define(cs_db,"b",(mut d) => 3); rx_expect(cs_bad,cs_m + "cycle fixed",rx_out_get(cs_db,"a"),"V3");
    rx_expect(cs_bad,cs_m + "audit cycle",rx_audit(cs_db),0);
    // batch: a body exception keeps the changes without notifications; delivery at the next flush
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => cs_ev.push(text(v)));
    try { batch(cs_db) { set_input(cs_db,"x",1); throw "body"; } } catch(cs_e) { }
    rx_expect(cs_bad,cs_m + "batch exc no notify",text(cs_ev),"[]"); rx_expect(cs_bad,cs_m + "batch exc kept",get(cs_db,"x"),1);
    set_input(cs_db,"x",2); rx_expect(cs_bad,cs_m + "batch exc delivered",text(cs_ev),"[2]");
    // M2: a handler exception does not interrupt delivery; the first is after delivery; it is not delivered again
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); set_input(cs_db,"y",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => { cs_ev.push("h1=" + text(v)); throw "handler1"; });
    watch(cs_db,"x",(k,v) => cs_ev.push("h2=" + text(v)));
    watch(cs_db,"y",(k,v) => { cs_ev.push("h3=" + text(v)); throw "handler3"; });
    cs_got = "";
    try { batch(cs_db) { set_input(cs_db,"x",1); set_input(cs_db,"y",1); } } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc first",cs_got,"handler1");
    rx_expect(cs_bad,cs_m + "handler exc all delivered",text(cs_ev),"[h1=1, h2=1, h3=1]");
    cs_got = ""; try { set_input(cs_db,"x",1); } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc no redelivery",text(cs_ev) + cs_got,"[h1=1, h2=1, h3=1]");
    batch(cs_db) { } rx_expect(cs_bad,cs_m + "handler exc empty batch",text(cs_ev),"[h1=1, h2=1, h3=1]");
    try { set_input(cs_db,"x",2); } catch(cs_e) { cs_got = text(cs_e); }
    rx_expect(cs_bad,cs_m + "handler exc next",text(cs_ev),"[h1=1, h2=1, h3=1, h1=2, h2=2]");
    rx_expect(cs_bad,cs_m + "handler exc state",rx_audit(cs_db) + cs_db.busy + cs_db.depth,0);
    // a database change from a handler and from a query is an explicit refusal
    cs_db = new_db(cs_push,(a,b) => a == b); set_input(cs_db,"x",0); set_input(cs_db,"y",0); cs_ev = array{};
    watch(cs_db,"x",(k,v) => set_input(cs_db,"y",5));
    try { set_input(cs_db,"x",1); } catch(cs_e) { cs_ev.push(text(cs_e)); }
    rx_expect(cs_bad,cs_m + "mutation in handler",text(cs_ev),"[reactive: change during notification: set_input y]");
    rx_expect(cs_bad,cs_m + "mutation in handler kept",get(cs_db,"y"),0);
    query_define(cs_db,"mutq",(mut d) => { set_input(d,"y",9); return 1; });
    rx_expect(cs_bad,cs_m + "mutation in query",rx_out_get(cs_db,"mutq"),"Estr:reactive: change during evaluation: set_input y");
    rx_expect(cs_bad,cs_m + "mutation in query state",rx_audit(cs_db),0);
    // depth: a chain of 120 at a limit of 50 - an explicit error, the database is intact; 40 - works; the limit raised - works
    cs_db = new_db(cs_push,(a,b) => a == b); set_max_depth(cs_db,50); rx_chain(cs_db,120);
    rx_expect(cs_bad,cs_m + "depth limit",rx_out_get(cs_db,"c120"),"Estr:reactive: глубина вычислений > 50");
    rx_expect(cs_bad,cs_m + "depth state",rx_audit(cs_db),0);
    rx_expect(cs_bad,cs_m + "depth below limit",rx_out_get(cs_db,"c40"),"V40");
    set_max_depth(cs_db,500); rx_expect(cs_bad,cs_m + "depth raised",rx_out_get(cs_db,"c120"),"V120");
    set_input(cs_db,"c0",5); rx_expect(cs_bad,cs_m + "depth update",rx_out_get(cs_db,"c120"),"V125");
    // keys with common prefixes and the growth of the hash table
    cs_db = new_db(cs_push,(a,b) => a == b);
    for(cs_i : range(200)) set_input(cs_db,"k" + text(cs_i),cs_i);
    cs_sum = 0; for(cs_i : range(200)) cs_sum = cs_sum + get(cs_db,"k" + text(cs_i));
    rx_expect(cs_bad,cs_m + "many keys",cs_sum,19900);
    rx_expect(cs_bad,cs_m + "absent key",rx_out_get(cs_db,"k200"),"Estr:reactive: undefined k200");
  }
  // push counters: early cutoff and dynamic dependencies (push only, exact numbers)
  cs_db = new_db(true,(a,b) => a == b);
  set_input(cs_db,"x",2); set_input(cs_db,"y",9);
  query_define(cs_db,"q",(mut d) => get(d,"x") % 2);
  query_define(cs_db,"r",(mut d) => get(d,"q") + 10);
  get(cs_db,"r"); cs_before = stats(cs_db)[0]; set_input(cs_db,"x",4); get(cs_db,"r");
  rx_expect(cs_bad,"cutoff evals",stats(cs_db)[0] - cs_before,1);
  query_define(cs_db,"dyn",(mut d) => if(get(d,"q") == 0) get(d,"y") else get(d,"x"));
  get(cs_db,"dyn"); set_input(cs_db,"x",3); get(cs_db,"dyn");
  rx_expect(cs_bad,"dyn detached",rx_has(cs_db.users[rx_find(cs_db,"y")],rx_find(cs_db,"dyn")),false);
  cs_before = stats(cs_db)[0]; set_input(cs_db,"y",8); get(cs_db,"dyn");
  rx_expect(cs_bad,"dyn no recompute",stats(cs_db)[0] - cs_before,0);
  cs_events = array{};
  watch(cs_db,"r",(k,v) => cs_events.push(k)); watch(cs_db,"q",(k,v) => cs_events.push(k));
  batch(cs_db) { set_input(cs_db,"x",6); set_input(cs_db,"x",8); }
  rx_expect(cs_bad,"watch order",text(cs_events),"[q, r]");
  batch(cs_db) { set_input(cs_db,"y",1); set_input(cs_db,"x",10); }
  rx_expect(cs_bad,"watch once",cs_events.size,2);
  return cs_bad + rx_cases_err();
}

// ---- Fixed cases of the second review cycle: the exception type, a cycle and delivery, the error cache, depth ----
rx_cases_err() {
  ce_bad = 0;
  for(ce_push : array{false,true}) {
    ce_m = if(ce_push) "push " else "pull ";
    // B1: a change of the exception type with the same text (`throw 1` -> `throw "1"`) recomputes the typed catch and its consumer
    ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",0);
    query_define(ce_db,"child",(mut d) => { if(get(d,"x") == 0) throw 1; throw "1"; });
    query_define(ce_db,"parent",(mut d) => { try { return get(d,"child"); } catch(str e) { return 20; } catch(e) { return 10; } });
    query_define(ce_db,"grand",(mut d) => get(d,"parent") + 100);
    rx_expect(ce_bad,ce_m + "typed catch before",get(ce_db,"grand"),110);
    rx_expect(ce_bad,ce_m + "typed uncaught before",rx_out_get(ce_db,"child"),"Ei64:1");
    set_input(ce_db,"x",1);
    rx_expect(ce_bad,ce_m + "typed catch after",get(ce_db,"grand"),120);
    rx_expect(ce_bad,ce_m + "typed uncaught after",rx_out_get(ce_db,"child"),"Estr:1");
    set_input(ce_db,"x",0); rx_expect(ce_bad,ce_m + "typed catch back",get(ce_db,"grand"),110);
    rx_expect(ce_bad,ce_m + "typed audit",rx_audit(ce_db),0);
    // B2: a caught cycle does not block delivery (including to an independent subscriber) and does not break the state
    ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",1); set_input(ce_db,"y",0); ce_ev = array{};
    query_define(ce_db,"a",(mut d) => { ce_x = get(d,"x"); try { return get(d,"b"); } catch(e) { return ce_x; } });
    query_define(ce_db,"b",(mut d) => get(d,"a"));
    watch(ce_db,"y",(k,v) => ce_ev.push("y=" + text(v))); watch(ce_db,"a",(k,v) => ce_ev.push("a=" + text(v)));
    rx_expect(ce_bad,ce_m + "caught cycle a",get(ce_db,"a"),1); rx_expect(ce_bad,ce_m + "caught cycle b",get(ce_db,"b"),1);
    ce_got = "";
    try { batch(ce_db) { set_input(ce_db,"x",2); set_input(ce_db,"y",2); } } catch(ce_e) { ce_got = text(ce_e); }
    rx_expect(ce_bad,ce_m + "caught cycle no error",ce_got,"");
    rx_expect(ce_bad,ce_m + "caught cycle both delivered",rx_has(ce_ev,"y=2") && rx_has(ce_ev,"a=2") && (ce_ev.size == 2),true);
    rx_expect(ce_bad,ce_m + "caught cycle value",get(ce_db,"a"),2);
    set_input(ce_db,"y",3); rx_expect(ce_bad,ce_m + "caught cycle independent",rx_has(ce_ev,"y=3"),true);
    set_input(ce_db,"x",5); rx_expect(ce_bad,ce_m + "caught cycle again",rx_has(ce_ev,"a=5"),true);
    rx_expect(ce_bad,ce_m + "caught cycle state",rx_audit(ce_db) + ce_db.busy + ce_db.depth + ce_db.top,0);
    // V1: a failed diamond of depth 20 is counted linearly: 1 + 3*20 executions, a repeated read comes from the cache
    ce_ex = array{0}; ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"s",0);
    query_define(ce_db,"r0",(mut d) => { ce_ex[0] = ce_ex[0] + 1; throw "boom" + text(get(d,"s") % 2); });
    for(ce_i : range(20)) {
      ce_p = "r" + text(ce_i); ce_l = "l" + text(ce_i + 1); ce_r = "m" + text(ce_i + 1);
      query_define(ce_db,ce_l,(mut d) => { ce_ex[0] = ce_ex[0] + 1; return get(d,ce_p); });
      query_define(ce_db,ce_r,(mut d) => { ce_ex[0] = ce_ex[0] + 1; return get(d,ce_p); });
      query_define(ce_db,"r" + text(ce_i + 1),(mut d) => { ce_ex[0] = ce_ex[0] + 1; try { get(d,ce_l); } catch(e) { } return get(d,ce_r); });
    }
    rx_expect(ce_bad,ce_m + "error diamond",rx_out_get(ce_db,"r20"),"Estr:boom0");
    rx_expect(ce_bad,ce_m + "error diamond execs",ce_ex[0],61);
    rx_expect(ce_bad,ce_m + "error diamond stats",stats(ce_db)[0],61);
    rx_out_get(ce_db,"r20"); rx_expect(ce_bad,ce_m + "error cached",ce_ex[0],61);
    set_input(ce_db,"s",2); rx_out_get(ce_db,"r20");
    rx_expect(ce_bad,ce_m + "error early cutoff",ce_ex[0],62);
    set_input(ce_db,"s",1);
    rx_expect(ce_bad,ce_m + "error changed",rx_out_get(ce_db,"r20"),"Estr:boom1");
    rx_expect(ce_bad,ce_m + "error changed execs",ce_ex[0],62 + 61);
    rx_expect(ce_bad,ce_m + "error diamond audit",rx_audit(ce_db),0);
    // an error is cached: the consumer is not recomputed while the child's exception is the same
    ce_ex = array{0,0}; ce_db = new_db(ce_push,(a,b) => a == b); set_input(ce_db,"x",0);
    query_define(ce_db,"child",(mut d) => { ce_ex[0] = ce_ex[0] + 1; get(d,"x"); throw "same"; });
    query_define(ce_db,"parent",(mut d) => { ce_ex[1] = ce_ex[1] + 1; try { get(d,"child"); } catch(e) { return text(e); } return ""; });
    rx_expect(ce_bad,ce_m + "error consumer",get(ce_db,"parent"),"same"); get(ce_db,"parent");
    rx_expect(ce_bad,ce_m + "error consumer cached",text(ce_ex),"[1, 1]");
    set_input(ce_db,"x",1); rx_expect(ce_bad,ce_m + "error consumer cutoff",get(ce_db,"parent"),"same");
    rx_expect(ce_bad,ce_m + "error consumer cutoff execs",text(ce_ex),"[2, 1]");
    // V2: a caught depth error depends on the limit: raising the limit is visible at once, without bypassing the cache
    ce_db = new_db(ce_push,(a,b) => a == b); rx_chain(ce_db,10);
    query_define(ce_db,"p",(mut d) => { try { return get(d,"c10"); } catch(e) { return -1; } });
    set_max_depth(ce_db,5); rx_expect(ce_bad,ce_m + "depth caught low",get(ce_db,"p"),-1);
    set_max_depth(ce_db,20); rx_expect(ce_bad,ce_m + "depth caught raised",get(ce_db,"p"),10);
    set_input(ce_db,"c0",5); rx_expect(ce_bad,ce_m + "depth caught update",get(ce_db,"p"),15);
    rx_expect(ce_bad,ce_m + "depth caught audit",rx_audit(ce_db),0);
  }
  return ce_bad;
}
