module prelude;

// Конструкции, написанные на языке поверх ядра (спека §3.2): в ядре — if,
// loop/break/continue, throw, intercept. 
//  
// 
// 
//.

// Операторы — сущности языка (§4.4): 
// Объявление повторяет запись:
// параметры — на стороне своих веток. Приоритетов нет — цепочку с несколькими
// деревьями разбирают типы (
// там же); [[associative]] — инвариант из
// логики: a + b + c — одно дерево. Тело из одного встроенного примитива —
// операция VM (интерпретатор и машинный код исполняют её напрямую).
[[associative]] operator (a) + (b) => add(a, b);
operator (a) - (b) => sub(a, b);
[[associative]] operator (a) * (b) => mul(a, b);
operator (a) / (b) => div(a, b);
operator (a) % (b) => rem(a, b);
operator (a) == (b) => eq(a, b);
operator (a) != (b) => ne(a, b);
operator (a) < (b) => lt(a, b);
operator (a) > (b) => gt(a, b);
operator (a) <= (b) => le(a, b);
operator (a) >= (b) => ge(a, b);
[[associative]] operator (bool a) && (expr bool b) => and(a, b);
[[associative]] operator (bool a) || (expr bool b) => or(a, b);
operator -(a) => neg(a);
operator !(bool a) => not(a);
// x? — try(x) вызывающего: «расто-макака try» без макроса;
// кадр оператора прозрачен для return(caller) — выход из того, кто написал x?.
operator (expr e)? => try(e);

// while(c) тело — условие вычисляется на каждой итерации (expr).
while(expr c, expr body) {
  loop {
    if(!c) break;
    body;
  }
}

// for(x : xs) тело — по массиву или range. Индекс становится безопасным
// после проверки is_index: 
// 
// Шаг — до тела:
// continue в теле не пропускает его.
for(xs, expr body) {
  i = 0;
  loop {
    if(!is_index(i, xs)) break;
    k = i;
    i = i + 1;
    body(xs[k]);
  }
}

// try { … } catch(E e) { … } … — 
// 
// catch.
// intercept выбирает первый блок, чей параметр принимает брошенное значение.
try(expr body) catch(expr... handlers) => intercept(body, handlers);

// push(xs, x) — рост массива: буфер может переехать, ссылки на элементы
// недействительны (
//). Семантика — атрибутом библиотеки.
[[invalidates(xs)]] push(mut xs, x) => append(xs, x);

// checked { … } — контекст: арифметика i64 с проверкой переполнения для всего,
// что выполняется внутри блока, включая вызванные функции (их экземпляры —
// свои для контекста): 
//.
checked(expr body) {
  using operator (i64 a) + (i64 b) => add_checked(a, b);
  using operator (i64 a) - (i64 b) => sub_checked(a, b);
  using operator (i64 a) * (i64 b) => mul_checked(a, b);
  body
}

// Файберы и потоки (§8.3): spawn { … } — стековая корутина; поток — блокирующие
// write/read: 
// Значение уходит в поток перемещением (own).
spawn(expr body) => fiber_start(body);
stream() => stream_new(16);
stream(i64 cap) => stream_new(cap);
write(stream s, own x) => stream_write(s, x);
read(stream s) => stream_read(s);
more(stream s) => stream_more(s);
close(stream s) => stream_close(s);
for(stream s, expr body) {
  loop {
    if(!more(s)) break;
    body(read(s));
  }
}

// Сеть (M3b):
// listen — один поток событий по всем
// соединениям: event{peer, kind: "open" | "data" | "close", data}; send — в
// исходящий поток, без ожидания; connect — такой же поток для одного peer (0).
struct event { i64 peer; str kind; str data; }
listen(i64 p) => net_listen(p);
connect(str host, i64 p) => net_connect(host, p);
port(stream n) => net_port(n);
send(stream n, i64 peer, str data) => net_send(n, peer, data);
send(stream n, str data) => net_send(n, 0, data);
drop(stream n, i64 peer) => net_drop(n, peer);

// Файлы: open — поток кусков (чтение заявками io_uring), create — запись.
open(str path) => file_open(path);
create(str path) => file_create(path);

// Процессы VM (M3c): process(f, аргументы…) — изолированный процесс, между
// процессами — только данные перемещением. wait — дождаться; false — процесс
// упал (остальные живут), error — его сообщение.
wait(process p) => process_wait(p);
error(process p) => process_error(p);

// Форматирование — не строка формата: 
//;
// 
// 
//.
// fmt"x = {x}, адрес {hex(8)}{p}" — части шаблона: текст, значение, текст, …;
// форматтер (наследник formatter) настраивает следующее значение; свой формат —
// своя перегрузка format_with(форматтер, значение).
struct formatter {}
struct plain : formatter {}
struct hex : formatter { i64 width; }
struct fixed : formatter { i64 digits; }
hex(i64 w) => hex{w};
fixed(i64 d) => fixed{d};
format_with(plain f, x) => text(x);
// Примитивы — на C++ в теле функции: 
// 
// native "cpp" { … } собран в VM (tz native,
// build.sh); #x — параметр значением VM. Неизвестный при разборе аргумент —
// стёртое значение результата (как у встроенных).
text_hex(i64 n, i64 width) => native "cpp" {
  if(!#n.known() || !#width.known()) return erase(value(std::string("x")));
  char buf[32];
  snprintf(buf, sizeof buf, "%0*llx", int(#width.as<int64_t>()), static_cast<unsigned long long>(#n.as<int64_t>()));
  return value(std::string(buf));
};

text_fixed(f64 x, i64 digits) => native "cpp" {
  if(!#x.known() || !#digits.known()) return erase(value(std::string("x")));
  char buf[64];
  snprintf(buf, sizeof buf, "%.*f", int(#digits.as<int64_t>()), #x.as<double>());
  return value(std::string(buf));
};

format_with(hex h, i64 x) => text_hex(x, h.width);
format_with(fixed d, f64 x) => text_fixed(x, d.digits);

fmt(...parts) {
  out = "";
  f = plain{};
  i = 0;
  for(p : parts) {
    if((i % 2) == 0) out = out + p; // текст шаблона
    else if(formatter{} = p) f = p; // форматтер — для следующего значения
    else {
      out = out + format_with(f, p);
      f = plain{};
    }
    i = i + 1;
  }
  out
}

// parse_int(s) — result{ok, value, error}: цифры без знака.
parse_int(str s) => native "cpp" {
  auto make = [&](bool good, int64_t v, std::string err) {
    agg_v r{vm.types.named("result"), {}};
    r.fields.push_back({vm.sym("ok"), value(good)});
    r.fields.push_back({vm.sym("value"), value(v)});
    r.fields.push_back({vm.sym("error"), value(std::move(err))});
    return value(std::move(r));
  };
  if(!#s.known()) return erase(make(true, 0, ""));
  auto const & text = #s.as<std::string>();
  int64_t v = 0;
  bool good = !text.empty();
  for(char ch: text) {
    if(ch < '0' || ch > '9') {
      good = false;
      break;
    }
    v = v * 10 + (ch - '0');
  }
  return make(good, good ? v : 0, good ? "" : cat("не число: ", in_quotes(text)));
};

// text(x) — текст значения (байты): число — десятичная запись.
text(x) => native "cpp" {
  if(!#x.known()) return erase(value(std::string("x")));
  return value(#x.is<std::string>() ? #x.as<std::string>() : vm.show_v(#x));
};

// fill(n, x) — массив из n копий x.
fill(i64 n, x) => native "cpp" {
  if(!#n.known() || !#x.known()) return erase(value(array_v::of({#x.known() ? #x : *shape_of(#x)})));
  array_v r;
  for(int64_t i = 0; i < #n.as<int64_t>(); ++i) r.push(#x);
  return value(std::move(r));
};

is_err(result r) => !r.ok;
