module prelude;

// Конструкции, написанные на языке поверх ядра (спека §3.2): в ядре — if,
// loop/break/continue, throw, intercept. 
//  
// 
// 
//.

// Операторы — сущности языка (§4.4): 
// Объявление повторяет запись:
// параметры — на стороне своих веток. Приоритетов нет — цепочку с несколькими
// деревьями разбирают типы (
// там же); [[associative]] — инвариант из
// логики: a + b + c — одно дерево. Тело из одного встроенного примитива —
// операция VM (интерпретатор и машинный код исполняют её напрямую).
[[associative]] operator (a) + (b) => add(a, b);
operator (a) - (b) => sub(a, b);
[[associative]] operator (a) * (b) => mul(a, b);
operator (a) / (b) => div(a, b);
operator (a) % (b) => rem(a, b);
operator (a) == (b) => eq(a, b);
operator (a) != (b) => ne(a, b);
operator (a) < (b) => lt(a, b);
operator (a) > (b) => gt(a, b);
operator (a) <= (b) => le(a, b);
operator (a) >= (b) => ge(a, b);
[[associative]] operator (bool a) && (expr bool b) => and(a, b);
[[associative]] operator (bool a) || (expr bool b) => or(a, b);
operator -(a) => neg(a);
// биты i64 — для кодирования инструкций на языке (§10.4)
[[associative]] operator (i64 a) & (i64 b) => band(a, b);
[[associative]] operator (i64 a) | (i64 b) => bor(a, b);
[[associative]] operator (i64 a) ^ (i64 b) => bxor(a, b);
operator (i64 a) << (i64 b) => shl(a, b);
operator (i64 a) >> (i64 b) => shr(a, b);
operator !(bool a) => not(a);
// a[i] — парный оператор: 
// перегрузка своим типам — 
// Место (a[i] = v) — форма ядра.
operator (a)[i] => index(a, i);
// x? — try(x) вызывающего: «расто-макака try» без макроса;
// кадр оператора прозрачен для return(caller) — выход из того, кто написал x?.
operator (expr e)? => try(e);

// while(c) тело — условие вычисляется на каждой итерации (expr).
while(expr c, expr body) {
  loop {
    if(!c) break;
    body;
  }
}

// for(x : xs) тело — по массиву или range. Индекс становится безопасным
// после проверки is_index: 
// 
// Шаг — до тела:
// continue в теле не пропускает его.
for(xs, expr body) {
  i = 0;
  loop {
    if(!is_index(i, xs)) break;
    k = i;
    i = i + 1;
    body(xs[k]);
  }
}

// try { … } catch(E e) { … } … — 
// 
// catch.
// intercept выбирает первый блок, чей параметр принимает брошенное значение.
try(expr body) catch(expr... handlers) => intercept(body, handlers);

// push(xs, x) — рост массива: буфер может переехать, ссылки на элементы
// недействительны (
//). Семантика — атрибутом библиотеки.
[[invalidates(xs)]] push(mut xs, x) => append(xs, x);

// checked { … } — контекст: арифметика i64 с проверкой переполнения для всего,
// что выполняется внутри блока, включая вызванные функции (их экземпляры —
// свои для контекста): 
//.
checked(expr body) {
  using operator (i64 a) + (i64 b) => add_checked(a, b);
  using operator (i64 a) - (i64 b) => sub_checked(a, b);
  using operator (i64 a) * (i64 b) => mul_checked(a, b);
  body
}

// Кодогенерация — контекст цели (§10.4): 
// 
// 
// 
// В контексте цели операция — её машинный код (байты) над
// регистровой моделью JIT: первый операнд — аккумулятор, второй — регистр
// второго операнда, результат — в аккумуляторе. JIT берёт кодогенератор из базы;
// нет его здесь — встроенный (C++, бутстрап).
// Кодирование на языке. x86-64: REX.W, код операции, ModRM «регистр, регистр»
// (reg — src, r/m — dst); с префиксом 0F — reg — dst. AArch64: слово
// младшим байтом вперёд. Номера регистров —
// кодировка цели; их даёт JIT (первый операнд — аккумулятор, второй — регистр
// второго операнда). *Моё:* регистры параметрами кодогенератора.
x64_rr(i64 op, i64 dst, i64 src) => array{0x48 | ((src >> 3) << 2) | (dst >> 3), op, 0xC0 | ((src & 7) << 3) | (dst & 7)};

x64_0f(i64 op, i64 dst, i64 src) => array{0x48 | ((dst >> 3) << 2) | (src >> 3), 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)};

// сдвиг на cl: второй операнд — rcx (регистровая модель JIT)
x64_shift(i64 ext, i64 dst) => array{0x48 | (dst >> 3), 0xD3, 0xC0 | (ext << 3) | (dst & 7)};

// сравнение → 0/1 в a: cmp a, b; setcc; movzx (cc — условие x86: e 4, ne 5, l C, ge D, le E, g F)
x64_cmp(i64 cc, i64 a, i64 b) => array{...x64_rr(0x39, a, b), 0xF, 0x90 | cc, 0xC0 | a, ...x64_0f(0xB6, a, a)};

// SSE «регистр, регистр» над xmm: префикс, [REX], 0F, код операции, ModRM (reg — dst)
x64_sse(i64 prefix, i64 op, i64 dst, i64 src) => if((dst | src) > 7) array{prefix, 0x40 | ((dst >> 3) << 2) | (src >> 3), 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)} else array{prefix, 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)};

x64_rel32(i64 off) => array{off & 0xFF, (off >> 8) & 0xFF, (off >> 16) & 0xFF, (off >> 24) & 0xFF};

// Память x86-64: [база + disp32] (mod 10; rsp/r12 — через SIB 0x24); REX — только
// если не пустой (как у ассемблера).
x64_rex(i64 w, i64 r, i64 x, i64 b) => {
  v = 0x40 | (w << 3) | ((r >> 3) << 2) | ((x >> 3) << 1) | (b >> 3);
  if(v == 0x40) array{} else array{v}
};

x64_mem(i64 r, i64 base, i64 disp) => array{0x80 | ((r & 7) << 3) | (base & 7), ...(if((base & 7) == 4) array{0x24} else array{}), ...x64_rel32(disp)};

x64_rm(i64 op, i64 r, i64 base, i64 disp) => array{...x64_rex(1, r, 0, base), op, ...x64_mem(r, base, disp)};

x64_sse_rm(i64 prefix, i64 op, i64 r, i64 base, i64 disp) => array{prefix, ...x64_rex(0, r, 0, base), 0xF, op, ...x64_mem(r, base, disp)};

x64_u64(i64 v) => array{v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF, (v >> 32) & 0xFF, (v >> 40) & 0xFF, (v >> 48) & 0xFF, (v >> 56) & 0xFF};

// [база + индекс * 8]: ModRM 00 r 100 + SIB 11 индекс база; база rbp/r13 — через
// disp8 = 0 (mod 01)
x64_sib(i64 r, i64 base, i64 index) => if((base & 7) == 5) array{0x44 | ((r & 7) << 3), 0xC0 | ((index & 7) << 3) | (base & 7), 0x0} else array{0x4 | ((r & 7) << 3), 0xC0 | ((index & 7) << 3) | (base & 7)};

// сравнения f64 (ucomisd): с NaN всё, кроме !=, ложно; результат — 0/1 в acc
x64_set(i64 cc, i64 r) => array{0xF, 0x90 | cc, 0xC0 | r};

x64_fcmp(i64 cc, i64 a, i64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(cc, acc), ...x64_0f(0xB6, acc, acc)};

// / и % с ловушкой (fault — смещение от начала этих байтов до ловушки деления на
// ноль): test b, b; je fault; cmp b, -1; jne обычное; (neg a | xor a, a); jmp
// конец; обычное: cqo; idiv b; [mov a, rdx]; конец. INT_MIN / -1 — модульно, без
// падения idiv. a — rax (cqo/idiv), rem — 1 для остатка.
x64_divmod(i64 a, i64 b, i64 fault, i64 rem) => array{...x64_rr(0x85, b, b), 0xF, 0x84, ...x64_rel32(fault - 9), 0x48 | (b >> 3), 0x83, 0xF8 | (b & 7), 0xFF, 0x75, 0x5, ...(if(rem == 1) x64_rr(0x31, a, a) else array{0x48 | (a >> 3), 0xF7, 0xD8 | (a & 7)}), 0xEB, 5 + (3 * rem), 0x48, 0x99, 0x48 | (b >> 3), 0xF7, 0xF8 | (b & 7), ...(if(rem == 1) x64_rr(0x89, a, 2) else array{})};

a64_word(i64 w) => array{w & 0xFF, (w >> 8) & 0xFF, (w >> 16) & 0xFF, (w >> 24) & 0xFF};

a64_rrr(i64 op, i64 d, i64 n, i64 m) => a64_word(op | (m << 16) | (n << 5) | d);

// Память AArch64: смещение -256..255 — ldur/stur, иначе — через x16 (movz/movk) и
// регистровое смещение; от sp слоты по 16 байт — смещение вдвое (как у ассемблера).
a64_imm64(i64 d, i64 v) => array{...a64_word(0xD2800000 | ((v & 0xFFFF) << 5) | d), ...(if(((v >> 16) & 0xFFFF) != 0) a64_word(0xF2A00000 | (((v >> 16) & 0xFFFF) << 5) | d) else array{}), ...(if(((v >> 32) & 0xFFFF) != 0) a64_word(0xF2C00000 | (((v >> 32) & 0xFFFF) << 5) | d) else array{}), ...(if(((v >> 48) & 0xFFFF) != 0) a64_word(0xF2E00000 | (((v >> 48) & 0xFFFF) << 5) | d) else array{})};

a64_mem(i64 unscaled, i64 regoff, i64 t, i64 base, i64 disp) => if((disp >= -256) && (disp <= 255)) a64_word(unscaled | ((disp & 0x1FF) << 12) | (base << 5) | t) else array{...a64_imm64(16, disp), ...a64_word(regoff | (16 << 16) | (base << 5) | t)};

a64_add_imm(i64 d, i64 s, i64 v) => if((v >= 0) && (v < 4096)) a64_word(0x91000000 | (v << 10) | (s << 5) | d) else if((v < 0) && (v > -4096)) a64_word(0xD1000000 | ((0 - v) << 10) | (s << 5) | d) else array{...a64_imm64(16, v), ...a64_word(0x8B206000 | (16 << 16) | (s << 5) | d)};

// fcmp a, b; cset acc (условие AArch64: gt C, ge A; вещественные флаги)
a64_cset(i64 cc, i64 d) => a64_word(0x9A9F07E0 | ((cc ^ 1) << 12) | d);

a64_fcmp(i64 cc, i64 a, i64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(cc, acc)};

a64_scaled(i64 base, i64 disp) => if(base == 31) 2 * disp else disp;

a64_mov(i64 d, i64 s) => if((d == 31) || (s == 31)) a64_word(0x91000000 | (s << 5) | d) else a64_word(0xAA0003E0 | (s << 16) | d);

// / и % с ловушкой: cbz b, fault; sdiv (INT_MIN / -1 не падает — модульно);
// остаток — msub через x16
a64_divmod(i64 a, i64 b, i64 fault, i64 rem) => array{...a64_word(0xB4000000 | (((fault >> 2) & 0x7FFFF) << 5) | b), ...(if(rem == 1) array{...a64_rrr(0x9AC00C00, 16, a, b), ...a64_word(0x9B008000 | (b << 16) | (a << 10) | (16 << 5) | a)} else a64_rrr(0x9AC00C00, a, a, b))};

// сравнение → 0/1 в a: cmp a, b; cset a (cc — условие AArch64: eq 0, ne 1, ge A, lt B, gt C, le D)
a64_cmp(i64 cc, i64 a, i64 b) => array{...a64_word(0xEB00001F | (b << 16) | (a << 5)), ...a64_word(0x9A9F07E0 | ((cc ^ 1) << 12) | a)};

amd64(expr body) {
  // регистровая модель: аккумулятор, второй операнд, их f64, база аргументов, кадр, стек
  // + аргументы C ABI (службы VM) и второй регистр результата
  model() => array{0, 1, 0, 1, 7, 5, 4, 2, 7, 6, 2, 1, 2}; // rax, rcx, xmm0, xmm1, rdi, rbp, rsp, rdx; rdi, rsi, rdx, rcx; rdx
  using operator (i64 a) + (i64 b) => x64_rr(0x1, a, b); // add
  using operator (i64 a) - (i64 b) => x64_rr(0x29, a, b); // sub
  using operator (i64 a) & (i64 b) => x64_rr(0x21, a, b); // and
  using operator (i64 a) | (i64 b) => x64_rr(0x9, a, b); // or
  using operator (i64 a) ^ (i64 b) => x64_rr(0x31, a, b); // xor
  using operator (i64 a) * (i64 b) => x64_0f(0xAF, a, b); // imul
  using operator (i64 a) << (i64 b) => x64_shift(4, a); // shl a, cl
  using operator (i64 a) >> (i64 b) => x64_shift(7, a); // sar a, cl
  move(i64 d, i64 s) => x64_rr(0x89, d, s); // mov d, s
  load(i64 d, i64 base, i64 disp) => x64_rm(0x8B, d, base, disp); // mov d, [base + disp]
  store(i64 base, i64 disp, i64 s) => x64_rm(0x89, s, base, disp); // mov [base + disp], s
  move_f64(i64 d, i64 s) => x64_sse(0xF2, 0x10, d, s); // movsd d, s
  load_f64(i64 d, i64 base, i64 disp) => x64_sse_rm(0xF2, 0x10, d, base, disp);
  store_f64(i64 base, i64 disp, i64 s) => x64_sse_rm(0xF2, 0x11, s, base, disp);
  load_const(i64 d, i64 v) => array{0x48 | (d >> 3), 0xB8 + (d & 7), ...x64_u64(v)}; // movabs d, v
  load_index(i64 d, i64 base, i64 index) => array{...x64_rex(1, d, index, base), 0x8B, ...x64_sib(d, base, index)};
  store_index(i64 base, i64 index, i64 s) => array{...x64_rex(1, s, index, base), 0x89, ...x64_sib(s, base, index)};
  load_index_f64(i64 d, i64 base, i64 index) => array{0xF2, ...x64_rex(0, d, index, base), 0xF, 0x10, ...x64_sib(d, base, index)};
  store_index_f64(i64 base, i64 index, i64 s) => array{0xF2, ...x64_rex(0, s, index, base), 0xF, 0x11, ...x64_sib(s, base, index)};
  check_index(i64 k, i64 n) => array{...x64_rr(0x39, k, n), 0xF, 0x83, ...x64_rel32(fault - 9)}; // cmp k, n; jae fault
  jump() => array{0xE9, ...x64_rel32(target - 5)}; // jmp target
  jump_if(bool a) => array{...x64_rr(0x85, a, a), 0xF, 0x85, ...x64_rel32(target - 9)}; // test a, a; jne target
  jump_if_set(i64 base) => array{...x64_rex(1, 7, 0, base), 0x83, ...x64_mem(7, base, 0), 0x0, 0xF, 0x85, ...x64_rel32((target - 8) - (if((base & 7) == 4) 7 else 6))}; // cmp qword [base], 0; jne
  store_const(i64 base, i64 disp, i64 v) => array{...x64_rm(0xC7, 0, base, disp), ...x64_rel32(v)}; // mov qword [base + disp], imm32
  address(i64 d, i64 base, i64 disp) => x64_rm(0x8D, d, base, disp); // lea
  call_reg(i64 r) => if(r >= 8) array{0x41, 0xFF, 0xD0 | (r & 7)} else array{0xFF, 0xD0 | r}; // call r
  call_mem(i64 base, i64 disp) => array{...x64_rex(0, 2, 0, base), 0xFF, ...x64_mem(2, base, disp)}; // call qword [base + disp]
  call_self() => array{0xE8, ...x64_rel32(target - 5)}; // call target (своё начало: рекурсия)
  frame_enter() => array{0x55}; // push rbp
  frame_leave() => array{0x5D}; // pop rbp
  frame_alloc(i64 n) => array{0x48, 0x81, 0xEC, ...x64_rel32(n)}; // sub rsp, n (размер — вторым вызовом)
  ret() => array{0xC3};
  is_index(i64 k, i64 n) => x64_cmp(0x2, k, n); // setb: 0 <= k < n одним беззнаковым сравнением
  using operator !(bool a) => array{...x64_rex(1, 0, 0, a), 0x83, 0xF0 | (a & 7), 0x1}; // xor a, 1
  using operator -(f64 a) => array{0x48 | (acc >> 3), 0xB8 + (acc & 7), ...x64_u64(1 << 63), 0x66, ...x64_rex(1, second_f, 0, acc), 0xF, 0x6E, 0xC0 | ((second_f & 7) << 3) | (acc & 7), ...x64_sse(0x66, 0x57, a, second_f)}; // знак: movabs; movq; xorpd
  jump_unless(bool a) => array{...x64_rr(0x85, a, a), 0xF, 0x84, ...x64_rel32(target - 9)}; // test a, a; je target
  using operator (i64 a) / (i64 b) => x64_divmod(a, b, fault, 0);
  using operator (i64 a) % (i64 b) => x64_divmod(a, b, fault, 1);
  using operator (f64 a) + (f64 b) => x64_sse(0xF2, 0x58, a, b); // addsd
  using operator (f64 a) - (f64 b) => x64_sse(0xF2, 0x5C, a, b); // subsd
  using operator (f64 a) * (f64 b) => x64_sse(0xF2, 0x59, a, b); // mulsd
  using operator (f64 a) / (f64 b) => x64_sse(0xF2, 0x5E, a, b); // divsd
  using operator (f64 a) == (f64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(0x4, acc), ...x64_set(0xB, second), 0x20, 0xC0 | ((second & 7) << 3) | (acc & 7), ...x64_0f(0xB6, acc, acc)}; // sete; setnp; and
  using operator (f64 a) != (f64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(0x5, acc), ...x64_set(0xA, second), 0x8, 0xC0 | ((second & 7) << 3) | (acc & 7), ...x64_0f(0xB6, acc, acc)}; // setne; setp; or
  using operator (f64 a) < (f64 b) => x64_fcmp(0x7, b, a); // seta, операнды наоборот
  using operator (f64 a) <= (f64 b) => x64_fcmp(0x3, b, a); // setae
  using operator (f64 a) > (f64 b) => x64_fcmp(0x7, a, b);
  using operator (f64 a) >= (f64 b) => x64_fcmp(0x3, a, b);
  push_tmp(i64 r) => if(r >= 8) array{0x41, 0x50 + (r & 7)} else array{0x50 + r};
  pop_tmp(i64 r) => if(r >= 8) array{0x41, 0x58 + (r & 7)} else array{0x58 + r};
  stack_alloc(i64 n) => array{0x48, 0x81, 0xEC, ...x64_rel32(n)}; // sub rsp, n
  stack_free(i64 n) => array{0x48, 0x81, 0xC4, ...x64_rel32(n)}; // add rsp, n
  to_f64(i64 d, i64 s) => array{0xF2, ...x64_rex(1, d, 0, s), 0xF, 0x2A, 0xC0 | ((d & 7) << 3) | (s & 7)}; // cvtsi2sd
  to_i64(i64 d, i64 s) => array{0xF2, ...x64_rex(1, d, 0, s), 0xF, 0x2C, 0xC0 | ((d & 7) << 3) | (s & 7)}; // cvttsd2si
  move_to_f64(i64 d, i64 s) => array{0x66, ...x64_rex(1, d, 0, s), 0xF, 0x6E, 0xC0 | ((d & 7) << 3) | (s & 7)}; // movq xmm, r
  move_from_f64(i64 d, i64 s) => array{0x66, ...x64_rex(1, s, 0, d), 0xF, 0x7E, 0xC0 | ((s & 7) << 3) | (d & 7)}; // movq r, xmm
  negate(i64 r) => array{0x48 | (r >> 3), 0xF7, 0xD8 | (r & 7)}; // neg r
  using operator (i64 a) == (i64 b) => x64_cmp(0x4, a, b);
  using operator (i64 a) != (i64 b) => x64_cmp(0x5, a, b);
  using operator (i64 a) < (i64 b) => x64_cmp(0xC, a, b);
  using operator (i64 a) >= (i64 b) => x64_cmp(0xD, a, b);
  using operator (i64 a) <= (i64 b) => x64_cmp(0xE, a, b);
  using operator (i64 a) > (i64 b) => x64_cmp(0xF, a, b);
  body
}

arm64(expr body) {
  model() => array{9, 3, 0, 1, 0, 29, 31, 2, 0, 1, 2, 3, 1}; // x9, x3, d0, d1, x0, x29, sp, x2; x0–x3; x1
  using operator (i64 a) + (i64 b) => a64_rrr(0x8B000000, a, a, b); // add
  using operator (i64 a) - (i64 b) => a64_rrr(0xCB000000, a, a, b); // sub
  using operator (i64 a) & (i64 b) => a64_rrr(0x8A000000, a, a, b); // and
  using operator (i64 a) | (i64 b) => a64_rrr(0xAA000000, a, a, b); // orr
  using operator (i64 a) ^ (i64 b) => a64_rrr(0xCA000000, a, a, b); // eor
  using operator (i64 a) * (i64 b) => a64_rrr(0x9B007C00, a, a, b); // madd a, a, b, xzr
  using operator (i64 a) << (i64 b) => a64_rrr(0x9AC02000, a, a, b); // lslv
  using operator (i64 a) >> (i64 b) => a64_rrr(0x9AC02800, a, a, b); // asrv
  move(i64 d, i64 s) => a64_mov(d, s);
  load(i64 d, i64 base, i64 disp) => a64_mem(0xF8400000, 0xF8606800, d, base, a64_scaled(base, disp)); // ldur/ldr
  store(i64 base, i64 disp, i64 s) => a64_mem(0xF8000000, 0xF8206800, s, base, a64_scaled(base, disp)); // stur/str
  move_f64(i64 d, i64 s) => a64_word(0x1E604000 | (s << 5) | d); // fmov
  load_f64(i64 d, i64 base, i64 disp) => a64_mem(0xFC400000, 0xFC606800, d, base, a64_scaled(base, disp));
  store_f64(i64 base, i64 disp, i64 s) => a64_mem(0xFC000000, 0xFC206800, s, base, a64_scaled(base, disp));
  load_const(i64 d, i64 v) => a64_imm64(d, v);
  load_index(i64 d, i64 base, i64 index) => a64_word(0xF8607800 | (index << 16) | (base << 5) | d); // ldr d, [base, index, lsl 3]
  store_index(i64 base, i64 index, i64 s) => a64_word(0xF8207800 | (index << 16) | (base << 5) | s);
  load_index_f64(i64 d, i64 base, i64 index) => a64_word(0xFC607800 | (index << 16) | (base << 5) | d);
  store_index_f64(i64 base, i64 index, i64 s) => a64_word(0xFC207800 | (index << 16) | (base << 5) | s);
  check_index(i64 k, i64 n) => array{...a64_word(0xEB00001F | (n << 16) | (k << 5)), ...a64_word(0x54000002 | ((((fault - 4) >> 2) & 0x7FFFF) << 5))}; // cmp k, n; b.hs fault
  jump() => a64_word(0x14000000 | ((target >> 2) & 0x3FFFFFF)); // b target
  jump_if(bool a) => a64_word(0xB5000000 | (((target >> 2) & 0x7FFFF) << 5) | a); // cbnz a, target
  jump_if_set(i64 base) => array{...a64_word(0xF8400000 | (base << 5) | 17), ...a64_word(0xB5000000 | ((((target - 4) >> 2) & 0x7FFFF) << 5) | 17)}; // ldur x17, [base]; cbnz x17
  store_const(i64 base, i64 disp, i64 v) => array{...a64_imm64(17, v), ...a64_mem(0xF8000000, 0xF8206800, 17, base, a64_scaled(base, disp))};
  address(i64 d, i64 base, i64 disp) => a64_add_imm(d, base, a64_scaled(base, disp));
  call_reg(i64 r) => array{...a64_word(0xD63F0000 | (r << 5)), ...a64_mov(acc, 0)}; // blr r; результат x0 → аккумулятор
  call_mem(i64 base, i64 disp) => array{...a64_mem(0xF8400000, 0xF8606800, 17, base, a64_scaled(base, disp)), ...a64_word(0xD63F0000 | (17 << 5)), ...a64_mov(acc, 0)};
  call_self() => array{...a64_word(0x94000000 | ((target >> 2) & 0x3FFFFFF)), ...a64_mov(acc, 0)}; // bl target; результат x0 → аккумулятор
  frame_enter() => a64_word(0xA9BF7BFD); // stp x29, x30, [sp, #-16]!
  frame_leave() => a64_word(0xA8C17BFD); // ldp x29, x30, [sp], #16
  frame_alloc(i64 n) => array{...a64_word(0xD2800000 | (n << 5) | 16), ...a64_word(0xCB206000 | (16 << 16) | (31 << 5) | 31)}; // movz x16, n; sub sp, sp, x16
  ret() => array{...a64_mov(0, acc), ...a64_word(0xD65F03C0)}; // результат — в x0
  is_index(i64 k, i64 n) => a64_cmp(0x3, k, n); // lo
  using operator !(bool a) => a64_word(0xD2400000 | (a << 5) | a); // eor a, a, #1
  using operator -(f64 a) => a64_word(0x1E614000 | (a << 5) | a); // fneg
  jump_unless(bool a) => a64_word(0xB4000000 | (((target >> 2) & 0x7FFFF) << 5) | a); // cbz a, target
  using operator (i64 a) / (i64 b) => a64_divmod(a, b, fault, 0);
  using operator (i64 a) % (i64 b) => a64_divmod(a, b, fault, 1);
  using operator (f64 a) + (f64 b) => a64_rrr(0x1E602800, a, a, b); // fadd
  using operator (f64 a) - (f64 b) => a64_rrr(0x1E603800, a, a, b); // fsub
  using operator (f64 a) * (f64 b) => a64_rrr(0x1E600800, a, a, b); // fmul
  using operator (f64 a) / (f64 b) => a64_rrr(0x1E601800, a, a, b); // fdiv
  using operator (f64 a) == (f64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(0x0, acc), ...a64_cset(0x7, second), ...a64_rrr(0x8A000000, acc, acc, second)}; // eq и vc
  using operator (f64 a) != (f64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(0x1, acc), ...a64_cset(0x6, second), ...a64_rrr(0xAA000000, acc, acc, second)}; // ne или vs
  using operator (f64 a) < (f64 b) => a64_fcmp(0xC, b, a);
  using operator (f64 a) <= (f64 b) => a64_fcmp(0xA, b, a);
  using operator (f64 a) > (f64 b) => a64_fcmp(0xC, a, b);
  using operator (f64 a) >= (f64 b) => a64_fcmp(0xA, a, b);
  push_tmp(i64 r) => a64_word(0xF81F0FE0 | r); // str r, [sp, #-16]!
  pop_tmp(i64 r) => a64_word(0xF84107E0 | r); // ldr r, [sp], #16
  stack_alloc(i64 n) => a64_add_imm(31, 31, -2 * n); // слоты по 16 байт
  stack_free(i64 n) => a64_add_imm(31, 31, 2 * n);
  to_f64(i64 d, i64 s) => a64_word(0x9E620000 | (s << 5) | d); // scvtf
  to_i64(i64 d, i64 s) => a64_word(0x9E780000 | (s << 5) | d); // fcvtzs
  move_to_f64(i64 d, i64 s) => a64_word(0x9E670000 | (s << 5) | d); // fmov d, x
  move_from_f64(i64 d, i64 s) => a64_word(0x9E660000 | (s << 5) | d); // fmov x, d
  negate(i64 r) => a64_word(0xCB0003E0 | (r << 16) | r); // neg
  using operator (i64 a) == (i64 b) => a64_cmp(0x0, a, b);
  using operator (i64 a) != (i64 b) => a64_cmp(0x1, a, b);
  using operator (i64 a) < (i64 b) => a64_cmp(0xB, a, b);
  using operator (i64 a) >= (i64 b) => a64_cmp(0xA, a, b);
  using operator (i64 a) <= (i64 b) => a64_cmp(0xD, a, b);
  using operator (i64 a) > (i64 b) => a64_cmp(0xC, a, b);
  body
}

// Файберы и потоки (§8.3): spawn { … } — стековая корутина; поток — блокирующие
// write/read: 
// Значение уходит в поток перемещением (own).
spawn(expr body) => fiber_start(body);
stream() => stream_new(16);
stream(i64 cap) => stream_new(cap);
stream(type t) => stream_type(t); // тип потока — функция над типами: stream(i64)
write(stream s, own x) => stream_write(s, x);
read(stream s) => stream_read(s);
more(stream s) => stream_more(s);
close(stream s) => stream_close(s);
for(stream s, expr body) {
  loop {
    if(!more(s)) break;
    body(read(s));
  }
}

// Сеть (M3b):
// listen — один поток событий по всем
// соединениям: event{peer, kind: "open" | "data" | "close", data}; send — в
// исходящий поток, без ожидания; connect — такой же поток для одного peer (0).
struct event { i64 peer; str kind; str data; }
listen(i64 p) => net_listen(p);
connect(str host, i64 p) => net_connect(host, p);
port(stream n) => net_port(n);
send(stream n, i64 peer, str data) => net_send(n, peer, data);
send(stream n, str data) => net_send(n, 0, data);
drop(stream n, i64 peer) => net_drop(n, peer);

// Файлы: open — поток кусков (чтение заявками io_uring), create — запись.
open(str path) => file_open(path);
create(str path) => file_create(path);

// Процессы VM (M3c): process(f, аргументы…) — изолированный процесс, между
// процессами — только данные перемещением. wait — дождаться; false — процесс
// упал (остальные живут), error — его сообщение.
wait(process p) => process_wait(p);
error(process p) => process_error(p);

// Форматирование — не строка формата: 
//;
// 
// 
//.
// fmt"x = {x}, адрес {hex(8)}{p}" — части шаблона: текст, значение, текст, …;
// форматтер (наследник formatter) настраивает следующее значение; свой формат —
// своя перегрузка format_with(форматтер, значение).
struct formatter {}
struct plain : formatter {}
struct hex : formatter { i64 width; }
struct fixed : formatter { i64 digits; }
hex(i64 w) => hex{w};
fixed(i64 d) => fixed{d};
format_with(plain f, x) => text(x);
// Примитивы — на C++ в теле функции: 
// 
// native "cpp" { … } собран в VM (tz native,
// build.sh); #x — параметр значением VM. Неизвестный при разборе аргумент —
// стёртое значение результата (как у встроенных).
text_hex(i64 n, i64 width) => native "cpp" {
  if(!#n.known() || !#width.known()) return erase(value(std::string("x")));
  char buf[32];
  snprintf(buf, sizeof buf, "%0*llx", int(#width.as<int64_t>()), static_cast<unsigned long long>(#n.as<int64_t>()));
  return value(std::string(buf));
};

text_fixed(f64 x, i64 digits) => native "cpp" {
  if(!#x.known() || !#digits.known()) return erase(value(std::string("x")));
  char buf[64];
  snprintf(buf, sizeof buf, "%.*f", int(#digits.as<int64_t>()), #x.as<double>());
  return value(std::string(buf));
};

format_with(hex h, i64 x) => text_hex(x, h.width);
format_with(fixed d, f64 x) => text_fixed(x, d.digits);

fmt(...parts) {
  out = "";
  f = plain{};
  i = 0;
  for(p : parts) {
    if((i % 2) == 0) out = out + p; // текст шаблона
    else if(formatter{} = p) f = p; // форматтер — для следующего значения
    else {
      out = out + format_with(f, p);
      f = plain{};
    }
    i = i + 1;
  }
  out
}

// parse_int(s) — result{ok, value, error}: цифры без знака.
parse_int(str s) => native "cpp" {
  auto make = [&](bool good, int64_t v, std::string err) {
    agg_v r{vm.types.named("result"), {}};
    r.fields.push_back({vm.sym("ok"), value(good)});
    r.fields.push_back({vm.sym("value"), value(v)});
    r.fields.push_back({vm.sym("error"), value(std::move(err))});
    return value(std::move(r));
  };
  if(!#s.known()) return erase(make(true, 0, ""));
  auto const & text = #s.as<std::string>();
  int64_t v = 0;
  bool good = !text.empty();
  for(char ch: text) {
    if(ch < '0' || ch > '9') {
      good = false;
      break;
    }
    v = v * 10 + (ch - '0');
  }
  return make(good, good ? v : 0, good ? "" : cat("не число: ", in_quotes(text)));
};

// text(x) — текст значения (байты): число — десятичная запись.
text(x) => native "cpp" {
  if(!#x.known()) return erase(value(std::string("x")));
  return value(#x.is<std::string>() ? #x.as<std::string>() : vm.show_v(#x));
};

// fill(n, x) — массив из n копий x.
fill(i64 n, x) => native "cpp" {
  if(!#n.known() || !#x.known()) return erase(value(array_v::of({#x.known() ? #x : *shape_of(#x)})));
  array_v r;
  for(int64_t i = 0; i < #n.as<int64_t>(); ++i) r.push(#x);
  return value(std::move(r));
};

is_err(result r) => !r.ok;

// Компилятор на языке — склейка JIT (шаг к раскрутке, §10.4): 
// 
// 
//.
// Компиляция — вычисление кода программы в контексте цели: 
// 
// Цель —
// сущность (amd64, arm64): её члены (cg.load, cg.jump…) и переопределённые в ней
// операции (op_codegen: оператор узла программы с типами операндов) — байты.
// Без строк: 
//  — вид узла — тег (n_op, n_if…), узел — распаковкой образцом,
// типы — значения (i64, array(i64), stream(f64)). Типы узлов и деревья цепочек — у
// разбора экземпляра: 
//. Регистры модели (acc, second…) и смещения меток (target, fault)
// кодогенераторы берут из окружения компилятора (O4). Вызовы — семантический инлайн
// (D10); рекурсия — call на своё начало. Вход (решение автора: слот от VM, без
// адресов хоста в коде): область аргументов — скаляр словом, массив — {данные,
// размер}, за ними вид ошибки, узел, брошенное значение и его тип, служба VM.
// JIT зовёт jit_compile(цель, код функции, типы параметров, тип результата);
// причина-строка — не умеет (код даст склейка C++).
struct jc_range {} // тег: значение range(n) — в слоте граница n

// имя в окружении: слот (kind — тип; массив — два слота: данные, размер; jc_range —
// граница) или expr-параметр (код, контекст, окружение и функция вызывающего)
struct jc_var { str name; type kind; i64 slot; bool thunk; code th; i64 th_ctx; i64 th_top; i64 th_base; i64 th_ret; }

// генератор, ждущий своего for: тело spawn (expr) и его вид, область, слоты, которые
// тело читает снаружи, узел spawn
struct jc_gen { code w; i64 w_ctx; i64 w_top; i64 w_base; i64 w_ret; i64 region; array caps; code at; }

// catch в машинном коде: тип (unit — любой), метка, переменная значения, глубина стека
struct jc_catch { type ty; i64 label; bool binds; str name; i64 slot; i64 depth; }

jit_compile(cg, f, types, type result) {
  array{acc, second, acc_f, second_f, argbase, frame, stack, third, ca0, ca1, ca2, ca3, cret2} = cg.model();
  ok = true;
  why = "";
  bad(str w) => {
    if(ok) why = w;
    ok = false;
  };
  out = array{};
  fix_at = array{}; // переходы на метки: место, метка, кодогенератор от смещения
  fix_label = array{};
  fix_mk = array{};
  labels = array{};
  faults = array{};
  loops = array{};
  env = array{};
  top = 0; // занятые записи env
  base = 0; // первая запись текущей (встроенной) функции
  ctx = 0; // контекст встраивания (как в разборе)
  nslots = 0;
  depth = 0; // временных на стеке (push_tmp) — переход в catch их снимает
  tries = array{}; // охватывающие try: массивы jc_catch
  jumps = 0; // throw, ставших переходом в catch
  fr_fn = array{}; // встроенные функции от корня: код, выход, кто встроил (return(f), return(caller))
  fr_exit = array{};
  fr_parent = array{};
  cur = 0;
  // Генератор → цикл (O11): s = stream(…); spawn { W }; for(x : s) B — без файбера: в
  // месте for исполняется W, где write(s, v) — это B с x = v: 
// Условия — как у
  // склейки C++ (*моё*): наблюдаемое не меняется.
  gens = array{}; // jc_gen, ждущие for
  region = 0; // область управления: ветка или тело цикла
  regions = 0;
  fusing = false; // идёт свёртка: генерируется W
  in_b = false; // внутри W — тело потребителя B
  f_stream = -1; // слот потока свёртки
  f_elem = unit;
  f_body = f; // блок for: (x) { B }
  f_env = array{}; // окружение места for — B генерируется в нём
  f_top = 0;
  f_base = 0;
  f_ctx = 0;
  f_cur = 0;
  f_outer = array{}; // слоты, видимые W снаружи
  f_caps = array{}; // слоты, которые W читает
  f_closes = 0;
  has(xs, i64 x) => {
    r = false;
    for(y : xs) if(y == x) r = true;
    r
  };
  is_stream(type t) => (t == stream(i64)) || ((t == stream(f64)) || (t == stream(bool)));
  is_arr(type t) => (t == array(i64)) || (t == array(f64));
  scalar(type t) => (t == i64) || ((t == bool) || ((t == f64) || is_stream(t))); // поток — его номер
  elem(type t) => if((t == array(f64)) || (t == stream(f64))) f64 else if(t == stream(bool)) bool else i64;
  if(!scalar(result) && (result != unit)) bad("тип результата");
  for(t : types) if(!scalar(t) && !is_arr(t)) bad("тип параметра");
  put_bytes(bytes) => {
    for(b : bytes) out.push(b);
  };
  label() => {
    labels.push(-1);
    labels.size - 1
  };
  bind(i64 l) => {
    labels[l] = out.size;
  };
  // переход на метку: кодогенератор от смещения (до привязки — 0, потом — настоящее)
  jump_to(i64 l, mk) => {
    fix_at.push(out.size);
    fix_label.push(l);
    fix_mk.push(mk);
    put_bytes(mk(0));
  };
  jump(i64 l) => jump_to(l, (i64 o) => {
    target = o;
    cg.jump()
  });
  jump_unless(i64 r, i64 l) => jump_to(l, (i64 o) => {
    target = o;
    cg.jump_unless(r)
  });
  jump_if(i64 r, i64 l) => jump_to(l, (i64 o) => {
    target = o;
    cg.jump_if(r)
  });
  off(i64 k) => 0 - (8 * (k + 1));
  alloc(i64 n) => {
    k = nslots;
    nslots += n;
    k
  };
  put(v) => {
    if(top < env.size) env[top] = v;
    else env.push(v);
    top += 1;
  };
  declare(str name, type kind) => {
    s = alloc(if(is_arr(kind)) 2 else 1);
    put(jc_var{name, kind, s, false, f, 0, 0, 0, 0});
    s
  };
  find(str name) => {
    k = -1;
    for(i : range(top)) if((i >= base) && (env[i].name == name)) k = i;
    k
  };
  load_slot(type kind, i64 s) => put_bytes(if(kind == f64) cg.load_f64(acc_f, frame, off(s)) else cg.load(acc, frame, off(s)));
  // запись, которая сделала бы порядок W и B наблюдаемым
  wrote(i64 sl) => {
    if(!fusing) {
      for(g : gens) if(has(g.caps, sl)) bad("переменную генератора меняют после spawn");
    } else if(!in_b && has(f_outer, sl)) bad("генератор пишет наружу");
    else if(in_b && has(f_caps, sl)) bad("потребитель пишет то, что читает генератор");
  };
  store_slot(type kind, i64 s) => {
    wrote(s);
    store_bytes(kind, s);
  };
  store_bytes(type kind, i64 s) => put_bytes(if(kind == f64) cg.store_f64(frame, off(s), acc_f) else cg.store(frame, off(s), acc));
  drop_last(xs) => {
    r = array{};
    for(i : range(xs.size - 1)) r.push(xs[i]);
    r
  };
  // ближайший catch для типа (последний try — первым); unit — любой
  catch_for(type t) => {
    r = array{};
    for(i : range(tries.size)) {
      for(c : tries[tries.size - (1 + i)]) if((r.size == 0) && ((c.ty == unit) || (c.ty == t))) r.push(c);
    }
    r
  };
  // ловушка: метка, вид (1 — границы, 2 — деление на ноль, 3 — require, 5 — throw, 6 — VM), узел
  vm_error_type(i64 kind) => if(kind == 1) out_of_bounds else if(kind == 2) div_by_zero else if(kind == 3) require_failed else vm_error;
  trap(i64 kind, e) => {
    if(fusing && !in_b) bad("генератор может упасть: свёртка изменила бы, где ошибка");
    l = label();
    to = catch_for(vm_error_type(kind));
    if(to.size == 0) faults.push(array{l, kind, code_id(e)});
    else if(to[0].binds) bad("catch использует объект ошибки VM");
    else faults.push(array{l, -2, to[0].label, depth - to[0].depth}); // ошибка VM в try — переход в catch
    l
  };
  // окружение вызывающего: записи выше его вершины — в сторону, потом обратно
  in_view(i64 t, i64 b, i64 c, i64 rt, g) => {
    saved = array{};
    for(i : range(top - t)) saved.push(env[t + i]);
    old_top = top;
    old_base = base;
    old_ctx = ctx;
    old_cur = cur;
    top = t;
    base = b;
    ctx = c;
    cur = rt; // return в коде вызывающего — из его функции (семантический инлайн)
    r = g();
    for(i : range(saved.size)) env[t + i] = saved[i];
    top = old_top;
    base = old_base;
    ctx = old_ctx;
    cur = old_cur;
    r
  };
  var_of(e) => if(code_kind(e) == n_ident) {
    array{name} = code_fields(e);
    find(name)
  } else -1;
  callee_name(e) => if(code_kind(e) == n_ident) {
    array{name} = code_fields(e);
    name
  } else "";
  is_call_of(e, str name) => (code_kind(e) == n_call) && {
    array{c, ...rest} = code_fields(e);
    callee_name(c) == name
  };
  // тип узла: имя — по окружению компилятора, иначе — у разбора, иначе — по виду узла
  ty(e) => {
    k = code_kind(e);
    v = var_of(e);
    t = jit_type(e, ctx);
    if(v >= 0) {
      w = env[v];
      if(w.thunk) in_view(w.th_top, w.th_base, w.th_ctx, w.th_ret, () => ty(w.th)) else w.kind
    } else if(given(t)) t
    else if(is_call_of(e, "index")) { // примитив ядра a[i] — тип элемента
      array{_, ys, ...rest} = code_fields(e);
      a = ty(ys[0]);
      if(a == jc_range) i64 else elem(a)
    } else if(k == n_int) i64
    else if(k == n_float) f64
    else if(k == n_op) {
      array{op, xs, _} = code_fields(e);
      if(op == ".size") i64
      else if(op == "[]") {
        a = ty(xs[0]);
        if(a == jc_range) i64 else elem(a)
      } else if((op == "!") || ((op == "==") || ((op == "!=") || ((op == "<") || ((op == "<=") || ((op == ">") || ((op == ">=") || ((op == "&&") || (op == "||"))))))))) bool
      else ty(xs[0])
    } else if(k == n_chain) {
      c = jit_chain(e, ctx);
      if(c.size == 0) unit else ty(c[0])
    } else unit
  };
  gen_name(e) => {
    array{name} = code_fields(e);
    k = find(name);
    if(name == "true") put_bytes(cg.load_const(acc, 1));
    else if(name == "false") put_bytes(cg.load_const(acc, 0));
    else if(k < 0) bad(fmt"имя {name}");
    else if(env[k].thunk) {
      v = env[k];
      if(code_kind(v.th) == n_lambda) bad("блок — только body(v)");
      else in_view(v.th_top, v.th_base, v.th_ctx, v.th_ret, () => gen(v.th));
    } else if(is_stream(env[k].kind) && pending(env[k].slot)) bad("поток генератора используется не через for");
    else if(is_stream(env[k].kind) && (fusing && (in_b && (env[k].slot == f_stream)))) bad("потребитель трогает поток генератора");
    else if(is_arr(env[k].kind)) bad("массив значением");
    else load_slot(env[k].kind, env[k].slot);
  };
  gen_const(v) => {
    if(typeof(v) == f64) {
      put_bytes(cg.load_const(acc, f64_bits(v)));
      put_bytes(cg.move_to_f64(acc_f, acc));
    } else if(typeof(v) == bool) put_bytes(cg.load_const(acc, if(v) 1 else 0));
    else put_bytes(cg.load_const(acc, v));
  };
  // codegen::eval: значение узла программы — байтами в аккумулятор (f64 — в acc_f)
  gen(e) => {
    k = code_kind(e);
    if(!ok) {
    } else if(k == n_int) {
      array{v, ...rest} = code_fields(e);
      put_bytes(cg.load_const(acc, v));
    } else if(k == n_float) {
      array{v} = code_fields(e);
      gen_const(v);
    } else if(k == n_ident) gen_name(e);
    else if(k == n_op) gen_op(e);
    else if(k == n_chain) {
      t = jit_chain(e, ctx);
      if(t.size == 0) bad("цепочка: дерево зависит от пути");
      else gen(t[0]);
    } else if(k == n_call) gen_call(e);
    else if(k == n_block) {
      array{items, ...rest} = code_fields(e);
      saved_top = top;
      for(x : items) if(ok) gen(x);
      top = saved_top;
    } else if(k == n_if) {
      array{c, t, el} = code_fields(e);
      l_else = label();
      l_done = label();
      gen(c);
      jump_unless(acc, l_else);
      in_region(() => gen(t));
      jump(l_done);
      bind(l_else);
      if(given(el)) in_region(() => gen(el));
      bind(l_done);
    } else if(k == n_loop) {
      array{body} = code_fields(e);
      t = label();
      done = label();
      bind(t);
      loops.push(t);
      loops.push(done);
      in_region(() => gen(body));
      jump(t);
      bind(done);
      loops = drop_last(drop_last(loops));
    } else if(k == n_break) {
      if(loops.size == 0) bad("break вне цикла");
      else jump(loops[loops.size - 1]);
    } else if(k == n_continue) {
      if(loops.size == 0) bad("continue вне цикла");
      else jump(loops[loops.size - 2]);
    } else if(k == n_return) {
      array{v, tg} = code_fields(e);
      to = cur;
      if(given(tg)) { // return(f) — из внешней функции f, return(caller) — из вызывающей (§6.1)
        tn = callee_name(tg);
        to = -1;
        if(tn == "caller") to = fr_parent[cur];
        else {
          i = cur;
          loop {
            if(i < 0) break;
            array{fname, ...rest} = code_fields(fr_fn[i]);
            if((to < 0) && (fname == tn)) to = i;
            i = fr_parent[i];
          }
        }
      }
      if(to < 0) bad("return(цель): цели нет в цепочке встраивания");
      else {
        if(given(v)) gen(v);
        if(depth > 0) put_bytes(cg.stack_free(8 * depth)); // временные незавершённых выражений
        jump(fr_exit[to]);
      }
    } else if(k == n_var) {
      array{name, vt, init, _, is_ct, is_ref, _} = code_fields(e);
      if(is_ref || is_ct) bad("ссылка или ct-переменная");
      else if(given(vt) && (code_kind(vt) == n_ident)) { // T x = e: значение — в тип T (§5.8)
        want = type_of_code(vt);
        t = ty(init);
        if(want == t) assign(name, init, true);
        else if((want == f64) && (t == i64)) {
          gen(init);
          put_bytes(cg.to_f64(acc_f, acc));
          declare(name, f64);
          store_slot(f64, env[top - 1].slot);
        } else bad(fmt"объявление {want} из {t}");
      } else assign(name, init, true);
    } else if(k == n_throw) gen_throw(e);
    else bad(fmt"узел {k}");
  };
  // индекс в acc, проверка границ по размеру массива (запись s); данные — в second
  checked(i64 s, e) => {
    put_bytes(cg.load(second, frame, off(env[s].slot + 1)));
    jump_to(trap(1, e), (i64 o) => {
      fault = o;
      cg.check_index(acc, second)
    });
    put_bytes(cg.load(second, frame, off(env[s].slot)));
  };
  // a[i] — парный оператор [] (узел n_op "[]")
  index_parts(e) => if(code_kind(e) == n_op) {
    array{op, xs, _} = code_fields(e);
    if((op == "[]") && (xs.size == 2)) xs else array{}
  } else array{};
  gen_index(e) => {
    array{o, ix} = index_parts(e);
    gen_index_of(e, o, ix);
  };
  // перегрузка [] кодом с типами (operator (T a)[U i]), подошедшая к операндам — встраивается
  typed_overload(g) => {
    array{_, ps, ...rest} = code_fields(g);
    n = 0;
    for(p : ps) {
      array{_, pt, ...prest} = code_fields(p);
      if(given(pt)) n += 1;
    }
    n > 0
  };
  gen_index_op(e, xs) => {
    g = choose("infix[]", xs);
    if((g.size == 1) && typed_overload(g[0])) gen_inline(e, "infix[]", xs);
    else gen_index(e);
  };
  gen_index_of(e, o, ix) => {
    s = var_of(o);
    if((s < 0) || env[s].thunk) bad("индекс не массива-переменной");
    else if(env[s].kind == jc_range) gen(ix); // элемент range(n) по индексу is_index — сам индекс
    else if(!is_arr(env[s].kind)) bad("индекс не массива");
    else {
      gen(ix);
      checked(s, e);
      put_bytes(if(env[s].kind == array(f64)) cg.load_index_f64(acc_f, second, acc) else cg.load_index(acc, second, acc));
    }
  };
  assign(str name, e, bool fresh) => {
    t = if(is_call_of(e, "range")) jc_range else ty(e);
    if(!scalar(t) && (t != jc_range)) bad(fmt"присваивание значения {t}");
    gen(e);
    s = if(fresh) -1 else find(name);
    if((s >= 0) && env[s].thunk) bad("присваивание expr-параметру");
    else {
      if(s < 0) {
        declare(name, t);
        s = top - 1;
      }
      if(env[s].kind != t) bad("тип переменной меняется");
      else store_slot(t, env[s].slot);
    }
  };
  // второй операнд: вычислить, на стек, первый, второй — в second
  operands(e0, e1, type t) => {
    gen(e1);
    if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
    put_bytes(cg.push_tmp(acc));
    depth += 1;
    gen(e0);
    put_bytes(cg.pop_tmp(second));
    depth -= 1;
    if(t == f64) put_bytes(cg.move_to_f64(second_f, second));
  };
  regs(type t) => if(t == f64) array{acc_f, second_f} else array{acc, second};
  // операция узла программы — её кодогенератор в цели (codegen::eval)
  apply_op(e, type t, g) => {
    r = regs(t);
    g(r[0], r[1])
  };
  // xs.size — постфиксный оператор .size 
  gen_size(xs) => {
    s = var_of(xs[0]);
    if((s < 0) || env[s].thunk) bad("обращение .size не к переменной");
    else if(is_arr(env[s].kind)) put_bytes(cg.load(acc, frame, off(env[s].slot + 1)));
    else if(env[s].kind == jc_range) put_bytes(cg.load(acc, frame, off(env[s].slot)));
    else bad(".size не массива");
  };
  gen_op(e) => {
    array{op, xs, _} = code_fields(e);
    if(op == "[]") gen_index_op(e, xs);
    else if(op == ".size") gen_size(xs);
    else if(xs.size == 1) {
      t = ty(xs[0]);
      gen(xs[0]);
      g = op_codegen(cg, e, array{t});
      if((op == "-") && (t == i64)) put_bytes(cg.negate(acc));
      else if(!given(g)) bad(fmt"нет кодогенератора {op} над {t}");
      else put_bytes(g(if(t == f64) acc_f else acc));
    } else if((op == "=") && (code_kind(xs[0]) == n_ident)) {
      array{name} = code_fields(xs[0]);
      assign(name, xs[1], false);
    } else if((op == "=") && (index_parts(xs[0]).size == 2)) { // xs[i] = v: значение — на стек, индекс, границы, запись
      array{o, ix} = index_parts(xs[0]);
      s = var_of(o);
      if((s < 0) || (env[s].thunk || !is_arr(env[s].kind))) bad("запись не в элемент массива-переменной");
      else {
        t = ty(xs[1]);
        if(t != elem(env[s].kind)) bad("тип элемента");
        wrote(env[s].slot);
        gen(xs[1]);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.push_tmp(acc));
        depth += 1;
        gen(ix);
        checked(s, xs[0]);
        put_bytes(cg.pop_tmp(third));
        depth -= 1;
        put_bytes(cg.store_index(second, acc, third));
      }
    } else if(((op == "+=") || ((op == "-=") || ((op == "*=") || (op == "/=")))) && (code_kind(xs[0]) == n_ident)) {
      s = var_of(xs[0]);
      if((s < 0) || env[s].thunk) bad("составное присваивание");
      else {
        t = env[s].kind;
        g = op_codegen(cg, e, array{t, t}); // a op= b — кодогенератор op
        if(!given(g) || ((op == "/=") && (t != f64))) bad(fmt"{op} над {t}");
        else {
          operands(xs[0], xs[1], t);
          put_bytes(apply_op(e, t, g));
          store_slot(t, env[s].slot);
        }
      }
    } else if((op == "&&") || (op == "||")) { // короткая логика — переходы
      l = label();
      gen(xs[0]);
      if(op == "&&") jump_unless(acc, l) else jump_if(acc, l);
      gen(xs[1]);
      bind(l);
    } else {
      t = ty(xs[0]);
      ot = if(t == bool) i64 else t; // == и != над bool — те же биты
      g = op_codegen(cg, e, array{ot, ot});
      if(!given(g)) bad(fmt"нет кодогенератора {op} над {t}");
      else if(ty(xs[1]) != t) bad("типы операндов");
      else if(((op == "/") || (op == "%")) && (ot == i64)) { // ловушка деления на ноль
        operands(xs[0], xs[1], ot);
        jump_to(trap(2, e), (i64 o) => {
          fault = o;
          g(acc, second)
        });
      } else {
        operands(xs[0], xs[1], ot);
        put_bytes(apply_op(e, ot, g));
      }
    }
  };
  gen_call(e) => {
    kc = jit_const(e, ctx);
    array{callee, xs, ...rest} = code_fields(e);
    name = callee_name(callee);
    v = find(name);
    if(kc.size == 1) gen_const(kc[0]);
    else if(name == "") bad("вызов значения");
    else if((v >= 0) && env[v].thunk) call_block(env[v], xs);
    else if(v >= 0) bad("значение-функция");
    else if((name == "f64") && ((xs.size == 1) && (ty(xs[0]) == i64))) {
      gen(xs[0]);
      put_bytes(cg.to_f64(acc_f, acc));
    } else if((name == "i64") && ((xs.size == 1) && (ty(xs[0]) == f64))) {
      gen(xs[0]);
      put_bytes(cg.to_i64(acc, acc_f));
    } else if((name == "range") && ((xs.size == 1) && (ty(xs[0]) == i64))) gen(xs[0]); // range(n) — граница
    else if((name == "intercept") && (xs.size == 2)) gen_intercept(xs);
    else if((name == "fiber_start") && (xs.size == 1)) gen_spawn(e, xs[0]);
    else if((name == "index") && (xs.size == 2)) gen_index_of(e, xs[0], xs[1]); // примитив ядра a[i]
    else if(name == "hide") {} // скрытие имени — только при компиляции
    else if((name == "require") && (xs.size == 1)) { // require(c) — вызов ядра: нарушено — ошибка 3
      gen(xs[0]);
      jump_unless(acc, trap(3, e));
    }
    else if((name == "stream_new") || ((name == "stream_write") || ((name == "stream_read") || ((name == "stream_more") || ((name == "stream_close") || ((name == "yield") && (xs.size == 0))))))) gen_stream(e, name, xs);
    else if((name == "is_index") && (xs.size == 2)) {
      s = var_of(xs[1]);
      if((s < 0) || env[s].thunk) bad("is_index не над переменной");
      else {
        gen(xs[0]);
        put_bytes(cg.load(second, frame, off(if(env[s].kind == jc_range) env[s].slot else env[s].slot + 1)));
        put_bytes(cg.is_index(acc, second));
      }
    } else gen_inline(e, name, xs);
  };
  // Операция потока — служба VM (адрес — в области аргументов, не в коде): op, номер
  // потока, биты значения, (тип << 32) | узел; ответ — значение и признак ошибки
  jt_code(type t) => if(t == i64) 1 else if(t == f64) 2 else if(t == bool) 3 else 0;
  gen_stream(e, str name, xs) => {
    op = if(name == "stream_new") 0 else if(name == "stream_write") 1 else if(name == "stream_read") 2 else if(name == "stream_more") 3 else if(name == "stream_close") 4 else 5;
    carried = unit;
    if(fusing && !in_b) sink(e, op, xs);
    else if(tries.size > 0) bad("операция потока внутри try");
    else if(op == 0) {
      if((xs.size != 1) || (ty(xs[0]) != i64)) bad("stream_new(ёмкость i64)");
      gen(xs[0]);
      put_bytes(cg.move(ca2, acc));
      put_bytes(cg.load_const(ca1, 0));
    } else if(op != 5) {
      st = ty(xs[0]);
      if(!is_stream(st)) bad(fmt"не поток известного типа: {st}");
      else if(op == 1) {
        carried = elem(st);
        gen(xs[0]);
        put_bytes(cg.push_tmp(acc));
        depth += 1;
        if(ty(xs[1]) != carried) bad("тип записи ≠ типу потока");
        gen(xs[1]);
        if(carried == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.move(ca2, acc));
        put_bytes(cg.pop_tmp(ca1));
        depth -= 1;
      } else {
        gen(xs[0]);
        put_bytes(cg.move(ca1, acc));
        if(op == 2) carried = elem(st);
      }
    }
    if(ok && !(fusing && !in_b)) vm_service(op, carried, e);
  };
  vm_service(i64 op, type carried, e) => {
    put_bytes(cg.load_const(ca3, (jt_code(carried) << 32) | code_id(e)));
    put_bytes(cg.load(acc, frame, off(args_slot)));
    put_bytes(cg.load(acc, acc, 8 * (ap + 4)));
    put_bytes(cg.load_const(ca0, op));
    pad = (depth % 2) == 1; // стек хоста — по 16 байт
    if(pad) put_bytes(cg.stack_alloc(8));
    put_bytes(cg.call_reg(acc));
    if(pad) put_bytes(cg.stack_free(8));
    jump_if(cret2, trap(6, e));
    if((carried == f64) && (op == 2)) put_bytes(cg.move_to_f64(acc_f, acc));
  };
  // перегрузка по типам аргументов (как склейка C++): expr-параметр — любой код
  choose(str name, xs) => {
    best = -1;
    pick = array{};
    tie = false;
    for(g : functions_named(name)) {
      array{_, ps, ...rest} = code_fields(g);
      fits = ps.size == xs.size;
      score = 0;
      for(i : range(if(fits) ps.size else 0)) {
        array{_, pt, mode, pack, ...prest} = code_fields(ps[i]);
        if(given(pt)) {
          want = type_of_code(pt);
          at = ty(xs[i]);
          if(!given(want) || (mode == 4)) fits = false;
          else if((want != at) && (want != type_family(at))) fits = false; // stream — семейство stream(i64)
          else score += 1;
        }
        if(pack && (mode != 4)) fits = false; // хвост ...xs; пак клаузы (catch) — можно
      }
      if(fits && (score > best)) {
        best = score;
        pick = array{g};
        tie = false;
      } else if(fits && (score == best)) tie = true;
    }
    if(tie) array{} else pick
  };
  gen_inline(e, str name, xs) => {
    gk = if((name == "for") && (xs.size == 2)) generator_of(xs[0]) else -1;
    if(gk >= 0) return gen_fused(e, xs, gk);
    g = choose(name, xs);
    if((g.size == 1) && (code_id(g[0]) == code_id(f))) return call_self_with(xs); // рекурсия — настоящий вызов себя
    rec = false;
    if(g.size == 1) {
      // рекурсия — по цепочке «кто встроил» от текущего кода: блок вызывающего
      // (тело for) генерируется в его цепочке, а не внутри встроенной конструкции
      k = cur;
      while(k >= 0) {
        if(code_id(fr_fn[k]) == code_id(g[0])) rec = true;
        k = fr_parent[k];
      }
    }
    array{_, ps, _, body, is_outline, ...rest} = if(g.size == 1) code_fields(g[0]) else array{"", array{}, false, false, true};
    if((g.size == 0) || (rec || is_outline)) bad(fmt"вызов {name}: нет встраиваемой перегрузки");
    else {
      fn = g[0];
      binds = array{};
      for(i : range(ps.size)) {
        array{pname, _, mode, ...prest} = code_fields(ps[i]);
        a = xs[i];
        s = var_of(a);
        if(mode == 4) binds.push(jc_var{pname, unit, 0, true, a, ctx, top, base, cur});
        else if((s >= 0) && ((mode != 2) && !env[s].thunk)) {
          w = env[s];
          binds.push(jc_var{pname, w.kind, w.slot, false, f, 0, 0, 0, 0}); // алиас места
        } else {
          t = if(is_call_of(a, "range")) jc_range else ty(a);
          if(!scalar(t) && (t != jc_range)) bad(fmt"аргумент {pname} типа {t}");
          gen(a);
          sl = alloc(1);
          store_slot(t, sl);
          binds.push(jc_var{pname, t, sl, false, f, 0, 0, 0, 0});
        }
      }
      if(ok) {
        exit = label();
        old_top = top;
        old_base = base;
        old_ctx = ctx;
        old_cur = cur;
        base = top;
        for(b : binds) put(b);
        ctx = inline_context(ctx, e);
        fr_fn.push(fn);
        fr_exit.push(exit);
        fr_parent.push(cur);
        cur = fr_fn.size - 1;
        gen(body);
        bind(exit);
        fr_fn = drop_last(fr_fn);
        fr_exit = drop_last(fr_exit);
        fr_parent = drop_last(fr_parent);
        top = old_top;
        base = old_base;
        ctx = old_ctx;
        cur = old_cur;
      }
    }
  };
  // Вызов себя: область аргументов вызываемого — в своём кадре (область[j] — слот
  // k0 + w - 1 - j: кадр растёт вниз), её адрес — в базу аргументов, call на своё
  // начало; ошибка вызванного — в свои слоты и выход (как ловушка).
  call_self_with(xs) => {
    if(fusing && !in_b) bad("генератор: настоящий вызов");
    ws = 0;
    for(i : range(xs.size)) ws += if(is_arr(types[i])) 2 else 1;
    w = ws + 4;
    k0 = alloc(w);
    area(i64 j) => off((k0 + w) - (1 + j));
    j = 0;
    for(i : range(xs.size)) {
      if(is_arr(types[i])) {
        s = var_of(xs[i]);
        if((s < 0) || (env[s].thunk || (env[s].kind != types[i]))) bad("массив в рекурсивный вызов");
        else {
          put_bytes(cg.load(acc, frame, off(env[s].slot)));
          put_bytes(cg.store(frame, area(j), acc));
          put_bytes(cg.load(acc, frame, off(env[s].slot + 1)));
          put_bytes(cg.store(frame, area(j + 1), acc));
        }
        j += 2;
      } else {
        t = ty(xs[i]);
        if(t != types[i]) bad(fmt"аргумент {t} вместо {types[i]}");
        gen(xs[i]);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.store(frame, area(j), acc));
        j += 1;
      }
    }
    put_bytes(cg.load_const(acc, 0));
    put_bytes(cg.store(frame, area(ws), acc));
    put_bytes(cg.address(argbase, frame, area(0)));
    jump_to(entry, (i64 o) => {
      target = o;
      cg.call_self()
    });
    put_bytes(cg.move(third, acc)); // результат — пока в стороне
    put_bytes(cg.load(acc, frame, area(ws)));
    l = label();
    faults.push(array{l, -1, area(ws)}); // -1 — перенос ошибки вызванного
    jump_if(acc, l);
    put_bytes(cg.move(acc, third));
    if(result == f64) put_bytes(cg.move_to_f64(acc_f, acc));
  };
  // throw: catch выбран при компиляции по типу — значение в его переменную и переход;
  // не пойман здесь — в слоты области (вид 5, узел, значение, тип) и выход
  gen_throw(e) => {
    array{v} = code_fields(e);
    t = ty(v);
    if(!scalar(t)) bad(fmt"throw значения {t}");
    else {
      gen(v);
      to = catch_for(t);
      if(to.size == 1) {
        c = to[0];
        if(c.binds) store_slot(t, c.slot);
        if(depth > c.depth) put_bytes(cg.stack_free(8 * (depth - c.depth)));
        jump(c.label);
        jumps += 1;
      } else {
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.load(second, frame, off(args_slot)));
        put_bytes(cg.store(second, 8 * (ap + 2), acc));
        put_bytes(cg.load_const(acc, jt_code(t)));
        put_bytes(cg.store(second, 8 * (ap + 3), acc));
        l = label();
        faults.push(array{l, 5, code_id(e)});
        jump(l);
      }
    }
  };
  // сколько раз имя встречается в коде (catch(e) без использования e)
  uses(c, str name) => {
    n = if(callee_name(c) == name) 1 else 0;
    for(x : code_items(c)) n += uses(x, name);
    n
  };
  // try { тело } catch(T e) { … } … = intercept(тело, блоки): 
// catch — по типу, при компиляции
  gen_intercept(xs) => {
    b = var_of(xs[0]);
    h = var_of(xs[1]);
    if((b < 0) || ((h < 0) || (!env[b].thunk || !env[h].thunk))) bad("intercept не над expr-параметрами");
    else {
      hv = env[h];
      hs = if(code_kind(hv.th) == n_construct) { // пак клауз — кортеж блоков
        array{_, items} = code_fields(hv.th);
        items
      } else array{hv.th};
      frame_c = array{};
      lams = array{};
      for(l : hs) {
        array{ps, body, _} = if(code_kind(l) == n_lambda) code_fields(l) else array{array{}, false, false};
        if(ps.size != 1) bad("catch не блок с параметром");
        else {
          array{pname, pt, ...prest} = code_fields(ps[0]);
          cty = if(given(pt)) type_of_code(pt) else unit;
          binds = (pname != "_") && (uses(body, pname) > 0);
          if(binds && !scalar(cty)) bad("catch использует значение, неизвестное машинному коду");
          frame_c.push(jc_catch{cty, label(), binds, pname, if(binds) alloc(1) else 0, depth});
          lams.push(body);
        }
      }
      done = label();
      tries.push(frame_c);
      bv = env[b];
      in_view(bv.th_top, bv.th_base, bv.th_ctx, bv.th_ret, () => gen(bv.th));
      tries = drop_last(tries);
      jump(done);
      for(i : range(frame_c.size)) {
        c = frame_c[i];
        bind(c.label);
        in_view(hv.th_top, hv.th_base, hv.th_ctx, hv.th_ret, () => {
          if(c.binds) put(jc_var{c.name, c.ty, c.slot, false, f, 0, 0, 0, 0});
          gen(lams[i]);
        });
        jump(done);
      }
      bind(done);
    }
  };
  // body(v): аргументы — здесь, тело блока — в окружении и контексте вызывающего
  call_block(v, xs) => {
    l = v.th;
    array{ps, body, block} = if(code_kind(l) == n_lambda) code_fields(l) else array{array{}, false, false};
    if(!block) bad("вызов expr-параметра, который не блок");
    else if(ps.size != xs.size) bad("арность блока");
    else {
      binds = array{};
      for(i : range(xs.size)) {
        t = ty(xs[i]);
        if(!scalar(t)) bad(fmt"аргумент блока типа {t}");
        gen(xs[i]);
        sl = alloc(1);
        store_slot(t, sl);
        array{pname, ...prest} = code_fields(ps[i]);
        binds.push(jc_var{pname, t, sl, false, f, 0, 0, 0, 0});
      }
      if(ok) in_view(v.th_top, v.th_base, v.th_ctx, v.th_ret, () => {
        for(b : binds) put(b);
        gen(body);
      });
    }
  };
  // ветка или тело цикла: spawn внутри свёртывается только с for в ней же
  in_region(g) => {
    saved = region;
    regions += 1;
    region = regions;
    g();
    for(x : gens) if(x.region == region) bad("spawn без for по его потоку в той же области");
    region = saved;
  };
  // имена в коде (для того, что W читает снаружи)
  idents(c, found) => {
    if(code_kind(c) == n_ident) {
      array{nm} = code_fields(c);
      found.push(nm);
    }
    for(x : code_items(c)) idents(x, found);
  };
  pending(i64 sl) => {
    r = false;
    for(g : gens) if(has(g.caps, sl)) r = true;
    r
  };
  // spawn { W }: генератор ждёт for по своему потоку
  gen_spawn(e, b) => {
    v = var_of(b);
    if(fusing) bad("spawn внутри генератора");
    else if((v < 0) || !env[v].thunk) bad("spawn");
    else {
      w = env[v];
      names = array{};
      idents(w.th, names);
      caps = array{};
      in_view(w.th_top, w.th_base, w.th_ctx, w.th_ret, () => {
        for(nm : names) {
          k = find(nm);
          if((k >= 0) && !env[k].thunk) caps.push(env[k].slot);
        }
      });
      gens.push(jc_gen{w.th, w.th_ctx, w.th_top, w.th_base, w.th_ret, region, caps, e});
    }
  };
  // for(stream s, expr body) по потоку, который видит ожидающий spawn: номер генератора
  generator_of(a) => {
    k = -1;
    if(!fusing && (gens.size > 0)) {
      v = var_of(a);
      if((v >= 0) && (!env[v].thunk && is_stream(env[v].kind))) {
        for(i : range(gens.size)) if((k < 0) && has(gens[i].caps, env[v].slot)) k = i;
      }
    }
    k
  };
  is_block(c) => (code_kind(c) == n_lambda) && {
    array{_, _, block} = code_fields(c);
    block
  };
  // B не выходит из цикла for: нет return, break/continue — только своих циклов
  consumer_stays(c, i64 inl) => {
    k = code_kind(c);
    if(k == n_return) false
    else if(((k == n_break) || (k == n_continue)) && (inl == 0)) false
    else {
      inner = inl + if((k == n_loop) || is_block(c)) 1 else 0;
      r = true;
      for(x : code_items(c)) if(r && !consumer_stays(x, inner)) r = false;
      r
    }
  };
  arity_fns(str nm, i64 n) => {
    fs = array{};
    for(g : functions_named(nm)) {
      array{_, ps, ...rest} = code_fields(g);
      if(ps.size == n) fs.push(g);
    }
    fs
  };
  // return/throw/close вне хвоста W (с вызванными функциями)
  gen_escapes(c, seen) => {
    k = code_kind(c);
    r = false;
    if((k == n_return) || (k == n_throw)) r = true;
    else if(k == n_call) {
      array{cal, cxs, ...rest} = code_fields(c);
      nm = callee_name(cal);
      if(nm == "close") r = true;
      else if(nm != "") {
        for(g : arity_fns(nm, cxs.size)) if(!r && !has(seen, code_id(g))) {
          seen.push(code_id(g));
          array{_, _, _, gb, ...grest} = code_fields(g);
          if(gen_escapes(gb, seen)) r = true;
        }
      }
    }
    for(x : code_items(c)) if(!r && gen_escapes(x, seen)) r = true;
    r
  };
  // перегрузка вызова в теле W по типам разбора (контекст встраивания cc): одна или нет
  pick_fn(str nm, cxs, i64 cc) => {
    fs = array{};
    for(g : arity_fns(nm, cxs.size)) {
      array{_, ps, ...rest} = code_fields(g);
      fits = true;
      for(i : range(ps.size)) {
        array{_, pt, ...prest} = code_fields(ps[i]);
        if(given(pt)) {
          want = type_of_code(pt);
          at = jit_type(cxs[i], cc);
          if(!given(want) || !given(at)) fits = false;
          else if((want != at) && (want != type_family(at))) fits = false;
        }
      }
      if(fits) fs.push(g);
    }
    fs
  };
  // W кончается close(s): последнее действие — close или вызов, который им кончается
  gen_tail(c, seen, i64 cc) => {
    k = code_kind(c);
    if(k == n_lambda) {
      array{_, lb, _} = code_fields(c);
      gen_tail(lb, seen, cc)
    } else if(k == n_block) {
      array{items, ...rest} = code_fields(c);
      r = items.size > 0;
      for(i : range(items.size)) if(r && (((i + 1) < items.size) && gen_escapes(items[i], seen))) r = false;
      r && gen_tail(items[items.size - 1], seen, cc)
    } else if(k != n_call) false
    else {
      array{cal, cxs, ...rest} = code_fields(c);
      nm = callee_name(cal);
      if(nm == "") false
      else if(nm == "close") true
      else {
        r = true;
        for(x : cxs) if(r && gen_escapes(x, seen)) r = false;
        fs = pick_fn(nm, cxs, cc);
        if(!r || ((fs.size != 1) || has(seen, code_id(fs[0])))) false
        else {
          seen.push(code_id(fs[0]));
          array{_, _, _, fb, ...frest} = code_fields(fs[0]);
          gen_tail(fb, seen, inline_context(cc, c))
        }
      }
    }
  };
  gen_fused(e, xs, i64 k) => {
    g = gens[k];
    v = var_of(xs[0]);
    sl = env[v].slot;
    body = xs[1];
    others = false;
    for(i : range(gens.size)) if((i != k) && has(gens[i].caps, sl)) others = true;
    if(g.region != region) bad("for по потоку генератора — не в области spawn");
    else if(others) bad("поток видят несколько spawn");
    else if(!is_block(body)) bad("тело for");
    else {
      array{bps, bb, _} = code_fields(body);
      if(bps.size != 1) bad("тело for");
      else if(!consumer_stays(bb, 0)) bad("тело for выходит из цикла");
      else if(!gen_tail(g.w, array{}, g.w_ctx)) bad("генератор: close(s) — не последнее действие, или return/throw");
      else {
        rest = array{};
        for(i : range(gens.size)) if(i != k) rest.push(gens[i]);
        gens = rest;
        f_stream = sl;
        f_elem = elem(env[v].kind);
        f_body = body;
        f_env = env;
        f_top = top;
        f_base = base;
        f_ctx = ctx;
        f_cur = cur;
        f_outer = array{};
        for(i : range(g.w_top)) if(!env[i].thunk) f_outer.push(env[i].slot);
        f_caps = g.caps;
        f_closes = 0;
        fusing = true;
        in_view(g.w_top, g.w_base, g.w_ctx, g.w_ret, () => {
          wb = g.w;
          if(code_kind(wb) == n_lambda) {
            array{_, lb, _} = code_fields(wb);
            wb = lb;
          }
          gen(wb);
        });
        fusing = false;
        if(f_closes != 1) bad("генератор: close(s) не один раз");
        // поток после цикла — закрытый и пустой, как после настоящего обмена
        put_bytes(cg.load(acc, frame, off(sl)));
        put_bytes(cg.move(ca1, acc));
        vm_service(4, unit, e);
      }
    }
  };
  // операция VM внутри W: write(s, v) — тело потребителя с x = v; close(s) — конец
  sink(e, i64 op, xs) => {
    v = if(xs.size > 0) var_of(xs[0]) else -1;
    if((v < 0) || (env[v].thunk || ((env[v].slot != f_stream) || ((op != 1) && (op != 4))))) bad("генератор: другая операция VM");
    else if(op == 4) f_closes += 1;
    else {
      t = ty(xs[1]);
      if(t != f_elem) bad("тип записи ≠ типу потока");
      else {
        gen(xs[1]);
        p = alloc(1);
        store_bytes(t, p);
        array{bps, bb, _} = code_fields(f_body);
        array{pname, ...prest} = code_fields(bps[0]);
        w_env = env;
        w_top = top;
        w_base = base;
        w_ctx = ctx;
        w_cur = cur;
        env = f_env;
        top = f_top;
        base = f_base;
        ctx = f_ctx;
        cur = f_cur;
        in_b = true;
        put(jc_var{pname, t, p, false, f, 0, 0, 0, 0});
        gen(bb);
        in_b = false;
        env = w_env;
        top = w_top;
        base = w_base;
        ctx = w_ctx;
        cur = w_cur;
      }
    }
  };
  entry = label();
  bind(entry); // начало кода — цель call_self
  ret = label();
  fr_fn.push(f);
  fr_exit.push(ret);
  fr_parent.push(-1);
  put_bytes(cg.frame_enter());
  put_bytes(cg.move(frame, stack));
  frame_at = out.size;
  frame_size = (i64 n) => cg.frame_alloc(n);
  put_bytes(frame_size(0));
  array{_, fps, _, fbody, ...frest} = code_fields(f);
  ap = 0; // слово в области аргументов
  for(i : range(fps.size)) {
    array{pname, ...prest} = code_fields(fps[i]);
    s = declare(pname, types[i]);
    for(w : range(if(is_arr(types[i])) 2 else 1)) {
      put_bytes(cg.load(acc, argbase, 8 * ap));
      put_bytes(cg.store(frame, off(s + w), acc));
      ap += 1;
    }
  }
  args_slot = alloc(1); // база области аргументов — для ловушек
  put_bytes(cg.store(frame, off(args_slot), argbase));
  if(ok) gen(fbody);
  if(gens.size > 0) bad("spawn (файбер) — интерпретатор");
  bind(ret);
  if(result == f64) put_bytes(cg.move_from_f64(acc, acc_f)); // f64 — битами в аккумуляторе
  put_bytes(cg.move(stack, frame));
  put_bytes(cg.frame_leave());
  put_bytes(cg.ret());
  // заглушки ловушек: вид и узел — в слоты области аргументов, выход
  for(x : faults) {
    bind(x[0]);
    if(x[1] == -2) { // ошибка VM в try — в catch, сняв временные
      if(x[3] > 0) put_bytes(cg.stack_free(8 * x[3]));
      jump(x[2]);
      continue;
    }
    put_bytes(cg.load(second, frame, off(args_slot)));
    if(x[1] < 0) { // ошибка вызванного: вид, узел, значение, тип — из его области (смещение слова — x[2])
      for(q : range(4)) {
        put_bytes(cg.load(acc, frame, x[2] + (8 * q)));
        put_bytes(cg.store(second, 8 * (ap + q), acc));
      }
    } else {
      put_bytes(cg.load_const(acc, x[1]));
      put_bytes(cg.store(second, 8 * ap, acc));
      put_bytes(cg.load_const(acc, x[2]));
      put_bytes(cg.store(second, 8 * (ap + 1), acc));
    }
    jump(ret);
  }
  if(!ok) return why; // не умеет — причина (код даст склейка C++)
  for(i : range(fix_at.size)) {
    bytes = fix_mk[i](labels[fix_label[i]] - fix_at[i]);
    for(j : range(bytes.size)) out[fix_at[i] + j] = bytes[j];
  }
  bytes = frame_size(((8 * nslots) + 15) & -16);
  for(j : range(bytes.size)) out[frame_at + j] = bytes[j];
  if(jumps > 0) array{out, fmt"исключений переходом: {jumps}"} else out
}
