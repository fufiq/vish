module proto;
// The editor<->VM protocol codec in the language - a port of include/vish/proto.hpp, part of the frames and messages (E7a of the porting plan, branch
// t3/cpp-to-vish-migration; the user's goal: "C++ is only the link between the VM and the OS"). A frame is not JSON: a u32 body length, the body is a u32 message kind
// number and the fields in order (the same as the database journal, serial.hpp): "because it is more reliable, simpler, better" (the author's remark about a binary protocol versus a text one).
// The client (c_*) and VM (s_*) messages are described by C++ aggregates (proto.hpp); their schema is data (`vish schema`, editor/src/protocol/schema.json):
// "in Rust you generate the serializer at once, and in C++ you do not need it". Here is one reader and
// one writer by the schema, as in the client (editor/src/protocol/codec.ts): parsing the schema from JSON, reading/writing a frame, taking frames from a stream,
// the flat tree of a VM message (the same as proto::flat) and a client message from field values (the same as proto::client_from).
// "Parsing logic and syntax are defined by logic in the language itself" (R1); "all your communication with the outside world
// goes through it" - about the VM (R9): the socket stays with the host (C++), and what is in a frame is decided by the language. The text form of the scenarios
// (.wire) has long been in the language (lib/tests.vish: client_message, describe).
// The C++ version stays working (the switch is E8). Equivalence is `vish protocheck <files>`: on the frames from the tests/*.wire scenarios (the frames
// that the client and the VM actually exchanged), on messages generated by the schema with corruption (a truncation, an extra byte, a foreign kind) and on
// boundary frames from text (tests/data/protocheck/*.txt) the parse, the flat tree, the re-encoding and the error texts match C++.
// Not supported (an explicit refusal - the proto_error exception): an f64 field (the protocol has none), a bool byte other than 0 and 1 (in C++ this is undefined).

use tools;
use tests;
// --- primitives (the VM's): the C++ reference (stage0) - for comparison only; each is *mine, temporary* until proto.hpp goes away ------------------
// the protocol schema as JSON, like `vish schema`
proto_schema_reference() => native "cpp" { return value(proto::schema()); };
// parsing a C++ VM message body: array{parsed, error, flat tree, the frame (length+body) after re-encoding}
proto_ref_server(str body) => native "cpp" {
  if(!a[0].known()) return erase(value(array_v::of({})));
  proto::server_msg m;
  try {
    proto::decode(a[0].as<str_v>().view(), m);
  } catch(diagnostic const & d) {
    return value(array_v::of({value(false), value(std::string(d.what())), value(array_v::of({})), value(std::string())}));
  }
  return value(array_v::of({value(true), value(std::string()), flat_value(m), value(proto::frame(m))}));
};
// parsing a C++ client message body: array{parsed, error, name, field values, the frame after re-encoding}; the values are strings as they are,
// a node is a decimal number, the rest are decimal unsigned
proto_ref_client(str body) => native "cpp" {
  if(!a[0].known()) return erase(value(array_v::of({})));
  proto::client_msg m;
  try {
    proto::decode(a[0].as<str_v>().view(), m);
  } catch(diagnostic const & d) {
    return value(array_v::of({value(false), value(std::string(d.what())), value(std::string()), value(array_v::of({})), value(std::string())}));
  }
  std::vector<std::string> vals;
  std::string name = std::visit([&](auto const & x) {
    template for(constexpr auto f: fields_of<std::remove_cvref_t<decltype(x)>>()) {
      auto const & v = x.[:f:];
      using T = std::remove_cvref_t<decltype(v)>;
      if constexpr(std::is_same_v<T, std::string>) vals.push_back(v);
      else if constexpr(std::is_same_v<T, node_id>) vals.push_back(cat(v.value));
      else vals.push_back(cat(uint64_t(v)));
    }
    return std::string(proto::short_name(std::meta::remove_cvref(^^decltype(x))));
  }, m);
  return value(array_v::of({value(true), value(std::string()), value(std::move(name)), strings_value(vals), value(proto::frame(m))}));
};
// a client message from field values (client_from) as a frame: array{there is such a kind, the frame}
proto_ref_client_frame(str name, values) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto m = proto::client_from(a[0].as<str_v>().view(), strings_of(a[1]));
  if(!m) return value(array_v::of({value(false), value(std::string())}));
  return value(array_v::of({value(true), value(proto::frame(*m))}));
};
// take frames from a C++ stream (take_frames): array{the frame bodies, the remainder}
proto_ref_take(str in) => native "cpp" {
  if(!a[0].known()) return erase(value(array_v::of({})));
  std::string buf(a[0].as<str_v>().view());
  std::vector<std::string> bodies;
  proto::take_frames(buf, [&](std::string_view body) { bodies.emplace_back(body); });
  return value(array_v::of({strings_value(bodies), value(std::move(buf))}));
};
proto_ref_version() => native "cpp" { return value(int64_t(proto::version)); };
// the frames that the client and the VM exchanged in the scenarios (after proto_tap_start): lines "c|s" + the body
proto_tap_start() => native "cpp" {
  proto::tap_frames.clear();
  proto::tap_on = true;
  return value(int64_t(0));
};
proto_tap_take() => native "cpp" {
  auto r = std::move(proto::tap_frames);
  proto::tap_frames.clear();
  proto::tap_on = false;
  return strings_value(r);
};
// --- schema --------------------------------------------------------------------------------------------------------------------
// type: tag - 1 bool, 2 u8, 3 u32, 4 u64, 5 i64, 6 f64, 7 string, 8 node, 10 vector (targs: the element), 11 variant (targs: the alternatives),
// 12 aggregate (ix is the number in the schema)
struct ty { i64 tag; i64 ix; array targs; }
struct fld { str name; ty t; }
struct sagg { str name; array fields; }
struct schema { i64 version; ty client; ty server; array kinds; array aggs; }
struct proto_error { str what; }
// --- schema JSON (only what is in the schema: objects, arrays, strings without escaping, integers) ---------------------------------------
struct jv { i64 k; str s; i64 n; array items; array keys; }
struct jp { str src; i64 at; }
jv_fail(mut jp p, str why) => throw proto_error{"схема: " + why + " в байте " + text(p.at)};
jv_skip(mut jp p) {
  while((p.at < p.src.size) && ((p.src[p.at] == 32) || ((p.src[p.at] == 10) || ((p.src[p.at] == 13) || (p.src[p.at] == 9))))) p.at += 1;
}
jv_string(mut jp p) {
  p.at += 1;
  start = p.at;
  while((p.at < p.src.size) && (p.src[p.at] != 34)) {
    if(p.src[p.at] == 92) jv_fail(p, "экранирование не поддержано");
    p.at += 1;
  }
  if(p.at >= p.src.size) jv_fail(p, "строка не закрыта");
  s = text_range(p.src, start, p.at);
  p.at += 1;
  s
}
jv_value(mut jp p) {
  jv_skip(p);
  if(p.at >= p.src.size) jv_fail(p, "неожиданный конец");
  c = p.src[p.at];
  if(c == 34) return jv{0, jv_string(p), 0, array{}, array{}};
  if((c >= 48) && (c <= 57)) {
    n = 0;
    while((p.at < p.src.size) && ((p.src[p.at] >= 48) && (p.src[p.at] <= 57))) {
      n = (n * 10) + (p.src[p.at] - 48);
      p.at += 1;
    }
    return jv{1, "", n, array{}, array{}};
  }
  if(c == 91) {
    p.at += 1;
    items = array{};
    jv_skip(p);
    if((p.at < p.src.size) && (p.src[p.at] == 93)) {
      p.at += 1;
      return jv{2, "", 0, items, array{}};
    }
    loop {
      items.push(jv_value(p));
      jv_skip(p);
      if(p.at >= p.src.size) jv_fail(p, "массив не закрыт");
      if(p.src[p.at] == 44) {
        p.at += 1;
        continue;
      }
      if(p.src[p.at] == 93) {
        p.at += 1;
        break;
      }
      jv_fail(p, "ожидалась , или ]");
    }
    return jv{2, "", 0, items, array{}};
  }
  if(c == 123) {
    p.at += 1;
    items = array{};
    keys = array{};
    jv_skip(p);
    if((p.at < p.src.size) && (p.src[p.at] == 125)) {
      p.at += 1;
      return jv{3, "", 0, items, keys};
    }
    loop {
      jv_skip(p);
      if((p.at >= p.src.size) || (p.src[p.at] != 34)) jv_fail(p, "ожидался ключ");
      keys.push(jv_string(p));
      jv_skip(p);
      if((p.at >= p.src.size) || (p.src[p.at] != 58)) jv_fail(p, "ожидалось :");
      p.at += 1;
      items.push(jv_value(p));
      jv_skip(p);
      if(p.at >= p.src.size) jv_fail(p, "объект не закрыт");
      if(p.src[p.at] == 44) {
        p.at += 1;
        continue;
      }
      if(p.src[p.at] == 125) {
        p.at += 1;
        break;
      }
      jv_fail(p, "ожидалась , или }");
    }
    return jv{3, "", 0, items, keys};
  }
  jv_fail(p, "неожиданный знак");
  jv{0, "", 0, array{}, array{}}
}
jv_get(jv o, str key) {
  for(i : range(o.keys.size)) if(o.keys[i] == key) return o.items[i];
  throw proto_error{"схема: нет поля " + key}
}
prim_tag(str s) => if(s == "bool") 1 else if(s == "u8") 2 else if(s == "u32") 3 else if(s == "u64") 4 else if(s == "i64") 5 else if(s == "f64") 6 else if(s == "string") 7 else if(s == "node") 8 else 0;
type_of_json(jv j, names) {
  if(j.k == 0) {
    t = prim_tag(j.s);
    if(t != 0) return ty{t, 0, array{}};
    for(i : range(names.size)) if(names[i] == j.s) return ty{12, i, array{}};
    throw proto_error{"схема: нет типа " + j.s}
  }
  if((j.k != 2) || (j.items.size == 0) || (j.items[0].k != 0)) throw proto_error{"схема: тип — строка или массив"};
  targs = array{};
  for(i : range(j.items.size)) if(i > 0) targs.push(type_of_json(j.items[i], names));
  head = j.items[0].s;
  if(head == "vector") {
    if(targs.size != 1) throw proto_error{"схема: vector ждёт один тип"};
    return ty{10, 0, targs};
  }
  if(head == "variant") return ty{11, 0, targs};
  throw proto_error{"схема: неизвестный конструктор " + head}
}
// a schema from JSON text (`vish schema`)
schema_load(str src) {
  p = jp{src, 0};
  root = jv_value(p);
  types = jv_get(root, "types");
  names = types.keys;
  aggs = array{};
  for(i : range(names.size)) {
    fs = array{};
    for(f : types.items[i].items) fs.push(fld{f.items[0].s, type_of_json(f.items[1], names)});
    aggs.push(sagg{names[i], fs});
  }
  kinds = array{};
  for(k : jv_get(root, "node_kinds").items) kinds.push(k.s);
  schema{jv_get(root, "version").n, type_of_json(jv_get(root, "client"), names), type_of_json(jv_get(root, "server"), names), kinds, aggs}
}
// --- values ----------------------------------------------------------------------------------------------------------------
// a value by the schema: tag - as in the type; n - a number (u64 as bits; bool as a byte), s - a string, ix - the aggregate number or the variant's alternative,
// kids - the aggregate's fields, the vector's elements or the variant's only value
struct pv { i64 tag; i64 n; str s; i64 ix; array kids; }
width_of(i64 tag) => if(tag == 1) 1 else if(tag == 2) 1 else if(tag == 3) 4 else if(tag == 8) 4 else 8;
// --- reading (reader from serial.hpp) -------------------------------------------------------------------------------------------
struct rd { str buf; i64 at; }
need(mut rd r, i64 n) {
  if(n > (r.buf.size - r.at)) throw proto_error{"журнал повреждён: неожиданный конец"};
}
// n bytes - a number (little-endian)
get_uint(mut rd r, i64 n) {
  need(r, n);
  v = 0;
  for(k : range(n)) v = v | (r.buf[r.at + k] << (8 * k));
  r.at += n;
  v
}
read_val(schema sc, ty t, mut rd r) {
  tag = t.tag;
  if(tag == 7) {
    n = get_uint(r, 4);
    need(r, n);
    s = text_range(r.buf, r.at, r.at + n);
    r.at += n;
    return pv{7, 0, s, 0, array{}};
  }
  if(tag == 10) {
    n = get_uint(r, 4);
    kids = array{};
    k = 0;
    while(k < n) {
      kids.push(read_val(sc, t.targs[0], r));
      k += 1;
    }
    return pv{10, n, "", 0, kids};
  }
  if(tag == 11) {
    ix = get_uint(r, 4);
    if(ix >= t.targs.size) throw proto_error{"журнал повреждён: вид " + text(ix) + " неизвестен"};
    return pv{11, 0, "", ix, array{read_val(sc, t.targs[ix], r)}};
  }
  if(tag == 12) {
    kids = array{};
    for(f : sc.aggs[t.ix].fields) kids.push(read_val(sc, f.t, r));
    return pv{12, 0, "", t.ix, kids};
  }
  if(tag == 6) throw proto_error{"f64 не поддержан"};
  w = width_of(tag);
  v = get_uint(r, w);
  if((tag == 1) && (v > 1)) throw proto_error{"bool-байт кроме 0 и 1 не поддержан"};
  pv{tag, v, "", 0, array{}}
}
struct decoded { bool ok; str err; pv msg; }
nothing() => pv{0, 0, "", 0, array{}};
// the frame body is the root message (client or server); an error - with the same text as proto::decode
msg_decode(schema sc, ty root, str body) {
  r = rd{body, 0};
  try {
    m = read_val(sc, root, r);
    if(r.at < body.size) throw proto_error{"протокол: лишние байты в кадре"};
    decoded{true, "", m}
  } catch(proto_error e) {
    decoded{false, e.what, nothing()}
  }
}
// --- writing (writer from serial.hpp) -------------------------------------------------------------------------------------------
put_uint(mut text_buffer out, i64 v, i64 n) {
  for(k : range(n)) put(out, text_byte((v >> (8 * k)) & 255));
}
write_val(schema sc, ty t, pv v, mut text_buffer out) {
  tag = t.tag;
  if(tag == 7) {
    put_uint(out, v.s.size, 4);
    put(out, v.s);
  } else if(tag == 10) {
    put_uint(out, v.kids.size, 4);
    for(x : v.kids) write_val(sc, t.targs[0], x, out);
  } else if(tag == 11) {
    put_uint(out, v.ix, 4);
    write_val(sc, t.targs[v.ix], v.kids[0], out);
  } else if(tag == 12) {
    fs = sc.aggs[t.ix].fields;
    for(i : range(fs.size)) write_val(sc, fs[i].t, v.kids[i], out);
  } else {
    put_uint(out, v.n, width_of(tag));
  }
}
// the body of the root message
msg_encode(schema sc, ty root, pv m) {
  out = text_buffer();
  write_val(sc, root, m, out);
  take(out)
}
// a frame: a u32 body length and the body
frame_of(str body) {
  out = text_buffer();
  put_uint(out, body.size, 4);
  put(out, body);
  take(out)
}
struct taken { array bodies; str rest; }
// all the whole frames from a stream (take_frames): the bodies and the remainder
frames_take(str buf) {
  at = 0;
  bodies = array{};
  loop {
    if((buf.size - at) < 4) break;
    n = buf[at] + (buf[at + 1] * 256) + (buf[at + 2] * 65536) + (buf[at + 3] * 16777216);
    if(((buf.size - at) - 4) < n) break;
    bodies.push(text_range(buf, at + 4, at + 4 + n));
    at += 4 + n;
  }
  taken{bodies, text_from(buf, at)}
}
// --- numbers and texts ----------------------------------------------------------------------------------------------------------
// an unsigned number by bits n - in tens without an i64 overflow: the high and the low 32 bits
u64_divmod10(i64 n) {
  hi = (n >> 32) & 0xFFFFFFFF;
  lo = n & 0xFFFFFFFF;
  t = ((hi % 10) * 4294967296) + lo;
  array{((hi / 10) * 4294967296) + (t / 10), t % 10}
}
u64_text(i64 n) {
  if(n >= 0) return text(n);
  s = "";
  x = n;
  loop {
    d = u64_divmod10(x);
    s = text(d[1]) + s;
    x = d[0];
    if(x == 0) break;
  }
  s
}
// a number from decimal digits w, like std::from_chars into uint64_t: the longest prefix of digits; no digits or an overflow - 0
u64_parse(str w) {
  hi = 0;
  lo = 0;
  k = 0;
  while((k < w.size) && ((w[k] >= 48) && (w[k] <= 57))) {
    lo2 = (lo * 10) + (w[k] - 48);
    hi2 = (hi * 10) + (lo2 >> 32);
    if(hi2 >= 4294967296) return 0;
    lo = lo2 & 0xFFFFFFFF;
    hi = hi2;
    k += 1;
  }
  (hi << 32) | lo
}
// --- the flat tree of a VM message (proto::flat) ---------------------------------------------------------------------------------
struct flat { array kind; array name; array text; array num; array count; array next; }
flat_put(mut flat f, str k, str n, str t, i64 x, i64 c) {
  f.kind.push(k);
  f.name.push(n);
  f.text.push(t);
  f.num.push(x);
  f.count.push(c);
  f.next.push(0);
  f.kind.size - 1
}
flat_value(schema sc, ty t, pv v, str name, mut flat f) {
  tag = t.tag;
  if(tag == 8) {
    flat_put(f, "node", name, "", if(v.n == 0xFFFFFFFF) -1 else v.n, 0);
  } else if(tag == 7) {
    flat_put(f, "str", name, v.s, 0, 0);
  } else if(tag == 1) {
    flat_put(f, "num", name, if(v.n != 0) "true" else "false", if(v.n != 0) 1 else 0, 0);
  } else if(tag == 5) {
    flat_put(f, "num", name, text(v.n), v.n, 0);
  } else if(tag == 4) {
    flat_put(f, "num", name, u64_text(v.n), v.n, 0);
  } else if((tag == 2) || (tag == 3)) {
    flat_put(f, "num", name, text(v.n), v.n, 0);
  } else if(tag == 11) {
    flat_value(sc, t.targs[v.ix], v.kids[0], name, f);
  } else if(tag == 10) {
    e = t.targs[0];
    at = flat_put(f, "list", name, if(e.tag == 12) "structs" else "values", 0, v.kids.size);
    for(x : v.kids) flat_value(sc, e, x, "", f);
    f.next[at] = f.kind.size;
  } else if(tag == 12) {
    fs = sc.aggs[t.ix].fields;
    at = flat_put(f, "struct", name, "", 0, fs.size);
    for(i : range(fs.size)) flat_value(sc, fs[i].t, v.kids[i], fs[i].name, f);
    f.next[at] = f.kind.size;
  } else {
    throw proto_error{"f64 не поддержан"}
  }
  last = f.next.size - 1;
  if(f.next[last] == 0) f.next[last] = f.kind.size;
}
// the kind name without the c_/s_ prefix
short_of(str n) => text_from(n, 2);
// a VM message as a flat tree: a message is an aggregate under a variant
msg_flat(schema sc, pv m) {
  f = flat{array{}, array{}, array{}, array{}, array{}, array{}};
  a = sc.aggs[sc.server.targs[m.ix].ix];
  inner = m.kids[0];
  at = flat_put(f, "struct", short_of(a.name), "", 0, a.fields.size);
  for(i : range(a.fields.size)) flat_value(sc, a.fields[i].t, inner.kids[i], a.fields[i].name, f);
  f.next[at] = f.kind.size;
  f
}
esc(str s) => replace_all(replace_all(replace_all(s, "\\", "\\\\"), "\n", "\\n"), "\t", "\\t");
// six arrays of the flat tree - as text by record
flat_text(kind, name, txt, num, count, next) {
  out = text_buffer();
  for(i : range(kind.size)) put(out, kind[i] + "\t" + esc(name[i]) + "\t" + esc(txt[i]) + "\t" + text(num[i]) + "\t" + text(count[i]) + "\t" + text(next[i]) + "\n");
  take(out)
}
// --- a client message from field values (proto::client_from) -------------------------------------------------------------------
// the number of the client kind named name (without c_); -1 - none
client_index(schema sc, str name) {
  for(k : range(sc.client.targs.size)) if(short_of(sc.aggs[sc.client.targs[k].ix].name) == name) return k;
  -1
}
// values in field order: strings as they are, numbers and nodes decimal (from digits - like from_chars), missing ones - by default
// (a string is empty, a number is 0, a node is "none"); for a narrower number the low bits, bool - non-zero
msg_from_values(schema sc, str name, values) {
  k = client_index(sc, name);
  if(k < 0) return nothing();
  fs = sc.aggs[sc.client.targs[k].ix].fields;
  kids = array{};
  for(i : range(fs.size)) {
    tag = fs[i].t.tag;
    has = i < values.size;
    if(tag == 7) {
      kids.push(pv{7, 0, if(has) values[i] else "", 0, array{}});
    } else if(tag == 8) {
      kids.push(pv{8, if(has) (u64_parse(values[i]) & 0xFFFFFFFF) else 0xFFFFFFFF, "", 0, array{}});
    } else if((tag == 1) || ((tag == 2) || ((tag == 3) || ((tag == 4) || (tag == 5))))) {
      x = if(has) u64_parse(values[i]) else 0;
      kids.push(pv{tag, if(tag == 1) (if(x != 0) 1 else 0) else if(tag == 2) (x & 255) else if(tag == 3) (x & 0xFFFFFFFF) else x, "", 0, array{}});
    } else {
      throw proto_error{"поле сообщения клиента не скаляр: " + fs[i].name}
    }
  }
  pv{11, 0, "", k, array{pv{12, 0, "", sc.client.targs[k].ix, kids}}}
}
// the field values of a parsed client message (as in the C++ reference proto_ref_client): strings as they are, nodes and numbers decimal
msg_values(schema sc, pv m) {
  out = array{};
  for(x : m.kids[0].kids) out.push(if(x.tag == 7) x.s else if(x.tag == 1) (if(x.n != 0) "1" else "0") else u64_text(x.n));
  out
}
msg_name(schema sc, pv m) => short_of(sc.aggs[m.kids[0].ix].name);
// client messages by kind: array{name, fields, field kinds (string, node, num)}, as proto::client_kinds
client_kinds_of(schema sc) {
  out = array{};
  for(t : sc.client.targs) {
    a = sc.aggs[t.ix];
    fs = array{};
    ks = array{};
    for(f : a.fields) {
      fs.push(f.name);
      ks.push(if(f.t.tag == 7) "string" else if(f.t.tag == 8) "node" else "num");
    }
    out.push(array{short_of(a.name), fs, ks});
  }
  out
}
// the protocol version of the hello client: empty - accepted, otherwise the error text, as in server::handle(c_hello)
hello_error(i64 client_version, i64 vm_version) => if(client_version == vm_version) "" else "версия протокола " + text(client_version) + " не поддерживается (VM: " + text(vm_version) + ")";
// --- comparison with C++ (vish protocheck) ---------------------------------------------------------------------------------------------
struct tally { i64 frames; i64 bad; i64 ok_frames; i64 err_frames; }
show_bad(str where, str what, str mine, str ref) {
  write_out(where + ": " + what + ": расхождение\n  vish: " + mine + "\n  C++:  " + ref + "\n");
}
flat_of_ref(r) => flat_text(r[0], r[1], r[2], r[3], r[4], r[5]);
// one body: dir is "c" or "s"; ok_only - do not print the details again
check_body(schema sc, str dir, str body, str where, mut tally t) {
  t.frames += 1;
  if(dir == "c") {
    mine = msg_decode(sc, sc.client, body);
    ref = proto_ref_client(body);
    if(mine.ok != ref[0]) {
      t.bad += 1;
      show_bad(where, "разбор клиентского кадра", text(mine.ok) + " " + mine.err, text(ref[0]) + " " + ref[1]);
      return 0;
    }
    if(!mine.ok) {
      t.err_frames += 1;
      if(mine.err != ref[1]) {
        t.bad += 1;
        show_bad(where, "ошибка разбора клиентского кадра", mine.err, ref[1]);
      }
      return 0;
    }
    t.ok_frames += 1;
    vals = msg_values(sc, mine.msg);
    if(msg_name(sc, mine.msg) != ref[2]) {
      t.bad += 1;
      show_bad(where, "имя сообщения клиента", msg_name(sc, mine.msg), ref[2]);
    }
    if(join_lines(vals) != join_lines(ref[3])) {
      t.bad += 1;
      show_bad(where, "поля сообщения клиента", join_lines(vals), join_lines(ref[3]));
    }
    if(frame_of(msg_encode(sc, sc.client, mine.msg)) != frame_of(body)) {
      t.bad += 1;
      show_bad(where, "повторная запись (vish)", "не совпала с телом", "");
    }
    if(ref[4] != frame_of(body)) {
      t.bad += 1;
      show_bad(where, "повторная запись (C++)", "не совпала с телом", "");
    }
    again = proto_ref_client_frame(msg_name(sc, mine.msg), vals);
    built = msg_from_values(sc, msg_name(sc, mine.msg), vals);
    if(!again[0] || (frame_of(msg_encode(sc, sc.client, built)) != again[1])) {
      t.bad += 1;
      show_bad(where, "сообщение из значений полей", "кадр vish ≠ client_from C++", "");
    }
    return 0;
  }
  mine = msg_decode(sc, sc.server, body);
  ref = proto_ref_server(body);
  if(mine.ok != ref[0]) {
    t.bad += 1;
    show_bad(where, "разбор кадра VM", text(mine.ok) + " " + mine.err, text(ref[0]) + " " + ref[1]);
    return 0;
  }
  if(!mine.ok) {
    t.err_frames += 1;
    if(mine.err != ref[1]) {
      t.bad += 1;
      show_bad(where, "ошибка разбора кадра VM", mine.err, ref[1]);
    }
    return 0;
  }
  t.ok_frames += 1;
  f = msg_flat(sc, mine.msg);
  mine_flat = flat_text(f.kind, f.name, f.text, f.num, f.count, f.next);
  ref_flat = flat_of_ref(ref[2]);
  if(mine_flat != ref_flat) {
    t.bad += 1;
    show_diff_lines(where, "плоское дерево", mine_flat, ref_flat);
  }
  if(frame_of(msg_encode(sc, sc.server, mine.msg)) != frame_of(body)) {
    t.bad += 1;
    show_bad(where, "повторная запись (vish)", "не совпала с телом", "");
  }
  if(ref[3] != frame_of(body)) {
    t.bad += 1;
    show_bad(where, "повторная запись (C++)", "не совпала с телом", "");
  }
  0
}
join_lines(xs) {
  out = text_buffer();
  for(x : xs) put(out, esc(x) + "\n");
  take(out)
}
show_diff_lines(str f, str what, str mine, str ref) {
  a = lines_of(mine);
  b = lines_of(ref);
  k = 0;
  while((k < a.size) && ((k < b.size) && (a[k] == b[k]))) k += 1;
  write_out(f + ": " + what + ": расхождение в строке " + text(k) + "\n  vish: " + (if(k < a.size) a[k] else "—") + "\n  C++:  " + (if(k < b.size) b[k] else "—") + "\n");
}
// --- random messages by the schema (the series is deterministic) ------------------------------------------------------------------------
struct rng { i64 x; }
next_random(mut rng g, i64 m) {
  g.x = ((g.x * 1103515245) + 12345) & 0x7FFFFFFF;
  (g.x >> 8) % m
}
gen_val(schema sc, ty t, mut rng g, i64 depth) {
  tag = t.tag;
  if(tag == 7) {
    n = next_random(g, 6);
    s = "";
    for(k : range(n)) s = s + text_byte(if(next_random(g, 4) == 0) next_random(g, 256) else 97 + next_random(g, 26));
    return pv{7, 0, s, 0, array{}};
  }
  if(tag == 10) {
    n = if(depth > 3) 0 else next_random(g, 4);
    kids = array{};
    for(k : range(n)) kids.push(gen_val(sc, t.targs[0], g, depth + 1));
    return pv{10, n, "", 0, kids};
  }
  if(tag == 11) {
    ix = next_random(g, t.targs.size);
    return pv{11, 0, "", ix, array{gen_val(sc, t.targs[ix], g, depth + 1)}};
  }
  if(tag == 12) {
    kids = array{};
    for(f : sc.aggs[t.ix].fields) kids.push(gen_val(sc, f.t, g, depth + 1));
    return pv{12, 0, "", t.ix, kids};
  }
  pick = next_random(g, 5);
  if(tag == 1) return pv{1, next_random(g, 2), "", 0, array{}};
  if(tag == 2) return pv{2, if(pick == 0) 255 else if(pick == 1) 0 else next_random(g, 256), "", 0, array{}};
  if(tag == 8) return pv{8, if(pick == 0) 0xFFFFFFFF else if(pick == 1) 0 else next_random(g, 5000), "", 0, array{}};
  if(tag == 3) return pv{3, if(pick == 0) 0xFFFFFFFF else if(pick == 1) 0 else (next_random(g, 65536) << 8) | next_random(g, 256), "", 0, array{}};
  // u64 and i64: the edges and random 64 bits
  bits = (next_random(g, 65536) << 48) | (next_random(g, 65536) << 32) | (next_random(g, 65536) << 16) | next_random(g, 65536);
  pv{tag, if(pick == 0) -1 else if(pick == 1) 0 else if(pick == 2) 9223372036854775807 else bits, "", 0, array{}}
}
// body corruption: a truncation at all places (a short one) or at several, an extra byte, a foreign kind (99 and ~0)
mutations(str body, mut rng g) {
  out = array{};
  if(body.size <= 40) {
    for(cut : range(body.size)) out.push(text_range(body, 0, cut));
  } else {
    for(k : range(4)) out.push(text_range(body, 0, next_random(g, body.size)));
  }
  out.push(body + text_byte(0));
  if(body.size >= 4) {
    out.push(text_byte(99) + text_byte(0) + text_byte(0) + text_byte(0) + text_from(body, 4));
    out.push(text_byte(255) + text_byte(255) + text_byte(255) + text_byte(255) + text_from(body, 4));
  }
  out
}
// --- hexadecimal frames tests/data/protocheck/*.txt ----------------------------------------------------------------------------
hex_digit(i64 c) => if((c >= 48) && (c <= 57)) c - 48 else if((c >= 97) && (c <= 102)) c - 87 else if((c >= 65) && (c <= 70)) c - 55 else -1;
hex_body(str h) {
  out = text_buffer();
  k = 0;
  while((k + 1) < h.size) {
    a = hex_digit(h[k]);
    b = hex_digit(h[k + 1]);
    if((a < 0) || (b < 0)) break;
    put(out, text_byte((a * 16) + b));
    k += 2;
  }
  take(out)
}
// --- vish protocheck <files> ----------------------------------------------------------------------------------------------------
// *.wire, *.session - the scenario is executed (the client and VM frames are taken at proto::frame), each frame is compared; *.txt - lines "c|s <hex>"
// (// is a comment); without files - the schema, the client kinds, the version, taking frames and generated messages with corruption. Code 0 - no mismatches.
check_cli(files) {
  sc = schema_load(proto_schema_reference());
  t = tally{0, 0, 0, 0};
  checks = 0;
  // the schema: from C++ by reflection and from the client's file - one text; the client kinds - as in proto::client_kinds
  file_schema = "editor/src/protocol/schema.json";
  if(read_text(file_schema) != proto_schema_reference()) {
    t.bad += 1;
    show_bad(file_schema, "схема", "файл", "proto::schema()");
  }
  checks += 1;
  if(sc.version != proto_ref_version()) {
    t.bad += 1;
    show_bad("версия", "схема", text(sc.version), text(proto_ref_version()));
  }
  checks += 1;
  mine_kinds = "";
  for(k : client_kinds_of(sc)) mine_kinds = mine_kinds + k[0] + ":" + join_lines(k[1]) + join_lines(k[2]) + "\n";
  ref_kinds = "";
  for(k : proto_client_kinds()) ref_kinds = ref_kinds + k[0] + ":" + join_lines(k[1]) + join_lines(k[2]) + "\n";
  if(mine_kinds != ref_kinds) {
    t.bad += 1;
    show_diff_lines("виды клиента", "client_kinds", mine_kinds, ref_kinds);
  }
  checks += 1;
  if((hello_error(8, proto_ref_version()) != "") || (hello_error(7, 8) != "версия протокола 7 не поддерживается (VM: 8)")) {
    t.bad += 1;
    show_bad("hello", "версия", hello_error(7, 8), "версия протокола 7 не поддерживается (VM: 8)");
  }
  checks += 1;
  scen = 0;
  hexed = 0;
  scen_frames = 0;
  for(f : files) {
    if(ends_with(f, ".txt")) {
      for(line : lines_of(read_text(f))) {
        if((line.size < 3) || starts_with(line, "//")) continue;
        hexed += 1;
        check_body(sc, text_range(line, 0, 1), hex_body(text_from(line, 2)), f + ": " + line, t);
      }
      continue;
    }
    scen += 1;
    proto_tap_start();
    state_fresh();
    why = run_scenario(f);
    state_clear();
    frames = proto_tap_take();
    if(why != "") write_out(f + ": сценарий не прошёл (проверка кадров всё равно идёт): " + why + "\n");
    n = 0;
    for(x : frames) {
      n += 1;
      check_body(sc, text_range(x, 0, 1), text_from(x, 1), f + " кадр " + text(n), t);
    }
    scen_frames += n;
  }
  // generated: for every client and VM kind - several messages, writing, parsing, corruption
  g = rng{20261116};
  made = 0;
  stream = "";
  for(side : range(2)) {
    root = if(side == 0) sc.client else sc.server;
    dir = if(side == 0) "c" else "s";
    for(k : range(root.targs.size)) {
      for(rep : range(3)) {
        m = pv{11, 0, "", k, array{gen_val(sc, root.targs[k], g, 0)}};
        body = msg_encode(sc, root, m);
        made += 1;
        if(side == 0) stream = stream + frame_of(body);
        check_body(sc, dir, body, "сгенерировано " + dir + " " + text(k) + "." + text(rep), t);
        for(bad_body : mutations(body, g)) check_body(sc, dir, bad_body, "порча " + dir + " " + text(k) + "." + text(rep), t);
      }
    }
  }
  // taking frames: whole frames in a row and an incomplete tail (a truncation in the length and in the body)
  cuts = array{stream, text_range(stream, 0, stream.size - 1), text_range(stream, 0, 3), ""};
  for(cut : cuts) {
    mine = frames_take(cut);
    ref = proto_ref_take(cut);
    same = (mine.rest == ref[1]) && (mine.bodies.size == ref[0].size);
    if(same) for(i : range(mine.bodies.size)) if(mine.bodies[i] != ref[0][i]) same = false;
    if(!same) {
      t.bad += 1;
      show_bad("снятие кадров", "take_frames", text(mine.bodies.size) + " кадров, остаток " + text(mine.rest.size), text(ref[0].size) + " кадров, остаток " + text(ref[1].size));
    }
    checks += 1;
  }
  write_out("протокол: сценариев " + text(scen) + " (кадров " + text(scen_frames) + "), граничных кадров " + text(hexed) + ", сгенерировано " + text(made) + "; разобрано кадров " + text(t.frames) + " (целых " + text(t.ok_frames) + ", отказов разбора " + text(t.err_frames) + "), прочих проверок " + text(checks) + ", расхождений " + text(t.bad) + "\n");
  if(t.bad == 0) 0 else 1
}
