// Meta protocol information: client messages - array {имя, поля, виды полей (string, node, num)}
proto_client_kinds() => native "cpp" {
  std::vector<value> out;
  for(auto const & k: proto::client_kinds()) {
    std::vector<std::string> fs(k.fields.begin(), k.fields.end()), ks(k.kinds.begin(), k.kinds.end());
    out.push_back(value(array_v::of({value(std::string(k.name)), strings_value(fs), strings_value(ks)})));
  }
  return value(array_v::of(std::move(out)));
};
// Tests in children (fork): no more jobs at once; the results - in the order of files: array{outcome, exit code
// (signal - minus), the language performed the test to the end}. The child performs test_packed(файл, режим).
tests_start(files, i64 jobs, bool a64, str projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  tests_host->start(strings_of(a[0]), uint32_t(std::max<int64_t>(1, (a[1]).as<int64_t>())));
  tests_host->a64_mode = (a[2]).as<bool>();
  tests_host->projection = std::string((a[3]).as<str_v>().view());
  return value(int64_t(0));
};
tests_next() => native "cpp" {
  node_id f = tools_host->fn("test_packed");
  auto [text, code, whole] = tests_host->take_next([&](std::string const & path) {
    return std::string(vm.analyze_instance(f, {value(path), value(tests_host->a64_mode), value(tests_host->projection)}).as<str_v>().view());
  });
  return value(array_v::of({value(std::move(text)), value(int64_t(code)), value(whole)}));
};

// Header directives - `// ключ: значение` lines at the beginning of the file (up to the first line of code):
//   args: a b c          аргументы программы          stdin: строка        строка stdin (несколько)
//   out: текст           строка stdout по порядку     out2: текст          второй запуск с тем же состоянием
//   error: подстрока     ожидаемая ошибка             instances: f(...)    экземпляр (подстрока таблицы)
//   check: / check-lacks: / check-error:  отчёт и ошибка vish check
//   residual: a b / residual-has: / residual-lacks:   остаточная программа для аргументов
//   slice: функция переменная / slice-has: / slice-lacks:
// fmt-stable - fmtацииfmt = fmt; fmt-has: text; fmt-ct-has: / fmt-ct-lacks: - after elaboration
//   fmt-projection: ключ / fmt-projection-has: текст — проекция модулем записей (§4.5)
//   jit-compiled: f / jit-stats: текст; no-jit — без сверки с JIT
// machine - and process machine; machine-dump: N - dump at step N; dump-out: - output with dump
//   quantum: N — квант вытеснения фоновых (VISH_SLICE); grant: fs net — ресурсы программе (VISH_GRANT)
// store-roundtrip - in .vishdb and back: the same projection and the same conclusion The typo in the
// directive should not silently turn off the check - unknown directive - cause.
struct header { array keys; array values; }
header_keys() => array{"args", "stdin", "out2", "dump-out", "quantum", "grant", "out", "error", "instances", "check-error", "check-lacks", "check", "residual-has", "residual-lacks", "residual", "slice-has", "slice-lacks", "slice", "jit-compiled", "jit-stats", "fmt-has", "fmt-projection-has", "fmt-projection", "fmt-ct-has", "fmt-ct-lacks", "machine-dump"};
directive_word(str w) {
  r = w.size > 0;
  for(k : range(w.size)) if(!(((w[k] >= 'a') && (w[k] <= 'z')) || (w[k] == '-'))) r = false;
  r
}
read_header(str src) {
  h = header{array{}, array{}};
  known = header_keys();
  done = false;
  for(line : lines_of(src)) if(!done) {
    if(!starts_with(line, "//")) {
      if(line != "") done = true;
    } else {
      body = trim_lead(text_from(line, 2));
      key = "";
      for(k : known) if((key == "") && starts_with(body, k + ":")) key = k;
      if(key != "") {
        h.keys.push(key);
        h.values.push(trim_lead(text_from(body, key.size + 1)));
      } else if((body == "no-jit") || ((body == "machine") || (starts_with(body, "fmt-stable") || starts_with(body, "store-roundtrip")))) {
        h.keys.push(if(starts_with(body, "fmt-stable")) "fmt-stable" else if(starts_with(body, "store-roundtrip")) "store-roundtrip" else body);
        h.values.push("");
      } else {
        colon = find_text(body, ":");
        if((colon > 0) && directive_word(slice_text(body, 0, colon))) {
          h.keys.push("?");
          h.values.push(slice_text(body, 0, colon));
        }
      }
    }
  }
  h
}
// the meaning of the key directive in order; is it
wanted(header h, str key) {
  r = array{};
  for(k : range(h.keys.size)) if(h.keys[k] == key) r.push(h.values[k]);
  r
}
has_key(header h, str key) => wanted(h, key).size > 0;
// arguments of the program - words of directives args
args_of(header h) {
  r = array{};
  for(line : wanted(h, "args")) for(w : words_of(line)) r.push(w);
  r
}
// projection text without a test cap: comments are typed (§4.5), and the expectation of fmt-has from the cap
// would otherwise be found in the cap itself.
without_header(str shown, str src) {
  n = 0;
  stop = false;
  for(l : lines_of(src)) if(!stop) {
    if(starts_with(l, "//")) {
      n += 1;
    } else stop = true;
  }
  at = 0;
  for(k : range(n)) if(at < shown.size) {
    if(!starts_with(text_from(shown, at), "//")) return shown;
    nl = find_text(text_from(shown, at), "\n");
    at = if(nl < 0) shown.size else (at + nl) + 1;
  }
  text_from(shown, at)
}
// Error text without space: "...: error: <text>" of the first line
error_text(str rendered) {
  at = find_text(rendered, "ошибка: ");
  if(at < 0) return "";
  rest = text_from(rendered, at + 14);
  nl = find_text(rest, "\n");
  if(nl < 0) rest else slice_text(rest, 0, nl)
}
// The place of the first error (before ": error")
first_place(str rendered) {
  at = find_text(rendered, ": ошибка");
  if(at < 0) rendered else slice_text(rendered, 0, at)
}
// The first differing line of two texts is with neighboring ones (was/became).
first_difference(str a, str b) {
  la = lines_of(a);
  lb = lines_of(b);
  k = 0;
  while((k < la.size) && ((k < lb.size) && (la[k] == lb[k]))) k += 1;
  r = "";
  i = if(k >= 3) k - 3 else 0;
  while(i < (k + 3)) {
    if(i < la.size) r = r + (((("      было  " + text(i + 1)) + ": ") + la[i]) + "\n");
    if((i < lb.size) && (i >= k)) r = r + (((("      стало " + text(i + 1)) + ": ") + lb[i]) + "\n");
    i += 1;
  }
  r
}

// The .vish test: reasons ("" - passed").
test_vish(str path, bool a64) {
  p = test_load(path);
  src = test_source(p);
  h = read_header(src);
  dir = test_dir_of(p);
  q = wanted(h, "quantum");
  if(q.size == 0) env_unset("VISH_SLICE") else env_set("VISH_SLICE", q[0]);
  grants = ""; // Resources of the program: "You give" - here they give the test (VISH_GRANT )
  for(line : wanted(h, "grant")) for(w : words_of(line)) grants = (grants + (if(grants == "") "" else ",")) + w;
  if(grants == "") env_unset("VISH_GRANT") else env_set("VISH_GRANT", grants);
  counts = array{0, 0};
  notes = array{};
  why = test_program(p, h, src, dir, a64, counts, notes);
  state_clear();
  test_close(p);
  test_result{why, counts[0], counts[1], notes}
}
// counts, notes - AArch64 of this test (verified, unverified; notes)
test_program(i64 p, header h, str src, str dir, bool a64, counts, notes) {
  errors = test_errors(p);
  parsed = test_parsed(p);
  args = args_of(h);
  input = wanted(h, "stdin");
  if(has_key(h, "fmt-stable")) {
    once = test_print(p);
    if(once != print_text(once, dir, "", false)[1]) return "    проекция нестабильна: fmt∘fmt ≠ fmt\n";
  }
  if(has_key(h, "fmt-has")) {
    shown = without_header(test_print(p), src);
    for(want : wanted(h, "fmt-has")) if(!contains(shown, want)) return (("    нет в проекции: " + in_quotes(want)) + "\n") + shown;
  }
  for(key : wanted(h, "fmt-projection")) { // projection is a key recording module like use k (§4.5)
    array{ok, printed} = print_text(src, dir, key, false);
    if(!ok) return ("    нет модуля проекции " + key) + "\n";
    shown = without_header(printed, src);
    for(want : wanted(h, "fmt-projection-has")) if(!contains(shown, want)) return (((("    нет в проекции " + key) + ": ") + in_quotes(want)) + "\n") + shown;
  }
  if((has_key(h, "fmt-ct-has") || has_key(h, "fmt-ct-lacks")) && (errors == "")) { // after elaboration (vish fmt --ct)
    array{ok, printed} = test_elaborated(p);
    if(!ok) return "    ошибка элаборации: " + printed;
    shown = without_header(printed, src);
    for(want : wanted(h, "fmt-ct-has")) if(!contains(shown, want)) return (("    нет в проекции после элаборации: " + in_quotes(want)) + "\n") + shown;
    for(bad : wanted(h, "fmt-ct-lacks")) if(contains(shown, bad)) return (("    лишнее в проекции после элаборации: " + in_quotes(bad)) + "\n") + shown;
  }
  // Program state (§12.2) - its directory for each execution; out2: - second run with it
  state_fresh();
  out = "";
  instances = "";
  if(errors == "") {
    array{o, e, i} = test_run(p, args, input);
    out = o;
    errors = errors + e;
    instances = i;
  }
  why_state = "";
  if(has_key(h, "out2") && (errors == "")) {
    array{again, e2, _} = test_run(p, array{}, input);
    why_state = why_state + e2;
    want2 = wanted(h, "out2");
    k = 0;
    for(line : lines_of(again)) {
      if((k >= want2.size) || (line != want2[k])) why_state = why_state + (((("    второй запуск, строка " + text(k + 1)) + ": ") + in_quotes(line)) + "\n");
      k += 1;
    }
    if(k < want2.size) why_state = why_state + "    второй запуск: не всё выведено\n";
  }
  state_fresh();
  why = "";
  for(k : range(h.keys.size)) if(h.keys[k] == "?") why = why + (("    неизвестная директива теста: " + h.values[k]) + "\n");
  // differentially (§10.5): with JIT, output and error locations - like an interpreter
  if(parsed && !has_key(h, "no-jit")) {
    array{out3, err3, stats} = test_run_jit(p, args, input, a64);
    if(a64) {
      array{c, sk, ns, ms} = a64_last();
      counts[0] = c;
      counts[1] = sk;
      for(n : ns) notes.push(n);
      for(m : ms) why = why + (("    AArch64: " + m) + "\n");
    }
    if(out3 != out) why = why + ((((("    JIT: вывод отличается: " + in_quotes(out3)) + " против ") + in_quotes(out)) + "\n") + stats);
    for(want : wanted(h, "jit-stats")) if(!contains(stats, want)) why = why + ((("    нет в статистике JIT: " + in_quotes(want)) + "\n") + stats);
    for(fn : wanted(h, "jit-compiled")) if(!contains(stats, ("jit  " + fn) + "(")) why = why + ((("    JIT не скомпилировал " + fn) + ":\n") + stats);
    if((first_place(err3) != first_place(errors)) && !((errors == "") && (err3 == ""))) why = why + (((("    JIT: ошибка отличается:\n" + err3) + "против\n") + errors));
  }
  if(has_key(h, "check") || (has_key(h, "check-lacks") || has_key(h, "check-error"))) {
    check_errors = "";
    report = "";
    if(parsed) {
      array{ce, rep} = test_check(p);
      check_errors = ce;
      report = rep;
    }
    for(want : wanted(h, "check")) if(!contains(report, want)) why = why + ((("    нет в отчёте check: " + in_quotes(want)) + "\n") + report);
    for(bad : wanted(h, "check-lacks")) if(contains(report, bad)) why = why + ((("    лишнее в отчёте check: " + in_quotes(bad)) + "\n") + report);
    for(want : wanted(h, "check-error")) if(!contains(check_errors, want)) why = why + ((((("    нет ошибки check: " + in_quotes(want)) + "; есть: ") + check_errors) + "\n"));
    if(!has_key(h, "check-error") && (check_errors != "")) why = why + ("    неожиданная ошибка check:\n" + check_errors);
  }
  if(has_key(h, "residual") && parsed) {
    shown = test_residual(p, words_of(wanted(h, "residual")[0]));
    for(want : wanted(h, "residual-has")) if(!contains(shown, want)) why = why + ((("    нет в остаточной программе: " + in_quotes(want)) + "\n") + shown);
    for(bad : wanted(h, "residual-lacks")) if(contains(shown, bad)) why = why + ((("    лишнее в остаточной программе: " + in_quotes(bad)) + "\n") + shown);
  }
  if(has_key(h, "slice") && parsed) {
    w = words_of(wanted(h, "slice")[0]);
    shown = test_slice(p, if(w.size > 0) w[0] else "", if(w.size > 1) w[1] else "");
    for(want : wanted(h, "slice-has")) if(!contains(shown, want)) why = why + ((("    нет в срезе: " + in_quotes(want)) + "\n") + shown);
    for(bad : wanted(h, "slice-lacks")) if(contains(shown, bad)) why = why + ((("    лишнее в срезе: " + in_quotes(bad)) + "\n") + shown);
  }
  if(has_key(h, "store-roundtrip")) {
    state_fresh();
    array{same, out2} = test_store_roundtrip(p, args, input);
    if(!same) why = why + "    проекция после загрузки базы отличается\n";
    if(out2 != out) why = why + (((("    вывод из базы отличается: " + in_quotes(out2)) + " против ") + in_quotes(out)) + "\n");
  }
  why = why + why_state;
  state_fresh();
  if((has_key(h, "machine") || has_key(h, "machine-dump")) && parsed) why = why + machine_diff(p, h, args, input, out, errors);
  want_out = wanted(h, "out");
  i = 0;
  for(line : lines_of(out)) {
    if(i >= want_out.size) why = why + (("    лишний вывод: " + line) + "\n");
    else if(line != want_out[i]) why = why + (((((("    строка " + text(i + 1)) + ": ожидалось ") + in_quotes(want_out[i])) + ", получено ") + in_quotes(line)) + "\n");
    i += 1;
  }
  while(i < want_out.size) {
    why = why + (("    не выведено: " + in_quotes(want_out[i])) + "\n");
    i += 1;
  }
  for(want : wanted(h, "error")) if(!contains(errors, want)) why = why + (("    нет ожидаемой ошибки: " + in_quotes(want)) + "\n");
  if(!has_key(h, "error") && (errors != "")) why = why + ("    неожиданная ошибка:\n" + errors);
  for(want : wanted(h, "instances")) if(!contains(instances, want)) why = why + ((((("    нет экземпляра " + in_quotes(want)) + "; есть:\n") + instances)));
  why
}
// Process machine (M5): the same output and the same error as the interpreter; with a dump - dump after N
// steps, restore to a new database from journal dump ("in another VM") and count: output before the dump and
// after recovery - complete (or dump-out: if the resources of host do not survive the transfer).
machine_diff(i64 p, header h, args, input, str out, str errors) {
  why = "";
  state_fresh();
  array{mout, merr} = test_machine(p, args, input);
  if(mout != out) why = why + (((("    машина процессов: вывод " + in_quotes(mout)) + " против ") + in_quotes(out)) + "\n");
  if(error_text(merr) != error_text(errors)) why = why + (((("    машина процессов: ошибка " + in_quotes(error_text(merr))) + " против ") + in_quotes(error_text(errors))) + "\n");
  for(at : wanted(h, "machine-dump")) { // each directive - its launch with a dump at this step
    state_fresh();
    array{dout, early} = test_machine_dump(p, args, input, number_of(at));
    if(early) why = why + (("    машина: процесс закончился раньше шага дампа " + at) + "\n");
    want = out;
    if(has_key(h, "dump-out")) {
      want = "";
      for(l : wanted(h, "dump-out")) want = (want + l) + "\n";
    }
    if(dout != want) why = why + (((((("    дамп на шаге " + at) + ": вывод ") + in_quotes(dout)) + " против ") + in_quotes(want)) + "\n");
  }
  why
}

// A second language on top of a single AST (§4.5): a program printed in projection k - the text that itself
// tells you how to parse it (use k; at the beginning) - is disassembled into the same tree, and its printing
// is stable. A tree is likened to a dump.
//
test_projection(str path, str key) {
  src = read_text(path);
  dir = path_dir(path);
  array{ok, once} = print_text(src, dir, key, true);
  if(!ok || (once == "")) return ("    нет модуля проекции " + key) + "\n";
  array{errors, dump_a} = parse_dump(src, dir, "программа");
  array{errors2, dump_b} = parse_dump(once, dir, "проекция");
  if((errors == "") && (errors2 != "")) return ("    текст в проекции не разбирается: " + errors2) + once;
  twice = print_text(once, dir, key, true)[1];
  if(once != twice) return "    печать в проекции нестабильна:\n" + first_difference(once, twice);
  use_line = ("  n_use key=" + key) + "\n";
  b = dump_b;
  at = find_text(b, use_line);
  if((at >= 0) && !contains(dump_a, use_line)) b = slice_text(b, 0, at) + text_from(b, at + use_line.size);
  if(dump_a != b) return (("    другое дерево после разбора проекции:\n" + first_difference(dump_a, b)) + "    текст:\n") + once;
  ""
}
// File directory (no slash at the end; no -')
path_dir(str path) {
  slash = -1;
  for(k : range(path.size)) if(path[k] == '/') slash = k;
  if(slash < 0) "" else slice_text(path, 0, slash)
}
// filename
path_name(str path) => text_from(path, path_dir(path).size + (if(path_dir(path) == "") 0 else 1));

// Scenarios: VM session (.session) and editor protocol (.wire)`check`, `edit f` … `.`) or a client
// message in text form (`key 1 End`, `[2] …` - a second client of the same VM); after it - expectations
// of the conclusion:
// // program: файл.vish program (relative to the script directory)
// // expect: substring // expect-not: substring (и - line translation)
// @ substring[:N] is the number N-th node in whose text it is (scripts do not depend on numbers);
// // let: the name @ substring is the number now, the name in the expectations is the same (the node saves the id after editing);
// // run: live - do not wait until the end; // quantum: N - quantum in the steps of the machine;
// // grant: fs net - startup resources; save_to / reopen file.vishdb - copies of the database for the merger (§9.4);
// wait [N], idle, journal, roundtrip - start, set pause, increase journal, journal to a new base;
// // quiet - then VM answers are not described or verified: the client only keeps the node table.
// (for @links) - Measurement of the editor's response, bench/editor/keys.sh.

// The text form of messages is on top of the meta-information of the protocol:
// 
// Customer message: name without c , fields - words in order (missing - zeros), `\s` - gap, `\n` -
// translation of a line, node. `#N`. Result: array{successful, view, field values, error}
//
all_digits(str w) {
  r = w.size > 0;
  for(k : range(w.size)) if((w[k] < '0') || (w[k] > '9')) r = false;
  r
}
client_message(str line, kinds_all) {
  ws = words_of(line);
  if(ws.size == 0) return array{false, "", array{}, "протокол: пустое сообщение"};
  for(m : kinds_all) {
    array{name, fs, kinds} = m;
    if(name == ws[0]) {
      values = array{};
      for(j : range(fs.size)) if((j + 1) < ws.size) {
        w = ws[j + 1];
        if(kinds[j] == "string") values.push(replace_all(replace_all(w, "\\s", " "), "\\n", "\n"));
        else {
          digits = if((kinds[j] == "node") && starts_with(w, "#")) text_from(w, 1) else w;
          if(!all_digits(digits)) return array{false, "", array{}, "протокол: не число: " + w};
          values.push(digits);
        }
      }
      return array{true, name, values, ""};
    }
  }
  array{false, "", array{}, "протокол: неизвестное сообщение " + ws[0]}
}
// The VM message is a flat tree m (array {виды, имена, тексты, числа, детей, после поддерева} ) - text:
// name, fields in order `имя=значение` ; node - #N (no - ·), a string - in quotation marks, a list of
// aggregates - from a new line each, the other list - [a b].
describe(m) {
  parts = array{m[1][0], " "};
  describe_fields(m, 0, parts);
  parts.push("\n");
  join_texts(parts)
}
describe_fields(m, i64 at, parts) {
  j = at + 1;
  for(k : range(m[4][at])) {
    if(k > 0) parts.push(" ");
    parts.push(m[1][j]);
    parts.push("=");
    describe_value(m, j, parts);
    j = m[5][j];
  }
  true
}
describe_value(m, i64 j, parts) {
  kind = m[0][j];
  if(kind == "node") parts.push(if(m[3][j] < 0) "·" else ("#" + text(m[3][j])));
  else if(kind == "num") parts.push(m[2][j]);
  else if(kind == "str") parts.push(in_quotes(m[2][j]));
  else if(kind == "struct") describe_fields(m, j, parts);
  else if(m[2][j] == "structs") {
    e = j + 1;
    for(k : range(m[4][j])) {
      parts.push("\n  ");
      describe_fields(m, e, parts);
      e = m[5][e];
    }
  } else {
    parts.push("[");
    e = j + 1;
    for(k : range(m[4][j])) {
      if(k > 0) parts.push(" ");
      describe_value(m, e, parts);
      e = m[5][e];
    }
    parts.push("]");
  }
  true
}
// The name field of the unit at a flat tree: record number (-1 - no)
field_at(m, i64 at, str name) {
  r = -1;
  j = at + 1;
  for(k : range(m[4][at])) {
    if((r < 0) && (m[1][j] == name)) r = j;
    j = m[5][j];
  }
  r
}

// Клиент сценария — как редактор: узлы (номер, вид, куски — текст или ребёнок), представления
// (номер → корень, вид), проекции представлений; текст собирается из кусков и сверяется с проекцией
// VM. Таблица узлов — массивы-переменные
// сценария, передаются именами (алиас места — без копии; поле-аргумент изменяемого параметра VM
// копирует на входе и пишет на выходе — вставка в поле структуры была бы копией всей таблицы на
// каждый кусок; *моё*). Ключ узла — номер·2 + клиент (у клиентов свои узлы: черновик — у автора).
// Текст узла — кэшем: правка узла снимает кэш у него и предков (родитель — по последней сборке),
// курсор собирается только по пути к нему.
// ids - place: key; info - place by fours: first piece, pieces, parent, whether there is cache;
// types, cache - by place: view, collected text; ptext, pkid - by piece: text or child (-1 -)
// text); sorted, slots - keys to increase and their places.
struct wclient { array vids; array vroots; array vkinds; i64 root; array pviews; array pkeys; str mismatch; }
new_client() => wclient{array{}, array{}, array{}, -1, array{}, array{}, ""};
// node n client c in the table (-1 - no)
node_slot(sorted, slots, i64 c, i64 n) {
  key = (n * 2) + c;
  k = lower_bound(sorted, key);
  if((k < sorted.size) && (sorted[k] == key)) slots[k] else -1
}
// node messages (nodes field): new - to the table, known - replaced; cache - over them and ancestors
take_nodes(i64 c, m, ids, info, kinds, cache, ptext, pkid, sorted, slots) {
  list = field_at(m, 0, "nodes");
  fresh = false;
  e = list + 1;
  for(k : range(m[4][list])) {
    id = m[3][field_at(m, e, "id")];
    pieces = field_at(m, e, "pieces");
    slot = node_slot(sorted, slots, c, id);
    if(slot < 0) {
      slot = ids.size;
      ids.push((id * 2) + c);
      kinds.push("");
      cache.push("");
      info.push(0);
      info.push(0);
      info.push(-1);
      info.push(0);
      fresh = true;
    }
    up = slot;
    hops = 0;
    while((up >= 0) && (hops < 100000)) {
      info[(up * 4) + 3] = 0;
      up = info[(up * 4) + 2];
      hops += 1;
    }
    kinds[slot] = m[2][field_at(m, e, "kind")];
    info[slot * 4] = ptext.size;
    info[(slot * 4) + 1] = m[4][pieces];
    p = pieces + 1;
    for(j : range(m[4][pieces])) {
      if(m[0][p] == "str") {
        ptext.push(m[2][p]);
        pkid.push(-1);
      } else {
        ptext.push("");
        pkid.push(m[3][p]);
      }
      p = m[5][p];
    }
    e = m[5][e];
  }
  if(fresh) {
    order = sorted_numbers(ids);
    sorted = array{};
    slots = array{};
    for(k : order) {
      sorted.push(ids[k]);
      slots.push(k);
    }
  }
  true
}
// root and view of the v client c (-1, "" - no);
view_index(cl, i64 c, i64 v) {
  r = -1;
  for(k : range(cl[c].vids.size)) if(cl[c].vids[k] == v) r = k;
  r
}
view_root_of(cl, i64 c, i64 v) {
  k = view_index(cl, c, v);
  if(k < 0) -1 else cl[c].vroots[k]
}
view_kind_of(cl, i64 c, i64 v) {
  k = view_index(cl, c, v);
  if(k < 0) "" else cl[c].vkinds[k]
}
set_view(cl, i64 c, i64 v, i64 root, str kind) {
  k = view_index(cl, c, v);
  if(k < 0) {
    cl[c].vids.push(v);
    cl[c].vroots.push(root);
    cl[c].vkinds.push(kind);
  } else {
    cl[c].vroots[k] = root;
    cl[c].vkinds[k] = kind;
  }
  true
}
// View projection (record module key;" - default)
projection_of(cl, i64 c, i64 v) {
  r = "";
  for(k : range(cl[c].pviews.size)) if(cl[c].pviews[k] == v) r = cl[c].pkeys[k];
  r
}
set_projection(cl, i64 c, i64 v, str key) {
  k = -1;
  for(j : range(cl[c].pviews.size)) if(cl[c].pviews[j] == v) k = j;
  if(k < 0) {
    cl[c].pviews.push(v);
    cl[c].pkeys.push(key);
  } else cl[c].pkeys[k] = key;
  true
}
// Text node n client c, collected from pieces - as it will collect the editor; cursor (node cn, piece cp,
// offset co at code points; cn -1 - no) - х in its place.
text_of(i64 c, i64 n, i64 cn, i64 cp, i64 co, info, cache, ptext, pkid, sorted, slots) {
  t = node_text(c, n, info, cache, ptext, pkid, sorted, slots); // At the same time, parents in this assembly
  if(cn < 0) return t;
  path = array{}; // from node cursor up to n
  s = node_slot(sorted, slots, c, cn);
  top = node_slot(sorted, slots, c, n);
  while((s >= 0) && (path.size < 100000)) {
    path.push(s);
    s = if(s == top) -1 else info[(s * 4) + 2];
  }
  if((path.size == 0) || (path[path.size - 1] != top)) return t; // cursor
  parts = array{};
  caret_pieces(c, n, cn, cp, co, path, parts, info, cache, ptext, pkid, sorted, slots);
  join_texts(parts)
}
// text node n (cache)
node_text(i64 c, i64 n, info, cache, ptext, pkid, sorted, slots) {
  slot = node_slot(sorted, slots, c, n);
  if(slot < 0) return "";
  if(info[(slot * 4) + 3] == 1) return cache[slot];
  parts = array{};
  f = info[slot * 4];
  for(i : range(info[(slot * 4) + 1])) {
    kid = pkid[f + i];
    if(kid >= 0) {
      ks = node_slot(sorted, slots, c, kid);
      if(ks >= 0) info[(ks * 4) + 2] = slot;
      parts.push(node_text(c, kid, info, cache, ptext, pkid, sorted, slots));
    } else parts.push(ptext[f + i]);
  }
  t = join_texts(parts);
  cache[slot] = t;
  info[(slot * 4) + 3] = 1;
  t
}
// pieces of node n with cursor: node paths to the cursor - by pieces, others - by cache
caret_pieces(i64 c, i64 n, i64 cn, i64 cp, i64 co, path, parts, info, cache, ptext, pkid, sorted, slots) {
  slot = node_slot(sorted, slots, c, n);
  if(slot < 0) return true;
  on_path = false;
  for(x : path) if(x == slot) on_path = true;
  if(!on_path) {
    parts.push(node_text(c, n, info, cache, ptext, pkid, sorted, slots));
    return true;
  }
  f = info[slot * 4];
  for(i : range(info[(slot * 4) + 1])) {
    kid = pkid[f + i];
    if(kid >= 0) caret_pieces(c, kid, cn, cp, co, path, parts, info, cache, ptext, pkid, sorted, slots);
    else if((cn == n) && (cp == i)) parts.push(with_caret(ptext[f + i], co));
    else parts.push(ptext[f + i]);
  }
  true
}
// овой before the code point co (after the last - at the end)
with_caret(str t, i64 co) {
  points = 0;
  for(k : range(t.size)) if((t[k] & 0xC0) != 0x80) {
    if(points == co) return (slice_text(t, 0, k) + "‸") + text_from(t, k);
    points += 1;
  }
  if(points == co) t + "‸" else t
}
// cursor
cursor_line(cl, i64 c, i64 cn, i64 cp, i64 co, info, cache, ptext, pkid, sorted, slots) {
  all = text_of(c, cl[c].root, cn, cp, co, info, cache, ptext, pkid, sorted, slots);
  r = "?";
  for(l : lines_of(all)) if((r == "?") && contains(l, "‸")) r = l;
  if((r == "?") && ends_with(all, "\n‸")) "‸" else r
}
// The collected text and its reconciliation: draft (text as typed) - projection of the presentation itself,
// otherwise - projection VM (layout: hole - only your text).
checked_text(i64 h, cl, i64 c, i64 v, info, cache, ptext, pkid, sorted, slots) {
  t = text_of(c, cl[c].root, -1, -1, -1, info, cache, ptext, pkid, sorted, slots);
  array{typed, draft} = scn_draft(h, c, v);
  if(typed) {
    if(t != draft) cl[c].mismatch = (("собрано:\n" + t) + "\nпредставление VM:\n") + draft;
  } else {
    want = scn_print(h, cl[c].root, view_kind_of(cl, c, v) == "module", projection_of(cl, c, v));
    if(t != want) cl[c].mismatch = (("собрано:\n" + t) + "\nпроекция:\n") + want;
  }
  ("текст:\n" + t) + "\n"
}
// VM answers to client c in quiet mode: only the node table and views (for @links)
take_quiet(i64 h, cl, i64 c, ids, info, kinds, cache, ptext, pkid, sorted, slots) {
  for(m : scn_collect_kinds(h, c, array{"view", "update", "cursor"})) {
    name = m[1][0];
    if(name == "view") {
      take_nodes(c, m, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      v = m[3][field_at(m, 0, "view")];
      set_view(cl, c, v, m[3][field_at(m, 0, "root")], m[2][field_at(m, 0, "kind")]);
      cl[c].root = view_root_of(cl, c, v);
    } else if(name == "update") {
      take_nodes(c, m, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      cl[c].root = view_root_of(cl, c, m[3][field_at(m, 0, "view")]);
    } else if(name == "cursor") cl[c].root = view_root_of(cl, c, m[3][field_at(m, 0, "view")]);
  }
  true
}
// VM answers to client c - text; presentation - collected text, cursor - line with а
collect(i64 h, cl, i64 c, ids, info, kinds, cache, ptext, pkid, sorted, slots) {
  out = "";
  for(m : scn_collect(h, c)) {
    out = out + describe(m);
    name = m[1][0];
    if(name == "view") {
      take_nodes(c, m, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      v = m[3][field_at(m, 0, "view")];
      set_view(cl, c, v, m[3][field_at(m, 0, "root")], m[2][field_at(m, 0, "kind")]);
      cl[c].root = view_root_of(cl, c, v);
      out = out + checked_text(h, cl, c, v, info, cache, ptext, pkid, sorted, slots);
    } else if(name == "update") {
      take_nodes(c, m, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      v = m[3][field_at(m, 0, "view")];
      cl[c].root = view_root_of(cl, c, v);
      out = out + checked_text(h, cl, c, v, info, cache, ptext, pkid, sorted, slots);
    } else if(name == "cursor") {
      cl[c].root = view_root_of(cl, c, m[3][field_at(m, 0, "view")]);
      out = ((out + "курсор: ") + cursor_line(cl, c, m[3][field_at(m, 0, "node")], m[3][field_at(m, 0, "piece")], m[3][field_at(m, 0, "offset")], info, cache, ptext, pkid, sorted, slots)) + "\n";
    }
  }
  out
}
// text without comments (`//…` to the end of the line, `/*…*/`): no string context chunks
without_comments(str t) {
  r = "";
  i = 0;
  while(i < t.size) {
    rest = text_from(t, i);
    if(starts_with(rest, "//")) {
      nl = find_text(rest, "\n");
      i = if(nl < 0) t.size else i + nl;
    } else if(starts_with(rest, "/*")) {
      e = find_text(text_from(t, i + 2), "*/");
      i = if(e < 0) t.size else (i + 2) + (e + 2);
    } else {
      nl = find_text(rest, "/");
      take = if(nl < 0) rest.size else (if(nl == 0) 1 else nl);
      r = r + slice_text(t, i, i + take);
      i += take;
    }
  }
  r
}
// N-th node (from the root, in the order of the text), in whose own text there is a want; notes - to search
// in the comments (their text of the context - module, block - without them: they are not node)
find_node(i64 c, i64 n, str want, bool notes, left, kinds, info, ptext, pkid, sorted, slots) {
  slot = node_slot(sorted, slots, c, n);
  if((slot < 0) || (left[1] >= 0)) return true;
  ctx = !notes && ((kinds[slot] == "n_module") || (kinds[slot] == "n_block"));
  f = info[slot * 4];
  count = info[(slot * 4) + 1];
  hit = false;
  for(i : range(count)) if(!hit && (pkid[f + i] < 0)) {
    t = ptext[f + i];
    if(contains(if(ctx) without_comments(t) else t, want)) {
      hit = true;
      left[0] = left[0] - 1;
      if(left[0] == 0) left[1] = n;
    }
  }
  for(i : range(count)) if(pkid[f + i] >= 0) find_node(c, pkid[f + i], want, notes, left, kinds, info, ptext, pkid, sorted, slots);
  true
}
// @ substring[:N] - node number (#N, not found - #?); `сообщение N …` - searched in representation N
resolve(cl, i64 c, str line, kinds, info, ptext, pkid, sorted, slots) {
  ws = words_of(line);
  if(ws.size > 1) {
    v = view_index(cl, c, number_of(ws[1]));
    if(v >= 0) cl[c].root = cl[c].vroots[v];
  }
  r = "";
  for(w : ws) {
    if(r != "") r = r + " ";
    if(!starts_with(w, "@")) r = r + w;
    else {
      want = text_from(w, 1);
      nth = 1;
      colon = -1;
      for(k : range(want.size)) if(want[k] == ':') colon = k;
      if((colon >= 0) && (((colon + 1) < want.size) && ((want[colon + 1] >= '1') && (want[colon + 1] <= '9')))) {
        nth = number_of(text_from(want, colon + 1));
        want = slice_text(want, 0, colon);
      }
      left = array{nth, -1};
      find_node(c, cl[c].root, want, false, left, kinds, info, ptext, pkid, sorted, slots);
      if(left[1] < 0) {
        left = array{nth, -1};
        find_node(c, cl[c].root, want, true, left, kinds, info, ptext, pkid, sorted, slots);
      }
      r = r + (if(left[1] < 0) "#?" else "#" + text(left[1]));
    }
  }
  r
}
// Message of the client with a line: links - numbers, text form - message, answers - text. projection
// representation (c_projection): text reconciliation - according to it, if the module is found. Bottom line:
// array { удалось, ответы или ошибка}.
exchange(i64 h, cl, i64 c, str line, kinds_all, ids, info, kinds, cache, ptext, pkid, sorted, slots) {
  array{ok, kind, values, error} = client_message(resolve(cl, c, line, kinds, info, ptext, pkid, sorted, slots), kinds_all);
  if(!ok) return array{false, error};
  view = -1;
  was = "";
  key = "";
  if(kind == "projection") {
    view = if(values.size > 0) number_of(values[0]) else 0;
    key = if(values.size > 1) values[1] else "";
    was = projection_of(cl, c, view);
    set_projection(cl, c, view, key);
  }
  failed = scn_send(h, c, kind, values);
  if(failed != "") return array{false, failed};
  out = collect(h, cl, c, ids, info, kinds, cache, ptext, pkid, sorted, slots);
  if((kind == "projection") && ((key != "") && !scn_has_module(h, key))) set_projection(cl, c, view, was); // No module - former
  array{true, out}
}
// Waiting for the script: without leading spaces; х - translation of the output line (\n in quotation marks -
// shielding in the output itself).
lines_joined(str s) => replace_all(trim_lead(s), "⏎", "\n");
// Scenario: Causes (" - passed").
run_scenario(str path) {
  env_unset("VISH_GRANT"); // Resources in the `// grant:` scenario only
  lines = lines_of(read_text(path));
  wire = ends_with(path, ".wire");
  h = scn_open(path, wire);
  ids = array{}; // Customer node table (see above)
  info = array{};
  kinds = array{};
  cache = array{};
  ptext = array{};
  pkid = array{};
  sorted = array{};
  slots = array{};
  cl = array{new_client(), new_client()};
  last = "";
  why = "";
  let_names = array{}; // `// let:` - memorized node
  let_ids = array{};
  live = false; // `// run: live` - Do not wait until the end
  quiet = false; // `// quiet` - Answers not to be understood
  kinds_all = proto_client_kinds(); // Meta Protocol Information - Once
  i = 0;
  while(i < lines.size) {
    l = lines[i];
    at = text(i + 1);
    if(starts_with(l, "// program:")) {
      failed = scn_program(h, trim_one(text_from(l, 11)));
      if(failed != "") {
        scn_close(h);
        return failed;
      }
    } else if(wire && starts_with(l, "save_to ")) { // journal database - to file; reopen - session again from it
      scn_save(h, text_from(l, 8));
      last = "";
    } else if(wire && starts_with(l, "reopen ")) {
      failed = scn_reopen(h, text_from(l, 7));
      if(failed != "") {
        scn_close(h);
        return failed;
      }
      ids = array{}; // Table node - again
      info = array{};
      kinds = array{};
      cache = array{};
      ptext = array{};
      pkid = array{};
      sorted = array{};
      slots = array{};
      cl = array{new_client(), new_client()};
      last = "";
    } else if(wire && starts_with(l, "// let:")) {
      ws = words_of(text_from(l, 7));
      if(ws.size == 2) {
        id = text_from(resolve(cl, 0, "x " + ws[1], kinds, info, ptext, pkid, sorted, slots), 2);
        k = -1;
        for(j : range(let_names.size)) if(let_names[j] == ws[0]) k = j;
        if(k < 0) {
          let_names.push(ws[0]);
          let_ids.push(id);
        } else let_ids[k] = id;
      }
    } else if(wire && starts_with(l, "// grant:")) {
      g = "";
      for(w : words_of(text_from(l, 9))) g = (g + (if(g == "") "" else ",")) + w;
      env_set("VISH_GRANT", g);
    } else if(wire && (l == "// run: live")) live = true;
    else if(wire && (l == "// quiet")) quiet = true;
    else if(wire && (starts_with(l, "// quantum:") && scn_has_server(h))) scn_quantum(h, number_of(trim_lead(text_from(l, 11))));
    else if(starts_with(l, "// expect:")) {
      want = lines_joined(text_from(l, 10));
      order = sorted_indices(let_names);
      k = order.size;
      while(k > 0) { // blk2 - formerly blk
        k -= 1;
        want = replace_all(want, "$" + let_names[order[k]], let_ids[order[k]]);
      }
      if(!contains(last, want)) why = why + ((((("    строка " + at) + ": нет ") + in_quotes(want)) + " в выводе:\n") + last);
    } else if(starts_with(l, "// expect-not:")) {
      bad = lines_joined(text_from(l, 14));
      if(contains(last, bad)) why = why + ((((("    строка " + at) + ": лишнее ") + in_quotes(bad)) + " в выводе:\n") + last);
    } else if((l == "") || (starts_with(l, "//") || !scn_ready(h))) {
    } else if(wire && (l == "journal")) { // journal base growth since last time: records and bytes of import text
      array{n, kinds, counts, bytes} = scn_journal(h);
      by = "";
      for(k : range(kinds.size)) by = (((by + (if(by == "") "" else ", ")) + kinds[k]) + " ") + text(counts[k]);
      last = (((((("журнал: +" + text(n)) + " записей (") + by) + "), текст импортов +") + text(bytes)) + " байт\n");
    } else if(wire && (l == "roundtrip")) last = scn_roundtrip(h);
    else if(wire && ((l == "wait") || starts_with(l, "wait "))) { // launch: quanta to end (wait N - N quanta) or to wait for host
      scn_wait(h, if(l == "wait") -1 else number_of(text_from(l, 5)));
      last = collect(h, cl, 0, ids, info, kinds, cache, ptext, pkid, sorted, slots);
    } else if(wire && (l == "idle")) { // Set pause: check and tags (without hours)
      scn_idle(h);
      last = collect(h, cl, 0, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      also = collect(h, cl, 1, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      if(also != "") last = (last + "другому клиенту:\n") + also;
    } else if(wire && quiet) {
      array{ok, kind, values, error} = client_message(resolve(cl, 0, l, kinds, info, ptext, pkid, sorted, slots), kinds_all);
      failed = if(ok) scn_send(h, 0, kind, values) else error;
      if(failed != "") why = why + (((("    строка " + at) + ": ") + failed) + "\n");
      take_quiet(h, cl, 0, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      scn_drain(h, 1);
      last = "";
    } else if(wire) {
      who = if(starts_with(l, "[2] ")) 1 else 0;
      array{ok, got} = exchange(h, cl, who, if(who == 1) text_from(l, 4) else l, kinds_all, ids, info, kinds, cache, ptext, pkid, sorted, slots);
      if(!ok) why = why + (((("    строка " + at) + ": ") + got) + "\n");
      else {
        last = got;
        if(!live && scn_running(h)) { // launch - to the end (quantas), unless the script requested otherwise
          scn_finish(h);
          last = last + collect(h, cl, who, ids, info, kinds, cache, ptext, pkid, sorted, slots);
        }
        other = 1 - who; // Answers sent to another client (one state for all)
        if(scn_sent(h, other) > 0) {
          also = collect(h, cl, other, ids, info, kinds, cache, ptext, pkid, sorted, slots);
          if(also != "") last = (last + "другому клиенту:\n") + also;
        }
        for(c : range(2)) if(cl[c].mismatch != "") {
          why = why + (((("    строка " + at) + ": текст представления расходится с проекцией:\n") + cl[c].mismatch));
          cl[c].mismatch = "";
        }
      }
    } else {
      body = "";
      if(starts_with(l, "edit ")) {
        i += 1;
        while((i < lines.size) && (lines[i] != ".")) {
          body = (body + lines[i]) + "\n";
          i += 1;
        }
      }
      last = vm_command(scn_session(h), l, body);
    }
    i += 1;
  }
  scn_close(h);
  why
}
// one-space-free
trim_one(str s) => if(starts_with(s, " ")) text_from(s, 1) else s;

// Test result: Causes ("passed") and AArch64 of this test (--a64): Verified, unverified, notes.
struct test_result { str why; i64 checked; i64 skipped; array notes; }
// One test: projection (-projection k) - program reversibility only; script; program.
test_one(str path, bool a64, str projection) {
  if(projection != "") return test_result{test_projection(path, projection), 0, 0, array{}};
  if(ends_with(path, ".session") || ends_with(path, ".wire")) return test_result{run_scenario(path), 0, 0, array{}};
  test_vish(path, a64)
}
// The result of the child's test (fork) to the parent - lines: "checked unverified notes", notes, reasons.
test_packed(str path, bool a64, str projection) {
  r = test_one(path, a64, projection);
  t = ((((text(r.checked) + " ") + text(r.skipped)) + " ") + text(r.notes.size)) + "\n";
  for(n : r.notes) t = (t + n) + "\n";
  t + r.why
}
// vish test <catalogue> [-a64 |-projection k]: run; code 0 - all passed. Simultaneous tests -
// VISH_TEST_JOBS, otherwise on the cores; 1 - in a row in this process, without fork.
run_tests(str dir, bool a64, str projection) {
  names = array{};
  for(f : files_in(dir)) if(ends_with(f, ".vish") || ((projection == "") && (ends_with(f, ".session") || ends_with(f, ".wire")))) names.push(f);
  files = array{};
  for(k : sorted_indices(names)) files.push(names[k]);
  jobs = if(env_get("VISH_TEST_JOBS") != "") number_of(env_get("VISH_TEST_JOBS")) else cpu_count();
  if(jobs < 1) jobs = 1;
  passed = 0;
  checked = 0;
  skipped = 0;
  notes = array{};
  if(jobs > 1) tests_start(files, jobs, a64, projection);
  for(f : files) {
    why = "";
    if(jobs > 1) {
      array{got, code, whole} = tests_next();
      if(code != 0) why = ("    тест не закончился: " + (if(code < 0) ("сигнал " + text(0 - code)) else ("код " + text(code)))) + "\n";
      else if(!whole) why = got;
      else {
        // Child's AArch64 counters: "unchecked notes", notes, reasons
        nl = find_text(got, "\n");
        ws = words_of(slice_text(got, 0, nl));
        checked += number_of(ws[0]);
        skipped += number_of(ws[1]);
        rest = text_from(got, nl + 1);
        for(j : range(number_of(ws[2]))) {
          e = find_text(rest, "\n");
          n = slice_text(rest, 0, e);
          if(!has_text(notes, n)) notes.push(n);
          rest = text_from(rest, e + 1);
        }
        why = rest;
      }
    } else {
      r = test_one(f, a64, projection);
      why = r.why;
      checked += r.checked;
      skipped += r.skipped;
      for(n : r.notes) if(!has_text(notes, n)) notes.push(n);
    }
    if(why == "") {
      passed += 1;
      write_out(("  ok   " + path_name(f)) + "\n");
    } else write_out(((("  FAIL " + path_name(f)) + "\n") + why) + "\n");
  }
  if(a64) {
    write_out(((("AArch64: проверено вызовов " + text(checked)) + ", не проверено ") + text(skipped)) + "\n");
    for(k : sorted_indices(notes)) write_out(("  не проверено  " + notes[k]) + "\n");
  }
  write_out((((text(passed) + "/") + text(files.size)) + " тестов прошло\n"));
  if(passed == files.size) 0 else 1
}

// entry point for cli: directory, "--a64" or "--projection key"
test_command(args) => run_tests(args[0], (args.size > 1) && (args[1] == "--a64"), if((args.size > 2) && (args[1] == "--projection")) args[2] else "");
