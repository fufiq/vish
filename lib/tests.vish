// Run reference tests and scenarios - in language (step 3 transfer tuling). The module is built into the
// assembly; it is loaded with a vish test (cli - key).
module tests;
use tools;

// --- Test run: vish test <catalogue> [--a64 | --projection k] ---
// 
// Engines are checked against each other (interpreter, JIT, AArch64, process machine); The test is a
// .vish program with directives in the header, a script for a VM session (.session) or an editor protocol
// (.wire). Here are directives, reconciliations, cause texts, order and parallelity; engines, state
// catalogs, children (fork) and scripts are primitives of VM.
//

// primitives run (VM): test program, its printing, engines
test_load(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tests_host->load(std::string((a[0]).as<str_v>().view())));
};
