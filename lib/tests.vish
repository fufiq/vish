// The client's message c (0, 1) type kind from the values of the fields is framed on its socket; the server
// spins until everyone gets theirs. Outcome or error.
scn_send(i64 h, i64 c, str kind, values) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(std::string()));
  auto m = proto::client_from((a[2]).as<str_v>().view(), strings_of(a[3]));
  if(!m) return value(cat("протокол: неизвестное сообщение ", (a[2]).as<str_v>().view()));
  try {
    tests_host->scene((a[0]).as<int64_t>()).send(int((a[1]).as<int64_t>()), *m);
  } catch(diagnostic const & d) {
    return value(std::string(d.what()));
  }
  return value(std::string());
};
// VM - flat trees: array {виды, имена, тексты, числа, детей, после поддерева}; how many messages the client
// sent
scn_collect(i64 h, i64 c) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  std::vector<value> out;
  for(auto const & m: tests_host->scene((a[0]).as<int64_t>()).collect(int((a[1]).as<int64_t>()))) out.push_back(flat_value(m));
  return value(array_v::of(std::move(out)));
};
// Coming to the client c messages of types (name without s ) - flat trees, others - only subtracted (//
// quiet)
scn_collect_kinds(i64 h, i64 c, kinds) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(array_v::of({})));
  auto want = strings_of(a[2]);
  std::vector<value> out;
  for(auto const & m: tests_host->scene((a[0]).as<int64_t>()).collect(int((a[1]).as<int64_t>()))) {
    std::string_view name = std::visit([](auto const & x) { return proto::short_name(std::meta::remove_cvref(^^decltype(x))); }, m);
    if(std::ranges::contains(want, name)) out.push_back(flat_value(m));
  }
  return value(array_v::of(std::move(out)));
};
