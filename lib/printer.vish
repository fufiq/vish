module printer;
// The printer in the language (E5, the porting plan; a port from C++, branch t3/cpp-to-vish-migration; the user's goal: "C++ is only the link
// between the VM and the OS"). THE FIRST STEP is expressions only: int/float/str/name, a call without a tail and clauses, operations (prefix, infix, postfix,
// `.name`, `a[i]`, `.[k]`), chains of infixes. The rules for parentheses and spaces are as in include/vish/printer.hpp (stage0): print_node(n_op),
// print_node(n_chain), operand, receiver. Parentheses around an operand are chosen by the same prelude function `operand_parens` as in C++.
// Everything else is an explicit refusal "not supported: <node kind>", not silently wrong text.
// The author's earlier requirements: parsing logic and syntax are defined by logic in the language itself; all the logic
// is to be written in the new language itself. There is no separate quote from the author about the printer
// (a search for "printer" found only other people's or irrelevant remarks); the printer.hpp comment "a printer can be created without
// changing the type" has not been checked by me. What is *mine* here: the port of printing to the language as a continuation of R1, the order of steps
// (expressions first) and the byte-by-byte comparison `vish fmtcheck` with the C++ print.
// Equivalence is `vish fmtcheck <corpus>`: the print of a node in the language = the C++ (stage0) print of the same node.

use tools;
use lexer;
use parser;

// the result of printing: ok - the text; otherwise text is the reason for the refusal ("not supported: ...")
struct pres { bool ok; str text; }
pr_no(str why) => pres{false, "не поддержано: " + why};

// the node kind as a word: "ast.name" -> "name"
pr_kind_word(c) {
  t = text(code_kind(c));
  if(starts_with(t, "ast.")) text_from(t, 4) else t
}

hex_digit(i64 d) => slice_text("0123456789ABCDEF", d, d + 1);
// 0x... with capital digits, like "0x%llX" in C++ (the value is unsigned)
hex_text(i64 v) {
  if(v == 0) return "0x0";
  r = "";
  x = v;
  n = 0;
  while((x != 0) && (n < 16)) {
    r = hex_digit(x & 15) + r;
    x = (x >> 4) & 1152921504606846975;
    n += 1;
  }
  "0x" + r
}
printable_ascii() => " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
pr_int(c) {
  v = node_field(c, "value");
  if(node_field(c, "hex")) return pres{true, hex_text(v)};
  if(!node_field(c, "ch")) return pres{true, text(v)};
  if(v == 10) return pres{true, "'\\n'"};
  if(v == 9) return pres{true, "'\\t'"};
  if((v < 32) || (v > 126)) return pr_no("символьный литерал вне печатного ASCII");
  s = slice_text(printable_ascii(), v - 32, v - 31);
  if((v == 39) || (v == 92)) return pres{true, "'\\" + s + "'"};
  pres{true, "'" + s + "'"}
}
pr_float(c) {
  s = text(node_field(c, "value"));
  if(!contains(s, ".") && !contains(s, "e")) s = s + ".0";
  pres{true, s}
}
pr_str(c) {
  s = node_field(c, "value");
  r = text_buffer();
  put(r, "\"");
  for(k : range(s.size)) {
    b = s[k];
    if((b == 34) || (b == 92)) put(r, "\\" + slice_text(s, k, k + 1))
    else if(b == 10) put(r, "\\n")
    else put(r, slice_text(s, k, k + 1));
  }
  put(r, "\"");
  pres{true, take(r)}
}

// [[associative]] on the operator `infix<op>` declared in the prelude (like associative() in printer.hpp for associativity in place)
pr_associative(str op) {
  for(f : functions_named("infix" + op)) {
    for(a : node_field(f, "attrs")) if((code_kind(a) == ast.name) && (node_field(a, "name") == "associative")) return true;
  }
  false
}
// the chain operator if it is the only one in the whole chain, otherwise empty
pr_same_op(ops) {
  for(o : ops) if(o != ops[0]) return "";
  ops[0]
}
// the operand kind for operand_parens: "infix", "chain", "" (if and the rest are a separate refusal above)
pr_is_infix(c) {
  if(code_kind(c) != ast.operation) return false;
  ii_args = node_field(c, "args");
  op = node_field(c, "op");
  (ii_args.size == 2) && (!node_field(c, "postfix") && ((op != "[]") && (op != ".[]")))
}
// an operand in parentheses or without - by operand_parens (the prelude), like operand() in printer.hpp
pr_operand(c, bool left, str parent_op) {
  kind = "";
  child_op = "";
  if(pr_is_infix(c)) {
    kind = "infix";
    child_op = node_field(c, "op");
  } else if(code_kind(c) == ast.chain) {
    kind = "chain";
    child_op = pr_same_op(node_field(c, "ops"));
  }
  r = print_code(c);
  if(!r.ok) return r;
  if(kind == "") return r;
  assoc = left && ((parent_op != "") && ((child_op == parent_op) && pr_associative(parent_op)));
  if(operand_parens(kind, child_op, left, parent_op, assoc)) pres{true, "(" + r.text + ")"} else r
}
// the receiver of a postfix, an index, a field and a call: a prefix is always in parentheses, #x too (splice is not supported here)
pr_receiver(c) {
  if(code_kind(c) == ast.operation) {
    if((node_field(c, "args").size == 1) && !node_field(c, "postfix")) {
      r = print_code(c);
      if(!r.ok) return r;
      return pres{true, "(" + r.text + ")"};
    }
  }
  pr_operand(c, false, "")
}
pr_op(c) {
  op = node_field(c, "op");
  op_args = node_field(c, "args");
  post = node_field(c, "postfix");
  if(op_args.size == 2) {
    if(!post && (op == "[]")) {
      a = pr_receiver(op_args[0]);
      if(!a.ok) return a;
      i = print_code(op_args[1]);
      if(!i.ok) return i;
      return pres{true, a.text + "[" + i.text + "]"};
    }
    if(!post && (op == ".[]")) {
      a = pr_receiver(op_args[0]);
      if(!a.ok) return a;
      i = print_code(op_args[1]);
      if(!i.ok) return i;
      return pres{true, a.text + ".[" + i.text + "]"};
    }
  }
  if(op_args.size == 1) {
    if(post) {
      a = pr_receiver(op_args[0]);
      if(!a.ok) return a;
      return pres{true, a.text + op};
    }
    a = pr_operand(op_args[0], false, "");
    if(!a.ok) return a;
    return pres{true, op + a.text};
  }
  if(op_args.size != 2) return pr_no("операция с " + text(op_args.size) + " операндами");
  if((op == "=") || ((op == "+=") || ((op == "-=") || ((op == "*=") || (op == "/="))))) { // an assignment is a core form
    a = pr_operand(op_args[0], false, "");
    if(!a.ok) return a;
    b = print_code(op_args[1]);
    if(!b.ok) return b;
    return pres{true, a.text + " " + op + " " + b.text};
  }
  a = pr_operand(op_args[0], true, op);
  if(!a.ok) return a;
  b = pr_operand(op_args[1], false, "");
  if(!b.ok) return b;
  pres{true, a.text + " " + op + " " + b.text}
}
pr_chain(c) {
  atoms = node_field(c, "atoms");
  ops = node_field(c, "ops");
  same = pr_same_op(ops);
  r = "";
  for(k : range(atoms.size)) {
    if(k > 0) r = r + (" " + ops[k - 1] + " ");
    a = pr_operand(atoms[k], k == 0, same);
    if(!a.ok) return a;
    r = r + a.text;
  }
  pres{true, r}
}
pr_call(c) {
  pc_args = node_field(c, "args");
  if(node_field(c, "tagged")) return pr_no("call: tagged (шаблонная строка)");
  if(node_field(c, "tail")) return pr_no("call: хвостовой блок");
  if(node_field(c, "words").size > 0) return pr_no("call: клаузы со словами");
  if(node_field(c, "form") != 0) return pr_no("call: запись syntax");
  if(node_field(c, "literal_suffix") && (pc_args.size == 1)) { // 10s is a literal with a suffix
    a = print_code(pc_args[0]);
    if(!a.ok) return a;
    f = print_code(node_field(c, "callee"));
    if(!f.ok) return f;
    return pres{true, a.text + f.text};
  }
  f = pr_receiver(node_field(c, "callee"));
  if(!f.ok) return f;
  r = f.text + "(";
  for(k : range(pc_args.size)) {
    if(k > 0) r = r + ", ";
    a = print_code(pc_args[k]);
    if(!a.ok) return a;
    r = r + a.text;
  }
  pres{true, r + ")"}
}

// The text of an expression node. What is not supported is pres{false, "not supported: kind"}.
print_code(c) {
  k = code_kind(c);
  if(k == ast.int) return pr_int(c);
  if(k == ast.float) return pr_float(c);
  if(k == ast.string) return pr_str(c);
  if(k == ast.name) return pres{true, node_field(c, "name")};
  if(k == ast.operation) return pr_op(c);
  if(k == ast.chain) return pr_chain(c);
  if(k == ast.call) return pr_call(c);
  pr_no(pr_kind_word(c))
}

// --- comparison with C++ (vish fmtcheck) ---------------------------------------------------------------------------------------
// The C++ (stage0) print of an expression from text: `main() { x = expression }` parsed by the C++ parser with the prelude, the right side of the
// assignment printed by the C++ printer (include/vish/printer.hpp). Empty - C++ did not parse it (a hole) or it is the wrong form.
expr_print_reference(str src) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  static ast_db db; // like expr_reference in parser.vish: the prelude is loaded once per run
  static bool loaded = false;
  pool_scope keep(current_pool);
  db.use_pool();
  if(!loaded) {
    load_prelude(db);
    loaded = true;
  }
  std::string text = cat("main() { x = ", std::string(a[0].as<str_v>().view()), " }");
  parser p(db, text, "<fmtcheck>");
  node_id m = p.parse_module();
  if(!p.errors().empty()) return value(std::string());
  node_id fn;
  for(node_id x: db.as<n_module>(m).items)
    if(db.is<n_fn>(x)) fn = x;
  if(!fn || !db.is<n_block>(db.as<n_fn>(fn).body)) return value(std::string());
  auto const & items = db.as<n_block>(db.as<n_fn>(fn).body).items;
  if(items.size() != 1 || !db.is<n_op>(items[0]) || db.as<n_op>(items[0]).args.size() != 2) return value(std::string());
  return value(printer(db).print(db.as<n_op>(items[0]).args[1]));
};

// vish fmtcheck <corpus files>: for an expression in a line - the print in the language (print_code of a node from the Vish parser tree) byte by byte
// against the C++ print of the same expression; what is not supported goes into the histogram of reasons
fmt_check_cli(es) {
  same = 0;
  bad = 0;
  unsupported = 0;
  skipped = 0;
  reasons = array{};
  counts = array{};
  for(f : es) {
    for(line : lines_of(read_text(f))) {
      if(line == "") continue;
      mine = expr_of_pn(line);
      if((mine.error != "") || (mine.unsupported != "")) { // no tree in the language: the parser's refusal, not the printer's
        skipped += 1;
        continue;
      }
      r = node_of(mine.tree);
      if(!r.ok) {
        skipped += 1;
        continue;
      }
      p = print_code(r.node);
      if(!p.ok) {
        unsupported += 1;
        at = -1;
        for(j : range(reasons.size)) if(reasons[j] == p.text) at = j;
        if(at < 0) { reasons.push(p.text); counts.push(1); } else counts[at] += 1;
        continue;
      }
      ref = expr_print_reference(line);
      if(ref == "") { // C++ did not parse it, but the Vish parser gave a tree - a parser mismatch (not the printer's), but we see it too
        bad += 1;
        write_out(line + ": C++ не разобрал / не та форма, печать vish: " + p.text + "\n");
        continue;
      }
      if(p.text == ref) same += 1 else {
        bad += 1;
        write_out(line + ": расхождение\n--- vish: " + p.text + "\n--- C++:  " + ref + "\n");
      }
    }
  }
  write_out("принтер, выражения: совпало " + text(same) + ", не поддержано " + text(unsupported) + ", расхождений " + text(bad) + " (без дерева у парсера на Vish: " + text(skipped) + ")\n");
  for(j : range(reasons.size)) write_out("  " + reasons[j] + " — " + text(counts[j]) + "\n");
  if(bad == 0) 0 else 1
}
