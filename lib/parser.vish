module parser;
// parsing text projection in language (transfer from C++, branch t3/cpp-to-vish-migration; user goal: ). Step 2 - phase 1 parser
// (include/vish/parser.hpp, stage0): names `ast.вид` one token, repairing unpaired brackets in indentation, table of paired brackets.
// Equivalence - `vish parsecheck <файлы>`: tokens, match table and reasons coincide with C++.; with an unbalanced bracket (§4.1
// stack), Further steps (Phase 2, operators, constructions) - according to the same technique: your dump against C++ on the entire
// body.
//

use tools;
use lexer;
// Phase 1: token as in the lexer + byte ch (for brackets and operators; inserted closing brackets positions are empty)
struct ptok { i64 kind; i64 from; i64 to; bool glued; i64 err; i64 ch; }
struct phase1 { array tokens; array match; array errors; bool bracket_error; }
pairs(i64 o, i64 c) => ((o == 40) && (c == 41)) || (((o == 91) && (c == 93)) || ((o == 123) && (c == 125)));
closer_of(i64 o) => if(o == 40) 41 else if(o == 91) 93 else 125;
line_begin(str src, i64 at) {
  k = at;
  while((k > 0) && (src[k - 1] != 10)) k -= 1;
  k
}
// indentation of the line of text on which the position at: spaces and tabs at the beginning of the line
indent_of(str src, i64 at) {
  b = line_begin(src, at);
  ind = 0;
  while(((b + ind) < src.size) && ((src[b + ind] == 32) || (src[b + ind] == 9))) ind += 1;
  ind
}
// Lexer tokens → ptok; the name node AST is one lexeme: `ast` `.` word close (words of the types node after `ast.` are not words of the language)
fold_ast_names(str src, toks) {
  out = array{};
  i = 0;
  while(i < toks.size) {
    t = toks[i];
    ch = if((t.kind == kind_op()) || ((t.kind == kind_open()) || (t.kind == kind_close()))) src[t.from] else 0;
    p = ptok{t.kind, t.from, t.to, t.glued, t.err, ch};
    after_dot = (out.size > 0) && ((out[out.size - 1].kind == kind_op()) && ((out[out.size - 1].ch == 46) && t.glued));
    if((t.kind == kind_ident()) && ((text_range(src, t.from, t.to) == "ast") && (!after_dot && (((i + 2) < toks.size) && ((toks[i + 1].kind == kind_op()) && ((src[toks[i + 1].from] == 46) && (toks[i + 1].glued && ((toks[i + 2].kind == kind_ident()) && toks[i + 2].glued)))))))) {
      p.to = toks[i + 2].to;
      i += 2;
    }
    out.push(p);
    i += 1;
  }
  out
}
// Brackets are unpaired - repair by indentation: the unclosed opener closes before the first line with indentation ≤ of its line
// (or before someone else's closing line, or at the end of the text) empty closing with the reason "unclosed bracket"; excess
// closing - token-hole "unpaired bracket". *Mine* (from C++): indentation - only when brackets are unpaired.
close_by_indent(str src, toks, errors) {
  out = array{};
  open = array{}; // stack of numbers out; arrays only grow (pop no) - depth in on
  indent = array{};
  on = 0;
  for(t0 : toks) {
    t = t0;
    ind = indent_of(src, t.from);
    first = (line_begin(src, t.from) + ind) == t.from;
    own_close = (t.kind == kind_close()) && ((on > 0) && pairs(out[open[on - 1]].ch, t.ch));
    while((on > 0) && (!own_close && ((t.kind == kind_end()) || (first && (ind <= indent[on - 1]))))) {
      o = out[open[on - 1]];
      at = out[out.size - 1].to;
      errors.push(lex_error{"незакрытая скобка", o.from, o.to});
      out.push(ptok{kind_close(), at, at, true, errors.size - 1, closer_of(o.ch)});
      on -= 1;
      own_close = (t.kind == kind_close()) && ((on > 0) && pairs(out[open[on - 1]].ch, t.ch));
    }
    if(t.kind == kind_open()) {
      if(on < open.size) {
        open[on] = out.size;
        indent[on] = ind;
      } else {
        open.push(out.size);
        indent.push(ind);
      }
      on += 1;
    } else if(t.kind == kind_close()) {
      fits = false;
      for(q : range(on)) if(pairs(out[open[q]].ch, t.ch)) fits = true;
      if(!fits) {
        t.kind = kind_bad();
        t.ch = 0; // ch is available only for brackets and operators
        errors.push(lex_error{"непарная скобка", t.from, t.to});
        t.err = errors.size - 1;
      } else {
        while(!pairs(out[open[on - 1]].ch, t.ch)) {
          // `{ ( }` - `(` closes before `}`
          o = out[open[on - 1]];
          at = out[out.size - 1].to;
          errors.push(lex_error{"незакрытая скобка", o.from, o.to});
          out.push(ptok{kind_close(), at, at, true, errors.size - 1, closer_of(o.ch)});
          on -= 1;
        }
        on -= 1;
      }
    }
    out.push(t);
  }
  out
}
// double bracket table: pair number or -1
rematch(toks) {
  match = array{};
  for(k : range(toks.size)) match.push(-1);
  open = array{};
  on = 0;
  for(i : range(toks.size)) {
    if(toks[i].kind == kind_open()) {
      if(on < open.size) open[on] = i else open.push(i);
      on += 1;
    } else if(toks[i].kind == kind_close()) {
      on -= 1;
      j = open[on];
      match[j] = i;
      match[i] = j;
    }
  }
  match
}
phase1_of(str src) {
  r = lex(src);
  toks = fold_ast_names(src, r.tokens);
  errors = r.errors;
  stack = array{};
  sn = 0;
  broken = false;
  for(t : toks) {
    if(t.kind == kind_open()) {
      if(sn < stack.size) stack[sn] = t.ch else stack.push(t.ch);
      sn += 1;
    } else if(t.kind == kind_close()) {
      if((sn == 0) || !pairs(stack[sn - 1], t.ch)) broken = true else sn -= 1;
    }
  }
  if(sn > 0) broken = true;
  if(broken) toks = close_by_indent(src, toks, errors);
  phase1{toks, rematch(toks), errors, broken}
}
dump1(phase1 r) {
  // a buffer, not `out = out + ...` (a square from copies of a growing string; see dump in lib/lexer.vish; the author's "buffer + position")
  out = text_buffer();
  for(t : r.tokens) put(out, "t " + text(t.kind) + " " + text(t.from) + " " + text(t.to) + " " + (if(t.glued) "1" else "0") + " " + text(t.err) + " " + text(t.ch) + "\n");
  for(k : range(r.match.size)) put(out, "m " + text(k) + " " + text(r.match[k]) + "\n");
  for(e : r.errors) put(out, "e " + text(e.from) + " " + text(e.to) + " " + e.what + "\n");
  put(out, "b " + (if(r.bracket_error) "1" else "0") + "\n");
  take(out)
}
// Phase 1 C++ (stage0) - same dump
phase1_reference(str src) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  ast_db db;
  parser p(db, a[0].as<str_v>().view(), "<parsecheck>");
  std::string out;
  for(auto const & t: p.toks) out += cat("t ", int(t.kind), " ", t.where.begin, " ", t.where.end, " ", t.glued ? 1 : 0, " ", t.err == ~uint32_t{0} ? int64_t(-1) : int64_t(t.err), " ", int(uint8_t(t.ch())), "\n");
  for(std::size_t k = 0; k < p.match.size(); ++k) out += cat("m ", k, " ", p.match[k] == ~uint32_t{0} ? int64_t(-1) : int64_t(p.match[k]), "\n");
  for(auto const & d: p.diags) out += cat("e ", d.where.begin, " ", d.where.end, " ", std::string_view(d.what()), "\n");
  out += cat("b ", p.bracket_error ? 1 : 0, "\n");
  return value(std::move(out));
};
// vish parsecheck <files>: Phase 1 in language = Phase 1 C++ on each file; code 0 - all matched
check_cli(args) {
  bad = 0;
  total = 0;
  for(f : args) {
    src = read_text(f);
    mine = dump1(phase1_of(src));
    ref = phase1_reference(src);
    total += 1;
    if(mine != ref) {
      bad += 1;
      a = lines_of(mine);
      b = lines_of(ref);
      k = 0;
      while((k < a.size) && ((k < b.size) && (a[k] == b[k]))) k += 1;
      write_out(f + ": расхождение в строке дампа " + text(k) + "\n  vish: " + (if(k < a.size) a[k] else "—") + "\n  C++:  " + (if(k < b.size) b[k] else "—") + "\n");
    }
  }
  write_out("парсер, фаза 1: файлов " + text(total) + ", расхождений " + text(bad) + "\n");
  if(bad == 0) 0 else 1
}
// ---- Step 3a: phase 2 expressions (a subset; include/vish/parser.hpp, stage0, expression/chain/postfix/call/primary) ----
// The tree is built by the pn structure and printed in the `vish ast` format (the dumper). Operator runs are parsed as in C++ (`run_length`,
// `splits`): exactly one split into postfixes*, [infix, prefixes*]; there are no priorities - a run of atoms with operators = n_chain.
// "an operator is always one character... the rules described for operators" (the author). *Mine:* the table of operator roles
// is fixed from the prelude (in C++ it comes from `operator` declarations in scope) - for now without module rules.
// Not supported (the reason is in ps.unsupported, the comparison skips such texts): record words (if/loop/return...), `{...}` blocks and records,
// lambdas, `name"..."`, trailing call blocks, declarations in parentheses; the prelude's record words and `Name{...}`/`...x` - see record_use and postfix.
// Real literals are already supported; #name is n_splice without children, like unary_core in C++ (without glued and a direct postfix).
struct pn { str kind; str info; array kids; array callee; array ops = array{}; str raw = ""; code node = code(); } // node - in n_ready: the node is already built (a syntax record) // ops - the infix operators of a run (n_chain): not part of the stage0 dump
struct ps { str src; array toks; array match; i64 pos; str unsupported; str error; array rules = array{}; bool tail = false; i64 head = -1; bool lwv = false; bool custom = false; array cons = array{}; array ops = array{array{}, array{}, array{}}; bool line = false; array lerrs = array{}; }
pn_new(str kind, str info, kids) => pn{kind, info, kids, array{}};
two(pn a, pn b) {
  r = array{};
  r.push(a);
  r.push(b);
  r
}
pn_hole(str why) => pn{"n_hole", "", array{}, array{}};
tk_at(ps s, i64 i) => if(i < s.toks.size) s.toks[i] else s.toks[s.toks.size - 1];
tk(ps s, i64 k) => if((s.pos + k) < s.toks.size) s.toks[s.pos + k] else s.toks[s.toks.size - 1];
tk_text(ps s, i64 k) => text_range(s.src, tk(s, k).from, tk(s, k).to);
want(ps s, str why) {
  if(s.unsupported == "") s.unsupported = why;
  0
}
fail(ps s, str why) {
  if(s.error == "") s.error = why;
  0
}
op_char(i64 c) => has_number(array{43, 45, 42, 47, 37, 60, 62, 61, 33, 38, 124, 94, 126, 63, 64, 36, 92}, c);
is_open_ch(ps s, i64 c, i64 k) => (tk(s, k).kind == kind_open()) && (tk(s, k).ch == c);
is_close_ch(ps s, i64 c) => (tk(s, 0).kind == kind_close()) && ((tk(s, 0).ch == c) && (tk(s, 0).err < 0));
// glued symbols o starting with token k
glued_as(ps s, str o, i64 k) {
  ok = true;
  for(i : range(o.size)) {
    t = tk(s, k + i);
    if(!((t.kind == kind_op()) && (t.ch == o[i]) && ((i == 0) || t.glued))) ok = false;
  }
  ok
}
core_ops() => array{"...", "=>", "+=", "-=", "*=", "/=", ".."};
roles_infix0() => array{"+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">=", "&&", "||", "&", "|", "^", "<<", ">>"};
roles_prefix0() => array{"-", "!"};
roles_postfix0() => array{"?"};
// operator roles: the prelude + those declared by the program (learn_operator parser.hpp)
roles_infix(ps s) => array{...roles_infix0(), ...s.ops[0]};
roles_prefix(ps s) => array{...roles_prefix0(), ...s.ops[1]};
roles_postfix(ps s) => array{...roles_postfix0(), ...s.ops[2]};
longest_op(ps s, i64 k) {
  t0 = tk(s, k);
  if(t0.kind != kind_op()) return "";
  best = text_range(s.src, t0.from, t0.from + 1);
  for(o : core_ops()) if((o.size > best.size) && glued_as(s, o, k)) best = o;
  for(o : roles_infix(s)) if((o.size > best.size) && glued_as(s, o, k)) best = o;
  best
}
is_op_at(ps s, str o, i64 k) => longest_op(s, k) == o;
is_role(ps s, str sym, i64 role) => has_text(if(role == 0) roles_prefix(s) else if(role == 1) roles_infix(s) else roles_postfix(s), sym);
run_length(ps s, i64 k) {
  n = 0;
  while((tk(s, k + n).kind == kind_op()) && (op_char(tk(s, k + n).ch) && !is_op_at(s, "=>", k + n))) n += 1;
  n
}
struct run_split { array post; array pre; str infix; }
// partitioning of a number of n tokens: post* [infix pre*]; glued symbols can be cut, space - boundary
splits(ps s, i64 i, i64 n, i64 phase, bool want_infix, array post, array pre, str infix, array out) {
  if(out.size > 1) return 0;
  if(i == n) {
    if(!want_infix || (phase == 1)) out.push(run_split{post, pre, infix});
    return 0;
  }
  sym = "";
  len = 1;
  while((i + len) <= n) {
    if((len > 1) && !tk(s, (i + len) - 1).glued) break;
    sym = sym + text_range(s.src, tk(s, (i + len) - 1).from, tk(s, (i + len) - 1).from + 1);
    if((phase == 0) && is_role(s, sym, 2)) splits(s, i + len, n, 0, want_infix, array{...post, sym}, pre, infix, out);
    if((phase == 0) && (want_infix && is_role(s, sym, 1))) splits(s, i + len, n, 1, want_infix, post, pre, sym, out);
    if((phase == 1) && is_role(s, sym, 0)) splits(s, i + len, n, 1, want_infix, post, array{...pre, sym}, infix, out);
    len += 1;
  }
  0
}
is_keyword_word(str w) => has_text(array{"if", "loop", "return", "throw", "break", "continue", "hide", "try_compile", "ct", "const", "outline", "module", "operator", "native", "quote", "use", "struct", "syntax", "try", "else", "until", "for", "while", "catch", "finally"}, w);
// beginning of the operand on token k (starts_operand)
starts_operand(ps s, i64 k) {
  t = tk(s, k);
  if(t.kind == kind_ident()) return true;
  if((t.kind == kind_int()) || ((t.kind == kind_float()) || ((t.kind == kind_str()) || (t.kind == kind_char())))) return true;
  if(t.kind == kind_open()) return (t.ch == 40) || (t.ch == 123);
  (t.kind == kind_op()) && (t.ch == 35)
}
int_value(str lit) {
  v = 0;
  hex = (lit.size > 1) && ((lit[0] == 48) && ((lit[1] == 120) || (lit[1] == 88)));
  k = if(hex) 2 else 0;
  while(k < lit.size) {
    c = lit[k];
    if(c != 95) {
      d = if(c <= 57) c - 48 else ((c | 32) - 97) + 10;
      v = (v * (if(hex) 16 else 10)) + d;
    }
    k += 1;
  }
  v
}
// as unescape C++: between quotes, `\n` →LF, `\t` →TAB, etc. after `\` - the symbol itself
unescape_lit(str lit) {
  out = "";
  i = 1;
  while((i + 1) < lit.size) {
    if((lit[i] == 92) && ((i + 2) < lit.size)) {
      i += 1;
      c = lit[i];
      out = out + (if(c == 110) "\n" else if(c == 116) "	" else text_range(lit, i, i + 1));
    } else out = out + text_range(lit, i, i + 1);
    i += 1;
  }
  out
}
// as in_quotes dumper: LF and TAB - `\n`, `\t`; quote and inverse line - with the inverse line
quoted_text(str v) {
  out = "\"";
  for(i : range(v.size)) {
    c = v[i];
    out = out + (if(c == 10) "\\n" else if(c == 9) "\\t" else if(c == 34) "\\\"" else if(c == 92) "\\\\" else text_range(v, i, i + 1));
  }
  out + "\""
}
// parser.hpp 2552-2557 (parse_float): without '_', std::stod; the record is like cat(double) in the dump
// (dump.hpp: " value=" + cat(x), the shortest to_chars). A NEW primitive - right in this file
// (like expr_reference below), lib/prelude.vish is NOT changed; modelled on text_fixed (prelude.vish:1708):
// native "cpp" without `#` wrappers, argument a[0], an unknown one (not computed at compile time) - erase(...).
// Declaration/placement: right before primary, once. After adding it - per AGENTS.md:
// `out/vish native out/native.hpp lib/tools.vish ... lib/parser.vish ...`, then ./build.sh release (twice).
float_value(str lit) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  std::string clean;
  for(char c: std::string(a[0].as<str_v>().view()))
    if(c != '_') clean += c;
  return value(cat(std::stod(clean)));
};
// the value of a real literal as f64 (for ast.float): without '_', std::stod - the same as float_value (text) in the dump
float_of(str lit) => native "cpp" {
  if(!a[0].known()) return erase(value(0.0));
  std::string clean;
  for(char c: std::string(a[0].as<str_v>().view()))
    if(c != '_') clean += c;
  return value(double(std::stod(clean)));
};
primary(ps s) {
  if(pattern_ahead(s)) { // pattern = value in an expression is a predicate (parser.hpp primary)
    pu = unpack_node(s, true);
    if(!pu.ok) { if((s.unsupported == "") && (s.error == "")) want(s, "образец без узла"); return pn_hole(""); }
    return pn{"n_ready", "", array{}, array{}, array{}, "", pu.node};
  }
  t = tk(s, 0);
  if(t.kind == kind_int()) {
    lit = tk_text(s, 0);
    s.pos += 1;
    hex = (lit.size > 1) && ((lit[0] == 48) && ((lit[1] == 120) || (lit[1] == 88)));
    node = pn_new("n_int", " value=" + text(int_value(lit)) + (if(hex) " hex" else ""), array{});
    if((tk(s, 0).kind == kind_ident()) && (tk(s, 0).glued && !is_keyword_word(tk_text(s, 0)))) {
      callee = pn_new("n_ident", " name=" + tk_text(s, 0), array{});
      s.pos += 1;
      return pn{"n_call", " literal_suffix", array{node}, array{callee}};
    }
    return node;
  }
  if(t.kind == kind_float()) {
    // parser.hpp 2448-2451: n_float{parse_float(t.text)} + literal_suffix
    lit = tk_text(s, 0);
    s.pos += 1;
    node = pn{"n_float", " value=" + float_value(lit), array{}, array{}, array{}, lit};
    // literal suffix (2.5ms == ms(2.5)): as for int above; parser.hpp 2528-2537
    if((tk(s, 0).kind == kind_ident()) && (tk(s, 0).glued && !is_keyword_word(tk_text(s, 0)))) {
      callee = pn_new("n_ident", " name=" + tk_text(s, 0), array{});
      s.pos += 1;
      return pn{"n_call", " literal_suffix", array{node}, array{callee}};
    }
    return node;
  }
  if(t.kind == kind_char()) {
    b = unescape_lit(tk_text(s, 0));
    s.pos += 1;
    if(b.size != 1) {
      fail(s, "символ '…' — один байт");
      return pn_hole("");
    }
    return pn_new("n_int", " value=" + text(b[0]) + " ch", array{});
  }
  if(t.kind == kind_str()) {
    v = unescape_lit(tk_text(s, 0));
    s.pos += 1;
    return pn{"n_str", " value=" + quoted_text(v), array{}, array{}, array{}, v};
  }
  if(t.kind == kind_ident()) {
    w = tk_text(s, 0);
    if(rule_has(s, w) && !((tk(s, 1).kind == kind_str()) && tk(s, 1).glued)) {
      r = record_use(s);
      return if(r.ok) pn{"n_ready", "", array{}, array{}, array{}, "", r.node} else pn_hole("");
    }
    if((w == "ct") && !((tk(s, 1).kind == kind_ident()) && is_op_at(s, "=", 2)) && !((tk(s, 1).kind == kind_str()) && tk(s, 1).glued)) { // ct"..." is a template string tagged ct, not a ct expression
      // ct e / ct { ... } - evaluation at compile time (parser.hpp primary); `ct x = e` is a variable, not supported
      s.pos += 1;
      ct_body = if(is_open_ch(s, 123, 0)) block_node(s) else node_of(unary_core(s));
      if(!ct_body.ok) { if(s.unsupported == "") want(s, "ct без узла"); return pn_hole(""); }
      return pn{"n_ready", "", array{}, array{}, array{}, "", ast.ct{ct_body.node}};
    }
    cw_ci = cons_of(s, w);
    if((cw_ci >= 0) && ((is_open_ch(s, 40, 1) && tk(s, 1).glued) || ((s.cons[cw_ci][2] == 1) && is_open_ch(s, 123, 1) && !tk(s, 1).glued))) { // as postfix parser.hpp: `(` is glued, a bare `{` is not
      cw_head = s.pos == s.head;
      s.pos += 1;
      return cons_call(s, pn_new("n_ident", " name=" + w, array{}), cw_ci, cw_head);
    }
    if(is_keyword_word(w) && (cw_ci < 0)) {
      want(s, "слово-запись " + w);
      s.pos += 1;
      return pn_hole("");
    }
    if((tk(s, 1).kind == kind_str()) && tk(s, 1).glued) {
      want(s, "шаблонная строка");
      s.pos += 1;
      return pn_hole("");
    }
    s.pos += 1;
    return pn_new("n_ident", " name=" + w, array{});
  }
  if(t.kind == kind_open()) {
    if(t.ch == 123) {
      if((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2)) { // {name: e, ...} - a record (record parser.hpp)
        s.pos += 1;
        pr_names = array{};
        pr_items = array{};
        loop {
          if(is_close_ch(s, 125)) break;
          if(!((tk(s, 0).kind == kind_ident()) && is_op_at(s, ":", 1))) { fail(s, "ожидалось имя поля"); return pn_hole(""); }
          pr_names.push(tk_text(s, 0));
          s.pos += 2;
          pr_e = value_expr(s);
          if((s.error != "") || (s.unsupported != "")) return pn_hole("");
          pr_r = node_of(pr_e);
          if(!pr_r.ok) { want(s, "значение поля записи без узла"); return pn_hole(""); }
          pr_items.push(pr_r.node);
          if(is_op_at(s, ",", 0)) s.pos += 1 else break;
        }
        if(is_close_ch(s, 125)) s.pos += 1 else { fail(s, "ожидалось '}'"); return pn_hole(""); }
        if(is_op_at(s, "=", 0)) { want(s, "образец распаковки {имя: …} = e"); return pn_hole(""); }
        return pn{"n_ready", "", array{}, array{}, array{}, "", ast.construct{code(), pr_items, pr_names}};
      }
      pb = block_node(s);
      if(!pb.ok) { if(s.unsupported == "") want(s, "блок без узла"); return pn_hole(""); }
      return pn{"n_ready", "", array{}, array{}, array{}, "", pb.node};
    }
    if(t.ch == 40) {
      close = s.match[s.pos];
      if((close >= 0) && is_op_at(s, "=>", (close + 1) - s.pos)) { // (parameters) => body
        pl = plist(s);
        if(!pl.ok) return pn_hole("");
        s.pos += 2;
        pl_body = code();
        if(is_open_ch(s, 123, 0) && !((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2))) {
          pl_b = block_node(s);
          if(!pl_b.ok) return pn_hole("");
          pl_body = pl_b.node;
        } else {
          pl_e = expression(s);
          if((s.error != "") || (s.unsupported != "")) return pn_hole("");
          pl_r = node_of(pl_e);
          if(!pl_r.ok) { want(s, "тело лямбды без узла"); return pn_hole(""); }
          pl_body = pl_r.node;
        }
        return pn{"n_ready", "", array{}, array{}, array{}, "", ast.lambda{pl.items, pl_body, false}};
      }
      s.pos += 1;
      e = expression(s);
      if(is_close_ch(s, 41)) s.pos += 1 else fail(s, "ожидалось ')'");
      return e;
    }
  }
  fail(s, "ожидалось выражение");
  pn_hole("")
}
unary_core(ps s) {
  if((tk(s, 0).kind == kind_op()) && ((tk(s, 0).ch == 35) && (tk(s, 1).kind == kind_ident()))) {
    name = tk_text(s, 1);
    s.pos += 2;
    return pn_new("n_splice", " name=" + name, array{});
  }
  postfix(s, primary(s))
}
call_of(ps s, pn callee) {
  es = array{};
  s.pos += 1;
  while(!is_close_ch(s, 41) && ((tk(s, 0).kind != kind_end()) && (s.error == ""))) {
    if(is_op_at(s, "...", 0)) {
      want(s, "раскрытие ...");
      s.pos += 1;
      break;
    }
    if((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident())) {
      want(s, "объявление в скобках");
      s.pos += 1;
      break;
    }
    es.push(value_expr(s)); // m({}) - a value of the parameter's type
    if(is_op_at(s, ",", 0)) s.pos += 1 else break;
  }
  if(is_close_ch(s, 41)) s.pos += 1 else fail(s, "ожидалось ')'");
  if(is_open_ch(s, 123, 0) && !tk(s, 0).glued) want(s, "хвостовой блок вызова у «" + tk_text(s, -1) + "»");
  pn{"n_call", "", es, array{callee}}
}
postfix(ps s, pn e0) {
  e = e0;
  loop {
    if(s.error != "") break;
    if(s.tail) break; // a record with `;` (return x;) ended the instruction (parser.hpp postfix: tail_statement)
    pf_ci = if(e.kind == "n_ident") cons_of(s, after_text(e.info, "name=")) else -1;
    if((pf_ci >= 0) && ((is_open_ch(s, 40, 0) && tk(s, 0).glued) || ((s.cons[pf_ci][2] == 1) && is_open_ch(s, 123, 0) && !tk(s, 0).glued))) {
      // a construct with the name in parentheses: (for)(x : xs) {} - callee is determined by the node (construct_of parser.hpp); the head of the instruction is not a name
      e = cons_call(s, e, pf_ci, false);
      if(s.tail) break;
    } else if(is_open_ch(s, 40, 0) && tk(s, 0).glued) {
      e = call_of(s, e);
      if(s.tail) break;
    } else if(is_open_ch(s, 91, 0) && tk(s, 0).glued) {
      s.pos += 1;
      i = expression(s);
      if(is_close_ch(s, 93)) s.pos += 1 else fail(s, "ожидалось ']'");
      e = pn_new("n_op", " op=[]", two(e, i));
    } else if(is_open_ch(s, 123, 0) && (tk(s, 0).glued && (e.kind == "n_ident"))) {
      // Name{a, b, ...xs}: brace_items parser.hpp; a record value {...} inside (a value of the field's type) is not supported;
      // after `}` a lone `=` is an unpacking pattern (pattern_ahead), not a constructor
      m = s.match[s.pos];
      if((m >= 0) && is_op_at(s, "=", (m + 1) - s.pos)) {
        want(s, "образец распаковки");
        break;
      }
      s.pos += 1;
      items = array{};
      loop {
        if(is_close_ch(s, 125)) break;
        if(is_op_at(s, "...", 0)) {
          s.pos += 3;
          v = expression(s);
          items.push(pn{"n_spread", "", array{}, array{v}});
        } else {
          items.push(value_expr(s)); // Name{{}, ...} - a value of the field's type
        }
        if(s.error != "") break;
        if(is_op_at(s, ",", 0)) s.pos += 1 else break;
      }
      if(s.unsupported != "") break;
      if(is_close_ch(s, 125)) s.pos += 1 else fail(s, "ожидалось '}'");
      e = pn{"n_construct", "", items, array{e}};
    } else if(is_op_at(s, ".", 0) && is_open_ch(s, 91, 1)) {
      s.pos += 2;
      key = expression(s);
      if(is_close_ch(s, 93)) s.pos += 1 else fail(s, "ожидалось ']'");
      e = pn_new("n_op", " op=.[]", two(e, key));
    } else if(is_op_at(s, ".", 0) && !is_op_at(s, "..", 0)) {
      s.pos += 1;
      if(tk(s, 0).kind == kind_ident()) {
        e = pn_new("n_op", " op=." + tk_text(s, 0) + " postfix", array{e});
        s.pos += 1;
      } else {
        fail(s, "ожидалось имя");
        break;
      }
    } else break;
  }
  e
}
chain(ps s) {
  pre = array{};
  n = run_length(s, 0);
  if((n > 0) && !is_op_at(s, "=>", 0)) {
    v = array{};
    splits(s, 0, n, 1, false, array{}, array{}, "", v);
    if(v.size != 1) {
      fail(s, "нет префиксного оператора или неоднозначно");
      return pn_hole("");
    }
    pre = v[0].pre;
    s.pos += n;
  }
  atoms = array{};
  infix = array{};
  loop {
    p0 = s.pos;
    a = unary_core(s);
    if(s.error != "") return pn_hole("");
    // an instruction that ends with a block (if/loop) ends at `}`: the next line `-1` is a new instruction, not a minus
    is_if_atom = (a.kind == "n_ready") && (code_kind(a.node) == ast.if);
    closed = s.tail || ((is_if_atom && if_closed_node(a.node)) || (!is_if_atom && (p0 == s.head) && ends_with_block_pn(a)));
    n = if(closed) 0 else run_length(s, 0);
    sp = run_split{array{}, array{}, ""};
    more = false;
    if(n > 0) {
      more = starts_operand(s, n);
      v = array{};
      splits(s, 0, n, 0, more, array{}, array{}, "", v);
      assign = is_op_at(s, "=", 0) || (is_op_at(s, "+=", 0) || (is_op_at(s, "-=", 0) || (is_op_at(s, "*=", 0) || is_op_at(s, "/=", 0))));
      if((v.size == 0) && assign) {
        n = 0;
        more = false;
      } else if(v.size == 0) {
        if(s.line) fail(s, "нет оператора") else want(s, "нет оператора (правила контекста — программа, конструкции — могут его объявлять)");
        return pn_hole("");
      } else if(v.size > 1) {
        fail(s, "запись операторов неоднозначна");
        return pn_hole("");
      } else {
        sp = v[0];
        s.pos += n;
      }
    }
    for(p : sp.post) a = pn_new("n_op", " op=" + p + " postfix", array{a});
    k = pre.size;
    while(k > 0) {
      k -= 1;
      a = pn_new("n_op", " op=" + pre[k], array{a});
    }
    atoms.push(a);
    if(!more) break;
    infix.push(sp.infix);
    pre = sp.pre;
  }
  if(atoms.size == 1) return atoms[0];
  if(infix.size == 1) return pn_new("n_op", " op=" + infix[0], two(atoms[0], atoms[1]));
  pn{"n_chain", "", atoms, array{}, infix}
}
// --- unpacking patterns (pattern/pattern_element/unpack parser.hpp): Name{...} = e, {name: ...} = e; `.field:`/`[k]:` are not supported
record_ahead(ps s) => is_open_ch(s, 123, 0) && (tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2);
pattern_ahead(ps s) {
  if(record_ahead(s)) {
    m = s.match[s.pos];
    return (m >= 0) && is_op_at(s, "=", (m + 1) - s.pos);
  }
  if(!((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 123, 1) && tk(s, 1).glued)) return false;
  m = s.match[s.pos + 1];
  (m >= 0) && is_op_at(s, "=", (m + 1) - s.pos)
}
pattern_element(ps s) {
  if(is_open_ch(s, 40, 0)) {
    pe_e = expression(s);
    if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
    return node_of(pe_e);
  }
  if(((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 123, 1) && tk(s, 1).glued) || record_ahead(s)) return pattern_node(s);
  pe_strict = false;
  if((tk_text(s, 0) == "explicit") && (tk(s, 1).kind == kind_ident()) && (tk(s, 2).kind == kind_ident())) { pe_strict = true; s.pos += 1; }
  pe_ty = code();
  if(tk(s, 1).kind == kind_ident()) {
    if(tk(s, 0).kind != kind_ident()) { want(s, "тип образца"); return nres{false, code()}; }
    if(tk_text(s, 0) == "auto") { want(s, "auto не нужен"); return nres{false, code()}; }
    pe_ty = ast.name{tk_text(s, 0)};
    s.pos += 1;
  }
  if(tk(s, 0).kind != kind_ident()) { want(s, "имя в образце"); return nres{false, code()}; }
  pe_nm = tk_text(s, 0);
  s.pos += 1;
  nres{true, ast.parameter{pe_nm, pe_ty, 0, false, "", pe_strict, -1}}
}
pattern_node(ps s) {
  pn_items = array{};
  if(record_ahead(s)) {
    s.pos += 1;
    loop {
      if(is_close_ch(s, 125)) break;
      if(tk(s, 0).kind != kind_ident()) { fail(s, "ожидалось имя поля"); return nres{false, code()}; }
      pn_name = tk_text(s, 0);
      s.pos += 1;
      if(!is_op_at(s, ":", 0)) { fail(s, "ожидалось ':'"); return nres{false, code()}; }
      s.pos += 1;
      pn_sub = pattern_element(s);
      if(!pn_sub.ok) return nres{false, code()};
      pn_acc = ast.operation{"." + pn_name, array{ast.subject{}}, true};
      pn_items.push(ast.pattern_field{pn_acc, pn_sub.node});
      if(is_op_at(s, ",", 0)) s.pos += 1 else break;
    }
    if(is_close_ch(s, 125)) s.pos += 1 else { fail(s, "ожидалось '}'"); return nres{false, code()}; }
    return nres{true, ast.pattern{code(), pn_items}};
  }
  pn_type = ast.name{tk_text(s, 0)};
  s.pos += 2;
  loop {
    if(is_close_ch(s, 125)) break;
    if((is_op_at(s, ".", 0) && !is_op_at(s, "...", 0)) || is_open_ch(s, 91, 0)) { want(s, "образец: .поле/[k]: подобразец"); return nres{false, code()}; }
    if(is_op_at(s, "...", 0)) {
      s.pos += 3;
      if(tk(s, 0).kind != kind_ident()) { want(s, "имя остатка образца"); return nres{false, code()}; }
      pn_items.push(ast.parameter{tk_text(s, 0), code(), 0, true, "", false, -1});
      s.pos += 1;
    } else if(is_open_ch(s, 40, 0)) {
      pn_e = expression(s);
      if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
      pn_r = node_of(pn_e);
      if(!pn_r.ok) { want(s, "значение образца без узла"); return nres{false, code()}; }
      pn_items.push(pn_r.node);
    } else if((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 123, 1) && tk(s, 1).glued) {
      pn_n = pattern_node(s);
      if(!pn_n.ok) return nres{false, code()};
      pn_items.push(pn_n.node);
    } else {
      pn_el = pattern_element(s);
      if(!pn_el.ok) return nres{false, code()};
      pn_items.push(pn_el.node);
    }
    if(is_op_at(s, ",", 0)) s.pos += 1 else break;
  }
  if(is_close_ch(s, 125)) s.pos += 1 else { fail(s, "ожидалось '}'"); return nres{false, code()}; }
  nres{true, ast.pattern{pn_type, pn_items}}
}
// pattern = value (test is a predicate in an expression)
unpack_node(ps s, bool test) {
  un_p = pattern_node(s);
  if(!un_p.ok) return nres{false, code()};
  if(!is_op_at(s, "=", 0)) { fail(s, "ожидалось '='"); return nres{false, code()}; }
  s.pos += 1;
  un_e = expression(s);
  if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
  un_r = node_of(un_e);
  if(!un_r.ok) { want(s, "значение распаковки без узла"); return nres{false, code()}; }
  nres{true, ast.unpack{un_p.node, un_r.node, test}}
}
// {} - a value of the place's type: a literal without fields (value_expr/empty_value_ahead parser.hpp): after `{}` comes `)`, `}`, `,` or `;`
empty_value_ahead(ps s) => is_open_ch(s, 123, 0) && is_close_ch_at(s, 125, 1) && (is_close_ch_at(s, 41, 2) || is_close_ch_at(s, 125, 2) || is_op_at(s, ",", 2) || is_op_at(s, ";", 2) || (s.line && (tk(s, 2).kind == kind_end())));
value_expr(ps s) {
  if(empty_value_ahead(s)) {
    s.pos += 2;
    return pn{"n_ready", "", array{}, array{}, array{}, "", ast.construct{code(), array{}, array{}}};
  }
  expression(s)
}
expression(ps s) {
  lhs = chain(s);
  if(s.error != "") return lhs;
  if(s.tail || ((lhs.kind == "n_ready") && (code_kind(lhs.node) == ast.if) && if_closed_node(lhs.node))) return lhs;
  for(a : array{"+=", "-=", "*=", "/=", "="}) {
    if(is_op_at(s, a, 0)) {
      s.pos += a.size;
      rhs = if(a == "=") value_expr(s) else expression(s); // p = {} - a value of the place's type
      return pn_new("n_op", " op=" + a, two(lhs, rhs));
    }
  }
  lhs
}
dump_pn(pn x, i64 depth) {
  pad = "";
  for(i : range(depth)) pad = pad + "  ";
  if(x.kind == "n_ready") { // the record node is already built: dumped by the C++ dumper, with a shift
    r = text_buffer();
    for(l : lines_of(dump_code(x.node))) put(r, pad + l + "\n");
    return take(r);
  }
  chain_ops = "";
  if((x.kind == "n_chain") && (x.ops.size > 0)) { // like the C++ dumper: ops=[+,*] - without them the dumps of a+b+c and a-b-c are equal
    chain_ops = " ops=[";
    for(i : range(x.ops.size)) chain_ops = chain_ops + (if(i > 0) "," else "") + x.ops[i];
    chain_ops = chain_ops + "]";
  }
  out = pad + x.kind + x.info + chain_ops + "\n";
  if(x.callee.size > 0) out = out + (pad + "  " + (if(x.kind == "n_construct") "type" else if(x.kind == "n_spread") "value" else "callee") + ":\n" + dump_pn(x.callee[0], depth + 2));
  for(k : x.kids) out = out + dump_pn(k, depth + 1);
  out
}
// expression-text → (dump, reason "not supported", error); end of text is mandatory
expr_of(str src) {
  r = phase1_of(src);
  s = ps{src, r.tokens, r.match, 0, "", "", syntax_records(), false, -1, false, false, syntax_constructs(), array{array{}, array{}, array{}}, true};
  e = value_expr(s); // the reference parses `x = expression` - the right side of `=` (value_expr)
  if((s.error == "") && (tk(s, 0).kind != kind_end())) fail(s, "лишнее после выражения");
  array{dump_pn(e, 0), s.unsupported, s.error}
}
struct expr_res { pn tree; str unsupported; str error; }
// the same as expr_of, but the whole pn tree (for display into ast.* nodes)
expr_of_pn(str src) {
  r = phase1_of(src);
  s = ps{src, r.tokens, r.match, 0, "", "", syntax_records(), false, -1, false, false, syntax_constructs(), array{array{}, array{}, array{}}, true};
  e = value_expr(s); // the reference parses `x = expression` - the right side of `=` (value_expr)
  if((s.error == "") && (tk(s, 0).kind != kind_end())) fail(s, "лишнее после выражения");
  expr_res{e, s.unsupported, s.error}
}
// An expression parsed by C++ (stage0): `main() { x = expression }` with the prelude; the dump without the header (6 lines) and without indentation
expr_reference(str src) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  // the database with the prelude is one per run: parsing the 311 KB prelude for every corpus line (27 ms x 556) was 15 of 20 seconds.
  // The thread's current pool is returned to the caller (pool_scope), the line's nodes are added to the common database.
  static ast_db db;
  static bool loaded = false;
  pool_scope keep(current_pool);
  db.use_pool();
  if(!loaded) {
    load_prelude(db);
    loaded = true;
  }
  std::string text = cat("main() { x = ", std::string(a[0].as<str_v>().view()), " }");
  parser p(db, text, "<exprcheck>");
  node_id m = p.parse_module();
  return value(dumper(db).dump(m));
};
// vish exprcheck <body files>: in line expression; dump on language = C++ dump (unsupported parties and general failures - separately)
expr_check_cli(es) {
  same = 0;
  bad = 0;
  skipped = 0;
  both_fail = 0;
  for(f : es) {
    for(line : lines_of(read_text(f))) {
      if(line == "") continue;
      mine = expr_of(line);
      ref = expr_reference(line);
      ref_lines = lines_of(ref);
      ref_hole = false;
      for(l : ref_lines) if(contains(l, "n_hole")) ref_hole = true;
      if(mine[1] != "") {
        skipped += 1;
        continue;
      }
      if(mine[2] != "") {
        if(ref_hole) both_fail += 1 else {
          bad += 1;
          write_out(line + ": vish отказал (" + mine[2] + "), C++ разобрал\n");
        }
        continue;
      }
      if(ref_hole) {
        bad += 1;
        write_out(line + ": C++ отказал, vish разобрал\n");
        continue;
      }
      body = "";
      for(k : range(ref_lines.size)) if(k >= 6) body = body + (text_range(ref_lines[k], 10, ref_lines[k].size) + "\n");
      if(body == mine[0]) same += 1 else {
        bad += 1;
        write_out(line + ": расхождение\n--- vish\n" + mine[0] + "--- C++\n" + body);
      }
    }
  }
  write_out("парсер, выражения: совпало " + text(same) + ", общих отказов " + text(both_fail) + ", не поддержано " + text(skipped) + ", расхождений " + text(bad) + "\n");
  if(bad == 0) 0 else 1
}

// --- step E3 (the porting plan): the parser tree in Vish -> real ast.* nodes from the language, without new C++ ------------------
// The author's requirements: access to the whole expression/context simply through ast; access to the ast is a basic
// feature; the nodes of the same ast must be described within your program... your struct will be a
// struct. The nodes come out derived (with the call position, not the text): a primitive "a node with a
// given source span" is a separate step (*mine*). int/name/operator/call/chain are supported; strings, reals,
// `#name`, suffix literals are not (ok=false).
struct nres { bool ok; code node; }
// the dump of a node from the database by the same C++ dumper as stage0's (comparison of the structure and the fields)
dump_code(c) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  node_id n = vm.code_node(a[0], where);
  return value(dumper(vm.db).dump(n));
};
after_text(str s, str key) {
  i = find_text(s, key);
  if(i < 0) return "";
  rest = text_from(s, i + key.size);
  j = find_text(rest, " ");
  if(j < 0) rest else slice_text(rest, 0, j)
}
node_of(pn x) {
  if(x.kind == "n_int") {
    v = parse_int(after_text(x.info, "value="));
    return if(v.ok) nres{true, ast.int{v.value, contains(x.info, " ch"), contains(x.info, " hex")}} else nres{false, code()};
  }
  if(x.kind == "n_ready") return nres{true, x.node};
  if(x.kind == "n_ident") return nres{true, ast.name{after_text(x.info, "name=")}};
  if(x.kind == "n_str") return nres{true, ast.string{x.raw}};
  if(x.kind == "n_float") return nres{true, ast.float{float_of(x.raw)}};
  if(x.kind == "n_splice") return nres{true, ast.splice{after_text(x.info, "name=")}};
  kids = array{};
  for(k : x.kids) {
    r = node_of(k);
    if(!r.ok) return nres{false, code()};
    kids.push(r.node);
  }
  if(x.kind == "n_op") return nres{true, ast.operation{after_text(x.info, "op="), kids, contains(x.info, " postfix")}};
  if(x.kind == "n_call") {
    if(x.callee.size != 1) return nres{false, code()};
    c = node_of(x.callee[0]);
    if(!c.ok) return nres{false, code()};
    if(contains(x.info, "literal_suffix")) return nres{true, ast.call{c.node, kids, array{}, false, 0, false, true}};
    return nres{true, ast.call{c.node, kids}};
  }
  if(x.kind == "n_chain") return nres{true, ast.chain{kids, x.ops}};
  if(x.kind == "n_spread") {
    v = node_of(x.callee[0]);
    return if(v.ok) nres{true, ast.spread{v.node}} else nres{false, code()};
  }
  if(x.kind == "n_construct") {
    t = node_of(x.callee[0]);
    return if(t.ok) nres{true, ast.construct{t.node, kids, array{}}} else nres{false, code()};
  }
  nres{false, code()}
}
// vish nodecheck <corpus>: for an expression in a line - nodes from the Vish parser tree: the structure = the C++ dump (stage0);
// the chain operators by a round trip: print the nodes -> C++ parse -> dump = the dump of the original line
node_check_cli(es) {
  same = 0;
  bad = 0;
  skipped = 0;
  for(f : es) {
    for(line : lines_of(read_text(f))) {
      if(line == "") continue;
      mine = expr_of_pn(line);
      if(mine.error != "" || mine.unsupported != "") {
        skipped += 1;
        continue;
      }
      r = node_of(mine.tree);
      if(!r.ok) {
        skipped += 1;
        continue;
      }
      ref = expr_reference(line);
      ref_lines = lines_of(ref);
      body = "";
      for(k : range(ref_lines.size)) if(k >= 6) body = body + (text_range(ref_lines[k], 10, ref_lines[k].size) + "\n");
      structure = body == dump_code(r.node);
      printed = code_text(r.node);
      again = expr_reference(printed);
      round = again == ref;
      if(structure && round) same += 1 else {
        bad += 1;
        write_out(line + ": расхождение (структура " + text(structure) + ", круг " + text(round) + ", печать " + printed + ")\n");
      }
    }
  }
  write_out("узлы из языка: совпало " + text(same) + ", пропущено " + text(skipped) + ", расхождений " + text(bad) + "\n");
  if(bad == 0) 0 else 1
}

// --- E4c (the porting plan): record words (if/loop/break/continue/return/throw) - the engine in Vish by the prelude's table ---------------
// The author's requirements: parsing logic and syntax are defined by logic in the language itself; there are no problems with
// keywords if we have no keywords. The rules are prelude data (syntax_records), here
// only the matching of forms as in parser.hpp syntax_use: the longest run of words/symbols ahead (at the `else` / `; else` fork),
// then (a parameter) in parentheses, then {a body}, then the end of the form; among equals, the last declaration. hide/try_compile (core calls)
// and template records are not supported. The termination of an instruction (`;`, a record branch with `;`, a block instead of `;`) is *mine*, as in C++.
// part k of the form of record i; past the end of the form it is empty (like piece() in parser.hpp)
rule_piece(ps s, i64 i, i64 k) => if(k < s.rules[i][1].size) s.rules[i][1][k] else "";
rule_has(ps s, str w) {
  for(r : s.rules) if(r[0] == w) return true;
  false
}
ends_with_text(str s, str p) => (p.size <= s.size) && (slice_text(s, s.size - p.size, s.size) == p);
piece_param(str p) => starts_with(p, "(") || starts_with(p, "{") || (p == "#") || (p == ",+") || (p == ",)");
// how many lexemes literal p occupies at distance off; -1 - did not match. `;` is the end of an instruction: `;`, and before `}` without a lexeme
literal_tokens(ps s, str p, i64 off) {
  if(p == ";") {
    if(is_op_at(s, ";", off)) return 1;
    if((tk(s, off).kind == kind_close()) && (tk(s, off).ch == 125)) return 0;
    return -1;
  }
  if((p.size > 0) && is_ident_start(p[0])) return if((tk(s, off).kind == kind_ident()) && (tk_text(s, off) == p)) 1 else -1;
  // glued symbols (literal_at parser.hpp): a run of operator signs of exactly length p
  n = run_length(s, off);
  if((p.size == 0) || (n < p.size)) return -1;
  for(i : range(p.size)) {
    if((tk(s, off + i).kind != kind_op()) || (tk(s, off + i).ch != p[i])) return -1;
    if((i > 0) && !tk(s, off + i).glued) return -1;
  }
  if((n > p.size) && tk(s, off + p.size).glued) return -1; // glued further - a different run
  p.size
}
node_field(c, str name) {
  for(fd : fields(code_kind(c))) if(fd.name == name) return c.[fd];
  code()
}
if_closed_node(c) {
  last = node_field(c, "else");
  if(!given(last)) last = node_field(c, "then");
  if(!given(last)) return false;
  if(code_kind(last) == ast.if) return if_closed_node(last);
  code_kind(last) == ast.block
}
// an instruction ending with a block does not need a `;` after it (ends_with_block parser.hpp; record nodes only)
ends_with_block_pn(pn a) {
  if(a.kind != "n_ready") return false;
  if((code_kind(a.node) == ast.ct) && (code_kind(node_field(a.node, "body")) == ast.block)) return true;
  if((code_kind(a.node) == ast.if) || ((code_kind(a.node) == ast.loop) || (code_kind(a.node) == ast.block))) return true;
  (code_kind(a.node) == ast.call) && (node_field(a.node, "tail") || (node_field(a.node, "words").size > 0))
}
// a syntax record at word s.pos: a node or "not supported"
record_use(ps s) {
  ru_w = tk_text(s, 0);
  ru_live = array{};
  ru_k = s.rules.size;
  while(ru_k > 0) {
    ru_k -= 1;
    if(s.rules[ru_k][0] == ru_w) ru_live.push(ru_k);
  }
  ru_head_pos = s.pos;
  s.pos += 1;
  ru_args = array{};
  ru_at = 1;
  loop {
    // 1. the literal run (words and symbols) - the longest that matched
    ru_best_len = 0;
    ru_best_toks = 0;
    ru_best = -1;
    for(i : ru_live) {
      ru_pcs = s.rules[i][1];
      ru_len = 0;
      ru_off = 0;
      loop {
        ru_p = if((ru_at + ru_len) < ru_pcs.size) ru_pcs[ru_at + ru_len] else "";
        if((ru_p == "") || piece_param(ru_p)) break;
        ru_n = literal_tokens(s, ru_p, ru_off);
        if(ru_n < 0) { ru_len = 0; break; }
        ru_off += ru_n;
        ru_len += 1;
      }
      if(ru_len > ru_best_len) { ru_best_len = ru_len; ru_best_toks = ru_off; ru_best = i; }
    }
    if(ru_best_len > 0) {
      ru_keep = array{};
      for(i : ru_live) {
        ru_same = true;
        for(j : range(ru_best_len)) if(rule_piece(s, i, ru_at + j) != rule_piece(s, ru_best, ru_at + j)) ru_same = false;
        if(ru_same) ru_keep.push(i);
      }
      ru_live = ru_keep;
      s.pos += ru_best_toks;
      s.tail = rule_piece(s, ru_best, (ru_at + ru_best_len) - 1) == ";";
      ru_at += ru_best_len;
      continue;
    }
    // 2. (a parameter) in parentheses: `(` | `()` - directly after the word; (a, b) - one place per part; (xs, ...) - a list
    ru_pv = array{};
    for(i : ru_live) {
      ru_p = if(ru_at < s.rules[i][1].size) s.rules[i][1][ru_at] else "";
      if(starts_with(ru_p, "(") && is_open_ch(s, 40, 0) && (!starts_with(ru_p, "()") || tk(s, 0).glued)) ru_pv.push(i);
    }
    if(ru_pv.size > 0) {
      ru_live = ru_pv;
      s.tail = false;
      s.pos += 1;
      ru_items = array{};
      if(!is_close_ch(s, 41)) { ru_it = expression(s); if((s.error != "") || (s.unsupported != "")) return nres{false, code()}; ru_items.push(ru_it); }
      loop {
        if(!is_op_at(s, ",", 0)) break;
        s.pos += 1;
        ru_it2 = expression(s);
        if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
        ru_items.push(ru_it2);
      }
      ru_nodes = array{};
      for(q : ru_items) {
        ru_qr = node_of(q);
        if(!ru_qr.ok) { want(s, "выражение без узла"); return nres{false, code()}; }
        ru_nodes.push(ru_qr.node);
      }
      // (a, b): as many places as expressions, parts (+ ,+ ... ,)
      ru_multi = array{};
      for(i : ru_live) {
        ru_pc = s.rules[i][1];
        ru_p0 = if(ru_at < ru_pc.size) ru_pc[ru_at] else "";
        ru_okm = (ru_nodes.size >= 2) && ((ru_p0 == "(+") || (ru_p0 == "()+"));
        for(q : range(ru_nodes.size)) {
          if(!ru_okm || (q == 0)) continue;
          ru_pq = if((ru_at + q) < ru_pc.size) ru_pc[ru_at + q] else "";
          if(ru_pq != (if((q + 1) == ru_nodes.size) ",)" else ",+")) ru_okm = false;
        }
        if(ru_okm) ru_multi.push(i);
      }
      if(ru_multi.size > 0) {
        ru_live = ru_multi;
        if(!is_close_ch(s, 41)) { fail(s, "ожидалось ')'"); return nres{false, code()}; }
        s.pos += 1;
        for(q : ru_nodes) ru_args.push(q);
        ru_at += ru_nodes.size;
        continue;
      }
      ru_nf = array{};
      for(i : ru_live) {
        ru_p1 = s.rules[i][1][ru_at];
        if((ru_p1 != "(+") && (ru_p1 != "()+")) ru_nf.push(i);
      }
      ru_live = ru_nf;
      ru_one = false;
      if(ru_nodes.size == 1) for(i : ru_live) if(!ends_with_text(s.rules[i][1][ru_at], "...")) ru_one = true;
      ru_lk = array{};
      for(i : ru_live) if(ends_with_text(s.rules[i][1][ru_at], "...") == !ru_one) ru_lk.push(i);
      ru_live = ru_lk;
      if(ru_live.size == 0) { fail(s, if(ru_nodes.size == 0) "ожидалось выражение" else "ожидалось одно выражение в скобках"); return nres{false, code()}; }
      if(!is_close_ch(s, 41)) { fail(s, "ожидалось ')'"); return nres{false, code()}; }
      s.pos += 1;
      if(ru_one) ru_args.push(ru_nodes[0]) else ru_args.push(ast.construct{ast.name{"array"}, ru_nodes, array{}});
      ru_at += 1;
      continue;
    }
    // #name - a bare name (a record word is not core: there are no keywords, the author's rule)
    ru_wv = array{};
    for(i : ru_live) if((ru_at < s.rules[i][1].size) && (s.rules[i][1][ru_at] == "#")) ru_wv.push(i);
    if((ru_wv.size > 0) && (tk(s, 0).kind == kind_ident()) && !core_word_text(tk_text(s, 0))) {
      ru_live = ru_wv;
      s.tail = false;
      ru_args.push(ast.name{tk_text(s, 0)});
      s.pos += 1;
      ru_at += 1;
      continue;
    }
    // 3. {a body} or a branch expression; `{}` / `{x: ...}` in a value is not supported
    ru_bv = array{};
    for(i : ru_live) {
      ru_p = if(ru_at < s.rules[i][1].size) s.rules[i][1][ru_at] else "";
      if((ru_p == "{") || (ru_p == "{=")) ru_bv.push(i);
    }
    if(ru_bv.size > 0) {
      ru_live = ru_bv;
      s.tail = false;
      if(is_open_ch(s, 123, 0)) {
        // `{}` is a value of the place's type only in the value slot `{=` (empty_value_ahead); a record `{x: ...}` is not a block (record_ahead)
        ru_value_slot = false;
        for(i : ru_bv) if(rule_piece(s, i, ru_at) == "{=") ru_value_slot = true;
        ru_empty = is_close_ch_at(s, 125, 1) && (is_close_ch_at(s, 41, 2) || (is_close_ch_at(s, 125, 2) || (is_op_at(s, ",", 2) || is_op_at(s, ";", 2))));
        if(ru_value_slot && ru_empty) { // {} in a value slot is an empty literal (the author's remark: in all kinds of foo({}), return {} - nothing needs to be written)
          s.pos += 2;
          ru_args.push(ast.construct{code(), array{}, array{}});
        } else if((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2)) { // a record {x: ...} is an expression
          ru_head = s.head;
          s.head = s.pos;
          ru_e = expression(s);
          s.head = ru_head;
          if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
          ru_r = node_of(ru_e);
          if(!ru_r.ok) { want(s, "запись без узла"); return nres{false, code()}; }
          ru_args.push(ru_r.node);
        } else {
          ru_b = block_node(s);
          if(!ru_b.ok) return nres{false, code()};
          ru_args.push(ru_b.node);
        }
      } else {
        ru_head = s.head;
        s.head = s.pos;
        ru_e = expression(s);
        s.head = ru_head;
        if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
        ru_r = node_of(ru_e);
        if(!ru_r.ok) { want(s, "ветка без узла"); return nres{false, code()}; }
        ru_args.push(ru_r.node);
      }
      ru_at += 1;
      continue;
    }
    // 4. the end of the form
    ru_done = array{};
    for(i : ru_live) if(ru_at >= s.rules[i][1].size) ru_done.push(i);
    if(ru_done.size == 0) { want(s, "запись " + ru_w + ": форма не подошла"); return nres{false, code()}; }
    ru_d = ru_done[0];
    ru_places = array{};
    for(j : range(s.rules[ru_d][4])) ru_places.push(code());
    for(j : range(ru_args.size)) ru_places[s.rules[ru_d][3][j]] = ru_args[j];
    if(s.rules[ru_d][2] < 0) { // a core call record: try_compile { ... }, hide x
      ru_lastp = s.rules[ru_d][1][s.rules[ru_d][1].size - 1];
      ru_tail = starts_with(ru_lastp, "{") && (ru_args.size > 0) && (code_kind(ru_args[ru_args.size - 1]) == ast.block);
      return nres{true, ast.call{ast.name{s.rules[ru_d][0]}, ru_places, array{}, ru_tail, 0, false, false}};
    }
    ru_kind = code_kinds()[s.rules[ru_d][2]];
    return nres{true, ru_kind{...ru_places}};
  }
}

// --- E4d: prelude constructs (for/while/try...): learn/call/group parser.hpp. The tail is a block or an instruction, bindings `x : xs`
// (a lambda wrapper), clauses `catch(e) { ... }` (a repeated clause is a pack of blocks). The table rows are syntax_constructs().
cons_of(ps s, str w) {
  for(i : range(s.cons.size)) if(s.cons[i][0] == w) return i;
  -1
}
cons_clause(ps s, i64 ci, str w) {
  for(c : s.cons[ci][3]) if(c[0] == w) return c;
  array{}
}
// one group: (arguments) and the tail - a block or an instruction; the result is appended to cg (args/words/tail) - the structures change in place
struct cgroup { array args; array words; bool tail; }
cons_group(ps s, i64 ci, str word, bool head_stmt, cgroup cg) {
  cg_first = cg.args.size;
  cg_packed = false;
  if(word != "") { cg_cl = cons_clause(s, ci, word); cg_packed = (cg_cl.size > 0) && (cg_cl[1] == 1); }
  cg_binders = array{};
  if(is_open_ch(s, 40, 0)) {
    s.pos += 1;
    loop {
      if(is_close_ch(s, 41)) break;
      if((tk(s, 0).kind == kind_end()) || (s.error != "") || (s.unsupported != "")) break;
      cg_closes1 = is_op_at(s, ",", 1) || is_close_ch_at(s, 41, 1);
      cg_closes2 = is_op_at(s, ",", 2) || is_close_ch_at(s, 41, 2);
      if(is_op_at(s, "#", 0) && (tk(s, 1).kind == kind_ident()) && (is_op_at(s, ":", 2) || (cg_packed && cg_closes2))) { // #x is a template place name (parser.hpp binder)
        cg_nm = "#" + tk_text(s, 1);
        s.pos += 2;
        cg_src = -1;
        if(is_op_at(s, ":", 0)) {
          s.pos += 1;
          cg_src = cg.args.size - cg_first;
          cg_x = expression(s);
          if((s.error != "") || (s.unsupported != "")) return false;
          cg_xr = node_of(cg_x);
          if(!cg_xr.ok) { want(s, "источник привязки без узла"); return false; }
          cg.args.push(cg_xr.node);
          cg.words.push(word);
        }
        cg_binders.push(ast.parameter{cg_nm, code(), 0, false, "", false, cg_src});
        if(is_op_at(s, ",", 0)) { s.pos += 1; continue; }
        break;
      }
      cg_typed = (tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident()) && (is_op_at(s, ":", 2) || cg_closes2);
      cg_bare = (tk(s, 0).kind == kind_ident()) && (is_op_at(s, ":", 1) || (cg_packed && cg_closes1));
      if(cg_typed || cg_bare) {
        cg_ty = code();
        if(cg_typed) { cg_ty = ast.name{tk_text(s, 0)}; s.pos += 1; }
        cg_nm = tk_text(s, 0);
        s.pos += 1;
        cg_src = -1;
        if(is_op_at(s, ":", 0)) {
          s.pos += 1;
          cg_src = cg.args.size - cg_first;
          cg_x = expression(s);
          if((s.error != "") || (s.unsupported != "")) return false;
          cg_xr = node_of(cg_x);
          if(!cg_xr.ok) { want(s, "источник привязки без узла"); return false; }
          cg.args.push(cg_xr.node);
          cg.words.push(word);
        }
        cg_binders.push(ast.parameter{cg_nm, cg_ty, 0, false, "", false, cg_src});
      } else if(!cg_packed && is_op_at(s, "...", 0)) {
        want(s, "раскрытие ... в аргументах конструкции");
        return false;
      } else {
        if(is_open_ch(s, 123, 0) && (is_close_ch_at(s, 125, 1) || ((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2)))) { want(s, "запись {…} в аргументе конструкции"); return false; }
        cg_x = expression(s);
        if((s.error != "") || (s.unsupported != "")) return false;
        cg_xr = node_of(cg_x);
        if(!cg_xr.ok) { want(s, "аргумент конструкции без узла"); return false; }
        cg.args.push(cg_xr.node);
        cg.words.push(word);
      }
      if(is_op_at(s, ",", 0)) s.pos += 1 else break;
    }
    if(is_close_ch(s, 41)) s.pos += 1 else { fail(s, "ожидалось ')'"); return false; }
  }
  if(cg_packed && (cg.args.size > cg_first)) { fail(s, "в скобках клаузы — только имена"); return false; }
  cg_body = code();
  if(is_open_ch(s, 123, 0)) {
    cg_b = block_node(s);
    if(!cg_b.ok) return false;
    cg_body = cg_b.node;
  } else if((word == "") && (s.cons[ci][1] == 1) && head_stmt && (tk(s, 0).kind == kind_ident())) {
    cg_st = statement_node(s);
    if(!cg_st.ok) return false;
    cg_body = cg_st.node;
    s.tail = true;
  }
  if(!given(cg_body)) {
    if(cg_binders.size > 0) { fail(s, "объявление в скобках вводит имя в блок — нужен блок"); return false; }
    if(word != "") { fail(s, "после клаузы ожидался блок"); return false; }
    return true;
  }
  if(cg_binders.size > 0) cg_body = ast.lambda{cg_binders, cg_body, true};
  cg.args.push(cg_body);
  cg.words.push(word);
  if(word == "") cg.tail = true;
  true
}
// a construct call: callee is a name; at `(` (or at `{` for bare); head_stmt - the call starts an instruction
cons_call(ps s, pn callee, i64 ci, bool head_stmt) {
  cc_callee = node_of(callee);
  cc_cg = cgroup{array{}, array{}, false};
  if(!cons_group(s, ci, "", head_stmt, cc_cg)) return pn_hole("");
  loop {
    if(s.tail) break;
    if(!((tk(s, 0).kind == kind_ident()) && (is_open_ch(s, 40, 1) || is_open_ch(s, 123, 1)))) break;
    cc_w = tk_text(s, 0);
    if(cons_clause(s, ci, cc_w).size == 0) break;
    s.pos += 1;
    if(!cons_group(s, ci, cc_w, false, cc_cg)) return pn_hole("");
  }
  // a repeated clause is one pack argument at the place of the first
  for(cc_cl : s.cons[ci][3]) {
    if(cc_cl[1] != 1) continue;
    cc_at = -1;
    cc_items = array{};
    cc_args = array{};
    cc_words = array{};
    for(k : range(cc_cg.args.size)) {
      if(cc_cg.words[k] == cc_cl[0]) {
        if(cc_at < 0) cc_at = cc_args.size;
        cc_items.push(cc_cg.args[k]);
      } else {
        cc_args.push(cc_cg.args[k]);
        cc_words.push(cc_cg.words[k]);
      }
    }
    if(cc_at < 0) continue;
    cc_pack = ast.construct{ast.name{"array"}, cc_items, array{}};
    cc_new_args = array{};
    cc_new_words = array{};
    for(k : range(cc_args.size + 1)) {
      if(k == cc_at) { cc_new_args.push(cc_pack); cc_new_words.push(cc_cl[0]); }
      if(k < cc_args.size) { cc_new_args.push(cc_args[k]); cc_new_words.push(cc_words[k]); }
    }
    cc_cg.args = cc_new_args;
    cc_cg.words = cc_new_words;
  }
  cc_has_word = false;
  for(w : cc_cg.words) if(w != "") cc_has_word = true;
  cc_final_words = if(cc_has_word) cc_cg.words else array{};
  pn{"n_ready", "", array{}, array{}, array{}, "", ast.call{cc_callee.node, cc_cg.args, cc_final_words, cc_cg.tail, 0, false, false}}
}

// --- E4a (the porting plan): module -> functions; nodes are built directly by the ast.* constructors, without the pn tree ---------------------
// The author's requirements: all the logic will be written in the new language itself; parsing logic and syntax are
// defined by logic in the language itself. Supported: `[type] name(parameters) => expression;` and
// `[type] name(parameters) { expression; ... }`, a parameter is `name` or `type name` (one type word). The rest is "not supported"
// (record words, variable declarations, clauses, parameter modes, templates, attributes, module/use/struct...).
// The layout (blank lines, comments, inner elements) is not part of the stage0 dump - a separate step E4d.
struct ires { bool ok; code node; i64 from; i64 to; str why; }
// the end of an unsupported element: the first `;` at zero depth or the `}` of a block (if there was no `=>` before `{`)
skip_item(ps s) {
  from = s.pos;
  loop {
    t = tk(s, 0);
    if(t.kind == kind_end()) break;
    if(t.kind == kind_open()) {
      m = s.match[s.pos];
      if(m < 0) { s.pos = s.toks.size - 1; break; }
      was_arrow = (s.pos > from) && is_op_at(s, "=>", -1);
      s.pos = m + 1;
      if((t.ch == 123) && !was_arrow && !is_op_at(s, ";", 0)) break;
      continue;
    }
    if(is_op_at(s, ";", 0)) { s.pos += 1; break; }
    s.pos += 1;
  }
  s.pos
}
param_node(ps s) {
  // [mode] [explicit] [type] [...] name; the mode is let(0)/mut/own/out/expr/ct/implicit (parser.hpp param()); patterns, default values,
  // `#name` of templates - not supported
  mode = 0;
  w0 = tk_text(s, 0);
  if(tk(s, 0).kind == kind_ident()) {
    if(w0 == "mut") mode = 1 else if(w0 == "own") mode = 2 else if(w0 == "out") mode = 3 else if(w0 == "expr") mode = 4 else if(w0 == "ct") mode = 5 else if((w0 == "implicit") && (tk(s, 1).kind == kind_ident())) mode = 6;
    if(mode > 0) s.pos += 1;
  }
  strict = false;
  if((tk(s, 0).kind == kind_ident()) && (tk_text(s, 0) == "explicit") && (tk(s, 1).kind == kind_ident()) && (tk(s, 2).kind == kind_ident())) {
    strict = true;
    s.pos += 1;
  }
  pack = false;
  if(is_op_at(s, "...", 0)) {
    pack = true;
    s.pos += 3;
  }
  if((mode == 0) && (((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 123, 1) && tk(s, 1).glued) || record_ahead(s))) {
    // pattern: foo(array{a, b, ...xs}) - a parameter without a name, the names come from unpacking; f({x: a, y: b}) (parser.hpp param)
    pp_pat = pattern_node(s);
    if(!pp_pat.ok) return nres{false, code()};
    if(!(is_op_at(s, ",", 0) || is_close_ch(s, 41) || is_close_ch(s, 93))) { want(s, "сложный параметр"); return nres{false, code()}; }
    return nres{true, ast.parameter{"", pp_pat.node, mode, pack, "", strict, -1}};
  }
  if(tk(s, 0).kind != kind_ident()) { want(s, "параметр не имя"); return nres{false, code()}; }
  if(is_keyword_word(tk_text(s, 0)) && (tk_text(s, 0) != "ct")) { want(s, "слово-запись в параметре"); return nres{false, code()}; }
  ty = code();
  if((tk(s, 0).kind == kind_ident()) && ((tk(s, 1).kind == kind_ident()) || is_op_at(s, "...", 1))) {
    if(is_keyword_word(tk_text(s, 1))) { want(s, "параметр с типом и модификатором"); return nres{false, code()}; }
    ty = ast.name{tk_text(s, 0)};
    s.pos += 1;
    if(is_op_at(s, "...", 0)) {
      pack = true;
      s.pos += 3;
    }
  }
  if(tk(s, 0).kind != kind_ident()) { want(s, "сложный параметр"); return nres{false, code()}; }
  nm = tk_text(s, 0);
  s.pos += 1;
  if(!(is_op_at(s, ",", 0) || is_close_ch(s, 41) || is_close_ch(s, 93))) { want(s, "сложный параметр"); return nres{false, code()}; }
  nres{true, ast.parameter{nm, ty, mode, pack, "", strict, -1}}
}
is_close_ch_at(ps s, i64 c, i64 k) => (tk(s, k).kind == kind_close()) && ((tk(s, k).ch == c) && (tk(s, k).err < 0));
// ahead is the header of a local function (try_fn_decl(true) parser.hpp): [type] name(...) [clauses] => | {; `f(x) { ... }` without `=>` in a block is a call with a tail
core_word_text(str w) => has_text(array{"ct", "const", "outline", "module", "operator"}, w);
local_fn_ahead(ps s) {
  name_at = -1;
  if((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident()) && is_open_ch(s, 40, 2)) name_at = 1
  else if((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 40, 1) && !core_word_text(tk_text(s, 0))) name_at = 0
  else return false;
  close = s.match[s.pos + name_at + 1];
  if(close < 0) return false;
  after = (close + 1) - s.pos;
  loop {
    if(!((tk(s, after).kind == kind_ident()) && is_open_ch(s, 40, after + 1) && !core_word_text(tk_text(s, after)))) break;
    c2 = s.match[s.pos + after + 1];
    if(c2 < 0) return false;
    after = (c2 + 1) - s.pos;
  }
  arrow = is_op_at(s, "=>", after);
  if(!(arrow || is_open_ch(s, 123, after))) return false;
  if((name_at == 0) && !arrow) return false;
  true
}
// one instruction (statement_body parser.hpp): a node or "not supported"; the end of an instruction - a tail record/construct has eaten the `;` itself,
// otherwise `;`, or `}` (the value of a block), or the instruction ends with a block (if/loop/a construct with a block) - `;` is not needed
statement_node(ps s) {
  // block rules: operator / using operator / [[...]] operator / syntax - apply to the end of the block (block_node restores the tables)
  sn_att = plres{true, array{}};
  if(is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1)) {
    sn_att = parse_attrs(s);
    if(!sn_att.ok) return nres{false, code()};
    if(!((tk_text(s, 0) == "operator") || ((tk_text(s, 0) == "using") && (tk_text(s, 1) == "operator")))) { want(s, "атрибуты [[…]] в блоке — перед operator или using operator"); return nres{false, code()}; }
  }
  sn_using = (tk_text(s, 0) == "using") && (tk_text(s, 1) == "operator");
  if(sn_using || ((tk_text(s, 0) == "operator") && (tk(s, 0).kind == kind_ident()))) {
    if(sn_using) s.pos += 1;
    sn_op = operator_item(s, sn_att.items, sn_using);
    s.lwv = false;
    if(!sn_op.ok) return nres{false, code()};
    learn_op(s, node_field(sn_op.node, "name"));
    return sn_op;
  }
  if((tk_text(s, 0) == "syntax") && (tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident())) {
    sn_sy = syntax_item(s, array{});
    s.lwv = false;
    if(!sn_sy.ok) { s.custom = true; return nres{false, code()}; }
    return sn_sy;
  }
  if(local_fn_ahead(s)) { // a local function: the same parse as a module element; its rules live only in the block (block_node restores the tables)
    sn_it = item_node(s);
    s.lwv = false;
    if(!sn_it.ok) { if(s.unsupported == "") want(s, if(sn_it.why == "") "локальная функция" else sn_it.why); return nres{false, code()}; }
    return nres{true, sn_it.node};
  }
  if((tk(s, 0).kind == kind_ident()) && !rule_has(s, tk_text(s, 0)) && (cons_of(s, tk_text(s, 0)) < 0) && !((tk_text(s, 0) == "ct") && !((tk(s, 1).kind == kind_str()) && tk(s, 1).glued))) {
    if((is_keyword_word(tk_text(s, 0)) || (tk(s, 1).kind == kind_ident())) && !var_decl_ahead(s)) {
      want(s, if(is_keyword_word(tk_text(s, 0))) "в блоке слово «" + tk_text(s, 0) + "»" else "в блоке объявление «тип имя» (" + tk_text(s, 1) + ")");
      return nres{false, code()};
    }
  }
  if(is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1)) { want(s, "атрибуты в блоке"); return nres{false, code()}; }
  if((tk_text(s, 0) == "ct") && (tk(s, 1).kind == kind_ident()) && is_op_at(s, "=", 2)) {
    sn_head0 = s.head;
    s.lwv = false;
    sn_cv = ct_var(s); // last_was_value from an inner block (ct x = if(c) {1}; ...) leaks through, as in C++: statement() resets it only at the start
    s.head = sn_head0;
    return sn_cv;
  }
  if(pattern_ahead(s)) { // pattern = value; is an instruction (a failure is an exception)
    s.lwv = false;
    sn_up = unpack_node(s, false);
    if(!sn_up.ok) { if((s.unsupported == "") && (s.error == "")) want(s, "образец без узла"); return nres{false, code()}; }
    if(is_op_at(s, ";", 0)) s.pos += 1 else if(!is_close_ch(s, 125)) { want(s, "образец без ;"); return nres{false, code()}; }
    return sn_up;
  }
  if(var_decl_ahead(s)) { // a variable declaration (try_var_decl goes after a pattern, before an expression)
    s.lwv = false;
    sn_vh = s.head;
    sn_vd = var_decl(s);
    s.head = sn_vh;
    return sn_vd;
  }
  s.tail = false;
  s.lwv = false;
  sn_head = s.head;
  s.head = s.pos;
  sn_e = expression(s);
  s.head = sn_head;
  if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
  sn_r = node_of(sn_e);
  if(!sn_r.ok) { want(s, "выражение без узла"); return nres{false, code()}; }
  if(s.tail) {
    s.tail = false;
  } else if(is_op_at(s, ";", 0)) {
    s.pos += 1;
    s.lwv = false;
  } else if(is_close_ch(s, 125)) s.lwv = true
  else if(!ends_with_block_pn(sn_e)) { want(s, "инструкция без ; перед «" + tk_text(s, 0) + "»"); return nres{false, code()}; }
  sn_r
}
block_node(ps s) {
  // at `{`
  bn_rules = s.rules; // the program's syntax records are also block rules
  bn_cons = s.cons; // block rules (constructs, operators) apply to its end (context_scope parser.hpp)
  bn_ops = s.ops;
  s.pos += 1;
  bn_items = array{};
  bn_has = false;
  loop {
    if(is_close_ch(s, 125)) break;
    if((tk(s, 0).kind == kind_end()) || (s.error != "") || (s.unsupported != "")) { want(s, "блок не закрыт или внутри не поддержано"); return nres{false, code()}; }
    bn_p0 = s.pos;
    bn_st = statement_node(s);
    if(!bn_st.ok) {
      if((s.error == "") || (s.unsupported != "")) return nres{false, code()};
      // a parse error is a hole (recover_statement parser.hpp): skipping to the end of the instruction; the skipped text and the reason
      s.pos = bn_p0;
      skip_stmt(s);
      if((s.pos == bn_p0) && (tk(s, 0).kind != kind_end())) s.pos += 1;
      bn_text = slice_text(s.src, tk_at(s, bn_p0).from, tk_at(s, s.pos - 1).to);
      bn_items.push(ast.hole{bn_text, hole_reason(s, bn_p0, s.pos, s.error)});
      s.error = "";
      s.tail = false;
      s.lwv = false;
      continue;
    }
    bn_items.push(bn_st.node);
    if(is_close_ch(s, 125) && s.lwv) bn_has = true;
  }
  s.pos += 1;
  s.cons = bn_cons;
  s.ops = bn_ops;
  s.rules = bn_rules;
  nres{true, ast.block{bn_items, bn_has, array{}}}
}
// one module element from token s.pos: a function or "not supported" (the position is after the element in any case)
item_node(ps s) {
  from = s.pos;
  why = "";
  // program rules (syntax/operator/using/use, functions with expr parameters - "constructs") change the parsing of the following elements
  // (parser.hpp learn/rules): while they are not supported, the elements after such a declaration are "not supported", not a call
  if(s.custom) {
    want(s, "правила программы выше (syntax/operator/use/expr)");
    why = s.unsupported;
    skip_item(s);
    return ires{false, code(), from, s.pos, why};
  }
  attrs = array{};
  loop {
    if(!(is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1))) break;
    s.pos += 2;
    loop {
      if(is_close_ch(s, 93)) break;
      at_e = expression(s);
      at_r = node_of(at_e);
      if((s.error != "") || (s.unsupported != "") || !at_r.ok) { if(s.unsupported == "") want(s, "атрибут без узла"); why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
      attrs.push(at_r.node);
      if(is_op_at(s, ",", 0)) s.pos += 1 else break;
    }
    if(is_close_ch(s, 93) && is_close_ch_at(s, 93, 1)) s.pos += 2 else { want(s, "атрибуты: ]]"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  }
  if((attrs.size > 0) && (tk(s, 0).kind == kind_ident()) && !is_keyword_word(tk_text(s, 0)) && is_op_at(s, "=", 1)) { // a record word name - C++ rejects it
    // [[state]] x = e; - program state (§12.2): a module variable
    sv_ok = true;
    for(a : attrs) if(!((code_kind(a) == ast.name) && (node_field(a, "name") == "state"))) sv_ok = false;
    if(!sv_ok) { want(s, "у переменной модуля — только [[state]]"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    sv_name = tk_text(s, 0);
    s.pos += 2;
    s.head = s.pos;
    s.tail = false;
    sv_e = expression(s);
    sv_r = node_of(sv_e);
    if((s.error != "") || (s.unsupported != "") || !sv_r.ok || !is_op_at(s, ";", 0)) { if(s.unsupported == "") want(s, "[[state]] без значения или ;"); why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    s.pos += 1;
    return ires{true, ast.variable{sv_name, code(), sv_r.node, false, false, false, false, attrs}, from, s.pos, ""};
  }
  if((attrs.size > 0) && ((tk_text(s, 0) == "ct") || (tk_text(s, 0) == "use") || (tk_text(s, 0) == "module"))) { want(s, "атрибуты перед ct/use/module"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  if((tk_text(s, 0) == "ct") && is_open_ch(s, 123, 1)) { // ct { ... } - evaluation at compile time at module level (statement parser.hpp)
    ic_st = statement_node(s);
    if(!ic_st.ok) { why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    return ires{true, ic_st.node, from, s.pos, ""};
  }
  if((attrs.size == 0) && (tk(s, 0).kind == kind_ident()) && !is_keyword_word(tk_text(s, 0)) && is_open_ch(s, 123, 1)) {
    // Name { ... } - an extension; the rules of its functions - constructs/operators - are taken by learn_item: conservative for now (ps.custom)
    ie_r = extension_item(s, "");
    if(!ie_r.ok) { s.custom = true; why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    s.custom = true;
    return ires{true, ie_r.node, from, s.pos, ""};
  }
  if((tk_text(s, 0) == "syntax") && (tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident())) {
    isy = syntax_item(s, attrs);
    if(!isy.ok) { s.custom = true; why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    return ires{true, isy.node, from, s.pos, ""};
  }
  if((tk_text(s, 0) == "operator") && (tk(s, 0).kind == kind_ident())) {
    io_r = operator_item(s, attrs, false);
    if(!io_r.ok) { why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    learn_op(s, node_field(io_r.node, "name"));
    return ires{true, io_r.node, from, s.pos, ""};
  }
  if((tk_text(s, 0) == "ct") && (tk(s, 1).kind == kind_ident()) && is_op_at(s, "=", 2)) {
    ci_cv = ct_var(s);
    if(!ci_cv.ok) { why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    return ires{true, ci_cv.node, from, s.pos, ""};
  }
  if((tk_text(s, 0) == "use") && (tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident())) {
    // use geo.vec; / use geo.vec.{norm, dot}; - an include module (§9.1); module forms change the parsing further on (learn_use) - like program rules
    s.pos += 1;
    us_key = tk_text(s, 0);
    s.pos += 1;
    us_names = array{};
    loop {
      if(!(is_op_at(s, ".", 0) && (tk(s, 1).kind == kind_ident()))) break;
      us_key = us_key + "." + tk_text(s, 1);
      s.pos += 2;
    }
    if(is_op_at(s, ".", 0) && is_open_ch(s, 123, 1)) {
      s.pos += 2;
      loop {
        if(is_close_ch(s, 125)) break;
        if(tk(s, 0).kind != kind_ident()) { want(s, "use: имя"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
        us_names.push(tk_text(s, 0));
        s.pos += 1;
        if(is_op_at(s, ",", 0)) s.pos += 1 else break;
      }
      if(is_close_ch(s, 125)) s.pos += 1 else { want(s, "use: }"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    }
    if(!is_op_at(s, ";", 0)) { want(s, "use без ;"); why = s.unsupported; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    s.pos += 1;
    // the rules of module k are taken by learn_use from the module found in the database; the module is not loaded (as in the modcheck reference) - there are no rules.
    // Loading modules by key is E6 (modules); until then `use` does not switch parsing to "rules above"
    return ires{true, ast.use{us_key, us_names}, from, s.pos, ""};
  }
  if((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident()) && (!is_keyword_word(tk_text(s, 0)) || (tk_text(s, 0) == "struct"))
     && (is_open_ch(s, 123, 2) || (is_op_at(s, ":", 2) && (tk(s, 3).kind == kind_ident()) && is_open_ch(s, 123, 4)))) {
    sd = struct_decl(s, attrs);
    if(!sd.ok) { why = if(s.unsupported != "") s.unsupported else s.error; s.pos = from; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    return ires{true, sd.node, from, s.pos, ""};
  }
  k = 0;
  rtype = code();
  if((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident()) && is_open_ch(s, 40, 2)) {
    if(is_keyword_word(tk_text(s, 0)) && (cons_of(s, tk_text(s, 0)) < 0)) { want(s, "слово-запись"); why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    rtype = ast.name{tk_text(s, 0)};
    k = 1;
  } else if(!((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 40, 1) && !core_word_text(tk_text(s, 0)))) { // a name is also a record word (core_word parser.hpp)
    want(s, "не функция, начало «" + tk_text(s, 0) + "»");
    why = s.unsupported;
    skip_item(s);
    return ires{false, code(), from, s.pos, why};
  }
  fname = tk_text(s, k);
  close = s.match[s.pos + k + 1];
  if(close < 0) { want(s, "скобки"); why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  after = (close + 1) - s.pos;
  loop { // clauses: name(...) word(...) word(...) => ...
    if(!((tk(s, after).kind == kind_ident()) && is_open_ch(s, 40, after + 1) && !core_word_text(tk_text(s, after)))) break;
    c2 = s.match[s.pos + after + 1];
    if(c2 < 0) break;
    after = (c2 + 1) - s.pos;
  }
  if(!(is_op_at(s, "=>", after) || is_open_ch(s, 123, after))) { want(s, "не объявление функции"); why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  s.pos += k + 2;
  params = array{};
  loop {
    if(is_close_ch(s, 41)) break;
    pr = param_node(s);
    if(!pr.ok) { s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    params.push(pr.node);
    if(is_op_at(s, ",", 0)) s.pos += 1 else if(!is_close_ch(s, 41)) { want(s, "список параметров"); s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  }
  s.pos += 1;
  loop {
    if(!((tk(s, 0).kind == kind_ident()) && is_open_ch(s, 40, 1) && !core_word_text(tk_text(s, 0)))) break;
    cl_w = tk_text(s, 0);
    s.pos += 2;
    loop {
      if(is_close_ch(s, 41)) break;
      cl_pr = param_node(s);
      if(!cl_pr.ok) { s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
      params.push(with_clause(cl_pr.node, cl_w));
      if(is_op_at(s, ",", 0)) s.pos += 1 else if(!is_close_ch(s, 41)) { want(s, "список параметров клаузы"); s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    }
    s.pos += 1;
  }
  if(is_op_at(s, "=>", 0)) {
    s.pos += 2; // `=>` is two one-character tokens
    s.tail = false;
    s.head = s.pos;
    e = expression(s);
    // `;` is optional (end_expr_body parser.hpp); a tail record (g() => if(c) return x;) has eaten it itself
    if((s.error != "") || (s.unsupported != "")) { if(s.unsupported == "") want(s, "тело-выражение"); s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    r = node_of(e);
    if(!r.ok) { want(s, "выражение без узла"); s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
    if(s.tail) s.tail = false else if(is_op_at(s, ";", 0)) s.pos += 1;
    learn_fn(s, fname, params);
    return ires{true, ast.function{fname, params, rtype, r.node, false, true, attrs, false, array{}}, from, s.pos, ""};
  }
  b = block_node(s);
  if(!b.ok) { s.pos = from; why = if(s.unsupported != "") s.unsupported else s.error; skip_item(s); return ires{false, code(), from, s.pos, why}; }
  learn_fn(s, fname, params);
  ires{true, ast.function{fname, params, rtype, b.node, false, false, attrs, false, array{}}, from, s.pos, ""}
}
// T Name [: base] { [ct] T field [= value]; ... } [;] - an extension Name, an instance of T (instance_decl/struct_fields parser.hpp); `= {...}` and #name are not supported
struct_decl(ps s, attrs) {
  sd_of = tk_text(s, 0);
  sd_name = tk_text(s, 1);
  s.pos += 2;
  sd_base = "";
  if(is_op_at(s, ":", 0)) { sd_base = tk_text(s, 1); s.pos += 2; }
  s.pos += 1;
  sd_items = array{};
  loop {
    if(is_close_ch(s, 125)) break;
    if((tk(s, 0).kind == kind_end()) || (s.error != "") || (s.unsupported != "")) { want(s, "struct не закрыт"); return nres{false, code()}; }
    sd_ct = (tk_text(s, 0) == "ct") && (tk(s, 1).kind == kind_ident()) && (tk(s, 2).kind == kind_ident());
    if(sd_ct) s.pos += 1;
    if(!((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident()))) { want(s, "поле struct не «тип имя»"); return nres{false, code()}; }
    sd_ty = ast.name{tk_text(s, 0)};
    sd_fn = tk_text(s, 1);
    s.pos += 2;
    sd_init = code();
    if(is_op_at(s, "=", 0)) {
      s.pos += 1;
      if(is_open_ch(s, 123, 0) && (is_close_ch_at(s, 125, 1) || ((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2)))) { want(s, "значение {…} у поля struct"); return nres{false, code()}; }
      s.head = s.pos;
      s.tail = false;
      sd_e = expression(s);
      if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
      sd_r = node_of(sd_e);
      if(!sd_r.ok) { want(s, "значение поля без узла"); return nres{false, code()}; }
      sd_init = sd_r.node;
    }
    if(is_op_at(s, ";", 0)) s.pos += 1 else if(!is_close_ch(s, 125)) { want(s, "поле struct без ;"); return nres{false, code()}; }
    sd_items.push(ast.variable{sd_fn, sd_ty, sd_init, false, sd_ct, false, false, array{}});
  }
  s.pos += 1;
  if(is_op_at(s, ";", 0)) s.pos += 1;
  nres{true, ast.extension{sd_name, sd_items, attrs, 0, sd_of, sd_base}}
}
// ct x = e; - a variable at compile time (§7.3, parser.hpp statement): variable{ct}
ct_var(ps s) {
  cv_name = tk_text(s, 1);
  s.pos += 3;
  s.head = s.pos;
  s.tail = false;
  cv_e = expression(s);
  if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
  cv_r = node_of(cv_e);
  if(!cv_r.ok) { want(s, "значение ct-переменной без узла"); return nres{false, code()}; }
  if(is_op_at(s, ";", 0)) s.pos += 1 else if(!is_close_ch(s, 125)) { want(s, "ct-переменная без ;"); return nres{false, code()}; } // end_statement
  nres{true, ast.variable{cv_name, code(), cv_r.node, false, true, false, false, array{}}}
}
struct plres { bool ok; array items; }
// (parameters) - param_list parser.hpp
plist(ps s) {
  pl_items = array{};
  s.pos += 1;
  loop {
    if(is_close_ch(s, 41)) break;
    pl_p = param_node(s);
    if(!pl_p.ok) return plres{false, array{}};
    pl_items.push(pl_p.node);
    if(is_op_at(s, ",", 0)) s.pos += 1 else break;
  }
  if(is_close_ch(s, 41)) s.pos += 1 else { want(s, "список параметров оператора"); return plres{false, array{}}; }
  plres{true, pl_items}
}
// glued operator symbols (symbol_run parser.hpp)
symbol_run(ps s) {
  sr = "";
  loop {
    if(!((tk(s, 0).kind == kind_op()) && op_char(tk(s, 0).ch) && ((sr == "") || tk(s, 0).glued) && !((sr == "") && is_op_at(s, "=>", 0)))) break;
    sr = sr + tk_text(s, 0);
    s.pos += 1;
  }
  sr
}
// operator -(a) ... | operator (a) + (b) ... | operator (a)++ ... | operator (a)[i] ... (operator_decl parser.hpp); `using operator` is not supported
operator_item(ps s, attrs, bool scoped) {
  s.pos += 1;
  oi_params = array{};
  oi_role = "";
  oi_sym = "";
  if(is_open_ch(s, 40, 0)) {
    oi_pl = plist(s);
    if(!oi_pl.ok) return nres{false, code()};
    oi_params = oi_pl.items;
    if(is_open_ch(s, 91, 0)) {
      s.pos += 1;
      oi_ix = param_node(s);
      if(!oi_ix.ok) return nres{false, code()};
      oi_params.push(oi_ix.node);
      if(is_close_ch(s, 93)) s.pos += 1 else { want(s, "оператор []: ]"); return nres{false, code()}; }
      oi_sym = "[]";
      oi_role = "infix";
    } else {
      oi_sym = symbol_run(s);
      if(oi_sym == "") { want(s, "ожидались символы оператора"); return nres{false, code()}; }
      if(is_open_ch(s, 40, 0)) {
        oi_role = "infix";
        oi_pl2 = plist(s);
        if(!oi_pl2.ok) return nres{false, code()};
        for(q : oi_pl2.items) oi_params.push(q);
      } else oi_role = "postfix";
    }
  } else {
    oi_role = "prefix";
    oi_sym = symbol_run(s);
    if(oi_sym == "") { want(s, "ожидались символы оператора"); return nres{false, code()}; }
    if(!is_open_ch(s, 40, 0)) { want(s, "оператор: параметры"); return nres{false, code()}; }
    oi_pl3 = plist(s);
    if(!oi_pl3.ok) return nres{false, code()};
    oi_params = oi_pl3.items;
  }
  if(has_text(array{"=", "+=", "-=", "*=", "/="}, oi_sym)) { want(s, "присваивание — форма ядра, не оператор"); return nres{false, code()}; }
  if(oi_params.size != (if(oi_role == "infix") 2 else 1)) { want(s, "у оператора неверное число параметров"); return nres{false, code()}; }
  oi_name = oi_role + oi_sym;
  if(is_op_at(s, "=>", 0)) {
    s.pos += 2;
    s.tail = false;
    s.head = s.pos;
    oi_e = expression(s);
    if((s.error != "") || (s.unsupported != "")) { if(s.unsupported == "") want(s, "тело-выражение оператора"); return nres{false, code()}; }
    oi_r = node_of(oi_e);
    if(!oi_r.ok) { want(s, "выражение без узла"); return nres{false, code()}; }
    if(s.tail) s.tail = false else if(is_op_at(s, ";", 0)) s.pos += 1; // end_expr_body: `;` is optional
    return nres{true, ast.function{oi_name, oi_params, code(), oi_r.node, false, true, attrs, scoped, array{}}};
  }
  if(!is_open_ch(s, 123, 0)) { want(s, "оператор: тело"); return nres{false, code()}; }
  oi_b = block_node(s);
  if(!oi_b.ok) return nres{false, code()};
  nres{true, ast.function{oi_name, oi_params, code(), oi_b.node, false, false, attrs, scoped, array{}}}
}
// a copy of a parameter with a clause (ast.parameter: name, type, mode, pack, clause, strict, source)
with_clause(pn, str cl) => ast.parameter{node_field(pn, "name"), node_field(pn, "type"), node_field(pn, "mode"), node_field(pn, "pack"), cl, node_field(pn, "strict"), node_field(pn, "source")};
// learn parser.hpp: a function with a clause or a last expr parameter is a construct (tail/bare/clauses)
learn_fn(ps s, str name, array params) {
  if(rule_has(s, name)) { // a function named like a record head closes the records until the end of the context (shadow_records parser.hpp)
    lf_keep = array{};
    for(r : s.rules) if(r[0] != name) lf_keep.push(r);
    s.rules = lf_keep;
  }
  lf_any = false;
  lf_head = 0;
  lf_last = false;
  for(p : params) {
    if(node_field(p, "clause") != "") lf_any = true
    else {
      lf_head += 1;
      lf_last = node_field(p, "mode") == 4;
    }
  }
  if(!lf_any && !lf_last) return 0;
  ci = cons_of(s, name);
  row = if(ci >= 0) s.cons[ci] else array{name, 0, 0, array{}, 0};
  tail = if(lf_last) 1 else row[1];
  bare = if((lf_head == 1) && lf_last) 1 else row[2];
  cls = row[3];
  for(p : params) {
    cl = node_field(p, "clause");
    if(cl == "") continue;
    known = false;
    for(c : cls) if(c[0] == cl) known = true;
    if(!known) cls.push(array{cl, if(node_field(p, "pack")) 1 else 0});
  }
  nrow = array{name, tail, bare, cls, row[4]};
  if(ci >= 0) {
    ncons = array{};
    for(i : range(s.cons.size)) ncons.push(if(i == ci) nrow else s.cons[i]);
    s.cons = ncons;
  } else s.cons.push(nrow);
  0
}
// an operator is declared by the program: the symbol's role extends the table (learn_operator parser.hpp; "already there - the context does not change")
learn_op(ps s, str name) {
  lo_role = -1;
  lo_sym = "";
  if(starts_with(name, "prefix")) { lo_role = 1; lo_sym = text_from(name, 6); }
  else if(starts_with(name, "postfix")) { lo_role = 2; lo_sym = text_from(name, 7); }
  else if(starts_with(name, "infix")) { lo_role = 0; lo_sym = text_from(name, 5); }
  if((lo_role < 0) || (lo_sym == "") || (lo_sym == "[]")) return 0;
  if(has_text(s.ops[lo_role], lo_sym)) return 0;
  base = if(lo_role == 0) roles_infix0() else if(lo_role == 1) roles_prefix0() else roles_postfix0();
  if(has_text(base, lo_sym)) return 0;
  nops = array{};
  for(i : range(3)) nops.push(if(i == lo_role) array{...s.ops[i], lo_sym} else s.ops[i]);
  s.ops = nops;
  0
}
// a variable declaration: [const] [explicit] T x = e; | const x = e; | &x = e; (try_var_decl parser.hpp). No - nres{false} with an empty reason: not a declaration
var_decl_ahead(ps s) {
  vd_k = 0;
  vd_const = (tk_text(s, 0) == "const") && (tk(s, 0).kind == kind_ident());
  if(vd_const) vd_k = 1;
  vd_strict = (tk_text(s, vd_k) == "explicit") && (tk(s, vd_k + 1).kind == kind_ident()) && (tk(s, vd_k + 2).kind == kind_ident());
  if(vd_strict) vd_k += 1;
  vd_typed = (tk(s, vd_k).kind == kind_ident()) && !is_keyword_word(tk_text(s, vd_k)) && (tk(s, vd_k + 1).kind == kind_ident()) && is_op_at(s, "=", vd_k + 2);
  vd_qual = vd_const && (tk(s, vd_k).kind == kind_ident()) && is_op_at(s, "=", vd_k + 1);
  vd_ref = (vd_k == 0) && is_op_at(s, "&", 0) && (tk(s, 1).kind == kind_ident()) && is_op_at(s, "=", 2);
  vd_typed || vd_qual || vd_ref
}
var_decl(ps s) {
  vd_const = (tk_text(s, 0) == "const") && (tk(s, 0).kind == kind_ident());
  if(vd_const) s.pos += 1;
  vd_strict = (tk_text(s, 0) == "explicit") && (tk(s, 1).kind == kind_ident()) && (tk(s, 2).kind == kind_ident());
  if(vd_strict) s.pos += 1;
  vd_ref = is_op_at(s, "&", 0);
  if(vd_ref) s.pos += 1;
  vd_ty = code();
  if((tk(s, 1).kind == kind_ident()) && !vd_ref) {
    if(tk_text(s, 0) == "auto") { want(s, "auto не нужен"); return nres{false, code()}; }
    vd_ty = ast.name{tk_text(s, 0)};
    s.pos += 1;
  }
  if(vd_strict && !given(vd_ty)) { want(s, "explicit без типа"); return nres{false, code()}; }
  vd_nm = tk_text(s, 0);
  s.pos += 2;
  s.head = s.pos;
  s.tail = false;
  vd_e = value_expr(s);
  if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
  vd_r = node_of(vd_e);
  if(!vd_r.ok) { want(s, "значение переменной без узла"); return nres{false, code()}; }
  s.tail = false;
  if(is_op_at(s, ";", 0)) s.pos += 1 else if(!is_close_ch(s, 125)) { want(s, "объявление без ;"); return nres{false, code()}; } // end_statement
  nres{true, ast.variable{vd_nm, vd_ty, vd_r.node, vd_const, false, vd_ref, vd_strict, array{}}}
}
// --- syntax: the declaration of a program record (syntax_decl parser.hpp). A core node record (`syntax word ... => ast.kind{...}`) goes into ps.rules -
// like the prelude's records; other bodies (a quote template, a function form, a program kind) - the declaration is parsed, but the use of the record
// is unknown: ps.custom
syntax_param(ps s, str mode_name) {
  sy_p = param_node(s);
  sy_p
}
syntax_item(ps s, attrs) {
  s.pos += 1;
  if(tk(s, 0).kind != kind_ident()) { want(s, "syntax: имя"); return nres{false, code()}; }
  sy_name = tk_text(s, 0);
  s.pos += 1;
  sy_form = array{sy_name};
  sy_params = array{};
  loop {
    if(is_op_at(s, "=>", 0)) break;
    if(tk(s, 0).kind == kind_end()) { fail(s, "syntax: нет =>"); return nres{false, code()}; }
    if(is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1)) { // [[line]] - a layout mark: print only
      s.pos += 2;
      loop {
        if(!((tk(s, 0).kind == kind_ident()) && has_text(array{"line", "indent", "space", "glued"}, tk_text(s, 0)))) { want(s, "пометка раскладки записи"); return nres{false, code()}; }
        sy_form.push("[" + tk_text(s, 0) + "]");
        s.pos += 1;
        if(is_op_at(s, ",", 0)) s.pos += 1 else break;
      }
      if(is_close_ch(s, 93) && is_close_ch_at(s, 93, 1)) s.pos += 2 else { want(s, "пометка раскладки: ]]"); return nres{false, code()}; }
      if(is_op_at(s, "=>", 0)) { want(s, "пометка раскладки — перед частью записи"); return nres{false, code()}; }
    } else if(is_open_ch(s, 40, 0)) {
      sy_glued = tk(s, 0).glued;
      s.pos += 1;
      sy_pr = param_node(s);
      if(!sy_pr.ok) return nres{false, code()};
      sy_params.push(sy_pr.node);
      sy_list = is_op_at(s, ",", 0) && is_op_at(s, "...", 1);
      if(sy_list) {
        s.pos += 1 + 3;
      } else if(is_op_at(s, ",", 0)) { // (a, b) - several places in one pair of parentheses
        sy_form.push(if(sy_glued) "()+" else "(+");
        loop {
          if(!is_op_at(s, ",", 0)) break;
          s.pos += 1;
          sy_pr2 = param_node(s);
          if(!sy_pr2.ok) return nres{false, code()};
          sy_params.push(sy_pr2.node);
          sy_form.push(if(is_op_at(s, ",", 0)) ",+" else ",)");
        }
        if(is_close_ch(s, 41)) s.pos += 1 else { want(s, "syntax: )"); return nres{false, code()}; }
        continue;
      }
      if(is_close_ch(s, 41)) s.pos += 1 else { want(s, "syntax: )"); return nres{false, code()}; }
      sy_form.push((if(sy_glued) "()" else "(") + (if(sy_list) "..." else ""));
    } else if(is_op_at(s, ";", 0)) {
      s.pos += 1;
      sy_form.push(";");
    } else if(is_open_ch(s, 123, 0)) {
      s.pos += 1;
      sy_value = is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1);
      if(sy_value) {
        s.pos += 2;
        if(tk_text(s, 0) != "value") { want(s, "в слоте записи — только [[value]]"); return nres{false, code()}; }
        s.pos += 1;
        if(is_close_ch(s, 93) && is_close_ch_at(s, 93, 1)) s.pos += 2 else { want(s, "слот: ]]"); return nres{false, code()}; }
      }
      if(tk(s, 0).kind != kind_ident()) { want(s, "слот записи: имя"); return nres{false, code()}; }
      sy_params.push(ast.parameter{tk_text(s, 0), code(), 4, false, "", false, -1});
      s.pos += 1;
      if(is_close_ch(s, 125)) s.pos += 1 else { want(s, "слот записи: }"); return nres{false, code()}; }
      sy_form.push(if(sy_value) "{=" else "{");
    } else if(tk(s, 0).kind == kind_ident()) {
      sy_form.push(tk_text(s, 0));
      s.pos += 1;
    } else if(is_op_at(s, "#", 0) && (tk(s, 1).kind == kind_ident()) && tk(s, 1).glued) {
      sy_params.push(ast.parameter{tk_text(s, 1), code(), 0, false, "", false, -1});
      s.pos += 2;
      sy_form.push("#");
    } else if(tk(s, 0).kind == kind_op()) {
      sy_sym = symbol_run(s);
      if(sy_sym == "") { want(s, "syntax: символы"); return nres{false, code()}; }
      sy_form.push(sy_sym);
    } else { want(s, "в записи syntax — слова, символы, ;, (параметр) и {тело}"); return nres{false, code()}; }
  }
  s.pos += 2;
  if((tk_text(s, 0) == "quote") && is_open_ch(s, 123, 1)) { want(s, "syntax: заготовка quote"); return nres{false, code()}; }
  sy_body = code();
  if(is_open_ch(s, 123, 0) && !((tk(s, 1).kind == kind_ident()) && is_op_at(s, ":", 2))) {
    sy_b = block_node(s);
    if(!sy_b.ok) return nres{false, code()};
    sy_body = sy_b.node;
  } else {
    s.tail = false;
    s.head = s.pos;
    sy_e = expression(s);
    if((s.error != "") || (s.unsupported != "")) { if(s.unsupported == "") want(s, "тело syntax"); return nres{false, code()}; }
    sy_r = node_of(sy_e);
    if(!sy_r.ok) { want(s, "тело syntax без узла"); return nres{false, code()}; }
    sy_body = sy_r.node;
    if(s.tail) s.tail = false else if(is_op_at(s, ";", 0)) s.pos += 1;
  }
  fnode = ast.function{sy_name, sy_params, code(), sy_body, false, true, attrs, false, sy_form};
  learn_syntax(s, fnode, sy_params, sy_form, sy_body);
  nres{true, fnode}
}
// record_of ast.hpp (the kinds "core node" and "core call"): a row of rules - like syntax_records(); otherwise the program's rules are unknown
learn_syntax(ps s, fnode, params, form, body) {
  ls_kind = -2;
  ls_items = array{};
  ls_name = node_field(fnode, "name");
  if(code_kind(body) == ast.construct) {
    ty = node_field(body, "type");
    if((code_kind(ty) == ast.name) && starts_with(node_field(ty, "name"), "ast.")) {
      ks = code_kinds();
      for(i : range(ks.size)) if(text(ks[i]) == node_field(ty, "name")) ls_kind = i;
      ls_items = node_field(body, "items");
    }
  } else if((code_kind(body) == ast.call) && (code_kind(node_field(body, "callee")) == ast.name) && (node_field(node_field(body, "callee"), "name") == ls_name)) {
    if((node_field(body, "words").size == 0) && !node_field(body, "tail")) { ls_kind = -1; ls_items = node_field(body, "args"); }
  }
  if(ls_kind == -2) { s.custom = true; return 0; }
  places = if(ls_kind >= 0) fields(code_kinds()[ls_kind]).size else ls_items.size;
  slots = array{};
  for(k : range(params.size)) slots.push(-1);
  for(i : range(ls_items.size)) {
    it = ls_items[i];
    if(code_kind(it) != ast.name) { s.custom = true; return 0; }
    nm = node_field(it, "name");
    if((ls_kind >= 0) && (nm == "_")) continue;
    at = -1;
    for(k : range(params.size)) if(node_field(params[k], "name") == nm) at = k;
    if((at < 0) || (slots[at] != -1)) { s.custom = true; return 0; }
    slots[at] = i;
  }
  for(k : range(slots.size)) if(slots[k] == -1) { s.custom = true; return 0; }
  pieces = array{};
  for(p : form) if(!starts_with(p, "[") || (p.size <= 2)) pieces.push(p);
  s.rules = array{...s.rules, array{ls_name, pieces, ls_kind, slots, places}};
  0
}
// [[a, b]] [[c]] - attributes: ordinary expressions (attributes parser.hpp)
parse_attrs(ps s) {
  pa_items = array{};
  loop {
    if(!(is_open_ch(s, 91, 0) && is_open_ch(s, 91, 1))) break;
    s.pos += 2;
    loop {
      if(is_close_ch(s, 93)) break;
      pa_e = expression(s);
      pa_r = node_of(pa_e);
      if((s.error != "") || (s.unsupported != "") || !pa_r.ok) { if((s.unsupported == "") && (s.error == "")) want(s, "атрибут без узла"); return plres{false, array{}}; }
      pa_items.push(pa_r.node);
      if(is_op_at(s, ",", 0)) s.pos += 1 else break;
    }
    if(is_close_ch(s, 93) && is_close_ch_at(s, 93, 1)) s.pos += 2 else { want(s, "атрибуты: ]]"); return plres{false, array{}}; }
  }
  plres{true, pa_items}
}
// Name { ... } - an entity extension: functions, fields `T name [= v];`, attributes (extension parser.hpp)
extension_item(ps s, str ex_from) {
  ex_name = tk_text(s, 0);
  s.pos += 2;
  ex_items = array{};
  ex_attrs = array{};
  loop {
    if(is_close_ch(s, 125)) break;
    if((tk(s, 0).kind == kind_end()) || (s.error != "") || (s.unsupported != "")) { want(s, "расширение не закрыто"); return nres{false, code()}; }
    ex_p0 = s.pos;
    ex_at = parse_attrs(s);
    if(!ex_at.ok) return nres{false, code()};
    ex_fn = (tk(s, 0).kind == kind_ident()) && ((is_open_ch(s, 40, 1) && !core_word_text(tk_text(s, 0))) || ((tk(s, 1).kind == kind_ident()) && is_open_ch(s, 40, 2)));
    if(ex_fn) {
      s.pos = ex_p0;
      ex_it = item_node(s);
      if(!ex_it.ok) { if(s.unsupported == "") want(s, if(ex_it.why == "") "функция в расширении" else ex_it.why); return nres{false, code()}; }
      ex_items.push(ex_it.node);
      continue;
    }
    if((tk(s, 0).kind == kind_ident()) && (tk(s, 1).kind == kind_ident())) { // a field: T name [= v];
      ex_ty = ast.name{tk_text(s, 0)};
      ex_nm = tk_text(s, 1);
      s.pos += 2;
      ex_init = code();
      if(is_op_at(s, "=", 0)) {
        s.pos += 1;
        s.head = s.pos;
        s.tail = false;
        ex_e = value_expr(s);
        if((s.error != "") || (s.unsupported != "")) return nres{false, code()};
        ex_r = node_of(ex_e);
        if(!ex_r.ok) { want(s, "значение поля без узла"); return nres{false, code()}; }
        ex_init = ex_r.node;
      }
      s.tail = false;
      if(is_op_at(s, ";", 0)) s.pos += 1 else if(!is_close_ch(s, 125)) { want(s, "поле расширения без ;"); return nres{false, code()}; }
      ex_items.push(ast.variable{ex_nm, ex_ty, ex_init, false, false, false, false, array{}});
      for(a : ex_at.items) ex_attrs.push(a);
      continue;
    }
    if(ex_at.items.size == 0) { want(s, "в расширении ожидались поле, функция или [[атрибут]]"); return nres{false, code()}; }
    for(a : ex_at.items) ex_attrs.push(a);
    if(is_op_at(s, ";", 0)) s.pos += 1;
  }
  s.pos += 1;
  if(is_op_at(s, ";", 0)) s.pos += 1;
  nres{true, ast.extension{ex_name, ex_items, ex_attrs, 0, "", ""}}
}
// skip_to_statement_end parser.hpp: skipping to the end of the instruction - `;` (eaten), `}` (the block ends it), the end of the enclosing group (not eaten)
skip_stmt(ps s) {
  loop {
    t = tk(s, 0);
    if(t.kind == kind_end()) return 0;
    if(t.kind == kind_close()) return 0;
    if(t.kind == kind_open()) {
      m = s.match[s.pos];
      if(m < 0) { s.pos += 1; continue; }
      s.pos = m + 1;
      if(tk_at(s, m).ch == 125) return 0;
      if(tk_at(s, m).err >= 0) return 0; // closed by the repair: next comes the next line
      continue;
    }
    // an unclosed string ate the end of the text line (and its `;`) - the instruction ends on it
    semi = is_op_at(s, ";", 0) || ((t.kind == kind_bad()) && ((text_range(s.src, t.from, t.from + 1) == "\"") || (text_range(s.src, t.from, t.from + 1) == "'")));
    s.pos += 1;
    if(semi) return 0;
  }
  0
}
// the reason for a hole: a lexer/bracket repair error in the skipped lexemes is its own (recover_statement parser.hpp), otherwise it is a parse diagnostic
hole_reason(ps s, i64 p0, i64 p1, str dflt) {
  for(k : range(p1 - p0)) {
    t = tk_at(s, p0 + k);
    if((t.err >= 0) && (t.err < s.lerrs.size)) return s.lerrs[t.err].what;
  }
  dflt
}
// a function declaration closes the prelude record with the same name (shadow_records/learn parser.hpp), and a function with a `word(...)` clause or
// an expr parameter is a construct: the rules change - the following elements are "not supported" (attributes [[...]] and outline before a declaration are skipped)
declares_shadow(ps s, i64 from) {
  p = from;
  loop {
    if(!((tk_at(s, p).kind == kind_open()) && (tk_at(s, p).ch == 91) && (tk_at(s, p + 1).kind == kind_open()) && (tk_at(s, p + 1).ch == 91))) break;
    m = s.match[p];
    if(m < 0) return false;
    p = m + 1;
  }
  if((tk_at(s, p).kind == kind_ident()) && has_text(array{"syntax", "operator", "use", "using"}, text_range(s.src, tk_at(s, p).from, tk_at(s, p).to))) return false; // a rule declaration, not a function
  if((tk_at(s, p).kind == kind_ident()) && (text_range(s.src, tk_at(s, p).from, tk_at(s, p).to) == "outline")) p += 1;
  // an extension `Name { ... }` / `&f(...) { ... }` declares functions inside - the rules may change (conservatively)
  if((tk_at(s, p).kind == kind_ident()) && (tk_at(s, p + 1).kind == kind_open()) && (tk_at(s, p + 1).ch == 123)) return true;
  if((tk_at(s, p).kind == kind_op()) && (text_range(s.src, tk_at(s, p).from, tk_at(s, p).to) == "&")) return true;
  name_at = -1;
  if((tk_at(s, p).kind == kind_ident()) && (tk_at(s, p + 1).kind == kind_ident()) && (tk_at(s, p + 2).kind == kind_open()) && (tk_at(s, p + 2).ch == 40)) name_at = p + 1
  else if((tk_at(s, p).kind == kind_ident()) && (tk_at(s, p + 1).kind == kind_open()) && (tk_at(s, p + 1).ch == 40)) name_at = p
  else return false;
  w = text_range(s.src, tk_at(s, name_at).from, tk_at(s, name_at).to);
  if(rule_has(s, w)) return true;
  false
}
// module elements of the text: the ires array (in text order)
// [[...]] before module: the attributes of the module, not of the first element (module_attrs_ahead parser.hpp)
module_attrs_ahead(ps s) {
  k = 0;
  loop {
    if(!(is_open_ch(s, 91, k) && is_open_ch(s, 91, k + 1))) break;
    m = s.match[s.pos + k];
    if(m < 0) return false;
    k = (m + 1) - s.pos;
  }
  (k > 0) && (tk(s, k).kind == kind_ident()) && (tk_text(s, k) == "module")
}
// `module a.b;` is the module header: skipped up to the elements; with attributes/sealed the file is not compared
module_header_ok(ps s) {
  if((tk_text(s, 0) == "sealed") && (tk_text(s, 1) == "module")) return false;
  if(module_attrs_ahead(s)) return false;
  if(!((tk(s, 0).kind == kind_ident()) && (tk_text(s, 0) == "module"))) return true;
  if(tk(s, 1).kind != kind_ident()) return false;
  s.pos += 2;
  loop {
    if(!(is_op_at(s, ".", 0) && (tk(s, 1).kind == kind_ident()))) break;
    s.pos += 2;
  }
  if(!is_op_at(s, ";", 0)) return false;
  s.pos += 1;
  true
}
module_header_skip(str src) {
  r = phase1_of(src);
  if(r.bracket_error || (r.errors.size > 0)) return false;
  s = ps{src, r.tokens, r.match, 0, "", "", array{}, false, -1, false, false, array{}};
  !module_header_ok(s)
}
module_items_of(str src) {
  r = phase1_of(src);
  items = array{};
  s = ps{src, r.tokens, r.match, 0, "", "", syntax_records(), false, -1, false, false, syntax_constructs(), array{array{}, array{}, array{}}, false, r.errors};
  if(!module_header_ok(s)) return items;
  loop {
    if(tk(s, 0).kind == kind_end()) break;
    s.unsupported = "";
    s.error = "";
    p0 = s.pos;
    it = item_node(s);
    if(!it.ok && (s.error != "") && (s.unsupported == "") && (it.to > it.from)) { // a parse error is a hole (recover_statement parser.hpp): the skipped text and the reason
      ht = slice_text(src, tk_at(s, it.from).from, tk_at(s, it.to - 1).to);
      it = ires{true, ast.hole{ht, hole_reason(s, it.from, it.to, s.error)}, it.from, it.to, ""};
    }
    items.push(it);
    if(declares_shadow(s, it.from)) s.custom = true;
    for(ti : range(it.to - it.from)) {
      tt = tk_at(s, it.from + ti);
      if(tt.kind == kind_ident()) {
        tw = text_range(s.src, tt.from, tt.to);
        if(has_text(array{"using"}, tw)) s.custom = true;
      }
    }
    if(s.pos <= p0) break;
  }
  items
}
// the reference: the text's module parsed by C++ (stage0) with the prelude; the whole dump
module_reference(str src) => native "cpp" {
  if(!a[0].known()) return erase(value(std::string()));
  ast_db db;
  load_prelude(db);
  parser p(db, std::string(a[0].as<str_v>().view()), "<modcheck>");
  node_id m = p.parse_module();
  return value(dumper(db).dump(m));
};
// module dump elements: depth-2 lines start an element
ref_items(str dump) {
  items = array{};
  cur = "";
  started = false;
  for(l : lines_of(dump)) {
    if(starts_with(l, "  n_") || starts_with(l, "  ·")) {
      if(started) items.push(cur);
      cur = "";
      started = true;
    }
    if(started) cur = cur + (slice_text(l, 2, l.size) + "\n");
  }
  if(started) items.push(cur);
  items
}
src_has_word(str src, str w) {
  r = phase1_of(src);
  for(t : r.tokens) if((t.kind == kind_ident()) && (text_range(src, t.from, t.to) == w)) return true;
  false
}
// vish modcheck <files>: element by element - functions from the Vish parser nodes against the C++ dump; a mismatch in the number of elements - the file is skipped
mod_check_cli(files) {
  total = 0;
  supported = 0;
  same = 0;
  bad = 0;
  skipped_files = 0;
  reasons = array{};
  counts = array{};
  samples = 0;
  for(f : files) {
    src = read_text(f);
    if(module_header_skip(src)) { // attributes [[...]] module/sealed: C++ gives attributes in the dump as extra elements - comparison by number is impossible
      skipped_files += 1;
      write_out("  пропущен файл " + f + ": заголовок module\n");
      continue;
    }
    mine = module_items_of(src);
    ref = ref_items(module_reference(src));
    // after program rules (syntax/operator/use/...) Vish's element boundaries are approximate (skip_item): we compare only the prefix before them
    cut = -1;
    for(k : range(mine.size)) if((cut < 0) && starts_with(mine[k].why, "правила программы выше")) cut = k;
    // the prefix is reliable only if all its elements are parsed (for unsupported ones the boundaries are an approximation, skip_item: an index shift gives a false "matched")
    prefix_ok = cut >= 0;
    for(k : range(mine.size)) if((k < cut) && !mine[k].ok) prefix_ok = false;
    if(!prefix_ok) cut = -1;
    if((cut >= 0) && (ref.size >= cut)) {
      for(k : range(mine.size - cut)) { total += 1; w0 = mine[cut + k].why; at0 = -1; for(j : range(reasons.size)) if(reasons[j] == w0) at0 = j; if(at0 < 0) { reasons.push(w0); counts.push(1); } else counts[at0] += 1; }
      head = array{};
      for(k : range(cut)) head.push(mine[k]);
      mine = head;
    }
    if(((cut < 0) && (mine.size != ref.size)) || ((cut >= 0) && (ref.size < cut))) {
      skipped_files += 1;
      write_out("  пропущен файл " + f + ": элементов у Vish " + text(mine.size) + ", у C++ " + text(ref.size) + "\n");
      continue;
    }
    for(k : range(mine.size)) {
      total += 1;
      if(!mine[k].ok) {
        w = if(mine[k].why == "") "(без причины)" else mine[k].why;
        if((mine[k].why == "") && (samples < 14)) {
          samples += 1;
          tk0 = phase1_of(src).tokens;
          write_out("  пример без причины: " + f + " элемент " + text(k) + ": " + slice_text(slice_text(src, tk0[mine[k].from].from, tk0[mine[k].to - 1].to), 0, 90) + "\n");
        }
        at = -1;
        for(j : range(reasons.size)) if(reasons[j] == w) at = j;
        if(at < 0) { reasons.push(w); counts.push(1); } else counts[at] += 1;
        continue;
      }
      supported += 1;
      got = dump_code(mine[k].node);
      if(got == ref[k]) same += 1 else {
        bad += 1;
        write_out(f + ": элемент " + text(k) + " расхождение\n--- vish\n" + got + "--- C++\n" + ref[k]);
      }
    }
  }
  write_out("модуль: элементов " + text(total) + ", функций из узлов Vish " + text(supported) + ", совпало " + text(same) + ", расхождений " + text(bad) + ", файлов пропущено (число элементов не сошлось) " + text(skipped_files) + "\n");
  for(j : range(reasons.size)) write_out("  не поддержано: " + reasons[j] + " — " + text(counts[j]) + "\n");
  if(bad == 0) 0 else 1
}

// The prelude's syntax records as data (E4c; the rules are code in the language, not hard-coded in the parser: the author's requirement;
// "there are no problems with keywords if we have no keywords"): a line per record -
// array{word, form parts (array str), kind (an index into code_kinds(); -1 - a core call), slots (array i64), number of places}
syntax_records() => native "cpp" {
  struct record_row {
    std::string word;
    std::vector<std::string> pieces;
    int64_t kind;
    std::vector<int64_t> slots;
    int64_t places;
  };
  static std::vector<record_row> rows; // the parse of the prelude is once per process; VM values are rebuilt on every call
  static bool loaded = false;
  if(!loaded) {
    ast_db db;
    load_prelude(db);
    node_id pre = db.prelude;
    if(pre)
      for(node_id d: db.as<n_module>(pre).items) {
        if(!db.is<n_fn>(d)) continue;
        auto r = record_of(db, d);
        if(!r || r->kind == record_template) continue;
        auto const & f = db.as<n_fn>(d);
        record_row row{std::string(db.strings.text(f.name)), {}, int64_t(r->kind), {}, int64_t(r->places)};
        for(std::size_t k = 0; k < f.form.size(); ++k) row.pieces.push_back(std::string(form_piece(db, f, k)));
        for(auto sl: r->slot) row.slots.push_back(int64_t(sl));
        rows.push_back(std::move(row));
      }
    loaded = true;
  }
  std::vector<value> out;
  for(auto const & row: rows) {
    std::vector<value> pieces, slots;
    for(auto const & p: row.pieces) pieces.push_back(value(std::string(p)));
    for(auto sl: row.slots) slots.push_back(value(int64_t(sl)));
    out.push_back(value(array_v::of({value(std::string(row.word)), value(array_v::of(std::move(pieces))), value(int64_t(row.kind)), value(array_v::of(std::move(slots))), value(int64_t(row.places))})));
  }
  return value(array_v::of(std::move(out)));
};
// Prelude constructs (learn parser.hpp): functions with a last expr parameter or word(...) clauses. A row:
// array{name, tail (the tail is an instruction), bare (a head without parentheses: try { ... }), clauses (array{word, pack}), raw (there is a raw body rule)}
syntax_constructs() => native "cpp" {
  struct construct_row {
    std::string name;
    bool tail = false, bare = false, raw = false;
    std::vector<std::pair<std::string, bool>> clauses;
  };
  static std::vector<construct_row> rows;
  static bool loaded = false;
  if(!loaded) {
    ast_db db;
    load_prelude(db);
    node_id pre = db.prelude;
    if(pre)
      for(node_id d: db.as<n_module>(pre).items) {
        if(!db.is<n_fn>(d)) continue;
        auto const & f = db.as<n_fn>(d);
        if(!f.name || raw_rule_form(db, f) || !f.form.empty()) continue;
        bool any_clause = false, last_expr = false;
        uint32_t head = 0;
        for(node_id pn: f.params) {
          auto const & p = db.as<n_param>(pn);
          if(p.clause) any_clause = true;
          else {
            ++head;
            last_expr = p.mode == param_mode::expr;
          }
        }
        if(!any_clause && !last_expr) continue;
        std::string name(db.strings.text(f.name));
        construct_row * row = nullptr;
        for(auto & r: rows)
          if(r.name == name) row = &r;
        if(!row) {
          rows.push_back({name, false, false, false, {}});
          row = &rows.back();
        }
        if(last_expr) row->tail = true;
        if(head == 1 && last_expr) row->bare = true;
        if(raw_rule_of(db, d)) row->raw = true;
        for(node_id pn: f.params) {
          auto const & p = db.as<n_param>(pn);
          if(!p.clause) continue;
          std::string w(db.strings.text(p.clause));
          bool known = false;
          for(auto & c: row->clauses)
            if(c.first == w) known = true;
          if(!known) row->clauses.push_back({w, bool(p.pack)});
        }
      }
    loaded = true;
  }
  std::vector<value> out;
  for(auto const & r: rows) {
    std::vector<value> cl;
    for(auto const & c: r.clauses) cl.push_back(value(array_v::of({value(std::string(c.first)), value(int64_t(c.second ? 1 : 0))})));
    out.push_back(value(array_v::of({value(std::string(r.name)), value(int64_t(r.tail ? 1 : 0)), value(int64_t(r.bare ? 1 : 0)), value(array_v::of(std::move(cl))), value(int64_t(r.raw ? 1 : 0))})));
  }
  return value(array_v::of(std::move(out)));
};
// the text of the records for debugging (vish syntaxrules x)
syntax_rules_dump() {
  out = "";
  for(c : syntax_constructs()) out = out + "конструкция " + c[0] + " tail=" + text(c[1]) + " bare=" + text(c[2]) + " клаузы=" + text(c[3].size) + " raw=" + text(c[4]) + "\n";
  for(r : syntax_records()) {
    out = out + r[0] + " | форма:";
    for(p : r[1]) out = out + " [" + p + "]";
    out = out + " | вид " + text(r[2]) + " места " + text(r[4]) + " слоты";
    for(x : r[3]) out = out + " " + text(x);
    out = out + "\n";
  }
  out
}
syntax_rules_cli(args) {
  write_out(syntax_rules_dump());
  0
}
