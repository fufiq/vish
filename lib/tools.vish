// parsing the text of editing according to the rules of the place at (-1 - the entire module, §4.4):
// array{mistakes in the text, elements of the disassembled}; label - the name of the edit in the messages
vm_parse_at(i64 s, i64 at, str label, str text) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(array_v::of({})));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  int64_t at = (a[1]).as<int64_t>();
  auto [errs, items] = x.parse_at(at < 0 ? node_id{} : node_id(uint32_t(at)), std::string((a[2]).as<str_v>().view()), std::string((a[3]).as<str_v>().view()));
  std::vector<value> ns;
  for(node_id n: items) ns.push_back(value(int64_t(n.value)));
  return value(array_v::of({value(errs), value(array_v::of(std::move(ns)))}));
};
// Element Old Becomes Fresh (id old saved): Base revision
vm_replace(i64 s, i64 old, i64 fresh) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(int64_t(0)));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(int64_t(x.replace_item(node_id(uint32_t((a[1]).as<int64_t>())), node_id(uint32_t((a[2]).as<int64_t>())))));
};
// elements of the program module - this list (one edit of the base): revision of the base
vm_set_items(i64 s, xs) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::vector<node_id> items;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) items.push_back(node_id(uint32_t((a[1]).as<array_v>().get(k).as<int64_t>())));
  x.set_items(std::move(items));
  return value(int64_t(x.db.revision));
};
// Program editing function f (§7.4): array {правок, ошибка}
vm_apply_fn(i64 s, i64 f) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  try {
    return value(array_v::of({value(int64_t(x.apply(node_id(uint32_t((a[1]).as<int64_t>()))))), value(std::string())}));
  } catch(diagnostic const & d) {
    return value(array_v::of({value(int64_t(0)), value(render(d, x.name, x.db))}));
  }
};
// journal database - in the file .vishdb: "" - written, otherwise the error
vm_save(i64 s, str path) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string path((a[1]).as<str_v>().view());
  try {
    save_db(x.db, x.root, path);
  } catch(diagnostic const & d) {
    return value(render(d, x.name, x.db));
  }
  return value(std::string());
};
// stats: array{узлов, записей журнала, байт .vishdb, узлов и записей при прошлом stats (0 — не было)}
vm_stats_facts(i64 s) => native "cpp" {
