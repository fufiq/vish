  return value(int64_t(x.proc->stale_values(t, struct_fields(x.db, n))));
};
// autotransfer of the values of struct n of the old layout (O8): "" - can (apply - moved), otherwise why not
vm_proc_auto(i64 s, i64 n, bool apply) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
