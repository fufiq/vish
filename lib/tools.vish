// Tuling in the language (author's decision 2026-10-20:).
// 
// 
// 
// Tuling modules are built into the assembly, like an editor, and loaded by the team that needs them (programs
// do not see them): tools - general (lines, output, OS, VM session commands), versions - version of the base,
// tests - run tests, cli - run vish. VM has a base: native "cpp" primitives.
//
//
// The chains of one associative operator (a + b + c) are bracketed as in editor.vish.
module tools;

// --- Primitives: the output of the command (VM) ----------------------------------------------- the
// output of the command (VM) - in stdout and stderr as is (without translating the line)
write_out(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stdout, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};
write_err(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stderr, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};

// --- primitives: strings - bytes (§4.0); search, slice, strings and words, order - base - place of part
// in line; -1 - no
find_text(str s, str part) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto at = (a[0]).as<str_v>().view().find((a[1]).as<str_v>().view());
  return value(at == std::string_view::npos ? int64_t(-1) : int64_t(at));
};
// bytes [from, to]
slice_text(str s, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t f = std::size_t(std::clamp<int64_t>((a[1]).as<int64_t>(), 0, int64_t(v.size()))), t = std::size_t(std::clamp<int64_t>((a[2]).as<int64_t>(), int64_t(f), int64_t(v.size())));
  return value(std::string(v.substr(f, t - f)));
};
// bytetail
text_from(str s, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t k = std::size_t(std::max<int64_t>(0, (a[1]).as<int64_t>()));
  return value(std::string(k < v.size() ? v.substr(k) : std::string_view()));
};
// Lines of text (without line translations) and line words (through spaces)
lines_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto l: lines_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(l)));
  return value(array_v::of(std::move(xs)));
};
words_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto w: words_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(w)));
  return value(array_v::of(std::move(xs)));
};
// row order: numbers by ascending keys (byte comparison, stable)
sorted_indices(keys) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & ks = (a[0]).as<array_v>();
  std::vector<uint32_t> order(ks.size());
  for(uint32_t k = 0; k < ks.size(); ++k) order[k] = k;
  std::ranges::stable_sort(order, [&](uint32_t x, uint32_t y) { return ks.get(x).as<str_v>().view() < ks.get(y).as<str_v>().view(); });
  std::vector<value> xs;
  for(uint32_t k: order) xs.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(xs)));
};

// place in an ordered array: the first, not less than x (binary search - primitive base); rows - bytes
//
lower_bound(xs, str x) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto const & xs = (a[0]).as<array_v>();
  auto x = (a[1]).as<str_v>().view();
  uint32_t lo = 0, hi = xs.size();
  while(lo < hi) {
    uint32_t mid = (lo + hi) / 2;
    if(xs.get(mid).as<str_v>().view() < x) lo = mid + 1;
    else hi = mid;
  }
  return value(int64_t(lo));
};
lower_bound(xs, i64 x) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto const & xs = (a[0]).as<array_v>();
  int64_t x = (a[1]).as<int64_t>();
  uint32_t lo = 0, hi = xs.size();
  if(xs.kind() == array_v::layout::ints) {
    int64_t const * d = xs.ints();
    while(lo < hi) {
      uint32_t mid = (lo + hi) / 2;
      if(d[mid] < x) lo = mid + 1;
      else hi = mid;
    }
  } else
    while(lo < hi) {
      uint32_t mid = (lo + hi) / 2;
      if(xs.get(mid).as<int64_t>() < x) lo = mid + 1;
      else hi = mid;
    }
  return value(int64_t(lo));
};

// the line "as in the conclusion": in quotation marks, "\\\n \\t - shielded
in_quotes(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(in_quotes((a[0]).as<str_v>().view()));
};
// chunks in a row - one line
join_texts(xs) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto const & ps = (a[0]).as<array_v>();
  std::size_t n = 0;
  for(uint32_t k = 0; k < ps.size(); ++k) n += ps.r().items[k].as<str_v>().view().size();
  std::string out;
  out.reserve(n);
  for(uint32_t k = 0; k < ps.size(); ++k) out += ps.r().items[k].as<str_v>().view();
  return value(std::move(out));
};
// replace all inputs from to
replace_all(str s, str from, str to) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(std::string()));
  std::string t((a[0]).as<str_v>().view());
  auto f = (a[1]).as<str_v>().view();
  auto r = (a[2]).as<str_v>().view();
  if(f.empty()) return value(std::move(t));
  for(std::size_t k = 0; (k = t.find(f, k)) != std::string::npos; k += r.size()) t.replace(k, f.size(), r);
  return value(std::move(t));
};
// order of numbers: ascending numbers
sorted_numbers(xs) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & ks = (a[0]).as<array_v>();
  std::vector<uint32_t> order(ks.size());
  for(uint32_t k = 0; k < ks.size(); ++k) order[k] = k;
  std::ranges::stable_sort(order, [&](uint32_t x, uint32_t y) { return ks.get(x).as<int64_t>() < ks.get(y).as<int64_t>(); });
  std::vector<value> out;
  for(uint32_t k: order) out.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(out)));
};

// --- Primitives: OS for commands (VM) ------------------------------------------------- text of the
// file (as is)
read_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(std::string(os::mapped_file(std::string((a[0]).as<str_v>().view())).text()));
};
// directory files (path - file: it itself)
files_in(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::filesystem::path d((a[0]).as<str_v>().view());
  std::vector<value> xs;
  if(std::filesystem::is_regular_file(d)) xs.push_back(value(d.string()));
  else
    for(auto & e: std::filesystem::directory_iterator(d)) xs.push_back(value(e.path().string()));
  return value(array_v::of(std::move(xs)));
};
// environment variable ("" - no"), ask, remove; processor cores
env_get(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  char const * v = std::getenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(std::string(v ? v : ""));
};
env_set(str name, str v) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  ::setenv(std::string((a[0]).as<str_v>().view()).c_str(), std::string((a[1]).as<str_v>().view()).c_str(), 1);
  return value(int64_t(0));
};
env_unset(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  ::unsetenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(int64_t(0));
};
cpu_count() => native "cpp" { return value(int64_t(std::max(std::thread::hardware_concurrency(), 1u))); };

// --- generalist ---
has_text(xs, str x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
has_number(xs, i64 x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
// number of strings of numbers (not number - 0)
number_of(str s) => parse_int(s).value;
starts_with(str s, str p) => (p.size <= s.size) && (find_text(s, p) == 0);
contains(str s, str p) => find_text(s, p) >= 0;
ends_with(str s, str tail) => (tail.size <= s.size) && (find_text(text_from(s, s.size - tail.size), tail) == 0);
// spaceless
trim_lead(str s) {
  k = 0;
  while((k < s.size) && (s[k] == ' ')) k += 1;
  text_from(s, k)
}
same_lines(xs, ys) {
  if(xs.size != ys.size) return false;
  r = true;
  for(k : range(xs.size)) if(xs[k] != ys[k]) r = false;
  r
}
// The reason is in stderr, code 1
fail(str why) {
  write_err(why + "\n");
  1
}

// --- VM session: commands by rows (vish vm, scripts .session, vish apply) ---------------------------- edit
// function - operation on the base, check recalculates only the affected (§10.1). Line - command and words;
// body edit - to the line "..." VM (session.hpp) has a command base: parsing, execution, database editing,
// live process, data (numbers, program output, text error with place). Solutions - what to replace with
// editing, struct and migrate in a live process, which editing function to apply - and command texts - here
// (user solution 2026-10-22):
//
// 
//.

// Elements of the root module v (-1 - program module): array{number, text, internal, empty lines in front
// of it, comments before it, comment at the end of the line}
version_items(i64 v, i64 root) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(array_v::of({}));
  return value(array_v::of(module_item_facts(*x->db, tools_host->module_of(*x, (a[1]).as<int64_t>()))));
};
// Root element numbers of version v (without text)
version_nodes(i64 v, i64 root) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({value(int64_t(0))})));
  std::vector<value> out;
  if(auto * x = tools_host->at((a[0]).as<int64_t>()))
    if(node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>()))
      for(node_id n: x->db->as<n_module>(m).items) out.push_back(value(int64_t(n.value)));
  return value(array_v::of(std::move(out)));
};
// What is the element n version v: array {вид, имя, части, цель} : fn (parts - parameter types, " " -
// without type), syntax (words form), struct, extend, extend_ref (goal - extensible function), var, other
version_signature(i64 v, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  int64_t n = (a[1]).as<int64_t>();
  if(!x || n < 0 || uint64_t(n) >= x->db->size()) return value(array_v::of({value(std::string("other")), value(std::string()), value(array_v::of({})), value(int64_t(-1))}));
  return item_signature(*x->db, node_id(uint32_t(n)));
};

// session base s - version: its elements and signatures - like copies
vm_version(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(tools_host->adopt(x.db, x.root));
};
// after the rounds command there are no shot views of node won (a long session does not save them)
vm_sweep(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  tools_host->session((a[0]).as<int64_t>()).db.sweep_retired();
  return value(int64_t(0));
};
// check: array{ошибка, пересчитано экземпляров (-1 — сам check не прошёл: ошибка — всё), их имена,
// cache
vm_check_facts(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  try {
    auto f = x.check();
    return value(array_v::of({value(f.error), value(int64_t(f.recomputed)), strings_value(f.names), value(int64_t(f.hits))}));
  } catch(diagnostic const & d) {
    return value(array_v::of({value(render(d, x.name, x.db)), value(int64_t(-1)), strings_value({}), value(int64_t(0))}));
  }
};
vm_report(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.last_report; }));
};
// Stdin string for the next run (queue; session stdin - not process stdin)
vm_stdin(i64 s, str line) => native "cpp" {
