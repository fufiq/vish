// Tuling in the language (author's decision 2026-10-20:).
// 
// 
// 
// Tuling modules are built into the assembly, like an editor, and loaded by the team that needs them (programs
// do not see them): tools - general (lines, output, OS, VM session commands), versions - version of the base,
// tests - run tests, cli - run vish. VM has a base: native "cpp" primitives.
//
//
// The chains of one associative operator (a + b + c) are bracketed as in editor.vish.
module tools;

// The repository container is host primitives. The program and the limited AI sample
// don't get that capability; the history decisions are in versions.
repository_storage(i64 s, str op, str key, str text, i64 number, i64 other) => native "cpp" {
  for(auto & v: a) if(!v.known()) return erase(value(array_v::of({value(false), value(std::string()), value(int64_t(0)), value(array_v::of({}))})));
  return repository_primitive(vm, a[0].as<int64_t>(), std::string(a[1].as<str_v>().view()), std::string(a[2].as<str_v>().view()), std::string(a[3].as<str_v>().view()), a[4].as<int64_t>(), a[5].as<int64_t>());
};
// Only copy host data and base operations; repository rules are versions.
repository_catalog(i64 s, modules) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  std::vector<repository_module> out;
  auto const & xs = a[1].as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    auto item = xs.get(k); auto const & row = item.as<array_v>();
    out.push_back({node_id(uint32_t(row.get(0).as<int64_t>())), std::string(row.get(1).as<str_v>().view())});
  }
  host.repository->modules = std::move(out);
  ++host.repository->generation;
  return value(int64_t(0));
};
repository_checkpoint(i64 s, i64 id, str name, i64 parent, i64 second) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  host.db.rollback(0);
  std::vector<uint32_t> parents;
  for(auto k: {3, 4}) if(a[k].as<int64_t>()) parents.push_back(uint32_t(a[k].as<int64_t>()));
  auto & r = *host.repository;
  auto id = uint32_t(a[1].as<int64_t>());
  r.snapshots.push_back({id, std::move(parents), std::string(a[2].as<str_v>().view()), r.modules, host.db.journal().size()});
  r.next_id = id + 1;
  ++r.generation;
  return value(int64_t(id));
};
version_modules(i64 v) => native "cpp" {
  if(!a[0].known()) return erase(value(array_v::of({})));
  std::vector<value> out;
  if(auto * x = tools_host->at(a[0].as<int64_t>())) for(uint32_t k = 0; k < x->db->size(); ++k) {
    node_id m(k);
    if(x->db->is<n_module>(m) && !(*x->db)[m].parent) {
      auto name = x->db->as<n_module>(m).name;
      out.push_back(value(array_v::of({value(int64_t(k)), value(std::string(name ? x->db->strings.text(name) : std::string_view()))})));
    }
  }
  return value(array_v::of(std::move(out)));
};
version_root(i64 v) => native "cpp" {
  if(!a[0].known()) return erase(value(int64_t(-1)));
  auto * x = tools_host->at(a[0].as<int64_t>());
  return value(x ? int64_t(x->root.value) : int64_t(-1));
};
version_module_name(i64 v, i64 n) => native "cpp" {
  if(!a[0].known() || !a[1].known()) return erase(value(std::string()));
  auto * x = tools_host->at(a[0].as<int64_t>());
  node_id n(uint32_t(a[1].as<int64_t>()));
  if(!x || n.value >= x->db->size() || !x->db->is<n_module>(n)) throw diagnostic("не модуль базы", {});
  auto name = x->db->as<n_module>(n).name;
  return value(std::string(name ? x->db->strings.text(name) : std::string_view()));
};
repository_tree(i64 s, i64 v, roots, selected) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  auto * target = tools_host->at(a[1].as<int64_t>());
  if(!target) throw diagnostic("нет версии базы", {});
  std::vector<node_id> roots, selected;
  for(auto [at, out]: {std::pair{2, &roots}, std::pair{3, &selected}}) {
    auto const & xs = a[at].as<array_v>();
    for(uint32_t k = 0; k < xs.size(); ++k) out->push_back(node_id(uint32_t(xs.get(k).as<int64_t>())));
  }
  restore_nodes(host.db, *target->db, roots, selected);
  return value(int64_t(0));
};
repository_clear(i64 s, i64 n) => native "cpp" {
  if(!a[0].known() || !a[1].known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  node_id n(uint32_t(a[1].as<int64_t>()));
  if(n.value >= host.db.size() || !host.db.is<n_module>(n)) throw diagnostic("не модуль базы", {});
  host.db.replace(n, n_module{});
  return value(int64_t(0));
};
repository_attach(i64 s, i64 module, i64 node, i64 at, i64 blank, bool inner) => native "cpp" {
  for(auto & x: a) if(!x.known()) return erase(value(int64_t(0)));
  auto & host = repository_session(vm, a[0].as<int64_t>());
  node_id m(uint32_t(a[1].as<int64_t>())), n(uint32_t(a[2].as<int64_t>()));
  if(m.value >= host.db.size() || !host.db.is<n_module>(m) || n.value >= host.db.size()) throw diagnostic("неверный узел базы", {});
  auto mod = host.db.as<n_module>(m);
  auto old = std::ranges::find(mod.items, n);
  if(old != mod.items.end()) {
    auto at = std::size_t(old - mod.items.begin()); mod.items.erase(old);
    if(at < mod.blank.size()) mod.blank.erase(mod.blank.begin() + at);
  }
  auto at = a[3].as<int64_t>();
  if(at < 0 || uint64_t(at) > mod.items.size()) throw diagnostic("неверное место элемента", {});
  mod.blank.resize(mod.items.size() + 1);
  mod.items.insert(mod.items.begin() + at, n); mod.blank.insert(mod.blank.begin() + at, uint32_t(a[4].as<int64_t>()));
  std::erase(mod.inner, n.value); if(a[5].as<bool>()) mod.inner.push_back(n.value);
  host.db.replace(m, std::move(mod)); host.db.link_parents(m);
  return value(int64_t(0));
};

// The exact structure of the written subtree: comparison, not hash with collisions.
version_structure(i64 v, i64 n) => native "cpp" {
  if(!a[0].known() || !a[1].known()) return erase(value(std::string()));
  auto * x = tools_host->at(a[0].as<int64_t>());
  node_id root{uint32_t(a[1].as<int64_t>())};
  if(!x || root.value >= x->db->size()) return value(std::string());
  writer out;
  auto walk = [&](auto const & self, node_id node) -> void {
    out.put(node);
    out.put((*x->db)[node].kind);
    out.put(x->db->note_of(node) ? *x->db->note_of(node) : node_note{});
    x->db->for_each_child(node, [&](node_id child) { self(self, child); });
  };
  walk(walk, root);
  return value(std::move(out.bytes));
};
version_module_meta(i64 v, i64 n) => native "cpp" {
  if(!a[0].known() || !a[1].known()) return erase(value(std::string()));
  auto * x = tools_host->at(a[0].as<int64_t>());
  node_id n{uint32_t(a[1].as<int64_t>())};
  if(!x || n.value >= x->db->size() || !x->db->is<n_module>(n)) return value(std::string());
  auto mod = x->db->as<n_module>(n);
  uint32_t tail = mod.blank.size() > mod.items.size() ? mod.blank.back() : 0;
  mod.items.clear(); mod.inner.clear(); mod.blank = {tail};
  writer out;
  out.put(mod);
  out.put(x->db->note_of(n) ? *x->db->note_of(n) : node_note{});
  return value(std::move(out.bytes));
};

// --- Primitives: the output of the command (VM) ----------------------------------------------- the
// output of the command (VM) - in stdout and stderr as is (without translating the line)
write_out(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stdout, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};
write_err(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stderr, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};

// --- strings - bytes (§4.0); search, slice, strings and words, order - in language ---
// 
// String - owning bytes without slice; bypass - by indices (s[k], s.size), The only primitive is
// a copy of the range of bytes: assembling bytes by byte through `+` would copy the entire string
// every time (square), the pieces are assembled into an array and glued in pairs (join_texts) -
// without quadratic copying. text_range is my choice of minimum. bytes [from, to] as a new
// string; boundaries on the calling line: 0 <= from <= to <= s.size
//
text_range(str s, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  return value(std::string(v.substr(std::size_t((a[1]).as<int64_t>()), std::size_t((a[2]).as<int64_t>() - (a[1]).as<int64_t>()))));
};
// the place of a part in a row from (from <=s.size); -1 - no
find_from(str s, str part, i64 from) {
  m = part.size;
  if(m == 0) return from;
  c = part[0];
  end = s.size - m;
  k = from;
  loop { if(!(k <= end)) break;
    if(s[k] == c) {
      j = 1;
      loop { if(!((j < m) && (s[k + j] == part[j]))) break; j += 1; }
      if(j == m) return k;
    }
    k += 1;
  }
  -1
}
// place of part in a row; -1 - no
find_text(str s, str part) => find_from(s, part, 0);
// [from, to] bytes; boundaries outside the row are compressed to them
slice_text(str s, i64 from, i64 to) {
  f = if(from < 0) 0 else if(from > s.size) s.size else from;
  t = if(to < f) f else if(to > s.size) s.size else to;
  text_range(s, f, t)
}
// bytetail
text_from(str s, i64 k) => if(k <= 0) s else if(k >= s.size) "" else text_range(s, k, s.size);
// Byte cycles are separate functions over s[k] and s.size: they are compiled by JIT (line - cell
// address, §10.3), and the assembly of pieces (text_range, join_texts) is conducted by the interpreter
// (*my*). place of byte b with from; s.size - no
byte_from(str s, i64 b, i64 from) {
  k = from;
  loop { if(!((k < s.size) && (s[k] != b))) break; k += 1; }
  k
}
// the end of spaces and tabs with from; the end of the word (before the space or tab) with from
blank_end(str s, i64 from) {
  k = from;
  loop { if(!((k < s.size) && ((s[k] == 32) || (s[k] == 9)))) break; k += 1; }
  k
}
word_end(str s, i64 from) {
  k = from;
  loop { if(!((k < s.size) && ((s[k] != 32) && (s[k] != 9)))) break; k += 1; }
  k
}
// Lines of text (without line translations) and line words (through spaces and tabs)
lines_of(str s) {
  r = array{};
  start = 0;
  loop { if(!(start < s.size)) break;
    k = byte_from(s, 10, start);
    r.push(text_range(s, start, k));
    start = k + 1;
  }
  r
}
words_of(str s) {
  r = array{};
  k = 0;
  loop { if(!(k < s.size)) break;
    start = blank_end(s, k);
    k = word_end(s, start);
    if(k > start) r.push(text_range(s, start, k));
  }
  r
}
// order of bytes: a before b (without a sign like memcmp), numbers by value. Byte comparison is the second
// primitive next to text_range: sorting and binary search call it thousands of times, the byte cycle of the
// interpreter on each comparison is editor regression by 40% (*my*, measuring 2026-10-31); order and
// algorithms are in language.
key_less(str a, str b) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(false));
  return value((a[0]).as<str_v>().view() < (a[1]).as<str_v>().view());
};
key_less(i64 a, i64 b) => a < b;
// numbers by ascending keys (lines - bytes, numbers), stable: merging from the bottom up; the passage writes to
// an array of the same size in place o (without pushing on the element - calling the function for each number)
sorted_order(keys) {
  n = keys.size;
  cur = array{};
  k = 0;
  ordered = true;
  loop {
    if(k >= n) break;
    cur.push(k);
    if((k > 0) && ordered) if(key_less(keys[k], keys[k - 1])) ordered = false;
    k += 1;
  }
  if(ordered) return cur;
  nxt = cur;
  w = 1;
  loop { if(!(w < n)) break;
    lo = 0;
    loop { if(!(lo < n)) break;
      mid = if(lo + w < n) lo + w else n;
      hi = if(lo + (2 * w) < n) lo + (2 * w) else n;
      i = lo;
      j = mid;
      o = lo;
      loop { if(!((i < mid) && (j < hi))) break;
        if(key_less(keys[cur[j]], keys[cur[i]])) {
          nxt[o] = cur[j];
          j += 1;
        } else {
          nxt[o] = cur[i];
          i += 1;
        }
        o += 1;
      }
      loop { if(!(i < mid)) break;
        nxt[o] = cur[i];
        i += 1;
        o += 1;
      }
      loop { if(!(j < hi)) break;
        nxt[o] = cur[j];
        j += 1;
        o += 1;
      }
      lo = hi;
    }
    was = cur;
    cur = nxt;
    nxt = was;
    w = w * 2;
  }
  cur
}
sorted_indices(keys) => sorted_order(keys);
sorted_numbers(xs) => sorted_order(xs);

// place in an ordered array: the first, not less than x (binary search); rows - bytes
lower_bound(xs, str x) {
  lo = 0;
  hi = xs.size;
  loop { if(!(lo < hi)) break;
    mid = (lo + hi) / 2;
    if(key_less(xs[mid], x)) lo = mid + 1 else hi = mid;
  }
  lo
}
lower_bound(xs, i64 x) {
  lo = 0;
  hi = xs.size;
  loop { if(!(lo < hi)) break;
    mid = (lo + hi) / 2;
    if(xs[mid] < x) lo = mid + 1 else hi = mid;
  }
  lo
}

// chunks in a row - one line: pairwise fusion, each byte is copied log2(число кусков) times; a pair of k,
// k + 1 is written in place k / 2 of the same copy (the first m is the current row; no push on the piece)
join_texts(xs) {
  if(xs.size == 0) return "";
  if(xs.size == 1) return xs[0];
  if(xs.size == 2) return xs[0] + xs[1];
  cur = xs;
  m = cur.size;
  loop { if(!(m > 1)) break;
    k = 0;
    loop { if(!(k + 1 < m)) break;
      cur[k / 2] = cur[k] + cur[k + 1];
      k += 2;
    }
    if(k < m) cur[k / 2] = cur[k];
    m = (m + 1) / 2;
  }
  cur[0]
}
// the place of the first byte with from, which is screened in the output ("\\n \t); -1 - no
escape_from(str s, i64 from) {
  k = from;
  loop { if(!(k < s.size)) break;
    c = s[k];
    if((c == 34) || ((c == 92) || ((c == 10) || (c == 9)))) return k;
    k += 1;
  }
  -1
}
// the line "as in conclusion": in quotation marks, "\\n \t - shielded
in_quotes(str s) {
  k = escape_from(s, 0);
  if(k < 0) return ("\"" + s) + "\""; // Usually there is nothing to hide - one glue
  parts = array{"\""};
  start = 0;
  loop { if(!(k >= 0)) break;
    c = s[k];
    parts.push(text_range(s, start, k));
    parts.push(if(c == 10) "\\n" else if(c == 9) "\\t" else if(c == 34) "\\\"" else "\\\\");
    start = k + 1;
    k = escape_from(s, start);
  }
  parts.push(text_range(s, start, s.size));
  parts.push("\"");
  join_texts(parts)
}
// Replace all inputs from to (no overlays, left to right)
replace_all(str s, str from, str to) {
  if(from.size == 0) return s;
  at = find_from(s, from, 0);
  if(at < 0) return s;
  parts = array{};
  start = 0;
  loop { if(!(at >= 0)) break;
    parts.push(text_range(s, start, at));
    parts.push(to);
    start = at + from.size;
    at = find_from(s, from, start);
  }
  parts.push(text_range(s, start, s.size));
  join_texts(parts)
}

// --- Primitives: OS for commands (VM) ------------------------------------------------- text of the
// file (as is)
read_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(std::string(os::mapped_file(std::string((a[0]).as<str_v>().view())).text()));
};
// directory files (path - file: it itself)
files_in(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::filesystem::path d((a[0]).as<str_v>().view());
  std::vector<value> xs;
  if(std::filesystem::is_regular_file(d)) xs.push_back(value(d.string()));
  else
    for(auto & e: std::filesystem::directory_iterator(d)) xs.push_back(value(e.path().string()));
  return value(array_v::of(std::move(xs)));
};
// environment variable ("" - no"), ask, remove; processor cores
env_get(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  char const * v = std::getenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(std::string(v ? v : ""));
};
env_set(str name, str v) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  ::setenv(std::string((a[0]).as<str_v>().view()).c_str(), std::string((a[1]).as<str_v>().view()).c_str(), 1);
  return value(int64_t(0));
};
env_unset(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  ::unsetenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(int64_t(0));
};
cpu_count() => native "cpp" { return value(int64_t(std::max(std::thread::hardware_concurrency(), 1u))); };

// --- generalist ---
has_text(xs, str x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
has_number(xs, i64 x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
// number of strings of numbers (not number - 0)
number_of(str s) => parse_int(s).value;
starts_with(str s, str p) => (p.size <= s.size) && (find_text(s, p) == 0);
contains(str s, str p) => find_text(s, p) >= 0;
ends_with(str s, str tail) => (tail.size <= s.size) && (find_text(text_from(s, s.size - tail.size), tail) == 0);
// spaceless
trim_lead(str s) {
  k = 0;
  while((k < s.size) && (s[k] == ' ')) k += 1;
  text_from(s, k)
}
same_lines(xs, ys) {
  if(xs.size != ys.size) return false;
  r = true;
  for(k : range(xs.size)) if(xs[k] != ys[k]) r = false;
  r
}
// The reason is in stderr, code 1
fail(str why) {
  write_err(why + "\n");
  1
}

// --- VM session: commands by rows (vish vm, scripts .session, vish apply) ---------------------------- edit
// function - operation on the base, check recalculates only the affected (§10.1). Line - command and words;
// body edit - to the line "..." VM (session.hpp) has a command base: parsing, execution, database editing,
// live process, data (numbers, program output, text error with place). Solutions - what to replace with
// editing, struct and migrate in a live process, which editing function to apply - and command texts - here
// (user solution 2026-10-22):
//
// 
//.

// Elements of the root module v (-1 - program module): array{number, text, internal, empty lines in front
// of it, comments before it, comment at the end of the line}
version_items(i64 v, i64 root) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(array_v::of({}));
  return value(array_v::of(module_item_facts(*x->db, tools_host->module_of(*x, (a[1]).as<int64_t>()))));
};
// Root element numbers of version v (without text)
version_nodes(i64 v, i64 root) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({value(int64_t(0))})));
  std::vector<value> out;
  if(auto * x = tools_host->at((a[0]).as<int64_t>()))
    if(node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>()))
      for(node_id n: x->db->as<n_module>(m).items) out.push_back(value(int64_t(n.value)));
  return value(array_v::of(std::move(out)));
};
// What is the element n version v: array {вид, имя, части, цель} : fn (parts - parameter types, " " -
// without type), syntax (words form), struct, extend, extend_ref (goal - extensible function), var, other
version_signature(i64 v, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  int64_t n = (a[1]).as<int64_t>();
  if(!x || n < 0 || uint64_t(n) >= x->db->size()) return value(array_v::of({value(std::string("other")), value(std::string()), value(array_v::of({})), value(int64_t(-1))}));
  return item_signature(*x->db, node_id(uint32_t(n)));
};

// session base s - version: its elements and signatures - like copies
vm_version(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(tools_host->adopt(x.db, x.root));
};
// after the rounds command there are no shot views of node won (a long session does not save them)
vm_sweep(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
