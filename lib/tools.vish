  int64_t f = (a[2]).as<int64_t>();
  try {
    auto t = x.proc->helper.types.named(std::string(x.db.strings.text(x.db.as<n_extend>(n).name)));
    return value(array_v::of({value(int64_t(x.proc->migrate_values(t, struct_fields(x.db, n), f < 0 ? node_id{} : node_id(uint32_t(f))))), value(std::string())}));
  } catch(diagnostic const & d) {
    return value(array_v::of({value(int64_t(0)), value(render(d, x.name, x.db))}));
  }
};

// k-word
words_from(xs, i64 k) {
  r = array{};
  for(j : range(xs.size)) if(j >= k) r.push(xs[j]);
  r
}
// Session command s line: conclusion
vm_command(i64 s, str line, str body) {
  out = run_vm_command(s, line, body);
  vm_sweep(s);
  out
}
run_vm_command(i64 s, str line, str body) {
  ws = words_of(line);
  cmd = if(ws.size > 0) ws[0] else "";
  args = words_from(ws, 1);
  if(cmd == "check") return check_command(s);
  if(cmd == "stdin") return vm_stdin(s, if(line.size > 6) text_from(line, 6) else "");
  if(cmd == "report") return vm_report(s);
  if(cmd == "jit") return vm_jit(s);
  if(cmd == "run") return vm_run(s, args);
  if(cmd == "residual") return vm_residual(s, args);
  if(cmd == "fmt") return vm_fmt(s);
  if((cmd == "edit") && (args.size == 1)) return edit_command(s, args[0], body);
  if((cmd == "apply") && (args.size == 1)) return apply_command(s, args[0]);
  if(cmd == "stats") return stats_command(s);
  if(cmd == "roundtrip") return roundtrip_command(s);
  if(cmd == "proc") return proc_command(s, args, line);
  if((cmd == "save") && (args.size == 1)) return save_command(s, args[0]);
  ("неизвестная команда: " + line) + "\n"
}
// comma names ("" - no)
joined(xs) {
  r = "";
  for(x : xs) r = if(r == "") x else (r + ", ") + x;
  r
}
check_command(i64 s) {
  array{error, count, names, hits} = vm_check_facts(s);
  if(count < 0) return error;
  shown = joined(names);
  error + ((((((("check: пересчитано " + text(count)) + " экземпл. (") + (if(shown == "") "—" else shown)) + "), из кэша ") + text(hits)) + "\n"))
}
// Base size and growth from the past stats: edits grow the base to disassemble text, while elaboration,
// parsing recalculation and new interpreters with the same result do not (test 217)
stats_command(i64 s) {
  array{nodes, entries, bytes, was_nodes, was_entries} = vm_stats_facts(s);
  out = ((((((("база: узлов " + text(nodes)) + ", журнал ") + text(entries)) + ", vishdb ") + text(bytes)) + " байт") + "\n");
  if(was_nodes > 0) out = out + ((((("рост: узлов +" + text(nodes - was_nodes)) + ", журнал +") + text(entries - was_entries)) + "\n"));
  out
}
// journal → new base (as .vishdb): same projection and same run output (tests 218, 219)
roundtrip_command(i64 s) {
  array{same, here, there, nodes} = vm_roundtrip_facts(s);
  out = if(same) "" else "roundtrip: проекция отличается\n";
  if(here != there) out = out + (((("roundtrip: вывод отличается: " + in_quotes(there)) + " против ") + in_quotes(here)) + "\n");
  if(out == "") (("roundtrip: совпадает (узлов " + text(nodes)) + ")\n") else out
}
save_command(i64 s, str path) {
  e = vm_save(s, path);
  if(e != "") e else (("сохранено: " + path) + "\n")
}
// Version v is a name function (not a syntax form)
is_fn_named(i64 v, i64 n, str name) {
  array{kind, nm, parts, target} = version_signature(v, n);
  (kind == "fn") && (nm == name)
}
// element n of version v - migrate(tn old)
takes_migrate(i64 v, i64 n, str tn) {
  array{kind, nm, parts, target} = version_signature(v, n);
  (kind == "fn") && ((nm == "migrate") && ((parts.size == 1) && (parts[0] == tn)))
}
// The function of editing the program (code_replace, code_rename, code_remove, code_insert; §7.4): edits -
// to the base, as human editing. Take the function fn without parameters (the last one in the module).
apply_command(i64 s, str fn) {
  v = vm_version(s);
  f = -1;
  for(n : version_nodes(v, -1)) {
    array{kind, nm, parts, target} = version_signature(v, n);
    if((kind == "fn") && ((nm == fn) && (parts.size == 0))) f = n;
  }
  if(f < 0) return (("нет функции правки " + fn) + "() без параметров") + "\n";
  array{count, error} = vm_apply_fn(s, f);
  if(error != "") error else (((("применена " + fn) + ": правок ") + text(count)) + "\n")
}
// Editing the element fn with the body text: function - replaces the first function with this name (the node retains the
// id: ссылки и экземпляры остаются) или добавляется в модуль (меняет набор перегрузок); struct — в
// edit_struct: The text is disassembled by the rules of the function location (§4.4; new, the entire
// module). With a live process - a hot replacement: new calls - in a new version, started frames live in the
// old, ct new body - in place (§9.3). .
//
edit_command(i64 s, str fn, str body) {
  v = vm_version(s);
  items = version_nodes(v, -1);
  at = -1;
  for(n : items) if((at < 0) && is_fn_named(v, n, fn)) at = n;
  array{errors, got} = vm_parse_at(s, at, fn, body);
  if(errors != "") return errors + "правка отклонена\n";
  for(n : got) {
    array{kind, nm, parts, target} = version_signature(v, n);
    if((kind == "struct") && (nm == fn)) return edit_struct(s, v, items, n, got);
  }
  fresh = -1;
  for(n : got) if(is_fn_named(v, n, fn)) fresh = n;
  if(fresh < 0) return (("в тексте правки нет функции " + fn) + "\n");
  if(at >= 0) {
    revision = vm_replace(s, at, fresh);
    if(vm_proc_alive(s)) {
      e = vm_proc_refresh(s);
      if(e != "") return e;
    }
    return ((((("функция " + fn) + " заменена (узел #") + text(at)) + ", ревизия ") + text(revision)) + ")\n";
  }
  items.push(fresh);
  vm_set_items(s, items);
  if(vm_proc_live(s)) vm_proc_register(s, fresh); // Living process sees new overload
  if(vm_proc_alive(s)) {
    e = vm_proc_refresh(s);
    if(e != "") return e;
  }
  ("функция " + fn) + " добавлена\n"
}
// Edit struct: node saves id, fields new. The living values of the old layout are via migrate(T old)
// from the same text (the former migrate of the same type is replaced); no, the edit is rejected. .
//
//
edit_struct(i64 s, i64 v, items, i64 fresh, got) {
  tn = version_signature(v, fresh)[1];
  item = -1;
  for(n : items) {
    array{kind, nm, parts, target} = version_signature(v, n);
    if((kind == "struct") && (nm == tn)) item = n;
  }
  if(item < 0) return (("нет struct " + tn) + "\n");
  mig = -1;
  for(n : got) if(takes_migrate(v, n, tn)) mig = n;
  alive = vm_proc_alive(s);
  stale = if(alive) vm_proc_stale(s, fresh) else 0;
  // without migrate - autotransfer as a record → struct (O8) if it does not lose or invent data
  auto = (stale > 0) && (mig < 0);
  if(auto) {
    why = vm_proc_auto(s, fresh, false);
    if(why != "")
      return ((((((((((("правка отклонена: живой процесс держит значений " + tn) + " старой раскладки: ") + text(stale)) + " — ") + why) + "(") + tn) + " old) => ") + tn) + "{…} в том же тексте (или proc stop)") + "\n");
  }
  vm_replace(s, item, fresh);
  kept = array{};
  for(n : items) if((mig < 0) || !takes_migrate(v, n, tn)) kept.push(n);
  if(mig >= 0) kept.push(mig);
  revision = vm_set_items(s, kept);
  out = ((((("struct " + tn) + " заменена (узел #") + text(item)) + ", ревизия ") + text(revision)) + ")\n";
  if(!alive) return out;
  if(mig >= 0) { // overload migrate in the assistant - as in the module
    vm_proc_clear(s, "migrate");
    for(n : kept) if(is_fn_named(v, n, "migrate")) vm_proc_register(s, n);
  }
  if(auto) {
    why = vm_proc_auto(s, item, true);
    if(why != "") return why;
    out = out + (("перенесено автоматически: " + text(stale)) + "\n");
  } else if(stale > 0) {
    array{moved, error} = vm_proc_migrate(s, item, mig);
    if(error != "") return error;
    out = out + (("перенесено migrate: " + text(moved)) + "\n");
  }
  out
}
// proc...: living process of the machine (§9.3)
proc_command(i64 s, args, str line) {
  sub = if(args.size > 0) args[0] else "";
  if(sub == "start") {
    e = vm_proc_start(s, words_from(args, 1));
    if(e != "") return e;
    return "процесс запущен\n";
  }
  if(!vm_proc_live(s)) return "нет живого процесса: proc start\n";
  if((sub == "step") || (sub == "run")) return vm_proc_step(s, if(sub == "run") -1 else (if(args.size > 1) number_of(args[1]) else 1));
  if(sub == "where") return vm_proc_where(s);
  if(((sub == "grant") || (sub == "revoke")) && (args.size == 2)) { // "You give."
    e = vm_proc_grant(s, args[1], sub == "grant");
    if(e != "") return e;
    return ((if(sub == "grant") "дано: " else "забрано: ") + args[1]) + "\n";
  }
  if(sub == "pressure") { //  
    array{handlers, error} = vm_proc_pressure(s);
    if(error != "") return error;
    return ("давление: обработчиков " + text(handlers)) + "\n";
  }
  if(sub == "stop") {
    vm_proc_stop(s);
    return "процесс завершён\n";
  }
  if(sub == "call") {
    if(!vm_proc_alive(s)) return "процесс завершён: пробовать нечего\n";
    return vm_proc_call(s, text_from(line, find_text(line, "call") + 4));
  }
  "proc: start, step N, run, where, call <выражение>, pressure, grant/revoke fs|net, stop\n"
}
