  std::vector<value> out;
  for(uint64_t k: r) out.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(out)));
};
// journal → new base: array{projection same, output run here, there, nodes in the new}
vm_roundtrip_facts(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & x = tools_host->session((a[0]).as<int64_t>());
