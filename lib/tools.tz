// Тулинг на языке (решение автора 2026-10-20:). 
// 
// 
// 
// Модули тулинга встроены в сборку, как editor, и грузятся
// командой, которой нужны (программы их не видят): tools — общее (строки, вывод, ОС, команды
// сессии VM), versions — версии базы, tests — прогон тестов, cli — строка запуска tz. У VM — база:
// примитивы native "cpp".
//
// Цепочки одного ассоциативного оператора (a + b + c) — скобками, как в editor.tz.
module tools;

// --- примитивы: вывод команды (у VM) --------------------------------------------------------
// текст — в stdout и stderr как есть (без перевода строки)
write_out(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stdout, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};
write_err(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stderr, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};

// --- примитивы: строки — байты (§4.0); поиск, срез, строки и слова, порядок — база ------------
// место части в строке; -1 — нет
find_text(str s, str part) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto at = (a[0]).as<str_v>().view().find((a[1]).as<str_v>().view());
  return value(at == std::string_view::npos ? int64_t(-1) : int64_t(at));
};
// байты [from, to)
slice_text(str s, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t f = std::size_t(std::clamp<int64_t>((a[1]).as<int64_t>(), 0, int64_t(v.size()))), t = std::size_t(std::clamp<int64_t>((a[2]).as<int64_t>(), int64_t(f), int64_t(v.size())));
  return value(std::string(v.substr(f, t - f)));
};
// хвост строки с байта k
text_from(str s, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t k = std::size_t(std::max<int64_t>(0, (a[1]).as<int64_t>()));
  return value(std::string(k < v.size() ? v.substr(k) : std::string_view()));
};
// строки текста (без переводов строки) и слова строки (через пробелы)
lines_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto l: lines_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(l)));
  return value(array_v::of(std::move(xs)));
};
words_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto w: words_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(w)));
  return value(array_v::of(std::move(xs)));
};
// порядок строк: номера по возрастанию ключей (сравнение байтов, устойчиво)
sorted_indices(keys) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & ks = (a[0]).as<array_v>();
  std::vector<uint32_t> order(ks.size());
  for(uint32_t k = 0; k < ks.size(); ++k) order[k] = k;
  std::ranges::stable_sort(order, [&](uint32_t x, uint32_t y) { return ks.get(x).as<str_v>().view() < ks.get(y).as<str_v>().view(); });
  std::vector<value> xs;
  for(uint32_t k: order) xs.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(xs)));
};

// место в упорядоченном массиве: первое, не меньшее x (двоичный поиск — примитив базы); строки —
// по байтам
lower_bound(xs, str x) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto const & xs = (a[0]).as<array_v>();
  auto x = (a[1]).as<str_v>().view();
  uint32_t lo = 0, hi = xs.size();
  while(lo < hi) {
    uint32_t mid = (lo + hi) / 2;
    if(xs.get(mid).as<str_v>().view() < x) lo = mid + 1;
    else hi = mid;
  }
  return value(int64_t(lo));
};
lower_bound(xs, i64 x) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto const & xs = (a[0]).as<array_v>();
  int64_t x = (a[1]).as<int64_t>();
  uint32_t lo = 0, hi = xs.size();
  if(xs.kind() == array_v::layout::ints) {
    int64_t const * d = xs.ints();
    while(lo < hi) {
      uint32_t mid = (lo + hi) / 2;
      if(d[mid] < x) lo = mid + 1;
      else hi = mid;
    }
  } else
    while(lo < hi) {
      uint32_t mid = (lo + hi) / 2;
      if(xs.get(mid).as<int64_t>() < x) lo = mid + 1;
      else hi = mid;
    }
  return value(int64_t(lo));
};

// строка «как в выводе»: в кавычках, " \\ \\n \\t — экранированы
in_quotes(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(in_quotes((a[0]).as<str_v>().view()));
};
// куски подряд — одной строкой
join_texts(xs) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto const & ps = (a[0]).as<array_v>();
  std::size_t n = 0;
  for(uint32_t k = 0; k < ps.size(); ++k) n += ps.r().items[k].as<str_v>().view().size();
  std::string out;
  out.reserve(n);
  for(uint32_t k = 0; k < ps.size(); ++k) out += ps.r().items[k].as<str_v>().view();
  return value(std::move(out));
};
// заменить все вхождения from на to
replace_all(str s, str from, str to) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(std::string()));
  std::string t((a[0]).as<str_v>().view());
  auto f = (a[1]).as<str_v>().view();
  auto r = (a[2]).as<str_v>().view();
  if(f.empty()) return value(std::move(t));
  for(std::size_t k = 0; (k = t.find(f, k)) != std::string::npos; k += r.size()) t.replace(k, f.size(), r);
  return value(std::move(t));
};
// порядок чисел: номера по возрастанию
sorted_numbers(xs) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & ks = (a[0]).as<array_v>();
  std::vector<uint32_t> order(ks.size());
  for(uint32_t k = 0; k < ks.size(); ++k) order[k] = k;
  std::ranges::stable_sort(order, [&](uint32_t x, uint32_t y) { return ks.get(x).as<int64_t>() < ks.get(y).as<int64_t>(); });
  std::vector<value> out;
  for(uint32_t k: order) out.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(out)));
};

// --- примитивы: ОС для команд (у VM) --------------------------------------------------------
// текст файла (как есть)
read_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(std::string(os::mapped_file(std::string((a[0]).as<str_v>().view())).text()));
};
// файлы каталога (путь — файл: он сам)
files_in(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::filesystem::path d((a[0]).as<str_v>().view());
  std::vector<value> xs;
  if(std::filesystem::is_regular_file(d)) xs.push_back(value(d.string()));
  else
    for(auto & e: std::filesystem::directory_iterator(d)) xs.push_back(value(e.path().string()));
  return value(array_v::of(std::move(xs)));
};
// переменная окружения ("" — нет), задать, убрать; ядер процессора
env_get(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  char const * v = std::getenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(std::string(v ? v : ""));
};
env_set(str name, str v) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  ::setenv(std::string((a[0]).as<str_v>().view()).c_str(), std::string((a[1]).as<str_v>().view()).c_str(), 1);
  return value(int64_t(0));
};
env_unset(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  ::unsetenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(int64_t(0));
};
cpu_count() => native "cpp" { return value(int64_t(std::max(std::thread::hardware_concurrency(), 1u))); };

// --- общие помощники ------------------------------------------------------------------------
has_text(xs, str x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
has_number(xs, i64 x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
// число строки цифр (не число — 0)
number_of(str s) => parse_int(s).value;
starts_with(str s, str p) => (p.size <= s.size) && (find_text(s, p) == 0);
contains(str s, str p) => find_text(s, p) >= 0;
ends_with(str s, str tail) => (tail.size <= s.size) && (find_text(text_from(s, s.size - tail.size), tail) == 0);
// без пробелов в начале
trim_lead(str s) {
  k = 0;
  while((k < s.size) && (s[k] == ' ')) k += 1;
  text_from(s, k)
}
same_lines(xs, ys) {
  if(xs.size != ys.size) return false;
  r = true;
  for(k : range(xs.size)) if(xs[k] != ys[k]) r = false;
  r
}
// причина — в stderr, код 1
fail(str why) {
  write_err(why + "\n");
  1
}

// --- сессия VM: команды строками (tz vm, сценарии .session, tz apply) -------------------------
// правка функции — операция над базой, check
// пересчитывает только затронутое (§10.1). Строка — команда и слова; тело edit — до строки «.».
// Сами команды — у VM (session.hpp); ошибка — текстом с местом.
vm_check(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.check(); }));
};
vm_report(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.last_report; }));
};
// строка stdin для следующих run (очередь; stdin сессии — не stdin процесса)
vm_stdin(i64 s, str line) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] {
    x.stdin_lines.emplace_back((a[1]).as<str_v>().view());
    return std::string();
  }));
};
vm_jit(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.jit.stats(); }));
};
vm_run(i64 s, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  auto args = strings_of(a[1]);
  return value(x.guarded([&] { return x.run(args); }));
};
vm_residual(i64 s, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  auto args = strings_of(a[1]);
  return value(x.guarded([&] { return x.residual(args); }));
};
vm_fmt(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return printer(x.db).print(x.root); }));
};
vm_edit(i64 s, str fn, str body) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string fn((a[1]).as<str_v>().view()), body((a[2]).as<str_v>().view());
  return value(x.guarded([&] { return x.edit(fn, body); }));
};
vm_apply(i64 s, str fn) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string fn((a[1]).as<str_v>().view());
  return value(x.guarded([&] { return x.apply(fn); }));
};
vm_save(i64 s, str path) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string path((a[1]).as<str_v>().view());
  return value(x.guarded([&] {
    save_db(x.db, x.root, path);
    return cat("сохранено: ", path, "\n");
  }));
};
vm_stats(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.stats(); }));
};
vm_roundtrip(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.roundtrip(); }));
};
// живой процесс машины (§9.3): есть ли; запустить; шаги (n < 0 — до конца); где; ресурс дать или
// забрать; давление; завершить; проба выражения в клоне (fork)
vm_proc_live(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(tools_host->session((a[0]).as<int64_t>()).proc != nullptr);
};
vm_proc_start(i64 s, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  auto args = strings_of(a[1]);
  return value(x.guarded([&] { return x.proc_start(args); }));
};
vm_proc_step(i64 s, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  int64_t n = (a[1]).as<int64_t>();
  return value(x.guarded([&] { return x.proc_step(n < 0 ? ~uint64_t{0} : uint64_t(n)); }));
};
vm_proc_where(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.proc->where_now(); }));
};
vm_proc_grant(i64 s, str what, bool give) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string what((a[1]).as<str_v>().view());
  bool give = (a[2]).as<bool>();
  return value(x.guarded([&] { return x.proc_grant(what, give); }));
};
vm_proc_pressure(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] { return x.proc_pressure(); }));
};
vm_proc_stop(i64 s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  return value(x.guarded([&] {
    x.proc.reset();
    return std::string("процесс завершён\n");
  }));
};
vm_proc_call(i64 s, str expr) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & x = tools_host->session((a[0]).as<int64_t>());
  std::string expr((a[1]).as<str_v>().view());
  return value(x.guarded([&] { return x.probe(expr); }));
};
// слова с номера k
words_from(xs, i64 k) {
  r = array{};
  for(j : range(xs.size)) if(j >= k) r.push(xs[j]);
  r
}
// Команда сессии s строкой: вывод
vm_command(i64 s, str line, str body) {
  ws = words_of(line);
  cmd = if(ws.size > 0) ws[0] else "";
  args = words_from(ws, 1);
  if(cmd == "check") return vm_check(s);
  if(cmd == "stdin") return vm_stdin(s, if(line.size > 6) text_from(line, 6) else "");
  if(cmd == "report") return vm_report(s);
  if(cmd == "jit") return vm_jit(s);
  if(cmd == "run") return vm_run(s, args);
  if(cmd == "residual") return vm_residual(s, args);
  if(cmd == "fmt") return vm_fmt(s);
  if((cmd == "edit") && (args.size == 1)) return vm_edit(s, args[0], body);
  if((cmd == "apply") && (args.size == 1)) return vm_apply(s, args[0]);
  if(cmd == "stats") return vm_stats(s);
  if(cmd == "roundtrip") return vm_roundtrip(s);
  if(cmd == "proc") return proc_command(s, args, line);
  if((cmd == "save") && (args.size == 1)) return vm_save(s, args[0]);
  ("неизвестная команда: " + line) + "\n"
}
// proc …: живой процесс машины (§9.3)
proc_command(i64 s, args, str line) {
  sub = if(args.size > 0) args[0] else "";
  if(sub == "start") return vm_proc_start(s, words_from(args, 1));
  if(!vm_proc_live(s)) return "нет живого процесса: proc start\n";
  if((sub == "step") || (sub == "run")) return vm_proc_step(s, if(sub == "run") -1 else (if(args.size > 1) number_of(args[1]) else 1));
  if(sub == "where") return vm_proc_where(s);
  if(((sub == "grant") || (sub == "revoke")) && (args.size == 2)) return vm_proc_grant(s, args[1], sub == "grant");
  if(sub == "pressure") return vm_proc_pressure(s);
  if(sub == "stop") return vm_proc_stop(s);
  if(sub == "call") return vm_proc_call(s, text_from(line, find_text(line, "call") + 4));
  "proc: start, step N, run, where, call <выражение>, pressure, grant/revoke fs|net, stop\n"
}

