// Тулинг на языке (решение автора 2026-10-20:). 
// 
// 
// 
// Модуль встроен в сборку, как editor; его грузят команды tz и
// сервер редактора (editor — use tools), программы его не видят. У VM — база: версии базы (копии по
// журналам), элементы модуля данными, разбор элемента на месте, вывод — примитивы native "cpp".
//
// Цепочки одного ассоциативного оператора (a + b + c) — скобками, как в editor.tz.
module tools;

// --- примитивы: версии базы (у VM) ----------------------------------------------------------
// Версия — копия базы по журналу .tzdb; номер 0 — база, с которой работают (программа сессии
// редактора), у команды tz — пусто. Общее начало журналов двух версий — их общая база.

// копия по файлу; -1 — не открылась (version_error — почему)
version_open(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->open(std::string((a[0]).as<str_v>().view())));
};
version_error() => native "cpp" { return value(tools_host->error); };
// общая база версий a и b (корень — корень a)
version_base(i64 a, i64 b) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->base((a[0]).as<int64_t>(), (a[1]).as<int64_t>()));
};
// копия больше не нужна
version_close(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  tools_host->close((a[0]).as<int64_t>());
  return value(int64_t(0));
};
// Элементы модуля root версии v (-1 — модуль программы): array{номер, текст, внутренний, пустых
// строк перед ним, комментарии перед ним, комментарий в конце строки}
version_items(i64 v, i64 root) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(array_v::of({}));
  return value(array_v::of(module_item_facts(*x->db, tools_host->module_of(*x, (a[1]).as<int64_t>()))));
};
// что за элемент n версии v: array{вид, имя, части, цель}: fn (части — типы параметров, «_» — без
// типа), syntax (слова формы), struct, extend, extend_ref (цель — расширяемая функция), var, other
version_signature(i64 v, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  int64_t n = (a[1]).as<int64_t>();
  if(!x || n < 0 || uint64_t(n) >= x->db->size()) return value(array_v::of({value(std::string("other")), value(std::string()), value(array_v::of({})), value(int64_t(-1))}));
  return item_signature(*x->db, node_id(uint32_t(n)));
};
// Элемент модуля root версии v — текстом, разбором по правилам его места (§4.4): mine — заменить
// его (узел сохраняет id), -1 — новый после after (-1 — в конец); раскладка — пустые строки,
// внутренний, комментарии. Итог — номер элемента; не разобрался — -1.
version_put(i64 v, i64 root, i64 mine, str text, str name, i64 after, i64 blank, bool inner, lead, str tail) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(-1)));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(int64_t(-1));
  node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>());
  if(!m) return value(int64_t(-1));
  auto num = [](value const & v) { return v.as<int64_t>() < 0 ? node_id{} : node_id(uint32_t(v.as<int64_t>())); };
  node_note note;
  for(uint32_t k = 0; k < (a[8]).as<array_v>().size(); ++k) note.lead.emplace_back((a[8]).as<array_v>().get(k).as<str_v>().view());
  note.tail = std::string((a[9]).as<str_v>().view());
  node_id got = put_item(*x->db, m, num(a[2]), std::string((a[3]).as<str_v>().view()), std::string((a[4]).as<str_v>().view()), num(a[5]), uint32_t((a[6]).as<int64_t>()), (a[7]).as<bool>(), std::move(note));
  return value(got ? int64_t(got.value) : int64_t(-1));
};
// убрать элемент n модуля root версии v
version_remove(i64 v, i64 root, i64 n) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(int64_t(0));
  if(node_id m = tools_host->module_of(*x, (a[1]).as<int64_t>()); m && (a[2]).as<int64_t>() >= 0) remove_item(*x->db, m, node_id(uint32_t((a[2]).as<int64_t>())));
  return value(int64_t(0));
};
// журнал версии v — в файл .tzdb; "" — записан, иначе ошибка
version_save(i64 v, str path) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto * x = tools_host->at((a[0]).as<int64_t>());
  if(!x) return value(std::string("нет версии"));
  try {
    save_db(*x->db, x->root, std::string((a[1]).as<str_v>().view()));
  } catch(std::exception const & e) {
    return value(std::string(e.what()));
  }
  return value(std::string());
};

// --- примитивы: вывод команды (у VM) --------------------------------------------------------
// текст — в stdout и stderr как есть (без перевода строки)
write_out(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stdout, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};
write_err(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  put(stderr, (a[0]).as<str_v>().view());
  return value(int64_t(0));
};

// --- примитивы: строки — байты (§4.0); поиск, срез, строки и слова, порядок — база ------------
// место части в строке; -1 — нет
find_text(str s, str part) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto at = (a[0]).as<str_v>().view().find((a[1]).as<str_v>().view());
  return value(at == std::string_view::npos ? int64_t(-1) : int64_t(at));
};
// байты [from, to)
slice_text(str s, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t f = std::size_t(std::clamp<int64_t>((a[1]).as<int64_t>(), 0, int64_t(v.size()))), t = std::size_t(std::clamp<int64_t>((a[2]).as<int64_t>(), int64_t(f), int64_t(v.size())));
  return value(std::string(v.substr(f, t - f)));
};
// хвост строки с байта k
text_from(str s, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t k = std::size_t(std::max<int64_t>(0, (a[1]).as<int64_t>()));
  return value(std::string(k < v.size() ? v.substr(k) : std::string_view()));
};
// строки текста (без переводов строки) и слова строки (через пробелы)
lines_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto l: lines_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(l)));
  return value(array_v::of(std::move(xs)));
};
words_of(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto w: words_of((a[0]).as<str_v>().view())) xs.push_back(value(std::string(w)));
  return value(array_v::of(std::move(xs)));
};
// порядок строк: номера по возрастанию ключей (сравнение байтов, устойчиво)
sorted_indices(keys) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & ks = (a[0]).as<array_v>();
  std::vector<uint32_t> order(ks.size());
  for(uint32_t k = 0; k < ks.size(); ++k) order[k] = k;
  std::ranges::stable_sort(order, [&](uint32_t x, uint32_t y) { return ks.get(x).as<str_v>().view() < ks.get(y).as<str_v>().view(); });
  std::vector<value> xs;
  for(uint32_t k: order) xs.push_back(value(int64_t(k)));
  return value(array_v::of(std::move(xs)));
};

// --- примитивы: ОС для команд (у VM) --------------------------------------------------------
// текст файла (как есть)
read_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(std::string(os::mapped_file(std::string((a[0]).as<str_v>().view())).text()));
};
// файлы каталога (путь — файл: он сам)
files_in(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::filesystem::path d((a[0]).as<str_v>().view());
  std::vector<value> xs;
  if(std::filesystem::is_regular_file(d)) xs.push_back(value(d.string()));
  else
    for(auto & e: std::filesystem::directory_iterator(d)) xs.push_back(value(e.path().string()));
  return value(array_v::of(std::move(xs)));
};
// переменная окружения ("" — нет), задать, убрать; ядер процессора
env_get(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  char const * v = std::getenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(std::string(v ? v : ""));
};
env_set(str name, str v) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  ::setenv(std::string((a[0]).as<str_v>().view()).c_str(), std::string((a[1]).as<str_v>().view()).c_str(), 1);
  return value(int64_t(0));
};
env_unset(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  ::unsetenv(std::string((a[0]).as<str_v>().view()).c_str());
  return value(int64_t(0));
};
cpu_count() => native "cpp" { return value(int64_t(std::max(std::thread::hardware_concurrency(), 1u))); };

// --- общие помощники ------------------------------------------------------------------------
has_text(xs, str x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
has_number(xs, i64 x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
// число строки цифр (не число — 0)
number_of(str s) => parse_int(s).value;
starts_with(str s, str p) => (p.size <= s.size) && (find_text(s, p) == 0);
contains(str s, str p) => find_text(s, p) >= 0;
ends_with(str s, str tail) => (tail.size <= s.size) && (find_text(text_from(s, s.size - tail.size), tail) == 0);
// без пробелов в начале
trim_lead(str s) {
  k = 0;
  while((k < s.size) && (s[k] == ' ')) k += 1;
  text_from(s, k)
}
// «как в выводе»: в кавычках, \" \\ \n \t — экранированы
in_quotes(str s) {
  r = "\"";
  from = 0;
  for(k : range(s.size)) {
    c = s[k];
    esc = if(c == '"') "\\\"" else if(c == '\\') "\\\\" else if(c == '\n') "\\n" else if(c == '\t') "\\t" else "";
    if(esc != "") {
      r = (r + slice_text(s, from, k)) + esc;
      from = k + 1;
    }
  }
  (r + text_from(s, from)) + "\""
}
same_lines(xs, ys) {
  if(xs.size != ys.size) return false;
  r = true;
  for(k : range(xs.size)) if(xs[k] != ys[k]) r = false;
  r
}

// --- версии базы: семантический дифф и трёхстороннее слияние (§9.4) --------------------------
//  
//  — живая правка через VM конфликтов не даёт. Копии базы
// расходятся, только когда работа шла в двух местах; тогда 
// 
// 
// База — версии и их элементы; решение (что чьё, что берётся само, где конфликт) — здесь.
// Дифф и слияние — по элементам модуля: функция опознаётся по имени и сигнатуре, а не по строкам.

// Элемент модуля в версии: кто он (id — номер узла, если элемент был в общей базе: смена сигнатуры
// — правка того же элемента; иначе — ключ), как называется (key), какой он (текст проекции) и его
// раскладка: внутренний (§13.3), пустые строки перед ним, комментарии, сосед перед ним (after — его
// id):   — элемент переносится со всем, что у него есть.
struct item { bool present; i64 node; str id; str key; str text; bool inner; i64 blank; array lead; str tail; str after; }
no_item() => item{false, -1, "", "", "", false, 0, array{}, "", ""};

// Ключ элемента: функция — имя и типы параметров, syntax — слова записи формы, struct, расширения,
// переменная — имя; прочее — сам текст.
item_key(i64 v, i64 n, str shown) {
  array{kind, name, parts, target} = version_signature(v, n);
  if(kind == "syntax") {
    k = "syntax";
    for(p : parts) k = (k + " ") + p;
    return k;
  }
  if(kind == "fn") {
    k = name + "(";
    for(j : range(parts.size)) k = (k + (if(j > 0) ", " else "")) + parts[j];
    return k + ")";
  }
  if(kind == "struct") return "struct " + name;
  if(kind == "extend_ref") return ("&" + item_key(v, target, "")) + " { … }";
  if(kind == "extend") return name + " { … }";
  if(kind == "var") return name;
  shown
}
// Элементы модуля root версии v (-1 — модуль программы); base_items — номера элементов общей базы.
module_items(i64 v, i64 root, base_items) {
  found = array{};
  prev = "";
  for(x : version_items(v, root)) {
    array{n, shown, inner, blank, lead, tail} = x;
    first = item_key(v, n, shown);
    key = first;
    j = 2;
    while(find_item(found, key).present) {
      key = (first + " #") + text(j);
      j += 1;
    }
    id = if(has_number(base_items, n)) "#" + text(n) else key;
    found.push(item{true, n, id, key, shown, inner, blank, lead, tail, prev});
    prev = id;
  }
  found
}
find_item(xs, str id) {
  r = no_item();
  for(x : xs) if(!r.present && (x.id == id)) r = x;
  r
}
find_key(xs, str key) {
  r = no_item();
  for(x : xs) if(!r.present && (x.key == key)) r = x;
  r
}
// что сравнивает слияние: текст и раскладка (элемента нет — тоже состояние)
same_state(item x, item y) {
  if(x.present != y.present) return false;
  if(!x.present) return true;
  (x.text == y.text) && ((x.inner == y.inner) && ((x.blank == y.blank) && ((x.tail == y.tail) && same_lines(x.lead, y.lead))))
}

// Заменить (или добавить, или убрать) элемент id модуля root версии v их элементом: текст — разбором
// на месте элемента (§4.4), раскладка — как у них; новый — после того же соседа, что у них (нет его
// — в конец). Итог — номер элемента (-1 — убран или не разобрался).
take_theirs(i64 v, i64 root, base_items, str id, item theirs) {
  items = module_items(v, root, base_items);
  mine = find_item(items, id);
  if(!theirs.present) {
    if(mine.present) version_remove(v, root, mine.node);
    return -1;
  }
  prev = find_item(items, theirs.after);
  version_put(v, root, if(mine.present) mine.node else -1, theirs.text, id, if(prev.present) prev.node else -1, theirs.blank, theirs.inner, theirs.lead, theirs.tail)
}

// Конфликт — оба варианта человеку: текст общей базы, мой, их (пусто — элемента в версии нет) и их
// элемент с раскладкой — для «взять их».
struct conflict { str id; str key; str base; str mine; str theirs; item their; }
struct merge_result { array taken; array conflicts; array base_items; }
no_merge() => merge_result{array{}, array{}, array{}};

// Трёхстороннее слияние их версии в мою (mine меняется на месте): изменённое только у них берётся
// само, у обоих по-разному — конфликт.
merge_versions(i64 mine, i64 theirs) {
  bv = version_base(mine, theirs);
  base_items = array{};
  for(x : version_items(bv, -1)) base_items.push(x[0]);
  b = module_items(bv, -1, base_items);
  m = module_items(mine, -1, base_items);
  t = module_items(theirs, -1, base_items);
  version_close(bv);
  ids = array{};
  for(x : b) if(!has_text(ids, x.id)) ids.push(x.id);
  for(x : m) if(!has_text(ids, x.id)) ids.push(x.id);
  for(x : t) if(!has_text(ids, x.id)) ids.push(x.id);
  r = no_merge();
  r.base_items = base_items;
  for(id : ids) {
    bi = find_item(b, id);
    mi = find_item(m, id);
    ti = find_item(t, id);
    name = if(mi.present) mi.key else if(ti.present) ti.key else bi.key;
    if(!same_state(mi, ti) && !same_state(ti, bi)) { // совпало или у них без изменений — нечего
      if(same_state(mi, bi)) { // изменено только у них — берётся само
        take_theirs(mine, -1, base_items, id, ti);
        r.taken.push(name);
      } else r.conflicts.push(conflict{id, name, bi.text, mi.text, ti.text, ti});
    }
  }
  r
}

// Двусторонний дифф: что в b иначе, чем в a (по элементам модуля).
diff_versions(i64 a, i64 b) {
  xa = module_items(a, -1, array{});
  xb = module_items(b, -1, array{});
  r = "";
  for(x : xa) {
    y = find_key(xb, x.key);
    if(!y.present) r = r + (("- " + x.key) + "\n");
    else if(y.text != x.text) r = r + ((((((("~ " + x.key) + "\n  было:  ") + x.text) + "\n  стало: ") + y.text) + "\n"));
    else if(!same_state(x, y)) r = r + (("~ " + x.key) + " — раскладка (внутренний, пустые строки, комментарий)\n");
  }
  for(y : xb) if(!find_key(xa, y.key).present) r = r + (((("+ " + y.key) + "\n  ") + y.text) + "\n");
  if(r == "") "без различий\n" else r
}

// --- команды tz: diff, merge ------------------------------------------------------------------
fail(str why) {
  write_err(why + "\n");
  1
}
// tz diff a.tzdb b.tzdb — семантический дифф баз
diff_files(str a, str b) {
  va = version_open(a);
  if(va < 0) return fail(version_error());
  vb = version_open(b);
  if(vb < 0) return fail(version_error());
  write_out(diff_versions(va, vb));
  0
}
// tz merge мой.tzdb их.tzdb [итог.tzdb] — трёхстороннее слияние; конфликты — мой вариант, код 1
merge_files(str mine, str theirs, str result) {
  mv = version_open(mine);
  if(mv < 0) return fail(version_error());
  tv = version_open(theirs);
  if(tv < 0) return fail(version_error());
  r = merge_versions(mv, tv);
  for(k : r.taken) write_out(("взято у них: " + k) + "\n");
  for(c : r.conflicts) write_out(((((((("конфликт: " + c.key) + "\n  база: ") + dash(c.base)) + "\n  мой:  ") + dash(c.mine)) + "\n  их:   ") + dash(c.theirs)) + "\n");
  why = version_save(mv, result);
  if(why != "") return fail(why);
  write_out((("записано: " + result) + (if(r.conflicts.size == 0) "" else " (конфликты — мой вариант; слить руками)")) + "\n");
  if(r.conflicts.size == 0) 0 else 1
}
dash(str s) => if(s == "") "—" else s;

// --- прогон тестов: tz test <каталог> [--a64 | --projection k] -------------------------------
// 
//   — движки сверяются друг с другом (интерпретатор,
// JIT, AArch64, машина процессов);. Тест —
// программа .tz с директивами в шапке, сценарий сессии VM (.session) или протокола редактора
// (.wire). Здесь — директивы, сверки, тексты причин, порядок и параллельность; движки, каталоги
// состояния, дети (fork) и сценарии — примитивы VM.

// примитивы прогона (у VM): программа теста, её печать, движки
test_load(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tests_host->load(std::string((a[0]).as<str_v>().view())));
};
test_close(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  tests_host->close((a[0]).as<int64_t>());
  return value(int64_t(0));
};
// текст, ошибки разбора (текстом), разобрана ли, каталог
test_source(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(tests_host->at((a[0]).as<int64_t>()).src);
};
test_errors(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(tests_host->at((a[0]).as<int64_t>()).errors);
};
test_parsed(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(tests_host->at((a[0]).as<int64_t>()).parsed);
};
test_dir_of(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(tests_host->at((a[0]).as<int64_t>()).dir.string());
};
// каноническая проекция; после элаборации (tz fmt --ct): array{удалось, текст или ошибка}
test_print(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = tests_host->at((a[0]).as<int64_t>());
  return value(printer(x.db).print(x.root));
};
test_elaborated(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & x = tests_host->at((a[0]).as<int64_t>());
  try {
    return value(array_v::of({value(true), value(elaborated_text(x.db, x.root, x.name))}));
  } catch(diagnostic const & d) {
    return value(array_v::of({value(false), value(render(d, x.name, x.db))}));
  }
};
// Текст программы (не файл) — разбор с модулями в каталоге dir и печать: по умолчанию или в проекции
// key (header — с `use key;`): array{есть модуль проекции, текст}; разбор и дамп дерева: array{первая
// ошибка, дамп}
print_text(str text, str dir, str key, bool header) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto [ok, t] = print_text(std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view()), std::string((a[2]).as<str_v>().view()), (a[3]).as<bool>());
  return value(array_v::of({value(ok), value(std::move(t))}));
};
parse_dump(str text, str dir, str name) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto [e, d] = parse_dump(std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view()), std::string((a[2]).as<str_v>().view()));
  return value(array_v::of({value(std::move(e)), value(std::move(d))}));
};
// каталог состояния программы (§12.2) — свежий на каждое исполнение; убрать все
state_fresh() => native "cpp" {
  tests_host->states.fresh();
  return value(int64_t(0));
};
state_clear() => native "cpp" {
  tests_host->states.clear();
  return value(int64_t(0));
};
// Интерпретатором: array{вывод, ошибка, экземпляры}; с JIT (a64 — и код AArch64 в qemu):
// array{вывод, ошибка, статистика JIT}; AArch64 последнего запуска: array{проверено, не проверено,
// заметки, расхождения}
test_run(i64 p, args, input) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto r = tests_host->run((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]));
  return value(array_v::of({value(r[0]), value(r[1]), value(r[2])}));
};
test_run_jit(i64 p, args, input, bool a64) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto r = tests_host->run_jit((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]), (a[3]).as<bool>());
  return value(array_v::of({value(r[0]), value(r[1]), value(r[2])}));
};
a64_last() => native "cpp" {
  auto & h = *tests_host;
  return value(array_v::of({value(int64_t(h.a64_checked)), value(int64_t(h.a64_skipped)), strings_value(h.a64_notes), strings_value(h.a64_mismatches)}));
};
// статический разбор: array{ошибка, отчёт}; остаточная программа для аргументов; срез
test_check(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto r = tests_host->check((a[0]).as<int64_t>());
  return value(array_v::of({value(r[0]), value(r[1])}));
};
test_residual(i64 p, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  return value(tests_host->residual((a[0]).as<int64_t>(), strings_of(a[1])));
};
test_slice(i64 p, str fn, str var) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(std::string()));
  auto & x = tests_host->at((a[0]).as<int64_t>());
  return value(slice_view(x.db).print(x.root, std::string((a[1]).as<str_v>().view()), std::string((a[2]).as<str_v>().view())));
};
// в .tzdb и обратно: array{та же проекция, вывод из загруженной}
test_store_roundtrip(i64 p, args, input) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto [same, out] = tests_host->store_roundtrip((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]));
  return value(array_v::of({value(same), value(std::move(out))}));
};
// машина процессов: array{вывод, ошибка}; с дампом после n шагов и восстановлением в новой базе:
// array{вывод, процесс закончился раньше}
test_machine(i64 p, args, input) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto r = tests_host->machine((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]));
  return value(array_v::of({value(r[0]), value(r[1])}));
};
test_machine_dump(i64 p, args, input, i64 n) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto [out, early] = tests_host->machine_dump((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]), uint64_t((a[3]).as<int64_t>()));
  return value(array_v::of({value(std::move(out)), value(early)}));
};
// сценарий сессии VM (.session) или протокола редактора (.wire): причины ("" — прошёл)
scenario_run(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(scenario_runner{}.run_session(std::string((a[0]).as<str_v>().view())));
};
// Тесты в детях (fork): не больше jobs разом; итоги — по порядку файлов: array{итог, код выхода
// (сигнал — минус), язык исполнил тест до конца}. Ребёнок исполняет test_packed(файл, режим).
tests_start(files, i64 jobs, bool a64, str projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  tests_host->start(strings_of(a[0]), uint32_t(std::max<int64_t>(1, (a[1]).as<int64_t>())));
  tests_host->a64_mode = (a[2]).as<bool>();
  tests_host->projection = std::string((a[3]).as<str_v>().view());
  return value(int64_t(0));
};
tests_next() => native "cpp" {
  node_id f = tools_host->fn("test_packed");
  auto [text, code, whole] = tests_host->take_next([&](std::string const & path) {
    return std::string(vm.analyze_instance(f, {value(path), value(tests_host->a64_mode), value(tests_host->projection)}).as<str_v>().view());
  });
  return value(array_v::of({value(std::move(text)), value(int64_t(code)), value(whole)}));
};

// Директивы шапки — строки `// ключ: значение` в начале файла (до первой строки кода):
//   args: a b c          аргументы программы          stdin: строка        строка stdin (несколько)
//   out: текст           строка stdout по порядку     out2: текст          второй запуск с тем же состоянием
//   error: подстрока     ожидаемая ошибка             instances: f(...)    экземпляр (подстрока таблицы)
//   check: / check-lacks: / check-error:  отчёт и ошибка tz check
//   residual: a b / residual-has: / residual-lacks:   остаточная программа для аргументов
//   slice: функция переменная / slice-has: / slice-lacks:
//   fmt-stable — fmt∘fmt = fmt; fmt-has: текст; fmt-ct-has: / fmt-ct-lacks: — после элаборации
//   fmt-projection: ключ / fmt-projection-has: текст — проекция модулем записей (§4.5)
//   jit-compiled: f / jit-stats: текст; no-jit — без сверки с JIT
//   machine — и машиной процессов; machine-dump: N — дамп на шаге N; dump-out: — вывод с дампом
//   quantum: N — квант вытеснения фоновых (TZ_SLICE); grant: fs net — ресурсы программе (TZ_GRANT)
//   store-roundtrip — в .tzdb и обратно: та же проекция и тот же вывод
// Опечатка в директиве не должна молча выключать проверку — неизвестная директива — причина.
struct header { array keys; array values; }
header_keys() => array{"args", "stdin", "out2", "dump-out", "quantum", "grant", "out", "error", "instances", "check-error", "check-lacks", "check", "residual-has", "residual-lacks", "residual", "slice-has", "slice-lacks", "slice", "jit-compiled", "jit-stats", "fmt-has", "fmt-projection-has", "fmt-projection", "fmt-ct-has", "fmt-ct-lacks", "machine-dump"};
directive_word(str w) {
  r = w.size > 0;
  for(k : range(w.size)) if(!(((w[k] >= 'a') && (w[k] <= 'z')) || (w[k] == '-'))) r = false;
  r
}
read_header(str src) {
  h = header{array{}, array{}};
  known = header_keys();
  done = false;
  for(line : lines_of(src)) if(!done) {
    if(!starts_with(line, "//")) {
      if(line != "") done = true;
    } else {
      body = trim_lead(text_from(line, 2));
      key = "";
      for(k : known) if((key == "") && starts_with(body, k + ":")) key = k;
      if(key != "") {
        h.keys.push(key);
        h.values.push(trim_lead(text_from(body, key.size + 1)));
      } else if((body == "no-jit") || ((body == "machine") || (starts_with(body, "fmt-stable") || starts_with(body, "store-roundtrip")))) {
        h.keys.push(if(starts_with(body, "fmt-stable")) "fmt-stable" else if(starts_with(body, "store-roundtrip")) "store-roundtrip" else body);
        h.values.push("");
      } else {
        colon = find_text(body, ":");
        if((colon > 0) && directive_word(slice_text(body, 0, colon))) {
          h.keys.push("?");
          h.values.push(slice_text(body, 0, colon));
        }
      }
    }
  }
  h
}
// значения директивы key по порядку; есть ли она
wanted(header h, str key) {
  r = array{};
  for(k : range(h.keys.size)) if(h.keys[k] == key) r.push(h.values[k]);
  r
}
has_key(header h, str key) => wanted(h, key).size > 0;
// аргументы программы — слова директив args
args_of(header h) {
  r = array{};
  for(line : wanted(h, "args")) for(w : words_of(line)) r.push(w);
  r
}
// Текст проекции без шапки теста: комментарии печатаются (§4.5), и ожидание fmt-has из шапки иначе
// нашлось бы в самой шапке.
without_header(str shown, str src) {
  n = 0;
  stop = false;
  for(l : lines_of(src)) if(!stop) {
    if(starts_with(l, "//")) {
      n += 1;
    } else stop = true;
  }
  at = 0;
  for(k : range(n)) if(at < shown.size) {
    if(!starts_with(text_from(shown, at), "//")) return shown;
    nl = find_text(text_from(shown, at), "\n");
    at = if(nl < 0) shown.size else (at + nl) + 1;
  }
  text_from(shown, at)
}
// Текст ошибки без места: «…: ошибка: <текст>» первой строки
error_text(str rendered) {
  at = find_text(rendered, "ошибка: ");
  if(at < 0) return "";
  rest = text_from(rendered, at + 14);
  nl = find_text(rest, "\n");
  if(nl < 0) rest else slice_text(rest, 0, nl)
}
// место первой ошибки (до «: ошибка»)
first_place(str rendered) {
  at = find_text(rendered, ": ошибка");
  if(at < 0) rendered else slice_text(rendered, 0, at)
}
// Первая различающаяся строка двух текстов — с соседними (было / стало).
first_difference(str a, str b) {
  la = lines_of(a);
  lb = lines_of(b);
  k = 0;
  while((k < la.size) && ((k < lb.size) && (la[k] == lb[k]))) k += 1;
  r = "";
  i = if(k >= 3) k - 3 else 0;
  while(i < (k + 3)) {
    if(i < la.size) r = r + (((("      было  " + text(i + 1)) + ": ") + la[i]) + "\n");
    if((i < lb.size) && (i >= k)) r = r + (((("      стало " + text(i + 1)) + ": ") + lb[i]) + "\n");
    i += 1;
  }
  r
}

// Тест .tz: причины ("" — прошёл).
test_tz(str path, bool a64) {
  p = test_load(path);
  src = test_source(p);
  h = read_header(src);
  dir = test_dir_of(p);
  q = wanted(h, "quantum");
  if(q.size == 0) env_unset("TZ_SLICE") else env_set("TZ_SLICE", q[0]);
  grants = ""; // ресурсы программы: «Даёшь ты» — здесь их даёт тест (TZ_GRANT)
  for(line : wanted(h, "grant")) for(w : words_of(line)) grants = (grants + (if(grants == "") "" else ",")) + w;
  if(grants == "") env_unset("TZ_GRANT") else env_set("TZ_GRANT", grants);
  counts = array{0, 0};
  notes = array{};
  why = test_program(p, h, src, dir, a64, counts, notes);
  state_clear();
  test_close(p);
  test_result{why, counts[0], counts[1], notes}
}
// counts, notes — AArch64 этого теста (проверено, не проверено; заметки)
test_program(i64 p, header h, str src, str dir, bool a64, counts, notes) {
  errors = test_errors(p);
  parsed = test_parsed(p);
  args = args_of(h);
  input = wanted(h, "stdin");
  if(has_key(h, "fmt-stable")) {
    once = test_print(p);
    if(once != print_text(once, dir, "", false)[1]) return "    проекция нестабильна: fmt∘fmt ≠ fmt\n";
  }
  if(has_key(h, "fmt-has")) {
    shown = without_header(test_print(p), src);
    for(want : wanted(h, "fmt-has")) if(!contains(shown, want)) return (("    нет в проекции: " + in_quotes(want)) + "\n") + shown;
  }
  for(key : wanted(h, "fmt-projection")) { // проекция — модуль записей по ключу, как use k (§4.5)
    array{ok, printed} = print_text(src, dir, key, false);
    if(!ok) return ("    нет модуля проекции " + key) + "\n";
    shown = without_header(printed, src);
    for(want : wanted(h, "fmt-projection-has")) if(!contains(shown, want)) return (((("    нет в проекции " + key) + ": ") + in_quotes(want)) + "\n") + shown;
  }
  if((has_key(h, "fmt-ct-has") || has_key(h, "fmt-ct-lacks")) && (errors == "")) { // после элаборации (tz fmt --ct)
    array{ok, printed} = test_elaborated(p);
    if(!ok) return "    ошибка элаборации: " + printed;
    shown = without_header(printed, src);
    for(want : wanted(h, "fmt-ct-has")) if(!contains(shown, want)) return (("    нет в проекции после элаборации: " + in_quotes(want)) + "\n") + shown;
    for(bad : wanted(h, "fmt-ct-lacks")) if(contains(shown, bad)) return (("    лишнее в проекции после элаборации: " + in_quotes(bad)) + "\n") + shown;
  }
  // состояние программы (§12.2) — свой каталог на каждое исполнение; out2: — второй запуск с ним же
  state_fresh();
  out = "";
  instances = "";
  if(errors == "") {
    array{o, e, i} = test_run(p, args, input);
    out = o;
    errors = errors + e;
    instances = i;
  }
  why_state = "";
  if(has_key(h, "out2") && (errors == "")) {
    array{again, e2, _} = test_run(p, array{}, input);
    why_state = why_state + e2;
    want2 = wanted(h, "out2");
    k = 0;
    for(line : lines_of(again)) {
      if((k >= want2.size) || (line != want2[k])) why_state = why_state + (((("    второй запуск, строка " + text(k + 1)) + ": ") + in_quotes(line)) + "\n");
      k += 1;
    }
    if(k < want2.size) why_state = why_state + "    второй запуск: не всё выведено\n";
  }
  state_fresh();
  why = "";
  for(k : range(h.keys.size)) if(h.keys[k] == "?") why = why + (("    неизвестная директива теста: " + h.values[k]) + "\n");
  // дифференциально (§10.5): с JIT вывод и места ошибок — как у интерпретатора
  if(parsed && !has_key(h, "no-jit")) {
    array{out3, err3, stats} = test_run_jit(p, args, input, a64);
    if(a64) {
      array{c, sk, ns, ms} = a64_last();
      counts[0] = c;
      counts[1] = sk;
      for(n : ns) notes.push(n);
      for(m : ms) why = why + (("    AArch64: " + m) + "\n");
    }
    if(out3 != out) why = why + ((((("    JIT: вывод отличается: " + in_quotes(out3)) + " против ") + in_quotes(out)) + "\n") + stats);
    for(want : wanted(h, "jit-stats")) if(!contains(stats, want)) why = why + ((("    нет в статистике JIT: " + in_quotes(want)) + "\n") + stats);
    for(fn : wanted(h, "jit-compiled")) if(!contains(stats, ("jit  " + fn) + "(")) why = why + ((("    JIT не скомпилировал " + fn) + ":\n") + stats);
    if((first_place(err3) != first_place(errors)) && !((errors == "") && (err3 == ""))) why = why + (((("    JIT: ошибка отличается:\n" + err3) + "против\n") + errors));
  }
  if(has_key(h, "check") || (has_key(h, "check-lacks") || has_key(h, "check-error"))) {
    check_errors = "";
    report = "";
    if(parsed) {
      array{ce, rep} = test_check(p);
      check_errors = ce;
      report = rep;
    }
    for(want : wanted(h, "check")) if(!contains(report, want)) why = why + ((("    нет в отчёте check: " + in_quotes(want)) + "\n") + report);
    for(bad : wanted(h, "check-lacks")) if(contains(report, bad)) why = why + ((("    лишнее в отчёте check: " + in_quotes(bad)) + "\n") + report);
    for(want : wanted(h, "check-error")) if(!contains(check_errors, want)) why = why + ((((("    нет ошибки check: " + in_quotes(want)) + "; есть: ") + check_errors) + "\n"));
    if(!has_key(h, "check-error") && (check_errors != "")) why = why + ("    неожиданная ошибка check:\n" + check_errors);
  }
  if(has_key(h, "residual") && parsed) {
    shown = test_residual(p, words_of(wanted(h, "residual")[0]));
    for(want : wanted(h, "residual-has")) if(!contains(shown, want)) why = why + ((("    нет в остаточной программе: " + in_quotes(want)) + "\n") + shown);
    for(bad : wanted(h, "residual-lacks")) if(contains(shown, bad)) why = why + ((("    лишнее в остаточной программе: " + in_quotes(bad)) + "\n") + shown);
  }
  if(has_key(h, "slice") && parsed) {
    w = words_of(wanted(h, "slice")[0]);
    shown = test_slice(p, if(w.size > 0) w[0] else "", if(w.size > 1) w[1] else "");
    for(want : wanted(h, "slice-has")) if(!contains(shown, want)) why = why + ((("    нет в срезе: " + in_quotes(want)) + "\n") + shown);
    for(bad : wanted(h, "slice-lacks")) if(contains(shown, bad)) why = why + ((("    лишнее в срезе: " + in_quotes(bad)) + "\n") + shown);
  }
  if(has_key(h, "store-roundtrip")) {
    state_fresh();
    array{same, out2} = test_store_roundtrip(p, args, input);
    if(!same) why = why + "    проекция после загрузки базы отличается\n";
    if(out2 != out) why = why + (((("    вывод из базы отличается: " + in_quotes(out2)) + " против ") + in_quotes(out)) + "\n");
  }
  why = why + why_state;
  state_fresh();
  if((has_key(h, "machine") || has_key(h, "machine-dump")) && parsed) why = why + machine_diff(p, h, args, input, out, errors);
  want_out = wanted(h, "out");
  i = 0;
  for(line : lines_of(out)) {
    if(i >= want_out.size) why = why + (("    лишний вывод: " + line) + "\n");
    else if(line != want_out[i]) why = why + (((((("    строка " + text(i + 1)) + ": ожидалось ") + in_quotes(want_out[i])) + ", получено ") + in_quotes(line)) + "\n");
    i += 1;
  }
  while(i < want_out.size) {
    why = why + (("    не выведено: " + in_quotes(want_out[i])) + "\n");
    i += 1;
  }
  for(want : wanted(h, "error")) if(!contains(errors, want)) why = why + (("    нет ожидаемой ошибки: " + in_quotes(want)) + "\n");
  if(!has_key(h, "error") && (errors != "")) why = why + ("    неожиданная ошибка:\n" + errors);
  for(want : wanted(h, "instances")) if(!contains(instances, want)) why = why + ((((("    нет экземпляра " + in_quotes(want)) + "; есть:\n") + instances)));
  why
}
// Машина процессов (M5): тот же вывод и та же ошибка, что у интерпретатора; с дампом — дамп после
// N шагов, восстановление в новой базе из журнала дампа («в другой VM») и досчёт: вывод до дампа и
// после восстановления — полный (или dump-out:, если ресурсы хоста не переживают перенос).
machine_diff(i64 p, header h, args, input, str out, str errors) {
  why = "";
  state_fresh();
  array{mout, merr} = test_machine(p, args, input);
  if(mout != out) why = why + (((("    машина процессов: вывод " + in_quotes(mout)) + " против ") + in_quotes(out)) + "\n");
  if(error_text(merr) != error_text(errors)) why = why + (((("    машина процессов: ошибка " + in_quotes(error_text(merr))) + " против ") + in_quotes(error_text(errors))) + "\n");
  for(at : wanted(h, "machine-dump")) { // каждая директива — свой запуск с дампом на этом шаге
    state_fresh();
    array{dout, early} = test_machine_dump(p, args, input, number_of(at));
    if(early) why = why + (("    машина: процесс закончился раньше шага дампа " + at) + "\n");
    want = out;
    if(has_key(h, "dump-out")) {
      want = "";
      for(l : wanted(h, "dump-out")) want = (want + l) + "\n";
    }
    if(dout != want) why = why + (((((("    дамп на шаге " + at) + ": вывод ") + in_quotes(dout)) + " против ") + in_quotes(want)) + "\n");
  }
  why
}

// Второй язык поверх одного АСТ (§4.5): программа, напечатанная в проекции k, — текст, который сам
// говорит, как его разбирать (use k; в начале), — разбирается в то же дерево, и её печать
// стабильна. 
// Дерево сравнивается дампом.
test_projection(str path, str key) {
  src = read_text(path);
  dir = path_dir(path);
  array{ok, once} = print_text(src, dir, key, true);
  if(!ok || (once == "")) return ("    нет модуля проекции " + key) + "\n";
  array{errors, dump_a} = parse_dump(src, dir, "программа");
  array{errors2, dump_b} = parse_dump(once, dir, "проекция");
  if((errors == "") && (errors2 != "")) return ("    текст в проекции не разбирается: " + errors2) + once;
  twice = print_text(once, dir, key, true)[1];
  if(once != twice) return "    печать в проекции нестабильна:\n" + first_difference(once, twice);
  use_line = ("  n_use key=" + key) + "\n";
  b = dump_b;
  at = find_text(b, use_line);
  if((at >= 0) && !contains(dump_a, use_line)) b = slice_text(b, 0, at) + text_from(b, at + use_line.size);
  if(dump_a != b) return (("    другое дерево после разбора проекции:\n" + first_difference(dump_a, b)) + "    текст:\n") + once;
  ""
}
// каталог файла (без косой в конце; нет — "")
path_dir(str path) {
  slash = -1;
  for(k : range(path.size)) if(path[k] == '/') slash = k;
  if(slash < 0) "" else slice_text(path, 0, slash)
}
// имя файла
path_name(str path) => text_from(path, path_dir(path).size + (if(path_dir(path) == "") 0 else 1));

// Итог теста: причины ("" — прошёл) и AArch64 этого теста (--a64): проверено, не проверено, заметки.
struct test_result { str why; i64 checked; i64 skipped; array notes; }
// Один тест: проекция (--projection k) — только обратимость программы; сценарий; программа.
test_one(str path, bool a64, str projection) {
  if(projection != "") return test_result{test_projection(path, projection), 0, 0, array{}};
  if(ends_with(path, ".session") || ends_with(path, ".wire")) return test_result{scenario_run(path), 0, 0, array{}};
  test_tz(path, a64)
}
// Итог теста ребёнка (fork) родителю — строками: «проверено не_проверено заметок», заметки, причины.
test_packed(str path, bool a64, str projection) {
  r = test_one(path, a64, projection);
  t = ((((text(r.checked) + " ") + text(r.skipped)) + " ") + text(r.notes.size)) + "\n";
  for(n : r.notes) t = (t + n) + "\n";
  t + r.why
}
// tz test <каталог> [--a64 | --projection k]: прогон; код 0 — все прошли. Одновременно тестов —
// TZ_TEST_JOBS, иначе по ядрам; 1 — подряд в этом процессе, без fork.
run_tests(str dir, bool a64, str projection) {
  names = array{};
  for(f : files_in(dir)) if(ends_with(f, ".tz") || ((projection == "") && (ends_with(f, ".session") || ends_with(f, ".wire")))) names.push(f);
  files = array{};
  for(k : sorted_indices(names)) files.push(names[k]);
  jobs = if(env_get("TZ_TEST_JOBS") != "") number_of(env_get("TZ_TEST_JOBS")) else cpu_count();
  if(jobs < 1) jobs = 1;
  passed = 0;
  checked = 0;
  skipped = 0;
  notes = array{};
  if(jobs > 1) tests_start(files, jobs, a64, projection);
  for(f : files) {
    why = "";
    if(jobs > 1) {
      array{got, code, whole} = tests_next();
      if(code != 0) why = ("    тест не закончился: " + (if(code < 0) ("сигнал " + text(0 - code)) else ("код " + text(code)))) + "\n";
      else if(!whole) why = got;
      else {
        // счётчики AArch64 ребёнка: «проверено не_проверено заметок», заметки, причины
        nl = find_text(got, "\n");
        ws = words_of(slice_text(got, 0, nl));
        checked += number_of(ws[0]);
        skipped += number_of(ws[1]);
        rest = text_from(got, nl + 1);
        for(j : range(number_of(ws[2]))) {
          e = find_text(rest, "\n");
          n = slice_text(rest, 0, e);
          if(!has_text(notes, n)) notes.push(n);
          rest = text_from(rest, e + 1);
        }
        why = rest;
      }
    } else {
      r = test_one(f, a64, projection);
      why = r.why;
      checked += r.checked;
      skipped += r.skipped;
      for(n : r.notes) if(!has_text(notes, n)) notes.push(n);
    }
    if(why == "") {
      passed += 1;
      write_out(("  ok   " + path_name(f)) + "\n");
    } else write_out(((("  FAIL " + path_name(f)) + "\n") + why) + "\n");
  }
  if(a64) {
    write_out(((("AArch64: проверено вызовов " + text(checked)) + ", не проверено ") + text(skipped)) + "\n");
    for(k : sorted_indices(notes)) write_out(("  не проверено  " + notes[k]) + "\n");
  }
  write_out((((text(passed) + "/") + text(files.size)) + " тестов прошло\n"));
  if(passed == files.size) 0 else 1
}
