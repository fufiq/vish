      jump(pre);
      bind(t);
      loops.push(t);
      loops.push(done);
      loop_blk.push(blk_depth);
      loop_nodes.push(e);
      loop_slot0.push(nslots);
      in_region(() => gen(body));
      jump(t);
      bind(done);
      loops = drop_last(drop_last(loops));
      loop_blk = drop_last(loop_blk);
      depth_l = loop_nodes.size - 1;
      loop_nodes = drop_last(loop_nodes);
      loop_slot0 = drop_last(loop_slot0);
      mine = array{};
      rest = array{};
      for(h : hoists) if(h[0] == depth_l) mine.push(h) else rest.push(h);
      hoists = rest;
      if(mine.size == 0) labels[pre] = labels[t];
      else {
        after = label();
        jump(after);
        bind(pre);
        for(h : mine) {
          if(h[2] == 0) arr_data(third, h[1]) else arr_size(third, h[1]);
          put_bytes(slot_st(h[3], third));
        }
        jump(t);
        bind(after);
      }
    } else if(k == ast.break) {
      if(loops.size == 0) bad("break вне цикла");
      else if(live_since(loop_blk[loop_blk.size - 1])) bad("break через живой ресурс — интерпретатор");
      else jump(loops[loops.size - 1]);
    } else if(k == ast.continue) {
      if(loops.size == 0) bad("continue вне цикла");
      else if(live_since(loop_blk[loop_blk.size - 1])) bad("continue через живой ресурс — интерпретатор");
      else jump(loops[loops.size - 2]);
    } else if(k == ast.return) {
      ast.return{v, tg} = e;
      if(res_live.size > 0) bad("return при живом ресурсе — интерпретатор");
      to = cur;
      if(given(tg)) { // return(f) from the external function f, return(caller) from the calling function (§6.1)
        tn = callee_name(tg);
        to = -1;
        if(tn == "caller") to = fr_parent[cur];
        else {
          i = cur;
          loop {
            if(i < 0) break;
            fname = code_name(fr_fn[i]); // at the lambda -'
            if((to < 0) && (fname == tn)) to = i;
            i = fr_parent[i];
          }
        }
      }
      if(to < 0) bad("return(цель): цели нет в цепочке встраивания");
      else {
        if(given(v)) gen(v);
        if(depth > 0) put_bytes(cg.stack_free(8 * depth)); // transient
        jump(fr_exit[to]);
      }
    } else if(k == ast.variable) {
      ast.variable{name, vt, init, _, is_ct, is_ref, _, _} = e;
      if(is_ct) bad("ct-переменная");
      else if(is_ref) gen_ref_decl(e, name, init);
      else if(given(vt) && (code_kind(vt) == ast.name)) { // T x = e: value in type T (§5.8 )
        want = type_of_code(vt);
        t = ty(init);
        if(want == t) assign(name, init, true);
        else if(is_handle(want) && ((code_kind(init) == ast.construct) && (jit_literal_place(init) != ""))) assign_handle(name, init, want, true); // T x = {…} : name type - T (field - by T), literal leads VM
        else if((want == f64) && (t == i64)) {
          gen(init);
          put_bytes(cg.to_f64(acc_f, acc));
          declare(name, f64);
          store_slot(f64, env[top - 1].slot);
        } else bad(fmt"объявление {want} из {t}");
      } else assign(name, init, true);
    } else if(k == ast.throw) gen_throw(e);
    else if(k == ast.function) { // Local function: no code in place - built into calls
      ast.function{nm, _, _, _, _, _, _, sc, _} = e;
      lfns.push(jc_lfn{nm, e, top, base, ctx, cur}); // Block operator: embedded in its operations (gen_op)
    }
    else if(k == ast.construct) gen_construct(e);
    else if(k == ast.unpack) gen_unpack(e);
    else if(k == ast.string) vm_or_bad(e, fmt"узел {k}");
    else if(kind_functions(e, "eval").size > 0) gen_program_node(e);
    else bad(fmt"узел {k}");
  };
  // index in acc, check the boundaries on the size of the array (record s); data in second. The index
  // proved by parsing instance (range(xs.size) - indexes xs until xs changes) - without checking:
  //
// 
// The test has already been completed (is_index in for).
  checked(i64 s, e) => {
    if(!jit_proven(e)) {
      hz = hoisted(s, 1, e);
      if(hz >= 0) put_bytes(slot_ld(second, hz)) else arr_size(second, env[s].slot);
      jump_to(trap(1, e), 3, acc, second);
    }
    hd = hoisted(s, 0, e);
    if(hd >= 0) put_bytes(slot_ld(second, hd)) else arr_data(second, env[s].slot);
  };
  // Data (0) or size (1) of array-variable s is derived from the current cycle:
// 
// 
// Only in fact parsing (jit_loop_keeps: the array for the entire cycle is not
  // was changed in its entirety) and for a variable declared before the cycle (its slot - before
  // entering the cycle): . The value is a slot variable (in the register, if there is free); -1 -
  // is not deducted.
  hoisted(i64 s, i64 kind, e) => {
    r = -1;
    if(!gen_sub && (loop_nodes.size > 0)) {
      d = loop_nodes.size - 1;
      sl = env[s].slot;
      for(h : hoists) if((h[0] == d) && ((h[1] == sl) && (h[2] == kind))) r = h[3];
      if((r < 0) && ((sl < loop_slot0[d]) && jit_loop_keeps(loop_nodes[d], e))) {
        r = alloc(1);
        give_reg(r, i64);
        hoists.push(array{d, sl, kind, r});
      }
    }
    r
  };
  // append(xs, x) (push): space in words is - a record and n + 1 machine code ("infinite vector":
  // growing array does not move, §12.2); no - VM via service (op 9: growth, layout choice first
  // element). The overall layout holds capacity 0 (*my*).
  gen_append(e, a, x) => {
    s = var_of(a);
    t = ty(x);
    if((s < 0) || (env[s].thunk || (!arr_like(env[s].kind) || ((t != i64) && (t != f64))))) vm_or_bad(e, "append не в массив-переменную");
    else {
      gen(x);
      if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
      push_into(env[s].slot, t, e);
    }
  };
  // element (bits in acc) - at the end of the array, the address of the cell in the slot sl
  push_into(i64 sl, type t, e) => {
    slow = label();
    done = label();
    put_bytes(slot_ld(second, sl));
    put_bytes(cg.load(third, second, a_size));
    put_bytes(cg.load(second, second, a_cap));
    put_bytes(cg.is_index(third, second));
    jump_unless(third, slow);
    put_bytes(slot_ld(second, sl));
    put_bytes(cg.load(third, second, a_size));
    put_bytes(cg.load(second, second, a_data));
    put_bytes(cg.store_index(second, third, acc));
    put_bytes(cg.address(third, third, 1));
    put_bytes(slot_ld(second, sl));
    put_bytes(cg.store(second, a_size, third));
    // the place was - data on the spot, links are complete:
// Moving to VM (Call 9)
    jump(done);
    bind(slow);
    put_bytes(cg.move(ca2, acc));
    put_bytes(slot_ld(ca1, sl));
    vm_service(9, t, e);
    bind(done);
  };
  // unpacking array {a, _, ...r} = v (P12; instruction or predicate if(образец = v)): unpacks VM - its entire semantics
  // (length, residue, types, unpack_failed), service op 11; names - slots: scalar by bits, VM value - a copy in the call
  // memory. Name type - from parsing (his observation)
  gen_unpack(e) => {
    ast.unpack{pat, val, test} = e;
    unpack_with(pat, test, e, ty(val), val, -1);
  };
  // Sample names - in depth (like op 11 service): elements, interface fields, nested samples
  pattern_names(p, names) => {
    k = code_kind(p);
    if(k == ast.pattern_field) {
      ast.pattern_field{_, sub} = p;
      pattern_names(sub, names);
    } else if(k == ast.pattern) {
      ast.pattern{_, items} = p;
      for(it : items) pattern_names(it, names);
    } else if(k == ast.parameter) {
      ast.parameter{pname, _, _, _, _, _, _} = p;
      if(pname != "_") names.push(p);
    }
  };
  // unpacking the value of val (node) or vslot slot (parameter-sample at the input - at - the
  // parameter itself): VM unpacks the service 11/12, names - in slots
  unpack_with(pat, bool test, at, vt, val, i64 vslot) => {
    names = array{};
    pattern_names(pat, names);
    if(!is_handle(vt)) bad(fmt"распаковка {vt}");
    else if(ok) {
      n = names.size;
      w = 2 + (2 * n);
      k0 = alloc(w);
      bsl(i64 j) => (k0 + w) - (1 + j);
      if(vslot >= 0) put_bytes(slot_ld(acc, vslot)) else gen(val);
      put_bytes(slot_st(bsl(1), acc));
      mem_to(acc);
      put_bytes(slot_st(bsl(0), acc));
      kinds = array{};
      for(i : range(n)) {
        t = ty(names[i]);
        if(!given(t) || (t == unit) || ((t == jc_range) || is_stream(t))) bad(fmt"распаковка: тип имени {t}");
        kinds.push(t);
        put_bytes(cg.load_const(acc, vm_kind(t)));
        put_bytes(slot_st(bsl(2 + (2 * i)), acc));
      }
      put_bytes(cg.address(ca1, sb(bsl(0)), so(bsl(0))));
      vm_service(if(test) 12 else 11, unit, at); // Predicate: Truth/Falsehood in Acc, Names in Success
      res = alloc(1);
      put_bytes(slot_st(res, acc));
      for(i : range(n)) if(ok) {
        ast.parameter{pname, _, _, _, _, _, _} = names[i];
        t = kinds[i];
        sl = declare(pname, t);
        wrote(sl);
        put_bytes(slot_ld(acc, bsl(3 + (2 * i))));
        if(t == f64) put_bytes(cg.move_to_f64(acc_f, acc));
        store_bytes(t, sl);
      }
      put_bytes(slot_ld(acc, res));
    }
  };
  // array {x, ...ys} over i64/f64: an empty array of the desired layout with space for scalars - VM
  // in call memory (op 10), elements - push machine code, ...ys - cycle according to ys
  gen_construct(e) => {
    t = ty(e);
    ast.construct{tn, items, _} = e;
    fits = is_arr(t) && (given(tn) && (code_name(tn) == "array"));
    // {x: …} without type: type from place (§4.3). The place in the text is the result of a function
    // or T x = {…} with a struct-aggregate: the literal computes VM and leads to it
    // (jit_literal_place - VM rule); otherwise (argument, scalar place) - the interpreter
    if(!given(tn)) {
      if(jit_literal_place(e) == "") bad("анонимный литерал {…} не на месте результата или T x — интерпретатор");
      else vm_or_bad(e, "анонимный литерал {…}");
      return unit;
    }
    n = 0;
    for(x : items) if(fits) {
      if(code_kind(x) == ast.spread) {
        ast.spread{v} = x;
        if(ty(v) != t) fits = false;
      } else if(ty(x) != elem(t)) fits = false;
      else n += 1;
    }
    if(!fits) vm_or_bad(e, "узел ast.construct");
    else {
      et = elem(t);
      c = alloc(1);
      mem_to(ca1);
      put_bytes(cg.load_const(ca2, n));
      vm_service(10, et, e);
      put_bytes(slot_st(c, acc));
      for(x : items) {
        if(code_kind(x) == ast.spread) {
          ast.spread{v} = x;
          src = alloc(1);
          j = alloc(1);
          gen(v);
          put_bytes(slot_st(src, acc));
          put_bytes(cg.load_const(acc, 0));
          put_bytes(slot_st(j, acc));
          top_l = label();
          end_l = label();
          bind(top_l);
          put_bytes(slot_ld(acc, j));
          put_bytes(slot_ld(second, src));
          put_bytes(cg.load(second, second, a_size));
          put_bytes(cg.is_index(acc, second));
          jump_unless(acc, end_l);
          put_bytes(slot_ld(second, src));
          put_bytes(cg.load(second, second, a_data));
          put_bytes(slot_ld(third, j));
          put_bytes(cg.load_index(acc, second, third));
          push_into(c, et, e);
          put_bytes(slot_ld(acc, j));
          put_bytes(cg.address(acc, acc, 1));
          put_bytes(slot_st(j, acc));
          jump(top_l);
          bind(end_l);
        } else {
          gen(x);
          if(et == f64) put_bytes(cg.move_from_f64(acc, acc_f));
          push_into(c, et, e);
        }
      }
      put_bytes(slot_ld(acc, c));
    }
  };
  // Array size and data - from its cell (slot sl - its address)
  arr_size(i64 r, i64 sl) => {
    put_bytes(slot_ld(r, sl));
    put_bytes(cg.load(r, r, a_size));
  };
  // the size of the array of variable s in the place o: numerical - dense words, otherwise (code,
  // lines, tuples - values of VM) - a list of values; an array without known elements - words
  arr_size_of(i64 r, i64 s, o) => {
    t = arr_type(s, o);
    if(is_arr(t) || late(t)) arr_size(r, env[s].slot)
    else {
      put_bytes(slot_ld(r, env[s].slot));
      put_bytes(cg.load(r, r, a_items_n));
    }
  };
  arr_data(i64 r, i64 sl) => {
    put_bytes(slot_ld(r, sl));
    put_bytes(cg.load(r, r, a_data));
  };
  // a[i] is a pair operator [] (node ast.operation "[]")
  index_parts(e) => if(code_kind(e) == ast.operation) {
    ast.operation{op, xs, _} = e;
    if((op == "[]") && (xs.size == 2)) xs else array{}
  } else array{};
  gen_index(e) => {
    array{o, ix} = index_parts(e);
    gen_index_of(e, o, ix);
  };
  // overload [] type code (operator (T a)[U i]) approaching the operands is embedded
  typed_overload(g) => {
    ast.function{_, ps, _, _, _, _, _, _, _} = g;
    n = 0;
    for(p : ps) {
      ast.parameter{_, pt, _, _, _, _, _} = p;
      if(given(pt)) n += 1;
    }
    n > 0
  };
  gen_index_op(e, xs) => {
    g = choose("infix[]", xs);
    if((g.size == 1) && typed_overload(g[0])) gen_inline(e, "infix[]", xs);
    else gen_index(e);
  };
  // Reference &e = xs[k] (§12.1):
// Machine code - only in fact parsing : for
  // The link life array has not been replaced or grown (jit_ref_keeps) - the element is the same,
  // the generation is not checked:
// Index - in the slot (register), reading and writing - an element of the array.
  gen_ref_decl(e, str name, init) => {
    if(index_parts(init).size != 2) bad("ссылка-путь (поле, элемент поля) — интерпретатор");
    else if(!jit_ref_keeps(e)) bad("ссылка: массив за её жизнь меняется целиком — интерпретатор (поколения)");
    else {
      array{o, ix} = index_parts(init);
      s = var_of(o);
      if((s < 0) || (env[s].thunk || (!arr_like(env[s].kind) || !is_arr(arr_type(s, o))))) bad("ссылка: элемент массива-переменной");
      else if(!scalar_t(elem(arr_type(s, o)))) bad("ссылка: элемент не скаляр");
      else {
        gen(ix);
        checked(s, init);
        k = alloc(1);
        give_reg(k, i64);
        put_bytes(slot_st(k, acc));
        put(jc_var{name, jc_ref, k, false, init, 0, s, 0, 0});
      }
    }
  };
  ref_elem(i64 k) => {
    v = env[k];
    elem(arr_type(v.th_top, index_parts(v.th)[0]))
  };
  ref_load(i64 k) => {
    v = env[k];
    put_bytes(slot_ld(acc, v.slot));
    checked(v.th_top, v.th);
    put_bytes(if(ref_elem(k) == f64) cg.load_index_f64(acc_f, second, acc) else cg.load_index(acc, second, acc));
  };
  // value in acc (f64 in acc_f)
  ref_store(i64 k, type t) => {
    v = env[k];
    wrote(env[v.th_top].slot);
    if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
    put_bytes(cg.push_tmp(acc));
    depth += 1;
    put_bytes(slot_ld(acc, v.slot));
    checked(v.th_top, v.th);
    put_bytes(cg.pop_tmp(third));
    depth -= 1;
    put_bytes(cg.store_index(second, acc, third));
  };
  store_var(i64 s, type t) => if(env[s].kind == jc_ref) ref_store(s, t) else store_slot(t, env[s].slot);
  gen_index_of(e, o, ix) => {
    s = var_of(o);
    if((s < 0) || env[s].thunk) bad("индекс не массива-переменной");
    else if(env[s].kind == jc_range) gen(ix); // range(n) on the is_index index is the index itself.
    else if(env[s].kind == str) gen_str_index(e, s, ix); // s[k] - byte string
    else if(!arr_like(env[s].kind)) bad("индекс не массива");
    else if(!is_arr(arr_type(s, o)) && !late(arr_type(s, o))) vm_or_bad(e, "элемент — значение VM"); // flashback
    else if(!is_arr(arr_type(s, o))) bad("тип элементов массива неизвестен");
    else {
      gen(ix);
      checked(s, e);
      put_bytes(if(arr_type(s, o) == array(f64)) cg.load_index_f64(acc_f, second, acc) else cg.load_index(acc, second, acc));
    }
  };
  assign(str name, e, bool fresh) => {
    if((code_kind(e) == ast.lambda) && (fresh || (find(name) < 0))) return put(jc_var{name, unit, 0, true, e, ctx, top, base, cur}); // f = (x) => ... as a local function
    t = if(is_call_of(e, "range")) jc_range else ty(e);
    if(is_handle(t)) assign_handle(name, e, t, fresh);
    else if(t == unit) bad("у значения нет одного типа на все шаги (кортеж растёт разнотипно) — интерпретатор"); //  
    else if(!scalar(t) && (t != jc_range)) bad(fmt"присваивание значения {t}");
    else assign_scalar(name, e, t, fresh);
  };
  assign_scalar(str name, e, type t, bool fresh) => {
    gen(e);
    s = if(fresh) -1 else find(name);
    if((s >= 0) && env[s].thunk) bad("присваивание expr-параметру");
    else if((s >= 0) && (env[s].kind == jc_ref)) {
      if(ref_elem(s) != t) bad("тип элемента ссылки") else ref_store(s, t);
    }
    else {
      if(s < 0) {
        declare(name, t);
        s = top - 1;
      }
      if(env[s].kind != t) bad("тип переменной меняется");
      else store_slot(t, env[s].slot);
    }
  };
  // The second operand: calculate, on the stack, the first, the second - in the second from left to
  // right, as an interpreter (operands have effects): the first - on the stack, the second - in the
  // second, the first - back to the acc First operand - variable-scalar, the second does not change
  // it (without assignments and calls): reading the variable is unobservable, the order is the same
  // in meaning - the second is calculated first, the variable is taken from its place (register)
  // without a stack of time.
  assign_ops = array{"=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>="};
  calm(e) => {
    k = code_kind(e);
    if((k == ast.name) || ((k == ast.int) || (k == ast.float))) true
    else if(k == ast.chain) {
      t = jit_chain(e, ctx);
      (t.size == 1) && calm(t[0])
    } else if(k == ast.operation) {
      ast.operation{op, xs, _} = e;
      r = !has_str(assign_ops, op);
      for(x : xs) if(r && !calm(x)) r = false;
      r
    } else false
  };
  has_str(xs, str x) => {
    r = false;
    for(y : xs) if(y == x) r = true;
    r
  };
  // Expression without calling VM services: scalars, literals, primitive operations on them, the
  // element of the array-variable. Its code does not affect temporary registers (temp_regs targets).
  scalar_t(type t) => (t == i64) || ((t == f64) || (t == bool));
  reg_safe(e) => {
    k = code_kind(e);
    if((k == ast.int) || (k == ast.float)) true
    else if(k == ast.name) plain_var(e)
    else if(k == ast.chain) {
      t = jit_chain(e, ctx);
      (t.size == 1) && reg_safe(t[0])
    } else if(k == ast.operation) {
      ast.operation{op, xs, _} = e;
      if(has_str(assign_ops, op) || !scalar_t(ty(e))) false
      else if(op == "[]") (xs.size == 2) && ((var_of(xs[0]) >= 0) && (arr_like(env[var_of(xs[0])].kind) && reg_safe(xs[1])))
      else if((op == ".size") || (field_slot(e).size == 2)) false
      else {
        r = true;
        for(x : xs) if(r && !reg_safe(x)) r = false;
        r
      }
    } else false
  };
  plain_var(e) => (code_kind(e) == ast.name) && {
    ast.name{nm} = e;
    v = find(nm);
    (v >= 0) && (!env[v].thunk && ((env[v].kind == i64) || ((env[v].kind == bool) || (env[v].kind == f64))))
  };
  operands(e0, e1, type t) => if(plain_var(e0) && calm(e1)) {
    gen(e1);
    if(t == f64) put_bytes(cg.move_f64(second_f, acc_f)) else put_bytes(cg.move(second, acc));
    gen(e0);
  } else if(reg_safe(e1) && (tmp_used[if(t == f64) 1 else 0] < tmp_regs[if(t == f64) 1 else 0].size)) {
    // The second - without calls VM services (scalars, literature, array-variable element): the first
    // waits in the register of its class, and not on the stack through the whole register.
// without a distributor: -
// register by depth.
    c = if(t == f64) 1 else 0;
    r = tmp_regs[c][tmp_used[c]];
    gen(e0);
    if(t == f64) put_bytes(cg.move_f64(r, acc_f)) else put_bytes(cg.move(r, acc));
    tmp_used[c] += 1;
    gen(e1);
    tmp_used[c] -= 1;
    if(t == f64) {
      put_bytes(cg.move_f64(second_f, acc_f));
      put_bytes(cg.move_f64(acc_f, r));
    } else {
      put_bytes(cg.move(second, acc));
      put_bytes(cg.move(acc, r));
    }
  } else {
    gen(e0);
    if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
    put_bytes(cg.push_tmp(acc));
    depth += 1;
    gen(e1);
    if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
    put_bytes(cg.move(second, acc));
    put_bytes(cg.pop_tmp(acc));
    depth -= 1;
    if(t == f64) {
      put_bytes(cg.move_to_f64(second_f, second));
      put_bytes(cg.move_to_f64(acc_f, acc));
    }
  };
  regs(type t) => if(t == f64) array{acc_f, second_f} else array{acc, second};
  // second operand i64, known as parsing (compile-time), is the value in code generator of the
  // context of the known target: in the immediate operand (imm32; shift - 0.63)
  imm_of(e, str op) => {
    k = ct_const(e);
    if(k.size != 1) array{}
    else if(typeof(k[0]) != i64) array{}
    else if((op == "<<") || ((op == ">>") || ((op == "<<=") || (op == ">>=")))) (if((k[0] >= 0) && (k[0] < 64)) k else array{})
    else if((k[0] >= -2147483648) && (k[0] <= 2147483647)) k
    else array{}
  };
  known_g(cx, e, x) => {
    ast.operation{op, _, _} = e;
    if(imm_of(x, op).size != 1) array{}
    else {
      g = op_codegen(cx.known, e, array{i64, i64});
      if(given(g)) array{g} else array{}
    }
  };
  // If, require: Comparison of i64 and is_index to code generator of the context of the goal
  // condition
// !c - same transition with reverse
  // condition. The rest is the value in acc and the transition over it.
  cmp_op(str op) => (op == "==") || ((op == "!=") || ((op == "<") || ((op == "<=") || ((op == ">") || (op == ">=")))));
  is_index_call(c) => (code_kind(c) == ast.call) && {
    ast.call{callee, xs, _, _, _, _, _} = c;
    (callee_name(callee) == "is_index") && ((xs.size == 2) && ((find("is_index") < 0) && ((local_fns("is_index").size == 0) && (jit_const(c, ctx).size == 0))))
  };
  // transition condition: array{node, known second operand (array {} - in the register)} - solved at
  // generation, bytes in the placement of offsets - the same (compiler environment is different)
  cond_bytes(i64 when, fc) => {
    cx = if(when == 1) cg.when else cg.unless;
    c = fc[0];
    v = fc[1];
    if(code_kind(c) == ast.call) cx.is_index(acc, second)
    else if(v.size == 1) {
      g = op_codegen(cx.known, c, array{i64, i64});
      g(acc, v[0])
    } else {
      g = op_codegen(cx, c, array{i64, i64});
      g(acc, second)
    }
  };
  jump_cond(c, bool when, i64 l) => {
    k = code_kind(c);
    if(ct_const(c).size == 1) jump_value(c, when, l)
    else if(k == ast.chain) {
      t = jit_chain(c, ctx);
      if(t.size == 0) bad("цепочка: дерево зависит от пути") else jump_cond(t[0], when, l);
    } else if(k == ast.operation) {
      ast.operation{op, xs, _} = c;
      if((op == "!") && ((xs.size == 1) && (ty(xs[0]) == bool))) jump_cond(xs[0], !when, l)
      else if(cmp_op(op) && ((xs.size == 2) && ((ty(xs[0]) == i64) && ((ty(xs[1]) == i64) && given(op_codegen(cg.unless, c, array{i64, i64})))))) {
        v = if(known_g(cg.unless, c, xs[1]).size == 1) imm_of(xs[1], op) else array{};
        if(v.size == 1) gen(xs[0]) else operands(xs[0], xs[1], i64);
        fix_conds.push(array{c, v});
        jump_to(l, 6, if(when) 1 else 0, fix_conds.size - 1);
      } else jump_value(c, when, l);
    } else if(is_index_call(c)) {
      ast.call{_, xs, _, _, _, _, _} = c;
      s = var_of(xs[1]);
      if((s < 0) || env[s].thunk) bad("is_index не над переменной");
      else {
        gen(xs[0]);
        if(env[s].kind == jc_range) put_bytes(slot_ld(second, env[s].slot));
        else arr_size_of(second, s, xs[1]);
        fix_conds.push(array{c, array{}});
        jump_to(l, 6, if(when) 1 else 0, fix_conds.size - 1);
      }
    } else jump_value(c, when, l);
  };
  // branch - one break (1: end of cycle) or continue (2: beginning), block or no
  loop_jump(t) => {
    k = code_kind(t);
    if(k == ast.break) array{1}
    else if(k == ast.continue) array{2}
    else if(k == ast.block) {
      ast.block{items, _, _} = t;
      if(items.size == 1) loop_jump(items[0]) else array{}
    } else array{}
  };
  jump_value(c, bool when, i64 l) => {
    gen(c);
    if(when) jump_if(acc, l) else jump_unless(acc, l);
  };
  // Cycle instance in bands (O6).
// 
// 
// 
// For for range: loop {if(! is_index(i, xs) ) break; k = i;
  // i = i + 1; b(xs[k]); }, body b - instance: only the entries of the elements a[k] = the expression of
  // the elements a[k] (index - k itself), the immutable scalars and literals; operations are those that
  // are in the context of the lanes goal. instance is independent (each touches only its own element),
  // strip operation is the same IEEE operation as one: the output is the same as that of the interpreter.
  // My:* limit is the smaller of n and array sizes (before the cycle), along the bands - as long as
  // width() instance enters, the remainder and error of the boundaries - the usual cycle behind it; the
  // convolution (s += ...) - not instance (dependent chain, order of rounding), remains scalar.
  tree(x) => if(code_kind(x) == ast.chain) {
    t = jit_chain(x, ctx);
    if(t.size == 1) t[0] else x
  } else x;
  name_is(x, str n) => (code_kind(x) == ast.name) && {
    ast.name{nm} = x;
    nm == n
  };
  lane_shape(e) => {
    r = array{};
    ast.loop{body} = e;
    if(code_kind(body) == ast.block) {
      ast.block{items, _, _} = body;
      if(items.size == 4) {
        c0 = tree(items[0]);
        c1 = tree(items[1]);
        c2 = tree(items[2]);
        c3 = tree(items[3]);
        if((code_kind(c0) == ast.if) && ((code_kind(c1) == ast.operation) && ((code_kind(c2) == ast.operation) && (code_kind(c3) == ast.call)))) {
          ast.if{c, t, el} = c0;
          c = tree(c);
          lj = loop_jump(t);
          if(!given(el) && ((lj.size == 1) && ((lj[0] == 1) && (code_kind(c) == ast.operation)))) {
            ast.operation{nop, nxs, _} = c;
            if((nop == "!") && ((nxs.size == 1) && is_index_call(tree(nxs[0])))) {
              ast.call{_, ixs, _, _, _, _, _} = tree(nxs[0]);
              ast.operation{op1, s1, _} = c1;
              ast.operation{op2, s2, _} = c2;
              ast.call{callee, args, _, _, _, _, _} = c3;
              iv = callee_name(ixs[0]);
              xv = callee_name(ixs[1]);
              kv = if((op1 == "=") && (s1.size == 2)) callee_name(s1[0]) else "";
              step = if((op2 == "=") && ((s2.size == 2) && name_is(s2[0], iv))) tree(s2[1]) else code();
              one = (code_kind(step) == ast.operation) && {
                ast.operation{sop, sxs, _} = step;
                (sop == "+") && ((sxs.size == 2) && (name_is(sxs[0], iv) && ((ct_const(sxs[1]).size == 1) && (ct_const(sxs[1])[0] == 1))))
              };
              arg = if(args.size == 1) index_parts(tree(args[0])) else array{};
              si = find(iv);
              sx = find(xv);
              sbd = find(callee_name(callee));
              if((iv != "") && ((kv != "") && (name_is(s1[1], iv) && (one && ((arg.size == 2) && (name_is(arg[0], xv) && name_is(arg[1], kv))))))) {
                if((si >= 0) && ((sx >= 0) && ((sbd >= 0) && (!env[si].thunk && ((env[si].kind == i64) && ((env[sx].kind == jc_range) && (env[sbd].thunk && (code_kind(env[sbd].th) == ast.lambda)))))))) {
                  ast.lambda{lps, _, _} = env[sbd].th;
                  if(lps.size == 1) r = array{si, sx, sbd};
                }
              }
            }
          }
        }
      }
    }
    r
  };
  // a[k] instance : array variable with elements t, index name instance
  lane_elem(o, ix, type t) => {
    s = var_of(o);
    w = var_of(tree(ix));
    fine = (s >= 0) && ((w >= 0) && (!env[s].thunk && (arr_like(env[s].kind) && ((arr_type(s, o) == array(t)) && (env[w].kind == jc_lane)))));
    if(fine && !has(lane_arrs, s)) lane_arrs.push(s);
    fine
  };
  // instance expression type t: how many registers of bands are needed (0 - not by bands)
  lane_expr(x0, type t) => {
    x = tree(x0);
    k = code_kind(x);
    kc = ct_const(x);
    if(kc.size == 1) (if(typeof(kc[0]) == t) 1 else 0)
    else if(k == ast.name) {
      s = var_of(x);
      if((s >= 0) && (!env[s].thunk && (env[s].kind == t))) 1 else 0
    } else if(k == ast.operation) {
      ast.operation{op, xs, _} = x;
      if((op == "[]") && (xs.size == 2)) (if(lane_elem(xs[0], xs[1], t)) 1 else 0)
      else if((xs.size == 1) && ((local_fns("prefix" + op).size == 0) && ((ty(x) == t) && ((ty(xs[0]) == t) && given(op_codegen(lx, x, array{t})))))) lane_expr(xs[0], t)
      else if((xs.size == 2) && (!has_str(assign_ops, op) && ((local_fns("infix" + op).size == 0) && ((ty(x) == t) && ((ty(xs[0]) == t) && ((ty(xs[1]) == t) && given(op_codegen(lx, x, array{t, t})))))))) {
        a = lane_expr(xs[0], t);
        b = lane_expr(xs[1], t);
        if((a == 0) || (b == 0)) 0 else if(a > (b + 1)) a else b + 1
      } else 0
    } else if(k == ast.if) { // Branches instance - mask:
//  
      ast.if{c, a0, b0} = x;
      m = lane_mask(c);
      p = if(given(b0)) lane_expr(lane_one(a0), t) else 0;
      q = if(given(b0)) lane_expr(lane_one(b0), t) else 0;
      if((m == 0) || ((p == 0) || (q == 0))) 0 // branches, then a mask: registers - in depth
      else if((p >= (q + 1)) && (p >= (m + 2))) p
      else if((q + 1) >= (m + 2)) q + 1
      else m + 2
    } else 0
  };
  lane_one(x0) => {
    x = tree(x0);
    if(code_kind(x) == ast.block) {
      ast.block{items, _, _} = x;
      if(items.size == 1) tree(items[0]) else x
    } else x
  };
  // condition of the instance branch - comparison by stripes: mask; registers are needed (0 - not by stripes)
  lane_mask(c0) => {
    c = tree(c0);
    r = 0;
    if(code_kind(c) == ast.operation) {
      ast.operation{op, xs, _} = c;
      if(cmp_op(op) && ((xs.size == 2) && (local_fns("infix" + op).size == 0))) {
        tc = ty(xs[0]);
        if(((tc == f64) || (tc == i64)) && ((ty(xs[1]) == tc) && given(op_codegen(lx, c, array{tc, tc})))) {
          a = lane_expr(xs[0], tc);
          b = lane_expr(xs[1], tc);
          if((a > 0) && (b > 0)) r = if(a > (b + 1)) a else b + 1;
        }
      }
    }
    r
  };
  lane_stmt(x0) => {
    x = tree(x0);
    k = code_kind(x);
    if(k == ast.block) {
      ast.block{items, _, _} = x;
      r = items.size > 0;
      for(y : items) if(r) r = lane_stmt(y);
      r
    } else if(k == ast.operation) {
      ast.operation{op, xs, _} = x;
      (op == "=") && ((xs.size == 2) && ((index_parts(tree(xs[0])).size == 2) && {
        array{o, ix} = index_parts(tree(xs[0]));
        t = ty(xs[1]);
        n = if((t == f64) || (t == i64)) lane_expr(xs[1], t) else 0;
        (n > 0) && ((n <= lx.vregs().size) && lane_elem(o, ix, t))
      }))
    } else false
  };
  lane_slot(i64 s) => {
    d = -1;
    for(j : range(lane_arrs.size)) if(lane_arrs[j] == s) d = lane_data[j];
    d
  };
  // the value of instance is in the register of bands number d; the index of the first page is in the third
  lane_val(x0, type t, i64 d) => {
    x = tree(x0);
    rs = lx.vregs();
    r = rs[d];
    kc = ct_const(x);
    if(kc.size == 1) {
      put_bytes(cg.load_const(acc, if(t == f64) f64_bits(kc[0]) else kc[0]));
      put_bytes(cg.move_to_f64(r, acc));
      put_bytes(lx.broadcast(r));
    } else if(code_kind(x) == ast.name) {
      put_bytes(slot_ldf(r, env[var_of(x)].slot));
      put_bytes(lx.broadcast(r));
    } else if(code_kind(x) == ast.if) {
      ast.if{c0, a0, b0} = x;
      lane_val(lane_one(a0), t, d);
      lane_val(lane_one(b0), t, d + 1);
      c = tree(c0);
      ast.operation{_, cs, _} = c;
      tc = ty(cs[0]);
      lane_val(cs[0], tc, d + 2);
      lane_val(cs[1], tc, d + 3);
      gc = op_codegen(lx, c, array{tc, tc});
      put_bytes(gc(rs[d + 2], rs[d + 3]));
      put_bytes(lx.select(r, rs[d + 1], rs[d + 2]));
    } else {
      ast.operation{op, xs, _} = x;
      if(op == "[]") {
        put_bytes(slot_ld(second, lane_slot(var_of(xs[0]))));
        put_bytes(lx.load_index(r, second, third));
      } else if(xs.size == 1) {
        lane_val(xs[0], t, d);
        g = op_codegen(lx, x, array{t});
        put_bytes(g(r));
      } else {
        lane_val(xs[0], t, d);
        lane_val(xs[1], t, d + 1);
        g = op_codegen(lx, x, array{t, t});
        put_bytes(g(r, rs[d + 1]));
      }
    }
  };
  lane_gen(x0) => {
    x = tree(x0);
    if(code_kind(x) == ast.block) {
      ast.block{items, _, _} = x;
      for(y : items) lane_gen(y);
    } else {
      ast.operation{_, xs, _} = x;
      array{o, _} = index_parts(tree(xs[0]));
      s = var_of(o);
      wrote(env[s].slot);
      lane_val(xs[1], ty(xs[1]), 0);
      put_bytes(slot_ld(second, lane_slot(s)));
      put_bytes(lx.store_index(second, third, lx.vregs()[0]));
    }
  };
  lanes_loop(e) => {
    sh = if(gen_sub || fusing) array{} else lane_shape(e);
    if(sh.size == 3) {
      array{si, sx, sbd} = sh;
      v = env[sbd];
      ast.lambda{lps, lbody, lblock} = v.th;
      ast.parameter{pname, _, _, _, _, _, _} = lps[0];
      lc = if(lblock) v.th_ctx else ctx;
      lane_arrs = array{};
      lane_data = array{};
      in_lane = (g) => in_view(v.th_top, v.th_base, lc, v.th_ret, () => {
        put(jc_var{pname, jc_lane, env[si].slot, false, f, 0, 0, 0, 0});
        g()
      });
      if(in_lane(() => lane_stmt(lbody)) && (lane_arrs.size > 0)) {
        for(s : lane_arrs) { // before the cycle: array data; limit - smaller of n and sizes
          d = alloc(1);
          arr_data(acc, env[s].slot);
          put_bytes(slot_st(d, acc));
          lane_data.push(d);
        }
        lim = alloc(1);
        put_bytes(slot_ld(acc, env[sx].slot));
        put_bytes(slot_st(lim, acc));
        for(s : lane_arrs) {
          keep = label();
          arr_size(acc, env[s].slot);
          put_bytes(slot_ld(second, lim));
          jump_to(keep, 7, acc, second);
          put_bytes(slot_st(lim, acc));
          bind(keep);
        }
        head = label();
        done = label();
        bind(head);
        put_bytes(slot_ld(acc, env[si].slot));
        put_bytes(lx.step(acc));
        put_bytes(slot_ld(second, lim));
        jump_to(done, 7, acc, second); // i + width > limits - then the normal cycle
        put_bytes(slot_ld(third, env[si].slot));
        in_lane(() => lane_gen(lbody));
        put_bytes(slot_ld(acc, env[si].slot));
        put_bytes(lx.step(acc));
        put_bytes(slot_st(env[si].slot, acc));
        jump(head);
        bind(done);
        lane_loops += 1;
      }
    }
  };
  // operation node of the program - its code generator to the goal (codegen::eval)
  apply_op(e, type t, g) => {
    r = regs(t);
    g(r[0], r[1])
  };
  // xs.size is the postfix operator .size
  gen_size(xs) => {
    s = var_of(xs[0]);
    if((s < 0) || env[s].thunk) bad("обращение .size не к переменной");
    else if(arr_like(env[s].kind)) arr_size_of(acc, s, xs[0]);
    else if(env[s].kind == jc_range) put_bytes(slot_ld(acc, env[s].slot));
    else if(env[s].kind == str) str_size(acc, env[s].slot);
    else bad(".size не массива и не строки");
  };
  // line-variable (VM - cell address): length and bytes - by displacements of VM (step tail 10:
  // parse_int and parsing assistants were to the interpreter); the string does not change in place - the
  // data is read at each call (s = s + ... - a new line in the cell)
  str_size(i64 r, i64 sl) => {
    put_bytes(slot_ld(r, sl));
    put_bytes(cg.load32(r, r, s_len));
  };
  gen_str_index(e, i64 s, ix) => {
    gen(ix);
    if(!jit_proven(e)) {
      str_size(second, env[s].slot);
      jump_to(trap(1, e), 3, acc, second);
    }
    put_bytes(slot_ld(second, env[s].slot));
    put_bytes(cg.load(second, second, s_data));
    put_bytes(cg.load_byte_index(acc, second, acc));
  };
  // p.x - aggregate-variable p field: field number of type k (static); empty - not field
  field_slot(e) => if((code_kind(e) == ast.operation) && dotted(e)) {
    ast.operation{_, ys, _} = e;
    s = var_of(ys[0]);
    if((s < 0) || (env[s].thunk || (!is_handle(env[s].kind) || arr_like(env[s].kind)))) array{}
    else {
      k = field_index(env[s].kind, code_name(e));
      if(k < 0) array{} else array{s, k}
    }
  } else array{};
  // the address of the data fields of the aggregate fs[0] - to the register r; the field k - by displacement k * step + scalar
  fields_to(i64 r, i64 s) => {
    put_bytes(slot_ld(r, env[s].slot));
    put_bytes(cg.load(r, r, ag_data));
  };
  field_off(i64 k) => (k * ag_stride) + ag_scalar;
  gen_field(e, fs) => {
    t = ty(e);
    if((t == i64) || (t == f64)) {
      fields_to(acc, fs[0]);
      put_bytes(cg.load(acc, acc, field_off(fs[1])));
      if(t == f64) put_bytes(cg.move_to_f64(acc_f, acc));
    } else vm_or_bad(e, fmt"поле {t}");
  };
  gen_field_store(e, xs, fs) => {
    t = ty(xs[0]);
    if(((t == i64) || (t == f64)) && (ty(xs[1]) == t)) {
      wrote(env[fs[0]].slot);
      gen(xs[1]);
      if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
      fields_to(second, fs[0]);
      put_bytes(cg.store(second, field_off(fs[1]), acc));
    } else vm_or_bad(e, fmt"запись поля {t}");
  };
  gen_op(e) => {
    ast.operation{op, xs, post} = e;
    // operator declared in the block is a local function (tail of step 10): a suitable overload
    // is embedded as a call; no one is an embedded operation (also a candidate)
    ent = if(xs.size == 2) "infix" + op else if(post) "postfix" + op else "prefix" + op;
    local = (op != "[]") && ((op != ".size") && (!starts(op, ".") && (!assign_symbol(op) && (local_fns(ent).size > 0))));
    if(local && (choose_from(local_fns(ent), xs).size == 1)) gen_local_call(e, ent, xs);
    else if(op == "[]") gen_index_op(e, xs);
    else if(op == ".size") gen_size(xs);
    else if(field_slot(e).size == 2) gen_field(e, field_slot(e));
    else if(xs.size == 1) {
      t = ty(xs[0]);
      g = op_codegen(cg, e, array{t});
      if((op == "-") && (t == i64)) {
        gen(xs[0]);
        put_bytes(cg.negate(acc));
      } else if(!given(g)) vm_or_bad(e, fmt"нет кодогенератора {op} над {t}");
      else {
        gen(xs[0]);
        put_bytes(g(if(t == f64) acc_f else acc));
      }
    } else if((op == "=") && (code_kind(xs[0]) == ast.name)) {
      ast.name{name} = xs[0];
      assign(name, xs[1], false);
    } else if((op == "=") && (field_slot(xs[0]).size == 2)) gen_field_store(e, xs, field_slot(xs[0]));
    else if((op == "=") && (index_parts(xs[0]).size == 2)) { // xs[i] = v: value per stack, index, boundary, record
      array{o, ix} = index_parts(xs[0]);
      s = var_of(o);
      if((s < 0) || (env[s].thunk || !arr_like(env[s].kind))) bad("запись не в элемент массива-переменной");
      else {
        t = ty(xs[1]);
        if(!is_arr(arr_type(s, o)) || (t != elem(arr_type(s, o)))) bad("тип элемента");
        wrote(env[s].slot);
        gen(xs[1]);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.push_tmp(acc));
        depth += 1;
        gen(ix);
        checked(s, xs[0]);
        put_bytes(cg.pop_tmp(third));
        depth -= 1;
        put_bytes(cg.store_index(second, acc, third));
      }
    } else if(((op == "+=") || ((op == "-=") || ((op == "*=") || (op == "/=")))) && (code_kind(xs[0]) == ast.name)) {
      s = var_of(xs[0]);
      if((s < 0) || env[s].thunk) bad("составное присваивание");
      else {
        t = if(env[s].kind == jc_ref) ref_elem(s) else env[s].kind;
        g = op_codegen(cg, e, array{t, t}); // a op = b - cogenerator op
        if(!given(g) || ((op == "/=") && (t != f64))) bad(fmt"{op} над {t}");
        else if((t == i64) && (known_g(cg, e, xs[1]).size == 1)) {
          gen(xs[0]);
          gk = known_g(cg, e, xs[1])[0];
          put_bytes(gk(acc, imm_of(xs[1], op)[0]));
          store_var(s, t);
        } else {
          operands(xs[0], xs[1], t);
          put_bytes(apply_op(e, t, g));
          store_var(s, t);
        }
      }
    } else if((op == "&&") || (op == "||")) { // short logic - transitions
      l = label();
      gen(xs[0]);
      if(op == "&&") jump_unless(acc, l) else jump_if(acc, l);
      gen(xs[1]);
      bind(l);
    } else {
      t = ty(xs[0]);
      ot = if(t == bool) i64 else t; // --- and!= over bool - the same bits
      g = op_codegen(cg, e, array{ot, ot});
      if(!given(g)) vm_or_bad(e, fmt"нет кодогенератора {op} над {t}");
      else if(ty(xs[1]) != t) bad("типы операндов");
      else if(((op == "/") || (op == "%")) && (ot == i64)) { // zero-trap
        operands(xs[0], xs[1], ot);
        fix_ops.push(e);
        jump_to(trap(2, e), 4, 0, fix_ops.size - 1);
      } else if((ot == i64) && (known_g(cg, e, xs[1]).size == 1)) {
        gen(xs[0]);
        gk = known_g(cg, e, xs[1])[0];
        put_bytes(gk(acc, imm_of(xs[1], op)[0]));
      } else {
        operands(xs[0], xs[1], ot);
        put_bytes(apply_op(e, ot, g));
      }
    }
  };
  // a.f(b) , f(a, b) if a has no field f
// call with the first argument a; aggregate - VM (field function)
  dotted(callee) => (code_kind(callee) == ast.operation) && {
    ast.operation{op, ys, post} = callee;
    post && ((ys.size == 1) && (code_name(callee) != ""))
  };
  gen_call(e) => {
    ast.call{callee, xs1, _, _, _, _, _} = e;
    xs0 = xs1;
    for(x : jit_implicit_args(e)) xs0.push(x); // Implicit parameters (O9): names at the call location
    if(dotted(callee)) {
      ast.operation{_, ys, _} = callee;
      if(is_handle(ty(ys[0])) && !arr_like(ty(ys[0]))) vm_or_bad(e, "вызов через точку у агрегата");
      else {
        args = array{ys[0]};
        for(x : xs0) args.push(x);
        gen_named_call(e, code_name(callee), args);
      }
    } else gen_named_call(e, callee_name(callee), xs0);
  };
  gen_named_call(e, str name, xs) => {
    kc = jit_const(e, ctx);
    v = find(name);
    if(kc.size == 1) gen_const(kc[0]);
    else if(name == "") bad("вызов значения");
    else if((v < 0) && (local_fns(name).size > 0)) gen_local_call(e, name, xs);
    else if((v >= 0) && env[v].thunk) call_block(env[v], xs);
    else if(v >= 0) bad("значение-функция");
    else if((name == "f64") && ((xs.size == 1) && (ty(xs[0]) == i64))) {
      gen(xs[0]);
      put_bytes(cg.to_f64(acc_f, acc));
    } else if((name == "i64") && ((xs.size == 1) && (ty(xs[0]) == f64))) {
      gen(xs[0]);
      put_bytes(cg.to_i64(acc, acc_f));
    } else if((name == "range") && ((xs.size == 1) && (ty(xs[0]) == i64))) gen(xs[0]); // range(n) - boundary
    else if((name == "intercept") && (xs.size == 2)) gen_intercept(xs);
    else if((name == "alloc_in") && (xs.size == 2)) gen_alloc_in(e, xs);
    else if((name == "fiber_start") && (xs.size == 1)) gen_spawn(e, xs[0]);
    else if(name == "print") gen_print(e, xs);
    else if((name == "index") && (xs.size == 2)) gen_index_of(e, xs[0], xs[1]); // nucleus a[i]
    else if((name == "append") && (xs.size == 2)) gen_append(e, xs[0], xs[1]);
    else if(name == "hide") {} // Hiding the name - only when compiling
    else if(ct_state_op(name)) bad(fmt"{name}: ct-состояние — интерпретатор");
    else if(((name == "require") || (name == "assume")) && (xs.size == 1)) jump_cond(xs[0], false, trap(3, e)); // require(c) , assume(c) - kernel calls: broken - error 3
    else if((name == "stream_new") || ((name == "stream_write") || ((name == "stream_read") || ((name == "stream_more") || ((name == "stream_close") || ((name == "yield") && (xs.size == 0))))))) gen_stream(e, name, xs);
    else if((name == "is_index") && (xs.size == 2)) {
      s = var_of(xs[1]);
      if((s < 0) || env[s].thunk) bad("is_index не над переменной");
      else {
        gen(xs[0]);
        if(env[s].kind == jc_range) put_bytes(slot_ld(second, env[s].slot));
        else arr_size_of(second, s, xs[1]);
        put_bytes(cg.is_index(acc, second));
      }
    } else gen_inline(e, name, xs);
  };
  // Flow operation - VM service (address - in the field of arguments, not in the code): op,
  // stream number, value bits, (type << 32) | node; response - value and error sign
  jt_code(type t) => if(t == i64) 1 else if(t == f64) 2 else if(t == bool) 3 else if(t == array(i64)) 4 else if(t == array(f64)) 5 else 0;
  gen_stream(e, str name, xs) => {
    op = if(name == "stream_new") 0 else if(name == "stream_write") 1 else if(name == "stream_read") 2 else if(name == "stream_more") 3 else if(name == "stream_close") 4 else 5;
    carried = unit;
    if(fusing && !in_b) sink(e, op, xs);
    else if(tries.size > 0) bad("операция потока внутри try");
    else if(op == 0) {
      if((xs.size != 1) || (ty(xs[0]) != i64)) bad("stream_new(ёмкость i64)");
      gen(xs[0]);
      put_bytes(cg.move(ca2, acc));
      put_bytes(cg.load_const(ca1, 0));
    } else if(op != 5) {
      st = ty(xs[0]);
      if(!is_stream(st)) bad(fmt"не поток известного типа: {st}");
      else if(op == 1) {
        carried = elem(st);
        gen(xs[0]);
        put_bytes(cg.push_tmp(acc));
        depth += 1;
        if(ty(xs[1]) != carried) bad("тип записи ≠ типу потока");
        gen(xs[1]);
        if(carried == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.move(ca2, acc));
        put_bytes(cg.pop_tmp(ca1));
        depth -= 1;
      } else {
        gen(xs[0]);
        put_bytes(cg.move(ca1, acc));
        if(op == 2) carried = elem(st);
      }
    }
    if(ok && !(fusing && !in_b)) vm_service(op, carried, e);
  };
  // print(x, …) - VM service (memory and output - VM, author's decision 2026-10-01): scalar - op 6 with
  // value and type, string literal - op 7 on node; ca1 & 1 - last
  gen_print(e, xs) => {
    if(tries.size > 0) bad("print внутри try");
    else if(fusing && !in_b) bad("генератор: print");
    else if(xs.size == 0) {
      mem_to(ca1);
      vm_service_code(6, 1 << 8, e);
    } else {
      simple = true;
      for(x : xs) if((code_kind(x) != ast.string) && !scalar(ty(x))) simple = false;
      if(!simple) vm_or_bad(e, "print значения VM");
      else {
        for(i : range(xs.size)) if(ok) gen_print_arg(e, xs[i], if((i + 1) == xs.size) 1 else 0);
      }
    }
  };
  gen_print_arg(e, x, i64 last) => {
    if(code_kind(x) == ast.string) {
      mem_to(ca1);
      vm_service_code(7, last << 8, x);
    } else {
      t = ty(x);
      if((t != i64) && ((t != f64) && (t != bool))) bad(fmt"print значения {t}");
      else {
        gen(x);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.move(ca2, acc));
        mem_to(ca1);
        vm_service_code(6, jt_code(t) | (last << 8), e);
      }
    }
  };
  // Memory address of the call context to register r (from the field of arguments)
  mem_to(i64 r) => {
    put_bytes(slot_ld(r, args_slot));
    put_bytes(cg.load(r, r, 8 * (ap + 5)));
  };
  vm_service(i64 op, type carried, e) => vm_service_code(op, jt_code(carried), e);
  // code: тип (биты 0–7) и флаги (8 — последний аргумент print)
  vm_service_code(i64 op, i64 code, e) => {
    put_bytes(cg.load_const(ca3, (code << 32) | code_id(e)));
    put_bytes(slot_ld(acc, args_slot));
    put_bytes(cg.load(acc, acc, 8 * (ap + 4)));
    put_bytes(cg.load_const(ca0, op));
    pad = (depth % 2) == 1; // stack host - 16 bytes each
    spill();
    if(pad) put_bytes(cg.stack_alloc(8));
    put_bytes(cg.call_reg(acc));
    if(pad) put_bytes(cg.stack_free(8));
    reload();
    jump_if(cret2, trap(6, e));
    if(((code & 255) == 2) && (op == 2)) put_bytes(cg.move_to_f64(acc_f, acc)); // read the f64 stream
  };
  // parameters of the embedded function: expr - the code of the caller, the place - alias, otherwise - the value in the slot
  bind_args(ps, xs) => {
    binds = array{};
    for(i : range(ps.size)) {
      ast.parameter{pname, _, mode, _, _, _, _} = ps[i];
      a = xs[i];
      s = var_of(a);
      if((mode == 4) || (code_kind(a) == ast.lambda)) binds.push(jc_var{pname, unit, 0, true, a, ctx, top, base, cur}); // lambda - definition code
      else if((s >= 0) && env[s].thunk) { // The caller code is the same code
        w = env[s];
        binds.push(jc_var{pname, w.kind, w.slot, true, w.th, w.th_ctx, w.th_top, w.th_base, w.th_ret});
      } else if((s >= 0) && ((mode != 2) && (env[s].kind == jc_ref))) {
        w = env[s];
        binds.push(jc_var{pname, jc_ref, w.slot, false, w.th, 0, w.th_top, 0, 0}); // reference
      } else if((s >= 0) && ((mode != 2) && !env[s].thunk)) {
        w = env[s];
        // resource - alias : transfer from the parameter decides and use in the caller (through
        // the embedding chain) - the interpreter knows this
        if(jit_resource(w.kind)) bad(fmt"ресурс-алиас аргументом {pname} — интерпретатор");
        binds.push(jc_var{pname, w.kind, w.slot, false, f, 0, 0, 0, 0}); // alias seat
      } else {
        t = if(is_call_of(a, "range")) jc_range else ty(a);
        if(jit_resource(t)) bad(fmt"ресурс аргументом {pname} (own или временное) — интерпретатор");
        else if(!scalar(t) && ((t != jc_range) && !is_handle(t))) bad(fmt"аргумент {pname} типа {t}");
        gen(a);
        sl = alloc(1);
        store_slot(t, sl);
        binds.push(jc_var{pname, t, sl, false, f, 0, 0, 0, 0});
      }
    }
    binds
  };
  // Call of the local function - semantic inlining in lexical form of its announcement:
  // captured names - places of the encompassing function
// recursion is the next step.
  local_fns(str nm) => {
    gs = array{};
    for(l : lfns) if(l.name == nm) gs.push(l.f);
    gs
  };
  gen_local_call(e, str name, xs) => {
    g = choose_from(local_fns(name), xs);
    rec = false;
    if(g.size == 1) {
      k = cur;
      while(k >= 0) {
        if(code_id(fr_fn[k]) == code_id(g[0])) rec = true;
        k = fr_parent[k];
      }
    }
    if(g.size != 1) bad(fmt"локальная функция {name}: нет перегрузки");
    else if(rules_in(g[0])) bad(fmt"вызов {name}: правила тела для блоков конструкции — интерпретатор");
    else if(rec) call_sub(e, name, g[0], xs);
    else {
      lf = lfns[0];
      for(l : lfns) if(code_id(l.f) == code_id(g[0])) lf = l;
      lres.push(array{code_id(g[0]), ty(e)});
      ast.function{_, ps, _, body, _, _, _, _, _} = g[0];
      binds = bind_args(ps, xs); // argumentation
      if(ok) {
        exit = label();
        saved = array{};
        for(i : range(top)) saved.push(env[i]);
        old_top = top;
        old_base = base;
        old_ctx = ctx;
        old_cur = cur;
        top = lf.top; // Type of Advertisement: What You Seen in Its Place
        base = lf.base;
        for(b : binds) put(b);
        ctx = inline_context(old_ctx, e);
        fr_fn.push(g[0]);
        fr_exit.push(exit);
        fr_parent.push(old_cur);
        cur = fr_fn.size - 1;
        gen(body);
        bind(exit);
        fr_fn = drop_last(fr_fn);
        fr_exit = drop_last(fr_exit);
        fr_parent = drop_last(fr_parent);
        for(i : range(saved.size)) env[i] = saved[i];
        top = old_top;
        base = old_base;
        ctx = old_ctx;
        cur = old_cur;
      }
    }
  };
