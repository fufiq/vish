      // caller (body for) is generated in its chain, and not inside the built-in structure
      k = cur;
      while(k >= 0) {
        if(code_id(fr_fn[k]) == code_id(g[0])) rec = true;
        k = fr_parent[k];
      }
    }
    ps = array{};
    body = e;
    is_outline = true;
    if(g.size == 1) {
      ast.function{_, gps, _, gbody, g_outline, _, _, _, _} = g[0];
      ps = gps;
      body = gbody;
      is_outline = g_outline;
    }
    if((g.size == 0) || (rec || is_outline)) vm_or_bad(e, fmt"вызов {name}: нет встраиваемой перегрузки");
    // Primitive native "cpp" (text_range, text_byte...) - VM code, not the body in the language: the call
    // counts VM in place, the function around it is machine code (*mine*)
    else if(code_kind(body) == ast.native) vm_or_bad(e, fmt"вызов {name}: примитив native");
    // call without run-time - inputs parsing curled - the body in this place is not disassembled
    // (no types): the value of VM considers the entire VM as an interpreter when executed
    else if(is_handle(ty(e)) && jit_known(e, ctx)) vm_or_bad(e, fmt"вызов {name}: свёрнут разбором");
    else if(leading_require(body)) vm_or_bad(e, fmt"вызов {name}: ведущий require — выбор перегрузки по значениям");
    else if(rules_in(g[0])) bad(fmt"вызов {name}: правила тела для блоков конструкции — интерпретатор");
    else {
      fn = g[0];
      binds = bind_args(ps, xs);
      if(ok) {
        exit = label();
        old_top = top;
        old_base = base;
        old_ctx = ctx;
        old_cur = cur;
        base = top;
        for(b : binds) put(b);
        ctx = inline_context(ctx, e);
        fr_fn.push(fn);
        fr_exit.push(exit);
        fr_parent.push(cur);
        cur = fr_fn.size - 1;
        gen(body);
        bind(exit);
        fr_fn = drop_last(fr_fn);
        fr_exit = drop_last(fr_exit);
        fr_parent = drop_last(fr_parent);
        top = old_top;
        base = old_base;
        ctx = old_ctx;
        cur = old_cur;
      }
    }
  };
  // Tail challenge yourself (O5, step 13):
// - not call, but transition: new values - in slots
  // parameters (first in time: arguments read the old), at the beginning of the body; the stack does not grow.
  tail_self_with(xs) => {
    plain = res_live.size == 0;
    for(t : types) if(t == unit) plain = false; // compile-time - instance; via call
    if(!plain) return call_self_with(xs);
    k0 = alloc(xs.size);
    for(i : range(xs.size)) {
      if(is_arr(types[i])) {
        s = var_of(xs[i]);
        if((s < 0) || (env[s].thunk || (env[s].kind != types[i]))) bad("массив в хвостовой вызов себя");
        else put_bytes(slot_ld(acc, env[s].slot));
