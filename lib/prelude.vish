  // encompassing through the register): arguments - in C registers ABI, the result - in the battery
  call_sub(e, str name, fc, xs) => {
    ast.function{_, ps, _, _, _, _, _, _, _} = fc;
    kinds = array{};
    for(x : xs) kinds.push(ty(x));
    lf = lfns[0];
    for(l : lfns) if(code_id(l.f) == code_id(fc)) lf = l;
    si = -1;
    for(i : range(subs.size)) if((code_id(subs[i].f) == code_id(fc)) && same_types(subs[i].kinds, kinds)) si = i;
    regs4 = array{ca0, ca1, ca2, ca3};
    if(xs.size > 4) bad(fmt"рекурсия {name}: больше четырёх параметров");
    else if((tries.size > 0) || (fusing || (gens.size > 0))) bad(fmt"рекурсия {name} внутри try или генератора");
    else {
      for(k : kinds) if(!scalar(k) && !is_handle(k)) bad(fmt"рекурсия {name}: параметр {k}");
      for(p : ps) {
        ast.parameter{_, _, mode, _, _, _, _} = p;
        if(mode != 0) bad(fmt"рекурсия {name}: параметр не по значению");
      }
      if(si < 0) {
        snap = array{};
        for(i : range(lf.top)) snap.push(env[i]);
        for(v : snap) if(v.thunk) bad(fmt"рекурсия {name}: захватывает expr-параметр");
        subs.push(jc_sub{fc, kinds, snap, lf.base, ctx, label(), lfns}); // the context of the first embedding: there parsing observed the body
        si = subs.size - 1;
      }
      for(i : range(xs.size)) if(ok) {
        gen(xs[i]);
        if(kinds[i] == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.push_tmp(acc));
        depth += 1;
      }
      for(i : range(xs.size)) {
        put_bytes(cg.pop_tmp(regs4[(xs.size - 1) - i]));
        depth -= 1;
      }
      if(!gen_sub) put_bytes(cg.move(outer_r, frame)); // frame encompassing - subprogram
      pad = (depth % 2) == 1;
      spill();
      if(pad) put_bytes(cg.stack_alloc(8));
      jump_to(subs[si].entry, 5, 0, 0);
      if(pad) put_bytes(cg.stack_free(8));
      reload();
    }
  };
  same_types(xs, ys) => (xs.size == ys.size) && {
    r = true;
    for(i : range(xs.size)) if(xs[i] != ys[i]) r = false;
    r
  };
  gen_subroutine(sub) => {
    ast.function{_, ps, _, body, _, _, _, _, _} = sub.f;
    regs4 = array{ca0, ca1, ca2, ca3};
    w_env = env;
    w_top = top;
    w_base = base;
    w_ctx = ctx;
    w_cur = cur;
    w_depth = depth;
    w_loops = loops;
    w_lfns = lfns;
    lfns = sub.lfs; // local functions of the ad block
    bind(sub.entry);
    put_bytes(cg.frame_enter());
    put_bytes(cg.move(frame, stack));
    fa = out.size;
    put_bytes(frame_size(0));
    gen_sub = true;
    sub_n = 0;
    depth = 0;
    loops = array{};
    env = array{};
    top = 0;
    for(v : sub.envsnap) put(v);
    base = sub.base;
    for(i : range(ps.size)) {
      ast.parameter{pname, _, _, _, _, _, _} = ps[i];
      sl = alloc(1);
      put_bytes(slot_st(sl, regs4[i])); // bits (f64 - too)
      put(jc_var{pname, sub.kinds[i], sl, false, f, 0, 0, 0, 0});
