      saved_lf = lfns.size;
      blk_depth += 1;
      for(i : range(items.size)) if(ok) {
        x = items[i];
        gen(x);
        if(ok && (((i + 1) < items.size) || !hv) && temporary_resource(x)) drop_reg(acc, x); // cast-off
