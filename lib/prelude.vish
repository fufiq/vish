module prelude;

// Constructions written on top of the kernel (§3.2 steak): in the kernel - if,
// loop/break/continue, throw, intercept.
//  
// 
// 
//.

// Numbers and strings - tags above machine kernel representations (§5.8, O15; user
// solution 2026-10-11):
// 
// 
// The kernel knows representations ( bool, int64, float64,
// bytes), names and operations are here.
struct bool { __bool value; }
struct i64 { __int64 value; }
struct f64 { __float64 value; }
struct str { __bytes value; }

// kernel entries (§4.4): How to write kernel node and kernel calls - ads, not parser.
// 
// 
// 
// 
// 
// The body of the record is the node itself above its parts: ast.if{c, t, e} is the node
// of the kernel. §7.4), hide(x) - call the kernel; parsing builds this node, printing the
// node goes on the first suitable record. Parts: (x) - in brackets (close to the word -
// only closely), {x} - body: block or expression, {x}[[value]] x} is a slot value: the
// same, but {} in it is an empty literal, the type is from the place (*my:* marking the
// slot), the end of the instruction (or before }). From the forms with a common beginning
// selects the text in front. The nodes are the same: the interpreter, the machine, the
// JIT, the editor do not distinguish them; *my:* writing the node and calling the kernel
// is not a function.
//
syntax if (c) {then_} => ast.if{c, then_};
syntax if (c) {then_} else {else_} => ast.if{c, then_, else_};
syntax if (c) {then_}; else {else_} => ast.if{c, then_, else_}; // if(c) x = 1; else x = 2;
syntax loop {body} => ast.loop{body};
syntax break; => ast.break{};
syntax continue; => ast.continue{};
syntax return; => ast.return{};
syntax return {[[value]] value}; => ast.return{value};
// return(f) x - output from external f; return (x) through space - value
syntax return(target); => ast.return{_, target};
syntax return(target) {[[value]] value}; => ast.return{value, target};
// throw
syntax throw {[[value]] value} => ast.throw{value};
// Hide x - the name disappears from the area:
syntax hide {x} => hide(x);
// try_compile { … } — 
// 
syntax try_compile {body} => try_compile(body);

// Operators - entity language (§4.4): The announcement repeats the record: the parameters
// are on the side of their branches. There are no priorities - a chain with several trees
// is disassembled by types (ibid.); [[associative]] is an invariant from logic: a + b + c
// is one tree. The body from one built-in primitive is the VM operation (the interpreter
// and machine code execute it directly). Numbers - tags over machine primitives (O15,
// author's decision 2026-10-11), which operations have what type - ads here, by types:
//
//
//
// 
// No announcement for these types - no operation: i64 + f64 is an error until the program
// declares its operator (i64 a) + (f64 b). *My: * The primitive operator has only "type
// equal."
[[associative]] operator (i64 a) + (i64 b) => add(a, b);
[[associative]] operator (f64 a) + (f64 b) => add(a, b);
[[associative]] operator (str a) + (str b) => add(a, b);
operator (i64 a) - (i64 b) => sub(a, b);
operator (f64 a) - (f64 b) => sub(a, b);
[[associative]] operator (i64 a) * (i64 b) => mul(a, b);
[[associative]] operator (f64 a) * (f64 b) => mul(a, b);
operator (i64 a) / (i64 b) => div(a, b);
operator (f64 a) / (f64 b) => div(a, b);
operator (i64 a) % (i64 b) => rem(a, b);
operator (i64 a) == (i64 b) => eq(a, b);
operator (f64 a) == (f64 b) => eq(a, b);
operator (str a) == (str b) => eq(a, b);
operator (bool a) == (bool b) => eq(a, b);
operator (type a) == (type b) => eq(a, b);
operator (i64 a) != (i64 b) => ne(a, b);
operator (f64 a) != (f64 b) => ne(a, b);
operator (str a) != (str b) => ne(a, b);
operator (bool a) != (bool b) => ne(a, b);
operator (type a) != (type b) => ne(a, b);
operator (i64 a) < (i64 b) => lt(a, b);
operator (f64 a) < (f64 b) => lt(a, b);
operator (i64 a) > (i64 b) => gt(a, b);
operator (f64 a) > (f64 b) => gt(a, b);
operator (i64 a) <= (i64 b) => le(a, b);
operator (f64 a) <= (f64 b) => le(a, b);
operator (i64 a) >= (i64 b) => ge(a, b);
operator (f64 a) >= (f64 b) => ge(a, b);
[[associative]] operator (bool a) && (expr bool b) => and(a, b);
[[associative]] operator (bool a) || (expr bool b) => or(a, b);
operator -(i64 a) => neg(a);
operator -(f64 a) => neg(a);

// Number transformations - announcements by types, as operators (M6, author’s decision 2026-10-10-10):
// VM - machine int_to_float / float_to_int. i64 → f64 and f64 → i64 (whole part) - a clear call;
// f64(2.5) - f64 already, i64(2) - i64 already.
f64(i64 x) => int_to_float(x);
f64(f64 x) => x;
i64(f64 x) => float_to_int(x);
i64(i64 x) => x;

// i64 bits for encoding instructions in language (§10.4)
[[associative]] operator (i64 a) & (i64 b) => band(a, b);
[[associative]] operator (i64 a) | (i64 b) => bor(a, b);
[[associative]] operator (i64 a) ^ (i64 b) => bxor(a, b);
operator (i64 a) << (i64 b) => shl(a, b);
operator (i64 a) >> (i64 b) => shr(a, b);
operator !(bool a) => not(a);
// a[i] is a pair operator: overload to its
// types - Place (a[i] = v) is the shape of
// the nucleus.
operator (a)[i] => index(a, i);
// try(x) caller: "growth macaque try" without macro; operator frame is transparent for
// return(caller) - exit from the one who wrote x?
operator (expr e)? => try(e);

// Operator Print (§4.4, variant C): brackets around the operand select this code rather than
// projection VM - There are no Priorities, so any nested infix and if, except the left operand
// of the same associative operator, have brackets (a + b + c is one tree). kind - type of
// operand: "infix", "chain" (chain; op - its operator, if one), "if" or "; assoc - is
// associative op of the parent in place. The function only selects and should be pure; the
// error is bracketed (conservatively). It is closer to the place (or in projection).
//
//
operand_parens(str kind, str op, bool left, str parent_op, bool assoc) =>
  (kind == "if") || (((kind == "infix") || (kind == "chain")) && !(left && (assoc && ((op != "") && (op == parent_op)))));

// while(c) body - the condition is calculated on each iteration (expr).
while(expr c, expr body) {
  loop {
    if(!c) break;
    body;
  }
}

// for(x : xs) body - by array or range. The index becomes safe after checking
// is_index.
// 
// Step to the body: continue in the body does
// not miss it.
for(xs, expr body) {
  i = 0;
  loop {
    if(!is_index(i, xs)) break;
    k = i;
    i = i + 1;
    body(xs[k]);
  }
}

// try { … } catch(E e) { … } … — 
// 
// catch. intercept selects the first block whose parameter takes the value thrown.
//
try(expr body) catch(expr... handlers) => intercept(body, handlers);

// push(xs, x) - Array growth: the “relocate” effect - the buffer can move. Whether
// it breaks links, decides the model of the reference pointer (below): by default,
// no ( ).
//
[[relocates(xs)]] push(mut xs, x) => append(xs, x);

// Reference supports (§12.1) - code analysis in the language: ct-state + require.
// 
// 
// The support is the ct state of the array: the generation of effects that break links, and where it
// changed; the link remembers the generation and where it is taken. Hooks parsing (my): the kernel in
// parsing causes ref_taken when taking &e = xs[i] (and the element in the variable parameter), ref_used
// when each use; [[g(…)]] in the function where g is a function is the hook of its call. In the
// executable code they are not: when executing, the link is the place (base and index), the transfer of
// VM memory is not visible to it; there is no element - out_of_bounds.
//
//
// Indicator models:
// 
// 
// The operation on the support announces the effect group ([[effect(xs, "relocate")]] or its attribute
// function, as relocates); the model - which groups break the link. Model - at the support (ct-state),
// the program specifies: with_model(xs, m). By default, the link is the base and the index, the growth
// and replacement of the array does not completely break it; they call the model that the program
// chose. pin(xs) is data in its address range (for host addresses).
//
//
struct pointer_model { str name; array breaks; }
// by default:
model_stable() => pointer_model{"stable", array{}};
// at the choice of the program: a link - like a cherry pointer in a buffer, growth and replacement of it break
model_moving() => pointer_model{"moving", array{"relocate", "replace"}};
// Infinite vector: addresses, data does not move
model_pinned() => pointer_model{"pinned", array{}};
breaks(pointer_model m, str e) {
  hit = false;
  for(b : m.breaks) if(b == e) hit = true;
  hit
}
struct ref_anchor { i64 gen; code at; pointer_model model; }
// gen-1 - references to it were not taken or the array was completely replaced
anchor_of(xs) => ct_state(xs, ref_anchor{-1, code(), model_stable()});
// the effect of group e over the support: breaks links if the support model does not tolerate it
effect(mut xs, str e) {
  a = anchor_of(xs);
  if(a.gen >= 0 && breaks(a.model, e)) set_ct_state(xs, ref_anchor{a.gen + 1, call_site(), a.model});
}
relocates(mut xs) => effect(xs, "relocate");
// Support model - hook parsing : when performing the body is not (pin - only the core pin_storage )
set_model(mut xs, pointer_model m) => set_ct_state(xs, ref_anchor{anchor_of(xs).gen, anchor_of(xs).at, m});
[[set_model(xs, m)]] with_model(mut xs, pointer_model m) {}
[[set_model(xs, model_pinned())]] pin(mut xs) => pin_storage(xs);
ref_taken(mut xs) {
  a = anchor_of(xs);
  if(a.gen < 0) set_ct_state(xs, ref_anchor{0, call_site(), a.model});
  ref_anchor{anchor_of(xs).gen, call_site(), a.model}
}
// entire array replaced (backbone again, gen-1) - the effect of "replace": breaks if it is called the
// model from which the link was taken
ref_used(xs, ref_anchor r) => require(if(anchor_of(xs).gen < 0) !breaks(r.model, "replace") else anchor_of(xs).gen == r.gen,
  "ссылка на элемент использована после инвалидации опоры (опасное-опасное)",
  "ссылка взята здесь", r.at, "опора инвалидирована здесь", if(anchor_of(xs).gen < 0) r.at else anchor_of(xs).at);

// [[inside(g)]] f(…) - entity exists only in the blocks of the g structure.
// 
// 
// Hook parsing: Call location is a block, tail, or g call clause up to the function boundary.
// parsing also runs before launch, so no:
//
//
inside(expr g) {
  site = call_site();
  require(in_blocks_of(site, code_name(code(g))),
    code_name(site) + " существует только внутри блоков " + code_name(code(g)));
}
// place c - inside the block of the call g (go to the root before the function is declared)
in_blocks_of(c, str g) {
  at = c;
  up = code_parent(c);
  found = false;
  done = false;
  while(!done && given(up)) {
    if(code_kind(up) == ast.function) done = true;
    else if(block_of_call(up, at, g)) {
      found = true;
      done = true;
    }
    at = up;
    up = code_parent(up);
  }
  found
}
// c - block argument g: block, block lambda, pack clause or tail
block_of_call(cl, c, str g) => (code_kind(cl) == ast.call) && {
  ast.call{callee, xs, _, tail, _, _, _} = cl;
  arg = false;
  for(x : xs) if(code_id(x) == code_id(c)) arg = true;
  last = (xs.size > 0) && (code_id(xs[xs.size - 1]) == code_id(c));
  (code_kind(callee) == ast.name) && ((code_name(callee) == g) && (arg && ((tail && last) || (is_code_block(c) || is_clause_pack(c)))))
};
is_code_block(c) => (code_kind(c) == ast.block) || ((code_kind(c) == ast.lambda) && {
  ast.lambda{_, _, block} = c;
  block
});
is_clause_pack(c) => (code_kind(c) == ast.construct) && {
  ast.construct{t, items, _} = c;
  all = (items.size > 0) && (given(t) && ((code_kind(t) == ast.name) && (code_name(t) == "array")));
  for(x : items) if(!is_code_block(x)) all = false;
  all
};

// Control of extensions (§9.1): [[extension(g)]] at the module or announcement g (extension,
// substance) Executed when parsing for each extension of the entity (overload, field, &f, syntax
// record, operator, using operator), the solution - requires.
// 
// 
// *My:* checks are below - library, not rule VM; module node - code_module(c).
//
same_module(a, b) => code_id(code_module(a)) == code_id(code_module(b));
module_title(c) => {
  n = code_name(code_module(c));
  if(n == "") "программы" else n
};
// It is possible, it is not possible (formerly sealed by the library)
own_only(ext, entity) => require(same_module(ext, entity),
  code_name(entity) + ": расширять сущности модуля " + module_title(entity) + " можно только в нём (own_only)",
  "сущность объявлена здесь", entity);
// conditional test: someone else's extension - only for the types of its module
// (overload parameters, expansion field Name { … });
same_module_types(ext, entity) => require(same_module(ext, entity) || uses_module_type(ext, code_module(ext)),
  code_name(entity) + ": расширение сущности модуля " + module_title(entity) + " из модуля " + module_title(ext) + " — только для типов своего модуля (same_module_types)",
  "сущность объявлена здесь", entity);
// type t - struct declared in modulus m
module_declares(m, str t) {
  found = false;
  for(x : code_items(m))
    if(code_kind(x) == ast.extension) {
      ast.extension{name, _, _, _, of, _} = x;
      if((of == "struct") && (name == t)) found = true;
    }
  found
}
declared_in(t, m) => given(t) && ((code_kind(t) == ast.name) && module_declares(m, code_name(t)));
uses_module_type(c, m) {
  found = false;
  if(code_kind(c) == ast.function) {
    ast.function{_, params, _, _, _, _, _, _, _} = c;
    for(p : params) {
      ast.parameter{_, t, _, _, _, _, _} = p;
      if(declared_in(t, m)) found = true;
    }
  } else if(code_kind(c) == ast.variable) {
    ast.variable{_, t, _, _, _, _, _, _} = c;
    found = declared_in(t, m);
  } else if(code_kind(c) == ast.extension) {
    for(x : code_items(c)) if(uses_module_type(x, m)) found = true;
  }
  found
}

// Checked { … } - context: i64 arithmetic with overflow check for everything that is performed
// inside the block, including the evoked functions (their instance is their own for the context):
// . with_alloc(r) { … } - the memory level selects the program: values created in the body - in r
// (§12.2): "well yes"; without context - the level of the caller (). r = region - a new level.
//
//
//
//
with_alloc(region r, expr body) => alloc_in(r, body);

checked(expr body) {
  using operator (i64 a) + (i64 b) => add_checked(a, b);
  using operator (i64 a) - (i64 b) => sub_checked(a, b);
  using operator (i64 a) * (i64 b) => mul_checked(a, b);
  body
}

// code generation is the context of the goal (§10.4):
// 
// 
// 
// In the context of the goal, the operation is its machine code (bytes) over the JIT
// register model: the first operand is a battery, the second is a register of the second
// operand, the result is in the battery. JIT takes code generator from the database; it's
// not here - built-in (C++, bootstrap). Language coding. x86-64: REX.W, operation code,
// ModRM "register, register" (reg - src, r / m - dst); with the prefix 0F - reg - dst.
// AArch64: the word junior byte forward. Register numbers are the target encoding; they
// are given by JIT (the first operand is the battery, the second is the register of the
// second operand). *My:* registers with code generator parameters.
//
x64_rr(i64 op, i64 dst, i64 src) => array{0x48 | ((src >> 3) << 2) | (dst >> 3), op, 0xC0 | ((src & 7) << 3) | (dst & 7)};

x64_0f(i64 op, i64 dst, i64 src) => array{0x48 | ((dst >> 3) << 2) | (src >> 3), 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)};

// shift to cl: second operand - rcx (JIT registration model)
x64_shift(i64 ext, i64 dst) => array{0x48 | (dst >> 3), 0xD3, 0xC0 | (ext << 3) | (dst & 7)};

// comparison → 0/1 in a: cmp a, b; setcc; movzx (cc - condition x86: e 4, ne 5, l C, ge D, le E, g F)
x64_cmp(i64 cc, i64 a, i64 b) => array{...x64_rr(0x39, a, b), 0xF, 0x90 | cc, 0xC0 | a, ...x64_0f(0xB6, a, a)};

// SSE "register, register" over xmm: prefix, [REX], 0F, operation code, ModRM (reg - dst)
x64_sse(i64 prefix, i64 op, i64 dst, i64 src) => if((dst | src) > 7) array{prefix, 0x40 | ((dst >> 3) << 2) | (src >> 3), 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)} else array{prefix, 0xF, op, 0xC0 | ((dst & 7) << 3) | (src & 7)};

x64_rel32(i64 off) => array{off & 0xFF, (off >> 8) & 0xFF, (off >> 16) & 0xFF, (off >> 24) & 0xFF};

// conditional transition compared to: cmp a, b; jcc t (t - offset from the beginning of these bytes)
x64_jcc(i64 cc, i64 a, i64 b, i64 t) => array{...x64_rr(0x39, a, b), 0xF, 0x80 | cc, ...x64_rel32(t - 9)};

// with the known second operand (imm32): op r, v (ext - /0 add, /5 sub, /4 and, 1 or, /6 xor, /7 cmp);
// imul r, r, v; shift r to v; cmp a, v; jcc t
x64_ri(i64 ext, i64 r, i64 v) => array{0x48 | (r >> 3), 0x81, 0xC0 | (ext << 3) | (r & 7), ...x64_rel32(v)};
x64_imul_i(i64 r, i64 v) => array{0x48 | ((r >> 3) << 2) | (r >> 3), 0x69, 0xC0 | ((r & 7) << 3) | (r & 7), ...x64_rel32(v)};
x64_shift_i(i64 ext, i64 r, i64 v) => array{0x48 | (r >> 3), 0xC1, 0xC0 | (ext << 3) | (r & 7), v & 63};
x64_jcc_i(i64 cc, i64 a, i64 v, i64 t) => array{...x64_ri(7, a, v), 0xF, 0x80 | cc, ...x64_rel32(t - 13)};

// Memory x86-64: [base + disp32] (mod 10; rsp/r12 via SIB 0x24); REX - only if not empty
// (as in assembler).
x64_rex(i64 w, i64 r, i64 x, i64 b) => {
  v = 0x40 | (w << 3) | ((r >> 3) << 2) | ((x >> 3) << 1) | (b >> 3);
  if(v == 0x40) array{} else array{v}
};

x64_mem(i64 r, i64 base, i64 disp) => array{0x80 | ((r & 7) << 3) | (base & 7), ...(if((base & 7) == 4) array{0x24} else array{}), ...x64_rel32(disp)};

x64_rm(i64 op, i64 r, i64 base, i64 disp) => array{...x64_rex(1, r, 0, base), op, ...x64_mem(r, base, disp)};

x64_sse_rm(i64 prefix, i64 op, i64 r, i64 base, i64 disp) => array{prefix, ...x64_rex(0, r, 0, base), 0xF, op, ...x64_mem(r, base, disp)};

x64_u64(i64 v) => array{v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF, (v >> 32) & 0xFF, (v >> 40) & 0xFF, (v >> 48) & 0xFF, (v >> 56) & 0xFF};

// [base + index * 8]: ModRM 00 r 100 + SIB 11 index base; base rbp/r13 - via disp8 = 0
// (mod 01) [base + index]: SIB with scale 1 - bytes of string (row - bytes, §4.0 )
//
x64_sib1(i64 r, i64 base, i64 index) => if((base & 7) == 5) array{0x44 | ((r & 7) << 3), ((index & 7) << 3) | (base & 7), 0x0} else array{0x4 | ((r & 7) << 3), ((index & 7) << 3) | (base & 7)};
x64_sib(i64 r, i64 base, i64 index) => if((base & 7) == 5) array{0x44 | ((r & 7) << 3), 0xC0 | ((index & 7) << 3) | (base & 7), 0x0} else array{0x4 | ((r & 7) << 3), 0xC0 | ((index & 7) << 3) | (base & 7)};

// f64 (ucomisd): with NaN everything except != is false; result is 0/1 in acc
x64_set(i64 cc, i64 r) => array{0xF, 0x90 | cc, 0xC0 | r};

x64_fcmp(i64 cc, i64 a, i64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(cc, acc), ...x64_0f(0xB6, acc, acc)};

// / and % with a trap (fault - shift from the beginning of these bytes to the dividing
// trap by zero): test b, b; je fault; cmp b, -1; jne ordinary; (neg a | xor a, a); jmp
// end; ordinary: cqo; idiv b; [mov a, rdx]; end. INT_MIN / -1 is modular, without falling
// idiv. a is rax (cqo/idiv), rem is 1 for the remainder.
x64_divmod(i64 a, i64 b, i64 fault, i64 rem) => array{...x64_rr(0x85, b, b), 0xF, 0x84, ...x64_rel32(fault - 9), 0x48 | (b >> 3), 0x83, 0xF8 | (b & 7), 0xFF, 0x75, 0x5, ...(if(rem == 1) x64_rr(0x31, a, a) else array{0x48 | (a >> 3), 0xF7, 0xD8 | (a & 7)}), 0xEB, 5 + (3 * rem), 0x48, 0x99, 0x48 | (b >> 3), 0xF7, 0xF8 | (b & 7), ...(if(rem == 1) x64_rr(0x89, a, 2) else array{})};

a64_word(i64 w) => array{w & 0xFF, (w >> 8) & 0xFF, (w >> 16) & 0xFF, (w >> 24) & 0xFF};

a64_rrr(i64 op, i64 d, i64 n, i64 m) => a64_word(op | (m << 16) | (n << 5) | d);

// Memory AArch64: offset -256..255 - ldur/stur, otherwise - through x16 (movz/movk) and
// register offset; from sp slots of 16 bytes - offset twice (as in assembler).
a64_imm64(i64 d, i64 v) => array{...a64_word(0xD2800000 | ((v & 0xFFFF) << 5) | d), ...(if(((v >> 16) & 0xFFFF) != 0) a64_word(0xF2A00000 | (((v >> 16) & 0xFFFF) << 5) | d) else array{}), ...(if(((v >> 32) & 0xFFFF) != 0) a64_word(0xF2C00000 | (((v >> 32) & 0xFFFF) << 5) | d) else array{}), ...(if(((v >> 48) & 0xFFFF) != 0) a64_word(0xF2E00000 | (((v >> 48) & 0xFFFF) << 5) | d) else array{})};

a64_mem(i64 unscaled, i64 regoff, i64 t, i64 base, i64 disp) => if((disp >= -256) && (disp <= 255)) a64_word(unscaled | ((disp & 0x1FF) << 12) | (base << 5) | t) else array{...a64_imm64(16, disp), ...a64_word(regoff | (16 << 16) | (base << 5) | t)};

a64_add_imm(i64 d, i64 s, i64 v) => if((v >= 0) && (v < 4096)) a64_word(0x91000000 | (v << 10) | (s << 5) | d) else if((v < 0) && (v > -4096)) a64_word(0xD1000000 | ((0 - v) << 10) | (s << 5) | d) else array{...a64_imm64(16, v), ...a64_word(0x8B206000 | (16 << 16) | (s << 5) | d)};

// fcmp a, b; cset acc (AArch64 condition: gt C, ge A; real flags)
a64_cset(i64 cc, i64 d) => a64_word(0x9A9F07E0 | ((cc ^ 1) << 12) | d);

a64_fcmp(i64 cc, i64 a, i64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(cc, acc)};

a64_scaled(i64 base, i64 disp) => if(base == 31) 2 * disp else disp;

a64_mov(i64 d, i64 s) => if((d == 31) || (s == 31)) a64_word(0x91000000 | (s << 5) | d) else a64_word(0xAA0003E0 | (s << 16) | d);

// / and % with a trap: cbz b, fault; sdiv (INT_MIN / -1 does not fall - modular); the
// remainder is msub through x16
a64_divmod(i64 a, i64 b, i64 fault, i64 rem) => array{...a64_word(0xB4000000 | (((fault >> 2) & 0x7FFFF) << 5) | b), ...(if(rem == 1) array{...a64_rrr(0x9AC00C00, 16, a, b), ...a64_word(0x9B008000 | (b << 16) | (a << 10) | (16 << 5) | a)} else a64_rrr(0x9AC00C00, a, a, b))};

// comparison → 0/1 in a: cmp a, b; cset a (cc - condition AArch64: eq 0, ne 1, ge A, lt B, gt C, le D)
// conditional transition compared to: cmp a, b; b.cc t (t - offset from the beginning of these bytes)
a64_bcc(i64 cc, i64 a, i64 b, i64 t) => array{...a64_word(0xEB00001F | (b << 16) | (a << 5)), ...a64_word(0x54000000 | ((((t - 4) >> 2) & 0x7FFFF) << 5) | cc)};

// with the known second operand: cmp a, v (imm12, otherwise through x16); b.cc t; shifts to v
a64_cmp_i(i64 a, i64 v) => if((v >= 0) && (v < 4096)) a64_word(0xF100001F | (v << 10) | (a << 5)) else array{...a64_imm64(16, v), ...a64_word(0xEB00001F | (16 << 16) | (a << 5))};
a64_bcc_i(i64 cc, i64 a, i64 v, i64 t) => {
  c = a64_cmp_i(a, v);
  array{...c, ...a64_word(0x54000000 | ((((t - c.size) >> 2) & 0x7FFFF) << 5) | cc)}
};
a64_lsl_i(i64 r, i64 v) => a64_word(0xD3400000 | (((64 - (v & 63)) & 63) << 16) | ((63 - (v & 63)) << 10) | (r << 5) | r);
a64_asr_i(i64 r, i64 v) => a64_word(0x9340FC00 | ((v & 63) << 16) | (r << 5) | r);

a64_cmp(i64 cc, i64 a, i64 b) => array{...a64_word(0xEB00001F | (b << 16) | (a << 5)), ...a64_word(0x9A9F07E0 | ((cc ^ 1) << 12) | a)};

amd64(expr body) {
  // register model: battery, second operands, their f64, argument base, frame, stack + arguments C
  // ABI (VM services) and second result register
  model() => array{0, 1, 0, 1, 7, 5, 4, 2, 7, 6, 2, 1, 2, 3}; // rax, rcx, xmm0, xmm1, rdi, rbp, rsp, rdx; rdi, rsi, rdx, rcx; rdx; rbx is a frame that surrounds the subroutine
  // Free registers for variables (scalars, classes i64 and f64): the compiler does not take them for
  // anything else; they are in memory for calls (see jit_compile: spill/reload).
  var_regs() => array{array{8, 9, 10, 11}, array{2, 3, 4, 5}}; // r8–r11, xmm2–xmm5
  // Temporary expressions without calls (the first operand, while the second is considered): rsi is
  // the argument of VM services, within such an expression is free; xmm6-xmm9.
  temp_regs() => array{array{6}, array{6, 7, 8, 9}};
  using operator (i64 a) + (i64 b) => x64_rr(0x1, a, b); // add
  using operator (i64 a) - (i64 b) => x64_rr(0x29, a, b); // sub
  using operator (i64 a) & (i64 b) => x64_rr(0x21, a, b); // and
  using operator (i64 a) | (i64 b) => x64_rr(0x9, a, b); // or
  using operator (i64 a) ^ (i64 b) => x64_rr(0x31, a, b); // xor
  using operator (i64 a) * (i64 b) => x64_0f(0xAF, a, b); // imul
  using operator (i64 a) << (i64 b) => x64_shift(4, a); // shl a, cl
  using operator (i64 a) >> (i64 b) => x64_shift(7, a); // sar a, cl
  move(i64 d, i64 s) => x64_rr(0x89, d, s); // mov d, s
  load(i64 d, i64 base, i64 disp) => x64_rm(0x8B, d, base, disp); // mov d, [base + disp]
  store(i64 base, i64 disp, i64 s) => x64_rm(0x89, s, base, disp); // mov [base + disp], s
  move_f64(i64 d, i64 s) => x64_sse(0x66, 0x28, d, s); // movapd d, s: register whole - no dependency on the old d (movsd merges the upper half)
  load_f64(i64 d, i64 base, i64 disp) => x64_sse_rm(0xF2, 0x10, d, base, disp);
  store_f64(i64 base, i64 disp, i64 s) => x64_sse_rm(0xF2, 0x11, s, base, disp);
  load_const(i64 d, i64 v) => array{0x48 | (d >> 3), 0xB8 + (d & 7), ...x64_u64(v)}; // movabs d, v
  load_index(i64 d, i64 base, i64 index) => array{...x64_rex(1, d, index, base), 0x8B, ...x64_sib(d, base, index)};
  load32(i64 d, i64 base, i64 disp) => array{...x64_rex(0, d, 0, base), 0x8B, ...x64_mem(d, base, disp)}; // mov d32, [base + disp]: higher bits are zeros
  load_byte_index(i64 d, i64 base, i64 index) => array{...x64_rex(0, d, index, base), 0xF, 0xB6, ...x64_sib1(d, base, index)}; // movzx d32, byte [base + index]
  store_index(i64 base, i64 index, i64 s) => array{...x64_rex(1, s, index, base), 0x89, ...x64_sib(s, base, index)};
  load_index_f64(i64 d, i64 base, i64 index) => array{0xF2, ...x64_rex(0, d, index, base), 0xF, 0x10, ...x64_sib(d, base, index)};
  store_index_f64(i64 base, i64 index, i64 s) => array{0xF2, ...x64_rex(0, s, index, base), 0xF, 0x11, ...x64_sib(s, base, index)};
  check_index(i64 k, i64 n) => array{...x64_rr(0x39, k, n), 0xF, 0x83, ...x64_rel32(fault - 9)}; // cmp k, n; jae fault
  jump() => array{0xE9, ...x64_rel32(target - 5)}; // jmp target
  jump_if(bool a) => array{...x64_rr(0x85, a, a), 0xF, 0x85, ...x64_rel32(target - 9)}; // test a, a; jne target
  jump_if_set(i64 base) => array{...x64_rex(1, 7, 0, base), 0x83, ...x64_mem(7, base, 0), 0x0, 0xF, 0x85, ...x64_rel32((target - 8) - (if((base & 7) == 4) 7 else 6))}; // cmp qword [base], 0; jne
  store_const(i64 base, i64 disp, i64 v) => array{...x64_rm(0xC7, 0, base, disp), ...x64_rel32(v)}; // mov qword [base + disp], imm32
  address(i64 d, i64 base, i64 disp) => x64_rm(0x8D, d, base, disp); // lea
  call_reg(i64 r) => if(r >= 8) array{0x41, 0xFF, 0xD0 | (r & 7)} else array{0xFF, 0xD0 | r}; // call r
  call_mem(i64 base, i64 disp) => array{...x64_rex(0, 2, 0, base), 0xFF, ...x64_mem(2, base, disp)}; // call qword [base + disp]
  call_self() => array{0xE8, ...x64_rel32(target - 5)}; // call target (beginning: recursion)
  frame_enter() => array{0x55}; // push rbp
  frame_leave() => array{0x5D}; // pop rbp
  frame_alloc(i64 n) => array{0x48, 0x81, 0xEC, ...x64_rel32(n)}; // sub rsp, n (size - second call)
  ret() => array{0xC3};
  is_index(i64 k, i64 n) => x64_cmp(0x2, k, n); // setb: 0 <= k < n by one unsigned comparison
  using operator !(bool a) => array{...x64_rex(1, 0, 0, a), 0x83, 0xF0 | (a & 7), 0x1}; // xor a, 1
  using operator -(f64 a) => array{0x48 | (acc >> 3), 0xB8 + (acc & 7), ...x64_u64(1 << 63), 0x66, ...x64_rex(1, second_f, 0, acc), 0xF, 0x6E, 0xC0 | ((second_f & 7) << 3) | (acc & 7), ...x64_sse(0x66, 0x57, a, second_f)}; // sign: movabs; movq; xorpd
  jump_unless(bool a) => array{...x64_rr(0x85, a, a), 0xF, 0x84, ...x64_rel32(target - 9)}; // test a, a; je target
  using operator (i64 a) / (i64 b) => x64_divmod(a, b, fault, 0);
  using operator (i64 a) % (i64 b) => x64_divmod(a, b, fault, 1);
  using operator (f64 a) + (f64 b) => x64_sse(0xF2, 0x58, a, b); // addsd
  using operator (f64 a) - (f64 b) => x64_sse(0xF2, 0x5C, a, b); // subsd
  using operator (f64 a) * (f64 b) => x64_sse(0xF2, 0x59, a, b); // mulsd
  using operator (f64 a) / (f64 b) => x64_sse(0xF2, 0x5E, a, b); // divsd
  using operator (f64 a) == (f64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(0x4, acc), ...x64_set(0xB, second), 0x20, 0xC0 | ((second & 7) << 3) | (acc & 7), ...x64_0f(0xB6, acc, acc)}; // sete; setnp; and
  using operator (f64 a) != (f64 b) => array{...x64_sse(0x66, 0x2E, a, b), ...x64_set(0x5, acc), ...x64_set(0xA, second), 0x8, 0xC0 | ((second & 7) << 3) | (acc & 7), ...x64_0f(0xB6, acc, acc)}; // setne; setp; or
  using operator (f64 a) < (f64 b) => x64_fcmp(0x7, b, a); // seta, operands in reverse
  using operator (f64 a) <= (f64 b) => x64_fcmp(0x3, b, a); // setae
  using operator (f64 a) > (f64 b) => x64_fcmp(0x7, a, b);
  using operator (f64 a) >= (f64 b) => x64_fcmp(0x3, a, b);
  push_tmp(i64 r) => if(r >= 8) array{0x41, 0x50 + (r & 7)} else array{0x50 + r};
  pop_tmp(i64 r) => if(r >= 8) array{0x41, 0x58 + (r & 7)} else array{0x58 + r};
  stack_alloc(i64 n) => array{0x48, 0x81, 0xEC, ...x64_rel32(n)}; // sub rsp, n
  stack_free(i64 n) => array{0x48, 0x81, 0xC4, ...x64_rel32(n)}; // add rsp, n
  to_f64(i64 d, i64 s) => array{0xF2, ...x64_rex(1, d, 0, s), 0xF, 0x2A, 0xC0 | ((d & 7) << 3) | (s & 7)}; // cvtsi2sd
  to_i64(i64 d, i64 s) => array{0xF2, ...x64_rex(1, d, 0, s), 0xF, 0x2C, 0xC0 | ((d & 7) << 3) | (s & 7)}; // cvttsd2si
  move_to_f64(i64 d, i64 s) => array{0x66, ...x64_rex(1, d, 0, s), 0xF, 0x6E, 0xC0 | ((d & 7) << 3) | (s & 7)}; // movq xmm, r
  move_from_f64(i64 d, i64 s) => array{0x66, ...x64_rex(1, s, 0, d), 0xF, 0x7E, 0xC0 | ((s & 7) << 3) | (d & 7)}; // movq r, xmm
  negate(i64 r) => array{0x48 | (r >> 3), 0xF7, 0xD8 | (r & 7)}; // neg r
  using operator (i64 a) == (i64 b) => x64_cmp(0x4, a, b);
  using operator (i64 a) != (i64 b) => x64_cmp(0x5, a, b);
  using operator (i64 a) < (i64 b) => x64_cmp(0xC, a, b);
  using operator (i64 a) >= (i64 b) => x64_cmp(0xD, a, b);
  using operator (i64 a) <= (i64 b) => x64_cmp(0xE, a, b);
  using operator (i64 a) > (i64 b) => x64_cmp(0xF, a, b);
  // Transition condition - the context of the goal:
// 
// 
// The comparison here is not 0/1 in the battery, but the transition.
  // If it is true, if it is false, if it is true. The second operand is
  // known when compiling the context:
// 
// The parameter v is the value itself, not the register.
  known(expr body) => {
    using operator (i64 a) + (i64 v) => x64_ri(0, a, v); // add a, v
    using operator (i64 a) - (i64 v) => x64_ri(5, a, v); // sub a, v
    using operator (i64 a) & (i64 v) => x64_ri(4, a, v); // and a, v
    using operator (i64 a) | (i64 v) => x64_ri(1, a, v); // or a, v
    using operator (i64 a) ^ (i64 v) => x64_ri(6, a, v); // xor a, v
    using operator (i64 a) * (i64 v) => x64_imul_i(a, v); // imul a, a, v
    using operator (i64 a) << (i64 v) => x64_shift_i(4, a, v); // shl a, v
    using operator (i64 a) >> (i64 v) => x64_shift_i(7, a, v); // sar a, v
    body
  };
  unless(expr body) => {
    known(expr body) => {
      using operator (i64 a) == (i64 v) => x64_jcc_i(0x5, a, v, target);
      using operator (i64 a) != (i64 v) => x64_jcc_i(0x4, a, v, target);
      using operator (i64 a) < (i64 v) => x64_jcc_i(0xD, a, v, target);
      using operator (i64 a) >= (i64 v) => x64_jcc_i(0xC, a, v, target);
      using operator (i64 a) <= (i64 v) => x64_jcc_i(0xF, a, v, target);
      using operator (i64 a) > (i64 v) => x64_jcc_i(0xE, a, v, target);
      body
    };
    using operator (i64 a) == (i64 b) => x64_jcc(0x5, a, b, target); // jne
    using operator (i64 a) != (i64 b) => x64_jcc(0x4, a, b, target); // je
    using operator (i64 a) < (i64 b) => x64_jcc(0xD, a, b, target); // jge
    using operator (i64 a) >= (i64 b) => x64_jcc(0xC, a, b, target); // jl
    using operator (i64 a) <= (i64 b) => x64_jcc(0xF, a, b, target); // jg
    using operator (i64 a) > (i64 b) => x64_jcc(0xE, a, b, target); // jle
    is_index(i64 k, i64 n) => x64_jcc(0x3, k, n, target); // jae
    body
  };
  when(expr body) => {
    known(expr body) => {
      using operator (i64 a) == (i64 v) => x64_jcc_i(0x4, a, v, target);
      using operator (i64 a) != (i64 v) => x64_jcc_i(0x5, a, v, target);
      using operator (i64 a) < (i64 v) => x64_jcc_i(0xC, a, v, target);
      using operator (i64 a) >= (i64 v) => x64_jcc_i(0xD, a, v, target);
      using operator (i64 a) <= (i64 v) => x64_jcc_i(0xE, a, v, target);
      using operator (i64 a) > (i64 v) => x64_jcc_i(0xF, a, v, target);
      body
    };
    using operator (i64 a) == (i64 b) => x64_jcc(0x4, a, b, target); // je
    using operator (i64 a) != (i64 b) => x64_jcc(0x5, a, b, target); // jne
    using operator (i64 a) < (i64 b) => x64_jcc(0xC, a, b, target); // jl
    using operator (i64 a) >= (i64 b) => x64_jcc(0xD, a, b, target); // jge
    using operator (i64 a) <= (i64 b) => x64_jcc(0xE, a, b, target); // jle
    using operator (i64 a) > (i64 b) => x64_jcc(0xF, a, b, target); // jg
    is_index(i64 k, i64 n) => x64_jcc(0x2, k, n, target); // jb
    body
  };
  // instance in bands (O6):
// 
// 
  // . Context code generation: the same node programs, the value is width() instance in one register
  // (SSE2: 64 bits); what is not here (i64 *, comparison), is not in stripes.
  lanes(expr body) => {
    width() => 2;
    vregs() => array{10, 11, 12, 13, 14}; // xmm10 - xmm14: body instance without calls; xmm15 working
    using operator (f64 a) + (f64 b) => x64_sse(0x66, 0x58, a, b); // addpd
    using operator (f64 a) - (f64 b) => x64_sse(0x66, 0x5C, a, b); // subpd
    using operator (f64 a) * (f64 b) => x64_sse(0x66, 0x59, a, b); // mulpd
    using operator (f64 a) / (f64 b) => x64_sse(0x66, 0x5E, a, b); // divpd
    using operator (i64 a) + (i64 b) => x64_sse(0x66, 0xD4, a, b); // paddq
    using operator (i64 a) - (i64 b) => x64_sse(0x66, 0xFB, a, b); // psubq
    using operator (i64 a) & (i64 b) => x64_sse(0x66, 0xDB, a, b); // pand
    using operator (i64 a) | (i64 b) => x64_sse(0x66, 0xEB, a, b); // por
    using operator (i64 a) ^ (i64 b) => x64_sse(0x66, 0xEF, a, b); // pxor
    using operator -(f64 a) => array{0x48 | (acc >> 3), 0xB8 + (acc & 7), ...x64_u64(1 << 63), 0x66, ...x64_rex(1, 15, 0, acc), 0xF, 0x6E, 0xC0 | ((15 & 7) << 3) | (acc & 7), ...x64_sse(0x66, 0x6C, 15, 15), ...x64_sse(0x66, 0x57, a, 15)}; // sign: movabs; movq; punpcklqdq; xorpd
    // Comparison - strip mask (all bits of the band are true): cmppd; > and >= - operands in reverse
    using operator (f64 a) == (f64 b) => array{...x64_sse(0x66, 0xC2, a, b), 0}; // cmpeqpd
    using operator (f64 a) != (f64 b) => array{...x64_sse(0x66, 0xC2, a, b), 4}; // cmpneqpd: with NaN - the truth as one
    using operator (f64 a) < (f64 b) => array{...x64_sse(0x66, 0xC2, a, b), 1}; // cmpltpd
    using operator (f64 a) <= (f64 b) => array{...x64_sse(0x66, 0xC2, a, b), 2}; // cmplepd
    using operator (f64 a) > (f64 b) => array{...x64_sse(0x66, 0xC2, b, a), 1, ...x64_sse(0x66, 0x28, a, b)}; // b < a; movapd
    using operator (f64 a) >= (f64 b) => array{...x64_sse(0x66, 0xC2, b, a), 2, ...x64_sse(0x66, 0x28, a, b)};
    // branch instance - choice on the mask m: both sides are counted (without effects), the result is in a
    select(i64 a, i64 b, i64 m) => array{...x64_sse(0x66, 0x54, a, m), ...x64_sse(0x66, 0x55, m, b), ...x64_sse(0x66, 0x56, a, m)}; // andpd a, m; andnpd m, b; orpd a, m
    broadcast(i64 r) => x64_sse(0x66, 0x6C, r, r); // punpcklqdq r, r: the youngest word in all bands
    load_index(i64 d, i64 base, i64 index) => array{0x66, ...x64_rex(0, d, index, base), 0xF, 0x10, ...x64_sib(d, base, index)}; // movupd d, [base + index * 8]
    store_index(i64 base, i64 index, i64 s) => array{0x66, ...x64_rex(0, s, index, base), 0xF, 0x11, ...x64_sib(s, base, index)}; // movupd [base + index * 8], s
    step(i64 r) => x64_ri(0, r, width()); // add r, width
    over(i64 a, i64 b) => x64_jcc(0xF, a, b, target); // cmp a, b; jg target
    body
  };
  body
}

arm64(expr body) {
  model() => array{9, 3, 0, 1, 0, 29, 31, 2, 0, 1, 2, 3, 1, 19}; // x9, x3, d0, d1, x0, x29, sp, x2; x0 - x3; x1; x19 is a frame embracing the subroutine
  // Free registers for variables (scalars, classes i64 and f64): the compiler does not take them for
  // anything else; they are in memory for calls (see jit_compile: spill/reload).
  var_regs() => array{array{10, 11, 12, 13}, array{4, 5, 6, 7}}; // x10–x13, d4–d7
  temp_regs() => array{array{14, 15}, array{16, 17, 18, 19}}; // Temporary expressions without calls: x14 - x15, d16 - d
  using operator (i64 a) + (i64 b) => a64_rrr(0x8B000000, a, a, b); // add
  using operator (i64 a) - (i64 b) => a64_rrr(0xCB000000, a, a, b); // sub
  using operator (i64 a) & (i64 b) => a64_rrr(0x8A000000, a, a, b); // and
  using operator (i64 a) | (i64 b) => a64_rrr(0xAA000000, a, a, b); // orr
  using operator (i64 a) ^ (i64 b) => a64_rrr(0xCA000000, a, a, b); // eor
  using operator (i64 a) * (i64 b) => a64_rrr(0x9B007C00, a, a, b); // madd a, a, b, xzr
  using operator (i64 a) << (i64 b) => a64_rrr(0x9AC02000, a, a, b); // lslv
  using operator (i64 a) >> (i64 b) => a64_rrr(0x9AC02800, a, a, b); // asrv
  move(i64 d, i64 s) => a64_mov(d, s);
  load(i64 d, i64 base, i64 disp) => a64_mem(0xF8400000, 0xF8606800, d, base, a64_scaled(base, disp)); // ldur/ldr
  store(i64 base, i64 disp, i64 s) => a64_mem(0xF8000000, 0xF8206800, s, base, a64_scaled(base, disp)); // stur/str
  move_f64(i64 d, i64 s) => a64_word(0x1E604000 | (s << 5) | d); // fmov
  load_f64(i64 d, i64 base, i64 disp) => a64_mem(0xFC400000, 0xFC606800, d, base, a64_scaled(base, disp));
  store_f64(i64 base, i64 disp, i64 s) => a64_mem(0xFC000000, 0xFC206800, s, base, a64_scaled(base, disp));
  load_const(i64 d, i64 v) => a64_imm64(d, v);
  load_index(i64 d, i64 base, i64 index) => a64_word(0xF8607800 | (index << 16) | (base << 5) | d); // ldr d, [base, index, lsl 3]
  load32(i64 d, i64 base, i64 disp) => a64_mem(0xB8400000, 0xB8606800, d, base, a64_scaled(base, disp)); // ldur/ldr w: Higher bits are zeros
  load_byte_index(i64 d, i64 base, i64 index) => a64_word(0x38606800 | (index << 16) | (base << 5) | d); // ldrb w, [base, index]
  store_index(i64 base, i64 index, i64 s) => a64_word(0xF8207800 | (index << 16) | (base << 5) | s);
  load_index_f64(i64 d, i64 base, i64 index) => a64_word(0xFC607800 | (index << 16) | (base << 5) | d);
  store_index_f64(i64 base, i64 index, i64 s) => a64_word(0xFC207800 | (index << 16) | (base << 5) | s);
  check_index(i64 k, i64 n) => array{...a64_word(0xEB00001F | (n << 16) | (k << 5)), ...a64_word(0x54000002 | ((((fault - 4) >> 2) & 0x7FFFF) << 5))}; // cmp k, n; b.hs fault
  jump() => a64_word(0x14000000 | ((target >> 2) & 0x3FFFFFF)); // b target
  jump_if(bool a) => a64_word(0xB5000000 | (((target >> 2) & 0x7FFFF) << 5) | a); // cbnz a, target
  jump_if_set(i64 base) => array{...a64_word(0xF8400000 | (base << 5) | 17), ...a64_word(0xB5000000 | ((((target - 4) >> 2) & 0x7FFFF) << 5) | 17)}; // ldur x17, [base]; cbnz x17
  store_const(i64 base, i64 disp, i64 v) => array{...a64_imm64(17, v), ...a64_mem(0xF8000000, 0xF8206800, 17, base, a64_scaled(base, disp))};
  address(i64 d, i64 base, i64 disp) => a64_add_imm(d, base, a64_scaled(base, disp));
  call_reg(i64 r) => array{...a64_word(0xD63F0000 | (r << 5)), ...a64_mov(acc, 0)}; // blr r; result x0 → battery
  call_mem(i64 base, i64 disp) => array{...a64_mem(0xF8400000, 0xF8606800, 17, base, a64_scaled(base, disp)), ...a64_word(0xD63F0000 | (17 << 5)), ...a64_mov(acc, 0)};
  call_self() => array{...a64_word(0x94000000 | ((target >> 2) & 0x3FFFFFF)), ...a64_mov(acc, 0)}; // bl target; result x0 → battery
  frame_enter() => a64_word(0xA9BF7BFD); // stp x29, x30, [sp, #-16]!
  frame_leave() => a64_word(0xA8C17BFD); // ldp x29, x30, [sp], #16
  frame_alloc(i64 n) => array{...a64_word(0xD2800000 | (n << 5) | 16), ...a64_word(0xCB206000 | (16 << 16) | (31 << 5) | 31)}; // movz x16, n; sub sp, sp, x16
  ret() => array{...a64_mov(0, acc), ...a64_word(0xD65F03C0)}; // result in x0
  is_index(i64 k, i64 n) => a64_cmp(0x3, k, n); // lo
  using operator !(bool a) => a64_word(0xD2400000 | (a << 5) | a); // eor a, a, #1
  using operator -(f64 a) => a64_word(0x1E614000 | (a << 5) | a); // fneg
  jump_unless(bool a) => a64_word(0xB4000000 | (((target >> 2) & 0x7FFFF) << 5) | a); // cbz a, target
  using operator (i64 a) / (i64 b) => a64_divmod(a, b, fault, 0);
  using operator (i64 a) % (i64 b) => a64_divmod(a, b, fault, 1);
  using operator (f64 a) + (f64 b) => a64_rrr(0x1E602800, a, a, b); // fadd
  using operator (f64 a) - (f64 b) => a64_rrr(0x1E603800, a, a, b); // fsub
  using operator (f64 a) * (f64 b) => a64_rrr(0x1E600800, a, a, b); // fmul
  using operator (f64 a) / (f64 b) => a64_rrr(0x1E601800, a, a, b); // fdiv
  using operator (f64 a) == (f64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(0x0, acc), ...a64_cset(0x7, second), ...a64_rrr(0x8A000000, acc, acc, second)}; // eq и vc
  using operator (f64 a) != (f64 b) => array{...a64_word(0x1E602000 | (b << 16) | (a << 5)), ...a64_cset(0x1, acc), ...a64_cset(0x6, second), ...a64_rrr(0xAA000000, acc, acc, second)}; // ne or v
  using operator (f64 a) < (f64 b) => a64_fcmp(0xC, b, a);
  using operator (f64 a) <= (f64 b) => a64_fcmp(0xA, b, a);
  using operator (f64 a) > (f64 b) => a64_fcmp(0xC, a, b);
  using operator (f64 a) >= (f64 b) => a64_fcmp(0xA, a, b);
  push_tmp(i64 r) => a64_word(0xF81F0FE0 | r); // str r, [sp, #-16]!
  pop_tmp(i64 r) => a64_word(0xF84107E0 | r); // ldr r, [sp], #16
  stack_alloc(i64 n) => a64_add_imm(31, 31, -2 * n); // 16-byte slot
  stack_free(i64 n) => a64_add_imm(31, 31, 2 * n);
  to_f64(i64 d, i64 s) => a64_word(0x9E620000 | (s << 5) | d); // scvtf
  to_i64(i64 d, i64 s) => a64_word(0x9E780000 | (s << 5) | d); // fcvtzs
  move_to_f64(i64 d, i64 s) => a64_word(0x9E670000 | (s << 5) | d); // fmov d, x
  move_from_f64(i64 d, i64 s) => a64_word(0x9E660000 | (s << 5) | d); // fmov x, d
  negate(i64 r) => a64_word(0xCB0003E0 | (r << 16) | r); // neg
  using operator (i64 a) == (i64 b) => a64_cmp(0x0, a, b);
  using operator (i64 a) != (i64 b) => a64_cmp(0x1, a, b);
  using operator (i64 a) < (i64 b) => a64_cmp(0xB, a, b);
  using operator (i64 a) >= (i64 b) => a64_cmp(0xA, a, b);
  using operator (i64 a) <= (i64 b) => a64_cmp(0xD, a, b);
  using operator (i64 a) > (i64 b) => a64_cmp(0xC, a, b);
  // The second operand is known - context as amd64 (and/or/xor/mul - without it: AArch64 has its
  // own mask encoding, shared register path)
  known(expr body) => {
    using operator (i64 a) + (i64 v) => a64_add_imm(a, a, v);
    using operator (i64 a) - (i64 v) => a64_add_imm(a, a, 0 - v);
    using operator (i64 a) << (i64 v) => a64_lsl_i(a, v);
    using operator (i64 a) >> (i64 v) => a64_asr_i(a, v);
    body
  };
  // Transition condition: context as in amd64
  unless(expr body) => {
    known(expr body) => {
      using operator (i64 a) == (i64 v) => a64_bcc_i(0x1, a, v, target);
      using operator (i64 a) != (i64 v) => a64_bcc_i(0x0, a, v, target);
      using operator (i64 a) < (i64 v) => a64_bcc_i(0xA, a, v, target);
      using operator (i64 a) >= (i64 v) => a64_bcc_i(0xB, a, v, target);
      using operator (i64 a) <= (i64 v) => a64_bcc_i(0xC, a, v, target);
      using operator (i64 a) > (i64 v) => a64_bcc_i(0xD, a, v, target);
      body
    };
    using operator (i64 a) == (i64 b) => a64_bcc(0x1, a, b, target); // b.ne
    using operator (i64 a) != (i64 b) => a64_bcc(0x0, a, b, target); // b.eq
    using operator (i64 a) < (i64 b) => a64_bcc(0xA, a, b, target); // b.ge
    using operator (i64 a) >= (i64 b) => a64_bcc(0xB, a, b, target); // b.lt
    using operator (i64 a) <= (i64 b) => a64_bcc(0xC, a, b, target); // b.gt
    using operator (i64 a) > (i64 b) => a64_bcc(0xD, a, b, target); // b.le
    is_index(i64 k, i64 n) => a64_bcc(0x2, k, n, target); // b.hs
    body
  };
  when(expr body) => {
    known(expr body) => {
      using operator (i64 a) == (i64 v) => a64_bcc_i(0x0, a, v, target);
      using operator (i64 a) != (i64 v) => a64_bcc_i(0x1, a, v, target);
      using operator (i64 a) < (i64 v) => a64_bcc_i(0xB, a, v, target);
      using operator (i64 a) >= (i64 v) => a64_bcc_i(0xA, a, v, target);
      using operator (i64 a) <= (i64 v) => a64_bcc_i(0xD, a, v, target);
      using operator (i64 a) > (i64 v) => a64_bcc_i(0xC, a, v, target);
      body
    };
    using operator (i64 a) == (i64 b) => a64_bcc(0x0, a, b, target); // b.eq
    using operator (i64 a) != (i64 b) => a64_bcc(0x1, a, b, target); // b.ne
    using operator (i64 a) < (i64 b) => a64_bcc(0xB, a, b, target); // b.lt
    using operator (i64 a) >= (i64 b) => a64_bcc(0xA, a, b, target); // b.ge
    using operator (i64 a) <= (i64 b) => a64_bcc(0xD, a, b, target); // b.le
    using operator (i64 a) > (i64 b) => a64_bcc(0xC, a, b, target); // b.gt
    is_index(i64 k, i64 n) => a64_bcc(0x3, k, n, target); // b.lo
    body
  };
  // instance in bands - context like amd64 (NEON: 64 bits)
  lanes(expr body) => {
    width() => 2;
    vregs() => array{20, 21, 22, 23, 24, 25, 26, 27}; // v20 - v27: v8 - v15 retains the call - do not take
    using operator (f64 a) + (f64 b) => a64_rrr(0x4E60D400, a, a, b); // fadd .2d
    using operator (f64 a) - (f64 b) => a64_rrr(0x4EE0D400, a, a, b); // fsub .2d
    using operator (f64 a) * (f64 b) => a64_rrr(0x6E60DC00, a, a, b); // fmul .2d
    using operator (f64 a) / (f64 b) => a64_rrr(0x6E60FC00, a, a, b); // fdiv .2d
    using operator (i64 a) + (i64 b) => a64_rrr(0x4EE08400, a, a, b); // add .2d
    using operator (i64 a) - (i64 b) => a64_rrr(0x6EE08400, a, a, b); // sub .2d
    using operator (i64 a) & (i64 b) => a64_rrr(0x4E201C00, a, a, b); // and .16b
    using operator (i64 a) | (i64 b) => a64_rrr(0x4EA01C00, a, a, b); // orr .16b
    using operator (i64 a) ^ (i64 b) => a64_rrr(0x6E201C00, a, a, b); // eor .16b
    using operator -(f64 a) => a64_word(0x6EE0F800 | (a << 5) | a); // fneg .2d
    using operator (f64 a) == (f64 b) => a64_rrr(0x4E60E400, a, a, b); // fcmeq .2d
    using operator (f64 a) != (f64 b) => array{...a64_rrr(0x4E60E400, a, a, b), ...a64_word(0x6E205800 | (a << 5) | a)}; // fcmeq; mvn
    using operator (f64 a) < (f64 b) => a64_rrr(0x6EE0E400, a, b, a); // fcmgt a, b, a
    using operator (f64 a) <= (f64 b) => a64_rrr(0x6E60E400, a, b, a); // fcmge a, b, a
    using operator (f64 a) > (f64 b) => a64_rrr(0x6EE0E400, a, a, b); // fcmgt
    using operator (f64 a) >= (f64 b) => a64_rrr(0x6E60E400, a, a, b); // fcmge
    select(i64 a, i64 b, i64 m) => a64_rrr(0x6EE01C00, a, b, m); // bif a, b, m: where the mask is false - from b
    broadcast(i64 r) => a64_word(0x4E080400 | (r << 5) | r); // dup r.2d, r.d[0]
    load_index(i64 d, i64 base, i64 index) => array{...a64_word(0x8B000C00 | (index << 16) | (base << 5) | 16), ...a64_word(0x3DC00000 | (16 << 5) | d)}; // add x16, base, index, lsl 3; ldr q, [x16]
    store_index(i64 base, i64 index, i64 s) => array{...a64_word(0x8B000C00 | (index << 16) | (base << 5) | 16), ...a64_word(0x3D800000 | (16 << 5) | s)}; // str q, [x16]
    step(i64 r) => a64_add_imm(r, r, width());
    over(i64 a, i64 b) => a64_bcc(0xC, a, b, target); // cmp a, b; b.gt
    body
  };
  body
}

// fiber and threads (§8.3): spawn { … } - stack coroutine; stream - block write/read: The
// value goes into the stream by moving (own).
//
spawn(expr body) => fiber_start(body);
// on_pressure { … } is the process memory pressure handler (§9.5, step 12.3): A block is the normal
// process code (sees its name - its cache); VM runs its fiber of this process when host lacks memory
// (PSI) or on an external command (proc pressure). Not a signal.
//
//
on_pressure(expr body) => pressure_handler(body);
// A bounded FIFO queue between fibers, cap slots (16 by default). write moves a value
// in and blocks while every slot is taken, until a reader frees one; read takes the
// oldest value and blocks while the stream is empty. Nothing is dropped or overwritten.
// Any fiber holding s may both write and read. close ends the stream: for(x : s) and
// more(s) finish once it is closed and empty; writing to it, or reading it empty, throws
// closed_stream. Fibers waiting on each other with no one left to run — deadlock.
stream() => stream_new(16);
stream(i64 cap) => stream_new(cap);
stream(type t) => stream_type(t); // Flow type - function over types: stream(i64)
write(stream s, own x) => stream_write(s, x);
read(stream s) => stream_read(s);
more(stream s) => stream_more(s);
close(stream s) => stream_close(s);
for(stream s, expr body) {
  loop {
    if(!more(s)) break;
    body(read(s));
  }
}

// Network (M3b): listen - one event stream over all connections: event {peer, kind:
// "open" | "data" | "close", data}; send - to the outgoing stream, without waiting;
// connect - the same stream for one peer (0).
//
struct event { i64 peer; str kind; str data; }
listen(i64 p) => net_listen(p);
connect(str host, i64 p) => net_connect(host, p);
port(stream n) => net_port(n);
send(stream n, i64 peer, str data) => net_send(n, peer, data);
send(stream n, str data) => net_send(n, 0, data);
drop(stream n, i64 peer) => net_drop(n, peer);

// Files: open - stream of pieces (read io_uring), create - write.
open(str path) => file_open(path);
create(str path) => file_create(path);

// Storage status (service VM, plan C1):
// 
// 
//;
// 
// . *My:* storage(имя) is a named region of bytes (name is a key in the VM environment, not a
// path); addressing by offsets; grow(s, n) - n zero bytes at the end, the result is a displacement
// of a new place; commit - fix (on the disk); without the right storage (vish run - storagegrant)
// - io_error, like fs; proc revoke storage - closes, then - io_error.
storage(str name) => storage_open(name);
size(storage s) => storage_size(s);
grow(storage s, i64 n) => storage_grow(s, n);
read(storage s, i64 at, i64 n) => storage_read(s, at, n);
write(storage s, i64 at, str bytes) => storage_write(s, at, bytes);
read_i64(storage s, i64 at) => storage_read_i64(s, at);
write_i64(storage s, i64 at, i64 x) => storage_write_i64(s, at, x);
commit(storage s) => storage_commit(s);
close(storage s) => storage_close(s);

// Processes VM (M3c): process(f, аргументы…) is an isolated process; between
// processes, only data is moved. Wait - wait; false - process fell (the rest live),
// error - his message.
wait(process p) => process_wait(p);
error(process p) => process_error(p);

// Formatting is not a string of format:
//
// 
// 
// . fmt"x = {x}, address {hex(8)}{p}" - parts of the template: text, value, text, ...;
// formatter (heir formatter) configures the following value; its format - its own
// overload format with (formatter, value).
//
struct formatter {}
struct plain : formatter {}
struct hex : formatter { i64 width; }
struct fixed : formatter { i64 digits; }
hex(i64 w) => hex{w};
fixed(i64 d) => fixed{d};
format_with(plain f, x) => text(x);
// Primitives in C++ in the body function:
// 
// native "cpp" { … } is collected in VM (vish native, build.sh); #x is a parameter of
// VM. An argument unknown in parsing is an erased value of the result (as in built-in
// ones). Numbers in the language above the primitive text_byte:
//
// 
// Primitives are only what is not in the kernel: byte → string
// (text_byte) and the record f64 (text_fixed, text).

// text_hex(n, width) is a hexadecimal record of n as 64 bits without a sign, zeros to width.
text_hex(i64 n, i64 width) {
  hex_digit(i64 d) => text_byte(if(d < 10) '0' + d else 'a' + (d - 10));
  s = "";
  k = n;
  w = 0;
  loop {
    s = hex_digit(k & 15) + s;
    k = (k >> 4) & 0x0fffffffffffffff; // shifting
    w = w + 1;
    if(k == 0) break;
  }
  while(w < width) {
    s = "0" + s;
    w = w + 1;
  }
  s
}

text_fixed(f64 x, i64 digits) => native "cpp" {
  if(!#x.known() || !#digits.known()) return erase(value(std::string("x")));
  char buf[64];
  snprintf(buf, sizeof buf, "%.*f", int(#digits.as<int64_t>()), #x.as<double>());
  return value(std::string(buf));
};

format_with(hex h, i64 x) => text_hex(x, h.width);
format_with(fixed d, f64 x) => text_fixed(x, d.digits);

fmt(...parts) {
  out = "";
  f = plain{};
  i = 0;
  for(p : parts) {
    if((i % 2) == 0) out = out + p; // template
    else if(formatter{} = p) f = p; // formatter - for the next meaning
    else {
      out = out + format_with(f, p);
      f = plain{};
    }
    i = i + 1;
  }
  out
}

// parse_int(s) is the result of {ok, value, error}: numbers without a sign.
struct result { bool ok; i64 value; str error; }
parse_int(str s) {
  good = s.size > 0;
  v = 0;
  for(k : range(s.size)) {
    ch = s[k];
    if((ch < '0') || (ch > '9')) {
      good = false;
      break;
    }
    v = (v * 10) + (ch - '0');
  }
  if(good) result{true, v, ""} else result{false, 0, "не число: \"" + s + "\""}
}

// text(x) is the text of the value (bytes): the string itself, the number is the decimal record.
text(str s) => s;
text(bool b) => if(b) "true" else "false";
text(i64 n) {
  s = "";
  k = n;
  loop {
    d = k % 10;
    s = text_byte('0' + (if(d < 0) -d else d)) + s; // Minimum i64 without changing the sign
    k = k / 10;
    if(k == 0) break;
  }
  if(n < 0) "-" + s else s
}
// The rest (f64, type, aggregate) is primitive: the entry f64 and the name of the type cannot be expressed to the kernel.
text(x) => native "cpp" {
  if(!#x.known()) return erase(value(std::string("x")));
  return #x.is<str_v>() ? value(#x.as<str_v>()) : value(vm.show_v(#x));
};

// text_byte(b) is a string of one byte b.
text_byte(i64 b) => native "cpp" {
  if(!#b.known()) return erase(value(std::string("x")));
  return value(std::string(1, char(#b.as<int64_t>())));
};

// Types of strings (Sh2a, docs/plan-vm-os.md §4 in, spec §5.9): the string is bytes, and the storage method
// chooses the code, the type is the view.
// 
// 
// (ibid.); SSO is the “most obvious case” of a fixed-size buffer; Specific types, names, and overflow
// behaviors are mine. `str` - default view: chunks of 2^k words, growth by copying. Here:
//
//
// grown_text is growing: bytes in their address range (like pin in a growing vector)
// growth of pages in place, bytes do not move;
// fixed_text(N) is a fixed text <N>: capacity N - ct-field type, overflow - exclusion of text_overflow.
// not silent truncation (§3.5);
// text_buffer - buffer + position for assembly and output: put, take (take everything, position - at 0). General:
// put(вид, str) - add on the spot (core append), size(вид), byte_at(вид, k) - byte, text(вид) - str. Operator type[k]
// no: overload operator[] would slow down each a[i] program (user candidate operator bypasses the fast path of the
// kernel). pin(s) is the str in its address range (core pin_storage).
//
pin(str s) => pin_storage(s);

struct grown_text { str bytes; }
grown_text() {
  g = grown_text{""};
  pin(g.bytes);
  g
}
grown_text(str s) {
  g = grown_text();
  g.bytes.push(s);
  g
}
put(mut grown_text g, str s) { g.bytes.push(s); }
size(grown_text g) => g.bytes.size;
byte_at(grown_text g, i64 k) => g.bytes[k];
text(grown_text g) => g.bytes;

struct fixed_text { ct i64 cap; str bytes; }
fixed_text(ct i64 n) => fixed_text{n, ""};
// Will s fit into the remaining bytes?
fits(fixed_text t, str s) => (t.bytes.size + s.size) <= t.cap;
// text_overflow exception (does not require: it selects overload instead of throwing)
struct text_overflow { i64 cap; i64 need; }
put(mut fixed_text t, str s) {
  if(!fits(t, s)) throw text_overflow{t.cap, t.bytes.size + s.size};
  t.bytes.push(s);
}
size(fixed_text t) => t.bytes.size;
byte_at(fixed_text t, i64 k) => t.bytes[k];
text(fixed_text t) => t.bytes;

struct text_buffer { grown_text data; }
text_buffer() => text_buffer{grown_text()};
byte_at(text_buffer b, i64 k) => b.data.bytes[k];
put(mut text_buffer b, str s) { b.data.bytes.push(s); }
size(text_buffer b) => b.data.bytes.size;
// everything accumulated by one line; position to the beginning, buffer address range the same
take(mut text_buffer b) {
  r = b.data.bytes;
  b.data = grown_text();
  r
}
text(text_buffer b) => b.data.bytes;

// fill(n, x) is an array of n copies of x.
fill(i64 n, x) {
  r = array{};
  for(i : range(n)) r.push(x);
  r
}

is_err(result r) => !r.ok;

// parsing code (§4.4): the block of the structure whose body declares `syntax {r} => f(r);` is
// stored raw (ast.raw: atoms and sub-units with positions), f disassembles it during analysis and
// returns the code (or value - VM builds the code that creates it) or parse_error - a hole with a
// cause in place of the atom. The library - in his criticism of mecha:
//
// 
//;
// 
// The alternative is
// 
// My:* parser - data (struct-heirs parser), analysis - overload p run in appearance; input - atoms
// of the raw block and symbols inside them; position - (k, c): atom k and displacement c in it (c >
// 0 - in the middle of the atom). The sum of p run is array{true, k, value, code(), c} or
// array{false, k, cause, atom, c}.
//
// Symbols inside the atom:
// 
// 
// The atom remains node, code_text(атом) - its text as written. *My:* symbol parser (int with config
// - int({sign: false, base: 16, digits: 2}), hex(2), byte '#') reads the text of the atom with (k,
// c); the word - atoms close (00ff00 is 00 and ff00), without space between them; between parsers,
// the boundary of the atom is free as a gap. The level is chosen by itself: atomic parsers require c
// = 0, the literal in the middle of the atom is checked by symbols.
//
struct parse_error { code at; str why; }
struct parse_error_in : parse_error { i64 offset; } // The place inside the atom: shift from its beginning
struct parser {}
struct p_int : parser { bool sign; i64 base; i64 max; } // whole: atom-number; base 10, max > 0 or in the middle of an atom are symbols
struct p_num : parser { bool sign; } // Number: integer or fractional - f64
struct p_word : parser { str w; } // name ("any") - a line
struct p_text : parser {} // string
struct p_bool : parser {} // true / false
struct p_sym : parser { str s; } // in a row, glued: "=", "->"
struct p_chr : parser { i64 c; } // byte # is a symbol inside an atom
struct p_code : parser {} // subblock {…} - standard parsing according to the rules of place (code)
struct p_seq : parser { array ps; bool drop; } // in a row - motorcade; drop: without literary (combine)
struct p_alt : parser { array ps; } // first-rate
struct p_rep : parser { array ps; i64 min; } // repeat
struct p_map : parser { type t; array names; array ps; } // aggregate t: field by name
struct p_as : parser { array v; array ps; } // The ps[0] is the value of v[0].
struct p_sub : parser { str open; array ps; } // subblock (...), [...], {…} - parsing entirely inside

// parser of meaning by context: type - parser type, string - literal (word or symbols), byte 'c' -
// symbol, formatter hex(n) n hexadecimal digits (*my*: same setting as fmt output)hex(2)}{x}")
//
as_parser(parser p) => p;
as_parser(type t) {
  if(t == i64) return p_int{true, 10, 0};
  if(t == f64) return p_num{true};
  if(t == str) return p_text{};
  if(t == bool) return p_bool{};
  if(t == code) return p_code{};
  throw parse_error{code(), "нет парсера типа"};
}
p_word_text(str s) => (s.size > 0) && (((s[0] >= 'a') && (s[0] <= 'z')) || (((s[0] >= 'A') && (s[0] <= 'Z')) || (s[0] == '_')));
as_parser(str s) => if(p_word_text(s)) p_word{s} else p_sym{s};
as_parser(i64 c) => p_chr{c};
as_parser(hex h) => p_int{false, 16, h.width};

int() => p_int{true, 10, 0};
int(bool sign) => p_int{sign, 10, 0};
// int({sign: false, base: 16, digits: 2}) - Configuration of the parser of the whole by name:
// 
//  
int(q) {
  p = p_int{true, 10, 0};
  for(f : fields(typeof(q))) {
    if(f.name == "sign") p.sign = q.[f];
    else if(f.name == "base") p.base = q.[f];
    else if(f.name == "digits") p.max = q.[f];
    else throw parse_error{code(), "int: нет настройки " + f.name};
  }
  p
}
word() => p_word{""};
word(str w) => p_word{w};
p_parsers(xs) {
  ps = array{};
  for(x : xs) ps = array{...ps, as_parser(x)};
  ps
}
seq(...xs) => p_seq{p_parsers(xs), false};
combine(...xs) => p_seq{p_parsers(xs), true};
repeated(p) => p_rep{array{as_parser(p)}, 0};
repeated(p, i64 min) => p_rep{array{as_parser(p)}, min};
within(str open, p) => p_sub{open, array{as_parser(p)}};
as(v, p) => p_as{array{v}, array{as_parser(p)}};
// map(T, {поле: парсер, …}) - aggregate T by field names (order parsing - order of writing):
// 
// 
// 
//  
map(type t, q) {
  names = array{};
  ps = array{};
  for(f : fields(typeof(q))) {
    names = array{...names, f.name};
    ps = array{...ps, as_parser(q.[f])};
  }
  p_map{t, names, ps}
}
operator (parser a) | (parser b) => p_alt{array{a, b}};
operator (p_alt a) | (parser b) => p_alt{array{...a.ps, b}};

// k-atom
p_has(xs, i64 k, type t) => (k < xs.size) && (code_kind(xs[k]) == t);
p_ok(i64 k, i64 c, v) => array{true, k, v, code(), c};
p_fail(xs, i64 k, i64 c, str why) => array{false, k, why, if(k < xs.size) xs[k] else code(), c};
// Atomic parser in the middle of an atom: the former parser ate only part of its symbols
p_mid(xs, i64 k, i64 c) => p_fail(xs, k, c, "лишнее внутри атома");
// further in position (failure of alternative that has gone further; promotion of repeat)
p_further(a, b) => (a[1] > b[1]) || ((a[1] == b[1]) && (a[4] > b[4]));

// symbols: byte on (k, c) or -1 is the end of a word; cont is a continuation of the same
// word: in the next atom - only close; subblock - not symbols
p_at(xs, i64 k, i64 c, bool cont) {
  if((k >= xs.size) || (code_kind(xs[k]) == ast.raw)) return -1;
  if(cont && (c == 0) && !code_glued(xs[k])) return -1;
  code_text(xs[k])[c]
}
// position after the symbol on (k, c): the end of the atom - the beginning of the next
p_next(xs, i64 k, i64 c) => if((c + 1) < code_text(xs[k]).size) array{k, c + 1} else array{k + 1, 0};
// Failure of the symbol on (k, c): the end of a word or block is the place immediately behind the last symbol of the atom
p_fail_at(xs, i64 k, i64 c, bool cont, str why) {
  end = (c == 0) && (k > 0) && ((k == xs.size) || (cont && (p_at(xs, k, c, true) < 0)));
  if(end && (code_kind(xs[k - 1]) != ast.raw)) return p_fail(xs, k - 1, code_text(xs[k - 1]).size, why);
  p_fail(xs, k, c, why)
}
p_digit(i64 ch, i64 base) {
  d = -1;
  if((ch >= '0') && (ch <= '9')) d = ch - '0';
  else if((ch >= 'a') && (ch <= 'z')) d = (ch - 'a') + 10;
  else if((ch >= 'A') && (ch <= 'Z')) d = (ch - 'A') + 10;
  if(d >= base) d = -1;
  d
}
// whole symbols: sign, base numbers, no more than max (0 - how much is there)
p_int_chars(p_int p, xs, i64 k, i64 c) {
  j = k;
  d = c;
  cont = false;
  neg = false;
  if(p.sign && (p_at(xs, j, d, false) == '-')) {
    neg = true;
    s = p_next(xs, j, d);
    j = s[0];
    d = s[1];
    cont = true;
  }
  v = 0;
  n = 0;
  loop {
    if((p.max > 0) && (n == p.max)) break;
    x = p_digit(p_at(xs, j, d, cont), p.base);
    if(x < 0) break;
    v = (v * p.base) + x;
    s = p_next(xs, j, d);
    j = s[0];
    d = s[1];
    n = n + 1;
    cont = true;
  }
  if(n == 0) return p_fail_at(xs, j, d, cont, if(p.base == 10) "ожидалась цифра" else "ожидалась цифра по основанию " + text(p.base));
  p_ok(j, d, if(neg) -v else v)
}
// Literal symbols: in the middle of an atom or bytes #
p_lit_chars(xs, i64 k, i64 c, str s) {
  j = k;
  d = c;
  ok = true;
  for(i : range(s.size)) {
    if(ok) {
      if(p_at(xs, j, d, i > 0) != s[i]) ok = false;
      else {
        t = p_next(xs, j, d);
        j = t[0];
        d = t[1];
      }
    }
  }
  if(!ok) return p_fail(xs, k, c, "ожидалось " + s);
  p_ok(j, d, s)
}

// The literal did not coincide with the atom: the atom close to the previous one (the same word:
// 1x2 - 1 and x2) - reconciliation by symbols
p_glued_lit(xs, i64 k, str s) => if((k < xs.size) && code_glued(xs[k])) p_lit_chars(xs, k, 0, s) else p_fail(xs, k, 0, "ожидалось " + s);

p_run(p_int p, xs, i64 k, i64 c) {
  if((c > 0) || (p.base != 10) || (p.max > 0)) return p_int_chars(p, xs, k, c);
  j = k;
  neg = false;
  if(p.sign && p_has(xs, j, ast.symbol)) {
    ast.symbol{t, _} = xs[j];
    if(t == "-") {
      neg = true;
      j = j + 1;
    }
  }
  if(!p_has(xs, j, ast.int)) return p_fail(xs, j, 0, "ожидалось целое");
  ast.int{v, _, _} = xs[j];
  p_ok(j + 1, 0, if(neg) -v else v)
}
p_run(p_num p, xs, i64 k, i64 c) {
  if(c > 0) return p_mid(xs, k, c);
  r = p_run(p_int{p.sign, 10, 0}, xs, k, 0);
  if(r[0]) return p_ok(r[1], 0, f64(r[2]));
  j = k;
  neg = false;
  if(p.sign && p_has(xs, j, ast.symbol)) {
    ast.symbol{t, _} = xs[j];
    if(t == "-") {
      neg = true;
      j = j + 1;
    }
  }
  if(!p_has(xs, j, ast.float)) return p_fail(xs, j, 0, "ожидалось число");
  ast.float{v} = xs[j];
  p_ok(j + 1, 0, if(neg) -v else v)
}
p_run(p_word p, xs, i64 k, i64 c) {
  if((c > 0) && (p.w != "")) return p_lit_chars(xs, k, c, p.w);
  if(c > 0) return p_mid(xs, k, c);
  if(!p_has(xs, k, ast.name)) return if(p.w == "") p_fail(xs, k, 0, "ожидалось имя") else p_glued_lit(xs, k, p.w);
  ast.name{nm} = xs[k];
  if((p.w != "") && (nm != p.w)) return p_glued_lit(xs, k, p.w);
  p_ok(k + 1, 0, nm)
}
p_run(p_text p, xs, i64 k, i64 c) {
  if(c > 0) return p_mid(xs, k, c);
  if(!p_has(xs, k, ast.string)) return p_fail(xs, k, 0, "ожидалась строка");
  ast.string{v} = xs[k];
  p_ok(k + 1, 0, v)
}
p_run(p_bool p, xs, i64 k, i64 c) {
  if(c > 0) return p_mid(xs, k, c);
  r = p_run(p_word{""}, xs, k, 0);
  if(r[0] && (r[2] == "true")) return p_ok(r[1], 0, true);
  if(r[0] && (r[2] == "false")) return p_ok(r[1], 0, false);
  p_fail(xs, k, 0, "ожидалось true или false")
}
p_run(p_sym p, xs, i64 k, i64 c) {
  if(c > 0) return p_lit_chars(xs, k, c, p.s);
  ok = true;
  for(i : range(p.s.size)) {
    if(!p_has(xs, k + i, ast.symbol)) ok = false;
    else {
      ast.symbol{t, g} = xs[k + i];
      if((t[0] != p.s[i]) || ((i > 0) && !g)) ok = false;
    }
  }
  if(!ok) return p_glued_lit(xs, k, p.s);
  p_ok(k + p.s.size, 0, p.s)
}
p_run(p_chr p, xs, i64 k, i64 c) {
  if(p_at(xs, k, c, false) != p.c) return p_fail(xs, k, c, "ожидался символ " + text_byte(p.c));
  s = p_next(xs, k, c);
  p_ok(s[0], s[1], p.c)
}
p_run(p_code p, xs, i64 k, i64 c) {
  if(c > 0) return p_mid(xs, k, c);
  if(!p_has(xs, k, ast.raw)) return p_fail(xs, k, 0, "ожидался блок {…}");
  ast.raw{open, _, _, _, _} = xs[k];
  if(open != "{") return p_fail(xs, k, 0, "ожидался блок {…}");
  p_ok(k + 1, 0, code_parse(xs[k]))
}
p_run(p_sub p, xs, i64 k, i64 c) {
  if(c > 0) return p_mid(xs, k, c);
  if(!p_has(xs, k, ast.raw)) return p_fail(xs, k, 0, "ожидался подблок " + p.open);
  ast.raw{open, items, _, _, _} = xs[k];
  if(open != p.open) return p_fail(xs, k, 0, "ожидался подблок " + p.open);
  r = p_whole(p.ps[0], items);
  if(!r[0]) return array{false, k, r[2], r[3], r[4]}; // The place of error is the atom inside the subblock
  p_ok(k + 1, 0, r[2])
}
// literal (word, symbols, byte) in combine - configuration, not result
p_literal(p_sym p) => true;
p_literal(p_chr p) => true;
p_literal(p_word p) => p.w != "";
p_literal(p) => false;
p_seq_from(p_seq p, xs, i64 k, i64 c, i64 i, acc) {
  if(i == p.ps.size) return p_ok(k, c, if(p.drop && (acc.size == 1)) acc[0] else acc);
  r = p_run(p.ps[i], xs, k, c);
  if(!r[0]) return r;
  if(p.drop && p_literal(p.ps[i])) return p_seq_from(p, xs, r[1], r[4], i + 1, acc);
  p_seq_from(p, xs, r[1], r[4], i + 1, array{...acc, r[2]})
}
p_run(p_seq p, xs, i64 k, i64 c) => p_seq_from(p, xs, k, c, 0, array{});
// The failure of everyone is the one that went on. My luck, which ended in the middle of the atom, is
// inferior to the next that reached the boundary of the atom: rgb(1) | rgb(2) on ff00aa - rgb(2)
// (atomic parsers luck is always on the boundary - the first successful)
p_alt_from(p_alt p, xs, i64 k, i64 c, i64 i, far) {
  if(i == p.ps.size) return far;
  r = p_run(p.ps[i], xs, k, c);
  if(r[0] && (r[4] == 0)) return r;
  if(r[0]) return p_alt_mid(p, xs, k, c, i + 1, r);
  p_alt_from(p, xs, k, c, i + 1, if(p_further(r, far)) r else far)
}
p_alt_mid(p_alt p, xs, i64 k, i64 c, i64 i, mid) {
  if(i == p.ps.size) return mid;
  r = p_run(p.ps[i], xs, k, c);
  if(r[0] && (r[4] == 0)) return r;
  p_alt_mid(p, xs, k, c, i + 1, mid)
}
p_run(p_alt p, xs, i64 k, i64 c) {
  r = p_run(p.ps[0], xs, k, c);
  if(r[0] && (r[4] == 0)) return r;
  if(r[0]) return p_alt_mid(p, xs, k, c, 1, r);
  p_alt_from(p, xs, k, c, 1, r)
}
p_rep_from(p_rep p, xs, i64 k, i64 c, acc) {
  r = p_run(p.ps[0], xs, k, c);
  if(r[0] && p_further(r, p_ok(k, c, 0))) return p_rep_from(p, xs, r[1], r[4], array{...acc, r[2]});
  if(acc.size >= p.min) return p_ok(k, c, acc);
  r
}
p_run(p_rep p, xs, i64 k, i64 c) => p_rep_from(p, xs, k, c, array{});
p_run(p_as p, xs, i64 k, i64 c) {
  r = p_run(p.ps[0], xs, k, c);
  if(!r[0]) return r;
  p_ok(r[1], r[4], p.v[0])
}
// Value - the code that builds it (map aggregate - {…} name in order of fields)
p_lit(i64 v) => ast.int{v};
p_lit(f64 v) => ast.float{v};
p_lit(str v) => ast.string{v};
p_lit(bool v) => ast.name{if(v) "true" else "false"};
p_lit(v) => v;
p_index(names, str n) {
  i = -1;
  for(k : range(names.size)) if(names[k] == n) i = k;
  i
}
p_run(p_map p, xs, i64 k, i64 c) {
  r = p_run(p_seq{p.ps, false}, xs, k, c);
  if(!r[0]) return r;
  items = array{};
  for(f : fields(p.t)) {
    i = p_index(p.names, f.name);
    if(i < 0) return p_fail(xs, k, c, "map: нет парсера поля " + f.name);
    items = array{...items, p_lit(r[2][i])};
  }
  p_ok(r[1], r[4], ast.construct{ast.name{text(p.t)}, items})
}
// all input: after parsing, the end (and not in the middle of the atom)
p_whole(p, xs) {
  r = p_run(as_parser(p), xs, 0, 0);
  if(r[0] && ((r[1] < xs.size) || (r[4] > 0))) return p_fail(xs, r[1], r[4], "лишнее: ожидался конец блока");
  r
}
// parse(r, p) is the block rule: syntax {r} => parse(r, p).
parse(code r, p) {
  ast.raw{_, items, _, _, _} = r;
  x = p_whole(p, items);
  if(!x[0]) return parse_error_in{if(given(x[3])) x[3] else r, x[2], x[4]};
  p_lit(x[2])
}

// The compiler in the language is a single code generation JIT (step to bootstrapping, §10.4):
// 
// 
// . Compilation is the calculation of the program code in the context
// of:
// 
// The target is entity (amd64, arm64): its members (cg.load, cg.jump...) and redefined
// operations (op_codegen: operator node of an operand-type program) are bytes. Without
// strings: - type node - tag (ast.operation, ast.if...), node - unpacking sample, types -
// values (i64, array(i64), stream(f64)). node types and chain trees are found in parsing
// instance: .The registers of the model (acc, second...) and tag offset (target, fault) code
// generator are taken from the compiler environment (O4). Challenges - semantic inlining
// (D10); recursion - call to its beginning. Input (author's decision: slot from VM, without
// addresses host in the code): the area of arguments - scalar word, array - {данные, размер},
// behind them error type, node, thrown value and its type, VM service. The JIT calls
// jit_compile(цель, код функции, типы параметров, тип результата); the cause-line does not
// know.
//
//
//
struct jc_range {} // Tag: the value of range(n) - in the slot the boundary n
struct jc_ref {} // Tag: link &e = xs[k] - in the slot index k, th - node xs[k], th_top - array variable
struct jc_lane {} // Tag: instance index in the body of the cycle by stripes - in slot i (first page index)
// domain resource (destroy, shared - tail of step 10): value slot, block depth, name
struct jc_res { i64 slot; i64 depth; str name; }

// name in the environment: slot (kind - type; array - two slots: data, size; jc_range -
// boundary) or expr-parameter (code, context, environment and caller function)
struct jc_var { str name; type kind; i64 slot; bool thunk; code th; i64 th_ctx; i64 th_top; i64 th_base; i64 th_ret; }

// Local function of the block: code and lexical form of the ad (which was visible in its place)
struct jc_lfn { str name; code f; i64 top; i64 base; i64 ctx; i64 ret; }

// Recursive local function subroutine: code, parameter types, ad type, embedding context,
// entry label
struct jc_sub { code f; array kinds; array envsnap; i64 base; i64 ctx; i64 entry; array lfs; }

// generator waiting for its for: body spawn (expr) and its appearance, area, slots that the
// body reads outside, spawn node
struct jc_gen { code w; i64 w_ctx; i64 w_top; i64 w_base; i64 w_ret; i64 region; array caps; code at; }

// frame of the generator convolution (conveyor: external - in the stack, while folded nested)
struct jc_fuse { i64 stream; type elem; code body; array env; i64 top; i64 base; i64 ctx; i64 cur; array outer; array caps; i64 closes; bool fusing; bool in_b; }

// catch in machine code: type (unit - any), label, variable value, stack depth
struct jc_catch { type ty; i64 label; bool binds; str name; i64 slot; i64 depth; }

// JIT prefilter (M6, step 2 - from C++ to the language): what the machine code knowingly does not
// execute - up to parsing instance, the result is array {} or array {узел, причина}; the string
// node puts VM. Lines, aggregates and kernel calls are not here: they are computed by VM through
// the service (user solution 2026-10-01). .
//
jit_precheck(f) {
  ast.function{_, params, _, body, _, _, _, _, _} = f;
  for(p : params) {
    ast.parameter{_, t, mode, pack, _, _, _} = p;
    if(pack && (mode == 0)) return array{p, "хвост аргументов ...xs — интерпретатор"};
  }
  jit_rejects(body, code_module(f))
}

// ct-variables of the module: read in place in canonical order (§7.3) - not the way of execution
jit_module_ct(m) {
  names = array{};
  for(x : code_items(m))
    if(code_kind(x) == ast.variable) {
      ast.variable{name, _, _, _, is_ct, _, _, _} = x;
      if(is_ct) names.push(name);
    }
  names
}

jit_rejects(c, m) => jit_rejects_in(c, if(given(m) && (code_kind(m) == ast.module)) jit_module_ct(m) else array{});

jit_rejects_in(c, cts) {
  if(!given(c)) return array{};
  kind = code_kind(c);
  up = code_parent(c);
  if((kind == ast.call) && (code_name(c) == "try_compile")) return array{c, "узел ast.call"}; // try_compile { … } - parsing sample
  if(kind == ast.hole) return array{c, "узел ast.hole"};
  if((kind == ast.pattern) && (code_kind(up) != ast.unpack)) return array{c, "узел ast.pattern"};
  if((kind == ast.spread) && (code_kind(up) != ast.construct)) return array{c, "узел ast.spread"}; // ... in array {…}, the value of VM
  if(kind == ast.ct) return array{c, "ct — по месту вызова (канонический порядок)"};
  if(kind == ast.name) {
    nm = code_name(c);
    for(x : cts) if(x == nm) return array{c, "ct-переменная модуля — по месту (канонический порядок)"};
  }
  for(x : code_items(c)) {
    r = jit_rejects_in(x, cts);
    if(r.size > 0) return r;
  }
  array{}
}

// Does the body create streams (stream(…) call): element types after the second pass of parsing?
jit_makes_streams(c) {
  if(!given(c)) return false;
  if((code_kind(c) == ast.call) && (code_name(c) == "stream")) return true;
  for(x : code_items(c)) if(jit_makes_streams(x)) return true;
  false
}

jit_compile(cg, f, types, type result) {
  array{acc, second, acc_f, second_f, argbase, frame, stack, third, ca0, ca1, ca2, ca3, cret2, outer_r} = cg.model();
  ok = true;
  why = "";
  // array - the address of the VM value cell; the data and size code reads from it at the time of
  // circulation (§12.2: memory - at VM, without copies in the frame): offsets tell VM
  array{a_data, a_size, a_cap, a_items_n} = jit_layout(); // size of the overall layout - a_items_n
  array{s_data, s_len} = jit_str_layout(); // string - bytes in words and length (32 bits)
  // aggregate - fields in the cell memory by type field number: field data, step, scalar in the field
  array{ag_data, ag_stride, ag_scalar} = jit_agg_layout();
  bad(str w) => {
    if(ok) why = w;
    ok = false;
  };
  out = array{};
  // Transitions to tags - data with a view, not closures in the array
//:
  // array {место, метка, вид, a, b}; view: 0 jump, 1 jump_unless a, 2 jump_if a, 3 check_index a
  // b, 4 division (b - node number in fix_ops), 5 call_self, 6 transition condition (a - 1: when,
  // 0: unless; b - number in fix_conds), 7 a > b (bands)
  fixes = array{};
  fix_ops = array{};
  fix_conds = array{}; // transition conditions (type 6): node and known second operand
  labels = array{};
  faults = array{};
  loops = array{};
  loop_nodes = array{}; // node Covering Cycles (ast.loop) for jit_loop_keeps
  loop_slot0 = array{}; // nslots at cycle entry: slot smaller - variable declared before cycle
  hoists = array{}; // rendered: array{cycle depth, array slot, 0 data / 1 size, value slot}
  env = array{};
  top = 0; // busy env
  base = 0; // first entry of the current (built-in) function
  ctx = 0; // Embedded context (as in parsing)
  nslots = 0;
  depth = 0; // Temporary on the stack (push_tmp) - transition to catch removes them
  tries = array{}; // Covering try: jc_catch arrays
  jumps = 0; // throw, which became the transition to catch
  lx = cg.lanes; // Objective context: instance by band (O6)
  lane_loops = 0; // instance cycles over bands
  lane_arrs = array{}; // body arrays in stripes (numbers in env) and their data (slots) - before the cycle
  lane_data = array{};
  fr_fn = array{}; // Built-in functions from the root: code, output, who embedded (return(f), return(caller))
  fr_exit = array{};
  fr_parent = array{};
  cur = 0;
  // Generator → cycle (O11): s = stream(…); spawn { W }; for(x : s) B - without fiber : in the
  // place for W is executed, where write(s, v) is B with x = v:
// Conditions like
  // Former C++ gluing (*mine*): Observables do not change.
  gens = array{}; // jc_gen awaiting for
  lfns = array{}; // jc_lfn: Local functions of blocks (semantic inlining, capture - spaces of the enclosing)
  // resources (§12.2, tail of step 10): - the block's resources are freed at its end by the VM service
  // (destroy - at VM, *my*: one semantics with an interpreter), transfer and copy solves VM (take to
  // place); exit through a live resource (break, return, throw) - interpreter
  //
  res_live = array{}; // jc_res
  blk_depth = 0;
  loop_blk = array{}; // block-depth
  vm_take = false; // next service 8 - with the transfer of the name (take), as in the assignment
  lres = array{}; // [function code, result type] - from an external call (in recursive parsing does not know)
  SUB = 1048576; // Subprogram Slot Numbers - from this database
  gen_sub = false; // subroutine
  sub_n = 0; // slots
  subs = array{}; // Recursive local functions: jc_sub
  sub_done = 0; // How many of them are generated
  region = 0; // Control area: branch or cycle body
  regions = 0;
  fusing = false; // Convolution: W is generated.
  in_b = false; // inside W - body of consumer B
  f_stream = -1; // convolutional
  f_elem = unit;
  f_body = f; // block for: (x) { B }
  f_env = array{}; // The environment of the place for - B is generated in it.
  f_top = 0;
  f_base = 0;
  f_ctx = 0;
  f_cur = 0;
  f_outer = array{}; // slots visible from the outside
  f_caps = array{}; // slots that W reads
  f_closes = 0;
  // Conveyor: W writer himself reads the flow of another generator - it is folded into for inside W,
  // and its consumer is code W: the frame of the external convolution acts on the time of the
  // consumer's body
// Checks of the enclosed - guards b_caps / b_streams.
  fuse_stack = array{};
  b_caps = array{}; // Slots that read generators whose consumer body is now being generated
  b_streams = array{}; // streams
  late_close = array{}; // nested threads: close VM after external convolution (in W it is the place of error): [slot, node]
  has(xs, i64 x) => {
    r = false;
    for(y : xs) if(y == x) r = true;
    r
  };
  is_stream(type t) => (t == stream(i64)) || ((t == stream(f64)) || (t == stream(bool)));
  is_arr(type t) => (t == array(i64)) || (t == array(f64));
  // array with the type of elements known later (array {} before push): the slot still has the address of the cell
  arr_like(type t) => is_arr(t) || (type_family(t) == type_family(array(i64)));
  // array<?>: the elements are not yet known (declared empty literature, recognized growth). typeof(array{})
  // was a type of array, and parsing called such an array array <?>: the comparison did not work, the size
  // was read from the general list, the cycle on the array went without iterations (quietly).
  late(type t) => fmt"{t}" == "array<?>";
  // variable array type s at place o: parsing at place of use
  arr_type(i64 s, o) => if(is_arr(env[s].kind)) env[s].kind else {
    u = jit_type(o, ctx);
    if(given(u)) u else env[s].kind
  };
  // value of VM (author's decision 2026-10-01: memory - VM): in the slot - the address of
  // his cell (the array - too: data and size code reads from the cell)
  is_handle(type t) => (t != unit) && (!((t == i64) || ((t == bool) || ((t == f64) || is_stream(t)))) && ((t != jc_range) && (t != jc_ref)));
  scalar(type t) => (t == i64) || ((t == bool) || ((t == f64) || is_stream(t))); // flow
  elem(type t) => if((t == array(f64)) || (t == stream(f64))) f64 else if(t == stream(bool)) bool else i64;
  if(!scalar(result) && ((result != unit) && !is_handle(result))) bad("тип результата"); // VM (and array) - the address of the cell in acc
  // parameter: scalar, VM value (cell address), unit - compile-time instance (not transmitted)
  put_bytes(bytes) => {
    for(b : bytes) out.push(b);
  };
  label() => {
    labels.push(-1);
    labels.size - 1
  };
  bind(i64 l) => {
    labels[l] = out.size;
  };
  // transition to the label: code generator from offset (before binding - 0, then - present)
  // bytes of transition of the form k with displacement o to the label
  fix_bytes(i64 k, i64 a, i64 b, i64 o) => {
    target = o;
    fault = o;
    if(k == 0) cg.jump()
    else if(k == 1) cg.jump_unless(a)
    else if(k == 2) cg.jump_if(a)
    else if(k == 3) cg.check_index(a, b)
    else if(k == 4) apply_op(fix_ops[b], i64, op_codegen(cg, fix_ops[b], array{i64, i64}))
    else if(k == 6) cond_bytes(a, fix_conds[b])
    else if(k == 7) lx.over(a, b)
    else cg.call_self()
  };
  jump_to(i64 l, i64 k, i64 a, i64 b) => {
    fixes.push(array{out.size, l, k, a, b});
    put_bytes(fix_bytes(k, a, b, 0));
  };
  jump(i64 l) => jump_to(l, 0, 0, 0);
  jump_unless(i64 r, i64 l) => jump_to(l, 1, r, 0);
  jump_if(i64 r, i64 l) => jump_to(l, 2, r, 0);
  off(i64 k) => 0 - (8 * (k + 1));
  alloc(i64 n) => if(gen_sub) {
    k = sub_n;
    sub_n += n;
    SUB + k // subroutine slot - her frame
  } else {
    k = nslots;
    nslots += n;
    k
  };
  // Slot - in its frame; the subroutine (recursive local function) has surround slots -
  // through the register of its frame: capture by link
// 
  sb(i64 slot_no) => if(gen_sub && (slot_no < SUB)) outer_r else frame;
  // Variables-scalars of the body function - in target registers (var_regs, first declared): as
  // in JIT M1 (user decision). The register slot has a place in the frame: before the call (VM
  // service, subroutine, recursion), the values are in the frame, after - back: switching is a
  // call,
  // 
// The subprogramme
  // (recursive local function) everything is in memory: its frame and frame encompassing.
  array{gp_regs, f_regs} = cg.var_regs();
  tmp_regs = cg.temp_regs(); // Temporary expressions without calls: [whole, f64]
  tmp_used = array{0, 0};
  rv_slot = array{};
  rv_reg = array{};
  rv_f = array{};
  rv_gp = 0;
  rv_fn = 0;
  reg_of(i64 at) => {
    k = -1;
    if(!gen_sub) for(i : range(rv_slot.size)) if(rv_slot[i] == at) k = i;
    k
  };
  give_reg(i64 at, type kind) => if(!gen_sub) {
    if(kind == f64) {
      if(rv_fn < f_regs.size) {
        rv_slot.push(at);
        rv_reg.push(f_regs[rv_fn]);
        rv_f.push(true);
        rv_fn += 1;
      }
    } else if((kind == i64) || (kind == bool)) {
      if(rv_gp < gp_regs.size) {
        rv_slot.push(at);
        rv_reg.push(gp_regs[rv_gp]);
        rv_f.push(false);
        rv_gp += 1;
      }
    }
  };
  // slot to register r / from register r (bits; f64 in register f64 - transfer)
  slot_ld(i64 r, i64 at) => {
    k = reg_of(at);
    if(k < 0) cg.load(r, sb(at), so(at)) else if(rv_f[k]) cg.move_from_f64(r, rv_reg[k]) else cg.move(r, rv_reg[k])
  };
  slot_st(i64 at, i64 r) => {
    k = reg_of(at);
    if(k < 0) cg.store(sb(at), so(at), r) else if(rv_f[k]) cg.move_to_f64(rv_reg[k], r) else cg.move(rv_reg[k], r)
  };
  slot_ldf(i64 r, i64 at) => {
    k = reg_of(at);
    if(k < 0) cg.load_f64(r, sb(at), so(at)) else if(rv_f[k]) cg.move_f64(r, rv_reg[k]) else cg.move_to_f64(r, rv_reg[k])
  };
  slot_stf(i64 at, i64 r) => {
    k = reg_of(at);
    if(k < 0) cg.store_f64(sb(at), so(at), r) else if(rv_f[k]) cg.move_f64(rv_reg[k], r) else cg.move_from_f64(rv_reg[k], r)
  };
  spill() => if(!gen_sub) for(i : range(rv_slot.size)) {
    o = so(rv_slot[i]);
    rg = rv_reg[i];
    put_bytes(if(rv_f[i]) cg.store_f64(frame, o, rg) else cg.store(frame, o, rg));
  };
  reload() => if(!gen_sub) for(i : range(rv_slot.size)) {
    o = so(rv_slot[i]);
    rg = rv_reg[i];
    put_bytes(if(rv_f[i]) cg.load_f64(rg, frame, o) else cg.load(rg, frame, o));
  };
  so(i64 slot_no) => off(if(slot_no >= SUB) slot_no - SUB else slot_no);
  put(v) => {
    if(top < env.size) env[top] = v;
    else env.push(v);
    top += 1;
  };
  declare(str name, type kind) => {
    s = alloc(1); // array and VM value - cell address
    give_reg(s, kind);
    put(jc_var{name, kind, s, false, f, 0, 0, 0, 0});
    s
  };
  find(str name) => {
    k = -1;
    for(i : range(top)) if((i >= base) && (env[i].name == name)) k = i;
    k
  };
  load_slot(type kind, i64 s) => put_bytes(if(kind == f64) slot_ldf(acc_f, s) else slot_ld(acc, s));
  // a record that would make the order W and B observable
  wrote(i64 sl) => {
    for(cs : b_caps) if(has(cs, sl)) bad("потребитель пишет то, что читает генератор");
    if(!fusing) {
      for(g : gens) if(has(g.caps, sl)) bad("переменную генератора меняют после spawn");
    } else if(!in_b && has(f_outer, sl)) bad("генератор пишет наружу");
    else if(in_b && has(f_caps, sl)) bad("потребитель пишет то, что читает генератор");
  };
  store_slot(type kind, i64 s) => {
    wrote(s);
    store_bytes(kind, s);
  };
  store_bytes(type kind, i64 s) => put_bytes(if(kind == f64) slot_stf(s, acc_f) else slot_st(s, acc));
  take_first(xs, i64 n) => {
    r = array{};
    for(i : range(n)) r.push(xs[i]);
    r
  };
  drop_last(xs) => {
    r = array{};
    for(i : range(xs.size - 1)) r.push(xs[i]);
    r
  };
  // the nearest catch for the type (last try - first); unit - any
  catch_for(type t) => {
    r = array{};
    for(i : range(tries.size)) {
      for(c : tries[tries.size - (1 + i)]) if((r.size == 0) && ((c.ty == unit) || (c.ty == t))) r.push(c);
    }
    r
  };
  // Trap: tag, view (1 - boundaries, 2 - division by zero, 3 - require, 5 - throw, 6 - VM), node
  vm_error_type(i64 kind) => if(kind == 1) out_of_bounds else if(kind == 2) div_by_zero else if(kind == 3) require_failed else vm_error;
  trap(i64 kind, e) => {
    if(fusing && !in_b) bad("генератор может упасть: свёртка изменила бы, где ошибка");
    l = label();
    to = catch_for(vm_error_type(kind));
    if(to.size == 0) faults.push(if(gen_sub) array{l, kind, code_id(e), 1} else array{l, kind, code_id(e)}); // from the sub-programme - a frame encompassing
    else if(to[0].binds) bad("catch использует объект ошибки VM");
    else faults.push(array{l, -2, to[0].label, depth - to[0].depth}); // VM error in try - transition to catch
    l
  };
  // Caller environment: records above its top - to the side, then back parameters - alias (often env
  // recording fields that g() will overwrite): values - at the beginning
  in_view(i64 t0, i64 b, i64 c, i64 rt, g) => {
    i64 t = t0;
    saved = array{};
    for(i : range(top - t)) saved.push(env[t + i]);
    old_top = top;
    old_base = base;
    old_ctx = ctx;
    old_cur = cur;
    top = t;
    base = b;
    ctx = c;
    cur = rt; // return in the caller code - from its function (semantic inlining)
    r = g();
    for(i : range(saved.size)) env[t + i] = saved[i];
    top = old_top;
    base = old_base;
    ctx = old_ctx;
    cur = old_cur;
    r
  };
  var_of(e) => if(code_kind(e) == ast.name) {
    ast.name{name} = e;
    find(name)
  } else -1;
  callee_name(e) => if(code_kind(e) == ast.name) {
    ast.name{name} = e;
    name
  } else "";
  is_call_of(e, str name) => (code_kind(e) == ast.call) && {
    ast.call{c, _, _, _, _, _, _} = e;
    callee_name(c) == name
  };
  // ct-state of value (§5.6) machine code does not carry: the code with it is executed by the interpreter
  ct_state_op(str name) => (name == "ct_state") || ((name == "set_ct_state") || (name == "call_site"));
  uses_ct_state(e) => {
    found = (code_kind(e) == ast.call) && {
      ast.call{c, _, _, _, _, _, _} = e;
      ct_state_op(callee_name(c))
    };
    for(x : code_items(e)) if(!found) found = uses_ct_state(x);
    found
  };
  // node type: name - by the environment of the compiler, otherwise - by parsing, otherwise - by the appearance of node
  ty(e) => {
    k = code_kind(e);
    v = var_of(e);
    t = jit_type(e, ctx);
    if(v >= 0) {
      w = env[v];
      if(w.thunk) in_view(w.th_top, w.th_base, w.th_ctx, w.th_ret, () => ty(w.th)) else if(w.kind == jc_ref) ref_elem(v)
      else if(!is_arr(w.kind) && (arr_like(w.kind) && (given(t) && late(w.kind)))) t // array {} - the type of element here knows parsing
      else w.kind
    } else if(given(t)) t
    else if((k == ast.call) && (local_fns(callee_name(code_items(e)[0])).size > 0)) { // Local recursion - the type of external call
      r = unit;
      for(x : local_fns(callee_name(code_items(e)[0]))) for(lr : lres) if(lr[0] == code_id(x)) r = lr[1];
      r
    } else if(is_call_of(e, "index")) { // Primitive kernel a[i] - type of element
      ast.call{_, ys, _, _, _, _, _} = e;
      a = ty(ys[0]);
      if(a == jc_range) i64 else elem(a)
    } else if(k == ast.int) i64
    else if(k == ast.float) f64
    else if(k == ast.operation) {
      ast.operation{op, xs, _} = e;
      if(op == ".size") i64
      else if(op == "[]") {
        a = ty(xs[0]);
        if(a == jc_range) i64 else elem(a)
      } else if((op == "!") || ((op == "==") || ((op == "!=") || ((op == "<") || ((op == "<=") || ((op == ">") || ((op == ">=") || ((op == "&&") || (op == "||"))))))))) bool
      else ty(xs[0])
    } else if(k == ast.chain) {
      c = jit_chain(e, ctx);
      if(c.size == 0) unit else ty(c[0])
    } else unit
  };
  gen_name(e) => {
    ast.name{name} = e;
    k = find(name);
    if(name == "true") put_bytes(cg.load_const(acc, 1));
    else if(name == "false") put_bytes(cg.load_const(acc, 0));
    else if(k < 0) bad(fmt"имя {name}");
    else if(env[k].thunk) {
      v = env[k];
      if(code_kind(v.th) == ast.lambda) bad("блок — только body(v)");
      else in_view(v.th_top, v.th_base, v.th_ctx, v.th_ret, () => gen(v.th));
    } else if(is_stream(env[k].kind) && pending(env[k].slot)) bad("поток генератора используется не через for");
    else if(is_stream(env[k].kind) && ((fusing && (in_b && (env[k].slot == f_stream))) || has(b_streams, env[k].slot))) bad("потребитель трогает поток генератора");
    else if(is_handle(env[k].kind)) put_bytes(slot_ld(acc, env[k].slot)); // VM is the address of its cell
    else if(env[k].kind == jc_ref) ref_load(k);
    else if(env[k].kind == unit) {
