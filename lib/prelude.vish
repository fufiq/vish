        t = ty(xs[i]);
        if(t != types[i]) bad(fmt"аргумент {t} вместо {types[i]}");
        gen(xs[i]);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
      }
      put_bytes(slot_st(k0 + i, acc));
    }
    for(i : range(xs.size)) {
      put_bytes(slot_ld(acc, k0 + i));
      put_bytes(slot_st(pslots[i], acc));
    }
    jump(body_start);
  };
  // Self-challenge: the field of arguments called in your frame (region[j] - slot k0 + w -
  // 1 - j: the frame grows down), its address - in the base of arguments, call to its
  // beginning; the error of the called - in their slots and output (like a trap).
  call_self_with(xs) => {
    if(fusing && !in_b) bad("генератор: настоящий вызов");
    if(gen_sub) bad("рекурсивный вызов функции из её локальной функции");
    ws = 0;
    ws = xs.size; // array - cell address (one word)
    w = ws + 6; // + Error (4), VM service, call memory
    k0 = alloc(w);
    area(i64 j) => off((k0 + w) - (1 + j));
    j = 0;
    for(i : range(xs.size)) {
      if(is_arr(types[i])) {
        s = var_of(xs[i]);
        if((s < 0) || (env[s].thunk || (env[s].kind != types[i]))) bad("массив в рекурсивный вызов");
        else {
          put_bytes(slot_ld(acc, env[s].slot));
          put_bytes(cg.store(frame, area(j), acc));
        }
        j += 1;
      } else {
        t = ty(xs[i]);
        if(t != types[i]) bad(fmt"аргумент {t} вместо {types[i]}");
        gen(xs[i]);
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(cg.store(frame, area(j), acc));
        j += 1;
      }
    }
    put_bytes(cg.load_const(acc, 0));
    put_bytes(cg.store(frame, area(ws), acc));
    for(q : range(2)) { // VM service, call memory - from your field
      put_bytes(slot_ld(acc, args_slot));
      put_bytes(cg.load(acc, acc, 8 * ((ap + 4) + q)));
      put_bytes(cg.store(frame, area((ws + 4) + q), acc));
    }
    put_bytes(cg.address(argbase, frame, area(0)));
    spill();
    jump_to(entry, 5, 0, 0);
    reload();
    put_bytes(cg.move(third, acc)); // result - for now
    put_bytes(cg.load(acc, frame, area(ws)));
    l = label();
    faults.push(array{l, -1, area(ws)}); // -1 - Transfer of an error caused
    jump_if(acc, l);
    put_bytes(cg.move(acc, third));
    if(result == f64) put_bytes(cg.move_to_f64(acc_f, acc));
  };
  // throw: catch выбран при компиляции по типу — значение в его переменную и переход;
  // not caught here - in the area slots (view 5, node, value, type) and output
  gen_throw(e) => {
    ast.throw{v} = e;
    t = ty(v);
    if(res_live.size > 0) bad("throw при живом ресурсе — интерпретатор");
    else if(!scalar(t)) bad(fmt"throw значения {t}");
    else {
      gen(v);
      to = catch_for(t);
      if(to.size == 1) {
        c = to[0];
        if(c.binds) store_slot(t, c.slot);
        if(depth > c.depth) put_bytes(cg.stack_free(8 * (depth - c.depth)));
        jump(c.label);
        jumps += 1;
      } else {
        if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
        put_bytes(slot_ld(second, args_slot));
        put_bytes(cg.store(second, 8 * (ap + 2), acc));
        put_bytes(cg.load_const(acc, jt_code(t)));
        put_bytes(cg.store(second, 8 * (ap + 3), acc));
        l = label();
        faults.push(array{l, 5, code_id(e)});
        jump(l);
      }
    }
  };
  // How many times a name appears in the code (catch(e) without using e)
  uses(c, str name) => {
    n = if(callee_name(c) == name) 1 else 0;
    for(x : code_items(c)) n += uses(x, name);
    n
  };
  // try {body } catch(T e) { … } … = intercept(body, blocks):
// catch - by type, when compiling
  // with_alloc(r) { тело } is the core of alloc_in: level r - VM (services 13/14), body - here
  // 
  gen_alloc_in(e, xs) => {
    b = var_of(xs[1]);
    if((b < 0) || !env[b].thunk) bad("alloc_in не над expr-параметром");
    else if(tries.size > 0) bad("with_alloc внутри try");
    else {
      vm_eval(xs[0], ty(xs[0])); // cell address region - in acc
      put_bytes(cg.move(ca2, acc));
      vm_service(13, unit, e);
      bv = env[b];
      in_view(bv.th_top, bv.th_base, bv.th_ctx, bv.th_ret, () => gen(bv.th));
      t = ty(e);
      keep = alloc(1);
      if(t == f64) put_bytes(cg.move_from_f64(acc, acc_f));
      put_bytes(slot_st(keep, acc));
      vm_service(14, unit, e);
      put_bytes(slot_ld(acc, keep));
      if(t == f64) put_bytes(cg.move_to_f64(acc_f, acc));
    }
  };
  gen_intercept(xs) => {
    b = var_of(xs[0]);
    h = var_of(xs[1]);
    if((b < 0) || ((h < 0) || (!env[b].thunk || !env[h].thunk))) bad("intercept не над expr-параметрами");
    else {
      hv = env[h];
      hs = if(code_kind(hv.th) == ast.construct) { // pack-clause
        ast.construct{_, items, _} = hv.th;
        items
      } else array{hv.th};
      frame_c = array{};
      lams = array{};
      for(l : hs) {
        ps = array{};
        body = l;
        if(ast.lambda{lps, lbody, _} = l) {
          ps = lps;
          body = lbody;
        }
        if(ps.size != 1) bad("catch не блок с параметром");
        else {
          ast.parameter{pname, pt, _, _, _, _, _} = ps[0];
          cty = if(given(pt)) type_of_code(pt) else unit;
          binds = (pname != "_") && (uses(body, pname) > 0);
          if(binds && !scalar(cty)) bad("catch использует значение, неизвестное машинному коду");
          frame_c.push(jc_catch{cty, label(), binds, pname, if(binds) alloc(1) else 0, depth});
          lams.push(body);
        }
      }
      done = label();
      tries.push(frame_c);
      bv = env[b];
      in_view(bv.th_top, bv.th_base, bv.th_ctx, bv.th_ret, () => gen(bv.th));
      tries = drop_last(tries);
      jump(done);
      for(i : range(frame_c.size)) {
        c = frame_c[i];
        bind(c.label);
        in_view(hv.th_top, hv.th_base, hv.th_ctx, hv.th_ret, () => {
          if(c.binds) put(jc_var{c.name, c.ty, c.slot, false, f, 0, 0, 0, 0});
          gen(lams[i]);
        });
        jump(done);
      }
      bind(done);
    }
  };
  // body(v): Arguments are here, the block body is in the environment and context of the defiant
  call_block(v, xs) => {
    l = v.th;
    ps = array{};
    body = l;
    block = false;
    if(ast.lambda{lps, lbody, lblock} = l) {
      ps = lps;
      body = lbody;
      block = lblock;
    }
    if(code_kind(l) != ast.lambda) bad("вызов expr-параметра, который не блок и не лямбда");
    else if(ps.size != xs.size) bad("арность блока");
    else {
      binds = array{};
      for(i : range(xs.size)) {
        t = ty(xs[i]);
        if(!scalar(t)) bad(fmt"аргумент блока типа {t}");
        gen(xs[i]);
        sl = alloc(1);
        give_reg(sl, t); // block name is a variable as declared
        store_slot(t, sl);
        ast.parameter{pname, _, _, _, _, _, _} = ps[i];
        binds.push(jc_var{pname, t, sl, false, f, 0, 0, 0, 0});
      }
      if(ok && block) in_view(v.th_top, v.th_base, v.th_ctx, v.th_ret, () => {
        for(b : binds) put(b);
        gen(body);
      });
      // Lambda value - semantic inlining in the form of its definition (capture - location of
      // definition), its output for return; context parsing - place of call (as call_value)
      else if(ok) in_view(v.th_top, v.th_base, ctx, v.th_ret, () => {
        for(b : binds) put(b);
        exit = label();
        fr_fn.push(l);
        fr_exit.push(exit);
        fr_parent.push(cur);
        cur = fr_fn.size - 1;
        gen(body);
        bind(exit);
        fr_fn = drop_last(fr_fn);
        fr_exit = drop_last(fr_exit);
        fr_parent = drop_last(fr_parent);
      });
    }
  };
  // branch or body of the cycle: the spawn inside coagulates only with for in it
  in_region(g) => {
    saved = region;
    regions += 1;
    region = regions;
    g();
    for(x : gens) if(x.region == region) bad("spawn без for по его потоку в той же области");
    region = saved;
  };
  // Names in the code (for what W reads outside)
  idents(c, found) => {
    if(code_kind(c) == ast.name) {
      ast.name{nm} = c;
      found.push(nm);
    }
    for(x : code_items(c)) idents(x, found);
  };
  pending(i64 sl) => {
    r = false;
    for(g : gens) if(has(g.caps, sl)) r = true;
    r
  };
  // spawn { W }: the generator is waiting for its flow
  gen_spawn(e, b) => {
    v = var_of(b);
    if(fusing) bad("spawn внутри генератора");
    else if((v < 0) || !env[v].thunk) bad("spawn");
    else {
      w = env[v];
      names = array{};
      idents(w.th, names);
      caps = array{};
      in_view(w.th_top, w.th_base, w.th_ctx, w.th_ret, () => {
        for(nm : names) {
          k = find(nm);
          if((k >= 0) && !env[k].thunk) caps.push(env[k].slot);
        }
      });
      gens.push(jc_gen{w.th, w.th_ctx, w.th_top, w.th_base, w.th_ret, region, caps, e});
    }
  };
  // for(stream s, expr body) on the stream that the waiting spawn sees: generator number
  generator_of(a) => {
    k = -1;
    if(!(fusing && in_b) && (gens.size > 0)) { // c W - nested convolution (conveyor)
      v = var_of(a);
      if((v >= 0) && (!env[v].thunk && is_stream(env[v].kind))) {
        for(i : range(gens.size)) if((k < 0) && has(gens[i].caps, env[v].slot)) k = i;
      }
    }
    k
  };
  is_block(c) => (code_kind(c) == ast.lambda) && {
    ast.lambda{_, _, block} = c;
    block
  };
  // B does not leave the cycle for: no return, break/continue - only its cycles
  consumer_stays(c, i64 inl) => {
    k = code_kind(c);
    if(k == ast.return) false
    else if(((k == ast.break) || (k == ast.continue)) && (inl == 0)) false
    else {
      inner = inl + if((k == ast.loop) || is_block(c)) 1 else 0;
      r = true;
      for(x : code_items(c)) if(r && !consumer_stays(x, inner)) r = false;
      r
    }
  };
  arity_fns(str nm, i64 n) => {
    fs = array{};
    for(g : functions_named(nm)) {
      ast.function{_, ps, _, _, _, _, _, _, _} = g;
      if(ps.size == n) fs.push(g);
    }
    fs
  };
  // return/throw/close outside the W tail (with evoked functions)
  gen_escapes(c, seen) => {
    k = code_kind(c);
    r = false;
    if((k == ast.return) || (k == ast.throw)) r = true;
    else if(k == ast.call) {
      ast.call{cal, cxs, _, _, _, _, _} = c;
      nm = callee_name(cal);
      if(nm == "close") r = true;
      else if(nm != "") {
        for(g : arity_fns(nm, cxs.size)) if(!r && !has(seen, code_id(g))) {
          seen.push(code_id(g));
          ast.function{_, _, _, gb, _, _, _, _, _} = g;
          if(gen_escapes(gb, seen)) r = true;
        }
      }
    }
    for(x : code_items(c)) if(!r && gen_escapes(x, seen)) r = true;
    r
  };
  // overload calls in body W by type parsing (context of embedding cc): one or not
  pick_fn(str nm, cxs, i64 cc) => {
    fs = array{};
    for(g : arity_fns(nm, cxs.size)) {
      ast.function{_, ps, _, _, _, _, _, _, _} = g;
      fits = true;
      for(i : range(ps.size)) {
        ast.parameter{_, pt, _, _, _, _, _} = ps[i];
        if(given(pt)) {
          want = type_of_code(pt);
          at = jit_type(cxs[i], cc);
          if(!given(want) || !given(at)) fits = false;
          else if((want != at) && (want != type_family(at))) fits = false;
        }
      }
      if(fits) fs.push(g);
    }
    fs
  };
  // W ends with close(s): the last action is close or the call that ends with it.
  gen_tail(c, seen, i64 cc) => {
    k = code_kind(c);
    if(k == ast.lambda) {
      ast.lambda{_, lb, _} = c;
      gen_tail(lb, seen, cc)
    } else if(k == ast.block) {
      ast.block{items, _, _} = c;
      r = items.size > 0;
      for(i : range(items.size)) if(r && (((i + 1) < items.size) && gen_escapes(items[i], seen))) r = false;
      r && gen_tail(items[items.size - 1], seen, cc)
    } else if(k != ast.call) false
    else {
      ast.call{cal, cxs, _, _, _, _, _} = c;
      nm = callee_name(cal);
      if(nm == "") false
      else if(nm == "close") true
      else {
        r = true;
        for(x : cxs) if(r && gen_escapes(x, seen)) r = false;
        fs = pick_fn(nm, cxs, cc);
        if(!r || ((fs.size != 1) || has(seen, code_id(fs[0])))) false
        else {
          seen.push(code_id(fs[0]));
          ast.function{_, _, _, fb, _, _, _, _, _} = fs[0];
          gen_tail(fb, seen, inline_context(cc, c))
        }
      }
    }
  };
  gen_fused(e, xs, i64 k) => {
    g = gens[k];
    v = var_of(xs[0]);
    sl = env[v].slot;
    body = xs[1];
    others = false;
    for(i : range(gens.size)) if((i != k) && has(gens[i].caps, sl)) others = true;
    if(g.region != region) bad("for по потоку генератора — не в области spawn");
    else if(others) bad("поток видят несколько spawn");
    else if(!is_block(body)) bad("тело for");
    else {
      ast.lambda{bps, bb, _} = body;
      if(bps.size != 1) bad("тело for");
      else if(!consumer_stays(bb, 0)) bad("тело for выходит из цикла");
      else if(!gen_tail(g.w, array{}, g.w_ctx)) bad("генератор: close(s) — не последнее действие, или return/throw");
      else {
        rest = array{};
        for(i : range(gens.size)) if(i != k) rest.push(gens[i]);
        gens = rest;
        if(fusing) fuse_stack.push(fuse_save());
        f_stream = sl;
        f_elem = elem(env[v].kind);
        f_body = body;
        f_env = env;
        f_top = top;
        f_base = base;
        f_ctx = ctx;
        f_cur = cur;
        f_outer = array{};
        for(i : range(g.w_top)) if(!env[i].thunk) f_outer.push(env[i].slot);
        f_caps = g.caps;
        f_closes = 0;
        fusing = true;
        in_view(g.w_top, g.w_base, g.w_ctx, g.w_ret, () => {
          wb = g.w;
          if(code_kind(wb) == ast.lambda) {
            ast.lambda{_, lb, _} = wb;
            wb = lb;
          }
          gen(wb);
        });
        closes = f_closes;
        if(fuse_stack.size > 0) {
          fuse_load(fuse_stack[fuse_stack.size - 1]);
          fuse_stack = drop_last(fuse_stack);
        } else fusing = false;
        if(closes != 1) bad("генератор: close(s) не один раз");
        // flow after the cycle - closed and empty, as after the present exchange; nested - after the external
        late_close.push(array{sl, e});
        if(!fusing) {
          for(lc : late_close) {
            array{lsl, le} = lc;
            put_bytes(slot_ld(acc, lsl));
            put_bytes(cg.move(ca1, acc));
            vm_service(4, unit, le);
          }
          late_close = array{};
        }
      }
    }
  };
  fuse_save() => jc_fuse{f_stream, f_elem, f_body, f_env, f_top, f_base, f_ctx, f_cur, f_outer, f_caps, f_closes, fusing, in_b};
  fuse_load(jc_fuse x) => {
    f_stream = x.stream;
    f_elem = x.elem;
    f_body = x.body;
    f_env = x.env;
    f_top = x.top;
    f_base = x.base;
    f_ctx = x.ctx;
    f_cur = x.cur;
    f_outer = x.outer;
    f_caps = x.caps;
    f_closes = x.closes;
    fusing = x.fusing;
    in_b = x.in_b;
  };
  // VM operation inside W: write(s, v) - consumer body with x = v; close(s) - end
  sink(e, i64 op, xs) => {
    v = if(xs.size > 0) var_of(xs[0]) else -1;
    if((v < 0) || (env[v].thunk || ((env[v].slot != f_stream) || ((op != 1) && (op != 4))))) bad("генератор: другая операция VM");
    else if(op == 4) f_closes += 1;
    else {
      t = ty(xs[1]);
      if(t != f_elem) bad("тип записи ≠ типу потока");
      else {
        gen(xs[1]);
        p = alloc(1);
        give_reg(p, t); // x consumer - variable
        store_bytes(t, p);
        ast.lambda{bps, bb, _} = f_body;
        ast.parameter{pname, _, _, _, _, _, _} = bps[0];
        w_env = env;
        w_top = top;
        w_base = base;
        w_ctx = ctx;
        w_cur = cur;
        env = f_env;
        top = f_top;
        base = f_base;
        ctx = f_ctx;
        cur = f_cur;
        nested = fuse_stack.size > 0;
        inner = fuse_save();
        if(nested) { // consumer - the code of the external W: his frame (taken off the stack), checks of the attached - by security guards
          fuse_load(fuse_stack[fuse_stack.size - 1]);
          fuse_stack = drop_last(fuse_stack);
          b_caps.push(inner.caps);
          b_streams.push(inner.stream);
        } else in_b = true;
        put(jc_var{pname, t, p, false, f, 0, 0, 0, 0});
        gen(bb);
        if(nested) {
          fuse_stack.push(fuse_save());
          b_caps = drop_last(b_caps);
          b_streams = drop_last(b_streams);
        }
        fuse_load(inner);
        in_b = false;
        env = w_env;
        top = w_top;
        base = w_base;
        ctx = w_ctx;
        cur = w_cur;
      }
    }
  };
  // A node that the compiler cannot computes VM (service, op 8):
// What is not expedited is performed by the interpreter.
  // (*my*: node, with variables that the node reads)
  name_nodes(c, found) => {
    if(code_kind(c) == ast.name) found.push(c);
    for(x : code_items(c)) name_nodes(x, found);
  };
  // VM-transmitted variables: name node, environment record; empty and bad
  vm_vars(e) => {
    nodes = array{};
    name_nodes(e, nodes);
    vs = array{};
    seen = array{};
    for(c : nodes) {
      ast.name{nm} = c;
      k = find(nm);
      if((k >= 0) && !has(seen, k)) {
        seen.push(k);
        if(env[k].thunk) bad(fmt"узел VM читает expr-параметр {nm}");
        else if(is_stream(env[k].kind) || (env[k].kind == jc_range)) bad(fmt"узел VM читает {env[k].kind}");
        else if(env[k].kind == unit) bad(fmt"узел VM читает кт-параметр {nm}");
        else vs.push(array{c, k});
      }
    }
    vs
  };
  vm_or_bad(e, str why) => {
    t = ty(e);
    if(uses_ct_state(e)) bad("ct-состояние — интерпретатор");
    else if(fusing && !in_b) bad(fmt"генератор: {why}");
    else if(tries.size > 0) bad(fmt"{why} (внутри try)");
    else if((t == jc_range) || is_stream(t)) bad(why);
    // parsing does not know the value (the element of empty array {} variable service, the path that in parsing
    // only throws): it is not the value of VM, the cell address as bool/number would be a lie (*mine*)
    else if(fmt"{t}" == "?") bad(fmt"{why}: тип узла неизвестен разбору");
    else if(jit_diverts(e)) bad(fmt"{why}: через узел VM — выход return(caller) — интерпретатор");
    else vm_eval(e, t);
  };
  vm_kind(type t) => if(is_handle(t)) 9 else jt_code(t);
  // parsing rules in the body (operator, syntax, construction - §4.4): the blocks of the structure
  // are executed with them - the layer of rules in the interpreter; machine code does not see them
  assign_symbol(str op) => (op == "=") || ((op == "+=") || ((op == "-=") || ((op == "*=") || (op == "/="))));
  starts(str s, str p) => (s.size > p.size) && {
    same = true;
    for(i : range(p.size)) if(s[i] != p[i]) same = false;
    same
  };
  op_name(str nm) => starts(nm, "infix") || (starts(nm, "prefix") || starts(nm, "postfix"));
  rule_decl(x) => (code_kind(x) == ast.function) && {
    ast.function{nm, ps, _, _, _, _, _, sc, form} = x;
    r = (form.size > 0) || op_name(nm);
    for(p : ps) {
      ast.parameter{_, _, mode, _, clause, _, _} = p;
      if((mode == 4) || (clause != "")) r = true;
    }
    r && !sc
  };
  rules_in(fn) => {
    ast.function{_, _, _, b, _, _, _, _, _} = fn;
    r = false;
    if(code_kind(b) == ast.block) {
      ast.block{items, _, _} = b;
      for(x : items) if(rule_decl(x)) r = true;
    }
    r
  };
  // The body begins with the requirement - the condition of choice overload (failure - unpack_failed at the call)
  leading_require(body) => (code_kind(body) == ast.block) && {
    ast.block{items, _, _} = body;
    (items.size > 0) && is_call_of(items[0], "require")
  };
  // the result is in acc (f64 - in acc_f), the value of VM - the address of the cell in acc
  vm_eval(e, type t) => {
    vs = vm_vars(e);
    n = vs.size;
    w = 2 + (3 * n);
    k0 = alloc(w);
    bsl(i64 j) => (k0 + w) - (1 + j);
    put_bytes(slot_ld(acc, args_slot));
    put_bytes(cg.load(acc, acc, 8 * (ap + 5)));
    put_bytes(slot_st(bsl(0), acc));
    put_bytes(cg.load_const(acc, n));
    put_bytes(slot_st(bsl(1), acc));
    for(i : range(n)) {
      v = env[vs[i][1]];
      put_bytes(cg.load_const(acc, code_id(vs[i][0])));
      put_bytes(slot_st(bsl(2 + (3 * i)), acc));
      put_bytes(cg.load_const(acc, vm_kind(v.kind)));
      put_bytes(slot_st(bsl(3 + (3 * i)), acc));
      if(v.kind == f64) {
        load_slot(f64, v.slot);
        put_bytes(cg.move_from_f64(acc, acc_f));
      } else put_bytes(slot_ld(acc, v.slot));
      put_bytes(slot_st(bsl(4 + (3 * i)), acc));
    }
    put_bytes(cg.address(ca1, sb(bsl(0)), so(bsl(0))));
    put_bytes(cg.load_const(ca2, if(vm_take) (vm_kind(t) | 256) else vm_kind(t)));
    vm_service(8, unit, e);
    keep = alloc(1); // The result is sideways while the scalars and arrays are reread
    put_bytes(slot_st(keep, acc));
    for(i : range(n)) {
      v = env[vs[i][1]];
      if(!is_handle(v.kind)) { // The scalar may have changed (mut-call parameter)
        put_bytes(slot_ld(acc, bsl(4 + (3 * i))));
        if(v.kind == f64) put_bytes(cg.move_to_f64(acc_f, acc));
        store_bytes(v.kind, v.slot);
      }
    }
    put_bytes(slot_ld(acc, keep));
    if(t == f64) put_bytes(cg.move_to_f64(acc_f, acc));
  };
  // x = e, where e is the value of VM: the address of its cell in the slot
  assign_handle(str name, e, type t, bool fresh) => {
    res = jit_resource(t);
    vm_take = res; // resource: name on the right - transfer (hide) or copy - decides VM on the place
    vm_or_bad(e, fmt"значение {t}");
    vm_take = false;
    s = if(fresh) -1 else find(name);
    if((s >= 0) && env[s].thunk) bad("присваивание expr-параметру");
    else if(ok) {
      fresh_here = s < 0;
      if(s < 0) {
        declare(name, t);
        s = top - 1;
      }
      if(env[s].kind != t) bad("тип переменной меняется");
      else {
        sl = env[s].slot;
        wrote(sl);
        if(res && !fresh_here) { // rewrite: the new is calculated, the former is released (like the interpreter)
          nv = alloc(1);
          put_bytes(slot_st(nv, acc));
          put_bytes(slot_ld(ca2, sl));
          vm_service(16, unit, e);
          put_bytes(slot_ld(acc, nv));
        }
        put_bytes(slot_st(sl, acc));
        if(res && fresh_here) res_live.push(jc_res{sl, blk_depth, name});
      }
    }
  };
  // Time-resource instruction (mk("x") ;) - released immediately
  temporary_resource(x) => {
    k = code_kind(x);
    ((k == ast.call) || (k == ast.construct)) && jit_resource(ty(x))
  };
  drop_reg(i64 r, at) => {
    put_bytes(cg.move(ca2, r));
    vm_service(16, unit, at);
  };
  live_since(i64 d) => {
    any = false;
    for(x : res_live) if(x.depth > d) any = true;
    any
  };
  // end of the block: its resources - in reverse order of the announcement; name - the value of the block
  // - goes to them (transfer to the outside); the value of the block - away while the VM service releases
  drop_block(e, items, bool hv) => {
    mine = array{};
    rest = array{};
    for(x : res_live) if(x.depth == blk_depth) mine.push(x) else rest.push(x);
    if(mine.size > 0) {
      last = if(items.size > 0) items[items.size - 1] else code();
      out_name = if(hv && (code_kind(last) == ast.name)) code_name(last) else "";
      vt = if(hv) ty(last) else unit;
      keep = alloc(1);
      if(hv) put_bytes(if(vt == f64) slot_stf(keep, acc_f) else slot_st(keep, acc));
      for(j : range(mine.size)) {
        x = mine[(mine.size - 1) - j];
        if(x.name != out_name) {
          put_bytes(slot_ld(ca2, x.slot));
          vm_service(16, unit, e);
        }
      }
      if(hv) put_bytes(if(vt == f64) slot_ldf(acc_f, keep) else slot_ld(acc, keep));
    }
    res_live = rest;
  };
  entry = label();
  bind(entry); // The beginning of the code is the purpose of call_self
  ret = label();
  fr_fn.push(f);
  fr_exit.push(ret);
  fr_parent.push(-1);
  put_bytes(cg.frame_enter());
  put_bytes(cg.move(frame, stack));
  frame_at = out.size;
  frame_size = (i64 n) => cg.frame_alloc(n);
  put_bytes(frame_size(0));
  ast.function{_, fps, _, fbody, _, _, _, _, _} = f;
  ap = 0; // argumentation
  pslots = array{}; // slots
  for(i : range(fps.size)) {
    ast.parameter{pname, _, _, _, _, _, _} = fps[i];
    s = declare(pname, types[i]);
    pslots.push(s);
    if(types[i] != unit) {
      put_bytes(cg.load(acc, argbase, 8 * ap));
      put_bytes(slot_st(s, acc));
      ap += 1;
    }
  }
  args_slot = alloc(1); // base of the field of arguments - for traps
  put_bytes(slot_st(args_slot, argbase));
  outer_save = alloc(1); // Received from the register of the frame (C ABI): return to the caller
  put_bytes(slot_st(outer_save, outer_r));
  // Sample parameter (tail of step 10): VM selected the candidate by value, names by unpacking the
  // parameter value at the input, as in the instruction sample = value (service 11)
  for(i : range(fps.size)) {
    ast.parameter{_, pt, _, _, _, _, _} = fps[i];
    if(given(pt) && (code_kind(pt) == ast.pattern)) unpack_with(pt, false, fps[i], types[i], pt, pslots[i]);
  }
  body_start = label(); // Body beginning - the goal of tail calling itself (transition, O5)
  bind(body_start);
  if(ok) gen(fbody);
  if(gens.size > 0) bad("spawn (файбер) — интерпретатор");
  bind(ret);
  if(result == f64) put_bytes(cg.move_from_f64(acc, acc_f)); // f64 - by bits in the battery
  put_bytes(slot_ld(outer_r, outer_save));
  put_bytes(cg.move(stack, frame));
  put_bytes(cg.frame_leave());
  put_bytes(cg.ret());
  while(ok && (sub_done < subs.size)) { // Recursive Local Functions - After the Body
    gen_subroutine(subs[sub_done]);
    sub_done += 1;
  }
  // trap plugs: view and node - in the slots of the argument area, output
  for(x : faults) {
    bind(x[0]);
    if((x[1] >= 0) && (x.size == 4)) put_bytes(cg.move(frame, outer_r)); // from the sub-programme: the exit from the encompassing
    if(x[1] == -2) { // VM error in try - in catch, removing temporary
      if(x[3] > 0) put_bytes(cg.stack_free(8 * x[3]));
      jump(x[2]);
      continue;
    }
    if(x[1] == 1) { // boundary: index (acc) and size (second) - in words of meaning, message as an interpreter
      put_bytes(slot_ld(third, args_slot));
      put_bytes(cg.store(third, 8 * (ap + 2), acc));
      put_bytes(cg.store(third, 8 * (ap + 3), second));
    }
    put_bytes(slot_ld(second, args_slot));
    if(x[1] < 0) { // error caused: type, node, value, type - from its area (word displacement - x[2])
      for(q : range(4)) {
        put_bytes(cg.load(acc, frame, x[2] + (8 * q)));
        put_bytes(cg.store(second, 8 * (ap + q), acc));
      }
    } else {
      put_bytes(cg.load_const(acc, x[1]));
      put_bytes(cg.store(second, 8 * ap, acc));
      put_bytes(cg.load_const(acc, x[2]));
      put_bytes(cg.store(second, 8 * (ap + 1), acc));
    }
    jump(ret);
  }
  if(!ok) return why; // It does not know the reason (performs the interpreter)
  for(f : fixes) {
    bytes = fix_bytes(f[2], f[3], f[4], labels[f[1]] - f[0]);
    for(j : range(bytes.size)) out[f[0] + j] = bytes[j];
  }
  bytes = frame_size(((8 * nslots) + 15) & -16);
  for(j : range(bytes.size)) out[frame_at + j] = bytes[j];
  note = if(jumps > 0) fmt"исключений переходом: {jumps}" else "";
  if(lane_loops > 0) note = if(note == "") fmt"циклов по полосам: {lane_loops}" else note + fmt", циклов по полосам: {lane_loops}";
  if(note != "") array{out, note} else out
}

// slice (§13.2, M6 step 3 - from C++ to language): . Function instructions that use the
// variable (and everything that is computed from it), plus what it depends on, slice remains an
// executable program; the enveloping constructs are stored along with the conditions. The
// result of slice_hidden is array {функция, скрытые инструкции…} or array {} (no function or
// name); printing with a filter is VM.
//
struct sl_stmt { code node; array defs; array uses; }

// Service functions slice - in entity sl (call outside - sl.f(…)): visibility - entity,
// without a separate mechanism .
//
sl() {
  has(xs, x) => {
    r = false;
    for(y : xs) if(y == x) r = true;
    r
  };
  add(xs, x) => if(has(xs, x)) false else {
    xs.push(x);
    true
  };
  meets(a, b) => {
    r = false;
    for(x : a) if(has(b, x)) r = true;
    r
  };
  same(a, b) => given(a) && (given(b) && (code_id(a) == code_id(b)));

  // Instruction tail: while(c) x = 1; - x = 1 is the instruction
  tail_of(call, n) => {
    ast.call{_, args, _, tail, _, _, _} = call;
    tail && ((args.size > 0) && same(args[args.size - 1], n))
  };

  // instruction: a block/module element or a structure/branch body that is not a block
  statement(n) => {
    p = code_parent(n);
    k = if(given(p)) code_kind(p) else unit;
    if(!given(p)) false
    else if((k == ast.block) || (k == ast.module)) true
    else if(k == ast.call) tail_of(p, n) && (code_kind(n) != ast.lambda)
    else if(k == ast.lambda) {
      ast.lambda{_, body, block} = p;
      block && same(body, n)
    } else if(k == ast.if) {
      ast.if{_, yes, no} = p;
      (same(yes, n) || same(no, n)) && statement(p)
    } else false
  };

  assign(str op) => (op == "=") || ((op == "+=") || ((op == "-=") || ((op == "*=") || (op == "/="))));

  // the names readable by the expression (without nested blocks: they have their own instructions); the parameters
  // of the block of construction are visible only in the block - the construction falls into slice as covering
  reads(n, names) => {
    if(given(n)) {
      k = code_kind(n);
      if(k == ast.name) add(names, code_name(n));
      else if((k != ast.block) && (k != ast.lambda)) {
        for(c : code_items(n)) {
          if(!((k == ast.call) && tail_of(n, c))) reads(c, names);
        }
      }
    }
  };

  analyze(n) => {
    defs = array{};
    uses = array{};
    k = code_kind(n);
    if(k == ast.variable) {
      ast.variable{name, _, init, _, _, _, _, _} = n;
      add(defs, name);
      reads(init, uses);
    } else if(k == ast.if) {
      ast.if{c, _, _} = n;
      reads(c, uses);
    } else if((k == ast.loop) || ((k == ast.break) || (k == ast.continue))) {
      // The cycle enters slice as encompassing the construction of stored instructions.
    } else if((k == ast.operation) && {
      ast.operation{op, _, _} = n;
      assign(op)
    }) {
      ast.operation{op, args, _} = n;
      t = args[0];
      loop {
        if(code_kind(t) != ast.operation) break;
        ast.operation{o, xs, pf} = t;
        if((o != "[]") || ((xs.size != 2) || pf)) break;
        reads(xs[1], uses);
        t = xs[0];
      }
      if(code_kind(t) == ast.name) {
        add(defs, code_name(t));
        if((op != "=") || !same(t, args[0])) add(uses, code_name(t));
      }
      reads(args[1], uses);
    } else {
      reads(n, uses);
      // The call can change the arguments - alias (§6.2); the design (for, while) action -
      // in its block, it is cut separately.
      if(k == ast.call) {
        ast.call{_, args, words, tail, _, _, _} = n;
        if(!tail && (words.size == 0)) {
          for(a : args) if(code_kind(a) == ast.name) add(defs, code_name(a));
        }
      }
    }
    sl_stmt{n, defs, uses}
  };

  // all the instructions of the body, and in local functions and lambdas: what is not stored is hidden
  statements(n, all) => {
    if(given(n)) {
      if(statement(n)) all.push(n);
      for(c : code_items(n)) statements(c, all);
    }
  };

  // Bypass the body: For each instruction, what it defines and uses
  collect(n, stmts) => {
    if(given(n)) {
      if(statement(n) && (code_kind(n) != ast.block)) stmts.push(analyze(n));
      for(c : code_items(n)) {
        skip = code_kind(c) == ast.function;
        if(code_kind(c) == ast.lambda) {
          ast.lambda{_, _, block} = c;
          skip = !block;
        }
        if(!skip) collect(c, stmts);
      }
    }
  };

  kept_has(kept, n) => {
    r = false;
    for(x : kept) if(code_id(x) == code_id(n)) r = true;
    r
  };
  keep(kept, n) => if(kept_has(kept, n)) false else {
    kept.push(n);
    true
  };
}

slice_hidden(m, str fn_name, str var) {
  fs = array{};
  for(item : code_items(m))
    if((code_kind(item) == ast.function) && (code_name(item) == fn_name)) fs.push(item);
  if(fs.size == 0) return array{};
  f = fs[fs.size - 1];
  stmts = array{};
  all = array{};
  ast.function{_, _, _, body, _, _, _, _, _} = f;
  sl.collect(body, stmts);
  sl.statements(body, all);
  named = false;
  for(s : stmts) if(sl.has(s.defs, var) || sl.has(s.uses, var)) named = true;
  if(!named) return array{};
  kept = array{};
  forward = array{var};
  backward = array{var};
  // Forward: Who uses x and all that is computed
  changed = true;
  while(changed) {
    changed = false;
    for(s : stmts)
      if(!sl.kept_has(kept, s.node) && sl.meets(s.uses, forward)) {
        kept.push(s.node);
        for(d : s.defs) sl.add(forward, d);
        changed = true;
      }
  }
  // Back: Where does x come from and everything that saves instructions use?
  for(s : stmts) {
    if(sl.kept_has(kept, s.node)) {
      for(u : s.uses) sl.add(backward, u);
    }
  }
  changed = true;
  while(changed) {
    changed = false;
    for(s : stmts)
      if(sl.meets(s.defs, backward) && sl.keep(kept, s.node)) {
        for(u : s.uses) sl.add(backward, u);
        changed = true;
      }
  }
  // control structures around and their conditions
  changed = true;
  while(changed) {
    changed = false;
    snapshot = array{};
    for(k : kept) snapshot.push(k);
    for(k : snapshot) {
      p = code_parent(k);
      while(given(p) && !sl.same(p, f)) {
        if(sl.statement(p) && sl.keep(kept, p)) {
          for(s : stmts) {
            if(sl.same(s.node, p)) {
              for(u : s.uses) sl.add(backward, u);
            }
          }
          changed = true;
        }
        p = code_parent(p);
      }
    }
    for(s : stmts)
      if(sl.meets(s.defs, backward) && sl.keep(kept, s.node)) {
        for(u : s.uses) sl.add(backward, u);
        changed = true;
      }
  }
  // Disclose: instructions without saved descendants
  shown = array{};
  for(k : kept) {
    p = k;
    while(given(p) && !sl.same(p, f)) {
      sl.keep(shown, p);
      p = code_parent(p);
    }
  }
  r = array{f};
  for(n : all) if(!sl.kept_has(shown, n)) r.push(n);
  r
}

// residual program (§13.2, M6 step 3b - from C++ to language):
// 
// parsing (check) with specified inputs observes node - view_obs / view_live / view_declares;
// here it is decided what to remove, which branch to leave and what to replace with a value. The
// result of residual_plan is rs_plan; printing with filter and substitutions is in VM
// (residual_view).
struct obs { bool found; bool present; bool seen; bool effect; bool diverted; bool known; bool has_literal; str literal; bool is_bool; bool truth; }
struct rs_fold { code at; code other; }
struct rs_value { code at; str text; }
struct rs_plan { array hidden; array folds; array values; }

// The service functions of residual program are in entity rs (external rs.f(…)), as sl.
rs() {
  kind_in(c, kinds) => {
    r = false;
    k = code_kind(c);
    for(t : kinds) if(t == k) r = true;
    r
  };

  // purpose of assignment: x in x = e, x += e
  lvalue(n) => {
    p = code_parent(n);
    r = false;
    if(given(p) && (code_kind(p) == ast.operation)) {
      ast.operation{op, args, _} = p;
      r = sl.assign(op) && sl.same(args[0], n);
    }
    r
  };

  is_require(n) => (code_kind(n) == ast.call) && {
    ast.call{c, args, words, _, _, _, _} = n;
    (words.size == 0) && ((args.size > 0) && ((code_kind(c) == ast.name) && (code_name(c) == "require")))
  };

  // not replace: purpose of assignment, called, announcements and parameters
  foldable_position(n) => {
    p = code_parent(n);
    if(kind_in(n, array{ast.variable, ast.function, ast.parameter, ast.lambda, ast.block, ast.return, ast.loop, ast.break, ast.continue}) || (is_require(n) || is_clause_pack(n))) false
    else if(!given(p)) false
    else if((code_kind(p) == ast.call) && {
      ast.call{c, _, _, _, _, _, _} = p;
      sl.same(c, n)
    }) false
    else if((code_kind(p) == ast.variable) && {
      ast.variable{_, t, _, _, _, _, _, _} = p;
      sl.same(t, n)
    }) false
    else if((code_kind(p) == ast.construct) && {
      ast.construct{t, _, _} = p;
      sl.same(t, n)
    }) false
    else !lvalue(n)
  };

  // The value of node is literal - or "" (convolution not)
  fold_value(n) => {
    r = "";
    if(!sl.statement(n) && foldable_position(n)) {
      o = view_obs(n);
      if(o.found && (o.seen && (!o.diverted && (!o.effect && (o.has_literal && !kind_in(n, array{ast.int, ast.float, ast.string})))))) r = o.literal;
    }
    r
  };

  // If: 0 unknown, 1 false, 2 true
  cond_of(n) => {
    ast.if{c, _, _} = n;
    o = view_obs(c);
    if(!o.found || (!o.seen || (o.effect || !o.is_bool))) 0 else if(o.truth) 2 else 1
  };

  // branch with a known condition is its branch (array {} - no convolution)
  fold_if(n) => {
    r = array{};
    if(code_kind(n) == ast.if) {
      c = cond_of(n);
      ast.if{_, yes, no} = n;
      if(c == 2) r.push(yes);
      if((c == 1) && given(no)) r.push(no);
    }
    r
  };
  drops(n) => (code_kind(n) == ast.if) && ((cond_of(n) == 1) && {
    ast.if{_, _, no} = n;
    !given(no)
  });

  // an expression instruction that does nothing at these inputs: the result is known and
  // discarded, there are no runtime effects, no variable parameters
  pure_noop(n) => {
    r = kind_in(n, array{ast.call, ast.operation, ast.name});
    if(r && (code_kind(n) == ast.operation)) {
      ast.operation{op, _, _} = n;
      if(sl.assign(op)) r = false;
    }
    if(r) {
      o = view_obs(n);
      if(!o.found || (!o.seen || (o.effect || (o.diverted || !o.known)))) r = false;
    }
    if(r && (code_kind(n) == ast.call)) {
      ast.call{c, _, _, _, _, _, _} = n;
      if(code_kind(c) == ast.name) {
        name = code_name(c);
        for(item : code_items(code_module(n))) {
          if((code_kind(item) == ast.function) && (code_name(item) == name)) {
            ast.function{_, params, _, _, _, _, _, _, _} = item;
            for(p : params) {
              ast.parameter{_, _, mode, _, _, _, _} = p;
              if((mode == 1) || ((mode == 2) || (mode == 3))) r = false; // mut, own, out
            }
          }
        }
      }
    }
    r
  };

  dead_init(init) => {
    o = view_obs(init);
    !o.found || !o.effect
  };

  keep(n, used) => {
    p = code_parent(n);
    k = code_kind(n);
    if((k == ast.function) && (given(p) && (code_kind(p) == ast.module))) (code_name(n) == "main") || view_live(n)
    else if(!sl.statement(n)) true
    else if({
      o = view_obs(n);
      !o.found || !o.present
    }) false // It was not performed at these entrances.
    else if((k == ast.variable) && {
      ast.variable{name, _, init, _, _, _, _, _} = n;
      !sl.has(used, name) && dead_init(init)
    }) false // dead variable: not read anywhere, initialization without effect
    else if(view_declares(n) && {
      ast.operation{_, args, _} = n;
      !sl.has(used, code_name(args[0])) && dead_init(args[1])
    }) false // x = e, which declares x that is not read
    else if(pure_noop(n)) false
    else !drops(n) // if(ложь) without more - nothing remains
  };

  // Names that are read in residual program: not folded, not discarded
  gather(n, used) => {
    if(given(n)) {
      p = code_parent(n);
      k = code_kind(n);
      o = view_obs(n);
      ignoring_dead = o.found && o.present;
      folds = fold_if(n);
      if((k == ast.function) && ((given(p) && (code_kind(p) == ast.module)) && !keep(n, used))) {
      } else if(sl.statement(n) && ((k != ast.variable) && (!view_declares(n) && ((k != ast.function) && (!ignoring_dead || pure_noop(n)))))) {
      } else if(fold_value(n).size > 0) {
      } else if(folds.size > 0) gather(folds[0], used)
      else if(drops(n)) {
      } else {
        if((k == ast.name) && !lvalue(n)) sl.add(used, code_name(n));
        for(c : code_items(n)) gather(c, used);
      }
    }
  };

  // The field of the structure transferred to the function changes into copies - lists by individual arrays
  collect_into(n, used, hidden, folds, values) => {
    if(given(n)) {
      if(!keep(n, used)) hidden.push(n);
      fs = fold_if(n);
      if(fs.size > 0) folds.push(rs_fold{n, fs[0]});
      v = fold_value(n);
      if(v.size > 0) values.push(rs_value{n, v});
      for(c : code_items(n)) collect_into(c, used, hidden, folds, values);
    }
  };
}

residual_plan(m) {
  used = array{};
  rs.gather(m, used);
  hidden = array{};
  folds = array{};
  values = array{};
  rs.collect_into(m, used, hidden, folds, values);
  rs_plan{hidden, folds, values}
}

// parsing chain operators by brute force (§4.4, M6 step 4 - from C++ to language):
// 
// Table by segments of atoms: parsing segment - type, number of trees (1 or "many"), root.
// Primitives VM: chain_probe(m, l, r) - type of application of the operator m to types l, r
// (type number or -1 - not instance, SFINAE), chain_key(h) - type string. The bottom line.
//
// ch_result: status 0 — дерево (tree — префиксом: -1 атом i | m левое правое),
// 1 - type is still derived, 2 - no parsing is not instance, 3 - ambiguous (notes -
// parsing types). There are no chains here (each expression is one operator in brackets):
// parsing chains do not disassemble itself.
struct ch_entry { i64 cell; i64 shape; i64 count; i64 op; i64 li; i64 ri; }
struct ch_result { i64 status; array tree; array notes; }

chain_resolve(i64 k, ops, assoc, bool open) {
  cell(i64 kk, i64 i, i64 j) => (i * kk) + j;
  // parsing cells (i, j) - record numbers
  in_cell(es, i64 c) => {
    r = array{};
    for(x : range(es.size)) if(es[x].cell == c) r.push(x);
    r
  };
  build(es, i64 x, acc) => {
    e = es[x];
    if(e.op < 0) {
      acc.push(-1);
      acc.push(e.li); // atom
    } else {
      acc.push(e.op);
      build(es, e.li, acc);
      build(es, e.ri, acc);
    }
  };
  ents = array{};
  for(i : range(k)) ents.push(ch_entry{cell(k, i, i), i, 1, -1, i, 0}); // type of atom i - number i
  len = 2;
  while(len <= k) {
    i = 0;
    while((i + (len - 1)) < k) {
      j = i + (len - 1);
      cj = cell(k, i, j);
      m = i;
      while(m < j) { // operator m - between atoms m and m + 1
        ls = in_cell(ents, cell(k, i, m));
        rs = in_cell(ents, cell(k, m + 1, j));
        for(li : ls) {
          for(ri : rs) {
            r = ents[ri];
            skip = assoc[m] && ((r.op >= 0) && (ops[r.op] == ops[m])); // a + (b + c) ≡ (a + b) + c
            if(!skip) {
              t = chain_probe(m, ents[li].shape, r.shape);
              if(t >= 0) {
                cnt = ents[li].count * r.count;
                if(cnt > 2) cnt = 2;
                same = -1;
                for(x : in_cell(ents, cj)) if(chain_key(ents[x].shape) == chain_key(t)) same = x;
                if(same >= 0) ents[same].count = 2; // other parsing of the same type
                else ents.push(ch_entry{cj, t, cnt, m, li, ri});
              }
            }
          }
        }
        m = m + 1;
      }
      i = i + 1;
    }
    len = len + 1;
  }
  top = in_cell(ents, cell(k, 0, k - 1));
  total = 0;
  for(x : top) total = total + ents[x].count;
  // atom with (recursion): only a single agreed tree, otherwise the type is still bred
  if(open && (total != 1)) return ch_result{1, array{}, array{}};
  if(total == 0) return ch_result{2, array{}, array{}};
  if(total > 1) {
    notes = array{};
    for(x : top) notes.push(chain_key(ents[x].shape));
    return ch_result{3, array{}, notes};
  }
  tree = array{};
  build(ents, top[0], tree);
  ch_result{0, tree, array{}}
}

// The choice of overload is the rule of specificity (§5.4, M6 step 5 - with C++ per language): “type equals” more specifically “can represent” (), the
// exact number of arguments - more specifically the tail ...xs, the sample and leading require - the conditions of the candidate. Signs of the candidate
// consider VM (whether type, unpacking, require): array{tail, require, according to the parameters: 0 - without type, 1 - imagine (new value), 2 - type
// equals, 3 - the same object under the general type (heir, record → struct), 100 + n - sample with n checks}. Weight: Type equals > general type > no
// type > imaginable - parameter without type takes value as is, otherwise f(f64 n) => f(i64(n)) would choose itself for i64 (tail without end). Here -
// the weight of features, order (steady, in descending), runtime - overload in value in parsing (reach - how much to disassemble) and ambiguity. VM
// remembers the result by the signs: the rule is a pure function. No chains and no congested calls: overload doesn't choose itself.
//
//
//
//
//
//
struct ov_pick { array order; i64 reach; bool ambiguous; i64 tied; }


overload_pick(feats, maybes, bool checking) {
  score(f) => {
    s = if(f[0] == 1) 0 else 1;
    s = s + f[1];
    i = 2;
    while(i < f.size) {
      k = f[i];
      if(k >= 100) s = s + (1 + (k - 100));
      else if(k == 1) s = s - 1; // new value (i64 а f64, implicit) - below the parameter without the type
      else if(k == 3) s = s + 1; // the same object under the general type - above without type, below "type equal"
      else s = s + k;
      i = i + 1;
    }
    s
  };
  n = feats.size;
  scores = array{};
  for(f : feats) scores.push(score(f));
  order = array{};
  for(i : range(n)) { // Insertion - after all with a weight not less than: the order of equals is maintained
    pos = order.size;
    found = false;
    j = 0;
    while(j < order.size) {
      if(!found) {
        if(scores[order[j]] < scores[i]) {
          pos = j;
          found = true;
        }
      }
      j = j + 1;
    }
    next = array{};
    for(x : range(order.size)) {
      if(x == pos) next.push(i);
      next.push(order[x]);
    }
    if(pos == order.size) next.push(i);
    order = next;
  }
  // parsing: Candidates whose unpacking depends on the run-time value, all up to the first accurate
  reach = 0;
  if(checking && maybes[order[0]]) {
    stop = false;
    for(x : order) {
      if(!stop) {
        reach = reach + 1;
        if(!maybes[x]) stop = true;
      }
    }
  }
  ambiguous = false;
  if(n > 1) {
    a = order[0];
    b = order[1];
    ambiguous = (scores[a] == scores[b]) && ((!maybes[a]) && (!maybes[b]));
  }
  tied = 0;
  for(x : order) if(scores[x] == scores[order[0]]) tied = tied + 1;
  ov_pick{order, reach, ambiguous, tied}
}

// Type relationships and path fusion (§5.8, §5.5, M6 step 6 - with C++ into the language):
// 
// 
// 
// 
// . Facts about the meaning and types (subtype, record, struct, code) and the transformation of
// values - VM; "type equals" VM decides itself (identity). Results are remembered by facts.
// Without chains and without type transformations within: rules do not apply themselves.

// fit_rule: подходит ли значение типа got месту типа want, если типы не равны.
// 0 is no, 2 is the heir instead of the base (as is), 3 is the record {x: …} → struct, 4 - {} →
// zero, 5 - i64 → f64 (without losses), 6 - f64 → i64 (integer), 7 - in the appearance of node
// code, 8 - a function of the `want implicit(got x) => …` program (implicit - it is declared):
// the declared program is the first.
// 
// explicit - only an equal type.
fit_rule(got, want, strict, subtype, record, want_struct, empty, is_code, want_node, implicit) {
  if(is_code && want_node) 7
  else if(strict) 0
  else if(implicit) 8
  else if(subtype) 2
  else if(record && want_struct) 3
  else if(empty && ((want == "i64") || (want == "f64"))) 4
  else if((got == "i64") && (want == "f64")) 5
  else if((got == "f64") && (want == "i64")) 6
  else 0
}


// join_rule: альтернатива y (тип ty) и значение x (тип tx) другого пути. Проход 1 —
// empty array: late element type, array<?> е array<T> = array<T> (run-time); passage 2 - the same
// compile-time - compile-time, one type - run-time, different types - splitting (without
// variant). 0 is not this alternative, 1 - x is already there, 2 - y is erased to type, 3 - y :=
// type x. Another state (ct field, hide) is always another alternative.
join_rule(pass, ty, tx, same_state, same_value) {
  starts(s, p) => {
    r = s.size >= p.size;
    k = 0;
    while(r && (k < p.size)) {
      if(s[k] != p[k]) r = false;
      k = k + 1;
    }
    r
  };
  if(!same_state) 0
  else if(pass == 1) {
    if((tx == "array<?>") && starts(ty, "array<")) 2
    else if((ty == "array<?>") && starts(tx, "array<")) 3
    else 0
  } else if(ty != tx) 0
  else if(same_value) 1
  else 2
}

// Thresholds of static parsing (§5.5, M6 step 7 - with C++ on the language). Author's model:
// 
// 
// parsing executes the known and erases to type where runtime begins (this is the core,
// type::eval). An infinite cycle on a type layer - thresholds - only to stop with an error. My
// number of thresholds.
//
//
analysis_limit(what) {
  if(what == "loop_known") 100000 // iterations of a cycle with known output
  else if(what == "loop_types") 8 // cycles by type to a fixed point
  else if(what == "recursion_widen") 16 // depth with which recursion is generalized to types
  else if(what == "recursion_depth") 2000 // recursion depth limit at parsing
  else 0
}

// Numbers of other widths are code, not kernel types:
// 
// 
// (convert(0xdeadbeef, type_c<uint16_t>).) Your type over int64/ float64 (§5.8): overflow in width (module
// like i64), mix with i64 only explicitly: i32(x). *My:* representation in VM is 64 bits, shift in width, i32
// {x} unchecked (x already in range), i32(x) with transfer.
//
struct i8 { __int64 value; }
struct i16 { __int64 value; }
struct i32 { __int64 value; }
struct u8 { __int64 value; }
struct u16 { __int64 value; }
struct u32 { __int64 value; }
struct u64 { __int64 value; }
struct f32 { __float64 value; }
num_wrap_s(i64 x, i64 bits) => (x << (64 - bits)) >> (64 - bits);
num_wrap_u(i64 x, i64 bits) => x & ((1 << bits) - 1);
num_srl(i64 x, i64 n) => if(n == 0) x else ((x >> n) & ((1 << (64 - n)) - 1)); // right-shift
num_ult(i64 a, i64 b) => (a ^ (1 << 63)) < (b ^ (1 << 63)); // bit-comparison
// Signless division of bits: "in column", 64 steps
num_udivrem(i64 a, i64 b) {
  require(b != 0, "деление на ноль");
  q = 0;
  r = 0;
  for(i : range(64)) {
    r = (r << 1) | (num_srl(a, 63 - i) & 1);
    if(!num_ult(r, b)) {
      r = r - b;
      q = q | (1 << (63 - i));
    }
  }
  array{q, r}
}
num_utext(i64 x) {
  if(x >= 0) return text(x);
  array{q, r} = num_udivrem(x, 10);
  text(q) + text(r)
}
f32(f64 x) => f32{f32_round(x)};
f32(i64 x) => f32{f32_round(f64(x))};
f64(f32 x) => x.value;
i64(f32 x) => i64(x.value);
text(f32 x) => text(x.value);
operator -(f32 a) => f32{0.0 - a.value};
operator (f32 a) + (f32 b) => f32{f32_round(a.value + b.value)};
operator (f32 a) - (f32 b) => f32{f32_round(a.value - b.value)};
