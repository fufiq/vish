    ctx = sub.ctx;
    exit = label();
    fr_fn.push(sub.f);
    fr_exit.push(exit);
    fr_parent.push(-1);
    cur = fr_fn.size - 1;
    gen(body);
    bind(exit);
    put_bytes(cg.move(stack, frame));
    put_bytes(cg.frame_leave());
    put_bytes(cg.ret());
    bytes = frame_size(((8 * sub_n) + 15) & -16);
    for(j : range(bytes.size)) out[fa + j] = bytes[j];
    gen_sub = false;
    env = w_env;
    top = w_top;
    base = w_base;
    ctx = w_ctx;
    cur = w_cur;
    depth = w_depth;
    loops = w_loops;
    lfns = w_lfns;
  };
  // overload by argument type: expr parameter - any code
  choose(str name, xs) => choose_from(functions_named(name), xs);
  choose_from(gs, xs) => {
    best = -1;
    pick = array{};
    tie = false;
    for(g : gs) {
      ast.function{_, ps, _, _, _, _, _, _, _} = g;
      fits = ps.size == xs.size;
      score = 0;
      for(i : range(if(fits) ps.size else 0)) {
        ast.parameter{_, pt, mode, pack, _, _, _} = ps[i];
        if(given(pt)) {
          want = type_of_code(pt);
          at = ty(xs[i]);
          if(!given(want) || (mode == 4)) fits = false;
          else if((want != at) && (want != type_family(at))) fits = false; // stream - family of stream(i64)
          else score += 1;
        }
        if(pack && (mode != 4)) fits = false; // tail ...xs; pack clauses (catch) - you can
      }
      if(fits && (score > best)) {
        best = score;
        pick = array{g};
        tie = false;
      } else if(fits && (score == best)) tie = true;
    }
    if(tie) array{} else pick
  };
  gen_inline(e, str name, xs) => {
    gk = if((name == "for") && (xs.size == 2)) generator_of(xs[0]) else -1;
    if(gk >= 0) return gen_fused(e, xs, gk);
    gen_inline_of(e, name, xs, choose(name, xs));
  };
  // node of the program type with eval (ast.dbl {) eval(expr x) => ...; }: call eval at the site of
  // the node, fields - arguments (like the interpreter, author's decision 2026-10-17)
  gen_program_node(e) => {
    xs = code_items(e);
    gen_inline_of(e, fmt"{code_kind(e)}.eval", xs, choose_from(kind_functions(e, "eval"), xs));
  };
  gen_inline_of(e, str name, xs, g) => {
    if((g.size == 1) && (code_id(g[0]) == code_id(f))) { // recursion - calling yourself; in the tail - transition (O5)
      if((cur == 0) && (!gen_sub && jit_tail_self(f, e))) return tail_self_with(xs);
      return call_self_with(xs);
    }
    rec = false;
