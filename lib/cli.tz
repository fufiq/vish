// Строка запуска tz — на языке (шаг 4 переноса тулинга). Модуль встроен в сборку; его грузит каждая
// команда tz, кроме бутстрапа tz native.
module cli;
use tools;

// --- команды tz: строка запуска (у VM — сами команды над программой, cli.hpp) ----------------
// 
// База команды одна: прелюдия, этот
// модуль и программа .tz (программа его не видит) — 
//. tz native — бутстрап, у C++: собирает сами примитивы (`tz native` до них).

// строка stdin процесса ("" и false — конец); вывод — сейчас
read_line() => native "cpp" {
  std::string line;
  bool ok = os::host_stdin().next(line);
  return value(array_v::of({value(ok), value(std::move(line))}));
};
flush_out() => native "cpp" {
  std::fflush(stdout);
  return value(int64_t(0));
};
// программа команды (.tz — в базу команды, .tzdb — своя база по журналу): номер; ошибки разбора
// текстом; разобрана ли; в .tzdb; проекция: array{текст, ошибки, нашёлся ли модуль проекции};
// после элаборации (tz fmt --ct); дерево; срез
prog_open(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(cli_now->open(std::string((a[0]).as<str_v>().view())));
};
prog_errors(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(cli_now->errors((a[0]).as<int64_t>()));
};
prog_parsed(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(cli_now->at((a[0]).as<int64_t>()).errors.empty());
};
prog_save(i64 p, str path) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & x = cli_now->at((a[0]).as<int64_t>());
  save_db(*x.db, x.root, std::string((a[1]).as<str_v>().view()));
  return value(int64_t(0));
};
prog_fmt(i64 p, str key) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto [text, errs, ok] = cli_now->fmt((a[0]).as<int64_t>(), std::string((a[1]).as<str_v>().view()));
  return value(array_v::of({value(std::move(text)), value(std::move(errs)), value(ok)}));
};
prog_fmt_ct(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = cli_now->at((a[0]).as<int64_t>());
  return value(elaborated_text(*x.db, x.root, x.path));
};
prog_ast(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & x = cli_now->at((a[0]).as<int64_t>());
  return value(dumper(*x.db).dump(x.root));
};
prog_slice(i64 p, str fn, str var) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(std::string()));
  auto & x = cli_now->at((a[0]).as<int64_t>());
  return value(slice_view(*x.db).print(x.root, std::string((a[1]).as<str_v>().view()), std::string((a[2]).as<str_v>().view())));
};
// сессия VM над программой: номер
prog_session(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(-1)));
  return value(tools_host->session_of(cli_now->session((a[0]).as<int64_t>())));
};
// исполнить main(): интерпретатор (JIT, AArch64 в qemu, экземпляры и статистика — в stderr);
// машина процессов (дамп после n шагов в файл); check; residual — код выхода
prog_run(i64 p, bool instances, bool jit, bool stats, bool a64, args) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(int64_t(0)));
  return value(int64_t(cli_now->run((a[0]).as<int64_t>(), (a[1]).as<bool>(), (a[2]).as<bool>(), (a[3]).as<bool>(), (a[4]).as<bool>(), strings_of(a[5]))));
};
prog_machine(i64 p, i64 n, str dump, args) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(int64_t(0)));
  return value(int64_t(cli_now->machine((a[0]).as<int64_t>(), uint64_t((a[1]).as<int64_t>()), std::string((a[2]).as<str_v>().view()), strings_of(a[3]))));
};
prog_check(i64 p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(cli_now->check((a[0]).as<int64_t>())));
};
prog_residual(i64 p, input, args) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(int64_t(0)));
  return value(int64_t(cli_now->residual((a[0]).as<int64_t>(), strings_of(a[1]), strings_of(a[2]))));
};
// VM для редактора на Unix-сокете — навсегда; модуль editor — до программы (её журнал — как без
// редактора)
prog_serve(i64 p, str socket) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  cli_now->serve((a[0]).as<int64_t>(), std::string((a[1]).as<str_v>().view()));
};
load_editor_module() => native "cpp" {
  load_editor(cli_now->db);
  return value(int64_t(0));
};
// возобновить процесс из дампа (в другой VM); журнал базы текстом; схема протокола редактора
resume_dump(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(resume_dump(std::string((a[0]).as<str_v>().view()))));
};
journal_text(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  node_id root;
  return value(describe_journal(read_journal(std::string((a[0]).as<str_v>().view()), root)));
};
proto_schema() => native "cpp" { return value(proto::schema()); };

// Модуль тулинга по ключу (tests, versions) — в базу команды, если его там нет, и его функция fn
// со словами args: код выхода. Команда грузит только то, что ей нужно.
run_module(str key, str fn, args) => native "cpp" {
  for(auto & v: a)
    if(!v.known()) return erase(value(int64_t(0)));
  return value(int64_t(cli_now->run_module(std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view()), strings_of(a[2]))));
};
// tz vm <программа>: команды из stdin, вывод каждой — после «> команда»
vm_loop(i64 s) {
  done = false;
  while(!done) {
    array{ok, line} = read_line();
    if(!ok || (line == "quit")) done = true;
    else if((line != "") && !starts_with(line, "//")) {
      body = "";
      if(starts_with(line, "edit ")) { // тело правки — до строки из одной точки
        more = true;
        while(more) {
          array{got, l} = read_line();
          if(!got || (l == ".")) more = false;
          else body = (body + l) + "\n";
        }
      }
      write_out(((("> " + line) + "\n") + vm_command(s, line, body)));
      flush_out();
    }
  }
  0
}
usage() {
  write_err("использование (<программа> — файл .tz или база .tzdb):\n  tz fmt <программа>        каноническая текстовая проекция\n  tz fmt --ct <программа>   проекция после элаборации: мутации ct-кода и порождённое emit\n  tz fmt --projection <ключ> <программа>   проекция — модуль записей syntax (по ключу, как use)\n  tz ast <программа>        дерево AST\n  tz run [--instances] [--jit] [--jit-stats] [--a64] [--grant fs,net] <программа> [аргументы...]   исполнить main(); --a64 — код AArch64 параллельно, в qemu-aarch64; --grant — ресурсы программе (без него — «0 устройств»)\n  tz run --machine [--dump-after N файл.tzproc] <программа> [аргументы...]   машина процессов; дамп после N шагов\n  tz resume [--grant fs,net] <файл.tzproc>   возобновить процесс из дампа (в другой VM)\n  tz check <программа>      статический разбор: стадии кт/рт, расщепления, экземпляры\n  tz residual <программа> [--stdin СТРОКА]... [аргументы...]   программа для заданных входов\n  tz slice <программа> <функция> <переменная>   только то, что связано с переменной\n  tz save <файл.tz> <база.tzdb>   импортировать текст в базу (журнал на диск)\n  tz log <база.tzdb>         журнал операций базы в тексте\n  tz apply <программа> <функция> [база.tzdb]   применить функцию правки (code_rename…): новый текст, база\n  tz vm <программа>          сессия VM: команды из stdin (check, run, edit <функция> … ., report, save)\n  tz serve <программа> <сокет>   VM для редактора: протокол на Unix-сокете\n  tz schema                  схема протокола редактора (JSON)\n  tz diff <a.tzdb> <b.tzdb>  семантический дифф баз (по элементам модуля)\n  tz merge <мой.tzdb> <их.tzdb> [итог.tzdb]   трёхстороннее слияние; конфликты — слить руками\n  tz test <каталог> [--a64 | --projection <ключ>]   прогнать эталонные тесты; --projection — каждая программа в проекции разбирается в то же дерево\n");
  2
}
// tz <команда> …: слова строки запуска (без имени tz) — код выхода
cli(args) {
  if((args.size == 1) && (args[0] == "schema")) { // схема протокола редактора (JSON)
    write_out(proto_schema());
    return 0;
  }
  if(args.size < 2) return usage();
  cmd = args[0];
  at = 1;
  projection = ""; // tz fmt --projection <ключ> <программа>: проекция — модуль записей (§4.4)
  if((cmd == "fmt") && (args[1] == "--ct")) { // tz fmt --ct <программа>
    if(args.size < 3) return usage();
    cmd = "fmt-ct";
    at = 2;
  } else if((cmd == "fmt") && (args[1] == "--projection")) {
    if(args.size < 4) return usage();
    projection = args[2];
    at = 3;
  }
  if(cmd == "test") return run_module("tests", "test_command", words_from(args, 1));
  // версии (§9.4): семантический дифф и трёхстороннее слияние баз .tzdb
  if((cmd == "diff") && (args.size == 3)) return run_module("versions", "diff_command", words_from(args, 1));
  if((cmd == "merge") && (args.size >= 3)) return run_module("versions", "merge_command", words_from(args, 1));
  if(cmd == "resume") { // в новой VM ресурсы даёт её пользователь
    k = 1;
    if((args[1] == "--grant") && (args.size > 3)) {
      env_set("TZ_GRANT", args[2]);
      k = 3;
    }
    return resume_dump(args[k]);
  }
  if(cmd == "log") {
    write_out(journal_text(args[1]));
    return 0;
  }
  instances = false;
  jit = false;
  stats = false;
  a64 = false;
  machine = false;
  dump_after = 0;
  dump_path = "";
  while((cmd == "run") && ((at < args.size) && starts_with(args[at], "--"))) {
    f = args[at];
    at += 1;
    if(f == "--instances") instances = true;
    else if(f == "--jit") jit = true;
    else if(f == "--jit-stats") {
      jit = true;
      stats = true;
    } else if(f == "--a64") { // код AArch64 — параллельно с хостом, в qemu
      jit = true;
      a64 = true;
    } else if(f == "--machine") machine = true;
    else if((f == "--grant") && (at < args.size)) { // ресурсы программе даёт пользователь: fs,net
      env_set("TZ_GRANT", args[at]);
      at += 1;
    } else if((f == "--dump-after") && ((at + 1) < args.size)) { // --dump-after N файл.tzproc
      machine = true;
      dump_after = number_of(args[at]);
      dump_path = args[at + 1];
      at += 2;
    } else return usage();
  }
  if(at >= args.size) return usage();
  if((cmd == "serve") && !ends_with(args[at], ".tzdb")) load_editor_module();
  p = prog_open(args[at]);
  at += 1;
  write_err(prog_errors(p));
  parsed = prog_parsed(p);
  if(cmd == "save") {
    if(at >= args.size) return usage();
    prog_save(p, args[at]);
    return if(parsed) 0 else 1;
  }
  if(cmd == "fmt") {
    array{shown, errs, ok} = prog_fmt(p, projection);
    if(!ok) {
      write_err(errs);
      return 1;
    }
    write_out(shown);
    write_err(errs);
    return if(parsed) 0 else 1;
  }
  if(cmd == "fmt-ct") { // после элаборации (мутации ct-кода, порождённое emit)
    if(!parsed) return 1;
    write_out(prog_fmt_ct(p));
    return 0;
  }
  if(cmd == "ast") {
    write_out(prog_ast(p));
    return if(parsed) 0 else 1;
  }
  if(cmd == "slice") {
    if((at + 1) >= args.size) return usage();
    sliced = prog_slice(p, args[at], args[at + 1]);
    if(sliced == "") {
      write_err(((("не найдены функция " + args[at]) + " или переменная ") + args[at + 1]) + "\n");
      return 1;
    }
    write_out(sliced);
    return 0;
  }
  if(!parsed) return 1; // дыры целиком не исполняем — M0
  if(cmd == "apply") { // правка программы функцией на языке (§7.4): новая проекция, база — с журналом правки
    if(at >= args.size) return usage();
    r = vm_command(prog_session(p), "apply " + args[at], "");
    write_err(r);
    if(!starts_with(r, "применена")) return 1;
    write_out(prog_fmt(p, "")[0]);
    if((at + 1) < args.size) prog_save(p, args[at + 1]);
    return 0;
  }
  if(cmd == "vm") return vm_loop(prog_session(p));
  if(cmd == "serve") {
    if(at >= args.size) return usage();
    return prog_serve(p, args[at]);
  }
  if((cmd == "run") && machine) return prog_machine(p, dump_after, dump_path, words_from(args, at));
  if(cmd == "run") return prog_run(p, instances, jit, stats, a64, words_from(args, at));
  if(cmd == "check") return prog_check(p);
  if(cmd == "residual") {
    input = array{};
    extra = array{};
    k = at;
    while(k < args.size) {
      if((args[k] == "--stdin") && ((k + 1) < args.size)) {
        input.push(args[k + 1]);
        k += 2;
      } else {
        extra.push(args[k]);
        k += 1;
      }
    }
    return prog_residual(p, input, extra);
  }
  usage()
}
