  return value(s.trace_output.substr(0, std::min<std::size_t>(s.session.trace[uint32_t(k)].out, s.trace_output.size())));
};
trace_error() => native "cpp" { return value(editor_host->trace_error); };
// трасса — клиенту: открыта ли, шаг, всего, узел шага, стек, вывод, ошибка
show_trace(bool active, i64 step, i64 total, n, stack, str out, str error) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  proto::s_trace t{(a[0]).as<bool>(), uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), s.node_or_none(vm, a[3], where), {}, std::string((a[5]).as<str_v>().view()), std::string((a[6]).as<str_v>().view())};
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) t.stack.push_back(std::string((a[4]).as<array_v>().get(k).as<str_v>().view()));
  s.send(*s.now_peer, t);
  return value(int64_t(0));
};
