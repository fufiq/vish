// вывод программы до шага k (k — -1: весь) и ошибка запуска
trace_output(i64 k) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & s = *editor_host;
  int64_t k = (a[0]).as<int64_t>();
