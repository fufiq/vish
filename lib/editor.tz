live_migrate(str tn) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(editor_host->live_migrate(std::string((a[0]).as<str_v>().view())));
};
live_refresh() => native "cpp" {
  editor_host->live_refresh();
  return value(int64_t(0));
};
// вывод запуска клиенту: more — продолжение прежнего, state — "running", "stopped" или "" (закончен)
run_output(str text, bool ok, bool more, str state) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known() || !(a[3]).known()) return erase(value(int64_t(0)));
  if(editor_host->now_peer)
    editor_host->send(*editor_host->now_peer, proto::s_output{std::string((a[0]).as<str_v>().view()), (a[1]).as<bool>(), (a[2]).as<bool>(), std::string((a[3]).as<str_v>().view())});
  return value(int64_t(0));
};
// запуск с трассой (шаги — по ней)
trace_program(str args, str input) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & h = *editor_host;
  h.session.stdin_lines.clear();
  for(auto l: lines_of((a[1]).as<str_v>().view())) h.session.stdin_lines.emplace_back(l);
  std::vector<std::string> args;
  for(auto w: words_of((a[0]).as<str_v>().view())) args.emplace_back(w);
  bool ok = true;
  h.trace_output = h.session.trace_run(args, ok, h.trace_error);
  return value(int64_t(0));
};
show_output(str text, bool ok) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  if(editor_host->now_peer) editor_host->send(*editor_host->now_peer, proto::s_output{std::string((a[0]).as<str_v>().view()), (a[1]).as<bool>(), false, ""});
  return value(int64_t(0));
};
// имя программы сессии (путь, как открыта)
program_name() => native "cpp" { return value(editor_host->session.name); };
// журнал базы — в файл .tzdb
save_program(str path) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  std::string path((a[0]).as<str_v>().view());
  save_db(s.session.db, s.session.root, path);
  if(s.now_peer) s.send(*s.now_peer, proto::s_saved{path});
  return value(int64_t(0));
};
// функция правки программы: итог (применена… — правки в базе)
program_apply(str fn) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(editor_host->session.apply(std::string((a[0]).as<str_v>().view())));
};
// конфликты слияния (и взятое само) — клиенту: conflicts — conflict модуля tools
send_merge_list(taken, conflicts) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & h = *editor_host;
  std::vector<std::string> taken;
  for(uint32_t k = 0; k < (a[0]).as<array_v>().size(); ++k) taken.emplace_back((a[0]).as<array_v>().get(k).as<str_v>().view());
  std::vector<proto::s_conflict> cs;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) {
    value c = (a[1]).as<array_v>().get(k);
    auto s = [&](std::string_view f) { return std::string(h.field(c, f, where).as<str_v>().view()); };
    cs.push_back({s("key"), s("base"), s("mine"), s("theirs")});
  }
  h.send_merge(std::move(taken), std::move(cs));
  return value(int64_t(0));
};
// модуль программы и прелюдия
program() => native "cpp" {
  return vm.code_value(editor_host->session.root);
};
prelude() => native "cpp" {
  return vm.code_value(editor_host->session.db.prelude);
};
// модуль базы по ключу (geo.vec); нет — пустой код
module_of_key(str key) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  auto & db = editor_host->session.db;
  auto it = db.strings.index.find(std::string((a[0]).as<str_v>().view()));
  return vm.code_value(it == db.strings.index.end() ? node_id{} : find_module(db, it->second));
};
// функции VM, видимые программе: array{имя, параметры}
vm_builtins() => native "cpp" {
  std::vector<value> xs;
  for(auto const & [name, sig]: interpreter::visible_builtins) xs.push_back(value(array_v::of({value(std::string(name)), value(std::string(sig))})));
  return value(array_v::of(std::move(xs)));
};
// запись syntax (if, return…) — разбора, а не сущность
is_record(c) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(bool(record_of(editor_host->session.db, vm.code_node(a[0], where))));
};
// вид узла ядра (ast.if…): в дополнении — только по набранному префиксу
core_node_kind(str name) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(is_node_kind((a[0]).as<str_v>().view()));
};
// имя типа машины: 2 — целое, 4 — байты (строка)
type_tag(i64 m) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(std::string(type_registry::tag(uint32_t((a[0]).as<int64_t>()))));
};
// поля записи типа {x: …}: array{имя, тип}
record_parts(str t) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto const & [name, tn]: type_registry::record_parts((a[0]).as<str_v>().view())) xs.push_back(value(array_v::of({value(std::string(name)), value(std::string(tn))})));
  return value(array_v::of(std::move(xs)));
};
// строки — байты (§4.0): подпоследовательность и регистр ASCII — примитивы базы (поиск, срез — модуль tools)
// w — подпоследовательность s (байты по порядку, не подряд)
subsequence(str s, str w) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(false));
  auto x = (a[0]).as<str_v>().view(), y = (a[1]).as<str_v>().view();
  std::size_t k = 0;
  for(char c: x)
    if(k < y.size() && c == y[k]) ++k;
  return value(k == y.size());
};
lower(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  std::string r((a[0]).as<str_v>().view());
  for(char & c: r)
    if(c >= 'A' && c <= 'Z') c = char(c - 'A' + 'a');
  return value(std::move(r));
};

// --- представления: найти, открыть, закрыть -------------------------------------------------
empty_layout() => layout{"", "\n", array{-1}, array{0}, array{0}, array{0}, array{}, array{}, array{}, array{}, array{}, array{}, array{}, array{}, array{}, array{0}, array{}, array{}, "", array{}, array{}, array{}, array{}, 0, 0, 0, 0, -1};
empty_draft() => draft{false, array{}, code(), 0, array{}, array{}, 0, "", array{}};
new_view(i64 peer, i64 id, root, str kind) => view{peer, id, root, kind, "", code(), empty_layout(), 0, -1, -1, false, false, false, false, array{}, 0, 0, array{}, empty_draft(), array{}, array{}, array{}, array{}};
// представление клиента, чьё сообщение обслуживается, по его номеру; -1 — нет (или закрыто);
// номер -1 — первое открытое
view_of(i64 id) {
  p = now_peer();
  r = -1;
  for(w : range(views.size)) if((r < 0) && ((views[w].peer == p) && (given(views[w].root) && ((id < 0) || (views[w].id == id))))) r = w;
  r
}
// сколько представлений клиент открывал (номер следующего — на единицу больше)
peer_view_count(i64 p) {
  n = 0;
  for(w : range(views.size)) if(views[w].peer == p) n += 1;
  n
}
// открытые представления клиента, чьё сообщение обслуживается
peer_views() {
  p = now_peer();
  r = array{};
  for(w : range(views.size)) if((views[w].peer == p) && given(views[w].root)) r.push(w);
  r
}
// проекция представления (своя функция решения в её модуле — первой); пусто — по умолчанию
view_projection(i64 id) {
  v = view_of(id);
  if(v < 0) code() else views[v].projection
}
// черновик представления (сверка сценариев): array{открыт, текст как набран}
view_draft(i64 id) {
  v = view_of(id);
  if((v >= 0) && views[v].d.open) array{true, views[v].lay.text} else array{false, ""}
}
// клиент k (растёт по мере обращений)
client_of(i64 p) {
  while(clients.size <= p) clients.push(client{false, 0});
  p
}
debugging() => clients[client_of(now_peer())].debugging;
set_debugging(bool on) {
  clients[client_of(now_peer())].debugging = on;
  0
}
trace_pos() => clients[client_of(now_peer())].trace_pos;
set_trace_pos(i64 k) {
  clients[client_of(now_peer())].trace_pos = k;
  0
}
// правка — трасса описывает прежнюю версию: закрыть её у всех
close_traces() {
  for(p : range(clients.size)) if(clients[p].debugging) {
    clients[p].debugging = false;
    send_trace(p, false, 0, 0, code(), array{}, "", "");
  }
  0
}
// ни представления, ни места — сказать клиенту
no_view(i64 id) => report("нет представления " + text(id));
// трасса — клиенту, чьё сообщение обслуживается
show_trace(bool active, i64 step, i64 total, n, stack, str text, str error) => send_trace(now_peer(), active, step, total, n, stack, text, error);

// --- раскладка: места, байты, узлы ------------------------------------------------------------
places(i64 v) => views[v].lay.node.size;
end_of(i64 v) => places(v) - 1;
// первый байт символа места k ('\n' — конец строки)
lead(i64 v, i64 k) => if((k >= 0) && (k < views[v].lay.lead.size)) views[v].lay.lead[k] else 0;
// строка первых байтов мест — своя копия для циклов по символам (вызов lead на символ дороже)
leads(i64 v) => views[v].lay.lead;
byte_of(i64 v, i64 k) => views[v].lay.byte[k];
// текст мест [from, to)
text_of(i64 v, i64 from, i64 to) => slice_text(views[v].lay.text, byte_of(v, from), byte_of(v, to));
// место по байту текста: первое, чей байт не меньше
place_of_byte(i64 v, i64 b) => lower_bound(views[v].lay.byte, b);
// номер раскладки узла n по узлам по возрастанию и их номерам (-1 — узла в ней нет)
index_in(sorted, order, i64 n) {
  k = lower_bound(sorted, n);
  if((k < sorted.size) && (sorted[k] == n)) order[k] else -1
}
// номер раскладки узла n в представлении
layout_at(i64 v, i64 n) {
  k = lower_bound(views[v].lay.sorted, n);
  if((k < views[v].lay.sorted.size) && (views[v].lay.sorted[k] == n)) views[v].lay.order[k] else -1
}
// номер раскладки узла (-1 — узла в представлении нет); места его текста [from, to)
layout_of(i64 v, n) => if(given(n)) layout_at(v, code_id(n)) else -1;
range_from(i64 v, i64 k) => views[v].lay.from[k];
range_to(i64 v, i64 k) => views[v].lay.to[k];
// узел места k
place_node(i64 v, i64 k) => if((k >= 0) && (k < places(v))) node_code(views[v].lay.node[k]) else code();
// курсор на начало узла n в представлении (-1 — узла в нём нет)
node_place(i64 v, n) {
  k = layout_of(v, n);
  if(k < 0) -1 else range_from(v, k)
}
// Место p — в протоколе: array{узел, кусок, смещение в кодовых точках}; конец текста — после
// последнего символа последнего непустого куска; пусто — array{-1, 0, 0}
caret_of(i64 v, i64 p) => array{views[v].lay.node[p], views[v].lay.piece[p], views[v].lay.offset[p]};
// Место по (узел, кусок, смещение) от клиента: конец куска — место после его последнего символа;
// exact — только ровно это место (и конец текста — его последним символом); -1 — нет
place_at(i64 v, i64 n, i64 piece, i64 offset, bool exact) {
  k = layout_at(v, n);
  if((k < 0) || ((piece < 0) || (piece >= views[v].lay.count[k]))) return -1;
  j = views[v].lay.first[k] + piece;
  if(views[v].lay.pchild[j] >= 0) return -1;
  len = views[v].lay.plen[j];
  start = views[v].lay.pplace[j];
  if(offset < len) return start + offset;
  if((offset == len) && ((len > 0) && (!exact || ((start + len) == end_of(v))))) return start + len;
  -1
}
// Номер первого элемента черновика в элементах модуля (пустого — место вставки).
group_at(i64 v) {
  items = code_items(program());
  first = if(views[v].d.items.size > 0) views[v].d.items[0] else views[v].d.next;
  if(given(first)) for(k : range(items.size)) if(code_id(items[k]) == code_id(first)) return k;
  k = 0; // в конце — перед внутренними элементами
  while((k < items.size) && !is_inner(items[k])) k += 1;
  k
}
// Напечатать представление заново (курсор — в начало: место ставит тот, кто печатает).
relayout(i64 v) => relayout_from(v, array{}, false);
// Черновик правлен на месте (old — его элементы до правки): если прежняя раскладка напечатана с
// ним же, печатается только его область —  
// иначе — представление целиком.
relayout_from(i64 v, old, bool in_place) {
  if(in_place && ((views[v].kind == "module") && (views[v].d.open && (views[v].lay.group_count == old.size)))) {
    at = group_at(v);
    if(views[v].lay.group_at == at) {
      views[v].lay = print_splice(views[v].lay, views[v].root, views[v].projection, at, old, views[v].d.items.size, views[v].d.source);
      views[v].cursor = 0;
      return 0;
    }
  }
  as_module = views[v].kind == "module";
  count = if(views[v].d.open && as_module) views[v].d.items.size else -1;
  at = if(count >= 0) group_at(v) else 0;
  fn_source = if(!as_module && views[v].d.open) views[v].d.source else -1;
  views[v].lay = print_view(views[v].root, as_module, views[v].projection, at, count, views[v].d.source, fn_source);
  views[v].cursor = 0;
  0
}
// Курсор на строке из одних пробелов (пустая строка с отступом) — в конец отступа: набор начнётся
// в колонке кода.
blank_line_end(i64 v, i64 c) {
  ld = leads(v);
  if(c >= ld.size) return c;
  s = c;
  e = c;
  while((s > 0) && (ld[s - 1] != '\n')) s -= 1;
  while(((e + 1) < ld.size) && (ld[e] != '\n')) e += 1;
  for(k : range(e - s)) if(ld[s + k] != ' ') return c;
  e
}
// поддерево: x внутри top (или он сам)
within(x, top) {
  n = x;
  r = false;
  while(given(n) && !r) {
    if(code_id(n) == code_id(top)) r = true;
    n = code_parent(n);
  }
  r
}
has_code(xs, c) {
  r = false;
  for(x : xs) if(code_id(x) == code_id(c)) r = true;
  r
}
same_codes(xs, ys) {
  r = xs.size == ys.size;
  if(r) for(k : range(xs.size)) if(code_id(xs[k]) != code_id(ys[k])) r = false;
  r
}
has_int(xs, i64 x) {
  r = false;
  for(y : xs) if(y == x) r = true;
  r
}
greater(i64 x, i64 y) => if(x > y) x else y;

// --- курсор и выделение клиенту ---------------------------------------------------------------
send_cursor(i64 v) {
  array{n, p, o} = caret_of(v, views[v].cursor);
  send_caret(views[v].peer, views[v].id, false, n, p, o);
  an = views[v].anchor;
  sel = (an >= 0) && ((an != views[v].cursor) && (an < places(v)));
  if(!sel && !views[v].selection_sent) return 0;
  if(sel) {
    array{an_n, an_p, an_o} = caret_of(v, an);
    send_caret(views[v].peer, views[v].id, true, an_n, an_p, an_o);
  } else send_caret(views[v].peer, views[v].id, true, -1, 0, 0);
  views[v].selection_sent = sel;
  0
}
cursor(i64 v) => views[v].cursor;
set_cursor(i64 v, i64 k) {
  views[v].cursor = if(k < 0) 0 else lesser(k, end_of(v));
  views[v].cursor
}
// второй конец выделения; -1 — нет
anchor(i64 v) => views[v].anchor;
set_anchor(i64 v, i64 k) {
  views[v].anchor = if(k < 0) -1 else k;
  0
}
// колонка для ↑/↓; -1 — нет
goal(i64 v) => views[v].goal;
set_goal(i64 v, i64 g) {
  views[v].goal = if(g < 0) -1 else g;
  0
}
draft_open(i64 v) => views[v].d.open;
set_typing(i64 v, bool on) {
  views[v].typing = on;
  0
}

// --- списки: дополнение и переход --------------------------------------------------------------
send_completion(i64 v) {
  array{n, p, o} = if(views[v].word_begin < places(v)) caret_of(v, views[v].word_begin) else array{-1, 0, 0};
  send_completion_list(views[v].peer, views[v].id, n, p, o, views[v].selected, views[v].items);
}
// открыт список дополнения (или перехода) и в нём есть варианты
completing(i64 v) => views[v].completing && (views[v].items.size > 0);
completion_count(i64 v) => views[v].items.size;
selected(i64 v) => views[v].selected;
select_item(i64 v, i64 k) {
  views[v].selected = k;
  send_completion(v);
}
completion_name(i64 v, i64 k) => views[v].items[k].name;
// начало набираемого слова дополнения
word_begin(i64 v) => views[v].word_begin;
// список — переход (F12, Ctrl+P), а не дополнение
nav_list(i64 v) => views[v].targets.size > 0;
close_completion(i64 v) {
  if(!views[v].completing) return 0;
  views[v].completing = false;
  views[v].items = array{};
  views[v].targets = array{};
  send_completion(v);
}
// пункт k списка перехода: функция (пусто — «добавить») и сигнатура, которую добавить
nav_fn(i64 v, i64 k) => views[v].targets[k][0];
nav_add(i64 v, i64 k) => views[v].targets[k][1];
// список перехода у курсора: варианты (completion) и цели — array{функция, добавить}
show_nav(i64 v, items, targets) {
  views[v].items = items;
  views[v].targets = targets;
  views[v].selected = 0;
  views[v].word_begin = views[v].cursor;
  views[v].completing = true;
  send_completion(v);
}
// список дополнения: варианты (completion), начало набираемого слова
show_completion(i64 v, items, i64 from) {
  views[v].items = items;
  views[v].selected = 0;
  views[v].word_begin = from;
  views[v].completing = true;
  send_completion(v);
}
hint_shown(i64 v) => views[v].hint_shown;
// подсказка набора у места anchor (-1 — без места); пусто — скрыть
show_hint(i64 v, i64 at, lines) {
  array{n, p, o} = if((at >= 0) && (at < places(v))) caret_of(v, at) else array{-1, 0, 0};
  views[v].hint_shown = lines.size > 0;
  send_hint_lines(views[v].peer, views[v].id, n, p, o, lines);
}
hide_hint(i64 v) {
  if(!views[v].hint_shown) return 0;
  views[v].hint_shown = false;
  send_hint_lines(views[v].peer, views[v].id, -1, 0, 0, array{});
}
show_hover(i64 v, n, lines) => send_hover(views[v].peer, views[v].id, n, lines);
show_inspect(i64 v, root, focus, nodes, expand) => send_inspect(views[v].peer, views[v].id, root, focus, nodes, expand);
show_marks(i64 v, marks) => send_marks_list(views[v].peer, views[v].id, marks);
// узлы раскладки представления (по порядку проекции)
view_nodes(i64 v) => node_codes(views[v].lay.nodes);
// вид представления: module — модуль, fn — одна функция
view_kind(i64 v) => views[v].kind;
view_root(i64 v) => views[v].root;
view_layer(i64 v) => views[v].layer;
// выбран слой (контекст экземпляра) функции
in_layer(i64 v) => (views[v].kind == "fn") && ((views[v].layer != "") && has_layer(views[v].root, views[v].layer));
// значение узла в слое представления ("" — нет); наблюдения слоя: типы узла; исполнялся ли
layer_literal(i64 v, n) => if(in_layer(v)) layer_literal_of(views[v].root, views[v].layer, n) else "";
layer_types(i64 v, n) => if(in_layer(v)) layer_types_of(views[v].root, views[v].layer, n) else array{};
layer_has(i64 v, n) => in_layer(v) && (given(n) && layer_has_of(views[v].root, views[v].layer, n));
// ошибки разбора на узлах представления: array{узел, текст, from, to}
error_marks(i64 v) => errors_on(views[v].lay.nodes);
// тексты ошибок разбора у узла
error_texts(i64 v, n) {
  r = array{};
  for(e : error_marks(v)) if(code_id(e[0]) == code_id(n)) r.push(e[1]);
  r
}
// слои функции представления: array{ключ, кт | рт}
layers_of(i64 v) => fn_layers(views[v].root);
show_layers(i64 v, layers) => send_layer_tabs(views[v].peer, views[v].id, layers, views[v].layer);
set_layer(i64 v, str key) {
  views[v].layer = key;
  0
}
// проекция представления (модуль записей по ключу; "" — по умолчанию); ошибка или ""
set_projection(i64 v, str key) {
  array{m, error} = projection_of(key);
  if(error == "") views[v].projection = m;
  error
}
// типы значения слева от точки на месте dot (по всем экземплярам): узел a.b — его объект; иначе
// (текст ещё дыра: xs.) — имя перед точкой, его типы в области
object_types(i64 v, i64 dot) {
  n = place_node(v, dot);
  while(given(n)) {
    if(member_name(n) != "") return node_types(member_object(n));
    n = code_parent(n);
  }
  k = dot;
  while((k > 0) && ident_byte(lead(v, k - 1))) k -= 1;
  name = text_of(v, k, dot);
  if(name == "") array{} else name_types(place_node(v, dot), name)
}

// --- представление клиенту ------------------------------------------------------------------
// проверка программы и узлы, изменённые её элаборацией, — представлениям, где они видны
recheck() {
  check_program();
  refresh_changed();
}
// Узлы, изменённые мутациями ct-кода и их откатом (элаборация при check, правка источника, §7.4):
// представления, где они видны и чей текст изменился, получают обновление — редактор показывает
// результат элаборации 
//.
refresh_changed() {
  xs = changed_nodes(true);
  if(xs.size == 0) return 0;
  for(w : range(views.size)) if(given(views[w].root)) {
    shown = array{};
    for(x : xs) if((layout_at(w, x) >= 0) && !has_int(shown, x)) shown.push(x);
    if(shown.size > 0) {
      was = views[w].lay.text;
      cur = views[w].cursor;
      array{kn, kp, ko} = caret_of(w, cur);
      relayout(w); // курсор — на том же месте узла
      views[w].cursor = lesser(cur, end_of(w));
      k = place_at(w, kn, kp, ko, true);
      if(k >= 0) views[w].cursor = k;
      if(views[w].lay.text != was) {
        // одно обновление — общий предок изменённых (клиент не видит промежуточной смеси)
        top = code();
        for(x : shown) if(layout_at(w, x) >= 0) {
          xc = node_code(x);
          if(!given(top)) top = xc;
          while(given(top) && !within(xc, top)) top = code_parent(top);
        }
        while(given(top) && (layout_of(w, top) < 0)) top = code_parent(top);
        if(!given(top)) top = views[w].root;
        send_update(views[w].peer, views[w].id, top, views[w].lay);
        send_cursor(w);
      }
    }
  }
  0
}
// представление заново (раскладка, курсор, метки); fresh — напечатать
show_view_of(i64 v, bool fresh) {
  recheck(); // элаборация — до раскладки: мутации ct-кода видны сразу
  if(fresh) relayout(v);
  send_view(views[v].peer, views[v].id, views[v].root, views[v].kind, views[v].lay);
  send_cursor(v);
  recheck();
  send_marks(v);
}
show_view(i64 v) => show_view_of(v, true);
// все представления заново (база изменилась целиком: слияние, правка функцией)
refresh_all() {
  recheck();
  for(w : range(views.size)) if(given(views[w].root)) show_view_of(w, true);
  0
}
// Пауза набора: проверка (реактивный check) и метки всем представлениям; черновики закрыты —
// принятые правки ложатся в живой процесс запуска (горячая замена, §9.3).
// Правки — в живой процесс (черновики закрыты): элементы модулей программы, изменённые с прошлого
// раза, — заменой по ключу в его базе, как proc/edit (§9.3); начатые кадры доживают в старом теле.
// struct, у которого живые значения старой раскладки, — через migrate(T old) программы, нет её —
// процесс останавливается.  
// Итог — что сказать человеку ("" — нечего).
sync_program() {
  if(!live_sync_due()) return "";
  lv = live_version();
  changed = 0;
  migrations = array{};
  for(mod : live_modules()) {
    now_items = module_items(0, mod, array{});
    was_items = module_items(lv, mod, array{});
    keys = array{};
    for(x : now_items) if(!has_text(keys, x.key)) keys.push(x.key);
    for(x : was_items) if(!has_text(keys, x.key)) keys.push(x.key);
    for(key : keys) {
      now = find_key(now_items, key);
      was = find_key(was_items, key);
      if(!(now.present && (was.present && (now.text == was.text)))) {
        changed += 1;
        if(now.present && (was.present && (version_signature(0, now.node)[0] == "struct"))) {
          tn = version_signature(0, now.node)[1];
          stale = live_stale(now.node);
          if(stale > 0) {
            if(!find_key(now_items, ("migrate(" + tn) + ")").present) {
              stop_program();
              return ((((((("struct " + tn) + " изменён, а живой процесс держит значений старой раскладки: ") + text(stale)) + " — нужна migrate(") + tn) + " old) => ") + tn) + "{…}; процесс остановлен";
            }
            migrations.push(tn);
          }
        }
        if(was.present && !now.present) {
          wk = version_signature(lv, was.node)[0];
          if((wk == "fn") || (wk == "syntax")) live_forget(was.node); // убрана: новые вызовы её не видят
        }
        got = take_theirs(lv, mod, array{}, key, now);
        if(now.present && (!was.present && (got >= 0))) live_register(got);
      }
    }
  }
  if(changed == 0) return "";
  for(tn : migrations) {
    why = live_migrate(tn);
    if(why != "") {
      stop_program();
      return ((("migrate " + tn) + ": ") + why) + "; процесс остановлен";
    }
  }
  live_refresh();
  ""
}
idle() {
  clear_pending();
  recheck();
  for(w : range(views.size)) if(given(views[w].root)) send_marks(w);
  if(program_running() && !any_draft_open()) {
    said = sync_program();
    if(said != "") report(said);
  }
  0
}
any_draft_open() {
  r = false;
  for(w : range(views.size)) if(given(views[w].root) && draft_open(w)) r = true;
  r
}
on_idle() => idle();
// открыть функцию во второй панели (у клиента одно представление функции)
open_fn(f) {
  p = now_peer();
  fv = -1;
  for(w : range(views.size)) if((views[w].peer == p) && (given(views[w].root) && (views[w].kind == "fn"))) fv = w;
  if(fv < 0) {
    views.push(new_view(p, peer_view_count(p) + 1, f, "fn"));
    fv = views.size - 1;
  }
  views[fv].root = f;
  views[fv].layer = "";
  views[fv].cursor = 0;
  views[fv].completing = false;
  relayout(fv);
  // курсор — в тело: на пустую строку, если есть, иначе после `{`
  n = places(fv);
  k = 0;
  while((k + 1) < n) {
    if(lead(fv, k) == '{') {
      views[fv].cursor = blank_line_end(fv, if((k + 2) < n) k + 2 else k + 1);
      k = n;
    } else k += 1;
  }
  show_view_of(fv, false);
}
// Добавить внутренний элемент модуля (текст — от add_overload): элемент — в конец модуля,
// внутренним; метки модуля, открыть во второй панели.
add_inner(str text, str sig) {
  f = parse_inner(text, sig);
  if(!given(f)) return report("не удалось добавить " + sig);
  // представления модуля: внутренний элемент не виден — меняются только метки
  recheck();
  for(w : range(views.size)) if(given(views[w].root) && (views[w].kind == "module")) send_marks(w);
  open_fn(f);
}

// --- черновик: набор как в обычном редакторе -------------------------------------------
// Решения пользователя (2026-10-12): клавиши идут в VM 
// но текст элемента модуля, который правят, — ровно как набран: `;`,
// пробелы и пустые строки ставит человек, а не проекция. Каждая правка разбирает черновик целиком
// (дописанное — узлы, недописанное — дыры своих строк, непарная скобка — по отступу, §4.1);
// раскладка — по местам узлов в набранном тексте, DOM остаётся деревом AST. Проверка и метки — по
// паузе в 1 с; канон — при уходе из элемента модуля (курсор вне его, Escape, сохранение, запуск,
// другое представление). 
//.

// Начало строк первого выведенного элемента с номера j; нет — конец элементов.
content_from(i64 v, i64 j) {
  k = j;
  while(k < views[v].lay.content_at.size) {
    if(views[v].lay.content_at[k] >= 0) return views[v].lay.content_at[k];
    k += 1;
  }
  views[v].lay.items_end
}
// Единица черновика вокруг места: места [from, to), элементы модуля [k0, k1); last — последняя
// (конец текста элементов — её место). ok false — нет (шапка модуля, комментарии конца).
struct region { bool ok; i64 from; i64 to; i64 k0; i64 k1; bool last; }
no_region() => region{false, 0, 0, 0, 0, false};
holds(region r, i64 p) => (p >= r.from) && ((p < r.to) || ((p == r.to) && r.last));
unit_of(i64 v, i64 place) {
  if(views[v].kind != "module") return region{true, 0, end_of(v), 0, 0, true};
  pb = byte_of(v, place);
  if(views[v].d.open) {
    at = group_at(v);
    r = region{true, place_of_byte(v, views[v].lay.draft_begin), place_of_byte(v, views[v].lay.draft_end), at, at + views[v].d.items.size, views[v].lay.draft_end == views[v].lay.items_end};
    if(holds(r, place)) return r;
  }
  k = -1; // элемент: последний, чьи строки начинаются не дальше места
  any = false;
  for(j : range(views[v].lay.content_at.size)) if(views[v].lay.content_at[j] >= 0) {
    any = true;
    if(views[v].lay.content_at[j] <= pb) k = j;
  }
  if(k < 0) {
    if(any || (views[v].d.open && (views[v].lay.draft_begin < views[v].lay.draft_end))) return no_region(); // шапка модуля
    items = code_items(program());
    at = 0;
    while((at < items.size) && !is_inner(items[at])) at += 1;
    e = place_of_byte(v, views[v].lay.items_end);
    return region{true, e, e, at, at, true};
  }
  to = content_from(v, k + 1);
  if(views[v].d.open && ((views[v].lay.draft_begin > views[v].lay.chunk_at[k]) && (views[v].lay.draft_begin < to))) to = views[v].lay.draft_begin; // черновик сразу после
  r = region{true, place_of_byte(v, views[v].lay.chunk_at[k]), place_of_byte(v, to), k, k + 1, to == views[v].lay.items_end};
  if(!holds(r, place)) return no_region(); // комментарии конца модуля
  r
}
draft_region(i64 v) {
  if(!views[v].d.open) return no_region();
  if(views[v].kind != "module") return region{true, 0, end_of(v), 0, 0, true};
  at = group_at(v);
  region{true, place_of_byte(v, views[v].lay.draft_begin), place_of_byte(v, views[v].lay.draft_end), at, at + views[v].d.items.size, views[v].lay.draft_end == views[v].lay.items_end}
}
// Черновик, покрывающий места [a, b]: открыть или расширить 
// Элемент в черновике другого клиента —
// отказ. Итог: array{1 — открыт, 0 — место не в элементе модуля, -1 — отказ; единица}.
open_draft(i64 v, i64 a, i64 b) {
  ra = unit_of(v, a);
  rb = unit_of(v, b);
  if(!ra.ok || !rb.ok) return array{0, no_region()};
  r = region{true, lesser(ra.from, rb.from), greater(ra.to, rb.to), lesser(ra.k0, rb.k0), greater(ra.k1, rb.k1), ra.last || rb.last};
  group = array{};
  if(views[v].kind == "module") {
    items = code_items(program());
    for(k : range(r.k1 - r.k0)) group.push(items[r.k0 + k]);
  } else group.push(views[v].root);
  for(w : range(views.size)) if((w != v) && (given(views[w].root) && views[w].d.open)) {
    hit = false;
    for(x : views[w].d.items) if(has_code(group, x)) hit = true;
    if(hit) {
      if(views[w].peer != views[v].peer) return array{-1, r};
      finalize(w); // своё другое представление — к канону
    }
  }
  if(views[v].d.open && same_codes(views[v].d.items, group)) return array{1, r};
  gb = byte_of(v, r.from);
  ge = byte_of(v, r.to);
  if(!views[v].d.open) {
    views[v].d.since = revision();
    views[v].d.sources = array{};
    views[v].d.before = slice_text(views[v].lay.text, gb, ge);
  } else {
    was = draft_region(v); // расширение: соседи — их текст до черновика
    if(was.ok) {
      wb = byte_of(v, was.from);
      we = byte_of(v, was.to);
      t = views[v].lay.text;
      views[v].d.before = (slice_text(t, gb, wb) + views[v].d.before) + slice_text(t, we, ge);
    }
  }
  views[v].d.open = true; // новый черновик или расширение открытого
  views[v].d.items = group;
  if(views[v].kind == "module") {
    items = code_items(program());
    views[v].d.next = if((r.k1 < items.size) && !is_inner(items[r.k1])) items[r.k1] else code();
  }
  array{1, r}
}
// байт после n кодовых точек строки
cp_bytes(str s, i64 n) {
  b = 0;
  k = 0;
  while((k < n) && (b < s.size)) {
    b += 1;
    while((b < s.size) && ((s[b] & 192) == 128)) b += 1;
    k += 1;
  }
  b
}
// последние n элементов
tail_of(xs, i64 n) {
  r = array{};
  for(k : range(xs.size)) if(k >= (xs.size - n)) r.push(xs[k]);
  r
}
// без последнего элемента
without_last(xs) {
  r = array{};
  for(k : range(xs.size - 1)) r.push(xs[k]);
  r
}
// Правка мест [a, b) на ins в черновике; caret — курсор после правки (кодовые точки внутри ins).
// 0 — место не в элементе модуля (шапка, комментарии конца): обычная правка; -1 — отклонено.
draft_edit(i64 v, i64 a, i64 b, str ins, i64 caret) {
  array{state, r} = open_draft(v, a, b);
  if(state < 0) {
    report("элемент правит другой клиент");
    return -1;
  }
  if(state == 0) return 0;
  base = byte_of(v, r.from);
  t = slice_text(views[v].lay.text, base, byte_of(v, r.to));
  ia = byte_of(v, a) - base;
  ib = byte_of(v, b) - base;
  edited = (slice_text(t, 0, ia) + ins) + text_from(t, ib);
  word = (a == b) && ((code_points(ins) == 1) && ident_byte(ins[0]));
  if(!(word && views[v].typing)) {
    views[v].undo.push(snapshot{t, byte_of(v, views[v].cursor) - base});
    if(views[v].undo.size > 500) views[v].undo = tail_of(views[v].undo, 500);
  }
  views[v].typing = word;
  views[v].redo = array{};
  array{hn, hp, ho} = caret_of(v, a);
  hint = edit_hint{hn, hp, ho, b - a, code_points(ins), true};
  commit_draft(v, edited, ia + cp_bytes(ins, caret), r.from, r.to);
  1
}
// Разобрать текст черновика и поставить его элементы в модуль (id элементов того же вида
// сохраняются); разослать раскладку. from, to — места черновика до правки.
commit_draft(i64 v, str t, i64 caret_at, i64 from, i64 to) {
  at = if(views[v].kind == "module") group_at(v) else 0;
  old = views[v].d.items;
  array{ids, source, blank, rest, reparsed} = draft_parse(views[v].kind == "module", views[v].root, t, views[v].d.items, views[v].d.next, at, views[v].projection);
  views[v].d.items = ids;
  views[v].d.source = source;
  views[v].d.sources.push(source);
  views[v].d.blank = blank;
  views[v].d.rest = rest;
  close_traces();
  broadcast(v, from, to, caret_at, reparsed, old);
  hint.valid = false;
  schedule_check();
}
// подпись поддерева узла x в раскладке до правки (0 — узла в ней нет)
tree_sig(nodes, order, sub, x) {
  k = index_in(nodes, order, code_id(x));
  if(k < 0) 0 else sub[k]
}
// Самый глубокий узел, вне которого раскладка не изменилась: свои куски те же, а изменилось
// поддерево ровно одного ребёнка — спуск в него (правка в сыром блоке — обновление только блока).
narrowest(i64 w, nodes, order, sig, sub, x) {
  n = x;
  while(true) {
    k = layout_of(w, n);
    ko = index_in(nodes, order, code_id(n));
    if((k < 0) || ((ko < 0) || (sig[ko] != views[w].lay.sig[k]))) return n;
    only = code();
    changed = 0;
    f = views[w].lay.first[k];
    for(j : range(views[w].lay.count[k])) {
      ch = views[w].lay.pchild[f + j];
      if(ch >= 0) {
        kc = layout_at(w, ch);
        kco = index_in(nodes, order, ch);
        if((kc < 0) || ((kco < 0) || (sub[kco] != views[w].lay.sub[kc]))) {
          only = node_code(ch);
          changed += 1;
        }
      }
    }
    if(changed != 1) return n;
    n = only;
  }
  n
}
// Новая раскладка всем представлениям. Автору (av, черновик) — курсор на caret_at байт от начала
// черновика; изменилось только внутри черновика — обновления его элементов, иначе — модуль
// целиком. Остальным — курсор на том же месте узла.
// Правка изменила только текст черновика v: ничего вне его не переразобрано и не изменено
// элаборацией (откат мутаций ct-кода, §7.4), расширений по ссылке на его функции нет (расширение
// печатает имя и сигнатуру цели).
draft_only(i64 v, reparsed) {
  if((reparsed.size > 0) || (changed_nodes(false).size > 0)) return false;
  for(e : fn_extensions()) for(x : views[v].d.items) if(within(e[1], x)) return false;
  true
}
// old — элементы черновика автора до правки (его раскладка — вклейкой, если правка не вышла за
// черновик)
broadcast(i64 av, i64 old_from, i64 old_to, i64 caret_at, reparsed, old) {
  in_place = draft_only(av, reparsed);
  tops = views[av].d.items; // правленые элементы и переразобранные — их раскладки до правки
  for(x : reparsed) {
    inside = false;
    for(y : tops) if(within(x, y)) inside = true;
    if(!inside) tops.push(x);
  }
  for(w : range(views.size)) if(given(views[w].root)) {
    // раскладка до правки: узлы, их порядок и подписи
    o_nodes = views[w].lay.sorted;
    o_order = views[w].lay.order;
    o_sig = views[w].lay.sig;
    o_sub = views[w].lay.sub;
    was = views[w].lay.text;
    mine = w == av;
    nb = views[w].lay.byte.size;
    ob = if(mine && (nb > 0)) views[w].lay.byte[lesser(old_from, nb - 1)] else 0;
    oe = if(mine && (nb > 0)) views[w].lay.byte[lesser(old_to, nb - 1)] else 0;
    array{kn, kp, ko} = caret_of(w, views[w].cursor);
    keep_byte = byte_of(w, views[w].cursor);
    relayout_from(w, old, mine && in_place);
    if(mine) {
      start = if(views[w].kind == "module") views[w].lay.draft_begin else 0;
      views[w].cursor = lesser(place_of_byte(w, start + caret_at), end_of(w));
      views[w].anchor = -1;
      views[w].goal = -1;
    } else {
      if(hint.valid && ((kn == hint.node) && ((kp == hint.piece) && (ko >= hint.offset))))
        ko = if(ko >= (hint.offset + hint.removed)) (ko - hint.removed) + hint.inserted else hint.offset + hint.inserted;
      views[w].cursor = lesser(place_of_byte(w, keep_byte), end_of(w));
      k = place_at(w, kn, kp, ko, true);
      if(k >= 0) views[w].cursor = k;
      if(views[w].anchor >= 0) views[w].anchor = lesser(views[w].anchor, end_of(w));
    }
    if(mine || (views[w].lay.text != was)) {
      // корень тот же (его куски — те же тексты и элементы): обновления только элементов черновика
      // и переразобранных по новым правилам
      inside = (views[w].lay.sig.size > 0) && ((o_sig.size > 0) && (views[w].lay.sig[0] == o_sig[0]));
      if(mine && (views[w].kind == "module"))
        inside = inside && ((slice_text(was, 0, ob) == slice_text(views[w].lay.text, 0, views[w].lay.draft_begin)) && (text_from(was, oe) == text_from(views[w].lay.text, views[w].lay.draft_end)));
      // одно обновление: изменился один элемент — он, иначе — корень (клиент не видит
      // промежуточной смеси)
      changed = array{};
      for(x : tops) {
        kx = layout_of(w, x);
        if((kx >= 0) && (views[w].lay.sub[kx] != tree_sig(o_nodes, o_order, o_sub, x))) {
          nested = false;
          for(y : tops) if((code_id(y) != code_id(x)) && ((layout_of(w, y) >= 0) && within(x, y))) nested = true;
          if(!nested) changed.push(x);
        }
      }
      if(inside && (changed.size == 1)) send_update(views[w].peer, views[w].id, narrowest(w, o_nodes, o_order, o_sig, o_sub, changed[0]), views[w].lay);
      else if(!inside || (changed.size > 0)) send_update(views[w].peer, views[w].id, views[w].root, views[w].lay);
      if(!mine) close_completion(w);
      send_cursor(w);
    }
  }
  0
}
// Место x (байт текста до канона) — после канона: до черновика — на том же месте, внутри —
// выравниванием набранного текста с каноническим, после — со сдвигом.
map_place(i64 v, str was, i64 ob, i64 oe, i64 ne, i64 x) {
  if(x < ob) return place_of_byte(v, x);
  if((x >= oe) && !((x == oe) && (oe == was.size))) return place_of_byte(v, (x - oe) + ne);
  got = align(text_from(was, ob), code_points(slice_text(was, ob, x)), text_from(views[v].lay.text, ob));
  lesser(place_of_byte(v, ob) + got, end_of(v))
}
// Канон: черновик уходит, представление печатается проекцией. Курсор и выделение — до черновика на
// тех же местах, внутри — выравниванием набранного текста с каноническим, после — со сдвигом.
// mode: 0 — правка, 1 — откат, 2 — повтор (история принятого).
finalize_mode(i64 v, i64 mode) {
  if(!views[v].d.open) return 0;
  as_module = views[v].kind == "module";
  ob = if(as_module) views[v].lay.draft_begin else 0;
  oe = if(as_module) views[v].lay.draft_end else views[v].lay.text.size;
  at = if(as_module) group_at(v) else 0;
  count = views[v].d.items.size;
  was = views[v].lay.text;
  cur = byte_of(v, views[v].cursor);
  anc = if(views[v].anchor >= 0) byte_of(v, views[v].anchor) else -1;
  draft_close(as_module, at, count, views[v].d.next, views[v].d.blank, views[v].d.rest, views[v].d.since, views[v].d.sources, views[v].d.source);
  entry = closed{views[v].d.items, views[v].d.next, views[v].d.before, ""};
  views[v].d = empty_draft();
  views[v].undo = array{};
  views[v].redo = array{};
  views[v].typing = false;
  check_program(); // элаборация — до раскладки: канон показывает изменённое ct-кодом
  relayout(v);
  ne = if(as_module) content_from(v, at + count) else views[v].lay.text.size;
  if(as_module && (ne < ob)) ne = ob;
  if(as_module) { // история принятого: текст единицы после — канон
    entry.after = slice_text(views[v].lay.text, ob, ne);
    if(entry.before != entry.after) {
      if(mode == 1) views[v].undone.push(entry) else views[v].done.push(entry);
      if(mode == 0) views[v].undone = array{};
    }
  }
  views[v].cursor = map_place(v, was, ob, oe, ne, cur);
  views[v].anchor = if(anc >= 0) map_place(v, was, ob, oe, ne, anc) else -1;
  for(w : range(views.size)) if(given(views[w].root)) {
    fresh = true;
    if(w != v) {
      t = views[w].lay.text;
      array{kn, kp, ko} = caret_of(w, views[w].cursor);
      relayout(w);
      k = place_at(w, kn, kp, ko, true);
      if(k >= 0) views[w].cursor = k;
      fresh = views[w].lay.text != t;
    }
    if(fresh) {
      send_update(views[w].peer, views[w].id, views[w].root, views[w].lay);
      send_cursor(w);
    }
  }
  close_completion(v);
  idle();
}
finalize(i64 v) => finalize_mode(v, 0);
// черновики всех представлений клиента — к канону (кроме представления except; -1 — всех)
finalize_peer(i64 p, i64 except) {
  for(w : range(views.size)) if((views[w].peer == p) && (given(views[w].root) && (w != except))) finalize(w);
  0
}
finalize_views() => finalize_peer(now_peer(), -1);
finalize_others(i64 v) => finalize_peer(views[v].peer, v);
finalize_everyone() {
  for(w : range(views.size)) if(given(views[w].root)) finalize(w);
  0
}
// Правка [a, b) на ins: в черновике, иначе (шапка модуля) — переразбором скобок; caret — курсор
// во вставке (кодовые точки; -1 — после неё)
replace(i64 v, i64 a, i64 b, str ins, i64 caret) {
  n = code_points(ins);
  c = if((caret < 0) || (caret > n)) n else caret;
  views[v].anchor = -1;
  views[v].goal = -1;
  r = draft_edit(v, a, b, ins, c);
  if(r == 0) {
    views[v].typing = false;
    edit(v, a, b, ins, c);
  }
  0
}
// Курсор передвинут (решение — move_to): набор слова кончился, дополнение закрыто; вне черновика —
// канон; курсор и подсказка — клиенту.
cursor_moved(i64 v) {
  views[v].typing = false;
  close_completion(v);
  r = draft_region(v);
  if(r.ok && !(holds(r, views[v].cursor) && ((views[v].anchor < 0) || holds(r, views[v].anchor)))) finalize(v) else send_cursor(v);
}
// Откат и повтор — внутри черновика; вне его — принятой правки.
undo(i64 v, bool again) {
  r = draft_region(v);
  n = if(again) views[v].redo.size else views[v].undo.size;
  if(!r.ok || (n == 0)) return undo_closed(v, again);
  base = byte_of(v, r.from);
  now = snapshot{slice_text(views[v].lay.text, base, byte_of(v, r.to)), byte_of(v, views[v].cursor) - base};
  snap = if(again) views[v].redo[n - 1] else views[v].undo[n - 1];
  if(again) {
    views[v].redo = without_last(views[v].redo);
    views[v].undo.push(now);
  } else {
    views[v].undo = without_last(views[v].undo);
    views[v].redo.push(now);
  }
  views[v].typing = false;
  views[v].anchor = -1;
  views[v].goal = -1;
  commit_draft(v, snap.text, snap.caret, r.from, r.to);
}
// место элемента в элементах модуля (-1 — нет)
index_of(items, c) {
  r = -1;
  for(k : range(items.size)) if((r < 0) && (code_id(items[k]) == code_id(c))) r = k;
  r
}
// Откат (повтор) принятой правки: единица — те же элементы, её текст — как был до правки (после
// неё); правка обратно — черновиком, сразу к канону. Текст единицы изменился с тех пор (другой
// клиент) — отказ.
undo_closed(i64 v, bool again) {
  finalize(v);
  n = if(again) views[v].undone.size else views[v].done.size;
  if(n == 0) return report(if(again) "повторять нечего" else "откатывать нечего");
  if(views[v].kind != "module") return report("откат принятого — в представлении модуля");
  e = if(again) views[v].undone[n - 1] else views[v].done[n - 1];
  if(again) views[v].undone = without_last(views[v].undone) else views[v].done = without_last(views[v].done);
  items = code_items(program());
  at = 0;
  if(e.items.size > 0) {
    i = index_of(items, e.items[0]);
    here = (i >= 0) && ((items.size - i) >= e.items.size);
    if(here) for(k : range(e.items.size)) if(code_id(items[i + k]) != code_id(e.items[k])) here = false;
    if(!here) return report("откат: элементов правки больше нет");
    at = i;
  } else {
    at = if(given(e.next)) index_of(items, e.next) else -1;
    if(at < 0) at = items.size;
    while(!given(e.next) && ((at > 0) && is_inner(items[at - 1]))) at -= 1;
  }
  count = e.items.size;
  ob = if((at < views[v].lay.chunk_at.size) && (count > 0)) views[v].lay.chunk_at[at] else content_from(v, at);
  oe = content_from(v, at + count);
  if((ob < 0) || ((oe < ob) || (slice_text(views[v].lay.text, ob, oe) != e.after))) return report("откат: элемент изменился после правки");
  for(w : range(views.size)) if((w != v) && (given(views[w].root) && views[w].d.open))
    for(x : views[w].d.items) if(has_code(e.items, x)) return report("элемент правит другой клиент");
  from_place = place_of_byte(v, ob);
  to_place = place_of_byte(v, oe);
  views[v].d = draft{true, e.items, e.next, 0, array{}, array{}, revision(), e.after, array{}};
  views[v].anchor = -1;
  views[v].goal = -1;
  views[v].typing = false;
  // курсор — на месте правки: первое отличие текстов
  same = 0;
  while((same < e.before.size) && ((same < e.after.size) && (e.before[same] == e.after[same]))) same += 1;
  while((same > 0) && ((same < e.before.size) && ((e.before[same] & 192) == 128))) same -= 1;
  commit_draft(v, e.before, same, from_place, to_place);
  finalize_mode(v, if(again) 2 else 1);
}

// --- ввод: правка текста проекции → переразбор скобок ---------------------------------------
// Правка мест [a, b) на ins. Единица переразбора — наименьшие скобки вокруг правки: блок, затем
// элемент модуля, затем модуль. 
// 
// Если сломаны скобки самой единицы — берутся внешние. Любой текст
// разбирается: недописанное — дыры (
// там же). Узел единицы сохраняет id.
struct edit_unit { code node; i64 kind; i64 from; i64 to; } // kind: 0 — блок, 1 — элемент модуля, 2 — модуль
units_around(i64 v, i64 a, i64 b) {
  found = array{};
  // блоки, внутри скобок которых правка, — предки узла места (изнутри наружу — по размеру)
  k = layout_at(v, views[v].lay.node[a]);
  while(k >= 0) {
    fr = range_from(v, k);
    t = range_to(v, k);
    if(((t - fr) >= 2) && ((a >= (fr + 1)) && (b <= (t - 1)))) {
      n = node_code(views[v].lay.nodes[k]);
      if(code_kind(n) == ast.block) found.push(edit_unit{n, 0, fr, t});
    }
    k = views[v].lay.up[k];
  }
  for(item : code_items(program())) {
    ki = layout_of(v, item);
    if((ki >= 0) && ((a >= range_from(v, ki)) && (b <= range_to(v, ki)))) found.push(edit_unit{item, 1, range_from(v, ki), range_to(v, ki)});
  }
  if(views[v].kind == "module") found.push(edit_unit{program(), 2, range_from(v, 0), range_to(v, 0)});
  found
}
// Правка внутри единицы (в местах от её начала): [from, to) заменено на inserted кодовых точек.
struct change { i64 from; i64 to; i64 inserted; }
// место до правки → место в тексте после правки (до разбора)
map_change(change ch, i64 c) => if(c >= ch.to) (c - (ch.to - ch.from)) + ch.inserted else if(c > ch.from) ch.from else c;
// Где правка в представлении: mode 0 — текст узла target; 1 — элементы [k, k + count) контейнера
// target (count 0 — место at)
struct spot { i64 mode; code target; i64 k; i64 count; i64 at; }
// Элементы контейнера в проекции: у модуля — без внутренних (они в конце).
items_of(c) {
  if(code_kind(c) == ast.block) return code_items(c);
  r = array{};
  for(x : code_items(c)) if(!is_inner(x)) r.push(x);
  r
}
// места элементов контейнера [from, from + count) в представлении w; count 0 — точка вставки at
items_range(i64 w, c, i64 from, i64 count, i64 at) {
  if(count == 0) return array{at, at};
  items = items_of(c);
  array{range_from(w, layout_of(w, items[from])), range_to(w, layout_of(w, items[(from + count) - 1]))}
}
spot_before(i64 w, spot s) {
  if(s.mode == 0) {
    k = layout_of(w, s.target);
    return array{range_from(w, k), range_to(w, k)};
  }
  items_range(w, s.target, s.k, s.count, s.at)
}
spot_after(i64 w, spot s, i64 n_new) {
  if(s.mode == 0) return spot_before(w, s);
  if(n_new > 0) return items_range(w, s.target, s.k, n_new, 0);
  // элемент удалён: место — после предыдущего или сразу за `{` блока
  at = if(s.k > 0) range_to(w, layout_of(w, items_of(s.target)[s.k - 1])) else (range_from(w, layout_of(w, s.target)) + (if(code_kind(s.target) == ast.block) 1 else 0));
  array{at, at}
}
// представления, где виден target, до правки: место правки и текст после него
struct seen_view { i64 v; i64 from; i64 to; str tail; }
apply_before(target, spot s) {
  found = array{};
  for(w : range(views.size)) if(given(views[w].root) && (layout_of(w, target) >= 0)) {
    array{f, t} = spot_before(w, s);
    found.push(seen_view{w, f, t, text_from(views[w].lay.text, byte_of(w, t))});
  }
  found
}
// База изменена (разбор единицы) — новую проекцию узла target всем представлениям всех клиентов;
// курсор каждого переносится через выравнивание текстов изменённого места.
apply_after(i64 av, target, spot s, i64 n_new, found, str edited, change ch, i64 caret, reparsed) {
  // элаборация — до раскладки: узлы, изменённые ct-кодом (и откатом его мутаций), — в той же
  // проекции, что и правка
  check_program();
  close_traces();
  changed = changed_nodes(false);
  exts = fn_extensions();
  for(b : found) {
    w = b.v;
    c = views[w].cursor;
    relayout(w);
    array{rf, rt} = spot_after(w, s, n_new);
    // было: правленый текст места + всё после него; стало: проекция с начала места
    was = edited + b.tail;
    now = text_from(views[w].lay.text, byte_of(w, rf));
    // курсор автора — сразу после введённого; чужой — сдвигается правкой; затем выравнивание с
    // канонической проекцией (пробелы ставит она)
    if(w == av) c = blank_line_end(w, rf + align(was, ch.from + caret, now));
    else if(c >= b.from) c = rf + align(was, map_change(ch, c - b.from), now);
    views[w].cursor = lesser(c, end_of(w));
    // переразобранные вне места меняют свой текст (дыра теряет значение блока): одно обновление
    // общего предка — клиент не видит промежуточной смеси
    top = target;
    for(x : reparsed) while(given(top) && (!within(x, top) && given(code_parent(top)))) top = code_parent(top);
    for(x : changed) if(layout_at(w, x) >= 0) {
      xc = node_code(x);
      while(given(top) && (!within(xc, top) && given(code_parent(top)))) top = code_parent(top);
    }
    if((code_id(top) != code_id(target)) && (layout_of(w, top) >= 0)) send_update(views[w].peer, views[w].id, top, views[w].lay);
    else {
      send_update(views[w].peer, views[w].id, target, views[w].lay);
      // &f(…) { … } печатает имя и сигнатуру цели: правка цели меняет и его проекцию
      for(e : exts) if((layout_of(w, e[0]) >= 0) && (within(e[1], target) && !within(e[0], target))) send_update(views[w].peer, views[w].id, e[0], views[w].lay);
      // переразобранные по новым правилам разбора (после правленого объявления)
      for(x : reparsed) if((layout_of(w, x) >= 0) && !within(x, target)) {
        inner = false;
        for(y : reparsed) if((code_id(y) != code_id(x)) && (within(x, y) && !within(y, target))) inner = true;
        if(!inner) send_update(views[w].peer, views[w].id, x, views[w].lay);
      }
    }
    if(w != av) close_completion(w); // чужая правка сдвинула слово
    send_cursor(w);
  }
  refresh_changed(); // представления, которых правка не касалась
  for(b : found) send_marks(b.v);
  0
}
// Правка не в черновике: сырой блок, строка набора, иначе наименьшая единица.
edit(i64 v, i64 a, i64 b, str ins, i64 caret) {
  if(edit_raw(v, a, b, ins, caret)) return 0;
  if(edit_line(v, a, b, ins, caret)) return 0;
  done = false;
  for(u : units_around(v, a, b)) if(!done) {
    old = text_of(v, u.from, u.to);
    base = byte_of(v, u.from);
    edited = (slice_text(old, 0, byte_of(v, a) - base) + ins) + text_from(old, byte_of(v, b) - base);
    s = spot{0, u.node, 0, 0, 0};
    found = apply_before(u.node, s);
    array{ok, reparsed} = unit_edit(u.node, u.kind, edited, views[v].projection);
    if(ok) {
      apply_after(v, u.node, s, 0, found, edited, change{a - u.from, b - u.from, code_points(ins)}, caret, reparsed);
      done = true;
    }
  }
  // представление функции: текст перестал быть функцией — дырой (тот же узел), пока не станет
  // снова; модуль из этой проекции не переразбирается
  if(!done && (views[v].kind == "fn")) {
    r0 = range_from(v, 0);
    old = text_of(v, r0, range_to(v, 0));
    base = byte_of(v, r0);
    edited = (slice_text(old, 0, byte_of(v, a) - base) + ins) + text_from(old, byte_of(v, b) - base);
    target = views[v].root;
    s = spot{0, target, 0, 0, 0};
    found = apply_before(target, s);
    fn_hole(target, edited);
    apply_after(v, target, s, 0, found, edited, change{a - r0, b - r0, code_points(ins)}, caret, array{});
  }
  0
}
// Сырой блок: единица правки — сам блок (§4.4). *Моё:* единица — блок вызова целиком (подблок —
// нет: его текст — часть текста блока); сломаны скобки блока — к внешней единице (строке).
edit_raw(i64 v, i64 a, i64 b, str ins, i64 caret) {
  k = layout_at(v, views[v].lay.node[a]);
  while(k >= 0) {
    fr = range_from(v, k);
    t = range_to(v, k);
    n = node_code(views[v].lay.nodes[k]);
    if(((t - fr) >= 2) && ((a >= (fr + 1)) && ((b <= (t - 1)) && raw_unit(n)))) {
      old = text_of(v, fr, t);
      base = byte_of(v, fr);
      edited = (slice_text(old, 0, byte_of(v, a) - base) + ins) + text_from(old, byte_of(v, b) - base);
      s = spot{0, n, 0, 0, 0};
      found = apply_before(n, s);
      if(!raw_edit(n, edited)) return false;
      apply_after(v, n, s, 0, found, edited, change{a - fr, b - fr, code_points(ins)}, caret, array{});
      return true;
    }
    k = views[v].lay.up[k];
  }
  false
}
// Контейнер места: наименьший блок, внутри скобок которого правка, иначе модуль.
container_of(i64 v, i64 a, i64 b) {
  r = program();
  done = false;
  for(u : units_around(v, a, b)) if(!done && (u.kind == 0)) {
    r = u.node;
    done = true;
  }
  r
}
// Место a в промежутке перед элементом k контейнера c — внутри комментария: в промежутке только
// пробелы и комментарии (§4.0), `//` — до конца строки.
in_comment(i64 v, c, i64 k, i64 a) {
  items = items_of(c);
  from = if(k > 0) range_to(v, layout_of(v, items[k - 1])) else (if(code_id(c) == code_id(program())) 0 else range_from(v, layout_of(v, c)) + 1);
  t = text_of(v, from, a);
  in_line = false;
  in_block = false;
  i = 0;
  while(i < t.size) {
    if(in_line) in_line = t[i] != '\n';
    else if(in_block) {
      if((t[i] == '*') && (((i + 1) < t.size) && (t[i + 1] == '/'))) {
        in_block = false;
        i += 1;
      }
    } else if((t[i] == '/') && (((i + 1) < t.size) && (t[i + 1] == '/'))) in_line = true;
    else if((t[i] == '/') && (((i + 1) < t.size) && (t[i + 1] == '*'))) in_block = true;
    i += 1;
  }
  in_line || in_block
}
// Строка набора (решение автора 2026-09-29): строка — как новый блок, ещё не разобранный.
// Правка внутри инструкции блока (или элемента модуля) переразбирает только её текст; набор на
// пустой строке или после `;` создаёт новый элемент на этом месте. Недописанное — дыра только этой
// строки. Сломаны скобки строки — к внешним скобкам.
edit_line(i64 v, i64 a, i64 b, str ins, i64 caret) {
  c = container_of(v, a, b);
  module_level = code_id(c) == code_id(program());
  if(module_level && (views[v].kind != "module")) return false; // заголовок функции в её представлении — через единицу-функцию
  items = items_of(c);
  // элемент, в тексте которого правка (конец включительно: набор перед `;`)
  k = 0;
  count = 0;
  stop = false;
  while((k < items.size) && !stop) {
    l = layout_of(v, items[k]);
    if(l >= 0) {
      if((a >= range_from(v, l)) && (b <= range_to(v, l))) {
        count = 1;
        stop = true;
      } else if(range_from(v, l) >= b) stop = true; // правка — в промежутке перед элементом k
    }
    if(!stop) k += 1;
  }
  blank_text = true;
  for(i : range(ins.size)) if((ins[i] != ' ') && ((ins[i] != '\n') && (ins[i] != '\t'))) blank_text = false;
  if((count == 0) && ((a != b) || blank_text)) return false; // стирание и пробелы в промежутке — через скобки
  if((count == 0) && in_comment(v, c, k, a)) return false; // набор в комментарии (§4.0) — тоже через скобки
  array{of, ot} = items_range(v, c, k, count, a);
  was = text_of(v, of, ot);
  base = byte_of(v, of);
  edited = if(count > 0) (slice_text(was, 0, byte_of(v, a) - base) + ins) + text_from(was, byte_of(v, b) - base) else ins;
  // пустые строки промежутка при вставке: выше и ниже нового элемента
  above = 0;
  below = 0;
  if(count == 0) {
    prev_end = if(k > 0) range_to(v, layout_of(v, items[k - 1])) else (if(module_level) 0 else range_from(v, layout_of(v, c)) + 1);
    next_start = if(k < items.size) range_from(v, layout_of(v, items[k])) else (if(module_level) end_of(v) else range_to(v, layout_of(v, c)) - 1);
    ld = leads(v);
    for(x : range(greater(a - prev_end, 0))) if(ld[prev_end + x] == '\n') above += 1;
    for(x : range(greater(next_start - a, 0))) if(ld[a + x] == '\n') below += 1;
  }
  s = spot{1, c, k, count, a};
  found = apply_before(c, s);
  array{ok, n_new, reparsed} = line_edit(c, k, count, edited, module_level, views[v].projection, above, below);
  if(!ok) return false;
  apply_after(v, c, s, n_new, found, edited, change{if(count > 0) a - of else 0, if(count > 0) b - of else 0, code_points(ins)}, caret, reparsed);
  true
}
// Длина кодовой точки UTF-8 с байта k.
cp_len(str s, i64 k) {
  n = 1;
  while(((k + n) < s.size) && ((s[k + n] & 192) == 128)) n += 1;
  n
}
space_byte(i64 c) => (c == ' ') || ((c == '\n') || (c == '\t'));
// Место at (в кодовых точках) текста from — в тексте to, который отличается пробелами между
// лексемами (каноническая проекция после разбора): совпадающие символы идут вместе, лишние пробелы
// с любой стороны пропускаются.
align(str from, i64 at, str to) {
  i = 0;
  j = 0;
  ci = 0;
  cj = 0;
  while((ci < at) && (i < from.size)) {
    ni = cp_len(from, i);
    nj = if(j < to.size) cp_len(to, j) else 0;
    if((nj > 0) && (space_byte(from[i]) && space_byte(to[j]))) {
      // пробельный промежуток — целиком против промежутка: курсор внутри него встаёт после стольких
      // же переводов строки (Enter в начале строки оставляет курсор на строке кода, в конце —
      // переводит на новую)
      ie = i;
      je = j;
      cie = ci;
      cje = cj;
      lines = 0;
      col = 0;
      while((ie < from.size) && space_byte(from[ie])) {
        if(cie < at) {
          col = if(from[ie] == '\n') 0 else col + 1;
          if(from[ie] == '\n') lines += 1;
        }
        ie += 1;
        cie += 1;
      }
      while((je < to.size) && space_byte(to[je])) {
        je += 1;
        cje += 1;
      }
      if(at < cie) {
        seen_lines = 0;
        while((j < je) && (seen_lines < lines)) {
          if(to[j] == '\n') seen_lines += 1;
          j += 1;
          cj += 1;
        }
        while((col > 0) && ((j < je) && (to[j] != '\n'))) {
          col -= 1;
          j += 1;
          cj += 1;
        }
        return cj;
      }
      i = ie;
      ci = cie;
      j = je;
      cj = cje;
    } else if((nj > 0) && (slice_text(from, i, i + ni) == slice_text(to, j, j + nj))) {
      i += ni;
      j += nj;
      ci += 1;
      cj += 1;
    } else if(space_byte(from[i])) {
      i += ni;
      ci += 1;
    } else if((nj > 0) && space_byte(to[j])) {
      j += nj;
      cj += 1;
    } else if((nj > 0) && (to[j] == ';')) { // `;` поставила проекция (после дыры в блоке)
      j += nj;
      cj += 1;
    } else if(from[i] == ';') { // лишняя `;` набора (`y = 2;;`) — проекция её убрала
      i += ni;
      ci += 1;
    } else { // расхождение (литерал записан иначе) — идём вместе
      i += ni;
      ci += 1;
      if(nj > 0) {
        j += nj;
        cj += 1;
      }
    }
  }
  cj
}

// --- сигналы клиента: представления --------------------------------------------------------
// открыть представление модуля программы
on_open_view() {
  p = now_peer();
  views.push(new_view(p, peer_view_count(p) + 1, program(), "module"));
  show_view_of(views.size - 1, true);
}
on_close_view(i64 id) {
  v = view_of(id);
  if(v < 0) return 0;
  finalize(v);
  views[v].root = code();
  0
}

// --- текст представления ---------------------------------------------------------------
// класс символа для слов: пробел 0, имя (и не-ASCII) 1, прочее 2
char_class(i64 c) {
  if((c == ' ') || ((c == '\n') || (c == '\t'))) return 0;
  if(((c >= 'a') && (c <= 'z')) || (((c >= 'A') && (c <= 'Z')) || (((c >= '0') && (c <= '9')) || ((c == '_') || (c >= 128))))) return 1;
  2
}
// параметр — алиас места вызывающего (§6.2): идём своей переменной
line_start(i64 v, i64 at) {
  ld = leads(v);
  k = at;
  while((k > 0) && (ld[k - 1] != '\n')) k -= 1;
  k
}
line_end(i64 v, i64 at) {
  ld = leads(v);
  k = at;
  while(((k + 1) < ld.size) && (ld[k] != '\n')) k += 1;
  k
}
word_left(i64 v, i64 at) {
  ld = leads(v);
  k = at;
  while((k > 0) && (char_class(ld[k - 1]) == 0)) k -= 1;
  if(k == 0) return 0;
  c = char_class(ld[k - 1]);
  while((k > 0) && (char_class(ld[k - 1]) == c)) k -= 1;
  k
}
word_right(i64 v, i64 at) {
  ld = leads(v);
  k = at;
  end = ld.size - 1;
  while((k < end) && (char_class(ld[k]) == 0)) k += 1;
  if(k == end) return end;
  c = char_class(ld[k]);
  while((k < end) && (char_class(ld[k]) == c)) k += 1;
  k
}
// места [from, to) — одни пробелы
blank(i64 v, i64 from, i64 to) {
  ld = leads(v);
  r = true;
  for(k : range(to - from)) if(ld[from + k] != ' ') r = false;
  r
}
spaces(i64 n) {
  s = "";
  for(k : range(n)) s = s + " ";
  s
}
lesser(i64 x, i64 y) => if(x < y) x else y;
// строка вверх (dir < 0) или вниз на lines — в колонку goal
vertical(i64 v, i64 dir, i64 lines) {
  c = cursor(v);
  ls = line_start(v, c);
  col = if(goal(v) >= 0) goal(v) else (c - ls);
  set_goal(v, col);
  for(n : range(lines)) {
    if(dir < 0) {
      if(ls == 0) return if(n == 0) 0 else lesser(ls + col, line_end(v, ls));
      ls = line_start(v, ls - 1);
    } else {
      le = line_end(v, ls);
      if((le + 1) >= places(v)) return if(n == 0) le else lesser(ls + col, le);
      ls = le + 1;
    }
  }
  lesser(ls + col, line_end(v, ls))
}
// выделение: array{начало, конец}
selection(i64 v) {
  c = cursor(v);
  an = anchor(v);
  if(an < 0) array{c, c} else if(an < c) array{an, c} else array{c, an}
}
// число кодовых точек (байты-продолжения UTF-8 — не символы)
code_points(str s) {
  n = 0;
  k = 0;
  while(k < s.size) {
    if((s[k] & 192) != 128) n += 1;
    k += 1;
  }
  n
}

// --- строки ------------------------------------------------------------------------------
// до первого байта ch (без него)
before(str s, i64 ch) {
  r = "";
  k = 0;
  while((k < s.size) && (s[k] != ch)) {
    r = r + text_byte(s[k]);
    k += 1;
  }
  r
}
ident_byte(i64 c) => ((c >= 'a') && (c <= 'z')) || (((c >= 'A') && (c <= 'Z')) || (((c >= '0') && (c <= '9')) || ((c == '_') || (c >= 128))));
digits3(i64 n) => if(n < 10) "00" + text(n) else if(n < 100) "0" + text(n) else text(n);

// --- дополнение ----------------------------------------------------------------------------
// 
// 
// 
// Контекст — путь от
// места вверх по АСТ: блок даёт объявленное до места, функция и блок конструкции — параметры,
// модуль и прелюдия — свои сущности. Список живой: 
// ничего не вставляется само —
//.
struct completion { str name; str kind; str detail; i64 depth; }

operator_name(str n) => starts_with(n, "infix") || (starts_with(n, "prefix") || starts_with(n, "postfix"));
// имя в список (повторы — после, uniq)
add_name(found, str name, str kind, str detail, i64 depth) {
  if((name == "") || operator_name(name)) return false;
  found.push(completion{name, kind, detail, depth});
  true
}
// ближнее объявление скрывает дальнее (найдено раньше — ближе); функция того же уровня —
// «перегрузки». Порядок — по имени, затем по порядку находки (сортировка устойчивая): один проход
uniq(found) {
  keys = array{};
  for(x : found) keys.push(x.name);
  kept = array{};
  for(k : sorted_indices(keys)) {
    x = found[k];
    n = kept.size;
    if((n > 0) && (kept[n - 1].name == x.name)) {
      y = kept[n - 1];
      if((y.kind == "функция") && ((x.kind == "функция") && (y.depth == x.depth))) kept[n - 1] = completion{y.name, y.kind, "перегрузки", y.depth};
    } else kept.push(x);
  }
  kept
}
param_list(ps, i64 from) {
  r = "(";
  for(k : range(ps.size)) if(k >= from) {
    ast.parameter{pname, _, _, _, _, _, _} = ps[k];
    r = (r + (if(k > from) ", " else "")) + pname;
  }
  r + ")"
}
entities(found, m, i64 depth) {
  if(!given(m) || (code_kind(m) != ast.module)) return false;
  for(item : code_items(m)) if(!is_record(item)) {
    kind = code_kind(item);
    if(kind == ast.function) {
      ast.function{name, ps, _, _, _, _, _, _, _} = item;
      add_name(found, name, "функция", param_list(ps, 0), depth);
    } else if(kind == ast.extension) {
      ast.extension{name, _, _, _, of, _} = item;
      if(of == "struct") add_name(found, name, "тип", "struct", depth);
    } else if(kind == ast.variable) {
      ast.variable{name, _, _, _, _, _, _, _} = item;
      add_name(found, name, "переменная", "модуль", depth);
    }
  }
  true
}
// сущности модулей прямых use модуля m (выборочный use k.{a, b} — только названные, §9.1)
use_entities(found, m, i64 depth) {
  for(u : code_items(m)) if(code_kind(u) == ast.use) {
    ast.use{key, names} = u;
    um = module_of_key(key);
    if(given(um)) {
      xs = array{};
      entities(xs, um, depth);
      for(x : xs) {
        ok = names.size == 0;
        for(nm : names) if(nm == x.name) ok = true;
        if(ok) found.push(completion{x.name, x.kind, with_note(x.detail, "модуль " + key), x.depth});
      }
    }
  }
  0
}
// модуль по пути перед точкой (geo.vec. — его сущности); нет — пустой код
module_before(i64 v, i64 dot) {
  k = dot;
  while((k > 0) && (ident_byte(lead(v, k - 1)) || (lead(v, k - 1) == '.'))) k -= 1;
  path = text_of(v, k, dot);
  if(path == "") code() else module_of_key(path)
}
// x = e объявляет, если имени ещё нет (решение автора: без auto); имя — или ""
assigned_name(s) {
  r = "";
  if(code_kind(s) == ast.operation) {
    ast.operation{op, xs, _} = s;
    if((op == "=") && ((xs.size > 0) && (code_kind(xs[0]) == ast.name))) {
      ast.name{nm} = xs[0];
      r = nm;
    }
  }
  r
}
// идентификаторы, видимые в месте at
context_names(at) {
  found = array{};
  depth = 0;
  child = at;
  n = at;
  while(given(n)) {
    kind = code_kind(n);
    if(kind == ast.block) {
      stop = false;
      for(s : code_items(n)) if(!stop) {
        if(code_id(s) == code_id(child)) stop = true; // объявленное после места не видно
        else {
          if(code_kind(s) == ast.variable) {
            ast.variable{vn, _, _, _, _, _, _, _} = s;
            add_name(found, vn, "переменная", "", depth);
          }
          add_name(found, assigned_name(s), "переменная", "", depth);
        }
      }
    } else if(kind == ast.function) {
      ast.function{_, ps, _, _, _, _, _, _, _} = n;
      for(p : ps) {
        ast.parameter{pn, _, _, _, _, _, _} = p;
        add_name(found, pn, "параметр", "", depth);
      }
    } else if(kind == ast.lambda) {
      ast.lambda{ps, _, _} = n;
      for(p : ps) {
        ast.parameter{pn, _, _, _, _, _, _} = p;
        add_name(found, pn, "параметр", "блок конструкции", depth);
      }
    } else if(kind == ast.module) {
      entities(found, n, depth);
      use_entities(found, n, depth + 1);
    }
    child = n;
    n = code_parent(n);
    depth += 1;
  }
  uniq(found)
}
// Прелюдия и функции VM — дальше любого места программы (глубина 900): не меняются — без повторов и
// в нижнем регистре один раз.: что не
// меняется, не считается заново — запомнено в состоянии сервиса: имена, нижний регистр, хвост ключа
// порядка (глубина, имя).
outer_known = false;
outer_found = array{};
outer_low = array{};
outer_tail = array{};
outer_ready() {
  if(outer_known) return 0;
  found = array{};
  entities(found, prelude(), 900);
  for(b : vm_builtins()) add_name(found, b[0], "функция", b[1] + " — VM", 901);
  outer_found = uniq(found);
  for(x : outer_found) {
    outer_low.push(lower(x.name));
    outer_tail.push(digits3(x.depth) + x.name);
  }
  outer_known = true;
  0
}
// Подошедшие к слову (нижний регистр) имена прелюдии и VM — их номера. Слово выросло из прежнего —
// подходящие к нему среди подходивших к прежнему (префикс, подстрока и подпоследовательность
// сохраняются у начала слова).
outer_word = "";
outer_hits = array{};
// имя в список членов: без повторов
add_member(found, str name, str kind, str detail, i64 depth) {
  for(x : found) if(x.name == name) return false;
  found.push(completion{name, kind, detail, depth});
  true
}
type_text(t) => if(given(t) && (code_kind(t) == ast.name)) {
  ast.name{nm} = t;
  nm
} else "";
// Члены значения после `.` для его типов 
// поля агрегата, размер массива и строки, функции из всех
// расширений сущности — 
// функции через точку — a.f(b) ≡ f(a, b) (§4.5).
member_names(types) {
  found = array{};
  for(t : types) {
    base = before(t, '<');
    if((base == "array") || (base == type_tag(4))) add_member(found, "size", "поле", (type_tag(2) + " — ") + t, 0);
    for(part : record_parts(t)) add_member(found, part[0], "поле", (part[1] + " — ") + t, 0);
    for(m : array{program(), prelude()}) if(given(m)) for(n : code_items(m)) if(code_kind(n) == ast.extension) {
      ast.extension{en, xs, _, _, _, _} = n;
      if(en == base) for(x : xs) {
        if(code_kind(x) == ast.variable) {
          ast.variable{fname, ft, _, _, _, _, _, _} = x;
          add_member(found, fname, "поле", (type_text(ft) + " — ") + t, 0);
        }
        if(code_kind(x) == ast.function) {
          ast.function{fname, ps, _, _, _, _, _, _, _} = x;
          if(ps.size > 0) add_member(found, fname, "функция", param_list(ps, 1), 0);
        }
      }
    }
  }
  dot_functions(found, types);
  found
}
// Функции, вызываемые через точку: первый параметр в каком-то экземпляре получал этот тип или
// явно им типизирован; не инстанцированная с этим типом — не предлагается.
dot_functions(found, types) {
  prog = program();
  for(m : array{prog, prelude()}) if(given(m)) for(item : code_items(m)) if((code_kind(item) == ast.function) && !is_record(item)) {
    ast.function{name, ps, _, _, _, _, _, _, _} = item;
    if((ps.size > 0) && !operator_name(name)) {
      ast.parameter{_, pt, _, _, _, _, _} = ps[0];
      fits = false;
      if(given(pt) && (code_kind(pt) == ast.name)) {
        want = type_text(pt);
        for(t : types) if(before(t, '<') == want) fits = true;
      } else {
        seen = param_types(item, 0);
        for(t : types) for(x : seen) if(x == t) fits = true;
      }
      if(fits && !construction(item)) { // конструкция — синтаксис, не вызов через точку
        fresh = true;
        for(x : found) if(x.name == name) fresh = false;
        if(fresh) found.push(completion{name, "функция", param_list(ps, 1), if(code_id(m) == code_id(prog)) 1 else 2});
      }
    }
  }
  true
}
// Живой фильтр: префикс, затем подстрока, затем подпоследовательность (без учёта регистра); при
// равенстве — ближнее, затем по имени. Пустое слово — всё (до 400: «всё видимое» доходит до
// встроенных VM).
rank(str n, str w) {
  at = find_text(n, w);
  if(at == 0) 0 else if(at > 0) 1 else if(subsequence(n, w)) 2 else -1
}
// узлы АСТ (struct программы, порождены из VM) — только по набранному префиксу: они нужны
// коду, который работает с кодом, остальным — шум (*моё*)
shown(x, str n, str w) => !((x.kind == "тип") && (core_node_kind(x.name) && ((w.size == 0) || (find_text(n, w) != 0))));
// подходящие: kept — варианты, keys — порядок (ранг, глубина, имя: tail — глубина и имя)
take(kept, keys, x, str n, str w, str tail) {
  r = rank(n, w);
  if((r >= 0) && shown(x, n, w)) {
    kept.push(x);
    keys.push(text(r) + tail);
  }
  r >= 0
}
// near — имена места (ближе); far — и прелюдия с VM; одноимённое дальнее скрыто ближним
filtered(near, bool far, str word) {
  w = lower(word);
  kept = array{};
  keys = array{};
  for(x : near) take(kept, keys, x, lower(x.name), w, digits3(x.depth) + x.name);
  if(far) {
    outer_ready();
    hits = array{};
    if((outer_word != "") && starts_with(w, outer_word)) {
      for(k : outer_hits) if(take(kept, keys, outer_found[k], outer_low[k], w, outer_tail[k])) hits.push(k);
    } else for(k : range(outer_found.size)) if(take(kept, keys, outer_found[k], outer_low[k], w, outer_tail[k])) hits.push(k);
    outer_word = w;
    outer_hits = hits;
  }
  // повторы имён среди подошедших: остаётся ближний (по имени, затем по глубине; сортировка
  // устойчивая — при равных по порядку находки)
  by_name = array{};
  for(x : kept) by_name.push((x.name + "\n") + digits3(x.depth));
  hidden = array{};
  for(k : range(kept.size)) hidden.push(false);
  last = "";
  first = true;
  for(k : sorted_indices(by_name)) {
    if(!first && (kept[k].name == last)) hidden[k] = true;
    last = kept[k].name;
    first = false;
  }
  found = array{};
  for(k : sorted_indices(keys)) if(!hidden[k] && (found.size < 400)) found.push(kept[k]);
  found
}
// Живое дополнение по слову перед курсором; forced (Ctrl+Space) — и без слова.
complete(i64 v, bool forced) {
  c = cursor(v);
  b = c;
  ld = leads(v);
  while((b > 0) && ident_byte(ld[b - 1])) b -= 1;
  word = text_of(v, b, c);
  number = (word.size > 0) && ((word[0] >= '0') && (word[0] <= '9'));
  at = place_node(v, if(b < c) b else if(c > 0) c - 1 else c);
  if(number || (given(at) && (code_kind(at) == ast.string))) return close_completion(v);
  // после `.` — члены значения слева (по его типам во всех экземплярах); список — сразу на точке
  dot = (b > 0) && (lead(v, b - 1) == '.');
  if(!dot && (!forced && (word.size == 0))) return close_completion(v);
  pm = if(dot) module_before(v, b - 1) else code(); // geo.vec. — сущности модуля (имя названо путём)
  types = if(dot && !given(pm)) object_types(v, b - 1) else array{};
  if(dot && (!given(pm) && (types.size == 0))) return close_completion(v);
  near = array{};
  if(given(pm)) entities(near, pm, 0) else near = if(dot) member_names(types) else context_names(at);
  items = filtered(near, !dot, word);
  // единственный вариант, совпадающий с набранным, — показывать нечего
  if((items.size == 0) || ((items.size == 1) && (items[0].name == word))) return close_completion(v);
  show_completion(v, items, b);
}

// --- подсказки: наведение, форма конструкции, сигнатура -----------------------------------
// 
// подсказка — строки из АСТ и
// разбора (тип по всем экземплярам, значение в слое, ошибка, объявления со ссылками), а не
// текст. *Моё:* состав строк.
struct line { str kind; str text; code node; i64 from; i64 to; }

// Функции прелюдии по имени: не меняются — указатель строится один раз (имена по возрастанию,
// сортировка устойчивая — одноимённые в порядке объявления), имя — двоичным поиском
prelude_fns = array{};
prelude_fn_names = array{};
prelude_fn_order = array{};
prelude_indexed = false;
prelude_declarations(str name) {
  if(!prelude_indexed) {
    names = array{};
    for(f : code_items(prelude())) if(code_kind(f) == ast.function) {
      ast.function{fname, _, _, _, _, _, _, _, _} = f;
      prelude_fns.push(f);
      names.push(fname);
    }
    for(k : sorted_indices(names)) {
      prelude_fn_names.push(names[k]);
      prelude_fn_order.push(k);
    }
    prelude_indexed = true;
  }
  found = array{};
  k = lower_bound(prelude_fn_names, name);
  while((k < prelude_fn_names.size) && (prelude_fn_names[k] == name)) {
    found.push(prelude_fns[prelude_fn_order[k]]);
    k += 1;
  }
  found
}
// Объявления имени, видимые в месте at: функции его модуля (с внутренними), модулей его прямых use
// (use не транзитивен, выборочный use k.{a, b} — только названные; §9.1) и прелюдии; имя названо
// путём (geo.vec.norm) — только того модуля. 
//;.
declarations(str name, at) {
  found = array{};
  qm = qualified_module(at);
  if(given(qm)) {
    functions_in(found, qm, name);
    return found;
  }
  m = place_module(at);
  functions_in(found, m, name);
  for(u : used_modules(m, name)) functions_in(found, u, name);
  for(f : prelude_declarations(name)) found.push(f);
  found
}
place_module(at) => if(given(at)) code_module(at) else program();
functions_in(found, m, str name) {
  if(!given(m)) return 0;
  for(f : code_items(m)) if(code_kind(f) == ast.function) {
    ast.function{fname, _, _, _, _, _, _, _, _} = f;
    if(fname == name) found.push(f);
  }
  0
}
// модули прямых use модуля m, которые дают имя name ("" — любое)
used_modules(m, str name) {
  r = array{};
  if(!given(m) || (code_kind(m) != ast.module)) return r;
  for(u : code_items(m)) if(code_kind(u) == ast.use) {
    ast.use{key, names} = u;
    gives = (name == "") || (names.size == 0);
    for(x : names) if(x == name) gives = true;
    if(gives) {
      um = module_of_key(key);
      if(given(um)) r.push(um);
    }
  }
  r
}
// путь из имён (geo.vec) — модуль; иначе пустой код
module_path(c) {
  if(!given(c)) return "";
  if(code_kind(c) == ast.name) return name_of(c);
  inner = if(member_name(c) != "") module_path(member_object(c)) else "";
  if(inner == "") "" else (inner + ".") + member_name(c)
}
// a.f, где a — путь модуля (geo.vec.norm): модуль; иначе пустой код
qualified_module(c) {
  if(!given(c) || (member_name(c) == "")) return code();
  path = module_path(member_object(c));
  if(path == "") code() else module_of_key(path)
}
// модуль, где объявлено (не модуль программы — подпись в списках)
module_note(f) {
  m = code_module(f);
  if(!given(m) || in_prelude(f) || (code_id(m) == code_id(program()))) return "";
  "модуль " + code_name(m)
}
// выбранные разбором — первыми (порядок прочих — как был)
chosen_first(fns, chosen) {
  r = array{};
  for(f : fns) if(has_code(chosen, f)) r.push(f);
  for(f : fns) if(!has_code(chosen, f)) r.push(f);
  r
}
declaration_lines(lines, str name, chosen, place) {
  n = 0;
  for(f : chosen_first(declarations(name, place), chosen)) if(n < 8) {
    n += 1;
    here = has_code(chosen, f);
    at = if(here) "выбрана здесь" else if(in_prelude(f)) "прелюдия" else if(is_inner(f)) "внутренняя" else "";
    if(module_note(f) != "") at = with_note(at, module_note(f));
    lines.push(line{if(construction(f)) "форма" else "объявление", head_text(f) + (if(at == "") "" else "  — " + at), f, 0, 0});
    for(l : note_lead(f)) if(l != "") lines.push(line{"комментарий", l, code(), 0, 0});
  }
  true
}
callee_of(c) => if(given(c) && (code_kind(c) == ast.call)) {
  ast.call{f, _, _, _, _, _, _} = c;
  f
} else code();
name_of(c) => if(given(c) && (code_kind(c) == ast.name)) {
  ast.name{nm} = c;
  nm
} else "";
on_hover(i64 id, n) {
  v = view_of(id);
  if(v < 0) no_view(id) else hover_at(v, n)
}
// наведение на узел n
hover_at(i64 v, n) {
  lines = array{};
  if(given(n)) {
    k = code_kind(n);
    if(k == ast.hole) {
      ast.hole{_, reason} = n;
      lines.push(line{"дыра", reason, code(), 0, 0});
    }
    // тип: у имени-объявления — по всем его упоминаниям, иначе — узла
    up = code_parent(n);
    ts = "";
    if(k == ast.parameter) {
      ast.parameter{pn, _, _, _, _, _, _} = n;
      ts = shown_name(n, pn);
    } else if(k == ast.variable) {
      ast.variable{vn, _, init, _, _, _, _, _} = n;
      ts = if(given(init)) shown_node(init) else shown_name(n, vn);
    } else if(has_types(n)) ts = shown_node(n);
    else if(k == ast.name) ts = shown_name(n, name_of(n));
    called = given(callee_of(up)) && (code_id(callee_of(up)) == code_id(n));
    if((ts != "") && !called) lines.push(line{"тип", ts, code(), 0, 0});
    lit = layer_literal(v, n);
    if(lit != "") lines.push(line{"значение", lit, code(), 0, 0});
    for(e : error_texts(v, n)) lines.push(line{"ошибка", e, code(), 0, 0});
    // имя функции или конструкции — объявления со ссылками (выбранные в экземплярах — первыми)
    name = "";
    if(k == ast.function) {
      ast.function{fname, _, _, _, _, _, _, _, _} = n;
      name = fname;
    } else if(k == ast.name) name = name_of(n);
    else if((member_name(n) != "") && (given(up) && (code_kind(up) == ast.call))) name = member_name(n);
    else if(k == ast.call) name = name_of(callee_of(n));
    if(name != "") {
      call = if(k == ast.call) n else if(called) up else code();
      declaration_lines(lines, name, if(given(call)) call_targets(call) else array{}, if((k == ast.call) && given(callee_of(n))) callee_of(n) else n);
    }
  }
  show_hover(v, n, lines);
}
// строка сигнатуры: текущий параметр arg — [from, to) в кодовых точках
signature_line(f, str name, i64 arg) {
  ast.function{_, ps, _, _, _, _, _, _, _} = f;
  s = name + "(";
  from = 0;
  to = 0;
  head = 0;
  stop = false;
  for(p : ps) if(!stop) {
    ast.parameter{pn, pt, _, pack, clause, _, _} = p;
    if(clause != "") stop = true; // клаузы — после головы
    else {
      if(head > 0) s = s + ", ";
      one = if(given(pt) && (code_kind(pt) == ast.name)) type_text(pt) + " " else "";
      if(param_mode(p) == "expr") one = "expr " + one;
      one = one + pn;
      if((head == arg) || (pack && (arg >= head))) {
        from = code_points(s);
        to = from + code_points(one);
      }
      s = s + one;
      head += 1;
    }
  }
  line{"сигнатура", s + ")", f, from, to}
}
// Подсказка набора: курсор внутри скобок вызова — сигнатуры с текущим параметром; слово перед
// курсором — имя конструкции — её форма. Иначе — скрыть.
send_hint(i64 v) {
  lines = array{};
  anchor = -1;
  c = cursor(v);
  b = c;
  ld = leads(v);
  while((b > 0) && ident_byte(ld[b - 1])) b -= 1;
  word = text_of(v, b, c);
  if((word.size > 0) && !((c < ld.size) && ident_byte(ld[c]))) {
    for(f : declarations(word, place_node(v, b))) if(construction(f) && (lines.size < 6)) lines.push(line{"форма", head_text(f), f, 0, 0});
    if(lines.size > 0) anchor = b;
  }
  // вызов вокруг курсора: скобки его аргументов
  n = if((lines.size == 0) && (c > 0)) place_node(v, c - 1) else code();
  done = false;
  while(given(n) && !done) {
    callee = callee_of(n);
    if(given(callee) && (code_kind(callee) == ast.name)) {
      k = layout_of(v, n);
      ck = layout_of(v, callee);
      if((k < 0) || (ck < 0)) done = true;
      else {
        open = range_to(v, ck); // `(` сразу после имени
        if((open < ld.size) && ((ld[open] == '(') && ((c > open) && (c < range_to(v, k))))) { // после `)` — уже не в скобках
          ast.call{_, args, _, _, _, _, _} = n;
          arg = 0; // текущий параметр — по аргументам, кончившимся до курсора
          for(x : args) {
            ak = layout_of(v, x);
            if((ak >= 0) && (range_to(v, ak) < c)) {
              q = range_to(v, ak);
              if(ld[lesser(q, ld.size - 1)] == ',') arg += 1;
              else {
                while((q < c) && (ld[q] == ' ')) q += 1;
                if((q < c) && (ld[q] == ',')) arg += 1;
              }
            }
          }
          name = if(member_name(callee) != "") member_name(callee) else name_of(callee);
          for(f : chosen_first(declarations(name, callee), call_targets(n))) if(lines.size < 6) lines.push(signature_line(f, name, arg));
          if(lines.size > 0) anchor = range_from(v, ck);
          done = true;
        }
      }
    }
    if(!done) n = code_parent(n);
  }
  if((lines.size == 0) && !hint_shown(v)) return 0;
  show_hint(v, anchor, lines);
}

// --- инспектор АСТ: что чем является и кем разобрано -----------------------------------
// 
// 
// *Моё:* дерево элемента модуля с местами в
// родителе (поле узла и параметр записи или конструкции), кем разобран узел, раскрытие фокуса.
struct inode { code node; i64 depth; str role; str kind; str text; str rule; code rule_at; str types; }
// правило узла: запись syntax или конструкция, которую он вызывает; места детей — её параметры
// (array{ребёнок, параметр}); нет правила — decl пустой
struct rule { code decl; str what; array places; }

// короткий свой текст узла: имя, литерал, оператор, причина дыры
own_text(n) {
  k = code_kind(n);
  if((k == ast.name) || ((k == ast.function) || ((k == ast.parameter) || (k == ast.variable)))) return code_name(n);
  if(k == ast.operation) {
    ast.operation{op, _, _} = n;
    return op;
  }
  if((k == ast.int) || ((k == ast.float) || (k == ast.string))) return clip(print_node(n), 40);
  if(k == ast.hole) {
    ast.hole{t, _} = n;
    return clip(t, 40);
  }
  if(k == ast.raw) {
    ast.raw{_, _, t, _, _} = n;
    return clip(t, 40);
  }
  ""
}
rule_for(n) {
  rec = record_rule(n);
  if(rec.size == 2) return rule{rec[0], "запись", rec[1]};
  callee = callee_of(n);
  if(!given(callee) || (code_kind(callee) != ast.name)) return rule{code(), "", array{}};
  ast.call{_, args, words, _, _, _, _} = n;
  for(f : chosen_first(declarations(name_of(callee), callee), call_targets(n))) if(construction(f)) {
    ast.function{_, ps, _, _, _, _, _, _, _} = f;
    // аргументы — параметрам по порядку внутри головы и каждой клаузы
    clauses = array{};
    used = array{};
    places = array{};
    for(i : range(args.size)) {
      w = if(i < words.size) words[i] else "";
      u = -1;
      for(j : range(clauses.size)) if(clauses[j] == w) u = j;
      if(u < 0) {
        clauses.push(w);
        used.push(0);
        u = clauses.size - 1;
      }
      seen = 0;
      matched = false;
      for(pa : ps) if(!matched) {
        ast.parameter{pn, _, _, pack, clause, _, _} = pa;
        if(clause == w) {
          skip = (seen < used[u]) && !pack;
          seen += 1;
          if(!skip) {
            places.push(array{args[i], if(w != "") (w + ": ") + pn else pn});
            if(!pack) used[u] = used[u] + 1;
            matched = true;
          }
        }
      }
    }
    return rule{f, "конструкция", places};
  }
  rule{code(), "", array{}}
}
place_of(r, c) {
  p = "";
  for(x : r.places) if(code_id(x[0]) == code_id(c)) p = x[1];
  p
}
inspect_tree(found, n, i64 depth, str role) {
  if(found.size >= 2000) return false;
  r = rule_for(n);
  rw = rewritten_by(n);
  text_rule = "";
  at = code();
  if(given(rw) && (code_kind(rw) == ast.function)) {
    text_rule = "переписан " + head_text(rw);
    at = rw;
  } else if(given(rw)) {
    text_rule = "изменён ct-кодом";
    at = rw;
  } else if(given(r.decl)) {
    text_rule = (r.what + " ") + head_text(r.decl);
    at = r.decl;
  } else if(code_kind(n) == ast.call) { // вызов функции — выбранная в экземплярах перегрузка
    ts = call_targets(n);
    if(ts.size > 0) {
      text_rule = "вызов " + head_text(ts[0]);
      at = ts[0];
    }
  }
  found.push(inode{n, depth, role, text(code_kind(n)), own_text(n), text_rule, at, shown_node(n)});
  for(cr : child_roles(n)) {
    p = place_of(r, cr[0]);
    inspect_tree(found, cr[0], depth + 1, if((p == "") || (p == cr[1])) cr[1] else (cr[1] + " → ") + p);
  }
  true
}
// Инспектор узла focus: дерево его элемента модуля и раскрытие фокуса (или ближайшего выше узла
// с правилом)
on_inspect(i64 id, focus) {
  v = view_of(id);
  if(v < 0) no_view(id) else inspect_at(v, focus)
}
inspect_at(i64 v, focus) {
  if(!given(focus)) return show_inspect(v, code(), code(), array{}, array{});
  // корень — элемент модуля (в представлении функции — она)
  top = view_root(v);
  root = focus;
  while(given(code_parent(root)) && ((code_id(root) != code_id(top)) && (code_kind(code_parent(root)) != ast.module))) root = code_parent(root);
  found = array{};
  inspect_tree(found, root, 0, "");
  expand = array{};
  n = focus;
  done = false;
  while(given(n) && !done) {
    r = rule_for(n);
    if(given(r.decl)) {
      expand.push(line{r.what, head_text(r.decl), r.decl, 0, 0});
      names = array{};
      args = array{};
      for(cr : child_roles(n)) {
        p = place_of(r, cr[0]);
        if(p != "") {
          expand.push(line{"параметр", (p + " = ") + print_node(cr[0]), cr[0], 0, 0});
          colon = find_text(p, ": ");
          names.push(if(colon >= 0) text_from(p, colon + 2) else p);
          args.push(cr[0]);
        }
      }
      if(r.what == "запись") { // итог — узел с полями
        parts = ""; // не fields: свободное имя тела вызванной — у вызывающего (O4), child_roles зовёт fields(…)
        for(cr : child_roles(n)) parts = (((parts + (if(parts == "") "" else ", ")) + cr[1]) + ": ") + print_node(cr[0]);
        expand.push(line{"итог", ((text(code_kind(n)) + "{") + parts) + "}", code(), 0, 0});
      } else {
        ast.function{_, _, _, body, _, _, _, _, _} = r.decl;
        if(given(body)) expand.push(line{"раскрытие", print_with_args(body, names, args), code(), 0, 0}); // тело с подставленными аргументами
      }
      done = true;
    } else if(code_id(n) == code_id(root)) done = true;
    else n = code_parent(n);
  }
  show_inspect(v, root, focus, found, expand);
}

// --- факты разбора — показ: тип, голова объявления, роли детей, ошибки на узлах -------------
// 
// У VM — факты (типы и значения узла по экземплярам,
// раскладка печати, поля узла, ошибки проверки и места узлов); что и как показать — здесь: 
//.

// Тип — две части: рантайм и компилтайм: «i64 = 3», «f64 = 1.5 | i64 = 2»,
// «i64 = 1 | 4». Значение рантайма хоть в одном экземпляре этого типа (или значений больше четырёх)
// — только тип. Значений нет — типы узлов по имени.
shown_facts(ns) {
  groups = node_values(ns, 4);
  if(groups.size == 0) return join_types(types_of_nodes(ns));
  r = "";
  for(g : groups) {
    array{t, lits} = g;
    one = t;
    if(!has_text(lits, "") && (lits.size <= 4)) {
      v = "";
      for(j : sorted_indices(lits)) v = (v + (if(v == "") "" else " | ")) + lits[j];
      one = (one + " = ") + v;
    }
    r = (r + (if(r == "") "" else " | ")) + one;
  }
  r
}
// типы узлов ns (по всем экземплярам), без повторов
types_of_nodes(ns) {
  ts = array{};
  for(n : ns) for(t : node_types(n)) if(!has_text(ts, t)) ts.push(t);
  ts
}
// Узлы фактов имени в области: все его упоминания в поддереве (без вложенных функций) и
// инициализаторы `name = e`, `T name = e`.
name_nodes(n, str name, found) {
  k = code_kind(n);
  if(k == ast.name) {
    ast.name{nm} = n;
    if(nm == name) found.push(n);
  } else if(k == ast.operation) {
    ast.operation{op, xs, _} = n;
    if((op == "=") && ((xs.size == 2) && (name_of(xs[0]) == name))) found.push(xs[1]);
  } else if(k == ast.variable) {
    ast.variable{vn, _, init, _, _, _, _, _} = n;
    if((vn == name) && given(init)) found.push(init);
  }
  for(c : code_items(n)) if(code_kind(c) != ast.function) name_nodes(c, name, found);
  true
}
// область имени: ближайшая функция или блок конструкции (лямбда) вверх; нет — программа
scope_of(n) {
  x = code_parent(n);
  while(given(x) && ((code_kind(x) != ast.function) && (code_kind(x) != ast.lambda))) x = code_parent(x);
  if(given(x)) x else program()
}
// узлы имени name в области узла n
name_nodes_at(n, str name) {
  ns = array{};
  name_nodes(scope_of(n), name, ns);
  ns
}
// типы (и значения) узла и имени в области узла n — по всем экземплярам; пусто — неизвестно
shown_node(n) => shown_facts(array{n});
shown_name(n, str name) => shown_facts(name_nodes_at(n, name));
// типы имени в области узла n (все его упоминания)
name_types(n, str name) => types_of_nodes(name_nodes_at(n, name));
// типы параметра k функции f по всем её экземплярам (его упоминания в теле); наблюдения в теле есть
// только у исполнявшейся при проверке — у неё есть слои (экземпляры), прочие тело не обходят
param_types(f, i64 k) {
  ns = array{};
  if(given(f) && ((code_kind(f) == ast.function) && (fn_layers(f).size > 0))) {
    ast.function{_, ps, _, _, _, _, _, _, _} = f;
    if(k < ps.size) name_nodes(f, code_name(ps[k]), ns);
  }
  types_of_nodes(ns)
}

// Голова объявления — проекция без тела: `when(c, expr yes) otherwise(expr no)`,
// `syntax if (c) {then_} else {else_}`. Раскладка печати — у VM; голова — куски до тела.
head_text(f) {
  lay = print_view(f, false, code(), -1, -1, -1, -1);
  ast.function{_, _, _, body, _, _, _, _, _} = f;
  b = code_id(body);
  out = "";
  ks = array{0}; // стек обхода: номер раскладки и его следующий кусок; top — вершина
  ps = array{0};
  top = 0;
  stop = (lay.nodes.size == 0);
  while(!stop && (top >= 0)) {
    k = ks[top];
    p = ps[top];
    if(p >= lay.count[k]) top -= 1;
    else {
      ps[top] = p + 1;
      j = lay.first[k] + p;
      c = lay.pchild[j];
      if(c < 0) out = out + slice_text(lay.ptext, lay.pbyte[j], lay.pbyte[j + 1]);
      else if(c == b) stop = true;
      else {
        kc = index_in(lay.sorted, lay.order, c);
        if(kc >= 0) {
          top += 1;
          if(top < ks.size) {
            ks[top] = kc;
            ps[top] = 0;
          } else {
            ks.push(kc);
            ps.push(0);
          }
        }
      }
    }
  }
  while((out.size > 0) && ((out[out.size - 1] == ' ') || ((out[out.size - 1] == '=') || (out[out.size - 1] == '>')))) out = slice_text(out, 0, out.size - 1);
  out
}

// конструкция: запись syntax или параметр-блок, выражение, клауза (for, while, try) — синтаксис,
// не вызов через точку
construction(c) {
  if(!given(c) || (code_kind(c) != ast.function)) return false;
  ast.function{_, ps, _, _, _, _, _, _, form} = c;
  r = (form.size > 0);
  for(p : ps) {
    ast.parameter{_, _, _, _, clause, _, _} = p;
    if((clause != "") || (param_mode(p) == "expr")) r = true;
  }
  r
}

// Дети узла с именами полей — вид узла struct программы (`fields`), поля — `code_fields`:
// array{узел, "cond" | "args[1]"}
child_roles(n) {
  out = array{};
  fs = fields(code_kind(n));
  k = 0;
  for(x : code_fields(n)) {
    if(typeof(x) == code) {
      if(given(x)) out.push(array{x, fs[k].name});
    } else {
      xs = codes_of(x);
      for(j : range(xs.size)) if(given(xs[j])) out.push(array{xs[j], ((fs[k].name + "[") + text(j)) + "]"});
    }
    k += 1;
  }
  out
}
// поле-список узлов (иначе — пусто)
codes_of(array xs) {
  out = array{};
  for(e : xs) if(typeof(e) == code) out.push(e);
  out
}
codes_of(x) => array{};

// Ошибки проверки на узлах ns (номера раскладки представления; место в прелюдии — первое место
// программы из трейса): array{узел, текст, from, to}
errors_on(ns) {
  out = array{};
  if(check_errors() == 0) return out;
  array{srcs, froms, tos} = node_spans(ns);
  for(k : range(check_errors())) {
    w = check_error_place(k, -1);
    n = node_at(ns, srcs, froms, tos, w);
    t = check_error_text(k, -1);
    for(j : range(check_error_frames(k))) {
      if(n < 0) n = node_at(ns, srcs, froms, tos, check_error_place(k, j));
      t = (t + "\n  ") + check_error_text(k, j);
    }
    if(n >= 0) {
      c = node_code(n);
      r = raw_range(c, w);
      out.push(array{c, t, r[0], r[1]});
    }
  }
  out
}
// узел из ns, в тексте которого лежит место w (наименьший); -1 — нет
node_at(ns, srcs, froms, tos, w) {
  array{ws, wb, we} = w;
  best = -1;
  size = 0;
  for(k : range(ns.size)) if((srcs[k] == ws) && ((froms[k] <= wb) && (we <= tos[k]))) if((best < 0) || ((tos[k] - froms[k]) < size)) {
    best = ns[k];
    size = tos[k] - froms[k];
  }
  best
}
// Место ошибки внутри сырого блока (§4.4): его проекция — текст как написан, позиции атомов — в
// этом тексте, поэтому метка указывает кусок блока — атом и смещение в нём 
// *Моё:* узел метки — блок (единица проекции и правки),
// место — кодовые точки [from, to) его текста; {0, 0} — весь узел.
raw_range(c, w) {
  if(code_kind(c) != ast.raw) return array{0, 0};
  ast.raw{_, _, t, _, _} = c;
  array{ss, sb, se} = node_spans(array{code_id(c)});
  array{ws, wb, we} = w;
  b = sb[0];
  if((ws != ss[0]) || ((wb < b) || ((we < wb) || ((we - b) > t.size)))) return array{0, 0};
  if((wb == b) && ((we - b) == t.size)) return array{0, 0};
  from = code_points(slice_text(t, 0, wb - b));
  to = code_points(slice_text(t, 0, we - b));
  array{from, if(to > from) to else from + 1}
}

// --- метки проверки: типы и ошибки на месте ---------------------------------------------
// После каждой ревизии — реактивный check сессии (пересчитываются только затронутые экземпляры,
// §10.1); типы узла — по всем контекстам экземпляров. Как в KDevelop: 
// ошибка — в месте использования с трейсом (§13.4).
struct mark { code node; str kind; str text; i64 from; i64 to; }

// типы по имени: порядок контекстов — хэши; показываем по имени
join_types(ts) {
  r = "";
  for(k : sorted_indices(ts)) r = (r + (if(r == "") "" else " | ")) + ts[k];
  r
}
// x = e: левая часть, если имя ("" — нет)
assign_target(n) => if(code_kind(n) == ast.operation) {
  ast.operation{op, xs, _} = n;
  if((op == "=") && ((xs.size == 2) && (code_kind(xs[0]) == ast.name))) xs[0] else code()
} else code();
type_marks(found, i64 v) {
  for(n : view_nodes(v)) {
    k = code_kind(n);
    if(k == ast.parameter) {
      ts = shown_name(n, code_name(n));
      if(ts != "") found.push(mark{n, "type", ts, 0, 0});
    } else if(k == ast.variable) {
      ast.variable{vn, _, init, _, _, _, _, _} = n;
      ts = if(given(init)) shown_node(init) else shown_name(n, vn);
      if(ts != "") found.push(mark{n, "type", ts, 0, 0});
    } else if(given(assign_target(n))) {
      // x = e объявляет, если имени ещё нет (решение автора: без auto); у объявления — тип
      // и значение в этот момент (инициализатор), а не будущие значения имени (2026-10-13)
      lhs = assign_target(n);
      name = name_of(lhs);
      known = false;
      for(c : context_names(n)) if((c.name == name) && ((c.kind == "переменная") || (c.kind == "параметр"))) known = true;
      if(!known) {
        ast.operation{_, xs, _} = n;
        ts = shown_node(xs[1]);
        if(ts != "") found.push(mark{lhs, "type", ts, 0, 0});
      }
    }
  }
  true
}
enclosing_fn(n) {
  x = code_parent(n);
  while(given(x) && (code_kind(x) != ast.function)) x = code_parent(x);
  x
}
// типы имени в слое: все его упоминания в поддереве (без вложенных функций)
layer_name_types(i64 v, n, str name, ts) {
  if((code_kind(n) == ast.name) && (name_of(n) == name)) for(t : layer_types(v, n)) {
    fresh = true;
    for(x : ts) if(x == t) fresh = false;
    if(fresh) ts.push(t);
  }
  for(c : code_items(n)) if(code_kind(c) != ast.function) layer_name_types(v, c, name, ts);
  true
}
// Метки слоя: типы объявлений в этом контексте, известные значения имён, не исполнявшееся в нём —
// приглушить (верхний такой узел)
layer_marks(found, i64 v) {
  f = view_root(v);
  for(n : view_nodes(v)) {
    k = code_kind(n);
    up = code_parent(n);
    if(k == ast.parameter) {
      ts = array{};
      layer_name_types(v, f, code_name(n), ts);
      if(ts.size > 0) found.push(mark{n, "type", join_types(ts), 0, 0});
    }
    // значения: имена и условия развилок (известное условие — какая ветка живёт)
    cond = given(up) && ((code_kind(up) == ast.if) && {
      ast.if{c, _, _} = up;
      code_id(c) == code_id(n)
    });
    if(((k == ast.name) && (given(up) && (code_kind(up) != ast.call))) || cond) {
      lit = layer_literal(v, n);
      if(lit != "") found.push(mark{n, "value", lit, 0, 0});
    }
    // не исполнялось в этом контексте: узел тела без наблюдения, родитель — с наблюдением
    body = (code_id(n) != code_id(f)) && ((code_id(enclosing_fn(n)) == code_id(f)) && ((k != ast.parameter) && !(given(up) && (code_kind(up) == ast.parameter))));
    if(body && (!layer_has(v, n) && ((code_id(up) == code_id(f)) || layer_has(v, up)))) found.push(mark{n, "dead", "не исполняется в этом контексте", 0, 0});
  }
  true
}
// Вкладки слоёв функции: «все» и контексты её использования
send_layers(i64 v) => show_layers(v, layers_of(v));
send_marks(i64 v) {
  found = array{};
  if(in_layer(v)) layer_marks(found, v) else type_marks(found, v);
  for(e : error_marks(v)) found.push(mark{e[0], "error", e[1], e[2], e[3]});
  show_marks(v, found);
  if(view_kind(v) == "fn") send_layers(v) else 0
}

// --- переход и «добавить по месту» ------------------------------------------------------
// 
// 
// 
// F12 на вызове — перегрузки, выбранные в
// экземплярах («трейсинг»), все остальные и «добавить» для типов аргументов без перегрузки;
// Ctrl+P — то же по набранной сигнатуре. Добавленная — внутренний элемент модуля, открывается во
// второй панели.

// перегрузки имени, видимые в месте at (модуль, его use, прелюдия), без записей syntax
overloads(str name, at) {
  found = array{};
  for(f : declarations(name, at)) if(!is_record(f)) found.push(f);
  found
}
signature(f) {
  ast.function{name, ps, _, _, _, _, _, _, _} = f;
  s = name + "(";
  for(k : range(ps.size)) {
    ast.parameter{pn, pt, _, _, _, _, _} = ps[k];
    if(k > 0) s = s + ", ";
    if(given(pt) && (code_kind(pt) == ast.name)) s = (s + type_text(pt)) + " ";
    s = s + pn;
  }
  s + ")"
}
// подходит ли перегрузка к типам (параметр без типа — к любому)
accepts(f, types) {
  ast.function{_, ps, _, _, _, _, _, _, _} = f;
  if(ps.size != types.size) return false;
  r = true;
  for(k : range(types.size)) {
    ast.parameter{_, pt, _, _, _, _, _} = ps[k];
    if(given(pt) && ((code_kind(pt) == ast.name) && (type_text(pt) != before(types[k], '<')))) r = false;
  }
  r
}
// точно ли типизирована под эти типы (все параметры с типом)
exact(f, types) {
  if(!accepts(f, types)) return false;
  ast.function{_, ps, _, _, _, _, _, _, _} = f;
  r = true;
  for(p : ps) {
    ast.parameter{_, pt, _, _, _, _, _} = p;
    if(!given(pt)) r = false;
  }
  r
}
add_text(str name, types) {
  s = name + "(";
  for(k : range(types.size)) s = (s + (if(k > 0) ", " else "")) + types[k];
  s + ")"
}
// примечание пункта: выбрана здесь, внутренняя, прелюдия
with_note(str detail, str note) => if(detail == "") note else (detail + ", ") + note;
// список перехода; пусто — сказать
nav(i64 v, items, targets) => if(items.size == 0) report("переход: ничего не найдено") else show_nav(v, items, targets);
// пункт «добавить» — в начало списка
prepend(xs, x) {
  r = array{x};
  for(y : xs) r.push(y);
  r
}
// F12: вызов в месте курсора — его перегрузки
goto_call(i64 v) {
  at = if(cursor(v) < places(v)) cursor(v) else 0;
  call = code();
  for(k : array{at, if(at > 0) at - 1 else at}) {
    n = if(given(call)) code() else place_node(v, k);
    while(given(n) && !given(call)) {
      callee = callee_of(n);
      if(given(callee) && ((code_kind(callee) == ast.name) || (member_name(callee) != ""))) call = n;
      n = code_parent(n);
    }
  }
  if(!given(call)) return report("F12: курсор не на вызове функции");
  ast.call{callee, given_args, _, _, _, _, _} = call;
  args = array{};
  name = name_of(callee);
  if(code_kind(callee) != ast.name) { // a.f(b) ≡ f(a, b) (§4.5); geo.vec.norm(b) — имя модуля
    name = member_name(callee);
    if(!given(qualified_module(callee))) args.push(member_object(callee));
  }
  for(x : given_args) args.push(x);
  chosen = call_targets(call);
  items = array{};
  targets = array{};
  fns = chosen_first(overloads(name, callee), chosen);
  for(f : fns) {
    detail = if(has_code(chosen, f)) "выбрана здесь" else "";
    if(is_inner(f)) detail = with_note(detail, "внутренняя");
    if(in_prelude(f)) detail = with_note(detail, "прелюдия");
    if(module_note(f) != "") detail = with_note(detail, module_note(f));
    items.push(completion{signature(f), "перегрузка", detail, 0});
    targets.push(array{f, ""});
  }
  // типы аргументов по всем экземплярам: сочетания без подходящей перегрузки — «добавить»
  combos = array{array{}};
  for(x : args) {
    ts = node_types(x);
    if(ts.size == 0) return nav(v, items, targets); // тип аргумента неизвестен — только переход
    next = array{};
    for(cmb : combos) for(t : ts) if(next.size < 8) {
      one = cmb;
      one.push(t);
      next.push(one);
    }
    combos = next;
  }
  for(cmb : combos) {
    fits = false;
    for(f : fns) if(accepts(f, cmb)) fits = true;
    if(!fits) {
      items = prepend(items, completion{"добавить " + add_text(name, cmb), "добавить", "внутренняя перегрузка", 0});
      targets = prepend(targets, array{code(), add_text(name, cmb)});
    }
  }
  nav(v, items, targets);
}
trim(str s) {
  from = 0;
  to = s.size;
  while((from < to) && (s[from] == ' ')) from += 1;
  while((to > from) && (s[to - 1] == ' ')) to -= 1;
  slice_text(s, from, to)
}
// Ctrl+P: «foo(i64, str)» или «foo» — перегрузки и «добавить»
on_goto(i64 id, str sig) {
  v = view_of(id);
  if(v < 0) no_view(id) else goto_sig(v, sig)
}
goto_sig(i64 v, str sig) {
  finalize_views();
  t = trim(sig);
  open = find_text(t, "(");
  name = trim(if(open >= 0) slice_text(t, 0, open) else t);
  if(name == "") return report("переход: нужна сигнатура вида foo(i64)");
  typed = open >= 0;
  types = array{};
  if(typed) {
    close = -1;
    for(k : range(t.size)) if(t[k] == ')') close = k;
    inside = slice_text(t, open + 1, if(close > open) close else t.size);
    from = 0;
    while(from <= inside.size) {
      comma = find_text(text_from(inside, from), ",");
      to = if(comma >= 0) from + comma else inside.size;
      part = trim(slice_text(inside, from, to));
      if(part != "") types.push(part);
      from = to + 1;
    }
  }
  fns = overloads(name, views[v].root);
  if(typed) { // точные, потом подходящие, потом прочие — порядок внутри — как был
    sorted = array{};
    for(f : fns) if(exact(f, types)) sorted.push(f);
    for(f : fns) if(!exact(f, types) && accepts(f, types)) sorted.push(f);
    for(f : fns) if(!accepts(f, types)) sorted.push(f);
    fns = sorted;
  }
  items = array{};
  targets = array{};
  for(f : fns) {
    detail = if(typed && exact(f, types)) "точно" else if(typed && accepts(f, types)) "подходит" else "";
    if(is_inner(f)) detail = with_note(detail, "внутренняя");
    if(module_note(f) != "") detail = with_note(detail, module_note(f));
    items.push(completion{signature(f), "перегрузка", detail, 0});
    targets.push(array{f, ""});
  }
  exactly = false;
  for(f : fns) if(exact(f, types)) exactly = true;
  if(typed && !exactly) {
    items = prepend(items, completion{"добавить " + add_text(name, types), "добавить", "внутренняя перегрузка", 0});
    targets = prepend(targets, array{code(), add_text(name, types)});
  }
  nav(v, items, targets);
}
// Добавить внутреннюю перегрузку «foo(i64, str)»: имена параметров — как у перегрузки той же
// арности, иначе a, b, c…; тело — пустая строка для набора
add_overload(str sig) {
  open = find_text(sig, "(");
  name = slice_text(sig, 0, open);
  inside = slice_text(sig, open + 1, sig.size - 1);
  types = array{};
  from = 0;
  while(from <= inside.size) {
    comma = find_text(text_from(inside, from), ",");
    to = if(comma >= 0) from + comma else inside.size;
    part = trim(slice_text(inside, from, to));
    if(part != "") types.push(part);
    from = to + 1;
  }
  names = array{};
  for(f : overloads(name, program())) if(names.size == 0) {
    ast.function{_, ps, _, _, _, _, _, _, _} = f;
    if(ps.size == types.size) for(p : ps) {
      ast.parameter{pn, _, _, _, _, _, _} = p;
      names.push(pn);
    }
  }
  s = name + "(";
  for(k : range(types.size)) s = (((s + (if(k > 0) ", " else "")) + before(types[k], '<')) + " ") + (if(k < names.size) names[k] else text_byte('a' + k));
  add_inner(s + ") {\n\n}\n", sig);
}
// пункт списка перехода: открыть функцию или добавить сигнатуру
nav_accept(i64 v) {
  k = selected(v);
  f = nav_fn(v, k);
  add = nav_add(v, k);
  close_completion(v);
  if(given(f)) open_fn(f) else add_overload(add);
}

// --- отладчик: трасса запуска ---------------------------------------------------------
// Решение автора: путь исполнения (§13.2) записан при запуске, шаги — по нему вперёд и
// назад; VM не останавливается. 
//;
// встроенные вызовы — обычные шаги (
//).

// инструкция: элемент блока или выражение-тело функции (тело-блок — не шаг, шаги — его инструкции)
is_stmt(i64 k) {
  n = trace_node(k);
  up = code_parent(n);
  if(code_kind(n) == ast.block) return false;
  given(up) && ((code_kind(up) == ast.block) || ((code_kind(up) == ast.function) && {
    ast.function{_, _, _, body, _, _, _, _, _} = up;
    code_id(body) == code_id(n)
  }))
}
// следующая (или предыдущая) инструкция не глубже max_depth (-1 — любая); нет — остаться
next_stmt(i64 from, bool back, i64 max_depth) {
  total = trace_size();
  if(total == 0) return 0;
  deep = (max_depth < 0);
  if(!back) {
    k = from;
    while(k < total) {
      if(is_stmt(k) && (deep || (trace_depth(k) <= max_depth))) return k;
      k += 1;
    }
  } else {
    k = from;
    while(k >= 0) {
      if(is_stmt(k) && (deep || (trace_depth(k) <= max_depth))) return k;
      k -= 1;
    }
  }
  lesser(from, total - 1)
}
// значок значения лишний: литерал (значение и так в тексте), блок, имя вызываемой функции
quiet_value(n) {
  k = code_kind(n);
  if((k == ast.int) || ((k == ast.float) || ((k == ast.string) || (k == ast.block)))) return true;
  up = code_parent(n);
  given(callee_of(up)) && (code_id(callee_of(up)) == code_id(n))
}
step_to(i64 pos) {
  set_trace_pos(pos);
  total = trace_size();
  if(total == 0) return show_trace(true, pos, 0, code(), array{}, trace_output(-1), trace_error());
  node = trace_node(pos);
  depth = trace_depth(pos);
  // стек: для каждой глубины — функция последнего шага этой глубины
  stack = array{};
  want = depth;
  k = pos;
  while((want >= 1) && (k >= 0)) {
    if(trace_depth(k) == want) {
      f = enclosing_fn(trace_node(k));
      stack.push(if(given(f)) code_name(f) else "?");
      want -= 1;
    } else k -= 1;
  }
  show_trace(true, pos, total, node, stack, trace_output(pos), trace_error());
  // значения подвыражений текущей инструкции (той же глубины) — значками
  from = pos;
  while((from > 0) && !(is_stmt(from - 1) && (trace_depth(from - 1) == depth))) from -= 1;
  nodes = array{};
  values = array{};
  for(i : range((pos - from) + 1)) {
    k2 = from + i;
    val = trace_value(k2);
    if((trace_depth(k2) == depth) && ((val != "") && (val != "()"))) {
      n = trace_node(k2);
      at = -1;
      for(j : range(nodes.size)) if(code_id(nodes[j]) == code_id(n)) at = j;
      if(at >= 0) values[at] = val else {
        nodes.push(n);
        values.push(val);
      }
    }
  }
  for(w : peer_views()) {
    found = array{};
    for(j : range(nodes.size)) if((layout_of(w, nodes[j]) >= 0) && !quiet_value(nodes[j])) found.push(mark{nodes[j], "value", values[j], 0, 0});
    if(layout_of(w, node) >= 0) found.push(mark{node, "current", "", 0, 0});
    show_marks(w, found);
  }
  true
}
// клавиши отладчика: true — обработана
debug_key(i64 v, str key, i64 mods) {
  pos = trace_pos();
  depth = if(trace_size() == 0) 0 else trace_depth(pos);
  shift = (mods & 1) != 0;
  if(key == "Escape") {
    set_debugging(false);
    show_trace(false, 0, 0, code(), array{}, "", "");
    for(w : peer_views()) send_marks(w);
    return true;
  }
  if(key == "F10") {
    step_to(if(shift) next_stmt(if(pos > 0) pos - 1 else 0, true, depth) else next_stmt(pos + 1, false, depth));
    return true;
  }
  if(key == "F11") {
    step_to(if(shift) next_stmt(pos + 1, false, if(depth > 0) depth - 1 else 0) else next_stmt(pos + 1, false, -1));
    return true;
  }
  if(key == "F4") { // до инструкции под курсором
    at = place_node(v, cursor(v));
    while(given(at) && (given(code_parent(at)) && (code_kind(code_parent(at)) != ast.block))) at = code_parent(at);
    k = pos + 1;
    while(k < trace_size()) {
      if(code_id(trace_node(k)) == code_id(at)) {
        step_to(k);
        return true;
      }
      k += 1;
    }
    report("F4: эта инструкция дальше не исполняется");
    return true;
  }
  false
}
// трасса записана: шаг — к первой инструкции
on_trace(i64 v) {
  set_debugging(true);
  set_trace_pos(0);
  step_to(next_stmt(0, false, -1));
}

// --- команды: запуск, сохранение, правка функцией, слияние, слой, проекция --------------------
// запуск (F5) — принятого текста: процесс в этой же VM, редактор не встаёт 
// 
on_run(str args, str input) {
  finalize_views();
  start_program(args, input);
}
// вывод запуска — по мере исполнения
on_run_output(str text, bool ok, bool more, str state) => run_output(text, ok, more, state);
// Shift+F5: «Остановить/запустить» 
on_stop() => if(program_running()) stop_program() else report("запуск: программа не исполняется");
// запуск с трассой (F6)
on_trace_run(i64 id, str args, str input) {
  v = view_of(id);
  finalize_views();
  trace_program(args, input);
  on_trace(v);
}
// .tzdb рядом с программой: stats.tz → stats.tzdb (база — источник истины, §3.1)
on_save() {
  finalize_views();
  name = program_name();
  save_program(if(ends_with(name, ".tz")) name + "db" else if(ends_with(name, ".tzdb")) name else name + ".tzdb");
}
// функция правки программы: черновики — к канону, правки — в базу, представления — заново
apply_edit(str fn) {
  finalize_everyone();
  r = program_apply(fn);
  if(starts_with(r, "применена")) refresh_all();
  r
}
// Слияние с копией базы (§9.4, модуль tools): 
// Взятое само — в базе; конфликты — до решения человеком (состояние
// редактора). "" — слито, иначе ошибка.
merge_from(str path) {
  v = version_open(path);
  if(v < 0) return version_error();
  merge_state = merge_versions(0, v);
  version_close(v);
  refresh_all();
  send_merge(true);
  ""
}
send_merge(bool with_taken) => send_merge_list(if(with_taken) merge_state.taken else array{}, merge_state.conflicts);
// конфликт решён: их вариант (база изменилась — представления заново) или мой; false — нет такого
take_version(str key, bool theirs) {
  k = -1;
  for(j : range(merge_state.conflicts.size)) if((k < 0) && (merge_state.conflicts[j].key == key)) k = j;
  if(k < 0) return false;
  c = merge_state.conflicts[k];
  rest = array{};
  for(j : range(merge_state.conflicts.size)) if(j != k) rest.push(merge_state.conflicts[j]);
  merge_state.conflicts = rest;
  if(theirs) {
    take_theirs(0, -1, merge_state.base_items, c.id, c.their);
    refresh_all();
  }
  send_merge(false);
  true
}
// функция правки программы (решение автора 2026-10-17): правки — в базу
on_apply(str fn) {
  r = apply_edit(fn);
  show_output(r, starts_with(r, "применена"));
}
// слияние: путь — относительно программы
on_merge(str path) {
  finalize_everyone();
  full = path;
  if(!starts_with(path, "/")) {
    name = program_name();
    slash = -1;
    for(k : range(name.size)) if(name[k] == '/') slash = k;
    if(slash >= 0) full = slice_text(name, 0, slash + 1) + path;
  }
  error = merge_from(full);
  if(error != "") report("слияние: " + error) else 0
}
on_take(str key, bool theirs) {
  finalize_everyone();
  if(!take_version(key, theirs)) report("нет конфликта " + key) else 0
}
// слой представления функции (контекст экземпляра): метки — заново
on_layer(i64 id, str key) {
  v = view_of(id);
  if(v < 0) return report("слои — у представления функции");
  if(view_kind(v) != "fn") return report("слои — у представления функции");
  set_layer(v, key);
  send_marks(v);
}
// проекция представления (§4.4):  
// 
on_projection(i64 id, str key) {
  v = view_of(id);
  if(v < 0) return no_view(id);
  finalize_views();
  error = set_projection(v, key);
  if(error != "") return report(error);
  set_cursor(v, 0);
  show_view(v);
}
// открыть узел: функция — во второй панели, иначе — курсор на него
on_open(i64 id, n) {
  v = view_of(id);
  if(v < 0) return no_view(id);
  finalize_views();
  if(code_kind(n) == ast.function) return open_fn(n);
  k = node_place(v, n);
  if(k < 0) return report("узла нет в этом представлении");
  move_to(v, k, false, false);
}

// --- курсор -----------------------------------------------------------------------------
// курсор на место t (shift — выделение тянется)
move_to(i64 v, i64 t, bool shift, bool keep_goal) {
  if(shift) {
    if(anchor(v) < 0) set_anchor(v, cursor(v));
  } else set_anchor(v, -1);
  set_cursor(v, lesser(t, end_of(v)));
  if(!keep_goal) set_goal(v, -1);
  cursor_moved(v);
  send_hint(v);
}
// клавиша движения: новое место курсора (-1 — не движение); у ↑/↓ колонка запоминается
motion(i64 v, str key, i64 mods) {
  ctrl = (mods & 2) != 0;
  end = end_of(v);
  array{s, e} = selection(v);
  collapse = (anchor(v) >= 0) && ((mods & 1) == 0);
  c = cursor(v);
  if(key == "ArrowLeft") return if(collapse && !ctrl) s else if(ctrl) word_left(v, c) else if(c > 0) c - 1 else 0;
  if(key == "ArrowRight") return if(collapse && !ctrl) e else if(ctrl) word_right(v, c) else lesser(c + 1, end);
  if(key == "Home") {
    if(ctrl) return 0;
    ls = line_start(v, c);
    fs = ls;
    ld = leads(v);
    while((fs < end) && (ld[fs] == ' ')) fs += 1;
    return if(c == fs) ls else fs;
  }
  if(key == "End") return if(ctrl) end else line_end(v, c);
  if(key == "ArrowUp") return vertical(v, -1, 1);
  if(key == "ArrowDown") return vertical(v, 1, 1);
  if(key == "PageUp") return vertical(v, -1, 30);
  if(key == "PageDown") return vertical(v, 1, 30);
  -1
}
vertical_key(str key) => (key == "ArrowUp") || ((key == "ArrowDown") || ((key == "PageUp") || (key == "PageDown")));

// --- правка -----------------------------------------------------------------------------
// набор текста (буква, вставка): заменяет выделение; `}` в отступе — на уровень меньше
type_text(i64 v, str t) {
  array{s, e} = selection(v);
  if((t == "}") && (s == e)) {
    ls = line_start(v, s);
    if((s > ls) && blank(v, ls, s)) return replace(v, ls, s, spaces(if((s - ls) >= 2) (s - ls) - 2 else 0) + "}", -1);
  }
  replace(v, s, e, t, -1);
  if(code_points(t) == 1) complete(v, false);
  send_hint(v);
}
// Enter: перевод строки с отступом строки; после `{` — глубже, между `{` и `}` — две строки,
// курсор — на средней
newline(i64 v) {
  array{s, e} = selection(v);
  ls = line_start(v, s);
  ld = leads(v);
  ind = 0;
  while(((ls + ind) < s) && (ld[ls + ind] == ' ')) ind += 1;
  b = s;
  while((b > ls) && (ld[b - 1] == ' ')) b -= 1;
  open = (b > ls) && (ld[b - 1] == '{');
  f = e;
  while(((f + 1) < ld.size) && (ld[f] == ' ')) f += 1;
  close = open && (ld[f] == '}');
  pad = spaces(ind + (if(open) 2 else 0));
  if(close) return replace(v, s, f, ((("\n" + pad) + "\n") + spaces(ind)), 1 + pad.size);
  replace(v, s, e, "\n" + pad, -1);
}
// Tab / Shift+Tab: отступ строк выделения на 2 (без выделения Tab — пробелы до следующей
// колонки отступа)
indent(i64 v, bool out) {
  array{s, e} = selection(v);
  if(!out && (s == e)) return replace(v, s, s, spaces(2 - ((s - line_start(v, s)) % 2)), -1);
  from = line_start(v, s);
  to = line_end(v, if((e > s) && (lead(v, e - 1) == '\n')) e - 1 else e);
  done = "";
  k = from;
  while(k <= to) { // строка за строкой: [k, конец строки)
    le = line_end(v, k);
    stop = if(le < to) le else to;
    n = 0;
    if(out) while((n < 2) && (((k + n) < stop) && (lead(v, k + n) == ' '))) n += 1;
    pre = if(!out && (stop > k)) "  " else "";
    done = (done + pre) + text_of(v, k + n, stop);
    if(stop < to) done = done + "\n";
    k = stop + 1;
  }
  replace(v, from, to, done, -1);
}
copy(i64 v, bool cut) {
  array{s, e} = selection(v);
  if(s == e) { // без выделения — строка целиком
    s = line_start(v, s);
    e = lesser(line_end(v, e) + 1, end_of(v));
  }
  clipboard(text_of(v, s, e));
  if(cut) replace(v, s, e, "", -1) else 0
}
// Backspace / Delete: выделение — удалить; в отступе — до предыдущей колонки отступа;
// с Ctrl — слово
delete_at(i64 v, bool back, bool ctrl) {
  array{s, e} = selection(v);
  if(s != e) return replace(v, s, e, "", -1);
  if(back && (s == 0)) return send_cursor(v);
  if(!back && ((s + 1) >= places(v))) return send_cursor(v);
  from = if(back) s - 1 else s;
  to = if(back) s else s + 1;
  if(back && !ctrl) {
    ls = line_start(v, s);
    if((s > ls) && blank(v, ls, s)) from = s - (if(((s - ls) % 2) == 1) 1 else 2);
  }
  if(ctrl) {
    if(back) from = word_left(v, s) else to = word_right(v, s);
  }
  replace(v, from, to, "", -1);
  if(back) complete(v, false);
  send_hint(v);
}

// --- сигналы клиента ----------------------------------------------------------------------
letter(str key, str lo, str up, str ru) => (key == lo) || ((key == up) || (key == ru));
// клавиша; mods: 1 Shift, 2 Ctrl, 4 Alt, 8 Meta
on_key(i64 id, str key, i64 mods) {
  v = view_of(id);
  if(v < 0) no_view(id) else key_at(v, key, mods)
}
key_at(i64 v, str key, i64 mods) {
  if(debugging() && debug_key(v, key, mods)) return true; // клавиши шагов — отладчику
  if(completing(v)) {
    if((key == "ArrowDown") || (key == "ArrowUp")) {
      n = completion_count(v);
      return select_item(v, (selected(v) + (if(key == "ArrowDown") 1 else n - 1)) % n);
    }
    if((key == "Enter") && nav_list(v)) return nav_accept(v); // список перехода: открыть или добавить
    if(key == "Enter") { // принять: набранное слово заменяется выбранным именем
      name = completion_name(v, selected(v));
      b = word_begin(v);
      close_completion(v);
      return replace(v, b, cursor(v), name, -1);
    }
    if(key == "Escape") return close_completion(v);
  }
  finalize_others(v); // клавиша другому представлению — черновики прочих к канону
  shift = (mods & 1) != 0;
  ctrl = (mods & 2) != 0;
  if((key == " ") && ctrl) return complete(v, true);
  if(key == "F12") {
    finalize(v);
    return goto_call(v);
  }
  t = motion(v, key, mods);
  if(t >= 0) return move_to(v, t, shift, vertical_key(key));
  if(key == "Escape") { // выделение снять; черновик — к канону; подсказку — скрыть
    close_completion(v);
    set_anchor(v, -1);
    if(draft_open(v)) finalize(v) else send_cursor(v);
    return hide_hint(v);
  }
  if(ctrl && letter(key, "a", "A", "ф")) {
    set_anchor(v, 0);
    return move_to(v, end_of(v), true, false);
  }
  if(ctrl && letter(key, "c", "C", "с")) return copy(v, false);
  if(ctrl && letter(key, "x", "X", "ч")) return copy(v, true);
  if(ctrl && letter(key, "z", "Z", "я")) return undo(v, shift);
  if(ctrl && letter(key, "y", "Y", "н")) return undo(v, true);
  close_completion(v);
  if((key == "Backspace") || (key == "Delete")) return delete_at(v, key == "Backspace", ctrl);
  if(key == "Enter") return newline(v);
  if(key == "Tab") return indent(v, shift);
  if((code_points(key) == 1) && ((mods & 14) == 0)) return type_text(v, key);
  report("клавиша не обработана: " + key);
}
// ввод текста (вставка, IME): набор слова кончился
on_input(i64 id, str text) {
  v = view_of(id);
  if(v < 0) return no_view(id);
  finalize_others(v);
  close_completion(v);
  set_typing(v, false);
  type_text(v, text);
}
// место клиента (узел, кусок, смещение) — в представлении; нет — черновики прочих к канону и сказать
client_place(i64 v, i64 n, i64 piece, i64 offset) {
  t = place_at(v, n, piece, offset, false);
  if(t < 0) {
    finalize_others(v);
    report(((((("нет места #" + text(n)) + "/") + text(piece)) + "/") + text(offset)));
  }
  t
}
on_select(i64 id, i64 n, i64 piece, i64 offset, i64 clicks) {
  v = view_of(id);
  if(v < 0) return no_view(id);
  t = client_place(v, n, piece, offset);
  if(t >= 0) select_at(v, t, clicks) else 0
}
// щелчок: место t; clicks — 2 слово, 3 строка
select_at(i64 v, i64 t, i64 clicks) {
  finalize_others(v);
  if(clicks == 2) {
    from = t;
    to = t;
    ld = leads(v);
    c = char_class(ld[t]);
    while((from > 0) && (char_class(ld[from - 1]) == c)) from -= 1;
    while(((to + 1) < ld.size) && (char_class(ld[to]) == c)) to += 1;
    set_cursor(v, from);
    return move_to(v, to, true, false);
  }
  if(clicks >= 3) {
    set_cursor(v, line_start(v, t));
    set_anchor(v, -1);
    return move_to(v, lesser(line_end(v, t) + 1, end_of(v)), true, false);
  }
  move_to(v, t, true, false);
}
// указатель (перенос курсора без выделения)
on_pointer(i64 id, i64 n, i64 piece, i64 offset) {
  v = view_of(id);
  if(v < 0) return no_view(id);
  t = client_place(v, n, piece, offset);
  if(t < 0) return 0;
  finalize_others(v);
  move_to(v, t, false, false);
}
