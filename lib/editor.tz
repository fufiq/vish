// Редактор на языке (M5 → язык, 2026-10-19, решение автора: 
//). 
// 
// 
// Клавиша, указатель,
// ввод — функции этого модуля: что сделать, решает код на языке. Своя функция с тем же именем в
// проекции представления или в программе — первой (как operand_parens).
//
// Цепочки одного ассоциативного оператора (a + b + c) здесь — скобками: дерево такой цепочки VM
// строит при первом исполнении производными узлами базы, а код редактора базу программы не
// трогает (*моё*).
//
// Состояние представлений — переменные этого модуля (решение автора 2026-10-20): модуль —
// сервис VM, его состояние одно на VM, живое —,
// Курсор, выделение, черновик, история отката,
// списки и раскладка — здесь; механизмы над ними (черновик, выбор единицы переразбора, рассылка
// правки с переносом курсоров, откат) — тоже. У VM — база языка: печать проекции (раскладкой,
// значением), разбор текста единицы в базу, факты разбора, сокет — примитивы native "cpp" ниже.
//.
// *Моё:* модуль отдельный — его грузит только сервер редактора, программы его не разбирают.
[[service]] module editor;
use tools; // тулинг вне редактора: версии базы, слияние (lib/tools.tz)

// --- состояние представлений --------------------------------------------------------------
// Раскладка представления — печать проекции (print_view): текст и места курсора (перед каждой
// кодовой точкой, последнее — конец текста), узлы по порядку печати с местами своего текста и
// кусками (свой текст или ребёнок). Номера узлов — числа (node_code — код узла).
struct layout {
  str text;      // текст проекции
  str lead;      // первый байт символа каждого места ('\n' в конце — край последней строки)
  array node;    // по месту: узел, номер его куска, смещение в куске (кодовые точки) — место в протоколе
  array piece;
  array offset;
  array byte;    // по месту: байт текста
  array nodes;   // по номеру раскладки: узел
  array up;      // по номеру раскладки: раскладка родителя (-1 — корень)
  array from;    // по номеру раскладки: места текста узла [from, to)
  array to;
  array sig;     // подпись своих кусков (вид, тексты, дети, примечание)
  array sub;     // подпись поддерева (узлы, свои куски, дети)
  array first;   // куски узла: [first, first + count) в pchild/pbyte
  array count;
  array pchild;  // по куску: ребёнок (-1 — текст)
  array pbyte;   // по куску: начало его текста в ptext
  array plen;    // по куску: кодовых точек текста (у ребёнка — 0)
  array pplace;  // по куску: его первое место
  str ptext;     // тексты кусков подряд
  array sorted;  // узлы по возрастанию
  array order;   // их номера раскладки
  array chunk_at;   // модуль: по номеру элемента — байт начала его куска (-1 — не выведен)
  array content_at; // — начала его строк
  i64 items_end;    // конец элементов (до комментариев конца модуля)
  i64 draft_begin;  // текст черновика [draft_begin, draft_end)
  i64 draft_end;
  i64 group_at;     // напечатано с черновиком модуля: элементы [group_at, group_at + group_count); -1 — без
  i64 group_count;
}
// Черновик (решение автора 2026-10-12): элементы модуля, которые правят, — текстом ровно как
// набран; в представлении функции — она сама.
struct draft {
  bool open;
  array items;   // элементы модуля черновика (представление функции — её корень)
  code next;     // элемент модуля после черновика (пусто — в конце)
  i64 source;    // импорт набранного текста: места узлов — в нём
  array blank;   // пустые строки разбора — для канона
  array rest;    // комментарии после последнего элемента — следующему
  i64 since;     // ревизия базы при открытии: журнал после неё — одна правка
  str before;    // текст единицы до черновика (канон) — для отката принятого
  array sources; // импорты набранного текста
}
struct snapshot { str text; i64 caret; } // откат внутри черновика: текст и байт курсора
// Принятая правка (закрытый черновик): элементы и их текст до и после — откат и повтор принятого —
// правкой обратно.  
// *моё*: история — правки, журнал базы не переписывается.
struct closed { array items; code next; str before; str after; }
struct view {
  i64 peer;          // клиент (номер у VM)
  i64 id;            // номер представления у клиента
  code root;         // модуль или функция; пусто — закрыто
  str kind;          // module — модуль без внутренних элементов; fn — одна функция
  str layer;         // слой представления функции: ключ экземпляра, "" — все контексты
  code projection;   // проекция (§4.4): модуль записей печати и правил разбора правок; пусто — по умолчанию
  layout lay;
  i64 cursor;        // место
  i64 anchor;        // второй конец выделения; -1 — нет
  i64 goal;          // колонка для ↑/↓; -1 — нет
  bool selection_sent;
  bool hint_shown;   // подсказка набора показана — скрыть, когда нечего
  bool typing;       // идёт набор слова: откат — словом, а не буквой
  bool completing;   // список дополнения (или перехода) открыт
  array items;       // его варианты (completion)
  i64 selected;
  i64 word_begin;    // начало набираемого слова
  array targets;     // список перехода (F12, Ctrl+P): по пункту — array{функция, сигнатура «добавить»}
  draft d;
  array undo;        // откат внутри черновика (snapshot)
  array redo;
  array done;        // принятые правки (closed)
  array undone;
}
// клиент: смотрит трассу запуска (клавиши шагов — отладчику) и её шаг
struct client { bool debugging; i64 trace_pos; }
// Правка автора в координатах узла (до разбора): курсоры других клиентов в том же куске сдвигаются
// ею, как в обычном редакторе.
struct edit_hint { i64 node; i64 piece; i64 offset; i64 removed; i64 inserted; bool valid; }

views = array{};   // все представления всех клиентов: номер — место в массиве
clients = array{}; // по номеру клиента
hint = edit_hint{-1, 0, 0, 0, 0, false};
merge_state = no_merge(); // конфликты последнего слияния — до решения человеком

// --- примитивы базы: печать проекции, разбор правки, отправка (у VM) ------------------------
// Неизвестный при разборе аргумент — стёртое значение (как у прелюдии), без эффектов.

// клиент, чьё сообщение обслуживается
now_peer() => native "cpp" { return value(int64_t(editor_host->now_peer ? editor_host->index_of(*editor_host->now_peer) : -1)); };
// код узла по номеру (-1 — пустой)
node_code(i64 n) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  int64_t n = (a[0]).as<int64_t>();
  return vm.code_value(n < 0 || n >= int64_t(editor_host->session.db.size()) ? node_id{} : node_id(uint32_t(n)));
};
node_codes(ns) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & xs = (a[0]).as<array_v>();
  array_v out;
  for(uint32_t k = 0; k < xs.size(); ++k) out.push(vm.code_value(node_id(uint32_t(xs.get(k).as<int64_t>()))));
  return value(std::move(out));
};
// ревизия базы
revision() => native "cpp" { return value(int64_t(editor_host->session.db.revision)); };
// Печать представления (база языка): раскладка (layout) — корень, модуль ли (иначе одна функция),
// проекция; черновик модуля — элементы [at, at + count) текстом как набран (count -1 — нет);
// черновик функции — её текст как набран (fn_source -1 — нет)
print_view(root, bool as_module, projection, i64 at, i64 count, i64 source, i64 fn_source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  return editor_host->print_view(vm, vm.code_node(a[0], where), (a[1]).as<bool>(), editor_host->node_or_none(vm, a[2], where), (a[3]).as<int64_t>(), (a[4]).as<int64_t>(), (a[5]).as<int64_t>(), (a[6]).as<int64_t>());
};
// Черновик модуля правлен на месте: печать только его области (элементы [at, at + count) текстом
// как набран, source) и вклейка в прежнюю раскладку lay, напечатанную с черновиком из элементов old.
// TZ_SPLICE_CHECK=1 — сверка с полной печатью.
print_splice(layout lay, root, projection, i64 at, old, i64 count, i64 source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  node_list old;
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) old.push_back(vm.code_node((a[4]).as<array_v>().get(k), where));
  node_id root = vm.code_node(a[1], where);
  int64_t at = (a[3]).as<int64_t>(), count = (a[5]).as<int64_t>(), source = (a[6]).as<int64_t>();
  value r = s.print_splice(vm, a[0], root, at, old, count, source, where);
  static bool const check = std::getenv("TZ_SPLICE_CHECK");
  if(check) s.splice_check(vm, r, s.print_view(vm, root, true, s.node_or_none(vm, a[2], where), at, count, source, -1));
  return r;
};
// черновик: текст элементов модуля [at, at + old.size) (или функции root) разобрать и поставить в
// базу; итог — array{элементы, импорт текста, пустые строки, комментарии конца, переразобранные}
draft_parse(bool as_module, root, str text, old, next, i64 at, projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  node_list old;
  for(uint32_t k = 0; k < (a[3]).as<array_v>().size(); ++k) old.push_back(vm.code_node((a[3]).as<array_v>().get(k), where));
  return s.draft_parse(vm, (a[0]).as<bool>(), s.node_or_none(vm, a[1], where), std::string((a[2]).as<str_v>().view()), old, s.node_or_none(vm, a[4], where), uint32_t((a[5]).as<int64_t>()), s.node_or_none(vm, a[6], where));
};
// канон черновика в базе: пустые строки, комментарии конца, клавиши — одна правка журнала
draft_close(bool as_module, i64 at, i64 count, next, blank, rest, i64 since, sources, i64 source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  std::vector<uint32_t> blank, sources;
  std::vector<std::string> rest;
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) blank.push_back(uint32_t((a[4]).as<array_v>().get(k).as<int64_t>()));
  for(uint32_t k = 0; k < (a[5]).as<array_v>().size(); ++k) rest.emplace_back((a[5]).as<array_v>().get(k).as<str_v>().view());
  for(uint32_t k = 0; k < (a[7]).as<array_v>().size(); ++k) sources.push_back(uint32_t((a[7]).as<array_v>().get(k).as<int64_t>()));
  s.draft_close((a[0]).as<bool>(), uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), s.node_or_none(vm, a[3], where), blank, rest, uint64_t((a[6]).as<int64_t>()), sources, uint32_t((a[8]).as<int64_t>()));
  return value(int64_t(0));
};
// единица переразбора (0 — блок, 1 — элемент модуля, 2 — модуль) — текстом правки: array{разобрана, переразобранные}
unit_edit(n, i64 kind, str text, projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  return s.unit_edit(vm, vm.code_node(a[0], where), (a[1]).as<int64_t>(), std::string((a[2]).as<str_v>().view()), s.node_or_none(vm, a[3], where));
};
// сырой блок — текстом правки; false — не разобрался
raw_edit(n, str text) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(false));
  return value(editor_host->raw_edit(vm.code_node(a[0], where), std::string((a[1]).as<str_v>().view())));
};
// узел представления функции — дырой с текстом правки
fn_hole(n, str text) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->fn_hole(vm.code_node(a[0], where), std::string((a[1]).as<str_v>().view()));
  return value(int64_t(0));
};
// строка набора: элементы [k, k + count) контейнера c — текстом правки (count 0 — новый на месте k);
// above/below — переводы строки промежутка до и после места; array{разобрана, элементов, переразобранные}
line_edit(c, i64 k, i64 count, str text, bool module_level, projection, i64 above, i64 below) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  return s.line_edit(vm, vm.code_node(a[0], where), uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), std::string((a[3]).as<str_v>().view()), (a[4]).as<bool>(), s.node_or_none(vm, a[5], where), uint32_t((a[6]).as<int64_t>()), uint32_t((a[7]).as<int64_t>()));
};
// реактивная проверка программы после правки (до раскладки: изменённое ct-кодом видно сразу)
check_program() => native "cpp" {
  editor_host->recheck();
  return value(int64_t(0));
};
// узлы, изменённые элаборацией (мутации ct-кода и их откат, §7.4): take — и забыть
changed_nodes(bool take) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & db = editor_host->session.db;
  array_v out;
  for(uint32_t x: db.changed) out.push(value(int64_t(x)));
  if((a[0]).as<bool>()) db.changed.clear();
  return value(std::move(out));
};
// пауза набора: проверка и метки — по таймеру (решение on_idle); clear_pending — уже сделано
schedule_check() => native "cpp" {
  editor_host->schedule_check();
  return value(int64_t(0));
};
clear_pending() => native "cpp" {
  editor_host->check_pending = false;
  return value(int64_t(0));
};
// расширения функций по ссылке в модуле программы: array{расширение, цель}
fn_extensions() => native "cpp" {
  auto const & db = editor_host->session.db;
  array_v out;
  for(node_id x: db.as<n_module>(editor_host->session.root).items)
    if(db.is<n_extend>(x) && db.as<n_extend>(x).target) out.push(value(array_v::of({vm.code_value(x), vm.code_value(node_id(db.as<n_extend>(x).target))})));
  return value(std::move(out));
};
// сырой блок с правилом разбора (единица правки — он сам)
raw_unit(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  auto const & db = editor_host->session.db;
  node_id n = vm.code_node(a[0], where);
  return value(db.is<n_raw>(n) && db.as<n_raw>(n).rule);
};
// добавить внутренний элемент модуля программы (текст объявления); не вышло — пусто
parse_inner(str text, str sig) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(vm.code_value(node_id{}));
  return vm.code_value(editor_host->add_inner(std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view())));
};
// модуль проекции по ключу (как use k рядом с программой): array{модуль, ошибка}; "" — по умолчанию
projection_of(str key) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto [m, error] = editor_host->projection_of(std::string((a[0]).as<str_v>().view()));
  return value(array_v::of({vm.code_value(m), value(std::move(error))}));
};

// --- примитивы: отправка клиенту ---------------------------------------------------------------
// представление целиком: узлы раскладки по порядку
send_view(i64 peer, i64 id, root, str kind, layout lay) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  s.send_to((a[0]).as<int64_t>(), proto::s_view{uint32_t((a[1]).as<int64_t>()), vm.code_node(a[2], where), s.session.db.revision, s.wire_nodes(a[4], {}, where), std::string((a[3]).as<str_v>().view())});
  return value(int64_t(0));
};
// поддерево узла at — заменено (id at сохранён, дети — новые)
send_update(i64 peer, i64 id, at, layout lay) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  node_id n = vm.code_node(a[2], where);
  s.send_to((a[0]).as<int64_t>(), proto::s_update{uint32_t((a[1]).as<int64_t>()), s.session.db.revision, n, s.wire_nodes(a[3], n, where)});
  return value(int64_t(0));
};
// курсор и второй конец выделения: узел (-1 — нет), кусок, смещение
send_caret(i64 peer, i64 id, bool selection, i64 n, i64 piece, i64 offset) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  int64_t n = (a[3]).as<int64_t>();
  node_id at = n < 0 ? node_id{} : node_id(uint32_t(n));
  uint32_t id = uint32_t((a[1]).as<int64_t>()), piece = uint32_t((a[4]).as<int64_t>()), offset = uint32_t((a[5]).as<int64_t>());
  if((a[2]).as<bool>()) editor_host->send_to((a[0]).as<int64_t>(), proto::s_select{id, at, piece, offset});
  else editor_host->send_to((a[0]).as<int64_t>(), proto::s_cursor{id, at, piece, offset});
  return value(int64_t(0));
};
// список дополнения (completion) у места (узел, кусок, смещение); пусто — скрыть
send_completion_list(i64 peer, i64 id, i64 n, i64 piece, i64 offset, i64 selected, items) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  int64_t n = (a[2]).as<int64_t>();
  proto::s_complete out{uint32_t((a[1]).as<int64_t>()), n < 0 ? node_id{} : node_id(uint32_t(n)), uint32_t((a[3]).as<int64_t>()), uint32_t((a[4]).as<int64_t>()), uint32_t((a[5]).as<int64_t>()), {}};
  auto const & xs = (a[6]).as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    value x = xs.get(k);
    out.items.push_back({std::string(s.field(x, "name", where).as<str_v>().view()), std::string(s.field(x, "kind", where).as<str_v>().view()), std::string(s.field(x, "detail", where).as<str_v>().view())});
  }
  s.send_to((a[0]).as<int64_t>(), out);
  return value(int64_t(0));
};
// подсказка набора у места (узел -1 — без места); пусто — скрыть
send_hint_lines(i64 peer, i64 id, i64 n, i64 piece, i64 offset, lines) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  int64_t n = (a[2]).as<int64_t>();
  s.send_to((a[0]).as<int64_t>(), proto::s_hint{uint32_t((a[1]).as<int64_t>()), n < 0 ? node_id{} : node_id(uint32_t(n)), uint32_t((a[3]).as<int64_t>()), uint32_t((a[4]).as<int64_t>()), s.wire_lines(vm, a[5], where)});
  return value(int64_t(0));
};
// подсказка наведения на узел
send_hover(i64 peer, i64 id, n, lines) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  s.send_to((a[0]).as<int64_t>(), proto::s_hover{uint32_t((a[1]).as<int64_t>()), s.node_or_none(vm, a[2], where), s.wire_lines(vm, a[3], where)});
  return value(int64_t(0));
};
// метки (mark) представления
send_marks_list(i64 peer, i64 id, marks) => native "cpp" {
