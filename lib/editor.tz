    out.push_back({s.node_or_none(vm, s.field(x, "node", where), where), std::string(s.field(x, "kind", where).as<str_v>().view()), std::string(s.field(x, "text", where).as<str_v>().view()), uint32_t(s.field(x, "from", where).as<int64_t>()), uint32_t(s.field(x, "to", where).as<int64_t>())});
  }
  s.send_to((a[0]).as<int64_t>(), proto::s_decor{uint32_t((a[1]).as<int64_t>()), s.session.db.revision, std::move(out)});
  return value(int64_t(0));
};
