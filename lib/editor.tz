// курсор на начало узла n в представлении (-1 — узла в нём нет)
node_place(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  uint32_t k = w.layout_of(vm.code_node(a[1], where));
  return value(k == ~uint32_t{0} ? int64_t(-1) : int64_t(w.range[k].first));
};

// --- примитивы: факты разбора и базы (у VM) ---------------------------------------------
// узел места k
place_node(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  uint32_t k = uint32_t((a[1]).as<int64_t>());
  return k < w.places.size() && w.places[k].node ? vm.code_value(w.places[k].node) : vm.code_value(node_id{});
};
