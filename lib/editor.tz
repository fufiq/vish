// --- примитивы: команды VM (запуск, база, слияние, проекция) -------------------------------
// main() текущего состояния базы в этой же VM: array{вывод, без ошибки}
run_program(str args, str input) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto & s = editor_host->session;
  s.stdin_lines.clear();
  for(auto l: lines_of((a[1]).as<str_v>().view())) s.stdin_lines.emplace_back(l);
  std::vector<std::string> args;
  for(auto w: words_of((a[0]).as<str_v>().view())) args.emplace_back(w);
  bool ok = true;
  std::string out = s.run(args, ok);
  return value(array_v::of({value(std::move(out)), value(ok)}));
};
// запуск с трассой (шаги — по ней)
trace_program(str args, str input) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & h = *editor_host;
  h.session.stdin_lines.clear();
  for(auto l: lines_of((a[1]).as<str_v>().view())) h.session.stdin_lines.emplace_back(l);
  std::vector<std::string> args;
  for(auto w: words_of((a[0]).as<str_v>().view())) args.emplace_back(w);
  bool ok = true;
  h.trace_output = h.session.trace_run(args, ok, h.trace_error);
  return value(int64_t(0));
};
show_output(str out, bool ok) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->send(*editor_host->now_peer, proto::s_output{std::string((a[0]).as<str_v>().view()), (a[1]).as<bool>()});
  return value(int64_t(0));
};
