// слои функции: array{ключ, кт | рт}
fn_layers(fn) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  std::vector<value> xs;
  if(auto fl = s.session.layers.find(vm.code_node(a[0], where).value); fl != s.session.layers.end())
    for(auto const & [key, l]: fl->second) xs.push_back(value(array_v::of({value(key), value(std::string(l.ct ? "кт" : "рт"))})));
  return value(array_v::of(std::move(xs)));
};
// Значения узлов ns при компиляции по экземплярам — по типам (типы по возрастанию): array{тип,
// литералы}; литералы различные, не больше limit + 1 на тип (сколько показать, решает язык), пустой —
// значение рантайма. *Моё:* группировка — запросом к фактам (их тысячи у узла в цикле, известном при
// компиляции); что показать — язык.
node_values(ns, i64 limit) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto const & xs = (a[0]).as<array_v>();
  std::size_t limit = std::size_t(std::max<int64_t>(0, (a[1]).as<int64_t>()));
  std::map<std::string_view, std::vector<std::string_view>> by;
  auto const & facts = editor_host->session.node_values;
  for(uint32_t k = 0; k < xs.size(); ++k)
    if(auto it = facts.find(vm.code_node(xs.get(k), where).value); it != facts.end())
      for(std::string_view x: it->second) {
        auto tab = x.find('\t');
        auto & lits = by[x.substr(0, tab)];
        std::string_view lit = tab == std::string_view::npos ? std::string_view() : x.substr(tab + 1);
        if(lits.size() <= limit && !std::ranges::contains(lits, lit)) lits.push_back(lit);
      }
  std::vector<value> out;
  for(auto const & [t, lits]: by) {
    std::vector<value> ls;
    for(auto l: lits) ls.push_back(value(std::string(l)));
    out.push_back(value(array_v::of({value(std::string(t)), value(array_v::of(std::move(ls)))})));
  }
  return value(array_v::of(std::move(out)));
};
// места узлов ns (номера) в тексте: array{импорты, начала, концы} (байты)
node_spans(ns) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & db = editor_host->session.db;
  auto const & xs = (a[0]).as<array_v>();
  array_v src, from, to;
  for(uint32_t k = 0; k < xs.size(); ++k) {
    span const & w = db[node_id(uint32_t(xs.get(k).as<int64_t>()))].where;
    src.push(value(int64_t(w.source)));
    from.push(value(int64_t(w.begin)));
    to.push(value(int64_t(w.end)));
  }
  return value(array_v::of({value(std::move(src)), value(std::move(from)), value(std::move(to))}));
};
// ошибки последней проверки: сколько; у ошибки k — шагов трейса, текст и место (j -1 — сама
// ошибка, иначе шаг трейса j); место — array{импорт, начало, конец}
check_errors() => native "cpp" { return value(int64_t(editor_host->session.errors.size())); };
check_error_frames(i64 k) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->session.errors[std::size_t((a[0]).as<int64_t>())].trace.size()));
};
check_error_text(i64 k, i64 j) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto const & d = editor_host->session.errors[std::size_t((a[0]).as<int64_t>())];
  int64_t j = (a[1]).as<int64_t>();
  return value(j < 0 ? std::string(d.what()) : d.trace[std::size_t(j)].what);
};
check_error_place(i64 k, i64 j) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  auto const & d = editor_host->session.errors[std::size_t((a[0]).as<int64_t>())];
  int64_t j = (a[1]).as<int64_t>();
  span w = j < 0 ? d.where : d.trace[std::size_t(j)].where;
  return value(array_v::of({value(int64_t(w.source)), value(int64_t(w.begin)), value(int64_t(w.end))}));
};

// --- примитивы: инспектор (поля узлов, записи, печать) ------------------------------------
// запись syntax узла (печать и разбор по ней): array{объявление, array{array{ребёнок, параметр}…}}; нет — array{}
record_rule(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  auto const & db = s.session.db;
  node_id n = vm.code_node(a[0], where);
  printer pr(db);
  auto const * r = pr.record_for(n);
  if(!r) return value(array_v::of({}));
  auto const & [d, info] = *r;
  auto const & fn = db.as<n_fn>(d);
  std::vector<value> roles;
  for(uint32_t k = 0; k < fn.params.size() && k < info.slot.size(); ++k) {
    node_id at = info.kind >= 0 ? node_place(db[n].kind, info.slot[k]) : db.as<n_call>(n).args[info.slot[k]];
    if(at) roles.push_back(value(array_v::of({vm.code_value(at), value(std::string(db.strings.text(db.as<n_param>(fn.params[k]).name)))})));
  }
  return value(array_v::of({vm.code_value(d), value(array_v::of(std::move(roles)))}));
};
// узел переписан трансформатором или изменён ct-кодом (§7.4): источник; нет — code()
rewritten_by(n) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  node_id n = vm.code_node(a[0], where), by;
  for(auto const & mu: editor_host->session.db.mutations)
    if(mu.target == n.value && mu.source) by = node_id(mu.source - 1);
  return vm.code_value(by);
};
// проекция узла
print_node(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(printer(editor_host->session.db).print(vm.code_node(a[0], where)));
};
// тело с подставленными аргументами (имя → узел; выражение-операция — в скобках вне скобок места)
print_with_args(body, names, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto const & db = editor_host->session.db;
  std::map<std::string, node_id> by;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) by[std::string((a[1]).as<array_v>().get(k).as<str_v>().view())] = vm.code_node((a[2]).as<array_v>().get(k), where);
  printer::substitution sub;
  sub.text = [&](node_id x) -> std::optional<std::string> {
    if(!db.is<n_ident>(x)) return std::nullopt;
    auto it = by.find(std::string(db.strings.text(db.as<n_ident>(x).name)));
    if(it == by.end()) return std::nullopt;
    std::string t = printer(db).print(it->second);
    node_id up = db[x].parent; // в скобках места (условие, аргумент) — без своих
    bool bracketed = up && (db.is<n_if>(up) || db.is<n_call>(up) || db.is<n_loop>(up));
    return db.is<n_op>(it->second) && !bracketed ? cat("(", t, ")") : t;
  };
  return value(printer(db, {}, sub).print(vm.code_node(a[0], where)));
};
// строка в одну строку текста, до n кодовых точек (длиннее — «…»)
clip(str s, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  std::string t((a[0]).as<str_v>().view());
  for(auto & c: t)
    if(c == '\n') c = ' ';
  uint32_t n = uint32_t((a[1]).as<int64_t>());
  if(code_points(t) > n) {
    std::size_t b = 0;
    for(uint32_t k = 0; k < n && b < t.size(); ++k) b += cp_len(t, b);
    t = t.substr(0, b) + "…";
  }
  return value(std::move(t));
};

