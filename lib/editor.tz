// наблюдения слоя: типы узла; узел исполнялся в этом контексте
layer_types(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  if(auto const * l = editor_host->layer_of(editor_host->view_now((a[0]).as<int64_t>())))
    if(auto it = l->types.find(vm.code_node(a[1], where).value); it != l->types.end())
      for(auto const & t: it->second) xs.push_back(value(t));
  return value(array_v::of(std::move(xs)));
};
layer_has(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(false));
  auto const * l = editor_host->layer_of(editor_host->view_now((a[0]).as<int64_t>()));
  node_id n = editor_host->node_or_none(vm, a[1], where);
  return value(l && n && l->types.contains(n.value));
};
