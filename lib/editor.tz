// Редактор на языке (M5 → язык, 2026-10-19, решение автора: 
//). 
// 
// 
// Клавиша, указатель,
// ввод — функции этого модуля: что сделать, решает код на языке. Своя функция с тем же именем в
// проекции представления или в программе — первой (как operand_parens).
//
// Цепочки одного ассоциативного оператора (a + b + c) здесь — скобками: дерево такой цепочки VM
// строит при первом исполнении производными узлами базы, а код редактора базу программы не
// трогает (*моё*).
//
// *Моё (решение автора 2026-10-19):* модуль отдельный — его грузит только сервер
// редактора, программы его не разбирают. Состояние представления (курсор, выделение, черновик,
// раскладка) пока у VM: язык видит его примитивами native "cpp" ниже — представление v — номер
// представления того клиента, чьё сообщение обслуживается. Механизмы базового языка (разбор
// правки, печать, база) — тоже примитивы: 
//.
module editor;

// --- примитивы: состояние представления (у VM) ------------------------------------------
// Неизвестный при разборе аргумент — стёртое значение (как у прелюдии), без эффектов.
places(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now(int64_t((a[0]).as<int64_t>())).places.size()));
};
// первый байт символа места k ('\n' — конец строки)
lead(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  int64_t k = (a[1]).as<int64_t>();
  return value(int64_t(k >= 0 && k < int64_t(w.lead.size()) ? uint8_t(w.lead[k]) : 0));
};
cursor(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).cursor));
};
set_cursor(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  w.cursor = uint32_t(std::clamp<int64_t>((a[1]).as<int64_t>(), 0, int64_t(w.places.size()) - 1));
  return value(int64_t(w.cursor));
};
// второй конец выделения; -1 — нет
anchor(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  return value(w.anchor == editor_view::none ? int64_t(-1) : int64_t(w.anchor));
};
set_anchor(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  w.anchor = (a[1]).as<int64_t>() < 0 ? editor_view::none : uint32_t((a[1]).as<int64_t>());
  return value(int64_t(0));
};
// колонка для ↑/↓; -1 — нет
goal(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  return value(w.goal == editor_view::none ? int64_t(-1) : int64_t(w.goal));
};
set_goal(i64 v, i64 g) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  w.goal = (a[1]).as<int64_t>() < 0 ? editor_view::none : uint32_t((a[1]).as<int64_t>());
  return value(int64_t(0));
};
// текст мест [from, to)
text_of(i64 v, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  return value(std::string(w.text_of({uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>())})));
};
draft_open(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(editor_host->view_now((a[0]).as<int64_t>()).draft.open);
};
// открыт список дополнения (или перехода) и в нём есть варианты
completing(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  return value(w.completing && !w.items.empty());
};
completion_count(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).items.size()));
};
selected(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).selected));
};
select_item(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  w.selected = uint32_t((a[1]).as<int64_t>());
  editor_host->send_completion(*editor_host->now_peer, w);
  return value(int64_t(0));
};
completion_name(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  return value(editor_host->view_now((a[0]).as<int64_t>()).items[uint32_t((a[1]).as<int64_t>())].name);
};
// начало набираемого слова дополнения
word_begin(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).word_begin));
};
// список — переход (F12, Ctrl+P), а не дополнение
nav_list(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(!editor_host->view_now((a[0]).as<int64_t>()).targets.empty());
};
// идёт набор слова (откат — словом)
set_typing(i64 v, bool on) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->view_now((a[0]).as<int64_t>()).typing = (a[1]).as<bool>();
  return value(int64_t(0));
};

// --- примитивы: механизмы VM ---------------------------------------------------------
// правка: места [from, to) заменить текстом, переразбор наименьшей единицы; caret — байт
// курсора во вставке (-1 — после неё)
replace(i64 v, i64 from, i64 to, str s, i64 caret) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known() || !(a[3]).known() || !(a[4]).known()) return erase(value(int64_t(0)));
  auto & w = editor_host->view_now((a[0]).as<int64_t>());
  int64_t c = (a[4]).as<int64_t>();
  editor_host->replace(*editor_host->now_peer, w, uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), std::string((a[3]).as<str_v>().view()), c < 0 ? ~uint32_t{0} : uint32_t(c));
  return value(int64_t(0));
};
// курсор передвинут: набор слова кончился, дополнение закрыто, черновик — к канону, если курсор
// из него ушёл; курсор — клиенту
cursor_moved(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->cursor_moved(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
send_cursor(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->send_cursor(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
hide_hint(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->hide_hint(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
close_completion(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->close_completion(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
// пункт k списка перехода: функция (пусто — «добавить») и сигнатура, которую добавить
nav_fn(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(vm.code_value(node_id{}));
  return vm.code_value(editor_host->view_now((a[0]).as<int64_t>()).targets[uint32_t((a[1]).as<int64_t>())].fn);
};
nav_add(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  return value(editor_host->view_now((a[0]).as<int64_t>()).targets[uint32_t((a[1]).as<int64_t>())].add);
};
// список перехода у курсора: варианты (completion) и цели — array{функция, добавить}
show_nav(i64 v, items, targets) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto const & db = s.session.db;
  auto & w = s.view_now((a[0]).as<int64_t>());
  auto field = [&](value const & x, std::string_view f) -> value const & {
    for(auto const & [k, fv]: x.as<agg_v>().fields)
      if(db.strings.text(k) == f) return fv;
    throw diagnostic(cat("completion: нет поля ", f), where);
  };
  w.items.clear();
  w.targets.clear();
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) {
    value x = (a[1]).as<array_v>().get(k);
    w.items.push_back({std::string(field(x, "name").as<str_v>().view()), std::string(field(x, "kind").as<str_v>().view()), std::string(field(x, "detail").as<str_v>().view()), uint32_t(field(x, "depth").as<int64_t>())});
    value t = (a[2]).as<array_v>().get(k);
    w.targets.push_back({s.node_or_none(vm, t.as<array_v>().get(0), where), std::string(t.as<array_v>().get(1).as<str_v>().view())});
  }
  w.selected = 0;
  w.word_begin = w.cursor;
  w.completing = true;
  s.send_completion(*s.now_peer, w);
  return value(int64_t(0));
};
// открыть функцию во второй панели (у клиента одно представление функции)
open_fn(f) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->open_fn(*editor_host->now_peer, vm.code_node(a[0], where));
  return value(int64_t(0));
};
// добавить внутренний элемент модуля программы (текст объявления) и открыть его
add_inner(str text, str sig) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->add_inner(*editor_host->now_peer, std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view()));
  return value(int64_t(0));
};
// типы узла по всем экземплярам
node_types(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  if(auto it = editor_host->session.node_types.find(vm.code_node(a[0], where).value); it != editor_host->session.node_types.end())
    for(auto const & t: it->second) xs.push_back(value(t));
  return value(array_v::of(std::move(xs)));
};
// a.f — значение слева
member_object(n) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  return vm.code_value(editor_host->session.db.member_of(vm.code_node(a[0], where)).object);
};
// черновики всех представлений клиента — к канону
finalize_views() => native "cpp" {
  editor_host->finalize_peer(*editor_host->now_peer);
  return value(int64_t(0));
};
// байты [from, to)
slice_text(str s, i64 from, i64 to) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t f = std::size_t(std::clamp<int64_t>((a[1]).as<int64_t>(), 0, int64_t(v.size()))), t = std::size_t(std::clamp<int64_t>((a[2]).as<int64_t>(), int64_t(f), int64_t(v.size())));
  return value(std::string(v.substr(f, t - f)));
};
// черновик представления — к канону
finalize(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->finalize(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
// черновики прочих представлений клиента — к канону
finalize_others(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->finalize_peer(*editor_host->now_peer, &editor_host->view_now((a[0]).as<int64_t>()));
  return value(int64_t(0));
};
undo(i64 v, bool again) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->undo(*editor_host->now_peer, editor_host->view_now((a[0]).as<int64_t>()), (a[1]).as<bool>());
  return value(int64_t(0));
};
clipboard(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->send(*editor_host->now_peer, proto::s_clipboard{std::string((a[0]).as<str_v>().view())});
  return value(int64_t(0));
};
// сообщение клиенту об ошибке
report(str s) => native "cpp" {
  if(!(a[0]).known()) return erase(value(int64_t(0)));
  editor_host->send(*editor_host->now_peer, proto::s_error{std::string((a[0]).as<str_v>().view())});
  return value(int64_t(0));
};

// --- примитивы: раскладка представления и подсказки ------------------------------------
// номер раскладки узла в представлении (-1 — узла нет); места его текста [from, to)
layout_of(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  uint32_t k = editor_host->view_now((a[0]).as<int64_t>()).layout_of(vm.code_node(a[1], where));
  return value(k == ~uint32_t{0} ? int64_t(-1) : int64_t(k));
};
range_from(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).range[uint32_t((a[1]).as<int64_t>())].first));
};
range_to(i64 v, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  return value(int64_t(editor_host->view_now((a[0]).as<int64_t>()).range[uint32_t((a[1]).as<int64_t>())].second));
};
// перегрузки, выбранные разбором у вызова (по всем экземплярам)
call_targets(c) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  if(auto it = editor_host->session.call_targets.find(vm.code_node(a[0], where).value); it != editor_host->session.call_targets.end())
    for(uint32_t f: it->second) xs.push_back(vm.code_value(node_id(f)));
  return value(array_v::of(std::move(xs)));
};
// голова объявления — проекция без тела: when(c, expr yes) otherwise(expr no)
head_text(f) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(editor_host->head_text(vm.code_node(a[0], where)));
};
// типы (и значения) узла и имени в его области — по всем экземплярам; пусто — неизвестно
has_types(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(editor_host->session.node_types.contains(vm.code_node(a[0], where).value));
};
shown_node(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(editor_host->shown_node(vm.code_node(a[0], where)));
};
shown_name(n, str name) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto & s = *editor_host;
  return value(s.shown_name(s.scope_of(vm.code_node(a[0], where)), s.session.db.strings.intern((a[1]).as<str_v>().view())));
};
// a.f — имя члена ("" — не член)
member_name(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto const & db = editor_host->session.db;
  node_id x = vm.code_node(a[0], where);
  return value(db.is_member(x) ? std::string(db.strings.text(db.member_of(x).name)) : std::string());
};
// вид параметра: let, mut, own, out, expr, ct, implicit
param_mode(p) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  static constexpr std::string_view names[] = {"let", "mut", "own", "out", "expr", "ct", "implicit"};
  return value(std::string(names[uint32_t(editor_host->session.db.as<n_param>(vm.code_node(a[0], where)).mode)]));
};
// комментарии перед объявлением
note_lead(f) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  if(auto const * nt = editor_host->session.db.note_of(vm.code_node(a[0], where)))
    for(auto const & l: nt->lead) xs.push_back(value(l));
  return value(array_v::of(std::move(xs)));
};
// внутренний элемент модуля программы; в прелюдии
is_inner(f) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(editor_host->is_inner(vm.code_node(a[0], where)));
};
in_prelude(f) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  auto const & db = editor_host->session.db;
  return value(db[vm.code_node(a[0], where)].where.source == db[db.prelude].where.source);
};
// значение узла в слое представления ("" — нет)
layer_literal(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  if(auto const * l = editor_host->layer_of(editor_host->view_now((a[0]).as<int64_t>())))
    if(auto it = l->literal.find(vm.code_node(a[1], where).value); it != l->literal.end()) return value(it->second);
  return value(std::string());
};
// тексты ошибок разбора у узла
error_texts(i64 v, n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(array_v::of({})));
  node_id n = vm.code_node(a[1], where);
  std::vector<value> xs;
  for(auto const & m: editor_host->marks_errors(editor_host->view_now((a[0]).as<int64_t>())))
    if(m.node == n) xs.push_back(value(m.text));
  return value(array_v::of(std::move(xs)));
};
hint_shown(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  return value(editor_host->view_now((a[0]).as<int64_t>()).hint_shown);
};
// подсказка набора у места anchor (-1 — без места); пусто — скрыть
show_hint(i64 v, i64 anchor, lines) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto & w = s.view_now((a[0]).as<int64_t>());
  int64_t k = (a[1]).as<int64_t>();
  caret c = k >= 0 && k < int64_t(w.places.size()) ? w.places[uint32_t(k)] : caret{};
  auto ls = s.wire_lines(vm, a[2], where);
  w.hint_shown = !ls.empty();
  s.send(*s.now_peer, proto::s_hint{w.id, c.node, c.piece, c.offset, std::move(ls)});
  return value(int64_t(0));
};
// подсказка наведения на узел
show_hover(i64 v, n, lines) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto & w = s.view_now((a[0]).as<int64_t>());
  s.send(*s.now_peer, proto::s_hover{w.id, vm.code_node(a[1], where), s.wire_lines(vm, a[2], where)});
  return value(int64_t(0));
};

// --- примитивы: инспектор (поля узлов, записи, печать) ------------------------------------
// дети узла с именами полей (рефлексия вида узла): array{узел, "cond" | "args[1]"}
child_roles(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  std::vector<value> xs;
  for(auto const & [c, name]: editor_host->child_roles(vm.code_node(a[0], where))) xs.push_back(value(array_v::of({vm.code_value(c), value(name)})));
  return value(array_v::of(std::move(xs)));
};
// запись syntax узла (печать и разбор по ней): array{объявление, array{array{ребёнок, параметр}…}}; нет — array{}
record_rule(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  auto const & db = s.session.db;
  node_id n = vm.code_node(a[0], where);
  printer pr(db);
  auto const * r = pr.record_for(n);
  if(!r) return value(array_v::of({}));
  auto const & [d, info] = *r;
  auto const & fn = db.as<n_fn>(d);
  std::vector<value> roles;
  for(uint32_t k = 0; k < fn.params.size() && k < info.slot.size(); ++k) {
    node_id at = info.kind >= 0 ? node_place(db[n].kind, info.slot[k]) : db.as<n_call>(n).args[info.slot[k]];
    if(at) roles.push_back(value(array_v::of({vm.code_value(at), value(std::string(db.strings.text(db.as<n_param>(fn.params[k]).name)))})));
  }
  return value(array_v::of({vm.code_value(d), value(array_v::of(std::move(roles)))}));
};
// узел переписан трансформатором или изменён ct-кодом (§7.4): источник; нет — code()
rewritten_by(n) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  node_id n = vm.code_node(a[0], where), by;
  for(auto const & mu: editor_host->session.db.mutations)
    if(mu.target == n.value && mu.source) by = node_id(mu.source - 1);
  return vm.code_value(by);
};
// проекция узла
print_node(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  return value(printer(editor_host->session.db).print(vm.code_node(a[0], where)));
};
// тело с подставленными аргументами (имя → узел; выражение-операция — в скобках вне скобок места)
print_with_args(body, names, args) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(std::string()));
  auto const & db = editor_host->session.db;
  std::map<std::string, node_id> by;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) by[std::string((a[1]).as<array_v>().get(k).as<str_v>().view())] = vm.code_node((a[2]).as<array_v>().get(k), where);
  printer::substitution sub;
  sub.text = [&](node_id x) -> std::optional<std::string> {
    if(!db.is<n_ident>(x)) return std::nullopt;
    auto it = by.find(std::string(db.strings.text(db.as<n_ident>(x).name)));
    if(it == by.end()) return std::nullopt;
    std::string t = printer(db).print(it->second);
    node_id up = db[x].parent; // в скобках места (условие, аргумент) — без своих
    bool bracketed = up && (db.is<n_if>(up) || db.is<n_call>(up) || db.is<n_loop>(up));
    return db.is<n_op>(it->second) && !bracketed ? cat("(", t, ")") : t;
  };
  return value(printer(db, {}, sub).print(vm.code_node(a[0], where)));
};
// строка в одну строку текста, до n кодовых точек (длиннее — «…»)
clip(str s, i64 n) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  std::string t((a[0]).as<str_v>().view());
  for(auto & c: t)
    if(c == '\n') c = ' ';
  uint32_t n = uint32_t((a[1]).as<int64_t>());
  if(code_points(t) > n) {
    std::size_t b = 0;
    for(uint32_t k = 0; k < n && b < t.size(); ++k) b += cp_len(t, b);
    t = t.substr(0, b) + "…";
  }
  return value(std::move(t));
};
// хвост строки с байта k
text_from(str s, i64 k) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(std::string()));
  auto v = (a[0]).as<str_v>().view();
  std::size_t k = std::size_t(std::max<int64_t>(0, (a[1]).as<int64_t>()));
  return value(std::string(k < v.size() ? v.substr(k) : std::string_view()));
};
// корень представления (модуль или функция)
view_root(i64 v) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  return vm.code_value(editor_host->view_now((a[0]).as<int64_t>()).root);
};
// инспектор: дерево (inode), фокус, раскрытие (line)
show_inspect(i64 v, root, focus, nodes, expand) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known() || !(a[3]).known() || !(a[4]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto const & db = s.session.db;
  auto field = [&](value const & x, std::string_view f) -> value const & {
    for(auto const & [k, fv]: x.as<agg_v>().fields)
      if(db.strings.text(k) == f) return fv;
    throw diagnostic(cat("inode: нет поля ", f), where);
  };
  auto text = [&](value const & x, std::string_view f) { return std::string(field(x, f).as<str_v>().view()); };
  proto::s_inspect out{s.view_now((a[0]).as<int64_t>()).id, s.node_or_none(vm, a[1], where), s.node_or_none(vm, a[2], where), {}, s.wire_lines(vm, a[4], where)};
  for(uint32_t k = 0; k < (a[3]).as<array_v>().size(); ++k) {
    value x = (a[3]).as<array_v>().get(k);
    out.nodes.push_back({s.node_or_none(vm, field(x, "node"), where), uint32_t(field(x, "depth").as<int64_t>()), text(x, "role"), text(x, "kind"), text(x, "text"), text(x, "rule"), s.node_or_none(vm, field(x, "rule_at"), where), text(x, "types")});
  }
  s.send(*s.now_peer, out);
  return value(int64_t(0));
};

