};
// метки (mark) — клиенту
show_marks(i64 v, marks) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto const & db = s.session.db;
  auto field = [&](value const & x, std::string_view f) -> value const & {
    for(auto const & [k, fv]: x.as<agg_v>().fields)
      if(db.strings.text(k) == f) return fv;
    throw diagnostic(cat("mark: нет поля ", f), where);
  };
  std::vector<proto::s_mark> out;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) {
    value x = (a[1]).as<array_v>().get(k);
    out.push_back({s.node_or_none(vm, field(x, "node"), where), std::string(field(x, "kind").as<str_v>().view()), std::string(field(x, "text").as<str_v>().view()), uint32_t(field(x, "from").as<int64_t>()), uint32_t(field(x, "to").as<int64_t>())});
  }
  auto & w = s.view_now((a[0]).as<int64_t>());
  s.send(*s.now_peer, proto::s_decor{w.id, db.revision, std::move(out)});
  return value(int64_t(0));
};
