// функция правки программы: итог (применена… — правки в базе); все представления — заново
apply_edit(str fn) => native "cpp" {
  if(!(a[0]).known()) return erase(value(std::string()));
  auto & s = *editor_host;
  s.finalize_all();
  std::string r = s.session.apply(std::string((a[0]).as<str_v>().view()));
  if(r.starts_with("применена")) s.refresh_all();
  return value(std::move(r));
};
