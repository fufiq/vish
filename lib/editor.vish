// Primitives: VM commands (launch, base, merger) main() received code - the process of the machine in the
// same VM (the server executes it with quants, the output - the solution on run output); the previous
// start is replaced
start_program(str args, str input) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  std::vector<std::string> args, input;
  for(auto w: words_of((a[0]).as<str_v>().view())) args.emplace_back(w);
  for(auto l: lines_of((a[1]).as<str_v>().view())) input.emplace_back(l);
  editor_host->start_run(std::move(args), std::move(input));
  return value(int64_t(0));
};
stop_program() => native "cpp" {
  editor_host->stop_run();
  return value(int64_t(0));
};
program_running() => native "cpp" { return value(editor_host->running()); };
// Live process (F5) and edits: the process is waiting for editing (noted); its base is the version of the tool
// module; modules of its program, which are in the session database; the values of struct n of the old layout in it;
