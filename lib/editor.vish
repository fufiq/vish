// Merge conflicts (and taken by itself) - to the client: conflicts - conflict tools module
send_merge_list(taken, conflicts, diffs) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known() || !(a[2]).known()) return erase(value(int64_t(0)));
  auto & h = *editor_host;
  std::vector<std::string> taken;
  for(uint32_t k = 0; k < (a[0]).as<array_v>().size(); ++k) taken.emplace_back((a[0]).as<array_v>().get(k).as<str_v>().view());
  std::vector<proto::s_conflict> cs;
  for(uint32_t k = 0; k < (a[1]).as<array_v>().size(); ++k) {
    value c = (a[1]).as<array_v>().get(k);
    auto s = [&](std::string_view f) { return std::string(h.field(c, f, where).as<str_v>().view()); };
    cs.push_back({s("key"), s("base"), s("mine"), s("theirs")});
    value d = (a[2]).as<array_v>().get(k);
    auto n = [&](std::string_view f) { return h.field(d, f, where); };
    cs.back().mine_from = uint32_t(n("mine_from").as<int64_t>());
    cs.back().mine_to = uint32_t(n("mine_to").as<int64_t>());
    cs.back().mine_note = std::string(n("mine_note").as<str_v>().view());
    cs.back().theirs_from = uint32_t(n("theirs_from").as<int64_t>());
    cs.back().theirs_to = uint32_t(n("theirs_to").as<int64_t>());
    cs.back().theirs_note = std::string(n("theirs_note").as<str_v>().view());
  }
  h.send_merge(std::move(taken), std::move(cs));
  return value(int64_t(0));
};
