// Launch output to the client: more - continuation of the former, state - "running", "stopped" or " (finished)
// from - out_src on the output lines, now - executable node (empty - no)
run_output(str text, bool ok, bool more, str state, from, now) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  proto::s_output out{std::string((a[0]).as<str_v>().view()), (a[1]).as<bool>(), (a[2]).as<bool>(), std::string((a[3]).as<str_v>().view()), {}, s.node_or_none(vm, a[5], where)};
  auto const & xs = (a[4]).as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    value x = xs.get(k);
    out.from.push_back({s.node_or_none(vm, s.field(x, "node", where), where), std::string(s.field(x, "label", where).as<str_v>().view())});
  }
  if(s.now_peer) s.send(*s.now_peer, out);
  return value(int64_t(0));
};
// Start with the track (steps - on it)
trace_program(str args, str input) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  auto & h = *editor_host;
  h.session.stdin_lines.clear();
  for(auto l: lines_of((a[1]).as<str_v>().view())) h.session.stdin_lines.emplace_back(l);
  std::vector<std::string> args;
  for(auto w: words_of((a[0]).as<str_v>().view())) args.emplace_back(w);
  bool ok = true;
  h.trace_output = h.session.trace_run(args, ok, h.trace_error);
  return value(int64_t(0));
};
show_output(str text, bool ok) => native "cpp" {
