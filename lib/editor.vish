// Editor in language (M5 → language, 2026-10-19, author's decision: ).
//
// 
// 
// Key, pointer, input - the functions of this module: what to do, decides the code in the language. A
// function of its own with the same name in the projection presentation or in the first program (as
// operand_parens).
//
// The chains of one associative operator (a + b + c) are here in parentheses: the VM tree of such a chain
// builds the base at the first execution by node derivatives, and the editor code does not touch the
// program base (*my*).
//
// The state of views is the variables of this module (author's decision 2026-10-20): the module is a VM
// service, its state is one on VM, live -, Cursor, selection, draft, rollback history, lists and layout -
// here; the mechanisms above them (draft, selection of the unit per parsing, sending edits with transfer
// of cursors, rollback) - too. VM has a language base: projection printing (layout, value), parsing text
// unit to base, parsing facts, socket - native "cpp" primitives below. *My:* module is separate - only
// the editor's server loads it, the programs do not disassemble it.
//
//
[[service]] module editor;
use tools; // Tuling: strings, session commands (lib/tools.vish)
use versions; // Base version: merger (lib/versions.vish)

// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Nodes are numbers (node code)
//
//
struct layout {
  str text;      // projection
  str lead;      // the first byte of the symbol of each place ('\n' at the end is the edge of the last line)
  array node;    // place: node, number of its piece, displacement in the piece (code points) - place in the protocol
  array piece;
  array offset;
  array byte;    // byte of text
  array nodes;   // by layout number: node
  array up;      // by layout number: layout of the parent (-1 - root)
  array from;    // by layout number: text places node [from, to]
  array to;
  array sig;     // signature of their pieces (view, texts, children, note)
  array sub;     // Subtree signature (node, its pieces, children)
  array first;   // node : [first, first + count] in pchild/pbyte
  array count;
  array pchild;  // by piece: child (-1 - text)
  array pbyte;   // The beginning of his text in ptext
  array plen;    // by piece: code points of text (the child has 0)
  array pplace;  // piece by piece: his first place
  str ptext;     // piece-writing
  array sorted;  // node by ascending
  array order;   // layout numbers
  array chunk_at;   // module: by element number - byte of the beginning of its piece (-1 - not output)
  array content_at; // - beginning of his lines
  i64 items_end;    // end of elements (until the end of the module comments)
  i64 draft_begin;  // Draft text [draft_begin, draft_end]
  i64 draft_end;
  i64 group_at;     // printed with the module draft: elements [group_at, group_at + group_count]; -1 - without
  i64 group_count;
}
// Draft (author's decision 2026-10-12): the elements of the module that rule - the text exactly as
// typed; in the representation of the function - it itself.
struct draft {
  bool open;
  array items;   // elements of the draft module (representation of the function is its root)
  code next;     // module element after draft (empty - at the end)
  i64 source;    // Import of typed text: places node - in it
  array blank;   // Empty parsing lines for the canon
  array rest;    // comments after the last element - the following
  i64 since;     // revision of the base at the opening: journal after it - one edit
  str before;    // text of the unit before the draft (canon) - for rollback of the accepted
  array sources; // importation
  i64 known;     // node with id less - were before the draft (their brackets - only together with node, O16)
}
struct snapshot { str text; i64 caret; } // rollback inside the draft: text and byte of the cursor
// Accepted editing (closed draft): elements and their text before and after - rollback and repetition of
// accepted - editing back. *Mine*: History is edited, journal is not rewritten.
//
struct closed { array items; code next; str before; str after; }
struct view {
  i64 peer;          // client (VM number)
  i64 id;            // presentation number
  code root;         // module or function; empty - closed
  str kind;          // Module - Module without internal elements; fn - one function
  str layer;         // Presentation Layer: Key instance, "all contexts"
  code projection;   // projection (§4.4): Module of print records and rules parsing edits; empty - default
  layout lay;
  i64 cursor;        // place
  i64 anchor;        // the second end of the allocation; -1 - no
  i64 goal;          // column for ↑/↓; -1 - no
  bool selection_sent;
  bool hint_shown;   // The tip of the set is shown - to hide when there is nothing
  bool typing;       // It's a set of words: rollback in a word, not a letter.
  bool completing;   // The list of additions (or transitions) is open
  array items;       // Its variants (completion)
  i64 selected;
  i64 word_begin;    // beginning
  array targets;     // transition list (F12, Ctrl+P): by item array {функция, сигнатура «добавить»}
  draft d;
  array undo;        // rollback inside the draft (snapshot)
  array redo;
  array done;        // Accepted amendments (closed)
  array undone;
  str peers_sent;    // Signing the latest list of other customers (do not submit the same)
}
// client: watches the launch track (step keys - debugger) and its step
struct client { bool debugging; i64 trace_pos; str name; }
// Edit the author in coordinates node (up to parsing): cursors of other clients in the same piece are
// shifted by it, as in a conventional editor.
struct edit_hint { i64 node; i64 piece; i64 offset; i64 removed; i64 inserted; bool valid; }

views = array{};   // All representations of all customers: number - place in the array
clients = array{}; // client number
hint = edit_hint{-1, 0, 0, 0, 0, false};
merge_state = no_merge(); // conflicts of the last merger before the decision of the person
// O12: overload instructions shared with most general overload (in function)
struct shared_seen { i64 fn; array texts; }
seen_shared = array{};
cursors_moved = false; // The cursor moved - send to other customers at the end of the decision
proposals = array{}; // Proposals of edits (AI) - before the decision of the person
// shown by the overload group in the module view (frame "Layers"): group name → function
struct pick { str name; i64 fn; }
picks = array{};
next_proposal = 0;
migrate_needed = ""; // process got up: struct without migrate (its type) - bangs with "Add migrate"
migrate_said = "";

// --- Primitives of the base: projection printing, parsing editing, sending (in VM)
// --------------------- Unknown in parsing argument - erased value (as in prelude), without effects.

// Customer whose message is being served
now_peer() => native "cpp" { return value(int64_t(editor_host->now_peer ? editor_host->index_of(*editor_host->now_peer) : -1)); };
// code node by number (-1 - empty)
node_code(i64 n) => native "cpp" {
  if(!(a[0]).known()) return erase(vm.code_value(node_id{}));
  int64_t n = (a[0]).as<int64_t>();
  return vm.code_value(n < 0 || n >= int64_t(editor_host->session.db.size()) ? node_id{} : node_id(uint32_t(n)));
};
node_codes(ns) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto const & xs = (a[0]).as<array_v>();
  array_v out;
  for(uint32_t k = 0; k < xs.size(); ++k) out.push(vm.code_value(node_id(uint32_t(xs.get(k).as<int64_t>()))));
  return value(std::move(out));
};
// base audit
revision() => native "cpp" { return value(int64_t(editor_host->session.db.revision)); };
// id node base boundary: node with id less is already there
node_limit() => native "cpp" { return value(int64_t(editor_host->session.db.size())); };
// Print presentation (base of language): layout (layout) - root, module (otherwise one function),
// projection; draft module - elements [at, at + count) text as typed (count -1 - no); draft function - its
// text as typed (fn_source -1 - no)
print_view(root, bool as_module, projection, i64 at, i64 count, i64 source, i64 fn_source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  return editor_host->print_view(vm, vm.code_node(a[0], where), (a[1]).as<bool>(), editor_host->node_or_none(vm, a[2], where), (a[3]).as<int64_t>(), (a[4]).as<int64_t>(), (a[5]).as<int64_t>(), (a[6]).as<int64_t>());
};
// The draft module is corrected in place: print only its area (elements [at, at + count) text as typed,
// source) and paste in the former lay layout printed with a draft of old elements. VISH_SPLICE_CHECK = 1 is a
// complete seal reconciliation.
print_splice(layout lay, root, projection, i64 at, old, i64 count, i64 source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  node_list old;
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) old.push_back(vm.code_node((a[4]).as<array_v>().get(k), where));
  node_id root = vm.code_node(a[1], where);
  int64_t at = (a[3]).as<int64_t>(), count = (a[5]).as<int64_t>(), source = (a[6]).as<int64_t>();
  value r = s.print_splice(vm, a[0], root, at, old, count, source, where);
  static bool const check = std::getenv("VISH_SPLICE_CHECK");
  if(check) s.splice_check(vm, r, s.print_view(vm, root, true, s.node_or_none(vm, a[2], where), at, count, source, -1));
  return r;
};
// draft: the text of the elements of the module [at, at + old.size] (or root functions) to disassemble and
// put in the base; the result is array{elements, import of text, empty lines, end comments, redisassembled}
draft_parse(bool as_module, root, str text, old, next, i64 at, projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  node_list old;
  for(uint32_t k = 0; k < (a[3]).as<array_v>().size(); ++k) old.push_back(vm.code_node((a[3]).as<array_v>().get(k), where));
  return s.draft_parse(vm, (a[0]).as<bool>(), s.node_or_none(vm, a[1], where), std::string((a[2]).as<str_v>().view()), old, s.node_or_none(vm, a[4], where), uint32_t((a[5]).as<int64_t>()), s.node_or_none(vm, a[6], where));
};
// Canon of draft in the database: empty lines, end comments, keys - one edit journal
draft_close(bool as_module, i64 at, i64 count, next, blank, rest, i64 since, sources, i64 source) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  std::vector<uint32_t> blank, sources;
  std::vector<std::string> rest;
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) blank.push_back(uint32_t((a[4]).as<array_v>().get(k).as<int64_t>()));
  for(uint32_t k = 0; k < (a[5]).as<array_v>().size(); ++k) rest.emplace_back((a[5]).as<array_v>().get(k).as<str_v>().view());
  for(uint32_t k = 0; k < (a[7]).as<array_v>().size(); ++k) sources.push_back(uint32_t((a[7]).as<array_v>().get(k).as<int64_t>()));
  s.draft_close((a[0]).as<bool>(), uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), s.node_or_none(vm, a[3], where), blank, rest, uint64_t((a[6]).as<int64_t>()), sources, uint32_t((a[8]).as<int64_t>()));
  return value(int64_t(0));
};
// unit of parsing (0 - block, 1 - module element, 2 - module) - edit text: array {разобрана, переразобранные}
unit_edit(n, i64 kind, str text, projection) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  return s.unit_edit(vm, vm.code_node(a[0], where), (a[1]).as<int64_t>(), std::string((a[2]).as<str_v>().view()), s.node_or_none(vm, a[3], where));
};
// raw block - text editing; false - not understood
raw_edit(n, str text) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(false));
  return value(editor_host->raw_edit(vm.code_node(a[0], where), std::string((a[1]).as<str_v>().view())));
};
// function representation node - a hole with editing text
fn_hole(n, str text) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(value(int64_t(0)));
  editor_host->fn_hole(vm.code_node(a[0], where), std::string((a[1]).as<str_v>().view()));
  return value(int64_t(0));
};
// set line: elements [k, k + count] of the container c - edit text (count 0 - new at the place k); above / below -
// translations of the line of the gap before and after the place; array {разобрана, элементов, переразобранные}
line_edit(c, i64 k, i64 count, str text, bool module_level, projection, i64 above, i64 below) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(array_v::of({})));
  auto & s = *editor_host;
  return s.line_edit(vm, vm.code_node(a[0], where), uint32_t((a[1]).as<int64_t>()), uint32_t((a[2]).as<int64_t>()), std::string((a[3]).as<str_v>().view()), (a[4]).as<bool>(), s.node_or_none(vm, a[5], where), uint32_t((a[6]).as<int64_t>()), uint32_t((a[7]).as<int64_t>()));
};
// reactive check of the program after editing (before layout: the changed ct code can be seen immediately)
check_program() => native "cpp" {
  editor_host->recheck();
  return value(int64_t(0));
};
// node modified by elaboration (ct code mutations and their rollback, §7.4): take - and forget
changed_nodes(bool take) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto & db = editor_host->session.db;
  array_v out;
  for(uint32_t x: db.changed) out.push(value(int64_t(x)));
  if((a[0]).as<bool>()) db.changed.clear();
  return value(std::move(out));
};
// set pause: check and tags - by timer (on_idle solution); clear_pending - already done
schedule_check() => native "cpp" {
  editor_host->schedule_check();
  return value(int64_t(0));
};
clear_pending() => native "cpp" {
  editor_host->check_pending = false;
  return value(int64_t(0));
};
// Extension of functions by link in the program module: array {расширение, цель}
fn_extensions() => native "cpp" {
  auto const & db = editor_host->session.db;
  array_v out;
  for(node_id x: db.as<n_module>(editor_host->session.root).items)
    if(db.is<n_extend>(x) && db.as<n_extend>(x).target) out.push(value(array_v::of({vm.code_value(x), vm.code_value(node_id(db.as<n_extend>(x).target))})));
  return value(std::move(out));
};
// a raw block with the parsing rule (the unit of editing is himself)
raw_unit(n) => native "cpp" {
  if(!(a[0]).known()) return erase(value(false));
  auto const & db = editor_host->session.db;
  node_id n = vm.code_node(a[0], where);
  return value(db.is<n_raw>(n) && db.as<n_raw>(n).rule);
};
// add an internal element of the program module (ad text); failed - empty
parse_inner(str text, str sig) => native "cpp" {
  if(!(a[0]).known() || !(a[1]).known()) return erase(vm.code_value(node_id{}));
  return vm.code_value(editor_host->add_inner(std::string((a[0]).as<str_v>().view()), std::string((a[1]).as<str_v>().view())));
};
// Key module projection (like use k next to the program): array {модуль, ошибка};
projection_of(str key) => native "cpp" {
  if(!(a[0]).known()) return erase(value(array_v::of({})));
  auto [m, error] = editor_host->projection_of(std::string((a[0]).as<str_v>().view()));
  return value(array_v::of({vm.code_value(m), value(std::move(error))}));
};

// --- Primitives: sending to the client the whole presentation: node layouts in order
//
send_view(i64 peer, i64 id, root, str kind, layout lay) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  s.send_to((a[0]).as<int64_t>(), proto::s_view{uint32_t((a[1]).as<int64_t>()), vm.code_node(a[2], where), s.session.db.revision, s.wire_nodes(a[4], {}, where), std::string((a[3]).as<str_v>().view())});
  return value(int64_t(0));
};
// subtree node at - replaced (id at saved, children new)
send_update(i64 peer, i64 id, at, layout lay) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  node_id n = vm.code_node(a[2], where);
  s.send_to((a[0]).as<int64_t>(), proto::s_update{uint32_t((a[1]).as<int64_t>()), s.session.db.revision, n, s.wire_nodes(a[3], n, where)});
  return value(int64_t(0));
};
// cursor and second end of allocation: node (-1 - no), piece, displacement
send_caret(i64 peer, i64 id, bool selection, i64 n, i64 piece, i64 offset) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  int64_t n = (a[3]).as<int64_t>();
  node_id at = n < 0 ? node_id{} : node_id(uint32_t(n));
  uint32_t id = uint32_t((a[1]).as<int64_t>()), piece = uint32_t((a[4]).as<int64_t>()), offset = uint32_t((a[5]).as<int64_t>());
  if((a[2]).as<bool>()) editor_host->send_to((a[0]).as<int64_t>(), proto::s_select{id, at, piece, offset});
  else editor_host->send_to((a[0]).as<int64_t>(), proto::s_cursor{id, at, piece, offset});
  return value(int64_t(0));
};
// a list of additions (completion) at the place (node, piece, offset); empty - hide extra - by
// items: type of result, documentation, match [from, to) (struct item_extra )
send_completion_list(i64 peer, i64 id, i64 n, i64 piece, i64 offset, i64 selected, items, str preview, extra, str context) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  int64_t n = (a[2]).as<int64_t>();
  proto::s_complete out{uint32_t((a[1]).as<int64_t>()), n < 0 ? node_id{} : node_id(uint32_t(n)), uint32_t((a[3]).as<int64_t>()), uint32_t((a[4]).as<int64_t>()), uint32_t((a[5]).as<int64_t>()), {}, std::string((a[7]).as<str_v>().view()), std::string((a[9]).as<str_v>().view())};
  auto const & xs = (a[6]).as<array_v>();
  auto const & es = (a[8]).as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    value x = xs.get(k);
    proto::s_item it{std::string(s.field(x, "name", where).as<str_v>().view()), std::string(s.field(x, "kind", where).as<str_v>().view()), std::string(s.field(x, "detail", where).as<str_v>().view()), {}, {}, 0, 0};
    if(k < es.size()) {
      value e = es.get(k);
      it.result = std::string(s.field(e, "type", where).as<str_v>().view());
      it.doc = std::string(s.field(e, "doc", where).as<str_v>().view());
      it.from = uint32_t(s.field(e, "from", where).as<int64_t>());
      it.to = uint32_t(s.field(e, "to", where).as<int64_t>());
    }
    out.items.push_back(std::move(it));
  }
  s.send_to((a[0]).as<int64_t>(), out);
  return value(int64_t(0));
};
// a hint of a set at a place (node -1 - without a place); empty - hide
send_hint_lines(i64 peer, i64 id, i64 n, i64 piece, i64 offset, lines) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  int64_t n = (a[2]).as<int64_t>();
  s.send_to((a[0]).as<int64_t>(), proto::s_hint{uint32_t((a[1]).as<int64_t>()), n < 0 ? node_id{} : node_id(uint32_t(n)), uint32_t((a[3]).as<int64_t>()), uint32_t((a[4]).as<int64_t>()), s.wire_lines(vm, a[5], where)});
  return value(int64_t(0));
};
// pointer
send_hover(i64 peer, i64 id, n, lines) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  s.send_to((a[0]).as<int64_t>(), proto::s_hover{uint32_t((a[1]).as<int64_t>()), s.node_or_none(vm, a[2], where), s.wire_lines(vm, a[3], where)});
  return value(int64_t(0));
};
// marker
send_marks_list(i64 peer, i64 id, marks) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  std::vector<proto::s_mark> out;
  auto const & xs = (a[2]).as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    value x = xs.get(k);
    out.push_back({s.node_or_none(vm, s.field(x, "node", where), where), std::string(s.field(x, "kind", where).as<str_v>().view()), std::string(s.field(x, "text", where).as<str_v>().view()), uint32_t(s.field(x, "from", where).as<int64_t>()), uint32_t(s.field(x, "to", where).as<int64_t>())});
  }
  s.send_to((a[0]).as<int64_t>(), proto::s_decor{uint32_t((a[1]).as<int64_t>()), s.session.db.revision, std::move(out)});
  return value(int64_t(0));
};
// layer tabs: array{key, kt | mouth}; selected
send_layer_tabs(i64 peer, i64 id, layers, str selected, overloads, heads, i64 shown) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  proto::s_layers out{uint32_t((a[1]).as<int64_t>()), {}, std::string((a[3]).as<str_v>().view()), {}, uint32_t((a[6]).as<int64_t>())};
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k)
    out.overloads.push_back({s.node_or_none(vm, (a[4]).as<array_v>().get(k), where), std::string((a[5]).as<array_v>().get(k).as<str_v>().view())});
  auto const & xs = (a[2]).as<array_v>();
  for(uint32_t k = 0; k < xs.size(); ++k) {
    value one = xs.get(k);
    auto const & x = one.as<array_v>();
    out.layers.push_back({std::string(x.get(0).as<str_v>().view()), std::string(x.get(1).as<str_v>().view())});
  }
  editor_host->send_to((a[0]).as<int64_t>(), out);
  return value(int64_t(0));
};
// Inspector: tree (inode), focus, disclosure (line)
send_inspect(i64 peer, i64 id, root, focus, nodes, expand) => native "cpp" {
  for(auto & x: a)
    if(!x.known()) return erase(value(int64_t(0)));
  auto & s = *editor_host;
  auto text = [&](value const & x, std::string_view f) { return std::string(s.field(x, f, where).as<str_v>().view()); };
  proto::s_inspect out{uint32_t((a[1]).as<int64_t>()), s.node_or_none(vm, a[2], where), s.node_or_none(vm, a[3], where), {}, s.wire_lines(vm, a[5], where)};
  for(uint32_t k = 0; k < (a[4]).as<array_v>().size(); ++k) {
    value x = (a[4]).as<array_v>().get(k);
    out.nodes.push_back({s.node_or_none(vm, s.field(x, "node", where), where), uint32_t(s.field(x, "depth", where).as<int64_t>()), text(x, "role"), text(x, "kind"), text(x, "text"), text(x, "rule"), s.node_or_none(vm, s.field(x, "rule_at", where), where), text(x, "types")});
  }
  s.send_to((a[0]).as<int64_t>(), out);
  return value(int64_t(0));
};
